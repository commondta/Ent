    @section Scripts {

    <script src="~/jstree/jstree.min.js"></script>
    <script>
        $(document).ready(function () {



            MakeTree();


        });


        function MakeTree() {

            $.ajax({
                type: 'GET',
                url: `/api/Approvals/GetAllApprovalUI`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        var apendstring = "";
                        var apendsubtree = "";
                        var apendsubtreeSales = "";
                        var apendsubtreeOpera = "";
                        $.each(response.data, function (i, item) {

                            debugger;
                            if (item.level == 2) {
                                apendstring = apendstring + "<li id='Ser" + item.serialNo + "'>" + item.moduleORSubModule + "</li>";
                            }

                            if (item.level == 3 && item.parentId == 2) {
                                if (item.checked == true) {

                                    apendsubtree = apendsubtree + "<li> <input class='checkboxfield' id='" + item.serialNo + "' type='checkbox' checked/>" + item.moduleORSubModule + "</li>";
                                }
                                else {
                                    apendsubtree = apendsubtree + "<li> <input id='" + item.serialNo + "' class='checkboxfield'  type='checkbox' />" + item.moduleORSubModule + "</li>";
                                }

                            }
                            if (item.level == 3 && item.parentId == 3) {
                                debugger;
                                if (item.checked == true) {

                                    apendsubtreeSales = apendsubtreeSales + "<li> <input class='checkboxfield' id='" + item.serialNo + "' type='checkbox' checked/>" + item.moduleORSubModule + "</li>";
                                }
                                else {
                                    apendsubtreeSales = apendsubtreeSales + "<li> <input id='" + item.serialNo + "' class='checkboxfield'  type='checkbox' />" + item.moduleORSubModule + "</li>";
                                }
                            }
                            if (item.level == 3 && item.parentId == 4) {
                                debugger;
                                if (item.checked == true) {

                                    apendsubtreeOpera = apendsubtreeOpera + "<li> <input class='checkboxfield' id='" + item.serialNo + "' type='checkbox' checked/>" + item.moduleORSubModule + "</li>";
                                }
                                else {
                                    apendsubtreeOpera = apendsubtreeOpera + "<li> <input id='" + item.serialNo + "' class='checkboxfield'  type='checkbox' />" + item.moduleORSubModule + "</li>";
                                }
                            }
                            //if(item.level==3 && item.parentId==3){

                            //}
                        });
                        $("#treeview").append("<ul >" + apendstring + "</ul>");
                        $("#Ser" + 2).append("<ul>" + apendsubtree + "</ul>");
                        $("#Ser" + 3).append("<ul>" + apendsubtreeSales + "</ul>");
                        $("#Ser" + 4).append("<ul>" + apendsubtreeOpera + "</ul>");
                        //  $("#treedemo").jstree();

                    }
                }
            });


        }

        $(document.body).on("click", ".jstree-anchor", function () {
            debugger;
            if ($(this).find(".checkboxfield").is(":checked") == true) {
                $(this).find(".checkboxfield").prop("checked", false);
            }
            else {
                $(this).find(".checkboxfield").prop("checked", true);
            }
        });
        function SubmitRequest() {

            var ApprovalUIArr = new Array();

            $('.checkboxfield').each(function () {
                var ApprovalUI = new Object();


                if ($(this).is(':checked')) {
                    ApprovalUI.SerialNo = parseInt($(this).attr("id"));
                    ApprovalUI.Checked = true;
                    ApprovalUIArr.push(ApprovalUI);

                }
                else {
                    ApprovalUI.SerialNo = parseInt($(this).attr("id"));
                    ApprovalUI.Checked = false;
                    ApprovalUIArr.push(ApprovalUI);
                }


            });

            var ModelData = JSON.stringify(ApprovalUIArr);

            debugger;
            $('#SubmitR').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: "POST",
                url: `/api/Approvals/ActiveApprovalUI`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    debugger;
                    $('#loader').fadeOut();
                    console.log(response);
                    if (response.code === 100) {
                        //notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", "Approval Applied Successfully");
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'Approval Applied Successfully',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }

                }
            });
            debugger;
            $('#SubmitR').prop('disabled', false); //enable
        }

    </script>
}

