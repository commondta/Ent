@model List<HRMS_Web.Services.ErpPlatform.ErpApplication>
@{
    Layout = null;
    var fullName = (ViewBag.FullName as string) ?? "";
    var recent = ViewBag.Recent as List<string> ?? new List<string>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Applications Library · Real Estate MIS</title>
    @* ERP (solution-wide) mark — the single login and the App Launcher carry the solution identity,
       not one application's (docs/brand/ · img/brand/erp/) *@
    @* favicon: a simple home icon (user instruction 2026-08-23) *@
    <link rel="icon" type="image/svg+xml" href="~/img/brand/erp/home-favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/brand/erp/home-favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/brand/erp/home-favicon-16.png">
    <link rel="shortcut icon" href="~/img/brand/erp/home-favicon.ico">
    <style>
        :root { --ink:#111111; --text2:#4D4D4D; --muted:#777777; --border:#E5E5E5; --surface:#F7F7F7; --hover:#F3F3F3; --bg:#FFFFFF; --bar:#242729; }
        * { box-sizing: border-box; }
        html, body { margin:0; min-height:100%; background:var(--bg); color:var(--ink); font-family: Inter, "Segoe UI", Arial, Helvetica, sans-serif; }
        .bar { height:62px; background:var(--bar); color:#fff; display:flex; align-items:center; padding:0 28px; gap:14px; border-bottom:1px solid #1B1D1F; }
        .bar img { width:34px; height:34px; border-radius:7px; background:#fff; padding:3px; }
        .bar img.bar-mark { width:auto; height:36px; padding:0; background:transparent; border-radius:0; }   /* white/gray mark, no tile */
        .tile .ic img { width:30px; height:30px; display:block; }
        .bar .t { font-weight:700; letter-spacing:.08em; font-size:13px; text-transform:uppercase; }
        .bar .s { color:#C9CDD1; font-size:11px; letter-spacing:.08em; text-transform:uppercase; display:block; margin-top:2px; }
        .bar .who { margin-left:auto; color:#C9CDD1; font-size:13px; }
        .bar .who a { color:#fff; text-decoration:none; margin-left:16px; border:1px solid rgba(255,255,255,.3); border-radius:6px; padding:6px 12px; font-size:12.5px; }
        .bar .who a:hover { background:rgba(255,255,255,.1); }
        main { max-width:1040px; margin:0 auto; padding:56px 24px 64px; }
        h1 { font-size:24px; font-weight:700; letter-spacing:-.01em; margin:0 0 6px; }
        .lead { color:var(--text2); font-size:14px; margin:0 0 32px; line-height:1.55; }
        .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:20px; }
        .tile { position:relative; display:flex; flex-direction:column; gap:14px; padding:24px; min-height:190px; border:1px solid var(--border); border-radius:10px; background:var(--bg); color:inherit; text-decoration:none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
        .tile:hover { transform: translateY(-3px); border-color:#BDBDBD; box-shadow: 0 10px 28px rgba(17,17,17,.10); }
        .tile:focus-visible { outline:2px solid var(--ink); outline-offset:3px; }
        .tile .ic { width:48px; height:48px; border-radius:10px; background:var(--ink); color:#fff; display:flex; align-items:center; justify-content:center; }
        .tile .ic svg { width:24px; height:24px; stroke:#fff; fill:none; stroke-width:1.75; stroke-linecap:round; stroke-linejoin:round; }
        .tile h2 { font-size:16px; font-weight:600; margin:0; }
        .tile p { margin:0; color:var(--text2); font-size:13px; line-height:1.5; }
        .tile .go { margin-top:auto; font-size:12.5px; font-weight:600; color:var(--ink); display:inline-flex; align-items:center; gap:6px; }
        .tile .go::after { content:""; width:7px; height:7px; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:rotate(-45deg); transition: transform .18s ease; }
        .tile:hover .go::after { transform: translateX(3px) rotate(-45deg); }
        .tile .badge { position:absolute; top:16px; right:16px; font-size:10.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); border:1px solid var(--border); border-radius:999px; padding:3px 8px; background:var(--surface); }
        .tile .badge.recent { color:var(--ink); border-color:#CFCFCF; background:var(--bg); }
        /* coming-soon: hoverable roadmap tile with a tooltip, not dead UI */
        .tile.is-off { opacity:.65; cursor:default; }
        .tile.is-off:hover { transform:none; box-shadow:none; border-color:#BDBDBD; }
        .tile.is-off .tip { position:absolute; bottom:calc(100% + 10px); left:50%; transform:translateX(-50%); width:max-content; max-width:260px; background:var(--bar); color:#fff; font-size:12px; line-height:1.45; padding:8px 12px; border-radius:7px; opacity:0; visibility:hidden; transition:opacity .18s ease; pointer-events:none; z-index:5; }
        .tile.is-off .tip::after { content:""; position:absolute; top:100%; left:50%; transform:translateX(-50%); border:6px solid transparent; border-top-color:var(--bar); }
        .tile.is-off:hover .tip, .tile.is-off:focus-visible .tip, .tile.is-off:focus-within .tip { opacity:1; visibility:visible; }
        .foot { margin-top:40px; color:var(--muted); font-size:12px; display:flex; gap:10px; align-items:center; }
        .foot img { width:14px; height:14px; border-radius:3px; background:#fff; }
        @@media (prefers-reduced-motion: reduce) { .tile, .tile .go::after, .tile.is-off .tip { transition:none; } }
    </style>
</head>
<body>
    <div class="bar">
        @* launcher: monochrome version of the ERP mark (black / gray / white) for contrast; the colour mark stays the favicon *@
        <img src="~/img/brand/erp/erp-mark-white.svg" alt="" class="bar-mark">
        <div><span class="t">Real Estate Management Solution</span><span class="s">Applications Library</span></div>
        <div class="who">@fullName <a href="/Login/SignOut">Sign out</a></div>
    </div>
    <main>
        <h1>Choose the workspace you want to access.</h1>
        <p class="lead">You can switch applications anytime from the workspace menu.</p>
        <div class="grid">
            @{
                // one tile body for both shapes: live tiles are links, coming-soon tiles are
                // hoverable roadmap tiles (tooltip instead of a dead pointer-events:none block)
                Func<HRMS_Web.Services.ErpPlatform.ErpApplication, Microsoft.AspNetCore.Html.IHtmlContent> tileBody = @<text>
                    @if (!item.IsActive) { <span class="badge">Coming soon</span><span class="tip" role="tooltip">Planned — @item.Name arrives in a later phase of the rollout.</span> }
                    else if (recent.Contains(item.Code, StringComparer.OrdinalIgnoreCase)) { <span class="badge recent">Recently used</span> }
                    <span class="ic" aria-hidden="true">
                        @if (item.Code == "PMS") { <svg viewBox="30.94 -6 753.91 852" style="fill:#fff;stroke:none"><path fill-rule="evenodd" d="M277,364.93 L374,401.9 L374,620.54 L407.9,601.47 L438,618.4 L438,236 L599,174.74 L599,59.23 L437.93,0 L277,59.14Z M613,179.33 L613,184.39 L599,189.72 L599,708.98 L762,800.68 L762,236.08Z M277,379.91 L263,374.58 L263,360.25 L211.28,340.47 L50,401.92 L50,802.82 L277,675.11Z"/><path fill-rule="evenodd" fill-opacity="0.72" d="M778.86,840 L407.9,631.3 L36.94,840 L128.48,840 L407.9,682.8 L687.32,840Z"/><path d="M373.4,742 L403.4,742 L403.4,712 L373.4,712Z M412.4,742 L442.4,742 L442.4,712 L412.4,712Z M373.4,781 L403.4,781 L403.4,751 L373.4,751Z M412.4,781 L442.4,781 L442.4,751 L412.4,751Z"/></svg> }
                        else if (item.Code == "LIMS") { <img src="/img/lims-logo-white.svg" alt=""> }
                        else if (item.Code == "PAYROLL") { <svg viewBox="40 117 394 245" style="fill:#fff;stroke:none"><defs><mask id="pmtile" maskUnits="userSpaceOnUse" x="0" y="0" width="474" height="474"><rect width="474" height="474" fill="#fff"/><circle cx="237" cy="160" r="61" fill="#000"/><path d="M137 362V295c0-22 8-39 24-51 12-9 26-13 42-13h17l17 30 17-30h17c16 0 30 4 42 13 16 12 24 29 24 51v67Z" fill="#000" stroke="#000" stroke-width="28" stroke-linejoin="round"/></mask></defs><g fill="#fff"><g mask="url(#pmtile)"><circle cx="113" cy="160" r="43"/><path d="M40 314V263c0-22 8-38 24-50 12-9 26-13 40-13h19c17 0 30 5 41 14 8 6 14 15 18 25V314Z"/><circle cx="361" cy="160" r="43"/><path d="M434 314V263c0-22-8-38-24-50-12-9-26-13-40-13h-19c-17 0-30 5-41 14-8 6-14 15-18 25V314Z"/></g><circle cx="237" cy="160" r="47"/><path d="M137 362V295c0-22 8-39 24-51 12-9 26-13 42-13h17l17 30 17-30h17c16 0 30 4 42 13 16 12 24 29 24 51v67Z"/></g></svg> }
                        else { <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg> }
                    </span>
                    <h2>@item.Name</h2>
                    <p>@item.Description</p>
                    <span class="go">@(item.IsActive ? "Open Application" : "Not available yet")</span>
                </text>;
            }
            @foreach (var app in Model)
            {
                if (app.IsActive)
                {
                    <a class="tile" href="@Url.Action("Go", "Apps", new { code = app.Code })">@tileBody(app)</a>
                }
                else
                {
                    <div class="tile is-off" tabindex="0" aria-disabled="true">@tileBody(app)</div>
                }
            }
        </div>
        <div class="foot"><span>Powered by</span><img src="~/img/n-stack-logo.png" alt=""><strong style="color:#111">N-Stack</strong></div>
    </main>
    <script>
        // Pre-authenticate the other applications the moment this page shows: the same
        // erp_sso cookie goes along, LIMS signs the user in on its side, and the tile
        // opens instantly with no login page.
        (function () {
            var prefix = '@(ViewBag.LimsPrefix ?? "/lims")';
            try { fetch(prefix + '/erp/touch', { credentials: 'same-origin', cache: 'no-store' }).catch(function () {}); } catch (e) {}
            try { fetch('@(ViewBag.PayrollPrefix ?? "/payroll")' + '/erp/touch', { credentials: 'same-origin', cache: 'no-store' }).catch(function () {}); } catch (e) {}
        })();
    </script>
</body>
</html>
