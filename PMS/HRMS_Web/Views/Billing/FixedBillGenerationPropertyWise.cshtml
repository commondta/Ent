        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResultWithMemberProfile?stock=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
