                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {

                        var result_User = response.data;

                        // set values
                        let isBillGenerationEnabled = result_User.isBillGenerationEnabled == true ? "true" : "false";
                        let isSaleTaxEnabled = result_User.isSaleTaxEnabled == true ? "true" : "false";
                        let isWithHoldingTaxEnabled = result_User.isWithHoldingTaxEnabled == true ? "true" : "false";

                        $("#ID").val(result_User.id);
                        $("#PrincipalMember").val(result_User.memberProfile.memberName);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phaseName);
                        $("#Block").val(result_User.blockName);
                        $("#Project").val(result_User.projectName);
                        $("#Type").val(result_User.typeName);
                        $("#Category").val(result_User.categoryName);
                        $("#Nature").val(result_User.natureName);
                        $("#REType").val(result_User.realStateTypeName);
                        $("#GeneratorUnitType").val(result_User.generatorUnitType);
                        $("#MaintenceAdvanceBillPaid").val(result_User.maintenceAdvanceBillPaid);
                        $("#BillPrintRegistrationNo").val(result_User.billPrintRegistrationNo);
                        $("#BillPrintPropertyNo").val(result_User.billPrintPropertyNo);
                        $("#BillPrintName").val(result_User.billPrintName);
                        $("#BillPrintAddress").val(result_User.billPrintAddress);
                        $("#IsBillGenerationEnabled").val(isBillGenerationEnabled);
                        $("#IsSaleTaxEnabled").val(isSaleTaxEnabled);
                        $("#IsWithHoldingTaxEnabled").val(isWithHoldingTaxEnabled);
                        $("#memberProfileId").val(result_User.memberProfile.id);
                        $("#stockCreationId").val(result_User.id);

                        PropertyDetail(result_User.id);
                        GetAllWTaxPropertyWise(result_User.id);
                        GetFixedChargesPropertyWise(result_User.id);
                        GetTanantDetail(result_User.id);

