@section Scripts {

    <script>

        $(document).ready(function () {
            GetAllPropertyLists();
            // GetAllMemberProfiles();
            //  GetAllChangeOwnerList();
        });

        // W Tax Setup

        function GetAllWTaxPropertyWise(id) {

            debugger

            var url = "/api/Filter/GetAllWTaxPropertWise?stockId=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#wTaxtbody").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {
                                var isEnabled = list.isEnabled == true ? "checked" : "";
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td class="hide"> <input   type="text"  class="form-control id" value="' + list.matchId + '" /></td>' +
                                    '<td> <input disabled  type="text"  class="form-control taxCode" value="' + list.taxCode + '" /></td>' +
                                    '<td> <input disabled type="text"  class="form-control rate" value="' + list.rate + '" /></td>' +
                                    '<td> <input ' + isEnabled + ' class="checkboxfield isEnabled"  type = "checkbox"   /> </td>' +
                                    '</tr>';
                                $("#wTaxtbody").append(row);
                                sr++;

                            }
                        }

                        else {
                            GetAllWTax();
                        }
                    }
                }
            });
        }

        function GetAllWTax() {
            debugger

            var url = "/api/WithHoldingTax/GetAll";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#wTaxtbody").empty();

                        debugger;
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td class="hide"> <input   type="text"  class="form-control id" value="' + list.id + '" /></td>' +
                                    '<td> <input disabled  type="text"  class="form-control taxCode" value="' + list.taxCode + '" /></td>' +
                                    '<td> <input disabled type="text"  class="form-control rate" value="' + list.rate + '" /></td>' +
                                    '<td> <input  class="checkboxfield isEnabled"  type = "checkbox"   /> </td>' +
                                    '</tr>';
                                $("#wTaxtbody").append(row);
                                sr++;

                            }
                        }
                    }
                }
            });
        }

        // Fixed Charges

        function GetFixedChargesPropertyWise(id) {

            debugger;

            var url = "/api/Filter/GetAllFixedChargesPropertWise?stockId=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#fChargetbody").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {
                                var isEnabled = list.isEnabled == true ? "checked" : "";
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td class="hide"> <input   type="text"  class="form-control id" value="' + list.matchId + '" /></td>' +
                                    '<td class="hide"> <input   type="text"  class="form-control globalChargeSetupId" value="' + list.globalChargeSetupId + '" /></td>' +
                                    '<td> <input disabled  type="text"  class="form-control chargeType" value="' + list.chargeType + '" /></td>' +
                                    '<td> <input disabled  type="text"  class="form-control chargeDes" value="' + list.chargeDes + '" /></td>' +
                                    '<td> <input  type="number"   class="form-control unit" value="' + list.unit + '" /></td>' +
                                    '<td> <input disabled type="text" class="form-control chargeSetupRate" value="' + list.chargeSetupRate + '" /></td>' +
                                    '<td> <input  type="text"  class="form-control rate" value="' + list.rate + '" /></td>' +
                                    '<td> <input  type="number"  class="form-control discount" value="' + list.discount + '" /></td>' +
                                    '<td> <input ' + isEnabled + ' class="checkboxfield isEnabled"  type = "checkbox"   /> </td>' +
                                    '</tr>';
                                $("#fChargetbody").append(row);
                                sr++;

                            }
                        }

                        else {
                            GetAllFixedCharges(id);
                        }
                    }
                }
            });
        }

        function GetAllFixedCharges(id) {

            var url = "/api/Filter/GetAllFixedCharges?stockId=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#fChargetbody").empty();

                        debugger;
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {
