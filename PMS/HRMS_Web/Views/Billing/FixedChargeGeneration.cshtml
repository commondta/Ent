        function DiscardRequest() {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    var month = $("#month").val();
                    var billFor = $("#BillFor").val();
                    if ($("#month") != "" && $("#BillFor") != "") {
                        Discard(month, billFor);
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: 'Please select month and Bill For',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })


            // $("#DeleteID").val(id);

        }
        function Discard(month, billFor) {

            var methodType = 'Delete';
            var url = "/api/FixedChargeGeneration/Discard?month=" + month + "&billFor=" + billFor;
            $('#btn_discard').prop('disabled', true); //disble
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',

                success: function (response) {

                    if (response.code == 100) {

                        $('#loader').fadeOut();
