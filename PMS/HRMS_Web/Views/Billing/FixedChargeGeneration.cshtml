        function RunBoth() {

            if ($("#FortheMonth") != "") {

                let month = $("#FortheMonth").val();
                let gracePeriodDate = $("#demarGraceDate").val();

                var methodType = 'GET';
                var url = "/api/FixedChargeGeneration/AddNewMonthlyFixedCharges?month=" + month + "&gracePeriodDate=" + gracePeriodDate;
                $('#Submit').prop('disabled', true); //disble
                NProgress.start();
                NProgress.set(0.0);
                $('#loader').fadeIn();
                $.ajax({
                    type: methodType,
                    url: url,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    dataType: "json",
                    success: function (response) {

                        if (response.code === 100) {
                            $('#loader').fadeOut();
                            NProgress.done();
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else if (response.code === 4) {
                            NProgress.done();
                            $('#loader').fadeOut();
                            Swal.fire({
                                icon: 'warning',
                                title: 'Warning',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            })
                        }
                        else {
                            NProgress.done();
                            $('#loader').fadeOut();
                            Swal.fire({
                                icon: 'error',
                                title: 'error',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            })
                        }
                    }
                });
            }
            else {
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: 'Please select month',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                })
            }
            $('#Submit').prop('disabled', false); //enable
        }

