                    <h1>FIXED CHARGES BILL GENERATION</h1>

                    <div class="vd_panel-menu  hidden-xs">

                        <div class="menu">

                            @*  <a class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal">Add New</a>*@

                        </div>
                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        <!-- Form Section 3 -->
                        <div class="row form-section">
                            <div class="col-md-12">
                                <form class="custom-validation" id="UpdateGraceBill">
                                    <div class="form-row">
                                        <div class="form-group col-sm-6">
                                            <label for="gracePeriodDate">Set Grce Peroid Date:</label>
                                            <input type="date" required class="form-control" id="gracePeriodDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder=" ">
                                        </div>
                                    </div>
                                    <div class="form-group" style="display: flex; align-items: flex-end;">
                                        <a onclick="updateGraceDate()" id="btn_grace" class="btn btn-primary" style="margin-top: 25px">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Update
                                        </a>
                                        <a onclick="updateAndInsert()" id="btn_grace" class="btn btn-primary" style="margin-top: 25px">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Update & Insert
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="row form-section">
                            <div class="col-md-12">
                                <form class="custom-validation" id="FixedBill">
                                    <div class="form-row">
                                        <div class="form-group col-sm-4">
                                            <label for="FortheMonth">For the Month</label>
                                            <input type="month" required class="form-control" id="FortheMonth" placeholder=" ">
                                        </div>
                                        <div class="form-group col-sm-4">
                                            <label for="demarGraceDate">Grace/Demarcation Date</label>
                                            <input type="date" class="form-control" id="demarGraceDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder=" ">
                                        </div>
                                    </div>
                                    <div class="form-group" style="display: flex; align-items: flex-end; gap-2">
                                        <a type="button" onclick="RunConstructed()" id="Submitp" class="btn btn-primary" style="margin-top: 25px">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Run Constructed
                                        </a>
                                        <a type="button" onclick="RunNonConstructed()" id="Submitpp" class="btn btn-primary" style="margin-top: 25px">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Run Non-Constructed
                                        </a>
                                        <a type="button" onclick="RunBoth()" id="Submit" class="btn btn-primary" style="margin-top: 25px">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Run Both
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Form Section 2 -->
                        <div class="row form-section">
                            <div class="col-md-12">
                                <form class="custom-validation" id="AnotherBill">
                                    <div class="form-row">
                                        <div class="form-group col-sm-3">
                                            <label for="month">For the Month</label>
                                            <input type="month" required class="form-control" id="month" placeholder=" ">
                                        </div>
                                        <div class="form-group col-sm-3">
                                            <label>Bill For</label>
                                            <div>
                                                <select name="BillFor" class="js-example-basic-single" id="BillFor">
                                                    <option value=""> -- Select Option --</option>
                                                    <option value="Constructed">Constructed</option>
                                                    <option value="Non-Constructed">Non-Constructed</option>
                                                    <option value="Fixed Dues">Fixed Charges</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display: flex; align-items: flex-end; justify-content:space-between">
                                        <a onclick="DiscardRequest()" id="btn_discard" class="btn btn-danger" style="margin-top: 25px">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Discard
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- .vd_content-section -->
        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>

<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

