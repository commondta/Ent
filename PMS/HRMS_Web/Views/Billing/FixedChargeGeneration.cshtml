                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    var month = $("#gracePeriodDate").val();
                    if ($("#gracePeriodDate") != "") {
                        GraceDate(month);
                    }
                    else {
                        Swal.fire({
