@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

           // $('#proplist').dataTable();
            GetAllPropertyLists();

        });
        
        $("#BillFor").change(function () {
            let readingFor = $(this).val();
            let month = $("#FortheMonth").val();
            let regno = $("#RegistrationNo").val();

            if (month != "" && regno !="" && readingFor == "Fixed Dues")
            {
                GetAllFixedBillDetial(readingFor, month, regno);
               // calculateBill();
            }

            if (month != "" && readingFor != "Fixed Dues" && regno != "") {
                GetAllBillDetial(readingFor, month, regno);
               // calculateBill();
            }
        });

        $("#FortheMonth").change(function () {
            var  month= $(this).val();
            var readingFor = $("#BillFor").val();
            let regno = $("#RegistrationNo").val();

            if (month != "" && regno != "" && readingFor == "Fixed Dues") {
                GetAllFixedBillDetial(readingFor, month, regno);
               // calculateBill();
            }

            if(month != "" && readingFor != "Fixed Dues" && regno != "") {
                GetAllBillDetial(readingFor, month, regno);
               // calculateBill();
            }
        });

        function GetAllBillDetial(readingFor, month, regno) {

            debugger;
            var url = "/api/Filter/GetDetailsFromMeterBillGeneration?readingFor=" + readingFor + "&month=" + month + "&regno=" + regno;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        debugger;

                        var readingFor = $("#BillFor").val();

                        $("#IBGeneratetbody").empty();

                        var model = response.data;

                        var relist = model.meterBillGenerationDetail;
                        if (relist != null && relist.length > 0) {
                            debugger;
                            var sr = 1;

                            for (let list of relist) {

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td class="hide"> <input class="form-control   Id" value="' + list.id + '" /></td>' +
                                    '<td> <input id="billType_' + sr + '" class="form-control   billType" value="' + readingFor + '" /></td>' +
                                    '<td> <input id="description_' + sr + '" class="form-control   description" value="' + readingFor + '" /></td>' +
                                    '<td> <input type="number" disabled name="amount1" class="form-control  amount1" value="' + list.amount + '" /></td>' + 
                                    '<td> <input type="number" onkeyup="calculateGrossAmountSurcharge(event)" name="surcharge" class="form-control  surcharge" value="' + list.surcharge + '" /></td>' +
                                    '<td> <input type="text" name="otherduesdescription" class="form-control  otherduesdescription" value="' + list.otherDuesDescription + '" /></td>' +
                                    '<td> <input type="number" onkeyup="calculateGrossAmount(event)" name="amount2" class="form-control  amount2"  value="' + list.otherDuesAmount + '" /></td>' +
                                    '<td> <input type="number" disabled name="saleTax" class="form-control  saleTax" value="' + list.saleTax + '" /></td>' +
                                    '<td> <input type="number" disabled name="saleTaxAmount"  class="form-control  saleTaxAmount" value="' + list.saleTaxAmount + '" /></td>' +                                   
                                    '<td> <input type="number" disabled name="grossAmount" class="form-control  grossAmount" value="' + list.grossAmount + '" /></td>' +
                                    '<td> <input type="number" onkeyup="calculateNetAmount(event)" name="discount" class="form-control  discount"  value="' + list.discount + '" /></td>' +
                                    '<td> <input type="number" disabled name="netAmount" class="form-control  netAmount" value="' + list.netAmount + '" /></td>' +
                                    '<td> <input type="number" disabled name="wTaxAmount"  class="form-control  wTaxAmount" value="' + list.wTaxAmount + '" /></td>' +
                                    '</tr>';
                                $("#IBGeneratetbody").append(row);

                                sr++;
                            }
                        }
                    }
                }
            });
        }

        function GetAllFixedBillDetial(readingFor, month, regno) {

            debugger;
            var url = "/api/Filter/GetDetailsFromFixedChargeBillGeneration?readingFor=" + readingFor + "&month=" + month + "&regno=" + regno;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        var readingFor = $("#BillFor").val();

                        $("#IBGeneratetbody").empty();

                        var model = response.data;

                        $("#wTaxAmount").val(model.wTaxAmount);
                        $("#total").val(model.totalAmount);

                        var relist = model.fixedChargeBillDetail;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td class="hide"> <input class="form-control   Id" value="' + list.id + '" /></td>' +
                                    '<td> <input id="billType_' + sr + '" class="form-control   billType" value="' + list.billType + '" /></td>' +
                                    '<td> <input id="description_' + sr + '" class="form-control   description" value="' + list.description + '" /></td>' +
                                    '<td> <input type="number" disabled name="amount1" class="form-control  amount1" value="' + list.amount + '" /></td>' +
                                    '<td> <input type="number" onkeyup="calculateGrossAmountSurcharge(event)" name="surcharge" class="form-control  surcharge" value="' + list.surcharge + '" /></td>' +
                                    '<td> <input type="text" name="otherduesdescription" class="form-control  otherduesdescription" value="' + list.otherDuesDescription + '" /></td>' +
                                    '<td> <input type="number" onkeyup="calculateGrossAmount(event)" name="amount2" class="form-control  amount2"  value="' + list.otherDuesAmount + '" /></td>' +
                                    '<td> <input type="number" disabled name="saleTax" class="form-control  saleTax" value="' + list.saleTax + '" /></td>' +
                                    '<td> <input type="number" disabled name="saleTaxAmount"  class="form-control  saleTaxAmount" value="' + list.saleTaxAmount + '" /></td>' +                                   
                                    '<td> <input type="number" disabled name="grossAmount" class="form-control  grossAmount" value="' + list.grossAmount + '" /></td>' +
                                    '<td> <input type="number" diaabled onkeyup="calculateNetAmount(event)" name="discount" class="form-control  discount"  value="' + list.discount + '" /></td>' +
                                    '<td> <input type="number" disabled name="netAmount" class="form-control  netAmount" value="' + list.netAmount + '" /></td>' +
                                    '<td> <input type="number" disabled name="wTaxAmountLine"  class="form-control  wTaxAmountLine" value="' + list.wTaxAmountLine + '" /></td>' +
                                    '</tr>';
                                $("#IBGeneratetbody").append(row);

                                sr++;
                            }
                            
                        }
                    }
                }
            });
        }

        function GetAllPropertyLists() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetAllProperiesForIndiviualBillGenration`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        debugger;
                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    //' <td class="sr">' + sr + '</td> ' +
                                    ' <td class="stockId">' + list.id + '</td> ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="memberName">' + list.memberName + '</td>       ' +
                                    ' <td class="memberCode">' + list.memberCode + '</td> ' +
                                     '<td><a class="btn btn-primary" onclick="SelectRegistration(this)" >Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(el) {

            var stockCreationId = $(el).parents('tr').find(".stockId").text();
            var property = $(el).parents('tr').find(".propertyNo").text();
            var Registration = $(el).parents('tr').find(".registrationNo").text();
            var memberName = $(el).parents('tr').find(".memberName").text();
            var memberCode = $(el).parents('tr').find(".memberCode").text();

            $("#StockCreationId").val(stockCreationId);
            $("#RegistrationNo").val(Registration);
            $("#PropertyNo").val(property);
            $("#MemberName").val(memberName);
            $("#MemberCode").val(memberCode);
            $("#registrationModal").modal("hide");
            PropertyDetail(stockCreationId);
            ShowAlert(stockCreationId);

            let month = $("#FortheMonth").val();
            let readingFor = $("#BillFor").val();
            let regno = $("#RegistrationNo").val();

            if (month != "" && regno != "" && readingFor !="" && readingFor == "Fixed Dues") {
                GetAllFixedBillDetial(readingFor, month, regno);
                //calculateBill();
            }

            if (month != "" && readingFor != "Fixed Dues" && regno != "" && readingFor != "") {
                GetAllBillDetial(readingFor, month, regno);
                //calculateBill();
            }
        }

