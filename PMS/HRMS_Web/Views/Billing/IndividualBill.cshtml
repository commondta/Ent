        function calculateGrossAmountSurcharge(event) {

            let tr = event.target.closest('tr');
            let saleTaxAmount = tr.querySelector('input[name="saleTaxAmount"]').value == "" ? 0 : tr.querySelector('input[name="saleTaxAmount"]').value;
            let wTaxAmount = tr.querySelector('input[name="wTaxAmount"]').value == "" ? 0 : tr.querySelector('input[name="wTaxAmount"]').value;
            let amount1 = tr.querySelector('input[name="amount1"]').value == "" ? 0 : tr.querySelector('input[name="amount1"]').value;
            let amount2 = tr.querySelector('input[name="amount2"]').value == "" ? 0 : tr.querySelector('input[name="amount2"]').value;
            let result = parseInt(saleTaxAmount) + parseInt(amount1) + parseInt(amount2) + parseInt(event.target.value);
            tr.querySelector('input[name="grossAmount"]').value = result;

            let discount = tr.querySelector('input[name="discount"]').value == "" ? 0 : tr.querySelector('input[name="discount"]').value;
            tr.querySelector('input[name="netAmount"]').value = result - parseInt(discount);
        }

        function calculateGrossAmount(event) {
    
            let tr = event.target.closest('tr');
            let saleTaxAmount = tr.querySelector('input[name="saleTaxAmount"]').value == "" ? 0 : tr.querySelector('input[name="saleTaxAmount"]').value;
            let wTaxAmount = tr.querySelector('input[name="wTaxAmount"]').value == "" ? 0 : tr.querySelector('input[name="wTaxAmount"]').value;
            let amount1 = tr.querySelector('input[name="amount1"]').value == "" ? 0 : tr.querySelector('input[name="amount1"]').value;
            let surcharge = tr.querySelector('input[name="surcharge"]').value == "" ? 0 : tr.querySelector('input[name="surcharge"]').value;

            let result = parseInt(saleTaxAmount) + parseInt(amount1) + parseInt(surcharge) + parseInt(event.target.value);
            tr.querySelector('input[name="grossAmount"]').value = result;

            let discount = tr.querySelector('input[name="discount"]').value == "" ? 0 : tr.querySelector('input[name="discount"]').value;
            tr.querySelector('input[name="netAmount"]').value = result - parseInt(discount);
        }

        function calculateNetAmount(event) {

            let tbody = document.querySelector('#IBGeneratetbody');

            let tr = event.target.closest('tr');
            let amount = tr.querySelector('input[name="grossAmount"]').value;
            let result = parseInt(amount) - parseInt(event.target.value);
            tr.querySelector('input[name="netAmount"]').value = result;
        }

        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/IndividualBill/AddNewIndividualBill";

            var individualBillGeneration = new Object();

            var individualBillGenerationDetailArr = new Array();

            //if ($("#Id").val()) {

            //    debugger;

            //    meterInstallation.id = parseInt($("#Id").val());
            //    methodType = 'PUT';
            //    url = "/api/MeterInstallation/UpdateMeterInstallation"
            //}

            individualBillGeneration.Month = $('#FortheMonth').val();
            individualBillGeneration.BillFor = $('#BillFor').val();
            individualBillGeneration.RegistrationNo = $('#RegistrationNo').val();
            individualBillGeneration.StockCreationID = $('#StockCreationId').val();
            individualBillGeneration.CreatedBy = $("#User_Id").val();
            individualBillGeneration.ModifiedBy = $("#User_Id").val();
            individualBillGeneration.LastModifiedUserName = $("#User_Name").val();
           
            $('#IBGeneratetbody tr').each(function () {

                var row = $(this);
                var individualBillGenerationDetail = new Object();

                individualBillGenerationDetail.Id = row.find('.Id').val();
                individualBillGenerationDetail.BillType = row.find('.billType').val();
                individualBillGenerationDetail.Description = row.find('.description').val();
                individualBillGenerationDetail.Amount = row.find('.amount1').val();
                individualBillGenerationDetail.Surcharge = row.find('.surcharge').val();
                individualBillGenerationDetail.OtherDuesDescription = row.find('.otherduesdescription').val();
                individualBillGenerationDetail.OtherDuesAmount = row.find('.amount2').val();
                individualBillGenerationDetail.GrossAmount = row.find('.grossAmount').val();
                individualBillGenerationDetail.Discount = row.find('.discount').val();
                individualBillGenerationDetail.NetAmount = row.find('.netAmount').val();

                individualBillGenerationDetailArr.push(individualBillGenerationDetail);
            });


            individualBillGeneration.IndividualBillDetail = individualBillGenerationDetailArr;

            var model = JSON.stringify(individualBillGeneration);
     
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: model,
                success: function (response) {

                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
        }
    </script>
 }
