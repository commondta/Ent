                                <div class="col-sm-6">
                                    <label>Reference No.</label>
                                    <div class="search_btn">
                                        <div class="input_div">
                                            <input style="" type="text" class="form-control" disabled name="RegistrationNo"
                                                   placeholder="" id="RegistrationNo" />

                                        </div>
                                        <div >
                                            <button data-toggle="modal" data-target="#registrationModal" type="button" class="btn btn-sm dha_theme_btn" 
                                            >Search</button>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-sm-6">
                                    <label>Property No.</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="PropertyNo" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <label>Member Name</label>
