                            <div >
                                <div class="card p-3">
                                    <div >
                                        <br>
                                        <br>
                                        <div class="table-responsive">
                                            <table id="IBillGenerate" class="table table-bordered table-hover mb-0">
                                                <thead class="bg-theme">
                                                    <tr>
                                                        <th class="text-white" style="min-width: 90px;">#</th>
                                                        <th class="text-white hide" style="min-width: 160px;">Id</th>
                                                        <th class="text-white" style="min-width: 160px;">Bill Type</th>
                                                        <th class="text-white" style="min-width: 160px;">Charge Type</th>
                                                        <th class="text-white" style="min-width: 130px;">Amount</th>
                                                        <th class="text-white" style="min-width: 130px;">Surcharge</th>
                                                        <th class="text-white" style="min-width: 170px;">Other Dues Description</th>
                                                        <th class="text-white" style="min-width: 130px;">Amount</th>
                                                        <th class="text-white" style="min-width: 130px;">Sale Tax %</th>
                                                        <th class="text-white" style="min-width: 130px;">Sale Tax Amount</th>
                                                        <th class="text-white" style="min-width: 130px;">Gross Amount</th>
                                                        <th class="text-white" style="min-width: 130px;">Discount</th>
                                                        <th class="text-white" style="min-width: 130px;">Net Amount</th>
                                                        <th class="text-white" style="min-width: 130px;">W Tax Amount</th>
                                                </thead>
                                                <tbody id="IBGeneratetbody">
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
