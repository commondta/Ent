                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Member Code</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="MemberCode" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-3">
                                    <label>For the Month</label>
                                    <div>
                                        <input type="month" class="form-control"
                                               placeholder=" " id="FortheMonth"/>
                                    </div>
                                </div>
                                <div class="col-sm-3">
