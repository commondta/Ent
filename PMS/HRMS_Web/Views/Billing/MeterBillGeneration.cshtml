<input id="rownumberforid" class="hide" value="0" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

            $('#registrationNO').dataTable();

            //var today = new Date();
            //var currentMonth = today.toISOString().slice(0, 7);
            //$('#FuelAjustedMonth').attr('max', currentMonth);

            //var today = new Date();
            //var currentMonth = today.toISOString().slice(0, 7); 
            //$('#FortheMonth').attr('min', currentMonth);

        });

        $("#BillFor").change(function () {
            let readingFor = $(this).val();
            let month = $("#FortheMonth").val();
            let fuelAjustedMonth = $("#FuelAjustedMonth").val();

            if (month != "" && readingFor != "") {
                GetAllBillDetial(readingFor, month, fuelAjustedMonth);
                calculateBill();
            }
        });

        $("#FortheMonth").change(function () {
            let  month= $(this).val();
            let readingFor = $("#BillFor").val();
            let fuelAjustedMonth = $("#FuelAjustedMonth").val();

            if(month != "" && readingFor != "") {
              GetAllBillDetial(readingFor, month, fuelAjustedMonth);
              calculateBill();
            }
        });

        $("#FuelAjustedMonth").change(function () {
            let fuelAjustedMonth = $(this).val();
            let readingFor = $("#BillFor").val();
            let month = $("#FortheMonth").val();

            if (month != "" && readingFor != "") {
                GetAllBillDetial(readingFor, month, fuelAjustedMonth);
                calculateBill();
            }
        });

        function GetAllBillDetial(readingFor, month, fuelAjustedMonth) {

            var url = "/api/Filter/GetMeterReadingForBillGenration?readingFor=" + readingFor + "&month=" + month + "&fuelAjustedMonth=" + fuelAjustedMonth;
            NProgress.start();
            NProgress.set(0.4);
            $('#loader').fadeIn();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    $('#loader').fadeOut();
                    NProgress.done();
                    if (response.code == 100) {

                       
                        $("#MeterGeneratetbody").empty();

                        var model = response.data;

                        var relist = model;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td> <input disabled id="regNo_' + sr + '" class="form-control   registrationNo" /></td>' +
                                    '<td> <input disabled id="propNo_' + sr + '" class="form-control   propertyNo"  /></td>' +
                                    '<td class="hide"> <input disabled name="sapAccount" id="sapAccount_' + sr + '" class="form-control   SapAccount"  /></td>' +
                                    '<td class="hide"> <input disabled name="wTax" id="wTax_' + sr + '" class="form-control   wTax"  /></td>' +
                                    '<td class="hide"> <input disabled name="PreviousReading"  class="form-control   PreviousReading" value="' + list.lastReading + '" /></td>' +
                                    '<td class="hide"> <input disabled name="CurrentReading"  class="form-control   CurrentReading" value="' + list.currentReading + '" /></td>' +
                                    '<td> <input disabled class="form-control  meterNo" value="' + list.meterNo + '" /></td>' +
                                    '<td> <input type="number" disabled name="totalUnitConsumed" class="form-control  totalUnitConsumed" value="' + list.unitsConsumed + '" /></td>' +
                                    '<td> <input type="number" disabled name="perUnitRate" id="unitrate_' + sr + '" class="form-control  perUnitRate" value="0" /></td>' +
                                    '<td> <input type="number" disabled name="fuelAdjustedUnit" class="form-control  fuelAdjustedUnit" value="' + list.fuelAdjustedUnits + '" /></td>' +
                                    '<td> <input type="number" disabled name="fuelAdjustment" id="fuelrate_' + sr + '" class="form-control  fuelAdjustment" value="0" /></td>' +
                                    '<td> <input type="number" disabled name="saleTax" class="form-control  saleTax" value="' + list.saleTax + '" /></td>' +
                                    '<td> <input type="number" disabled name="saleTaxAmount"  class="form-control  saleTaxAmount" value="0" /></td>' +
                                    '<td> <input type="number" disabled name="grossAmount" class="form-control  grossAmount" value="0" /></td>' +
                                    '<td> <input type="number" onkeypress="validateNumberInput(event)" onkeyup="calculateNetAmount(event)" name="discount" class="form-control  discount" value="0" /></td>' +
                                    '<td> <input type="number" disabled name="netAmount" class="form-control  netAmount" value="0" /></td>' +
                                     '<td> <input type="number" disabled name="wTaxAmount"  class="form-control  wTaxAmount" value="0" /></td>' +
                                    '</tr>';
                                $("#MeterGeneratetbody").append(row);

                                GetMeter(sr, list.meterNo);
                                sr++;
                            }
                        }
                       
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
        }

        function GetMeter(sr, meterNo){
            $("#rownumberforid").val(sr);
            SelectProperty(meterNo);
        }

        function SelectProperty(meterNo) {

            var url = "/api/Filter/GetPropertyForBillGenrationByMeterNo?meterNo=" + meterNo + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { meterNo: meterNo },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                   
                    if (response.code === 100) {
                        var result = response.data;
                        var rownumber = $("#rownumberforid").val();
                        $("#regNo_" + rownumber).val(result.registrationNo);
                        $("#propNo_" + rownumber).val(result.propertyNo);

                        GetWTax(result.id);

                        var obj = new Object();

                        obj.RealStateTypeId = result.realStateType;
                        obj.ProjectId = result.project;
                        obj.PhaseId = result.phase;
                        obj.BlockId = result.block;
                        obj.CategoryId = result.category;
                        obj.PropertyTypeId = result.type;
                        obj.NatureId = result.nature;
                        obj.GeneratorUnitType = result.generatorUnitType;

                        getchargesdata(obj);
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }

            });
        }

        function getchargesdata(obj) {
            
            var ModelData = JSON.stringify(obj);
    
            $.ajax({
                type: "POST",
                url: `/api/Filter/GetGlobalChargeDetail/?formId=2`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    debugger;
                    if (response.code == 100) {
                        if (response.data != null) {

                            let perUnit = response.data.globalChargeDetail[0].rate;
                            let sapAccount = response.data.globalChargeDetail[0].sapAccount;
                            let fuelAdjustment = $("#FuelPrice").val();

                            var rownumber = $("#rownumberforid").val();
                            $("#unitrate_" + rownumber).val(perUnit);
                            $("#fuelrate_" + rownumber).val(fuelAdjustment);
                            $("#sapAccount_" + rownumber).val(sapAccount);
                        }
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }

            });
        }

         function GetWTax(id) {

            var url = "/api/Filter/GetWTax?id=" + id + "";

            $.ajax({
                type: "GET",
                url : url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                success: function (response) {
                    debugger;
                    if (response.code == 100) {
                        if (response.data != null) {

                            let wTax = response.data;
                            
                            var rownumber = $("#rownumberforid").val();
                            $("#wTax_" + rownumber).val(wTax);
                        }
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }

            });
        }

        function calculateBill() {
            const tbody = document.querySelector('#MeterGeneratetbody');
            let totalUnits = 0.00;
            let totalAmount = 0.00;

            tbody.querySelectorAll('tr').forEach((tr) => {
                debugger;
                
                let totalUnitConsumed = parseFloat(tr.querySelector('input[name="totalUnitConsumed"]').value);
                let perUnitRate = parseFloat(tr.querySelector('input[name="perUnitRate"]').value);
                let fuelAdjustment = parseFloat(tr.querySelector('input[name="fuelAdjustment"]').value);
                let fuelAdjustedUnit = parseFloat(tr.querySelector('input[name="fuelAdjustedUnit"]').value);
                let wTax = parseFloat(tr.querySelector('input[name="wTax"]').value);
                let saleTax = parseFloat(tr.querySelector('input[name="saleTax"]').value);
                
                let totalunitBill = totalUnitConsumed * perUnitRate;
                let totalfuelAdjustmentBill = fuelAdjustedUnit * fuelAdjustment;
                let total = totalunitBill + totalfuelAdjustmentBill;
                
                let saleTaxAmount = total * (saleTax / 100);
                let grossAmount = total;
                let wTaxAmount = grossAmount * (wTax / 100);

                totalUnits = totalUnits + totalUnitConsumed;
                totalAmount = totalAmount + grossAmount;

                tr.querySelector('input[name="saleTaxAmount"]').value = saleTaxAmount.toFixed(2);
                tr.querySelector('input[name="wTaxAmount"]').value = wTaxAmount.toFixed(2);
                tr.querySelector('input[name="grossAmount"]').value = grossAmount.toFixed(2);
                tr.querySelector('input[name="netAmount"]').value = grossAmount.toFixed(2);
            });

            $("#totalconsumedUnits").val(totalUnits.toFixed(2));
            $("#total").val(totalAmount.toFixed(2));
        }

        function calculateNetAmount(event) {
            let tr = event.target.closest('tr');
            let grossAmount = tr.querySelector('input[name="grossAmount"]').value;
            let discountAmount = event.target.value;
            let netAmount = tr.querySelector('input[name="netAmount"]').value;

            let result;
            if (grossAmount !== '') {
                if (grossAmount === '0' && discountAmount >= 0) {
                    result = 0;
                } else {
                    result = parseInt(grossAmount) - parseInt(discountAmount);
                }
            } else {
                result = netAmount;
            }

            tr.querySelector('input[name="netAmount"]').value = result;
        }



        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/MeterBillGeneration/AddNewMeterBillGeneration";

            var meterBillGeneration = new Object();

            var meterBillGenerationDetailArr = new Array();

            //if ($("#Id").val()) {

            //    debugger;

            //    meterInstallation.id = parseInt($("#Id").val());
            //    methodType = 'PUT';
            //    url = "/api/MeterInstallation/UpdateMeterInstallation"
            //}

            meterBillGeneration.Month = $('#FortheMonth').val();
            meterBillGeneration.BillFor = $('#BillFor').val();
            meterBillGeneration.ChargesStatus = $('#ChargeStatus').val();
            meterBillGeneration.CreatedBy = $("#User_Id").val();
            meterBillGeneration.ModifiedBy = $("#User_Id").val();
            meterBillGeneration.LastModifiedUserName = $("#User_Name").val();


            $('#MeterGeneratetbody tr').each(function () {

                var row = $(this);
                var merterBillGenerationDetail = new Object();

                // Amount

                const totalUnitConsumed = row.find('.totalUnitConsumed').val();
                const perUnitRate = row.find('.perUnitRate').val();
                const fuelAdjustment = row.find('.fuelAdjustment').val();
                const fuelAdjustedUnit = row.find('.fuelAdjustedUnit').val();
               
                const totalunitBill = totalUnitConsumed * perUnitRate;
                const totalfuelAdjustmentBill = fuelAdjustedUnit * fuelAdjustment;
                const total = totalunitBill + totalfuelAdjustmentBill;

                //end

                merterBillGenerationDetail.PropertyNo = row.find('.propertyNo').val();
                merterBillGenerationDetail.RegistrationNo = row.find('.registrationNo').val();
                merterBillGenerationDetail.SapAccount = row.find('.SapAccount').val();
                merterBillGenerationDetail.Month = $('#FortheMonth').val();
                merterBillGenerationDetail.MeterNo = row.find('.meterNo').val();
                merterBillGenerationDetail.PreviousReading = row.find('.PreviousReading').val();
                merterBillGenerationDetail.CurrentReading = row.find('.CurrentReading').val();
                merterBillGenerationDetail.TotalUnitConsumed = row.find('.totalUnitConsumed').val();
                merterBillGenerationDetail.PerUnitRate = row.find('.perUnitRate').val();
                merterBillGenerationDetail.FuelAdjustedUnits = row.find('.fuelAdjustedUnit').val();
                merterBillGenerationDetail.FuelAdjustment = row.find('.fuelAdjustment').val();
                merterBillGenerationDetail.Amount = total;
                merterBillGenerationDetail.SaleTax = row.find('.saleTax').val();
                merterBillGenerationDetail.SaleTaxAmount = row.find('.saleTaxAmount').val();
                merterBillGenerationDetail.WTaxAmount = row.find('.wTaxAmount').val();
                merterBillGenerationDetail.GrossAmount = row.find('.grossAmount').val();
                merterBillGenerationDetail.Discount = row.find('.discount').val();
                merterBillGenerationDetail.NetAmount = row.find('.netAmount').val();

                meterBillGenerationDetailArr.push(merterBillGenerationDetail);
            });


            meterBillGeneration.MeterBillGenerationDetail = meterBillGenerationDetailArr;

            var model = JSON.stringify(meterBillGeneration);
            $('#Submitp').prop('disabled', true); //disble
            $('#loader').fadeIn();
            NProgress.start();
            NProgress.set(0.4);
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                     $('#loader').fadeOut();
                    if (response.code === 100) {
                        NProgress.done();
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else
                    {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
            $('#Submitp').prop('disabled', false); //enable
        }

         function DiscardRequest() {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: 'Your data is deleted.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    var month = $("#month").val();
                     if ($("#FortheMonth") != "") {
                        Discard(month);
                     }
                     else
                     {
                          Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: 'Please select month',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                            })
                     }
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Discard(month) {
            debugger;

            var methodType = 'Delete';
            var url = "/api/MeterBillGeneration/Discard?month=" + month + "";
            NProgress.start();
            NProgress.set(0.4);
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',

                success: function (response) {
                    NProgress.done();
                    if (response.code == 100) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
        }

    </script>
