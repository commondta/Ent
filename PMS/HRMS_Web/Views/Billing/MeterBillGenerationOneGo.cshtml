    </div>
    <!-- .vd_container -->
</div>
@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";
        });

        function PostRequest() {

            let readingFor = $("#BillFor").val();
            let month = $("#FortheMonth").val();
            let fuelAjustedMonth = $("#FuelAjustedMonth").val();
            let fuelAdjustment = $("#FuelPrice").val();

            var methodType = 'GET';
            var url = "/api/Filter/GetMeterReadingForBillGenrationInBulk?readingFor=" + readingFor + "&month=" + month + "&fuelAjustedMonth=" + fuelAjustedMonth + "&fuelAdjustment=" + fuelAdjustment;
   
            $('#Submitp').prop('disabled', true); //disble
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
         
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                success: function (response) {
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
            $('#Submitp').prop('disabled', false); //enable
        }

        function DiscardRequest() {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: 'Your data is deleted.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    var month = $("#month").val();
                    if ($("#FortheMonth") != "") {
                        Discard(month);
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: 'Please select month',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Discard(month) {
            debugger;

            var methodType = 'Delete';
            var url = "/api/MeterBillGeneration/Discard?month=" + month + "";
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',

                success: function (response) {
                    debugger;
                    console.log(response);
                    if (response.code == 100) {
                        NProgress.done();
                        $('#loader').fadeOut();

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
        }

    </script>
 }
