            <div class="vd_title-section clearfix">
                <div class="vd_panel-header">
                    <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cash-coin" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8m5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0"/><path d="M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.54-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.668zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195z"/><path d="M1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083q.088-.517.258-1H3a2 2 0 0 0-2-2V3a2 2 0 0 0 2-2h10a2 2 0 0 0 2 2v3.528c.38.34.717.728 1 1.154V1a1 1 0 0 0-1-1z"/><path d="M9.998 5.083 10 5a2 2 0 1 0-3.132 1.65 6 6 0 0 1 3.13-1.567"/></svg></span>
                    <h1>METER BILL GENERATION ONE GO</h1>

                    <div class="vd_panel-menu  hidden-xs">

                        <div class="menu">

                            @*  <a class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal">Add New</a>*@

                        </div>
                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        <form class="custom-validation" id="MeterBill">
                            <div class="row">
                                <div class="col-sm-3">
                                    <label>Document Date</label>
                                    <div>
                                        <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                               placeholder=" " id="Docdate" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>Month.</label>
                                    <div>
                                        <input type="month" class="form-control"
                                               placeholder="" id="month" />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <a onclick="DiscardRequest()" style="margin-top:26px;" class="btn btn-danger">
                                        <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Discard
                                    </a>
                                </div>
                            </div>
                            <br>
                            <div class="row">
                                <div class="col-sm-3">
                                    <label>Fuel Adjusted Month</label>
                                    <div>
                                        <input type="month" class="form-control"
                                               placeholder=" " id="FuelAjustedMonth" />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>Fuel Price</label>
                                    <div>
                                        <input type="number" class="form-control"
                                               placeholder=" " id="FuelPrice" value="1" />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>For the Month</label>
                                    <div>
                                        <input type="month" class="form-control"
                                               placeholder=" " id="FortheMonth" />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>Bill For</label>
                                    <div>
                                        <select name="BillFor" class="js-example-basic-single" id="BillFor">
                                            <option value=""> -- Select Option --</option>
                                            <option value="Electricity">Electricity</option>
                                            <option value="Water">Water</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <br>
                            <div >
                               
                                    <label>Remarks</label>
                                    <div>
                                        <textarea type="text" class="form-control" id="Remarks" name="Remarks"
                                                  placeholder=" "></textarea>
                                    </div>
                              
                            </div>
                            <br>
                        </form>
                        <div class="col-12" style="float: right;">
                            <button type="submit" onclick="PostRequest()" id="Submitp" class="btn dha_theme_btn">
                                <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Generate
                            </button>
                            <button class="btn btn-light" href="javascript:void(0);">
                                <span class="menu-icon"><i class="fa fa-fw fa-times-circle"></i></span> Cancel
