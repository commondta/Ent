<!-- /.modal -->

<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            GetAllPhaseWiseRates();
        });

        function GetAllPhaseWiseRates() {

            var url = "/api/MeterPhaseWiseRate/GetAll";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var result = response.data;

                        $("#MRatetbody").empty();

                        $.each(result, function (i, item) {
                            var rownumber = parseInt($("#rownumberN").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumberN").val(rownumber);

                            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <select type="text" class="form-control MeterPhase" style="width: 100%;" id="MeterPhase' + rownumber + '"></select></td>' +
                                '<td> <input type="text" class="form-control Rate" value="' + item.rate + '"/></td>' +

                                '<td style="padding-top:10px"><a disabled class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';

                            $("#MRatetbody").append(row);

                            GetPhaseType(rownumber, item.meterPhaseId)
                        });
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Lead");
                    }
                }
            });
        }

        function AddRow() {

            var rownumber = parseInt($("#rownumberN").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberN").val(rownumber);

            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <select type="text" class="form-control MeterPhase" style="width: 100%;" id="MeterPhase' + rownumber + '"></select></td>' +
                '<td> <input type="text" class="form-control Rate"/></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#MRatetbody").append(row);

            GetPhaseType(rownumber)
        }

        function DeleteItemRow(id) {
            $('#L' + id).remove();
            var rownumber = 1;
            $("#MRatetbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberN").val(rownumber - 1);
        }

        function GetPhaseType(rowno, meterPhaseId) {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/MeterPhase/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#MeterPhase" + rowno).empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#MeterPhase" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#MeterPhase" + rowno).append(row);

                                sr++;
                            }
                            $('#MeterPhase' + rowno).select2();
                        }
                        if (meterPhaseId != null && meterPhaseId != undefined) {
                            $('#MeterPhase' + rowno).select2("val", [meterPhaseId])
                        }

                    }
                }
            });
        }

        function PostRequest() {

            var PhaseWiseRateArray = new Array();

            $('#MRatetbody tr').each(function () {

                var row = $(this);
                var RateData = new Object();

                RateData.MeterPhaseId = row.find('.MeterPhase').val();
                RateData.Rate = row.find('.Rate').val();
                RateData.CreatedBy = $("#User_Id").val();
                RateData.ModifiedBy = $("#User_Id").val();
                RateData.LastModifiedUserName = $("#User_Name").val();

                PhaseWiseRateArray.push(RateData);
            });

            var model = JSON.stringify(PhaseWiseRateArray);
            debugger;
            $('#sbbtn').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: 'POST',
                url: `/api/MeterPhaseWiseRate/SaveMeterPhaseWiseRates`,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: model,

                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
            $('#sbbtn').prop('disabled', false); //enable
        }
    </script>
  }