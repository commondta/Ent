            <div class="vd_content-section clearfix">

                <div class="container-fluid">
                    <div class="card p-3">
                       
                       
                        <div >
                            <div class="menu" style="float: right; margin-bottom:.5rem;">
                                <a class="btn btn-sm dha_theme_btn" onclick="AddRow()" style="padding: 6px 20px; ">Add New</a>
                                <input type="text" id="rownumberN" value="0" class="hide" />
                            </div>
                            <div class="table-responsive">
                                <table id="GLData" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            <th class="text-white" style="width: 250px; text-align: center;">Meter Phase</th>
                                            <th class="text-white" style="width: 250px; text-align: center;">Rate</th>
