<input id="rownumberforid" class="hide" value="0" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script>
            $(document).ready(function () {
            "use strict";
               $("#MeterReadingForm").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {

                    ForMonth: { 
                        required: true
                    },
                    ReadingFor: { 
                        required: true
                    }
                   
                },
                   messages: {
                       required:"Required Field"
                   },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { 
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    debugger;
                     PostRequest();
                }
            });

               jQuery.extend(jQuery.validator.messages, {
              required: "Field required.",
        });

            GetMeterType();
            GetAllFindMeterLists();

            //var today = new Date();
            //var currentMonth = today.toISOString().slice(0, 7);
            //$('input[type="month"]').attr('min', currentMonth);
        });

        function GetMeterType() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/MeterType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#MeterType").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#MeterType").append(row);

                                sr++;
                            }
                            $('#MeterType').select2();
                        }
                        
                    }
                }
            });
        }

        // selection All MeterList
        function GetAllFindMeterLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetAllMetersReadingMonthwise`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        $("#Metertbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                var row = ' <tr> ' +
                                    ' <td class="Id">' + sr + '</td> ' +
                                    ' <td>' + list.month + '</td>           ' +
                                    ' <td>' + list.readingFor + '</td>           ' +
                                    '<td><a class="btn btn-primary" onclick="SelectMeter(' + list.id + ')">Select</a></td> </tr>';
                                $("#Metertbody").append(row);
                                sr++;
                            }
                        }

                        $('#Meterlist').dataTable();
                    }
                }
            });
        }

        function SelectMeter(id) {

            var url = "/api/MeterReading/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var result = response.data;

                        $("#Id").val(result.id);
                        $("#ForMonth").val(result.month);
                        $("#ReadingFor").val(result.readingFor);

                        $("#MeterRtbody").empty();

                        $.each(result.readingDetail, function (i, item) {

                            // set values
                            let copyToTargetDocument = item.picture == "" ? "/img/placeholder-photo.svg" : item.picture;      
                            
                            var rownumber = parseInt($("#rownumberM").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumberM").val(rownumber);

                            var row = '<tr id="M' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td style="width: 250px;"> <input disabled id="meterNo_' + rownumber + '" value="' + item.meterNo + '" class="MeterNo" style="height:30px; width: 200px; background-color: #E5E5E5; border:#E5E5E5; border-radius:5px;"/><a class="btn btn-primary btn-sm btn-theme" onclick="GetMeter(' + rownumber + ')" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +
                                '<td> <input disabled id="propNo_' + rownumber + '" value="' + item.propertyNo + '" class="form-control PropertyNo" </td > ' +
                                '<td> <input type="number"   name="LastReading" readonly id="LastReading_' + rownumber + '"  class="form-control  LastReading" value="' + item.lastReading + '"/></td>' +
                                '<td> <input type="number" id="CurrentReading_' + rownumber + '"  required name="CurrentReading[' + rownumber + '].LastReading" value="' + item.currentReading + '" onkeyup="calculateNetUnits(event)" class="form-control  CurrentReading" /></td>' +
                                '<td> <input disabled name="ConsumedUnit" class="form-control  UnitsConsumed" value="' + item.unitsConsumed + '" /></td>' +
                                '<td> <select disabled class="form-control ReadingOfficer" id="ReadingOfficer' + rownumber + '"></select></td>' +
                                '<td> <input disabled type="file" class="form-control targetPath" value="' + item.targetPath + '" /><input  class="form-control CopyToTargetDocument hide" value="' + copyToTargetDocument + '" /></td>' +
                                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + copyToTargetDocument + '" class="clickme" ></a></img></td>' +


                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';

                            $("#MeterRtbody").append(row);

                           GetReadingOfficer(rownumber, item.readingOfficerId)
                       

                        });

                        $("#MeterReadingModal").modal("hide");

                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Reading");
                    }
                }
            });
        }

        function GetReadingOfficer(rowno, readingOfficerId) {
          
            $.ajax({
                type: 'GET',
                url: `/api/ReadingOfficer/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#ReadingOfficer" + rowno).empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#ReadingOfficer" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#ReadingOfficer" + rowno).append(row);

                                sr++;
                            }
                            $('#ReadingOfficer' + rowno).select2();
                        }
                        if (readingOfficerId != null && readingOfficerId != undefined) {
                            $('#ReadingOfficer' + rowno).select2("val", [readingOfficerId])
                        }

                    }
                }
            });
        }
        // selection All Meter END

        // selection MeterNumber start
        function GetAllMeterList() {
            debugger;
            let meterType = $("#MeterType").val();

            $.ajax({
                type: 'GET',
                url: "/api/Filter/GetMeterNumbersForMeterReading?meterType=" + meterType + "",
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#MeterReadtbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
                                    ' <td>' + list.meterNumber + '</td> ' +
                                    ' <td>' + list.propertyNo + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                $("#MeterReadtbody").append(row);
                                sr++;
                            }
                        }

                        $('#MetermodalTable').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetMeterNumbersForMeterReadingById?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        var rownumber = $("#rownumberforid").val();
                        $("#meterNo_" + rownumber).val(result_User.meterNumber)
                        $("#propNo_" + rownumber).val(result_User.propertyNo)
                        $("#LastReading_" + rownumber).val(result_User.unitsAtInstallation)
                        $("#CurrentReading_" + rownumber).val(result_User.unitsAtInstallation);
                        $("#CurrentReading_" + rownumber).attr('min', result_User.unitsAtInstallation);
                        $("#MeterModal").modal("hide");
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        // selection MeterNumber end
        function GetMeter(id){
            GetAllMeterList();
            $("#rownumberforid").val(id);
            $("#MeterModal").modal("show");
        }

        function AddRow() {

            var rownumber = parseInt($("#rownumberM").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberM").val(rownumber);

            var row = '<tr id="M' + rownumber + '" DetailId="0"> ' +
               '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
               '<td style="width: 250px;"> <input required name="MeterReading[' + rownumber + '].MeterNo" readonly id="meterNo_' + rownumber + '" class="MeterNo" style="height:30px; width: 200px; background-color: #E5E5E5; border:#E5E5E5; border-radius:5px;"/><a class="btn btn-primary btn-sm btn-theme" onclick="GetMeter(' + rownumber + ')" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +
               '<td> <input type="text"  readonly id="propNo_' + rownumber + '"  class="form-control PropertyNo" /></td>' +
               '<td> <input type="number"   name="LastReading" readonly id="LastReading_' + rownumber + '"  class="form-control  LastReading" /></td>' +
               '<td> <input type="number" id="CurrentReading_' + rownumber + '"  required name="CurrentReading[' + rownumber + '].LastReading"  onkeyup="calculateNetUnits(event)" class="form-control  CurrentReading" /></td>' +
               '<td> <input type="text"   name="ConsumedUnit" readonly class="form-control  UnitsConsumed" value="0.00" /></td>' +
               '<td> <select required name="MeterReading[' + rownumber + '].ReadingOfficer"  class="form-control ReadingOfficer" id="ReadingOfficer' + rownumber + '"></select></td>' +
               '<td> <input type="file" class="form-control targetPath" /><input  class="form-control CopyToTargetDocument hide" /></td>' +
                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +


                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#MeterRtbody").append(row);

            GetReadingOfficer(rownumber)
        }

        function DeleteItemRow(id) {
            $('#M' + id).remove();
            var rownumber = 1;
            $("#MeterRtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberM").val(rownumber - 1);
        }

        // image from body
        $('body').on('change', '.targetPath', UploadImageOnServerforAttachmenttbody);

        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                // alert();
                // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("warning", "Sorry, invalid extension.");
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {
                debugger;
                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".fileName").val(file.name);
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('input[type=file]').get(0).files[0];
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        function calculateNetUnits(event) {
            debugger;
            let tr = event.target.closest('tr');
            let amount = tr.querySelector('input[name="LastReading"]').value;
            let result =  parseFloat(event.target.value) - parseFloat(amount);
            tr.querySelector('input[name="ConsumedUnit"]').value = result.toFixed(2);
        }

        function PostRequest() {

          if ($("#ForMonth").val() != "" && $("#ReadingFor").val())
          {
            var methodType = 'POST';
            var url = "/api/MeterReading/AddNewMeterReading";

            var meterReading = new Object();

            var meterReadingArr = new Array();

            if ($("#Id").val()) {

                meterReading.id = parseInt($("#Id").val());
                methodType = 'PUT';
                url = "/api/MeterReading/UpdateMeterReading"
            }

            meterReading.Month = $('#ForMonth').val();
            meterReading.MeterReadingOfficer = $('#Officer').val();
            meterReading.ReadingFor = $('#ReadingFor').val();
                meterReading.CreatedBy = $("#User_Id").val();
            meterReading.ModifiedBy = $("#User_Id").val();
            meterReading.LastModifiedUserName = $("#User_Name").val();

    

            $('#MeterRtbody tr').each(function () {

                var row = $(this);
                var merterReading = new Object();

                var readingOfficer = row.find('.ReadingOfficer').val() == "" ? null : row.find('.ReadingOfficer').val();

                merterReading.MeterNo = row.find('.MeterNo').val();
                merterReading.PropertyNo = row.find('.PropertyNo').val();
                merterReading.LastReading = row.find('.LastReading').val();
                merterReading.CurrentReading = row.find('.CurrentReading').val();
                merterReading.UnitsConsumed = row.find('.UnitsConsumed').val();
                merterReading.ReadingOfficerId = readingOfficer;
                merterReading.Picture = row.find('.CopyToTargetDocument').val();


                meterReadingArr.push(merterReading);
            });


            meterReading.ReadingDetail = meterReadingArr;
            var model = JSON.stringify(meterReading);

            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {

                    if (response.code === 100) {
                            NProgress.done();
                            $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
          }
          else
          {

            Swal.fire({
               icon: 'warning',
               title: 'Warning',
               text: "Please Select Both Month & Reading For",
               customClass: 'swal-wide',
               allowOutsideClick: false,
               allowEscapeKey: false
            });

          }
        }

        //filterByMeterNo

        function filterByMeterNo() {

            const searchMonth = $("#searchMonth").val();
            const filterByMeter = $("#filtermeterNo").val();

            if (!searchMonth || !filterByMeter) {
                return;
            }

            var url = "/api/MeterReading/FilterByMeterNo?month=" + searchMonth + "&meterNo=" + filterByMeter;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var result = response.data;
                        
                        $("#ForMonth").val(searchMonth);
                      
                        $("#MeterRtbody").empty();

                        $.each(result, function (i, item) {

                            // set values
                            let copyToTargetDocument = item.picture == "" ? "/img/placeholder-photo.svg" : item.picture;      
                            
                            var rownumber = parseInt($("#rownumberM").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumberM").val(rownumber);

                            var row = '<tr id="M' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td style="width: 250px;"> <input disabled id="meterNo_' + rownumber + '" value="' + item.meterNo + '" class="MeterNo" style="height:30px; width: 200px; background-color: #E5E5E5; border:#E5E5E5; border-radius:5px;"/><a class="btn btn-primary btn-sm btn-theme" onclick="GetMeter(' + rownumber + ')" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +
                                '<td> <input disabled id="propNo_' + rownumber + '" value="' + item.propertyNo + '" class="form-control PropertyNo" </td > ' +
                                '<td> <input type="number"   name="LastReading" readonly id="LastReading_' + rownumber + '"  class="form-control  LastReading" value="' + item.lastReading + '"/></td>' +
                                '<td> <input type="number" id="CurrentReading_' + rownumber + '"  required name="CurrentReading[' + rownumber + '].LastReading" value="' + item.currentReading + '" onkeyup="calculateNetUnits(event)" class="form-control  CurrentReading" /></td>' +
                                '<td> <input disabled name="ConsumedUnit" class="form-control  UnitsConsumed" value="' + item.unitsConsumed + '" /></td>' +
                                '<td> <select disabled class="form-control ReadingOfficer" id="ReadingOfficer' + rownumber + '"></select></td>' +
                                '<td> <input disabled type="file" class="form-control targetPath" value="' + item.targetPath + '" /><input  class="form-control CopyToTargetDocument hide" value="' + copyToTargetDocument + '" /></td>' +
                                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + copyToTargetDocument + '" class="clickme" ></a></img></td>' +

                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';

                            $("#MeterRtbody").append(row);

                           GetReadingOfficer(rownumber, item.readingOfficerId)
                       
                        });

                        $("#MeterReadingModal").modal("hide");

                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Reading");
                    }
                }
            });
        }

    </script>
