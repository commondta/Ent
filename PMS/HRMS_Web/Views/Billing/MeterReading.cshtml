@*MeterReading Model*@

<div class="modal" id="MeterModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title">Select Meter No.</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <table id="MetermodalTable" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white">#</th>
                                            <th class="text-white">Meter No.</th>
                                            <th class="text-white">Property No.</th>
                                            <th class="text-white">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="MeterReadtbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
