@section Scripts {
    <script src="~/js/QrCode.js"></script>
    <script>
        $(document).ready(function () {
            "use strict";
            $('#MBillGenerate').dataTable();

            //var today = new Date();
            //var currentMonth = today.toISOString().slice(0, 7);
            //$('input[type="month"]').attr('min', currentMonth);
        });

        const textarea = document.getElementById("Remarks");
        const charCount = document.getElementById("charCount");

        textarea.addEventListener("input", function () {
            const remaining = 200 - this.value.length;
            charCount.textContent = `${remaining} characters remaining`;
        });

        function OpenPrintRangeModal() {
            $("#PrintRangeModal").modal("show");
        }

        $("#BillFor").change(function () {
            let readingFor = $(this).val();
            let month = $("#FortheMonth").val();

            if (month && readingFor) { // Check if both month and readingFor are truthy
                if (readingFor == "Fixed Dues" || readingFor == "Constructed" || readingFor == "Non-Constructed") {
                    GetFixedDues(readingFor, month);
                }
                else if (readingFor == "All") {
                    GetAllDues(readingFor, month);
                }
                else {
                    GetAllBillDetial(readingFor, month);
                }
            }
        });

        $("#FortheMonth").change(function () {
            var month = $(this).val();
            var readingFor = $("#BillFor").val();
            GetHeadsdata(month);

            if (month && readingFor) { // Check if both month and readingFor are truthy
                if (readingFor == "Fixed Dues" || readingFor == "Constructed" || readingFor == "Non-Constructed") {
                    GetFixedDues(readingFor, month);
                }
                else if (readingFor == "All") {
                    GetAllDues(readingFor, month);
                }
                else {
                    GetAllBillDetial(readingFor, month);
                }
            }
        });


        function GetAllDues(readingFor, month) {


            var url = "/api/SP/GetCombineBillFromMonthlyBillGeneration?readingFor=" + readingFor + "&month=" + month;
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        NProgress.done();
                        $('#loader').fadeOut();

                        var datatabl = $('#MBillGenerate').DataTable();
                        datatabl.destroy();

                        $("#MBGeneratetbody").empty();

                        var relist = response.data;

                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {

                                let arrears = Number(list.arrears ?? 0);
                                let netAmount = Number(list.netAmount);
                                let totalAmount = netAmount + arrears;

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td> <input disabled class="form-control registrationNo" value="' + list.registrationNo + '" /></td>' +
                                    '<td> <input disabled class="form-control propertyNo" value="' + list.propertyNo + '" /></td>' +
                                    '<td> <input disabled name="netAmount" class="form-control netAmount" value="' + list.netAmount + '" /></td>' +
                                    '<td> <input disabled name="arrears" class="form-control arrears" value="' + arrears + '" /></td>' +
                                    '<td> <input disabled name="totalAmount" class="form-control totalAmount" value="' + (list.netAmount + arrears) + '" /></td>' +
                                    '<td> <input disabled name="meterNo" class="form-control meterNo" value="' + (list.meterNo || '') + '" /></td>' +
                                    '<td><a class="btn btn-primary btn-sm" onclick="PrintSingleBill(\'' + list.registrationNo + '\', \'' + list.propertyNo + '\', \'' + list.meterNo + '\', ' + list.netAmount + ')">Print</a></td>'

                                    '</tr>';

                                $("#MBGeneratetbody").append(row);

                                sr++;
                            }

                        }
                        $('#MBillGenerate').dataTable();
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function GetFixedDues(readingFor, month) {


            var url = "/api/SP/GetDetailsFixedDuesFromMonthlyBillGeneration?readingFor=" + readingFor + "&month=" + month;
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        NProgress.done();
                        $('#loader').fadeOut();

                        var datatabl = $('#MBillGenerate').DataTable();
                        datatabl.destroy();

                        $("#MBGeneratetbody").empty();

                        var relist = response.data;

                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {

                                let arrears = Number(list.arrears ?? 0);
                                let netAmount = Number(list.netAmount);
                                let totalAmount = netAmount + arrears;

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td> <input disabled class="form-control registrationNo" value="' + list.registrationNo + '" /></td>' +
                                    '<td> <input disabled class="form-control propertyNo" value="' + list.propertyNo + '" /></td>' +
                                    '<td> <input disabled name="netAmount" class="form-control netAmount" value="' + list.netAmount + '" /></td>' +
                                    '<td> <input disabled name="arrears" class="form-control arrears" value="' + arrears + '" /></td>' +
                                    '<td> <input disabled name="totalAmount" class="form-control totalAmount" value="' + (list.netAmount + arrears) + '" /></td>' +
                                    '<td> <input disabled name="meterNo" class="form-control meterNo" value="' + (list.meterNo || '') + '" /></td>' +
                                    '<td><a class="btn btn-primary btn-sm" onclick="PrintSingleBill(\'' + list.registrationNo + '\', \'' + list.propertyNo + '\', \'' + list.meterNo + '\', ' + list.netAmount + ')">Print</a></td>'
                                '</tr>';

                                $("#MBGeneratetbody").append(row);

                                sr++;
                            }
                        }
                        $('#MBillGenerate').dataTable();
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function GetAllBillDetial(readingFor, month) {

            var url = "/api/SP/GetDetailsFromMonthlyBillGeneration?readingFor=" + readingFor + "&month=" + month;
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        NProgress.done();
                        $('#loader').fadeOut();

                        var datatabl = $('#MBillGenerate').DataTable();
                        datatabl.destroy();

                        $("#MBGeneratetbody").empty();

                        var model = response.data;

                        var relist = model;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;

                            for (let list of relist) {

                                let arrears = Number(list.arrears ?? 0);
                                let netAmount = Number(list.netAmount);
                                let totalAmount = netAmount + arrears;

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td> <input disabled class="form-control registrationNo" value="' + list.registrationNo + '" /></td>' +
                                    '<td> <input disabled class="form-control propertyNo" value="' + list.propertyNo + '" /></td>' +
                                    '<td> <input disabled name="netAmount" class="form-control netAmount" value="' + list.netAmount + '" /></td>' +
                                    '<td> <input disabled name="arrears" class="form-control arrears" value="' + arrears + '" /></td>' +
                                    '<td> <input disabled name="totalAmount" class="form-control totalAmount" value="' + (list.netAmount + arrears) + '" /></td>' +
                                    '<td> <input disabled name="meterNo" class="form-control meterNo" value="' + (list.meterNo || '') + '" /></td>' +
                                    '<td><a class="btn btn-primary btn-sm" onclick="PrintSingleBill(\'' + list.registrationNo + '\', \'' + list.propertyNo + '\', \'' + list.meterNo + '\', ' + list.netAmount + ')">Print</a></td>'
                                '</tr>';

                                $("#MBGeneratetbody").append(row);

                                sr++;
                            }
                        }
                        $('#MBillGenerate').dataTable();
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function GetHeadsdata(month) {

            var url = "/api/FixedChargeGeneration/GetHeads?month=" + month;
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        NProgress.done();
                        $('#loader').fadeOut();

                        $("#ServicesChargesHeadstbody").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            var totalAmount = 0;
                            for (let list of relist) {
                                totalAmount += list.totalAmount;
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.description + '</td>' +
                                    ' <td style="text-align:right;padding-right:3px;" >' + formatPKR(list.totalAmount) + '</td>' +
                                    '</tr>';
                                $("#ServicesChargesHeadstbody").append(row);
                                sr++;
                            }
                            var totalRow = '<tr>' +
                                '<td colspan="2" style="text-align: center; font-weight: bold;">Total</td>' +
                                '<td style="font-weight: bold; text-align:right;padding-right:3px;">' + formatPKR(totalAmount) + '</td>' +
                                '</tr>';
                            $("#ServicesChargesHeadstbody").append(totalRow);

                        }
                        $('#ServicesChargesHeads').dataTable();
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        var dataforprint = new Array();

        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/Filter/PrintBill";

            var bill = new Object();

            var billDetailArr = new Array();

            bill.DocDate = $('#DocDate').val();
            bill.BillMonth = $('#FortheMonth').val();
            bill.BillFor = $('#BillFor').val();
            bill.DueDate = $('#DueDate').val();
            bill.Remarks = $('#Remarks').val();

            var table = $('#MBillGenerate').DataTable();
            table.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var data = this.data();
                var billDetail = new Object();

                billDetail.RegistrationNo = $(data[1]).val();
                billDetail.PropertyNo = $(data[2]).val();
                billDetail.Amount = $(data[3]).val();
                billDetail.MeterNo = $(data[6]).val();
                billDetailArr.push(billDetail);
            });

            bill.BillList = billDetailArr;

            var model = JSON.stringify(bill);

            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: model,
                success: function (response) {

                    if (response.code === 100) {

                        dataforprint = response.data;
                        var responselength = response.data.length;
                        var totalbuttons = responselength / 100;
                        var val = 1;
                        $("#BillPrintButtons").empty();
                        for (var i = 1; i < totalbuttons; i++) {
                            val = i * 100;
                            $("#BillPrintButtons").append("<tr><td><a class='btn btn-success btn-block' onclick='PrintBill(" + (parseInt(val) - 99) + "," + val + ")'> Print " + (parseInt(val) - 99) + " To " + val + "<a></td></tr>");
                        }
                        if (totalbuttons % 100 > 0) {
                            $("#BillPrintButtons").append("<tr><td><a class='btn btn-success btn-block' onclick='PrintBill(" + (parseInt(val) + 1) + "," + responselength + ")'> Print " + (parseInt(val) + 1) + " To " + responselength + "<a></td></tr>");

                        }
                        NProgress.done();
                        $('#loader').fadeOut();
                        OpenPrintRangeModal();
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });

        }

