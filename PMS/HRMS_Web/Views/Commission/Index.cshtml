    <div class="modal" id="ModalForType" tabindex="-1" role="dialog" aria-labelledby="modaltitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header vd_bg-blue vd_white">
                    <h4 class="modal-title" >Find <span id="modaltitle"></span></h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>

                </div>
                <div class="modal-body">
                    <div class="container">
                        <div class="row">
                            <div class="col-sm-12">
                                <table id="ModalForTypetable" class="table">
                                    <thead class="bg-theme">
                                        <tr>

                                            <th class="text-white">ID</th>
                                            <th class="text-white">Dealer Code</th>
                                            <th class="text-white">Dealer Name</th>
                                            <th class="text-white">Date</th>
                                            <th class="text-white">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ModalForTypetbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>
    <input value="0" id="rownumber" class="hide" />
    <input value="@Context.Session.GetString("ID")" id="userId" class="hide" />
    @section Scripts {
        <script>
            var BookingData;
            var TransferData;
            $(document).ready(function() {
                GetBookingData();
            });
             function GetBookingData() {
                $.ajax({
                    type: 'GET',
                    url: `/api/Booking/GetAllBookingDealerAvailable`,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.code == 100) {          
                                BookingData = response.data;//setting the global variable                
                        }
                    }
                });
             }
             $('#Type').on('change', function() {
                 var type = $(this).val();
                 if (type == "Booking") {
                     if (BookingData != null && BookingData.length > 0) {
                            var sr = 1;
                            for (let list of BookingData) {
                                var bookingDate = list.createdOn.split("T")[0];
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + list.id + '</td> ' +
                                    ' <td>' + list.dealer.dealerEstateDeatail[0].id + '</td>           ' +
                                    ' <td>' + list.dealer.dealerEstateDeatail[0].name + '</td>           ' +
                                    ' <td>' + bookingDate + '</td>       ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRecord(this)">Select</a></td> </tr>';
                                $("#ModalForTypetbody").append(row);
                                sr++;
                            }
                        }

                        $('#ModalForTypetable').dataTable();
                 }
                 else{

                 }
                 $("#ModalForType").modal("show");
             });

        </script>
}


