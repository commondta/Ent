<style>
    .ent-wrap {
        font-family: inherit;
    }

    .ent-wrap .container-fluid {
        padding-left: 0;
        padding-right: 0;
    }

    .ent-wrap * {
        box-sizing: border-box;
    }

    .ent-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 14px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ent-toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ent-toolbar-title i {
        color: #1e3a8a;
    }

    .ent-btn {
        border: 1px solid #1e3a8a;
        border-radius: 4px;
        background: #1e3a8a;
        color: #fff;
        font-weight: 600;
        font-size: 13px;
        padding: 0 18px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: background .15s ease;
    }

    .ent-btn:hover {
        background: #16296b;
        color: #fff;
    }

    .ent-btn[disabled] {
        opacity: .65;
        cursor: not-allowed;
    }

    .ent-error-banner {
        display: none;
        margin-bottom: 14px;
        padding: 9px 14px;
        border-radius: 6px;
        border: 1px solid #f5c2c0;
        background: #fdecea;
        color: #b3261e;
        font-size: 13px;
        font-weight: 500;
    }

    .ent-kpi-ribbon {
        display: flex;
        flex-wrap: wrap;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 14px;
    }

    @@media (max-width: 991px) {
        .ent-kpi-tile {
            flex: 1 1 50% !important;
            border-bottom: 1px solid #e2e8f0;
        }
    }

    @@media (max-width: 575px) {
        .ent-kpi-tile {
            flex: 1 1 100% !important;
        }
    }

    .ent-kpi-tile {
        flex: 1;
        min-width: 160px;
        padding: 12px 16px;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        position: relative;
    }

    .ent-kpi-tile:last-child {
        border-right: none;
    }

    .ent-kpi-tile::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
    }

    .ent-accent-blue::before {
        background: #1e3a8a;
    }

    .ent-accent-teal::before {
        background: #0f766e;
    }

    .ent-accent-orange::before {
        background: #c2410c;
    }

    .ent-accent-purple::before {
        background: #6d28d9;
    }

    .ent-accent-slate::before {
        background: #475569;
    }

    .ent-accent-rose::before {
        background: #be123c;
    }

    .ent-kpi-label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .ent-kpi-value {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }

    .ent-kpi-sub {
        display: block;
        font-size: 11px;
        color: #94a3b8;
        margin-top: 4px;
    }

    .ent-insights-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 14px;
    }

    @@media (max-width: 991px) {
        .ent-insights-row {
            grid-template-columns: 1fr;
        }
    }

    .ent-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
    }

    .ent-panel-header {
        padding: 10px 16px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 12.5px;
        font-weight: 700;
        color: #1e293b;
        text-transform: uppercase;
        letter-spacing: .03em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .ent-chart-body-sm {
        min-height: 240px;
        padding: 8px 6px 4px;
        position: relative;
    }

    .ent-chart-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 200px;
        color: #94a3b8;
        font-size: 12.5px;
    }

    .ent-loading-overlay {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, .65);
        align-items: center;
        justify-content: center;
        z-index: 5;
        border-radius: 6px;
    }

    .ent-loading-overlay i {
        font-size: 24px;
        color: #1e3a8a;
    }

    .ent-dashboard {
        position: relative;
    }

    .ent-dashboard.ent-is-loading .ent-loading-overlay {
        display: flex;
    }
</style>

<!-- Middle Content Start -->

