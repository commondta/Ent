<!-- Middle Content End -->
@section Scripts {
    <script type="text/javascript">
        var pieChart, soldAvailableChart, topBlocksChart;
        var entColors = ['#1e3a8a', '#c2410c', '#0f766e', '#6d28d9', '#be123c', '#0369a1', '#a16207', '#4338ca'];

        $(document).ready(function () {
            fetchData();
            $("#searchButton").click(function () {
                fetchData();
            });
        });

        function setLoading(isLoading) {
            var $dashboard = $("#entDashboard");
            var $btn = $("#searchButton");
            if (isLoading) {
                $dashboard.addClass("ent-is-loading");
                $btn.prop("disabled", true);
                $("#errorBanner").hide();
            } else {
                $dashboard.removeClass("ent-is-loading");
                $btn.prop("disabled", false);
            }
        }

        function animateValue(id, endValue) {
            var $el = $("#" + id);
            if (!$el.length) return;
            var startValue = 0;
            var duration = 700;
            var startTime = null;

            function step(timestamp) {
                if (!startTime) startTime = timestamp;
                var progress = Math.min((timestamp - startTime) / duration, 1);
                var current = Math.floor(progress * (endValue - startValue) + startValue);
                $el.text(current.toLocaleString());
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    $el.text(endValue.toLocaleString());
                }
            }
            window.requestAnimationFrame(step);
        }

        function sumBy(list, key) {
            if (!list || !list.length) return 0;
            return list.reduce(function (total, item) { return total + (item[key] || 0); }, 0);
        }

        function showChartEmpty(containerId, message) {
            $("#" + containerId).html('<div class="ent-chart-empty"><i class="fa fa-inbox" style="margin-right:8px;"></i>' + (message || 'No data available') + '</div>');
        }

        function fetchData() {
            setLoading(true);
            $.ajax({
                type: 'GET',
                url: `/Home/api/Dashboard/GetCardsValues?project=all`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                contentType: 'application/json',
                success: function (response) {
                    setLoading(false);
                    if (response.code === 100) {
                        var result = response.data;
                        clearCharts();
                        updateKpis(result);
                        renderCategoryChart(result);
                        renderSoldAvailableChart(result);
                        renderTopBlocksChart(result);
                    } else {
                        $("#errorBanner").show();
                    }
                },
                error: function (error) {
                    setLoading(false);
                    $("#errorBanner").show();
                    console.error('Error fetching data:', error);
                }
            });
        }

        function clearCharts() {
            if (pieChart) pieChart.destroy();
            if (soldAvailableChart) soldAvailableChart.destroy();
            if (topBlocksChart) topBlocksChart.destroy();
        }

        function updateKpis(result) {
            var totalStock = result.totalStock || 0;
            var sold = result.soldStock || 0;
            var available = result.availableStock || 0;

            animateValue('totalMembers', result.totalMembers || 0);
            animateValue('totalDealers', result.totalDealers || 0);
            animateValue('totalSystemUsers', result.totalPMSUsers || 0);
            animateValue('totalStock', totalStock);
            animateValue('kpiSold', sold);
            animateValue('kpiAvailable', available);

            $('#kpiSoldPct').text(totalStock ? ((sold / totalStock) * 100).toFixed(1) + '% of total' : '');
            $('#kpiAvailablePct').text(totalStock ? ((available / totalStock) * 100).toFixed(1) + '% of total' : '');
        }

        function renderCategoryChart(result) {
            var data = result.typeWisePieChartDTO || [];
            if (!data.length) { showChartEmpty('pie-chart'); return; }

            var options = {
                chart: { type: 'donut', width: '100%', height: 250, toolbar: { show: false } },
                labels: data.map(function (item) { return item.name; }),
                series: data.map(function (item) { return item.count; }),
                colors: entColors,
                dataLabels: { style: { fontSize: '10px' } },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '62%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '11px',
                                    formatter: function (w) { return w.globals.seriesTotals.reduce((a, b) => a + b, 0); }
                                }
                            }
                        }
                    }
                },
                legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '10.5px', itemMargin: { horizontal: 6, vertical: 2 } },
                tooltip: { y: { formatter: function (val) { return val; } } }
            };

            pieChart = new ApexCharts(document.querySelector("#pie-chart"), options);
            pieChart.render();
        }

        function renderSoldAvailableChart(result) {
            var sold = result.soldStock || 0;
            var available = result.availableStock || 0;
            if (!(sold + available)) { showChartEmpty('sold-available-chart'); return; }

            var options = {
                chart: { type: 'donut', width: '100%', height: 250, toolbar: { show: false } },
                labels: ['Sold / Registered', 'Available'],
                series: [sold, available],
                colors: ['#0f766e', '#c2410c'],
                dataLabels: { style: { fontSize: '10px' } },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '62%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '11px',
                                    formatter: function (w) { return w.globals.seriesTotals.reduce((a, b) => a + b, 0); }
                                }
                            }
                        }
                    }
                },
                legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '10.5px' },
                tooltip: { y: { formatter: function (val) { return val; } } }
            };

            soldAvailableChart = new ApexCharts(document.querySelector("#sold-available-chart"), options);
            soldAvailableChart.render();
        }

        function renderTopBlocksChart(result) {
            var rows = (result.blockWiseData || []).map(function (item) {
                var total = (item.residentialCount || 0) + (item.commercialCount || 0) + (item.villaCount || 0) + (item.farmHouseCount || 0) + (item.largeComercialCount || 0);
                return { name: item.name, total: total };
            }).sort(function (a, b) { return b.total - a.total; }).slice(0, 6);

            if (!rows.length) { showChartEmpty('top-blocks-chart'); return; }

            var options = {
                series: [{ name: 'Total', data: rows.map(function (r) { return r.total; }) }],
                chart: { type: 'bar', height: 250, toolbar: { show: false } },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        barHeight: '55%',
                        distributed: true,
                        dataLabels: { position: 'top' }
                    }
                },
                colors: entColors,
                dataLabels: { enabled: true, offsetX: 16, style: { fontSize: '10px', colors: ['#334155'] } },
                xaxis: { categories: rows.map(function (r) { return r.name; }), labels: { style: { fontSize: '10px' } } },
                grid: { borderColor: '#f1f5f9' },
                legend: { show: false },
                tooltip: { y: { formatter: function (val) { return val; } } }
            };

            topBlocksChart = new ApexCharts(document.querySelector("#top-blocks-chart"), options);
            topBlocksChart.render();
        }
    </script>
}
