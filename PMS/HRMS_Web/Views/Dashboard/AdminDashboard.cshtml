                    <div class="ent-dashboard" id="entDashboard">

                        <!-- KPI Ribbon -->
                        <div class="ent-kpi-ribbon">
                            <div class="ent-kpi-tile ent-accent-blue">
                                <span class="ent-kpi-label">Total Members</span>
                                <span class="ent-kpi-value" id="totalMembers">0</span>
