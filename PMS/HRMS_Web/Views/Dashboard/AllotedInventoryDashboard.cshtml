@section Scripts {
    <script type="text/javascript">
        var pieChartType, mixChartInst, topBlocksChartInst, typeBreakdownChartInst;
        var entColors = ['#1e3a8a', '#c2410c', '#0f766e', '#6d28d9', '#be123c', '#0369a1', '#a16207', '#4338ca'];
        var mixColors = ['#0f766e', '#c2410c', '#6d28d9', '#be123c', '#4338ca'];

        var blockRows = [], typeRows = [], categoryRows = [];
        var blockSort = { key: 'total', dir: 'desc' };
        var typeSort = { key: 'total', dir: 'desc' };
        var categorySort = { key: 'count', dir: 'desc' };

        $(document).ready(function () {
            initTabs();
            initTableSorting();

            getAllProjects();
            fetchData();

            $("#searchButton").click(function () {
                fetchData();
            });
        });

        function getAllProjects() {
            $.ajax({
                type: 'GET',
                url: "/api/Project/GetAllProjects",
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 0) {
                        $("#Project").empty();
                        $("#Project").append('<option value="all">All Projects</option>');
                        var projects = response.data || [];
                        projects.forEach(function (project) {
                            $("#Project").append('<option value="' + project.id + '">' + project.description + '</option>');
                        });
                    }
                }
            });
        }

        function initTabs() {
            $(".ent-tab").click(function () {
                var tab = $(this).data("tab");
                $(".ent-tab").removeClass("active");
                $(this).addClass("active");
                $("#blockTableWrap").toggle(tab === "block");
                $("#typeTableWrap").toggle(tab === "type");
                $("#categoryTableWrap").toggle(tab === "category");
            });
        }

        function initTableSorting() {
            $(".ent-table thead th[data-key]").on("click", function () {
                var $th = $(this);
                var $table = $th.closest("table");
                var tableId = $table.attr("id");
                var key = $th.data("key");
                var state = tableId === "blockTable" ? blockSort : (tableId === "typeTable" ? typeSort : categorySort);

                if (state.key === key) {
                    state.dir = state.dir === "asc" ? "desc" : "asc";
                } else {
                    state.key = key;
                    state.dir = "desc";
                }

                updateSortIndicators($table, state);
                if (tableId === "blockTable") renderBlockTable();
                else if (tableId === "typeTable") renderTypeTable();
                else renderCategoryTable();
            });
        }

        function updateSortIndicators($table, state) {
            $table.find("th[data-key]").removeClass("ent-sort-asc ent-sort-desc");
            $table.find('th[data-key="' + state.key + '"]').addClass(state.dir === "asc" ? "ent-sort-asc" : "ent-sort-desc");
        }

        function setLoading(isLoading) {
            var $dashboard = $("#entDashboard");
            var $btn = $("#searchButton");
            if (isLoading) {
                $dashboard.addClass("ent-is-loading");
                $btn.prop("disabled", true);
                $("#errorBanner").hide();
            } else {
                $dashboard.removeClass("ent-is-loading");
                $btn.prop("disabled", false);
            }
        }

        function fetchJson(url) {
            return $.ajax({
                type: 'GET',
                url: url,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                contentType: 'application/json'
            }).then(
                function (response) { return { ok: response.code === 100, data: response.data }; },
                function () { return { ok: false, data: null }; }
            );
        }

        function fetchData() {
            var project = $("#Project").val() || "all";
            setLoading(true);

            fetchJson(`/Home/api/Dashboard/GetAllotedInventory?project=${project}`).done(function (current) {
                setLoading(false);
                if (current.ok) {
                    var result = current.data;
                    clearCharts();
                    updateKpis(result);

                    blockRows = computeRows(result.blockWiseData);
                    typeRows = computeRows(result.typeWiseStackedChartDTO);
                    categoryRows = computeCategoryRows(result.sizeWisePieChartDTO);
                    blockSort = { key: 'total', dir: 'desc' };
                    typeSort = { key: 'total', dir: 'desc' };
                    categorySort = { key: 'count', dir: 'desc' };
                    updateSortIndicators($("#blockTable"), blockSort);
                    updateSortIndicators($("#typeTable"), typeSort);
                    updateSortIndicators($("#categoryTable"), categorySort);
                    renderBlockTable();
                    renderTypeTable();
                    renderCategoryTable();

                    typePieChart(result);
                    renderMixChart(result);
                    renderTopBlocksChart();
                    renderTypeBreakdownChart();
                } else {
                    $("#errorBanner").show();
                }
            }).fail(function () {
                setLoading(false);
                $("#errorBanner").show();
                console.error('Error fetching data');
            });
        }

        function clearCharts() {
            if (pieChartType) pieChartType.destroy();
            if (mixChartInst) mixChartInst.destroy();
            if (topBlocksChartInst) topBlocksChartInst.destroy();
            if (typeBreakdownChartInst) typeBreakdownChartInst.destroy();
        }

        function animateValue(id, endValue) {
            var $el = $("#" + id);
            if (!$el.length) return;
            var startValue = 0;
            var duration = 700;
            var startTime = null;

            function step(timestamp) {
                if (!startTime) startTime = timestamp;
                var progress = Math.min((timestamp - startTime) / duration, 1);
                var current = Math.floor(progress * (endValue - startValue) + startValue);
                $el.text(current.toLocaleString());
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    $el.text(endValue.toLocaleString());
                }
            }
            window.requestAnimationFrame(step);
        }

        function sumBy(list, key) {
            if (!list || !list.length) return 0;
            return list.reduce(function (total, item) { return total + (item[key] || 0); }, 0);
        }

        function updateKpis(result) {
            var totalStock = result.totalStock || 0;
            var blocks = (result.blockWiseData || []).length;

            animateValue('kpiTotalStock', totalStock);
            animateValue('kpiBlocks', blocks);
        }

        function escapeHtml(str) {
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            return String(str == null ? '' : str).replace(/[&<>"']/g, function (ch) { return map[ch]; });
        }

        function computeRows(list) {
            return (list || []).map(function (item) {
                var residential = item.residentialCount || 0;
                var commercial = item.commercialCount || 0;
                var villa = item.villaCount || 0;
                var farmHouse = item.farmHouseCount || 0;
                var largeCommercial = item.largeComercialCount || 0;
                return {
                    name: item.name,
                    residential: residential,
                    commercial: commercial,
                    villa: villa,
                    farmHouse: farmHouse,
                    largeCommercial: largeCommercial,
                    total: residential + commercial + villa + farmHouse + largeCommercial
                };
            });
        }

        function sortRows(rows, key, dir) {
            var sorted = rows.slice().sort(function (a, b) {
                if (a[key] > b[key]) return 1;
                if (a[key] < b[key]) return -1;
                return 0;
            });
            if (dir === 'desc') sorted.reverse();
            return sorted;
        }

        function renderTableBody(bodyId, rows, grandTotal) {
            var $body = $("#" + bodyId);
            if (!rows.length) {
                $body.html('<tr><td colspan="8" class="ent-empty-cell"><i class="fa fa-inbox" style="margin-right:8px;"></i>No data available</td></tr>');
                return;
            }
            var html = rows.map(function (r) {
                var share = grandTotal ? ((r.total / grandTotal) * 100).toFixed(1) : '0.0';
                return '<tr>' +
                    '<td>' + escapeHtml(r.name) + '</td>' +
                    '<td class="ent-num">' + r.residential.toLocaleString() + '</td>' +
                    '<td class="ent-num">' + r.commercial.toLocaleString() + '</td>' +
                    '<td class="ent-num">' + r.villa.toLocaleString() + '</td>' +
                    '<td class="ent-num">' + r.farmHouse.toLocaleString() + '</td>' +
                    '<td class="ent-num">' + r.largeCommercial.toLocaleString() + '</td>' +
                    '<td class="ent-num ent-total-col">' + r.total.toLocaleString() + '</td>' +
                    '<td><div class="ent-share-col"><div class="ent-share-bar"><div class="ent-share-fill" style="width:' + share + '%"></div></div><span class="ent-share-text">' + share + '%</span></div></td>' +
                    '</tr>';
            }).join('');
            $body.html(html);
        }

        function renderTableFooter(footId, rows) {
            var $foot = $("#" + footId);
            if (!rows.length) { $foot.html(''); return; }
            var totals = rows.reduce(function (acc, r) {
                acc.residential += r.residential;
                acc.commercial += r.commercial;
                acc.villa += r.villa;
                acc.farmHouse += r.farmHouse;
                acc.largeCommercial += r.largeCommercial;
                acc.total += r.total;
                return acc;
            }, { residential: 0, commercial: 0, villa: 0, farmHouse: 0, largeCommercial: 0, total: 0 });

            $foot.html(
                '<tr class="ent-total-row">' +
                '<td>Total</td>' +
                '<td class="ent-num">' + totals.residential.toLocaleString() + '</td>' +
                '<td class="ent-num">' + totals.commercial.toLocaleString() + '</td>' +
                '<td class="ent-num">' + totals.villa.toLocaleString() + '</td>' +
                '<td class="ent-num">' + totals.farmHouse.toLocaleString() + '</td>' +
                '<td class="ent-num">' + totals.largeCommercial.toLocaleString() + '</td>' +
                '<td class="ent-num ent-total-col">' + totals.total.toLocaleString() + '</td>' +
                '<td></td>' +
                '</tr>'
            );
        }

        function renderBlockTable() {
            var sorted = sortRows(blockRows, blockSort.key, blockSort.dir);
            var grandTotal = blockRows.reduce(function (s, r) { return s + r.total; }, 0);
            renderTableBody('blockTableBody', sorted, grandTotal);
            renderTableFooter('blockTableFoot', blockRows);
        }

        function renderTypeTable() {
            var sorted = sortRows(typeRows, typeSort.key, typeSort.dir);
            var grandTotal = typeRows.reduce(function (s, r) { return s + r.total; }, 0);
            renderTableBody('typeTableBody', sorted, grandTotal);
            renderTableFooter('typeTableFoot', typeRows);
        }

        function computeCategoryRows(list) {
            return (list || []).map(function (item) {
                return { name: item.name, count: item.count || 0 };
            });
        }

        function renderCategoryTableBody(bodyId, rows, grandTotal) {
            var $body = $("#" + bodyId);
            if (!rows.length) {
                $body.html('<tr><td colspan="3" class="ent-empty-cell"><i class="fa fa-inbox" style="margin-right:8px;"></i>No data available</td></tr>');
                return;
            }
            var html = rows.map(function (r) {
                var share = grandTotal ? ((r.count / grandTotal) * 100).toFixed(1) : '0.0';
                return '<tr>' +
                    '<td>' + escapeHtml(r.name) + '</td>' +
                    '<td class="ent-num ent-total-col">' + r.count.toLocaleString() + '</td>' +
                    '<td><div class="ent-share-col"><div class="ent-share-bar"><div class="ent-share-fill" style="width:' + share + '%"></div></div><span class="ent-share-text">' + share + '%</span></div></td>' +
                    '</tr>';
            }).join('');
            $body.html(html);
        }

        function renderCategoryTableFooter(footId, rows) {
            var $foot = $("#" + footId);
            if (!rows.length) { $foot.html(''); return; }
            var total = rows.reduce(function (sum, r) { return sum + r.count; }, 0);
            $foot.html(
                '<tr class="ent-total-row">' +
                '<td>Total</td>' +
                '<td class="ent-num ent-total-col">' + total.toLocaleString() + '</td>' +
                '<td></td>' +
                '</tr>'
            );
        }

        function renderCategoryTable() {
            var sorted = sortRows(categoryRows, categorySort.key, categorySort.dir);
            var grandTotal = categoryRows.reduce(function (s, r) { return s + r.count; }, 0);
            renderCategoryTableBody('categoryTableBody', sorted, grandTotal);
            renderCategoryTableFooter('categoryTableFoot', categoryRows);
        }

        function showChartEmpty(containerId, message) {
            $("#" + containerId).html('<div class="ent-chart-empty"><i class="fa fa-inbox" style="margin-right:8px;"></i>' + (message || 'No data available') + '</div>');
        }

        function typePieChart(result) {
            var data = result.typeWisePieChartDTO || [];
            if (!data.length) { showChartEmpty('plot-type-pie-chart'); return; }

            var labels = data.map(item => item.name);
            var series = data.map(item => item.count);

            var pieChartOptions = {
                chart: { type: 'donut', width: '100%', height: 230, toolbar: { show: false } },
                labels: labels,
                series: series,
                colors: entColors,
                dataLabels: { style: { fontSize: '10px' } },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '62%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '11px',
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                                    }
                                }
                            }
                        }
                    }
                },
                legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '10.5px', itemMargin: { horizontal: 6, vertical: 2 } },
                tooltip: { y: { formatter: function (val) { return val; } } }
            };

            pieChartType = new ApexCharts(document.querySelector("#plot-type-pie-chart"), pieChartOptions);
            pieChartType.render();
        }

        function renderMixChart(result) {
            var residential = sumBy(result.blockWiseData, 'residentialCount');
            var commercial = sumBy(result.blockWiseData, 'commercialCount');
            var villa = sumBy(result.blockWiseData, 'villaCount');
            var farmHouse = sumBy(result.blockWiseData, 'farmHouseCount');
            var largeCommercial = sumBy(result.blockWiseData, 'largeComercialCount');

            if (!(residential + commercial + villa + farmHouse + largeCommercial)) { showChartEmpty('mix-chart'); return; }

            var options = {
                chart: { type: 'donut', width: '100%', height: 230, toolbar: { show: false } },
                labels: ['Residential', 'Commercial', 'Villa', 'Farm House', 'Large Commercial'],
                series: [residential, commercial, villa, farmHouse, largeCommercial],
                colors: mixColors,
                dataLabels: { style: { fontSize: '10px' } },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '62%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '11px',
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                                    }
                                }
                            }
                        }
                    }
                },
                legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '10.5px', itemMargin: { horizontal: 6, vertical: 2 } },
                tooltip: { y: { formatter: function (val) { return val; } } }
            };

            mixChartInst = new ApexCharts(document.querySelector("#mix-chart"), options);
            mixChartInst.render();
        }

        function renderTopBlocksChart() {
            var sorted = blockRows.slice().sort(function (a, b) { return b.total - a.total; }).slice(0, 6);
            if (!sorted.length) { showChartEmpty('top-blocks-chart'); return; }

            var options = {
                series: [{ name: 'Total', data: sorted.map(function (r) { return r.total; }) }],
                chart: { type: 'bar', height: 230, toolbar: { show: false } },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        barHeight: '55%',
                        distributed: true,
                        dataLabels: { position: 'top' }
                    }
                },
                colors: entColors,
                dataLabels: { enabled: true, offsetX: 16, style: { fontSize: '10px', colors: ['#334155'] } },
                xaxis: { categories: sorted.map(function (r) { return r.name; }), labels: { style: { fontSize: '10px' } } },
                grid: { borderColor: '#f1f5f9' },
                legend: { show: false },
                tooltip: { y: { formatter: function (val) { return val; } } }
            };

            topBlocksChartInst = new ApexCharts(document.querySelector("#top-blocks-chart"), options);
            topBlocksChartInst.render();
        }

        function renderTypeBreakdownChart() {
            if (!typeRows.length) { showChartEmpty('type-breakdown-chart'); return; }

            var options = {
                series: [
                    { name: 'Residential', data: typeRows.map(function (r) { return r.residential; }) },
                    { name: 'Commercial', data: typeRows.map(function (r) { return r.commercial; }) },
                    { name: 'Villa', data: typeRows.map(function (r) { return r.villa; }) },
                    { name: 'Farm House', data: typeRows.map(function (r) { return r.farmHouse; }) },
                    { name: 'Large Commercial', data: typeRows.map(function (r) { return r.largeCommercial; }) }
                ],
                chart: { type: 'bar', height: 230, stacked: true, toolbar: { show: false } },
                plotOptions: { bar: { borderRadius: 3, columnWidth: '50%' } },
                colors: mixColors,
                xaxis: { categories: typeRows.map(function (r) { return r.name; }), labels: { style: { fontSize: '9px' }, rotate: -30, trim: true } },
                yaxis: { labels: { style: { fontSize: '10px' } } },
                grid: { borderColor: '#f1f5f9' },
                legend: { position: 'top', horizontalAlign: 'left', fontSize: '10px' },
                tooltip: { y: { formatter: function (val) { return val; } } },
                fill: { opacity: 1 }
            };

            typeBreakdownChartInst = new ApexCharts(document.querySelector("#type-breakdown-chart"), options);
            typeBreakdownChartInst.render();
        }
    </script>
}
