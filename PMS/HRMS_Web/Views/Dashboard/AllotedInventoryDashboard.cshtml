<style>
    .ent-wrap {
        font-family: inherit;
    }

    .ent-wrap .container-fluid {
        padding-left: 0;
        padding-right: 0;
    }

    .ent-wrap * {
        box-sizing: border-box;
    }

    /* Toolbar */
    .ent-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 14px;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
    }

    .ent-toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ent-toolbar-title i {
        color: #1e3a8a;
    }

    .ent-toolbar-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 10px;
    }

    .ent-field label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 4px;
    }

    .ent-field {
        min-width: 220px;
    }

    .ent-input {
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        height: 34px;
        font-size: 13px;
    }

    .ent-btn {
        border: 1px solid #1e3a8a;
        border-radius: 4px;
        background: #1e3a8a;
        color: #fff;
        font-weight: 600;
        font-size: 13px;
        padding: 0 18px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: background .15s ease;
    }

    .ent-btn:hover {
        background: #16296b;
        color: #fff;
    }

    .ent-btn[disabled] {
        opacity: .65;
        cursor: not-allowed;
    }

    .ent-error-banner {
        display: none;
        margin-bottom: 14px;
        padding: 9px 14px;
        border-radius: 6px;
        border: 1px solid #f5c2c0;
        background: #fdecea;
        color: #b3261e;
        font-size: 13px;
        font-weight: 500;
    }

    /* KPI ribbon */
    .ent-kpi-ribbon {
        display: flex;
        flex-wrap: wrap;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 14px;
    }

    @@media (max-width: 991px) {
        .ent-kpi-tile {
            flex: 1 1 50% !important;
            border-bottom: 1px solid #e2e8f0;
        }
    }

    @@media (max-width: 575px) {
        .ent-kpi-tile {
            flex: 1 1 100% !important;
        }
    }

    .ent-kpi-tile {
        flex: 1;
        min-width: 160px;
        padding: 12px 16px;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        position: relative;
    }

    .ent-kpi-tile:last-child {
        border-right: none;
    }

    .ent-kpi-tile::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
    }

    .ent-accent-blue::before {
        background: #1e3a8a;
    }

    .ent-accent-teal::before {
        background: #0f766e;
    }

    .ent-accent-orange::before {
        background: #c2410c;
    }

    .ent-accent-slate::before {
        background: #475569;
    }

    .ent-kpi-label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .ent-kpi-value {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }

    .ent-kpi-sub {
        display: block;
        font-size: 11px;
        color: #94a3b8;
        margin-top: 4px;
    }

    /* Additional insights row */
    .ent-insights-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 14px;
    }

    @@media (max-width: 991px) {
        .ent-insights-row {
            grid-template-columns: 1fr;
        }
    }

    /* Main grid */
    .ent-main-grid {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 14px;
        align-items: start;
    }

    @@media (max-width: 991px) {
        .ent-main-grid {
            grid-template-columns: 1fr;
        }
    }

    .ent-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
    }

    .ent-panel-header {
        padding: 10px 16px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 12.5px;
        font-weight: 700;
        color: #1e293b;
        text-transform: uppercase;
        letter-spacing: .03em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .ent-tabs {
        display: flex;
        gap: 4px;
    }

    .ent-tab {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 4px;
        padding: 4px 12px;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #64748b;
        cursor: pointer;
    }

    .ent-tab.active {
        background: #eef2ff;
        color: #1e3a8a;
        border-color: #c7d2fe;
    }

    .ent-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
    }

    .ent-table thead th {
        position: sticky;
        top: 0;
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 8px 10px;
        text-align: left;
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #475569;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    .ent-table thead th.ent-num {
        text-align: right;
    }

    .ent-table thead th[data-key]::after {
        content: "";
        display: inline-block;
        width: 10px;
    }

    .ent-table thead th.ent-sort-asc::after {
        content: "\2191";
        color: #1e3a8a;
    }

    .ent-table thead th.ent-sort-desc::after {
        content: "\2193";
        color: #1e3a8a;
    }

    .ent-table tbody td {
        padding: 8px 10px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }

    .ent-table tbody tr:nth-child(even) {
        background: #fafbfc;
    }

    .ent-table tbody tr:hover {
        background: #f0f4ff;
    }

    .ent-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .ent-total-col {
        font-weight: 700;
        color: #0f172a;
    }

    .ent-total-row td {
        background: #f8fafc !important;
        font-weight: 700;
        border-top: 2px solid #e2e8f0;
    }

    .ent-share-col {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 110px;
    }

    .ent-share-bar {
        flex: 1;
        height: 6px;
        background: #e2e8f0;
        border-radius: 3px;
        overflow: hidden;
    }

    .ent-share-fill {
        height: 100%;
        background: #1e3a8a;
        border-radius: 3px;
    }

    .ent-share-text {
        font-size: 11px;
        color: #64748b;
        min-width: 34px;
        text-align: right;
    }

    .ent-empty-cell {
        text-align: center;
        padding: 34px;
        color: #94a3b8;
        font-size: 13px;
    }

    /* Side panel */
    .ent-side-panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .ent-chart-body-sm {
        min-height: 220px;
        padding: 8px 6px 4px;
        position: relative;
    }

    .ent-chart-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 180px;
        color: #94a3b8;
        font-size: 12.5px;
    }

    .ent-loading-overlay {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, .65);
        align-items: center;
        justify-content: center;
        z-index: 5;
        border-radius: 6px;
    }

    .ent-loading-overlay i {
        font-size: 24px;
        color: #1e3a8a;
    }

    .ent-dashboard {
        position: relative;
    }

    .ent-dashboard.ent-is-loading .ent-loading-overlay {
        display: flex;
    }
</style>

