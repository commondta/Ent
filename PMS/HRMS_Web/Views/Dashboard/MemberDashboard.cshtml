<style>
    .sd-wrap {
        font-family: inherit;
    }

    .sd-wrap .container-fluid {
        padding-left: 0;
        padding-right: 0;
    }

    .sd-filter-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(24, 39, 75, 0.08);
        padding: 18px 20px;
        margin-bottom: 20px;
    }

    .sd-filter-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .sd-filter-title {
        font-size: 16px;
        font-weight: 600;
        color: #22223b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sd-search-box {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        max-width: 320px;
        margin-left: auto;
    }

    .sd-search-box input {
        border-radius: 8px;
        border: 1px solid #e1e5ee;
        height: 38px;
    }

    .sd-btn {
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg, #4361ee, #3a0ca3);
        color: #fff;
        font-weight: 600;
        padding: 9px 22px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 10px rgba(67, 97, 238, .3);
        transition: opacity .15s ease, transform .1s ease;
        flex-shrink: 0;
    }

    .sd-btn:hover {
        opacity: .92;
        color: #fff;
    }

    .sd-btn:active {
        transform: translateY(1px);
    }

    .sd-btn[disabled] {
        opacity: .7;
        cursor: not-allowed;
    }

    .sd-error-banner {
        display: none;
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 8px;
        background: #fdecea;
        color: #b3261e;
        font-size: 13px;
        font-weight: 500;
    }

    .sd-kpi-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    @@media (max-width: 991px) {
        .sd-kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 575px) {
        .sd-kpi-row {
            grid-template-columns: 1fr;
        }
    }

    .sd-kpi-card {
        border-radius: 14px;
        padding: 18px 20px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 6px 16px rgba(24, 39, 75, .12);
        position: relative;
        overflow: hidden;
    }

    .sd-kpi-card::after {
        content: "";
        position: absolute;
        right: -20px;
        top: -20px;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .12);
    }

    .sd-kpi-blue {
        background: linear-gradient(135deg, #4361ee, #3a0ca3);
    }

    .sd-kpi-teal {
        background: linear-gradient(135deg, #06d6a0, #059669);
    }

    .sd-kpi-orange {
        background: linear-gradient(135deg, #f77f00, #d1495b);
    }

    .sd-kpi-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: rgba(255, 255, 255, .18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        z-index: 1;
    }

    .sd-kpi-info {
        display: flex;
        flex-direction: column;
        z-index: 1;
        min-width: 0;
    }

    .sd-kpi-value {
        font-size: 26px;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sd-kpi-label {
        font-size: 12.5px;
        opacity: .9;
        font-weight: 500;
    }

    .sd-row {
        margin-bottom: 20px;
    }

    .sd-chart-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 2px 10px rgba(24, 39, 75, 0.08);
        padding: 18px 18px 8px;
        height: 100%;
    }

    .sd-chart-header {
        font-size: 14.5px;
        font-weight: 600;
        color: #22223b;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
        padding-bottom: 10px;
        border-bottom: 1px solid #f0f1f5;
    }

    .sd-chart-header i {
        color: #4361ee;
    }

    .sd-chart-count-badge {
        font-size: 11.5px;
        font-weight: 600;
        color: #4361ee;
        background: #eef1fd;
        border-radius: 20px;
        padding: 3px 10px;
    }

    .sd-chart-body {
        min-height: 340px;
        position: relative;
    }

    .sd-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        color: #9aa0ac;
        font-size: 14px;
        font-weight: 500;
    }

    .sd-loading-overlay {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, .6);
        align-items: center;
        justify-content: center;
        z-index: 5;
        border-radius: 14px;
    }

    .sd-loading-overlay i {
        font-size: 26px;
        color: #4361ee;
    }

    .sd-dashboard.sd-is-loading .sd-loading-overlay {
        display: flex;
    }
</style>

<!-- Middle Content Start -->

