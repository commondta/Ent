<!-- Middle Content End -->
@section Scripts {
    <script type="text/javascript">
        var memberChart, memberDonutChart;
        var allCityData = [];

        var sdColors = ['#4361ee', '#f77f00', '#06d6a0', '#7209b7', '#e63946', '#4cc9f0', '#ffb703', '#560bad'];

        $(document).ready(function () {
            fetchData();

            $("#searchButton").click(function () {
                fetchData();
            });

            $("#citySearch").on('input', function () {
                var term = $(this).val().toLowerCase();
                var filtered = allCityData.filter(function (item) {
                    return (item.name || '').toLowerCase().indexOf(term) !== -1;
                });
                renderCityBarChart(filtered);
            });
        });

        function setLoading(isLoading) {
            var $dashboard = $("#sdDashboard");
            var $btn = $("#searchButton");
            if (isLoading) {
                $dashboard.addClass("sd-is-loading");
                $btn.prop("disabled", true);
                $("#errorBanner").hide();
            } else {
                $dashboard.removeClass("sd-is-loading");
                $btn.prop("disabled", false);
            }
        }

        function fetchData() {
            setLoading(true);
            $.ajax({
                type: 'GET',
                url: `/Home/api/Dashboard/GetMemberDashboardValues`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                contentType: 'application/json',
                success: function (response) {
                    setLoading(false);
                    if (response.code === 100) {
                        var result = response.data;
                        clearCharts();
                        $("#citySearch").val('');
                        processMemberData(result);
                    } else {
                        $("#errorBanner").show();
                    }
                },
                error: function (error) {
                    setLoading(false);
                    $("#errorBanner").show();
                    console.error('Error fetching data:', error);
                }
            });
        }

        function clearCharts() {
            if (memberChart) memberChart.destroy();
            if (memberDonutChart) memberDonutChart.destroy();
        }

        function animateValue(id, endValue) {
            var $el = $("#" + id);
            var startValue = 0;
            var duration = 700;
            var startTime = null;

            function step(timestamp) {
                if (!startTime) startTime = timestamp;
                var progress = Math.min((timestamp - startTime) / duration, 1);
                var current = Math.floor(progress * (endValue - startValue) + startValue);
                $el.text(current.toLocaleString());
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    $el.text(endValue.toLocaleString());
                }
            }
            window.requestAnimationFrame(step);
        }

        function showEmptyState(containerId, message) {
            $("#" + containerId).html('<div class="sd-empty"><i class="fa fa-inbox" style="margin-right:8px;"></i>' + (message || 'No data available') + '</div>');
        }

        function processMemberData(result) {
            var data = (result.memberCityWiseData || []).slice();

            // Show every result, sorted so the largest cities surface first.
            data.sort(function (a, b) { return (b.count || 0) - (a.count || 0); });
            allCityData = data;

            var totalMembers = data.reduce(function (sum, item) { return sum + (item.count || 0); }, 0);
            animateValue('kpiTotalMembers', totalMembers);
            animateValue('kpiTotalCities', data.length);
            $("#kpiTopCity").text(data.length ? (data[0].name + ' (' + data[0].count + ')') : '-');

            renderCityBarChart(data);
            renderTopCitiesDonut(data);
        }

        function renderCityBarChart(data) {
            if (memberChart) { memberChart.destroy(); memberChart = null; }

            $("#cityCountBadge").text(data.length + (data.length === 1 ? ' city' : ' cities'));

            if (!data.length) { showEmptyState('member-wise-stacked-chart', 'No matching cities'); return; }

            $("#member-wise-stacked-chart").empty();

            var labels = data.map(item => item.name);
            var counts = data.map(item => item.count);

            // Dynamic height ensures every city is rendered without clipping or scrolling.
            var chartHeight = Math.max(360, data.length * 30);

            var options = {
                series: [{ name: 'Members', data: counts }],
                chart: {
                    type: 'bar',
                    height: chartHeight,
                    toolbar: { show: false }
                },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        barHeight: '65%',
                        distributed: true,
                        dataLabels: { position: 'top' }
                    }
                },
                colors: sdColors,
                dataLabels: {
                    enabled: true,
                    offsetX: 20,
                    style: { fontSize: '11px', colors: ['#22223b'] }
                },
                xaxis: {
                    categories: labels,
                    title: { text: 'Count' }
                },
                grid: { borderColor: '#f0f1f5' },
                legend: { show: false },
                tooltip: {
                    y: {
                        formatter: function (val) {
                            return val;
                        }
                    }
                },
                fill: { opacity: 1 }
            };

            memberChart = new ApexCharts(document.querySelector("#member-wise-stacked-chart"), options);
            memberChart.render();
        }

        function renderTopCitiesDonut(data) {
            if (!data.length) { showEmptyState('member-top-donut-chart'); return; }

            var topN = data.slice(0, 6);
            var othersTotal = data.slice(6).reduce(function (sum, item) { return sum + (item.count || 0); }, 0);

            var labels = topN.map(item => item.name);
            var series = topN.map(item => item.count);

            if (othersTotal > 0) {
                labels.push('Others');
                series.push(othersTotal);
            }

            var options = {
                chart: {
                    type: 'donut',
                    width: '100%',
                    height: 340,
                    toolbar: { show: false }
                },
                labels: labels,
                series: series,
                colors: sdColors,
                dataLabels: {
                    style: { fontSize: '11px' }
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total',
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                                    }
                                }
                            }
                        }
                    }
                },
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center',
                    fontSize: '11px'
                },
                tooltip: {
                    y: {
                        formatter: function (val) {
                            return val;
                        }
                    }
                }
            };

            memberDonutChart = new ApexCharts(document.querySelector("#member-top-donut-chart"), options);
            memberDonutChart.render();
        }
    </script>
}
