                        </div>
                        <div class="sd-error-banner" id="errorBanner"><i class="fa fa-exclamation-circle"></i> Unable to load member data. Please try again.</div>
                    </div>

                    <div class="sd-dashboard" id="sdDashboard">

                        <!-- KPI Cards -->
                        <div class="sd-kpi-row">
                            <div class="sd-kpi-card sd-kpi-blue">
                                <div class="sd-kpi-icon"><i class="fa fa-users"></i></div>
                                <div class="sd-kpi-info">
                                    <span class="sd-kpi-value" id="kpiTotalMembers">0</span>
                                    <span class="sd-kpi-label">Total Members</span>
                                </div>
                            </div>
                            <div class="sd-kpi-card sd-kpi-teal">
                                <div class="sd-kpi-icon"><i class="fa fa-map-marker"></i></div>
                                <div class="sd-kpi-info">
                                    <span class="sd-kpi-value" id="kpiTotalCities">0</span>
                                    <span class="sd-kpi-label">Total Cities</span>
                                </div>
                            </div>
                            <div class="sd-kpi-card sd-kpi-orange">
                                <div class="sd-kpi-icon"><i class="fa fa-trophy"></i></div>
                                <div class="sd-kpi-info">
                                    <span class="sd-kpi-value" id="kpiTopCity">-</span>
