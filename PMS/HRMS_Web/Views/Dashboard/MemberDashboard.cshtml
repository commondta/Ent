                                        <span><i class="fa fa-bar-chart"></i> Members by City (All Results)</span>
                                        <span class="sd-chart-count-badge" id="cityCountBadge">0 cities</span>
                                    </div>
                                    <div class="sd-chart-body" id="member-wise-stacked-chart"></div>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-12">
                                <div class="sd-chart-card">
                                    <div class="sd-chart-header"><i class="fa fa-circle-o-notch"></i> Top Cities Share</div>
