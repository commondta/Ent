<div class="modal" id="findmodal" tabindex="-1" role="dialog" aria-labelledby="modaltitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header modal-xl vd_bg-blue vd_white">
                <h4 class="modal-title" id="modaltitle">Find Deal</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">
                            <table id="findmodaltable" class="table">
                                <thead class="bg-theme">
                                    <tr>
                                        <th class="text-white">Dealer Name</th>
                                        <th class="text-white">Deal Name</th>                 
                                        <th class="text-white">Deal Nature</th>
                                        <th class="text-white">Deal type</th>
                                        <th class="text-white">Deal Date</th>
                                        <th class="text-white">Deal Expiry Date</th>
                                        <th class="text-white">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="findmodaltbody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal" id="dealerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title">Select Dealer.</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <table id="dealerlist" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white">#</th>
                                            <th class="text-white">DealerName</th>
                                            @*                                            <th class="text-white">Registration No.</th>
                                            <th class="text-white">Type</th>
                                            <th class="text-white">Real Estate</th>
                                            <th class="text-white">Status</th>*@
                                            <th class="text-white">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="Dealertbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


<input id="Prownumber" class="hide" value="0" />
