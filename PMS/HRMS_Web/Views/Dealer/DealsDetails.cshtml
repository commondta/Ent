@section Scripts {

    <script>
        function AddRow3() {


            var rownumber3 = parseInt($("#rownumber3").val());
            var LineId = rownumber3;
            rownumber3 = rownumber3 + 1;
            $("#rownumber3").val(rownumber3);


            var row = '<tr id="' + rownumber3 + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber3 + '"/></td>' +
                '<td> <select  class="form-control DealCode" /></td>' +
                '<td> <input  class="form-control No.ofPlots" /></td>' +
                '<td> <select  class="form-control Block" /></td>' +
                '<td> <input  class="form-control AdvanceperPlot" /></td>' +
                '<td> <input  class="form-control TotalAdvance" /></td>' +
                '<td> <input  class="form-control Rebate" /></td>' +
                '<td> <input  class="form-control NetReceivable" /></td>' +
                '<td> <input  class="form-control TotalApplied" /></td>' +
                '<td> <input  class="form-control OutstandingBalance" /></td>' +
                '<td> <input  type="date" class="form-control ReservationDate" /></td>' +
                '<td> <input  class="form-control Status" /></td>' +

                '<td style="padding-top:20px"><a class="btn btn-sm btn-danger"  onclick="return DeleteItemRow(\'' + rownumber3 + '\')">X</a> </td>' +
                '</tr>';


            $("#Dealstbody").append(row);


        }

        function DeleteItemRow(id) {
            $('#' + id).remove();
        }
    </script>

 }
