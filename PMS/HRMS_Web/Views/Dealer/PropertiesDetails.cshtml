@section Scripts {

    <script>
        function AddRow1() {


            var rownumber1 = parseInt($("#rownumber1").val());
            var LineId = rownumber1;
            rownumber1 = rownumber1 + 1;
            $("#rownumber1").val(rownumber1);


            var row = '<tr id="' + rownumber1 + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber1 + '"/></td>' +
                '<td> <select class="form-control RegistrationNo." /></td>' +
                '<td> <select  class="form-control PropertyNo." /></td>' +
                '<td> <select  class="form-control Block" /></td>' +
                '<td> <select  class="form-control Phase" /></td>' +
                '<td> <select  class="form-control RealEstateType" /></td>' +
                '<td> <select  class="form-control Project" /></td>' +
                '<td> <select  class="form-control ConstructionStatus" /></td>' +
                '<td> <select  class="form-control Nature" /></td>' +
                '<td> <input  class="form-control SoftLocked" /></td>' +
                '<td> <input  class="form-control OutstandingLandCost" /></td>' +
                '<td> <input  class="form-control OutstandingCharges" /></td>' +
                '<td> <input  type="date" class="form-control ExpiryDate" /></td>' +
                '<td> <input  type="date" class="form-control ReservationDate" /></td>' +
                '<td> <input  class="form-control Remarks" /></td>' +

                '<td style="padding-top:20px"><a class="btn btn-sm btn-danger"  onclick="return DeleteItemRow(\'' + rownumber1 + '\')">X</a> </td>' +
                '</tr>';


            $("#Propertiestbody").append(row);


        }

        function DeleteItemRow(id) {
            $('#' + id).remove();
        }
    </script>


 }
