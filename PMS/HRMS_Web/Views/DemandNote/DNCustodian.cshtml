    @section Scripts {

    <script type="text/javascript">
        $(document).ready(function() {
             GetAllItemGroups();
            GetAllWarehousesData();
            GetPreviousRecords();
        });
          function GetAllWhse(rownum,whse){

              
                        $("#whse"+rownum).empty();
                        var row = ' <option value="-1">Select WareHouse</option> ';

                        $("#whse"+rownum).append(row);

                        var relist = WareHouses;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {


                                    var row = ' <option value="' + list.whsCode + '" >'+ list.whsName + '</option> ';

                                    $("#whse"+rownum).append(row);

                                sr++;
                            }
                        }

                        $("#whse"+rownum).select2();
                        if (whse != null && whse != undefined) {
                             $("#whse" + rownum).select2("val", [whse]);
                        }
                     }

        function ApprovedOrRejectMDN() {
            var id = $("#mdnTableId").val();
            $("#mdnNum").val(id);
            $("#modalapproval").modal("show");
            $("#ViewRequest").modal("hide");

        }
        function approveMDN() {
            var id = $("#mdnNum").val();
            var status = $("#ChangeStatus").val()=="true"?true:false;
            var Comment = $("#Comment").val();
            debugger;
             $.ajax({
                type: 'GET',
                url: `/api/DemandNote/ApproveOrRejectByCustodian`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: {id:id,status:status,Comment:Comment},
                async: false,
                contentType: 'application/json',
                success: function (response) {
                     
                    if (response.code === 100) {
                         
                        $("#modalapproval").modal("hide");
                        GetPreviousRecords();
                          Swal.fire({
                                  icon: 'success',
                                  title: 'Success',
                                  text: response.message,
      
                            });

                    }
                    else{
                         Swal.fire({
                                  icon: 'error',
                                  title: 'Error',
                                  text: response.message,
      
                            });
                    }
                }
            });
        }
         function GetPreviousRecords() {
             var id = $("#id").val();
            $.ajax({
                type: 'GET',
                url: `/api/DemandNote/GetAllWithRespectToCustodian`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: {id:id},
                async: false,
                contentType: 'application/json',
                success: function (response) {
                     
                    if (response.code === 100) {
                         
                        var datatabl = $('#findmodaltable').DataTable();
                        datatabl.destroy();
                        $("#findmodaltbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                //var approveOrRejected=list.IsDemandNoteApproved==null?"Requested":
                                var ApprovedOrRejectStatus = "";
                                
                                if (list.isDemandNoteApproved == null && list.isDemandNoteRequested == true && list.dnManagerStatus == true) {
                                    ApprovedOrRejectStatus = "Requested";
                                }
                                else if (list.dnCustodianStatus == true) {
                                    ApprovedOrRejectStatus = "Approved";
                                }
                                else {
                                    ApprovedOrRejectStatus = "Rejected";
                                }
                                var row = '<tr>' +
                                    '<td>' + list.id + '</td>' +
                                    '<td>' + list.requesterName + '</td>' +
                                    '<td>' + list.deparment + '</td>' +
                                    '<td>' + list.requiredDate + '</td>' +
                                    '<td>' + ApprovedOrRejectStatus + '</td>' +
                                    '<td><a onclick="SelectMDN(' + list.id + ')"><i class="fa fa-eye"></i></a></td>' +
                                    '</tr>';
                                $("#findmodaltbody").append(row);
                                sr++;
                            }
                        }

                        $('#findmodaltable').dataTable();
                    }
                }
            });

        }


         var WareHouses;
       
           function GetAllWarehousesData(){

              $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllWhse`,
                dataType: "json",
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        WareHouses=   response.data;
                    }
                }
            });
        }

         function SelectMDN(id) {
             
            var url = "/api/DemandNote/Get?id=" + id + "";
             
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                     
                    if (response.code === 100) {
                        var mdnData = response.data;
                        $("#ViewRequest").modal("show");

                        $("#Status").val(mdnData.status);
                        $("#mdnTableId").val(mdnData.id);
                        $("#RequesterName").val(mdnData.requesterName);
                        
                        $("#Department").val(mdnData.deparment);
                        $("#ItemGroupCode").val(mdnData.itemGroupCode).trigger("change");
                        //$("#ValidUntill").val(mdnData.validUntill);
                        $("#RequiredDate").val(mdnData.requiredDate);
                        $("#MDNType").val(mdnData.mdnType);
                        $("#DNTabletbody").empty();

                         
                        $.each(mdnData.demandNoteItems, function (index, mdnItem) {
                            var rownumber = parseInt($("#rownumber").val());
                            var lineprice = mdnItem.infoPrice;
                            var linetotal = parseFloat(mdnItem.requiredQuantity) * parseFloat(lineprice);
                                var LineId = rownumber;
                            rownumber = rownumber + 1;
                            var sr = index + 1;
                                $("#rownumber").val(rownumber);
                            debugger;
                                var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                                    '<td> <input disabled class="form-control line" value="' + sr + '"/></td>' +
                                    '<td> <input disabled id="ItemNo' + rownumber + '" value="'+mdnItem.itemNo+'" class="form-control ItemNo" style="width:100%" /></td>' +
                                    '<td> <input  value="'+mdnItem.description+'"  class="form-control Description" disabled/></td>' +
                                    '<td> <input disabled  type="text" value="'+mdnItem.requiredDate+'" class="form-control RequiredDate" /></td>' +
                                    '<td><input type="number" max="'+mdnItem.requiredQuantity+'" name="RequiredQuantity[]" value="'+mdnItem.requiredQuantity+'" class="form-control RequiredQuantity" /></td>' +
                                    '<td><select disabled id="whse' + rownumber + '" class="form-control whse" style="width:100%"></select></td>' +
                                    '<td><input value="'+mdnItem.uom+'" disabled id="UomCode' + rownumber + '" class="form-control UomCode" style="width:100%" /></td>' +
                              
                                    '<td><input  disabled value="'+mdnItem.prjCode+'" type="text" class="form-control prjCode"  /></td>' +
                                    '<td><input  value="'+lineprice+'" type="number" class="form-control infoPrice"  /></td>' +
                                    '<td><input disabled value="'+linetotal+'" type="text" class="form-control lineTotal"  /></td>' +
                                    '<td><input disabled type="text" class="form-control Remarks" value="'+mdnItem.remarks+'"  /></td>' +
                                      '<td><input checked type="checkbox" class="isChecked" /> </td>' +
                                    '</tr>';

                            $("#DNTabletbody").append(row);
                               GetAllWhse(rownumber,mdnItem.whse)
            
                        });

                   
                  

                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Lead");
                         Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something Went Wrong',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        
               function GetAllItemGroups() {
                
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllItemGroups`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    
                    if (response.code === 100) {

                        $("#ItemGroupCode").empty();
                        var row = ' <option value="-1">Select Item Group</option> ';

                        $("#ItemGroupCode").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                 
                              
                                    var row = ' <option data-custordian="'+list.custodianId+'" value="' + list.id + '" >'+ list.name + '</option> ';

                                    $("#ItemGroupCode").append(row);
                          
                                sr++;
                            }
                        }

                        $('#ItemGroupCode').select2();
                    }
                }
            });
        }
         $('body').on('change', '#ItemGroupCode', SelectGroupName);
       
         function SelectGroupName(){
             var select2row = $(this);
             
            var data_Val = $(this).select2('data');
             var custodianId = data_Val[0].element.attributes['data-custordian'].value;
            var goupname = data_Val[0].text;
             $("#GroupName").val(goupname);
             $("#CustodianId").val(custodianId);
         }
         function SetItemName() {
              var select2row = $(this);
            var data_Val = $(this).select2('data');
            var itemName = data_Val[0].text;
            var itemCode = data_Val[0].id;
              
             select2row.parent().parent().find(".Description").val(itemName);
               $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetItemDetails`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                 data: { itemCode: itemCode },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                      
                    if (response.code === 100) {
                           var relist = response.data;
                       
                       select2row.parent().parent().find(".LastPurPrice").val(relist.lastPurPrc);
                     //  select2row.parent().parent().find(".infoPrice").val(relist.lastPurPrc);
                       select2row.parent().parent().find(".UomCode").val(relist.uomCode).trigger("change");
                       select2row.parent().parent().find(".whse").val(relist.dfltWH).trigger("change");
                    }
                }
            });

         }
        


         function UpdateAndApproveRequest() {

            var demandNote = new Object();

            var demandNoteItems = new Array();

            demandNote.Id = $('#mdnTableId').val();
            demandNote.Status = $('#Status').val();
            demandNote.RequesterName = $('#RequesterName').val();
            demandNote.ValidUntill = $('#RequiredDate').val();
            demandNote.RequiredDate = $('#RequiredDate').val();
            demandNote.MDNType = $('#MDNType').val();
            demandNote.Remarks = $('#Remarks').val();
            demandNote.Deparment = $('#Department').val();
            demandNote.ItemGroupCode = $('#ItemGroupCode').val();
            demandNote.CustodianId = $('#CustodianId').val();
            demandNote.ManagerId = $('#ManagerId').val();

            $('#DNTabletbody tr').each(function () {
                var row = $(this);
                var itemArray = new Object();
                if (row.find('.isChecked').is(":checked") == true) {
                    itemArray.ItemNo = row.find('.ItemNo').val();
                itemArray.Description = row.find('.Description').val();
                itemArray.RequiredDate = row.find('.RequiredDate').val();
                itemArray.RequiredQuantity = row.find('.RequiredQuantity').val();
                itemArray.LastPurPrice = row.find('.LastPurPrice').val();
                itemArray.InfoPrice = row.find('.infoPrice').val();
                itemArray.PrjCode = row.find('.prjCode').val();
                itemArray.PrjName = row.find('.prjName').val();
                itemArray.Whse = row.find('.whse').val();
                itemArray.Uom = row.find('.UomCode').val();
                itemArray.Remarks = row.find('.Remarks').val();
                demandNoteItems.push(itemArray);
                }
                
            });

            demandNote.demandNoteItems = demandNoteItems;

            var model = JSON.stringify(demandNote);
             
         //   $('#submmit').prop('disabled', true); //disble
         
            $('#loader').fadeIn();
            NProgress.start();
            NProgress.set(0.0);
             if ($("#ChangeStatus").val() == "true") {
                 $.ajax({
                     type: 'POST',
                     url: `/api/DemandNote/UpdateDemandNote`,
                     contentType: 'application/json; charset=utf-8',
                     dataType: "json",
                     headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                     data: model,
                     success: function(response) {
                         $('#loader').fadeOut();
                          NProgress.done();
                         console.log(response);
                         if (response.code == 100) {

                             approveMDN();
                             $('#loader').fadeOut()
                         }
                     }

                 });
             }
             else {
                 approveMDN();
                  $('#loader').fadeOut()
             }
            
                   
        }




        $('body').on('change', '.infoPrice', calculteLineTotal);
          $('body').on('change', '.RequiredQuantity', calculteLineTotal);

        function calculteLineTotal(){
              debugger;
              var infoprice=   $(this).parent().parent().find(".infoPrice").val();
              var requiredQty=   $(this).parent().parent().find(".RequiredQuantity").val();
              var lineTotal;
              if (infoprice!="" && requiredQty!="")
              {
                  lineTotal = infoprice * requiredQty;
                   $(this).parent().parent().find(".lineTotal").val(lineTotal);
              }
              else
              {
                    $(this).parent().parent().find(".lineTotal").val(0);
              }
             
          }


      </Script>
  }
