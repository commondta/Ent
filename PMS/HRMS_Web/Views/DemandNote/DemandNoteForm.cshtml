    @section Scripts {

    <script>
        $(document).ready(function () {
            NProgress.start();
            NProgress.set(0.0);
            $("#DNForm").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    Status: {
                        required: true
                    },  
                    RequesterName:{
                        required: true
                    },
                    RequiredDate: {
                        required: true
                    },
                    MDNType: {
                        required: true
                    },
                    Deparment: {
                        required: true
                    },
                    ItemGroupCode: {
                        required: true
                    },
                    "RequiredQuantity[]": {
                        required: true
                    }

                },

                errorPlacement: function (error, element) {

                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    // alert("validation Successfully");
                    PostRequest();
                }

            });
            $("#StageNo").select2();

            GetAllItemGroups();
            GetAllWarehousesData();
            GetAllUomsData();
            GetAllProjectsData();
            GetPreviousRecords();
            NProgress.done();
        });
         function GetAllWhse(rownum,whse){

              
                        $("#whse"+rownum).empty();
                        var row = ' <option value="-1">Select WareHouse</option> ';

                        $("#whse"+rownum).append(row);

                        var relist = WareHouses;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {


                                    var row = ' <option value="' + list.whsCode + '" >'+ list.whsName + '</option> ';

                                    $("#whse"+rownum).append(row);

                                sr++;
                            }
                        }

                        $("#whse"+rownum).select2();
                        if (whse != null && whse != undefined) {
                             $("#whse" + rownum).select2("val", [whse]);
                        }
                     }

                     
        function printInvoice() {
          var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=600,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);

            setTimeout(() => { // Needed for large documents

                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000)
            
        }

        function GetPreviousRecords() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/DemandNote/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        var datatabl = $('#findmodaltable').DataTable();
                        datatabl.destroy();
                        $("#findmodaltbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                        
                            var sr = 1;
                            for (let list of relist) {
                                    var status="";
                        if (list.sapPosting == true) {
                            status = "Approved";
                        }
                        else if(list.dnManagerStatus==false){
                            status = "Rejected";
                        }
                        else{
                            status = "Requested";
                        }
                                var row = '<tr>' +
                                    '<td>' + list.id + '</td>' +
                                    '<td>' + list.deparment + '</td>' +
                                    '<td>' + list.requiredDate + '</td>' +
                                    //'<td>' + list.validUntill + '</td>' +
                                    '<td>' + status + '</td>' +
                                    '<td><a onclick="SelectMDN(' + list.id + ')"><i class="fa fa-eye"></i></a><a style="margin-left:10px" onclick="PrintMDN(' + list.id + ')"><i class="fa fa-print"></i></a></td>' +
                                    '</tr>';
                                $("#findmodaltbody").append(row);
                                sr++;
                            }
                        }

                        $('#findmodaltable').dataTable();
                    }
                }
            });

        }

            function GetAllItemGroups() {

            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllItemGroups`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#ItemGroupCode").empty();
                        var row = ' <option value="-1">Select Item Group</option> ';

                        $("#ItemGroupCode").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {


                                    var row = ' <option data-custordian="'+list.custodianId+'" value="' + list.id + '" >'+ list.name + '</option> ';

                                    $("#ItemGroupCode").append(row);

                                sr++;
                            }
                        }

                        $('#ItemGroupCode').select2();
                    }
                    else{
                         Swal.fire(
                            'Error!',
                            response.message,
                            'error'

                        )
                    }
                }
            });
        }
         $('body').on('change', '#ItemGroupCode', SelectGroupName);
         $('body').on('change', '.ItemNo', SetItemName);
         function SelectGroupName(){
             var select2row = $(this);

            var data_Val = $(this).select2('data');
             var custodianId = data_Val[0].element.attributes['data-custordian'].value;
            var goupname = data_Val[0].text;

             $("#DNTabletbody").empty();
             $("#GroupName").val(goupname);
             $("#CustodianId").val(custodianId);
             GetAllItemsInGroup();
             $("#rownumber").val(0);
         }
         var GroupItems;
         var WareHouses;
         var Uoms;
         var Projects;
           function GetAllWarehousesData(){

              $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllWhse`,
                dataType: "json",
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        WareHouses=   response.data;
                    }
                }
            });
        }
           function GetAllProjectsData(){

              $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllProjects`,
                dataType: "json",
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        Projects=   response.data;
                    }
                }
            });
        }
       function GetAllUomsData(){
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllUoms`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                         Uoms=response.data;
                    }
                }
            });
       }
        function GetAllUoms(rownum,uom){

             

                        $("#UomCode"+rownum).empty();
                        var row = ' <option value="">Select UOM</option> ';

                        $("#UomCode"+rownum).append(row);

                        var relist = Uoms;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {


                                    var row = ' <option value="' + list.uomCode + '" >'+ list.uomName + '</option> ';

                                    $("#UomCode"+rownum).append(row);

                                sr++;
                            }
                        }

                        $("#UomCode"+rownum).select2();
                         if (uom != null && uom != undefined) {
                            $("#UomCode" + rownum).select2("val", [uom]);


                        }
                  
               
        }

         function GetAllItemsInGroup(){
             var groupCode=$("#ItemGroupCode").val();
              $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllItems`,
                dataType: "json",
                 data: { groupcode: groupCode },
                async: false,
                 cache:true,
                contentType: 'application/json',
                success: function (response) {
                  
                    if (response.code === 100) {
                        GroupItems=response.data;
                       
                    }
                    else{
                        GroupItems = null;
                    }
                }
            });
         }
          function GetAllItems(rownum,item){
            var relist=GroupItems;
              
             var row = ' <option value="" >Select Option</option> ';

                                    $("#ItemNo"+rownum).append(row);
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                    var row = ' <option value="' + list.itemCode + '" >'+ list.itemName + '</option> ';

                                    $("#ItemNo"+rownum).append(row);

                                sr++;
                            }
                        }

                        $("#ItemNo"+rownum).select2();
                        if (item != null && item != undefined) {
                            $("#ItemNo" + rownum).select2("val", [item]);
                            $("#ItemNo" + rownum).val(item).trigger("change");

                        }
        
        } 

         function SetItemName() {
              var select2row = $(this);
            var data_Val = $(this).select2('data');
            var itemName = data_Val[0].text;
            var itemCode = data_Val[0].id;

             select2row.parent().parent().find(".Description").val(itemName);
               $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetItemDetails`,
                dataType: "json",
                 data: { itemCode: itemCode },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                           var relist = response.data;

                       select2row.parent().parent().find(".LastPurPrice").val(relist.lastPurPrc);
                       //select2row.parent().parent().find(".infoPrice").val(relist.lastPurPrc);

                     // if( $("#mdnId").val()!=""){
                           select2row.parent().parent().find(".UomCode").val(relist.uomCode).trigger("change");
                       select2row.parent().parent().find(".whse").val(relist.dfltWH).trigger("change");
                      // }
                       
                    }
                }
            });

         }


        function AddRow() {
            var rownumber = parseInt($("#rownumber").val());

            if ($("#ItemGroupCode").val() != "-1" && $("#RequiredDate").val() != "") {
               var requireDate = $("#RequiredDate").val();
                var LineId = rownumber;
            rownumber = rownumber + 1;

                $("#rownumber").val(rownumber);

                var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                    '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                    '<td> <select required id="ItemNo' + rownumber + '" class="form-control ItemNo" style="width:100%" /></td>' +
                    '<td> <input  class="form-control Description" disabled/></td>' +
                    '<td> <input  type="date" value="'+requireDate+'" class="form-control RequiredDate" /></td>' +
                    '<td><input type="number" required name="RequiredQuantity['+rownumber+']" class="form-control RequiredQuantity" /></td>' +
                    '<td><select name="whse['+rownumber+']"  required id="whse' + rownumber + '" class="form-control whse" style="width:100%" /></td>' +
                    //'<td><input type="text" disabled class="form-control UomCode" /></td>' +
                    '<td><select required name="UomCode['+rownumber+']" id="UomCode' + rownumber + '" class="form-control UomCode" style="width:100%" /></td>' +
                    '<td><select required  name="Project['+rownumber+']" id="Project' + rownumber + '" class="form-control prjCode" style="width:100%" /></td>' +
                    '<td class="hide"><input type="text" class="form-control prjName"  /></td>' +
                    '<td><input type="number"  class="form-control infoPrice"  /></td>' +
                    '<td><input type="text" disabled class="form-control LastPurPrice"  /></td>' +
                    '<td><input type="text" disabled class="form-control lineTotal" value="0"  /></td>' +
                    '<td><textarea row="2" type="text" class="form-control Remarks" ></textarea></td>' +
                    '<td style="padding-top:10px"><a class="fa fa-trash-o fa-2x text-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"></a> </td>' +
                    '</tr>';

            $("#DNTabletbody").append(row);
                GetAllItems(rownumber);
                GetAllWhse(rownumber);
                GetAllUoms(rownumber);
                GetAllProjects(rownumber);
            }
            else{
                Swal.fire(
                            'Error!',
                            'Please Select Item Group and Require Date First.',
                            'error'

                        )
            }

        }

       
        function GetAllProjects(rownum,project){


                        $("#Project"+rownum).empty();
                        var row = ' <option value="">Select Project</option> ';

                        $("#Project"+rownum).append(row);

                        var relist = Projects;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {


                                    var row = ' <option value="' + list.prjCode + '" >'+ list.prjName + '</option> ';

                                    $("#Project"+rownum).append(row);

                                sr++;
                            }
                        }

                        $("#Project"+rownum).select2();
                         if (project != null && project != undefined) {
                            $("#Project" + rownum).select2("val", [project]);
                           // $("#ItemNo" + rownum).val(item).trigger("change");

                        }
                    
            
        }
        

       
        function DeleteItemRow(id) {
            $('#L' + id).remove();

            var rownumber = 1;
            $("#DNTabletbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumber").val(rownumber - 1);
        }

        function PostRequest() {

            var demandNote = new Object();

            var demandNoteItems = new Array();

            demandNote.Status = $('#Status').val();
            demandNote.RequesterName = $('#RequesterName').val();
            demandNote.ValidUntill = $('#RequiredDate').val();
            demandNote.RequiredDate = $('#RequiredDate').val();
            demandNote.MDNType = $('#MDNType').val();
            demandNote.Remarks = $('#Remarks').val();
            demandNote.Deparment = $('#Department').val();
            demandNote.ItemGroupCode = $('#ItemGroupCode').val();
            demandNote.CustodianId = $('#CustodianId').val();
            demandNote.ManagerId = $('#ManagerId').val();
            demandNote.CreatedBy = $('#userId').val();
            demandNote.ModifiedBy = $('#userId').val();
            demandNote.LastModifiedUserName = $("#User_Name").val();

            if($("#mdnId").val()!=""){
                 demandNote.Id = $("#mdnId").val();
            }


            $('#DNTabletbody tr').each(function () {
                var row = $(this);
                var itemArray = new Object();

                itemArray.ItemNo = row.find('.ItemNo').val();
                itemArray.Description = row.find('.Description').val();
                itemArray.RequiredDate = row.find('.RequiredDate').val();
                itemArray.RequiredQuantity = row.find('.RequiredQuantity').val();
                itemArray.LastPurPrice = row.find('.LastPurPrice').val();
                itemArray.InfoPrice = row.find('.infoPrice').val();
