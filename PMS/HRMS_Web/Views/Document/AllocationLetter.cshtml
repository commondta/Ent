                            <div class="col-sm-4">
                                <label>Sale Person</label>
                                <input type="text" class="form-control" id="salePerson"
                                        />
                            </div>

                            <div class="col-sm-4">
                                <div class="mt-2" style="max-width: 120px; max-height: 120px;">
                                    <img id="docImagePreview" src="#" alt="Image Preview"
                                         class="img-fluid d-none" />
                                </div>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input"
                                           id="docImageUpload" accept="image/*">
                                    <label class="custom-file-label"
                                           for="docImageUpload">Choose file</label>
                                </div>
                            </div>

                        </div>

                        <!-- Table Section -->
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <table id="proplistPP"
                                       class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white">#</th>
                                            <th class="text-white">Property No.</th>
                                            <th class="text-white">Registration No.</th>
                                            <th class="text-white">Member Name</th>
                                            <th class="text-white">CNIC</th>
                                            <th class="text-white">Relationship With</th>
                                            <th class="text-white">Phase</th>
                                            <th class="text-white">Block</th>
                                            <th class="text-white">Category</th>
                                            <th class="text-white">Property Type</th>
                                            <th class="text-white">Action</th>
