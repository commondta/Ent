@section css {
    <link media="print" rel="stylesheet" href="~/bootstrap/bootstrapcss.css">
    <style>
        .vd_panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #propertyModal {
            margin-left: auto;
        }

        .image-container {
            display: flex;
            flex-wrap: wrap;
            max-width: 250px;
        }

            .image-container img {
                max-width: 100%;
                height: auto;
                margin: 2px;
                box-sizing: border-box;
                flex: 1 1 calc(25% - 4px);
            }

        .cards_style {
            box-shadow: rgba(0, 0, 0, 0.05) 0px 0px 0px 1px;
            border-radius: 10px;
            padding: 2rem;
            margin-bottom: 1rem;
        }

        .img_input {
            position: relative;
            top: 8.5rem
        }
    </style>
}
<!-- Middle Content Start -->

<div class="vd_content-wrapper">
