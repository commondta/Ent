                                            <th class="text-white">Registration No.</th>
                                            <th class="text-white">Member Name</th>
                                            <th class="text-white">CNIC</th>
                                            <th class="text-white">Relationship With</th>
                                            <th class="text-white">Phase</th>
                                            <th class="text-white">Block</th>
                                            <th class="text-white">Category</th>
                                            <th class="text-white">Property Type</th>
                                            <th class="text-white">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="PropertytbodyPP"></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- .vd_content-section -->

        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
