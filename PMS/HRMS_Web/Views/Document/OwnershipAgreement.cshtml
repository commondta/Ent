@section Scripts {
    <script src="~/js/qrcode.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            GetAllPropertyLists();
            GetAllNDCTransferTypes();

        });

        function GetAllNDCTransferTypes() {

            $.ajax({
                type: 'GET',
                url: `/api/TransferType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Transfer").empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#Transfer").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Transfer").append(row);
                                sr++;
                            }
                        }

                        $('#Transfer').select2();
                    }
                }
            });
        }

        function GetAllPropertyLists() {

            $('#proplistPP').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="Print(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function Print(id) {

            var methodType = 'GET';
            var url = "/api/Document/GetOwnershipAgreement?Id=" + id + "";
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {

                    var printdata = response;

                    $(".ppropertyNo").text(printdata.propertyNo);
                    $(".pregistrationNo").text(printdata.registrationNo);

                    var buyerDetails = $("#BuyerNames").val() === "" ? printdata.buyerWithJointMembers : $("#BuyerNames").val();
                    var sellerDetails = $("#SellerNames").val() === "" ? printdata.sellerWithJointMembers : $("#SellerNames").val();

                    //var detailsstring = "";
                   // $(".pmemberNameAndDetails").text($("#BuyerNames").val());

                    // var count = printdata.memberNames.length;
                    // $.each(printdata.memberNames, function (i, item) {
                    //     var comma = count - 1 == i ? "" : ",";
                    //     detailsstring += item.memeberName + " " + item.cnic + " " + item.relationName + " " + item.relationhipwith + " " + comma + " ";
                    // });

                    // if (count < 3) {
                         $(".pmemberNameAndDetails").empty();
                         $('.messcountmembersdiv').hide();
                         $('.lesscountmembersdiv').show();
                         $('.lesscountmembersdiv').find('.pmemberNameAndDetails').text(buyerDetails);
                    // } else {
                    //     $(".pmemberNameAndDetails").empty();
                    //     $('.lesscountmembersdiv').hide();
                    //     $('.messcountmembersdiv').show();
                    //     $('.messcountmembersdiv').find('.pmemberNameAndDetails').text(detailsstring);
                    // }


                    $(".ppermanentAddress").text(printdata.permanentAddress);
                    $(".pblock").text(printdata.block);
                    $(".pbuyerPhone").text(printdata.buyerPhone);
                    $(".pmembershipNo").text(printdata.membershipNo);
                    $(".ptype").text(printdata.type);
                    $(".parea").text(printdata.area + " " + printdata.unitArea);
                    //$("#psqft").text(Math.round(printdata.area * 225));
                    $(".psqryard").text(printdata.area);
                    $(".pcategory").text(printdata.category);
                    $(".pcnic").text(printdata.buyerCnic);
                    $(".pllot").text(printdata.nature);
                    $(".InternalNo").text(printdata.internalNo);
                    $(".psector").text(printdata.sectorName);
                    $(".pphase").text(printdata.phase);
                    $(".ptitle").text(printdata.title);
                    $(".pPlotNo").text(printdata.plotNo);
                    $(".pSignatoryRank").text(printdata.signatoryRank);
                    $(".pSignatoryDesignation").text(printdata.signatoryDesignation);
                    $(".pSignatoryName").text(printdata.signatoryName);
                    $(".pbuyerDetail").text(sellerDetails);

                    $("#SellerNames").val(sellerDetails);
                    $("#BuyerNames").val(buyerDetails);
                                                        
                    printdata.letterDate = $("#DocDate").val();
                    var date = new Date(printdata.letterDate);
                    var options = { day: 'numeric', month: 'short', year: 'numeric' };
                    $(".pppdate").text(date.toLocaleDateString('en-GB', options));

                    $(".qrcode").empty();
                    $(".imgContainerForPrint").empty();

                    var Adress = printdata.permanentAddress;
                    var Name = printdata.buyerName;
                    var RegistrationNo = printdata.propertyNo;
                    let udno = printdata.block;

                    var qrcodeContent = "BWP" + "/" + RegistrationNo + "/" + udno;
                    $(".RefNum").text(qrcodeContent);

                    $(".qrcode").each(function () {
                        $(this).empty();
                        new QRCode(this, {
                            text: qrcodeContent,
                            width: 90,
                            height: 90
                        });
                    });

                    $(".imgContainerForPrint").empty();

                    var selectedFile = $('#docImageUpload')[0].files[0];

                    if (selectedFile) {
                        // ✅ PRIORITY 1: Use uploaded image
                        var reader = new FileReader();

                        reader.onload = function (e) {
                            var row = '<img style="width:100%;height:100%;margin:0px;" src="' + e.target.result + '" />';
                            $(".imgContainerForPrint").append(row);
                        };

                        reader.readAsDataURL(selectedFile);
                    }
                    else if (printdata.imageUrl && printdata.imageUrl !== "") {
                        // ✅ PRIORITY 2: Use backend image
                        var row = '<img style="width:100%;height:100%;margin:0px;" src="' + printdata.imageUrl + '" />';
                        $(".imgContainerForPrint").append(row);
                    }


                    $(".ptext").text("purchased");
                    $(".pPropertyNo").text(printdata.propertyNo);
                    $(".swapOverStatement").text($("#ChangeOverStatement").val());

                    printdata.transferType = $("#Transfer").val();
                    printdata.legalHeireType = $("#LegalHeirType").val();
                    printdata.lagalHeireContent = $("#LegalHeirContent").val();

                    if (printdata.transferType == 'Hiba Transfer') {
                        $(".ptext").text("been gifted");
                    }

                    var actionText = (printdata.transferType === 'Hiba Transfer') ? "been gifted" : "purchased";
                    var propNo = (printdata.propertyNo === "") ? printdata.propertyNo : printdata.plotNo

                    var statement = `The Management of N-Stack is pleased to inform that you have <b>${actionText}</b> a <b>${printdata.type}</b> <b>${printdata.nature}</b> <b>${printdata.category}</b> (<b>${printdata.area}</b> Square Yards) in phase <b>${printdata.phase}</b>, <b>${propNo}</b>, Sector-<b>${printdata.sectorName}</b>, N-Stack from <b><u>${printdata.buyerDetail}</u></b>. ${printdata.swapOverStatement || ""}`;

                    $("#Statement").text($("#Statement").val() === "" ?
                        ((printdata.statement && printdata.statement.trim() !== "")
                            ? printdata.statement
                            : statement) : $("#Statement").val()
                    );

                    var finalStatement = $("#Statement").text();

                    $(".pStatement").html(finalStatement);

                    if (printdata.legalHeireType === "50 Percent Share Hiba") {
                        $("#content1").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetter50percentshareHiba");
                    }
                    else if (printdata.legalHeireType === "Through Court Case") {
                        $("#content2").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetterthroughCourtCase");
                    }
                    else if (printdata.legalHeireType === "Through Court Representative") {
                        $("#content3").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetterthroughCourtRepresentative");
                    }
                    else if (printdata.legalHeireType === "Through Nadra") {
                        $("#content4").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetterthroughNadra");
                    }
                    else if (printdata.nature === "Villa") {
                        printInvoice("printdivtransferLetterVilla");
                    } else if (printdata.constructionStatus.trim() === "Constructed") {
                        printInvoice("printdivtransferLetterConstructedHouse");
                    } else if (printdata.propertyNo.trim() !== "" && printdata.unitArea && printdata.category.includes("Kanal")) {
                        printInvoice("printdivtransferLetterWithPlotNo");
                    } else if (printdata.propertyNo === "" && printdata.unitArea && printdata.category.includes("Kanal")) {
                        printInvoice("printdivtransferLetterWithoutPlotNo");
                    } else if (printdata.propertyNo.trim() !== "") {
                        printInvoice("printdivtransferLetterWithPlotNoBelowKanal");
                    } else if (printdata.propertyNo === "") {
                        printInvoice("printdivtransferLetterWithoutPlotNoBelowKanal");
                    }
                    printInvoice();
                }, error: function (xhr) {
                    // ✅ Handle backend NotFound (404) or any other error
                    if (xhr.status === 404) {
                        alert(xhr.responseText || "No record found. Please wait for letter print approval.");
                    } else if (xhr.status === 401) {
                        alert("Unauthorized access. Please log in again.");
                        // optional: redirect to login
                        // window.location.href = "/login";
                    } else {
                        alert("An error occurred while fetching print data. Please try again later.");
                    }
                }
            });
        }

        function CompletedTransferPrint(id) {

            var methodType = 'GET';
            var url = "/api/TransferHistery/GetOwnershipAgreement?Id=" + id + "";
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {

                    var printdata = response;
                    $("#printNoOfDays").text();
                    $("#printReferenceNo").text(printdata.registrationNo);
                    $("#printplotNo").text(printdata.propertyNo);
                    $("#printName").text(printdata.buyerName);
                    $("#printCNICNo").text(printdata.buyerCnic);
                    $("#printSec").text(printdata.sectorName);
                    $("#printDate").text(printdata.docDate.split("T")[0]);

                    printCompletedTransfersInvoice();
                }
            });
        }

        function printCompletedTransfersInvoice() {
            var printContents = document.getElementById('printdivForTransferCompletionCertificate').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdivForTransferCompletionCertificate');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }


        function printInvoice(transferType) {
            var printContents = document.getElementById(transferType).innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById(transferType);
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

        $('#docImageUpload').on('change', function (e) {
            const file = e.target.files[0];

            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    $('#docImagePreview')
                        .attr('src', e.target.result)
                        .removeClass('d-none');
                };

                reader.readAsDataURL(file);
                $('.custom-file-label').text(file.name);
            } else {
                $('#docImagePreview').addClass('d-none').attr('src', '#');
                $('.custom-file-label').text('Choose file');
            }
        });
    </script>
}
