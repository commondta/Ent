            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">

                        <!-- First Row -->
                        <div class="row">
                            <div class="col-md-4">
                                <label>Legal Heire Type</label>
                                <select class="js-example-basic-single" name="LegalHeirType" id="LegalHeirType">
