@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberName: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetPreviousRecords();
            $('#SubmitMR').prop('disabled', false);
        });

        function GetInvoicesAgainstRegistrationNo() {
            debugger;
            var registrationNo = $("#RegistrationNo").val();
            // var registrationNo = "F-0455";
            var url = "/api/SapIntegration/GetAllInvoicesAgainstRegistration"
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                data: { registrationNo: registrationNo },
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#invoicemodal").modal("show");
                        var datatabl = $('#invoicelist').DataTable();
                        datatabl.destroy();
                        $("#invoicetbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.docEntry + '</td> ' +
                                    ' <td>' + list.docNum + '</td> ' +
                                    ' <td>' + list.cardName + '</td> ' +
                                    ' <td>' + list.docDate + '</td> ' +
                                    ' <td>' + list.docTotal + '</td> ' +
                                    '<td><a onclick="SelectSingleInvoice(' + list.docEntry + ')" class="btn btn-primary btn-sm">Select</a></td>' +
                                    '</tr>';
                                $("#invoicetbody").append(row);
                                sr++;
                            }
                            $('#invoicelist').dataTable();
                        }

                    }
                    else if (response.code == 2) {
                        Swal.fire(response.message, '', 'info')
                    }
                }
            });
        }
        function SelectSingleInvoice(DocEntry) {
            $("#invoiceNo").val(DocEntry);
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetSingleInvoiceDetails`,
                data: { DocEntry: DocEntry },
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#Chargestbody").empty();
                        $("#invoicemodal").modal("hide");
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = '<tr>' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td class="lineNum hide">' + list.lineNum + '</td> ' +
                                    ' <td class="acctName">' + list.acctName + '</td> ' +
                                    ' <td class="price" style="text-align: right;">' + formatPKR(list.price) + '</td> ' +
                                    ' <td class="creditMemo">' + list.creditMemo + '</td> ' +
                                    ' <td><input type="number" class="adjustment form-control" value="0" /></td> ' +
                                    ' <td class="hide"><input class="nettotal form-control" readonly value="' + list.price + '" /></td> ' +
                                    ' <td class="acctCode hide" >' + list.acctCode + '</td> ' +
                                    ' </tr>';
                                $("#Chargestbody").append(row);
                                sr++;
                            }
                        }
                    }
                }
            });
        }
        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetAllInvoicesProjects`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requesttbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.member + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registration + '</td>           ' +
                                    ' <td class="propertyNo">' + list.property + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick=SelectSinglePPS("' + list.registration + '","' + list.property + '")></a>' +
                                    '<a class="fa fa-trash-o fa-2x text-danger hide" onclick="DeleteSingleChargeSetup(' + list.property + ')"></a></td> </tr>';
                                //</tr>';
                                $("#requesttbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestlist').dataTable();
                    }
                }
            });

        }
        $('body').on('keydown', '.adjustment', calculteLineTotal);
        function calculteLineTotal() {

            var adjus = $(this).val() == "" ? 0 : parseFloat($(this).val());
            var price = $(this).closest("tr").find(".price").text() == "" ? 0 : parseFloat($(this).closest("tr").find(".price").text());
            //$(this).closest("tr").find(".nettotal").val(price + adjus)

        }


        function SelectSinglePPS(registrationNo, propertyNo) {

            $("#requestmodal").modal("hide");
            $("#RegistrationNo").val(registrationNo);
            $("#PropertyNo").val(propertyNo);
            SelectRegistration(registrationNo);
        }

        function SelectRegistration(id) {

            var url = "/api/GenralAdjustment/GetFilterPropertyByRegistraionNo?reg=" + id + "";


            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberName);
                        $("#ConstrucationStatus").val(result_User.constructionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);
                        $("#TypeName").val(result_User.typeName);
                        $("#CNIC").val(result_User.cnic);
                        var cnicExpDate = result_User.cnicExpiryDate.split("T");
                        cnicExpDate = cnicExpDate[0].split("-");
                        cnicExpDate = cnicExpDate[2] + "-" + cnicExpDate[1] + "-" + cnicExpDate[0];
                        $("#CNICExp").val(cnicExpDate);

                        $("#StockCreationId").val(result_User.id);
                        $("#MemberProfileId").val(result_User.memberProfileId);

                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                    }
                }
            });
        }

        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/GenralAdjustment/SaveGenralAdjustment";

            var file = new Object();
            var genralAdjustmentChargesArray = new Array();
            debugger;
            file.InvoiceNo = $('#invoiceNo').val();
            file.DocumentDate = $('#DocumentDate').val();
            file.StockCreationId = parseInt($('#StockCreationId').val());
            file.MemberProfileId = parseInt($('#MemberProfileId').val());
            file.ConstrucationStatus = $("#ConstrucationStatus").val();
            file.PossessionStatus = $("#PossessionStatus").val();
            file.RegistrationNo = $("#RegistrationNo").val();
            file.Size = $("#Size").val();
            file.Category = $("#Category").val();
            file.Block = $("#Block").val();
            file.Remarks = $("#Remarks").val();
            file.CreatedBy = $("#User_Id").val();
            file.ModifiedBy = $("#User_Id").val();
            file.LastModifiedUserName = $("#User_Name").val();

            $('#Chargestbody tr').each(function () {
                debugger;
                var row = $(this);
                var charge = new Object();
                charge.LineNum = row.find('.lineNum').text();
                charge.ChargeName = row.find('.acctName').text();
                // charge.Amount = parseFloat(row.find('.price').text());
                charge.Amount = parseFloat(row.find('.price').val().replace(/,/g, ''));
                charge.Adjustment = parseFloat(row.find('.adjustment').val());
                charge.NetAmount = parseFloat(row.find('.nettotal').val());
                charge.SapAccount = row.find('.acctCode').text();

                genralAdjustmentChargesArray.push(charge);
            });

            file.GenralAdjustmentCharges = genralAdjustmentChargesArray;

            var model = JSON.stringify(file);
            $('#SubmitMR').prop('disabled', true); //disble
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    NProgress.done();
                    $('#loader').fadeOut();
                    if (response.code === 100) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            $('#SubmitMR').prop('disabled', true);
                            printInvoice();
                        })
                    }
                    else {
                        $('#SubmitMR').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
        }
        function numberToWords(number) {
            var digit = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
            var elevenSeries = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
            var countingByTens = ['twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
            var shortScale = ['', 'thousand', 'million', 'billion', 'trillion'];

            number = number.toString(); number = number.replace(/[\, ]/g, ''); if (number != parseFloat(number)) return 'not a number'; var x = number.indexOf('.'); if (x == -1) x = number.length; if (x > 15) return 'too big'; var n = number.split(''); var str = ''; var sk = 0; for (var i = 0; i < x; i++) { if ((x - i) % 3 == 2) { if (n[i] == '1') { str += elevenSeries[Number(n[i + 1])] + ' '; i++; sk = 1; } else if (n[i] != 0) { str += countingByTens[n[i] - 2] + ' '; sk = 1; } } else if (n[i] != 0) { str += digit[n[i]] + ' '; if ((x - i) % 3 == 0) str += 'hundred '; sk = 1; } if ((x - i) % 3 == 1) { if (sk) str += shortScale[(x - i - 1) / 3] + ' '; sk = 0; } } if (x != number.length) { var y = number.length; str += 'point '; for (var i = x + 1; i < y; i++) str += digit[n[i]] + ' '; } str = str.replace(/\number+/g, ' '); return str.trim() + " Only.";
        }

        function printInvoice() {
            
            // $(".id").text(result_User.id);
            $(".registrationNo").text($("#RegistrationNo").val());
            $(".buyerName").text($("#MembName").val());
            $(".blockName").text($("#PropertyNo").val() + " / " + $("#Block").val());
            $(".plotType").text($("#TypeName").val());
            $(".plotSize").text($("#Category").val());
            $(".CollectionOfficer").text("@Context.Session.GetString("FullName")");
            var genralAdjustmentChargesArray = new Array();
            $(".tbodyinvoice").empty();
            $('#Chargestbody tr').each(function () {
              
                var row = $(this);
                var charge = new Object();
                charge.LineNum = row.find('.lineNum').text();
                charge.ChargeName = row.find('.acctName').text();
                // charge.Amount = parseFloat(row.find('.price').text());
                charge.Amount = parseFloat(row.find('.price').val().replace(/,/g, ''));
                charge.Adjustment = parseFloat(row.find('.adjustment').val());
                charge.NetAmount = parseFloat(row.find('.nettotal').val());
                charge.SapAccount = row.find('.acctCode').text();

                genralAdjustmentChargesArray.push(charge);
            });

            console.log(genralAdjustmentChargesArray);
            var amounttotal = 0;
            $.each(genralAdjustmentChargesArray, function (i, item) {

                var rownumber = 1 + i;

                var row = '<tr style="font-size: 11px" id="' + rownumber + '" DetailId="0"> ' +
                    '<td style="text-align:center">' + rownumber + '</td>' +
                    '<td style="padding-left:8px">' + item.ChargeName + '</td>' +
                    '<td style="text-align:right;padding-right:4px">' + formatPKR(item.NetAmount - item.Adjustment) + '</td>' +
                    '</tr>';

                amounttotal = amounttotal + parseInt(item.NetAmount - item.Adjustment);
                rownumber++;
                $(".tbodyinvoice").append(row);
                rownumber++;
            });
            $(".invoicetotal").text(formatPKR(amounttotal));
            var amountinwords = numberToWords(amounttotal);
            $(".amountinwords").text(amountinwords);

            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }
    </script>
