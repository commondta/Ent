@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";

            const textarea = document.getElementById("Remarks");
            const charCount = document.getElementById("charCount");

            textarea.addEventListener("input", function () {
                const remaining = 100 - this.value.length;
                charCount.textContent = `${remaining} characters remaining`;
            });

            $('#PaymentMode').on('change', function () {
                var paymentMode = $(this).val();

                if (paymentMode === 'DD') {
                    $('#ddField').removeClass('hide');
                } else {
                    $('#BankAccountDD').val('');   
                    $('#ddField').addClass('hide');
                }
            });

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberName: {

                        required: true
                    },

                },

                errorPlacement: function (error, element) {
                    
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest(true);
                }
            });
            GetAllPropertyLists();
            $('#SubmitMR').prop('disabled', false);
        });


        function numberToWords(number) {
            var digit = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
            var elevenSeries = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
            var countingByTens = ['twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
            var shortScale = ['', 'thousand', 'million', 'billion', 'trillion'];

            number = number.toString(); number = number.replace(/[\, ]/g, ''); if (number != parseFloat(number)) return 'not a number'; var x = number.indexOf('.'); if (x == -1) x = number.length; if (x > 15) return 'too big'; var n = number.split(''); var str = ''; var sk = 0; for (var i = 0; i < x; i++) { if ((x - i) % 3 == 2) { if (n[i] == '1') { str += elevenSeries[Number(n[i + 1])] + ' '; i++; sk = 1; } else if (n[i] != 0) { str += countingByTens[n[i] - 2] + ' '; sk = 1; } } else if (n[i] != 0) { str += digit[n[i]] + ' '; if ((x - i) % 3 == 0) str += 'hundred '; sk = 1; } if ((x - i) % 3 == 1) { if (sk) str += shortScale[(x - i - 1) / 3] + ' '; sk = 0; } } if (x != number.length) { var y = number.length; str += 'point '; for (var i = x + 1; i < y; i++) str += digit[n[i]] + ' '; } str = str.replace(/\number+/g, ' '); return str.trim() + " Only.";
        }

        function printInvoice() {

            
            $(".challanNo").text($("#challanNumber").val());
            if ($("#showOwnerDetails").is(":checked")) {
                $(".owner-details").show();
            } else {
                $(".owner-details").hide();
            }

            $(".remarks").text($("#Remarks").val());
            $(".registrationNo").text($("#RegistrationNo").val());
            $(".paymentMode").text($("#PaymentMode").val());

            var bankDD = $("#BankAccountDD").val();

            if (bankDD && bankDD.trim() !== "") {
                $(".dd").text(bankDD);
                $(".bank-dd").removeClass("hide");
            } else {
                $(".bank-dd").addClass("hide");
            }

            $(".dueDate").text($("#DueDate").val().split("-").reverse().join("-"));
            $(".docDate").text($("#DocumentDate").val().split("-").reverse().join("-"));
          
            $(".buyerName").text(
                $("#nameRecipt").val().trim() ? $("#nameRecipt").val() : $("#MembName").val()
            );
            $(".blockName").text($("#PropertyNo").val() + " / " + $("#Block").val());
            $(".plotType").text($("#TypeName").val());
            $(".plotSize").text($("#Category").val());
            $(".CollectionOfficer").text("@Context.Session.GetString("FullName")");
            var standAloneChargesArray = new Array();
            $(".tbodyinvoice").empty();
            $('#Chargestbody tr').each(function () {

                var row = $(this);
                var charge = new Object();
                charge.ChargeName = row.find('.FeeType').val();
                charge.Amount = row.find('.Amount').val();
                charge.Remarks = row.find('.Remarks').val();
                charge.SapAccount = row.find('.sapAccount').val();

                standAloneChargesArray.push(charge);
            });

            var amounttotal = 0;
            $.each(standAloneChargesArray, function (i, item) {

                var rownumber = 1 + i;

                var row = '<tr style="font-size: 11px" id="' + rownumber + '" DetailId="0"> ' +
                    '<td style="text-align:center">' + rownumber + '</td>' +
                    '<td style="padding-left:0px">' + item.ChargeName + '</td>' +
                    '<td style="text-align:right;padding-right:0px">' + formatPKR(item.Amount) + '</td>' +
                    '</tr>';



                amounttotal = amounttotal + parseInt(item.Amount);
                rownumber++;
                $(".tbodyinvoice").append(row);
                rownumber++;
            });
            $(".invoicetotal").text(formatPKR(amounttotal));
            var amountinwords = numberToWords(amounttotal);
            $(".amountinwords").text(amountinwords);

            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

        $("#btnFindMode").click(function () {
            $("#findStandaloneModal").modal("show");
            loadStandaloneInvoices();
        });

        function loadStandaloneInvoices() {

            if ($.fn.DataTable.isDataTable('#standaloneTable')) {
                $('#standaloneTable').DataTable().destroy();
            }

            $('#standaloneTable').DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                searching: true,
                ordering: false,

                ajax: {
                    url: "/api/GenralAdjustment/GetAllStandaloneInvoices",
                    type: "GET",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search.value
                        };
                    }
                },

                columns: [
                    {
                        data: null,
                        render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1
                    },
                    { data: "challanNo" },
                    { data: "type" },
                    { data: "memberName" },
                    { data: "referenceNo" },
                    { data: "propertyNo" },
                    { data: "documentDate" },
                    { data: "dueDate" },
                    {
                        data: "totalAmount",
                        className: "text-right"
                    },
                    { data: "remarks" },
                    { data: "status" },
                    {
                        data: null,
                        orderable: false,
                        render: function (data) {

                            let viewBtn = `
                    <a class="btn btn-sm btn-primary"
                       onclick="viewStandalone(${data.id})">
                        <i class="fa fa-eye"></i>
                    </a>
                `;

                            let cancelBtn = '';

                            if (canDeleteStandaloneInvoice && data.status === "Active") {
                                cancelBtn = `
                        <a class="btn btn-sm btn-danger ml-1"
                           title="Cancel"
                           onclick="CancelRequest('${data.challanNo}')">
                            <i class="fa fa-times"></i>
                        </a>
                    `;
                            }

                            return viewBtn + cancelBtn;
                        }
                    }
                ]
            });
        }


        function viewStandalone(id) {

            $.ajax({
                url: "/api/GenralAdjustment/GetStandaloneById?id=" + id,
                type: "GET",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (res) {

                    if (res.code === 100) {

                        const d = res.data;
                        $("#findStandaloneModal").modal("hide");

                        $("#MemberNDC :input").prop("disabled", true);
                        $("#findStandaloneModal").prop("disabled", true);
                        $("#AddRowProcessingChargesbtn").prop("disabled", true);
                        $("#btnPrintVoucher").prop("disabled", false);

                        // ---------- HEADER ----------
                        $("#DocumentDate").val(d.documentDate);
                        $("#DueDate").val(d.dueDate);
                        $("#PaymentMode").val(d.paymentMode).trigger("change");
                        $("#BankAccountDD").val(d.bankAccountDD);
                        $("#Remarks").val(d.remarks);
                        $("#nameRecipt").val(d.nameRecipt);
                       
                        $("#Type").val(d.type);
                        $("#showOwnerDetails").prop("checked", d.showOwnerDetails);

                        $("#RegistrationNo").val(d.registrationNo || "");
                        $("#PropertyNo").val(d.propertyNo || "");
                        $("#MembName").val(d.memberName || "");
                        $("#CNIC").val(d.cnic || "");
                        $("#MembCode").val(d.memberProfileId || "");
                        $("#Block").val(d.block || "");
                        $("#Category").val(d.category || "");
                        $("#Size").val(d.size || "");
                        $("#ConstrucationStatus").val(d.construcationStatus || "");
                        $("#PossessionStatus").val(d.possessionStatus || "");
                        $("#TypeName").val(d.typeName || "");

                        $("#StockCreationId").val(d.stockCreationId);
                        $("#MemberProfileId").val(d.memberProfileId);
                        $("#challanNumber").val(d.challanNo);

                        // ---------- CHARGES ----------
                        $("#Chargestbody").empty();
                        $("#rownumberPR").val(0);

                        if (d.charges && d.charges.length > 0) {

                            d.charges.forEach((c, i) => {
                                AddRowProcessingCharges();
                                let r = i + 1;

                                $(`#FeeType_${r}`)
                                    .val(c.chargeName)
                                    .trigger('change')
                                    .prop('disabled', true);  

                                $(`#sapAccount_${r}`)
                                    .val(c.sapAccount || "")
                                    .prop('readonly', true);

                                $(`#PR${r} .Amount`)
                                    .val(c.amount)
                                    .prop('readonly', true);

                                $(`#PR${r} .Remarks`)
                                    .val(c.remarks || "")
                                    .prop('readonly', true);

                                $(`#PR${r} .btn-delete`)
                                    .addClass("disabled")
                                    .css("pointer-events", "none")
                                    .removeAttr("onclick");

                                if (d.dueDate) {
                                    $(`#PR${r} .DueDate`)
                                        .val(d.dueDate)
                                        .prop('readonly', true);
                                }
                            });
                        }

                        enablePrintVoucherMode();
                    }
                }
            });
        }


        function enablePrintVoucherMode() {

            $("#SubmitMR").hide();
            $("#SubmitPrint").hide();
            $(".vd_btn:contains('Cancel')").hide();

            if ($("#btnPrintVoucher").length === 0) {
                $(".col-md-6.text-right").append(`
                    <a id="btnPrintVoucher"
                            class="btn btn-success ml-2">
                        <i class="fa fa-print"></i> Print Voucher
                    </a>
                `);
            }
        }

        $(document).on("click", "#btnPrintVoucher", function () {
            printInvoice(); 
        });

        function CancelRequest(challan) {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            });

            swalWithBootstrapButtons.fire({
                target: '#findStandaloneModal',
                title: 'Cancel Request',
                text: 'Please enter cancel remarks',
                icon: 'warning',
                input: 'textarea',
                inputPlaceholder: 'Enter cancel remarks...',
                inputAttributes: {
                    rows: 4
                },
                showCancelButton: true,
                confirmButtonText: 'Yes, Cancel it!',
                cancelButtonText: 'No',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false,

                didOpen: () => {
                    document.querySelector('.swal2-textarea').focus();
                },

                inputValidator: (value) => {
                    if (!value) {
                        return 'Cancel remarks is required!';
                    }
                }

            }).then((result) => {
                if (result.isConfirmed) {
                    CancellInvoices(challan, result.value);
                }
            });
        }

        function CancellInvoices(challanNo, remarks) {

            NProgress.start();
            $('#loader').fadeIn();

            $.ajax({
                url: "/api/GenralAdjustment/CancellByChallanNo",
                type: "GET",
                data: {
                    challanNo: challanNo,
                    remarks: remarks
                },
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",

                success: function (response) {

                    NProgress.done();
                    $('#loader').fadeOut();

                    if (response.code === 100) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message
                        });

                    } else {

                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message
                        });
                    }
                }
            });
        }


