        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResultForNDCById?stockId=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        debugger;

                        $("#registrationModal").modal("hide");
                        var result_User = response.data;
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberName);
                        $("#ConstrucationStatus").val(result_User.constructionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);
                        $("#TypeName").val(result_User.typeName);
                        $("#CNIC").val(result_User.cnic);
                        var cnicExpDate = result_User.cnicExpiryDate.split("T");
                        cnicExpDate = cnicExpDate[0].split("-");
                        cnicExpDate = cnicExpDate[2] + "-" + cnicExpDate[1] + "-" + cnicExpDate[0];
                        $("#CNICExp").val(cnicExpDate);

                        $("#StockCreationId").val(result_User.id);
                        $("#MemberProfileId").val(result_User.memberProfileId);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);



                    }
                }
            });
        }

        function AddRowProcessingCharges() {

            var rownumber1 = parseInt($("#rownumberPR").val());
            var LineId = rownumber1;
            rownumber1 = rownumber1 + 1;
            $("#rownumberPR").val(rownumber1);

            var row = '<tr id="PR' + rownumber1 + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber1 + '"/></td>' +
                '<td> <select required name="Validate[' + rownumber1 + '].FeeType" name="FeeType" class="form-control FeeType" style="width:100%" id="FeeType_' + rownumber1 + '"></select><input id="sapAccount_' + rownumber1 + '" class="sapAccount hide" /></td>' +
                '<td> <input type="number" required name="Validate[' + rownumber1 + '].Amount" min="0" name="Amount"  class="form-control Amount" value="0" /></td>' +
                '<td> <input type="date" required name="Validate[' + rownumber1 + '].DueDate"  class="form-control DueDate" value="@lastDayOfMonth" /></td>' +
                '<td> <textarea  class="form-control Remarks" ></textarea></td>' +
                '<td class="hide"> <input  class="form-control sapAccount" disabled  id="sapAccount__' + rownumber1 + '" /></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger btn-delete" onclick="return DeletePRItemRow(\'' + rownumber1 + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#Chargestbody").append(row);

            ChargeGroupType(rownumber1)
        }

        function ChargeGroupType(rowno, chargetype) {

            let type = 'GET';
            let url = "/api/ChargeGroupType/GetAllChargeGroupType";

            $.ajax({
                type: type,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 0) {

                        $("#FeeType_" + rowno).empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#FeeType_" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option data-sapAccount="' + list.sapAccount + '" value="' + list.chargeTypeName + '" >' + list.chargeTypeName + '</option> ';

                                $("#FeeType_" + rowno).append(row);

                                sr++;
                            }
                            $('#FeeType_' + rowno).select2();
                        }
                        if (chargetype != null && chargetype != undefined) {
                            $('#FeeType_' + rowno).select2("val", [chargetype])
                        }

                    }
                }
            });
        }

        $('body').on('select2:select', '.FeeType', SetSapAccount);
        function SetSapAccount() {
            var rowarr = $(this).attr('id').split("_");
            var rownumber = rowarr[1];

            var select2row = $(this);
            var data_Val = $(this).select2('data');
            var sapAccount = data_Val[0].element.attributes['data-sapAccount'].value;

            $("#sapAccount_" + rownumber).val(sapAccount)
        }

        function DeletePRItemRow(id) {
            $('#PR' + id).remove();
            var rownumber1 = 1;
            $("#Chargestbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber1));
                rownumber1++;
            });
            $("#rownumberPR").val(rownumber1 - 1);
        }

        function PostRequest(isChallan) {

            var url2 = isChallan ? "/api/Filter/GetNextChallanNumberAsync" : "/api/Filter/GetNextChallanNumberAsyncPrintOnly";
            $.ajax({
                type: 'GET',
                url: url2,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $(".challanNo").text(response.data);
                        $("#challanNumber").val(response.data);

                    }
                }
            });
 
            var methodType = 'POST';
            var url = "/api/GenralAdjustment/SaveStandAlone";

            var file = new Object();
            var standAloneChargesArray = new Array();

            file.StockCreationId = parseInt($('#StockCreationId').val());
            file.MemberProfileId = parseInt($('#MemberProfileId').val());
            file.ConstrucationStatus = $("#ConstrucationStatus").val();
            file.PossessionStatus = $("#PossessionStatus").val();
            file.RegistrationNo = $("#RegistrationNo").val();
            file.Size = $("#Size").val();
            file.Category = $("#Category").val();
            file.ChallanNo = $("#challanNumber").val();
            file.Block = $("#Block").val();
            file.DocumentDate = $("#DocumentDate").val();
            file.DueDate = $("#DueDate").val();
            file.Type = isChallan ? "Challan" : "Print";
            file.Remarks = $("#Remarks").val();
            file.PaymentMode = $("#PaymentMode").val();
            file.NameRecipt = $("#nameRecipt").val();
            file.BankAccountDD = $("#BankAccountDD").val();
            file.ShowOwnerDetails = $("#showOwnerDetails").is(":checked");
            file.CreatedBy = $("#User_Id").val();
            file.ModifiedBy = $("#User_Id").val();
            file.LastModifiedUserName = $("#User_Name").val();

            $('#Chargestbody tr').each(function () {

                var row = $(this);
                var charge = new Object();
                charge.ChargeName = row.find('.FeeType').val();
                charge.Amount = row.find('.Amount').val();
                charge.DueDate = row.find('.DueDate').val();
                charge.Remarks = row.find('.Remarks').val();
                charge.SapAccount = row.find('.sapAccount').val();

                standAloneChargesArray.push(charge);
            });

            file.StandAloneCharges = standAloneChargesArray;

            var model = JSON.stringify(file);
            NProgress.start();
            NProgress.set(0.0);
            $('#SubmitMR').prop('disabled', true); 
            $('#loader').fadeIn();

            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    NProgress.done();
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                                $('#SubmitMR').prop('disabled', true);
                                $('#SubmitPrint').prop('disabled', true);

                                printInvoice();
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $('#SubmitMR').prop('disabled', false);
                        $('#SubmitPrint').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message
                        })
                    }
                }
            });
        }
    </script>
