<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
<!-- /.modal -->

<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="modaltitle">Add Charges Group</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body">
                <form id="ChargesGroup" class="form-horizontal">

                    <div class="container">
                        <div class="row">
                            <div class="col-sm-12 hide">
                                <label>Code</label>
                                <input id="ID" class="form-control" disabled />
                                @* <input  id="ID" class="form-control hide" />*@
                            </div>
                            <div>
                                <label>Form Name</label>
                                <div>
                                    <select class="js-example-basic-single" name="formName" id="formName" style="width:70%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12" style="margin-top: 8px;">
                                <label>Group Name</label>
                                <div>
                                    <select class="js-example-basic-multiple" name="chargeGroups" id="chargeGroups" style="width:70%" multiple="multiple">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12" style="margin-top: 8px;">
                                @* <label>Remarks</label>*@
                                <textarea type="text" class="form-control hide"
                                          placeholder=" " id="Remarks"></textarea>
                            </div>
                        </div>
                    </div>

                </form>

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                <button onclick="SaveFormChargesGroup()" id="SubmitButton" type="button" class="btn btn-primary btn-theme">Save</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Confirmation</h4>
                <a class="close" data-dismiss="modal">&times;</a>

            </div>
            <div class="modal-body">
                <p>Are You sure you want to permanently delete?</p>
                <input class="hide" id="DeleteID" />

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button onclick="DeleteFormChargesGroup()" type="button" class="btn btn-primary ">Yes</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

@section Scripts {

        <script type="text/javascript">
            $(document).ready(function () {
                "use strict";
            GetAllFormChargesGroup();
            GetFormName();
            });
            function EditFormChargesGroup() {

                const FormCharge = {
                    Id: $("#ID").val(),
                    FormId: $("#formName").val(),
                    ChargeGroupId: $("#chargeGroups").val()
                }

                $.ajax({
                    type: 'Put',
                    url: `/api/Forms/UpdateForms`,
                    dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    data: JSON.stringify(FormCharge),
                    async: false,
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.code === 100) {
                        
                        $("#myModal").modal("hide");
                        GetAllFormChargesGroup();
                        notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", response.message);
                        }
                        else if (response.code === 1) 
                        {
                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            $("#myModal").modal("hide");
                            GetAllFormChargesGroup();
                            console.log(response.message)
                            notification("bottomleft", "warning", "fa fa-exclamation-circle vd_red", "Warning", response.message);
                        }
                    else if (response.code === 101) {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModal").modal("hide");
                        GetAllFormChargesGroup();
                        console.log(response.message)
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                    }
                        else 
                        {
                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            $("#myModal").modal("hide");
                            GetAllFormChargesGroup();
                            console.log(response.message)
                            notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                        }
                    }
                });

            }

            function openmodalAdd() {
                $("#ID").val("");
                //$("#Code").val("");
                $("#formName").val("");
                $("#formName").prop('disabled', false);


                $("#chargeGroups").attr('multiple', '')
                $("#chargeGroups").val('').trigger('change')
                
                $("#SubmitButton").text("Submit");
                $("#SubmitButton").attr("onclick", "SaveFormChargesGroup()");
                $("#modaltitle").text("Add Charge Group");

            }

            function openModalEdit(id, formId, chargeId) {
                if (id) {
                    $("#ID").val(id);
                    $("#formName").val(formId);
                    $("#formName").prop('disabled', true);
                    $("#chargeGroups").removeAttr('multiple')
                    $("#chargeGroups").val(chargeId).trigger('change')

                    $("#SubmitButton").text("Save");
                    $("#SubmitButton").attr("onclick", "EditFormChargesGroup()");

                    $("#modaltitle").text("Update Charge Group");
                    $("#myModal").modal("show");
                }
            }


            function GetAllFormChargesGroup() {
                $.ajax({
                    type: 'GET',
                    url: `/api/Forms/GetFormsDetail`,
                    dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    async: false,
                    contentType: 'application/json',
                    success: function (response) {

                        if (response.code === 100) {
                            var datatabl = $('#ChargesGroup').DataTable();
                            datatabl.destroy();
                            $("#ChargesGrouptbody").empty();
                            var relist = response.data;
                            if (relist != null && relist.length > 0) {
                                var sr = 1;
                                for (let list of relist) {
                                    var row = ' <tr> ' +
                                        ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.formName + '</td>       ' +
                                    ' <td>' + list.chargeGroupName + '</td>       ' +
                                    '<td><a class="fa fa-edit fa-2x" style="margin-right:10px" onclick="openModalEdit(' + list.id + ', ' + list.formId + ', ' + list.chargeGroupId + ')"></a><a class="fa fa-trash-o fa-2x text-danger" onclick="ConfirmBlock(' + list.id + ')"></a></td>' +
                                        '</tr>';
                                    $("#ChargesGrouptbody").append(row);
                                    sr++;
                                }
                            }

                            $('#ChargesGroup').dataTable();
                        }
                    }
                });


            }
            function ConfirmBlock(id) {
                $("#confirmationModal").modal("show");
                $("#DeleteID").val(id);
            }
            function DeleteFormChargesGroup() {

                var id = $("#DeleteID").val();
                $.ajax({
                    type: "Get",
                    url: `/api/Forms/DeleteForms/`,
                    dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    data: { id: id },
                    async: false,
                    contentType: 'application/json',

                    success: function (response) {
                        if (response.code === 100) {

                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });

                            //alert(response.message);
                            //location.reload();
                            $("#confirmationModal").modal("hide");
                            GetAllFormChargesGroup();
                            //  alert(response.message);
                            Swal.fire(
                                'Saved!',
                                'Your Data has been Saved.',
                                'success'
                            )
                        }
                        else {
                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            notification("bottomleft", "Error", "fa fa-exclamation-circle vd_red", "Success", response.message);
                        }
                    }
                });
            }

            function GetFormName()
            {
            $.ajax({
                type: 'GET',
                url: `/api/Forms/GetForms`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) 
                            {
                                var row = ' <option value="' + list.formId+ '" >' + list.formName + '</option> ';
                                $("#formName").append(row);
                            }
                        }

                    }
                }
            });
            }

