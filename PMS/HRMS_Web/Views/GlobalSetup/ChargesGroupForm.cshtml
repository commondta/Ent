        function SaveFormChargesGroup(){

            var FormCharge=new Object();
            FormCharge.FormId = $("#formName").val();
            FormCharge.ChargeGroupIds = $("#chargeGroups").val();
            var ModelData = JSON.stringify(FormCharge);
            $.ajax({
                type: "POST",
                url: `/api/Forms/AddForms`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    if (response.code === 100) 
                    {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModal").modal("hide");
                        GetAllFormChargesGroup();
                        notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", response.message);
                    }
                   else if (response.code === 1) 
                        {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModal").modal("hide");
                        GetAllFormChargesGroup();
                            console.log(response.message)
                            notification("bottomleft", "warning", "fa fa-exclamation-circle vd_red", "Warning", response.message);
                        }
                    else 
                    {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                        //  alert(response.message);
                    }
                }
            });
        }
