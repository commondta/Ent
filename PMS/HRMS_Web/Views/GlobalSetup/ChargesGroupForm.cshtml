                    <div class="card p-3">
                        <div class="menu" style="float:right; margin-right: 15px;">
                            <a onclick="openmodalAdd()" class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal">Add New</a>
                        </div>
                        <br />

                        <br />
                        <div >
                            <div class="">
                                <table id="ChargesGroup" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            @*<th class="text-white">Code</th>*@
                                            <th class="text-white" style="text-align: center;">Form Name</th>
                                            @*<th class="text-white">Remarks</th>*@
                                            <th class="text-white" style="text-align: center;">Charge Groups</th>
                                            <th class="text-white" style="text-align: center;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ChargesGrouptbody">
                                    </tbody>
                                </table>
                            </div>
