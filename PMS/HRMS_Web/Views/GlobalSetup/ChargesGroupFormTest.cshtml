            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        <div class="row">
                            <div class="col-sm-12" style="float:left; margin-left: 15px; width:200px">
                                <label>Form Name</label>
                                <div>
                                    <select class="js-example-basic-single" name="formName" id="formName">
                                         <option value="-1"> --Select Option-- </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <br />

                        <br />
                        <div >
                            <div class="">
                                <table id="ChargesGroup" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            <th class="text-white" style="text-align: center;">Charge Groups</th>
                                            <th class="text-white" style="text-align: center;">Is Applied</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ChargesGrouptbody">
                                    </tbody>
                                </table>
                            </div>
                            <div class="menu" style="float:right; margin-top: 1.5rem;">
                                <button type="button" id="saveFormChargeGroups" onclick="saveFormChargeGroups()" class="btn btn-primary btn-sm btn-theme" style="display: none" >Save</button>
