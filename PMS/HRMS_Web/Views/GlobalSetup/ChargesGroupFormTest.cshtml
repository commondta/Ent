<!-- Middle Content End -->
<!-- /.modal -->

@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
          //  GetAllFormChargesGroup();
            GetFormName();
        });

        $(document.body).on("change", "#formName", function () {
            GetAllFormChargesGroup();
        });
        function GetAllFormChargesGroup() 
        {
                const id = $("#formName").val();
            if (id != "-1") 
            {
                $.ajax({
                    type: 'GET',
                    url: `/api/GlobalSetup/GetGlobalChargeGroup`,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    async: false,
                    contentType: 'application/json',
                    success: function (chargeGroupResponse) {
                        if (chargeGroupResponse.code == 0) {
                            const chargeGroups = chargeGroupResponse.data

                            const url = `/api/Forms/GetFormsDetail?id=${id}`
                            $.ajax({
                                type: 'GET',
                                url: url,
                                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                                dataType: "json",
                                data: { id: id },
                                async: false,
                                contentType: 'application/json',
                                success: function (formChargeGroupResponse) {

                                    if (formChargeGroupResponse.code === 100) {
                                        const datatabl = $('#ChargesGroup').DataTable();
                                        datatabl.destroy();
                                        $("#ChargesGrouptbody").empty();
                                        const formChargeGroups = formChargeGroupResponse.data ?? [];

                                        let sr = 1;

                                        for (let chargeGroup of chargeGroups) {
                                            const isApplied = formChargeGroups.findIndex(fcg => fcg.chargeGroupId == chargeGroup.id) > -1;
                                            const row = `<tr>
                                                            <td> ${sr} </td>
                                                            <td data-id="${chargeGroup.id}"> ${chargeGroup.chargeGroupName} </td>
                                                            <td> <input type="checkbox" name="chargeGroupId" value="${chargeGroup.id}" ${isApplied ? 'checked' : ''}> </td>
                                                        </tr>`

                                            $("#ChargesGrouptbody").append(row);
                                            sr++;
                                        }
                                        $('#ChargesGroup').dataTable();
                                        $("#saveFormChargeGroups").show();

                                    }
                                }
                            });
                        }

                    }
                })
            } else {
                $("#saveFormChargeGroups").hide();
                const datatabl = $('#ChargesGroup').DataTable();
                datatabl.destroy();
                $("#ChargesGrouptbody").empty();
            }
        }

        function GetFormName() {
            $.ajax({
                type: 'GET',
                url: `/api/Forms/GetForms`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.formId + '" >' + list.formName + '</option> ';
                                $("#formName").append(row);
                            }
                        }

                    }
                }
            });
        }

        function saveFormChargeGroups() {
            const formId = $("#formName").val()
            if (formId) {
                //jquery get value of all the input checkbox whose name is chargeGroupId
                const checkedChargeGroups = []
                $("input[name='chargeGroupId']:checked").each(function() {
                    checkedChargeGroups.push($(this).val());
                });

                const FormCharge = {
                    FormId: formId,
                    ChargeGroupIds: checkedChargeGroups
                }

                $.ajax({
                type: "POST",
                url: `/api/Forms/AddForms`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: JSON.stringify(FormCharge),
                success: function (response) {
                    if (response.code === 100) {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModal").modal("hide");
                        GetAllFormChargesGroup();
                        notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", response.message);
                    }
                    else if (response.code === 1) {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModal").modal("hide");
                        GetAllFormChargesGroup();
                        console.log(response.message)
                        notification("bottomleft", "warning", "fa fa-exclamation-circle vd_red", "Warning", response.message);
                    }
                    else {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                    }
                }
            });
            }
        }
    </script>
}