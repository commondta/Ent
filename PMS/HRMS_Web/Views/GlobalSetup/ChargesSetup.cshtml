        function SubmitRequest() {


            if ($("#EffectiveDate").val() != "" && $("#EffectiveDate").val() != null) {

                
                var methodType = 'POST';
                var url = "/api/GlobalChargesSetup/AddGlobalChargeSetup";
                var GlobalChargeDetailarr = new Array();
                var GlobalChargeSetup = new Object();

                 if ($("#Id").val()) {
                    GlobalChargeSetup.Id = parseInt($("#Id").val());
                     
                    methodType = 'POST';
                    url = "/api/GlobalChargesSetup/UpdateGlobalChargeSetup"
                }

                //set values
                let phaseId = $("#Phase").val() == "" ? null : $("#Phase").val();
                let RealStateTypeId = $("#RealStateType").val() == "" ? null : $("#RealStateType").val();
                let ProjectId = $("#Project").val() == "" ? null : $("#Project").val();
                let BlockId = $("#Block").val() == "" ? null : $("#Block").val();
                let NatureId = $("#Nature").val() == "" ? null : $("#Nature").val();
                let CategoryId = $("#Category").val() == "" ? null : $("#Category").val();
                let TypeId = $("#Type").val() == "" ? null : $("#Type").val();
                let possessionStatus = $("#PossessionStatus").val() == "true" ? true : false;
                let gracePeriod = $("#GracePeriod").val() == "true" ? true : false;
                let processing = $('#Processing').val() == 0 ? false : true;
                let fBR236C = $('#FBR236C').val() == 0 ? false : true;
                let registryVerification = $('#RegistryVerification').val() == 0 ? false : true;

                GlobalChargeSetup.ChargeStatus = $("#ChargesStatus").val();
                GlobalChargeSetup.ConstructionStatus = $("#ConstructionStatus").val();
                GlobalChargeSetup.PossessionStatus = possessionStatus;
                GlobalChargeSetup.GracePeriod = gracePeriod;
                GlobalChargeSetup.EffectiveDate = $("#EffectiveDate").val();
                GlobalChargeSetup.ToDate = $("#ToDate").val();
                GlobalChargeSetup.Description = $("#description").val();
                GlobalChargeSetup.GeneratorUnitType = $("#GeneratorUnitType").val();
                GlobalChargeSetup.TaxStatus = $("#TaxStatus").val();
                GlobalChargeSetup.NDCRequestType = $("#RequestType").val();
                GlobalChargeSetup.NDCTransferType = $("#TransferType").val();
                GlobalChargeSetup.Redesign = $("#Redesign").val();
                GlobalChargeSetup.FileRequestType = $("#FileRequestType").val();
                GlobalChargeSetup.NDCProcessing = processing;
                GlobalChargeSetup.FBR236C = fBR236C;
                GlobalChargeSetup.RegistryVerification = registryVerification;
                GlobalChargeSetup.GlobalChargeGroupId = $("#ChargesGroup").val();
                GlobalChargeSetup.ModifiedBy = $("#User_Id").val();
                GlobalChargeSetup.CreatedBy = $("#User_Id").val();
                GlobalChargeSetup.LastModifiedUserName = $("#User_Name").val();
                GlobalChargeSetup.RealStateTypeId = RealStateTypeId;
                GlobalChargeSetup.ProjectId = ProjectId;
                GlobalChargeSetup.PhaseId = phaseId;
                GlobalChargeSetup.BlockId = BlockId;
                GlobalChargeSetup.CategoryId = CategoryId;
                GlobalChargeSetup.PropertyTypeId = TypeId;
                GlobalChargeSetup.NatureId = NatureId;
                GlobalChargeSetup.Sector = $("#prefixPropertyNo").val();

                $("#ChargesSetuptbody tr").each(function () {
                    var row = $(this);

                    var saleTax = row.find('.ActiveInactive').is(":checked");
                    var statusforSize = row.find('.MultiplyBySize').is(":checked");
                    var wHStatus = row.find('.WHStatus').is(":checked");
                    var yearly = row.find('.Yearly').is(":checked");

                    var GlobalChargeDetail = new Object();

                        GlobalChargeDetail.Id = row.find(".id").val(),
                        GlobalChargeDetail.ChargeType = row.find(".ChargesType").val(),
                        GlobalChargeDetail.Description = row.find(".Description").val(),
                        GlobalChargeDetail.SapAccount = row.find(".SapAccount").val(),
                        GlobalChargeDetail.Rate = row.find(".Rate").val(),
                        GlobalChargeDetail.Percentage = row.find(".Percentage").val(),
                        GlobalChargeDetail.EffectiveFrom = row.find(".EffectiveFrom").val(),
                        GlobalChargeDetail.EffectiveTo = row.find(".EffectiveTo").val(),
                        GlobalChargeDetail.Status = saleTax,
                        GlobalChargeDetail.WHStatus = wHStatus,
                        GlobalChargeDetail.MultiplyBySize = statusforSize,
                        GlobalChargeDetail.Yearly = yearly,
                        GlobalChargeDetailarr.push(GlobalChargeDetail);
                });
                GlobalChargeSetup.GlobalChargeDetail = GlobalChargeDetailarr;
                var ModelData = JSON.stringify(GlobalChargeSetup);
                
                $('#SubmitR').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: methodType,
                    url: url,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {
                        
                        $('#loader').fadeOut();
                        console.log(response);
                        if (response.code == 100) {
                             Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                            empty();

                        }
                        else {
                            //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "SOmething Went Wrong");
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'SOmething Went Wrong',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                            });
                        }
                    }

                });
                
                        $('#SubmitR').prop('disabled', false); //enable


            }
            else {
                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "PLease Fill all Fields");
               
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: 'Please Fill all Fields',
                     allowOutsideClick: false,
                      allowEscapeKey: false
                });
            }
        }

