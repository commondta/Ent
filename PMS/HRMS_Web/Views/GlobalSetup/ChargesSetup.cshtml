<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
<input class="hide" value="0" />

@section Scripts {

    <script>

        $(document).ready(function () {
            "use strict";
            GetAllChargesGroup();
            GetPreviousRecords();

            $("#ChargesStatus").select2();
            $("#ConstructionStatus").select2();
            $("#PossessionStatus").select2();
            $("#GracePeriod").select2();

            // casecading property selection

            GetAllPhases();
            GetAllBlocks();
            GetAllTypes();
            GetAllProjects();
            GetAllRealEstate();
            GetAllCategories();
            GetAllNatures();
            GetAllSector();
            GetAllNDCTransferTypes();
        });

        function GetAllNDCTransferTypes() {

            $.ajax({
                type: 'GET',
                url: `/api/TransferType/GetAll`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#TransferType").empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#TransferType").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#TransferType").append(row);
                                sr++;
                            }
                        }

                        $('#TransferType').select2();
                    }
                }
            });
        }

        $('#RealStateType').on('select2:selecting', function (e) {
            var value = e.params.args.data.id;
            GetAllCategories(value);
            GetAllNatures(value);
            GetAllProjects(value);
        });

        $('#Phase').on('select2:selecting', function (e) {
            var value = e.params.args.data.id;
            GetAllRealEstate(value);
        });

        function GetAllTypes() {

            $.ajax({
                type: 'GET',
                url: `/api/PropertyType/GetAllPropertyTypes`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Type").empty();
                        var row = ' <option value="">-- Select Type --</option> ';

                        $("#Type").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Type").append(row);


                                sr++;

                            }
                        }

                        $('#Type').select2();
                    }
                }
            });
        }

        function GetAllSector() {

            $.ajax({
                type: 'GET',
                url: `/api/Sector/GetAllSectors`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#prefixPropertyNo").empty();
                        var row = ' <option value="">-- Select Sector --</option> ';

                        $("#prefixPropertyNo").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#prefixPropertyNo").append(row);


                                sr++;
                            }
                        }

                        $('#prefixPropertyNo').select2();
                    }
                }
            });
        }

        function GetAllBlocks() {

            $.ajax({
                type: 'GET',
                url: `/api/Block/GetAllBlocks`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Block").empty();
                        var row = ' <option value="">-- Select Block --</option> ';

                        $("#Block").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Block").append(row);


                                sr++;

                            }
                        }

                        $('#Block').select2();
                    }
                }
            });


        }

        function GetAllCategories(id , real) {

            var url = "/api/StockCreation/GetCategoryDropdownByRealEstateId?realEstateId=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                data: id,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Category").empty();
                        var row = ' <option value="-1">-- Select Category --</option> ';

                        $("#Category").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Category").append(row);
                                sr++;

                            }
                        }

                        $('#Category').select2();
                         if (real != undefined && real != null) {
                                
                                $('#Category').select2('val', [real]);
                          }
                    }
                }
            });


        }

        function GetAllNatures(id , real) {

            var url = "/api/StockCreation/GetNatureDropdownByRealEstateId?realEstateId=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: id,
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Nature").empty();
                        var row = ' <option value="-1">-- Select Nature --</option> ';

                        $("#Nature").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';
                                $("#Nature").append(row);
                                sr++;
                            }
                        }

                        $('#Nature').select2();
                         if (real != undefined && real != null) {
                                
                                $('#Nature').select2('val', [real]);
                          }
                    }
                }
            });
        }

        function GetAllPhases() {

            $.ajax({
                type: 'GET',
                url: `/api/Phase/GetAllPhases`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Phase").empty();
                        var row = ' <option value="-1">-- Select Phase --</option> ';

                        $("#Phase").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Phase").append(row);


                                sr++;

                            }
                        }

                        $('#Phase').select2();
                    }
                }
            });
        }

        function GetAllRealEstate(id) {
            

            $.ajax({

                type: 'GET',
                url: `/api/RealEstate/GetRealEstatesByPhaseId`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#RealStateType").empty();
