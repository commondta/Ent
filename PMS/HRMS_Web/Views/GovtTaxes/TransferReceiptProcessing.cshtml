        function printReciept(id, invType) {
            var typeofprint = $("#printType").val(); 
            var id = id;
            var url = "/api/TransferReceiptProcessing/PrintReceipt";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id, type: typeofprint, invoiceType: invType },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;

                        $(".challanNo").text(result_User.challanNo);

                        const challanDate = $("#challanDate").val();
                        // Document date from response
                        const docDate = new Date(challanDate);

                        // Last day of the document date's month
                        const lastDayOfDocMonth = new Date(
                            docDate.getFullYear(),
                            docDate.getMonth() + 1,
                            0
                        );

                        // Format helpers
                        const formatYYYYMMDD = (d) =>
                            d.getFullYear() + "-" +
                            String(d.getMonth() + 1).padStart(2, '0') + "-" +
                            String(d.getDate()).padStart(2, '0');

                        const formatDDMMYYYY = (d) =>
                            String(d.getDate()).padStart(2, '0') + "-" +
                            String(d.getMonth() + 1).padStart(2, '0') + "-" +
                            d.getFullYear();

                        // Set values
                        $(".docDate").text(formatDDMMYYYY(docDate));
                        $(".dueDate").text(formatDDMMYYYY(lastDayOfDocMonth));

                        $(".paymentMode").text($("#PaymentMode").val());
                        $(".id").text(result_User.id);
                        $(".registrationNo").text(result_User.registrationNo);
                        $(".buyerName").text(result_User.buyerName || "N/A");
                        $(".blockName").text(
                            (result_User.stockCreation.propertyNo ? result_User.stockCreation.propertyNo + " / " : "N/A / ") +
                            (result_User.blockName || "N/A")
                        );
                        $(".plotSize").text(result_User.stockCreation.categoryName || "N/A"
                            // (result_User.stockCreation.actualSize ? result_User.stockCreation.actualSize + " " : "N/A ") +
                            // (result_User.stockCreation.actualSizeUnit || "")
                        );
                        $(".plotType").text(result_User.stockCreation.typeName || "N/A");

                        $(".CollectionOfficer").text("@Context.Session.GetString("FullName")");

                        $(".tbodyinvoice").empty();

                        var relist;
                        if (typeofprint == "Seller")//tbodyinvoice
                        {
                            relist = result_User.sellerTaxes;
                        }
                        else if (invType == "NDC") {
                            relist = result_User.govtBuyerCharges;
                        }
                        else {
                            relist = result_User.buyerTaxes;
                        }
                        var amounttotal = 0;
                        var sr = 1;
                        for (let list of relist) {
                            var row = '<tr style="font-size: 11px" id="' + sr + '" DetailId="0"> ' +
                                '<td style="text-align:center">' + sr + '</td>' +
                                '<td style="padding-left:8px">' + list.chargeName + '</td>' +
                                '<td style="text-align:right;padding-right:4px">' + formatPKR(list.amount) + '</td>' +
                                '</tr>';
                            $(".tbodyinvoice").append(row);
                            amounttotal = amounttotal + list.amount;
                            sr++;
                        }
                        $(".invoicetotal").text(formatPKR(amounttotal));
                        var amountinwords = numberToWords(amounttotal);
                        $(".amountinwords").text(amountinwords);
                        $("#ViewStockForSearchModal").modal("hide");
                        printInvoiceRecipt();

                    }

                    else {

                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                    }
                }
            });
            //printInvoice()
        }

        function numberToWords(number) {
            var digit = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
            var elevenSeries = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
            var countingByTens = ['twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
            var shortScale = ['', 'thousand', 'million', 'billion', 'trillion'];

            number = number.toString(); number = number.replace(/[\, ]/g, ''); if (number != parseFloat(number)) return 'not a number'; var x = number.indexOf('.'); if (x == -1) x = number.length; if (x > 15) return 'too big'; var n = number.split(''); var str = ''; var sk = 0; for (var i = 0; i < x; i++) { if ((x - i) % 3 == 2) { if (n[i] == '1') { str += elevenSeries[Number(n[i + 1])] + ' '; i++; sk = 1; } else if (n[i] != 0) { str += countingByTens[n[i] - 2] + ' '; sk = 1; } } else if (n[i] != 0) { str += digit[n[i]] + ' '; if ((x - i) % 3 == 0) str += 'hundred '; sk = 1; } if ((x - i) % 3 == 1) { if (sk) str += shortScale[(x - i - 1) / 3] + ' '; sk = 0; } } if (x != number.length) { var y = number.length; str += 'point '; for (var i = x + 1; i < y; i++) str += digit[n[i]] + ' '; } str = str.replace(/\number+/g, ' '); return str.trim() + " Only.";

        }

        function printInvoiceRecipt() {
            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

