@section Scripts {
    <script src="~/js/QrCode.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            const today = new Date().toISOString().split('T')[0];
            $('#documentDate').val(today);
            $('#challanDate').val(today);
            GetAllNDCTransferTypes();
            GetAllPropertyLists();
            GetAllMembersList();
            GetAllDealerProfiles();
            GetPreviousRecords();
            $("#ReciptProcessing").validate({
                errorElement: 'div', 
                errorClass: 'vd_red', 
                focusInvalid: false,
                ignore: "",
                rules: {
                    BuyerName: {

                        required: true
                    },
                    RegistrationNo: {

                        required: true
                    },
                    slotDate: {

                        required: true
                    },
                    availableHour: {

                        required: true
                    },
                    availableMintues: {

                        required: true
                    },
                    // DealerCode: {

                    //     required: true
                    // },
                    // DealerName: {

                    //     required: true
                    // },
                },

                errorPlacement: function (error, element) {
                
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });

            var id = $("#TransferReceiptProcessingAId").val();
          
            if (id > 0) {
                SelectSinglePPS(id);
                if ($("#TransferReceiptProcessingAId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#ReciptProcessing :input").prop("disabled", true);
                }
            }
        });

        function refreshPage() {
            location.reload();
        }

        function GetAllNDCTransferTypes() {

            $.ajax({
                type: 'GET',
                url: `/api/TransferType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Transfer").empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#Transfer").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#Transfer").append(row);
                                sr++;
                            }
                        }

                        $('#Transfer').select2();
                    }
                }
            });
        }


        $("#clearButton").click(function () {
            $("#DealerCode").val('');
            $("#EstateName").val('');
            $("#DealerName").val('');
        });

        let dayOfWeek = '';
        let date = '';
        const datePicker = document.getElementById("slotDate");

        datePicker.addEventListener("change", function () {

            $("#availableHour").val("");
            $("#availableMintues").val("");
            $("#availableHour").empty();
            $("#availableMintues").empty();

            date = document.getElementById("slotDate").value;
            const selectedDate = new Date(datePicker.value);
            const daysOfWeek = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            dayOfWeek = daysOfWeek[selectedDate.getDay()];
            $("#Day").val(dayOfWeek);

            GetAvailableHours(dayOfWeek, date);
        });

        $("#availableHour").change(function () {
            let hour = $(this).val();

            if (hour != "" && dayOfWeek != "" && date != "") {
                GetAvailableMintues(dayOfWeek, date, hour);
            }
        });

        function populateHoursDropdown(selectedValue) {
            $('#availableHour').empty();
            $('#availableHour').append($('<option>').text(selectedValue).attr('value', selectedValue));
        }
        function populateMintuesDropdown(selectedValue) {
            $('#availableMintues').empty();
            $('#availableMintues').append($('<option>').text(selectedValue).attr('value', selectedValue));
        }

        function GetAvailableHours(dayOfWeek, datePicker, hrr) {

            const requestType = $("#RequestType").val();
            const endpoint = (requestType === "Premium Transfer")
                ? "/api/Calendar/GetAvailableHours"
                : "/api/Calendar/GetAvailableHoursExecutive";

            const url = `${endpoint}?dayOfWeek=${dayOfWeek}&datePicker=${datePicker}`;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#availableHour").empty();
                        var row = ' <option value="">Select Hour</option> ';

                        $("#availableHour").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list + '" >' + list + '</option> ';

                                $("#availableHour").append(row);
                                sr++;
                            }
                        }

                        $('#availableHour').select2();
                    }

                    if (hrr != undefined && hrr != null) {
                        $('#availableHour').select2('val', [hrr]);

                    }
                }
            });
        }

        function GetAvailableMintues(dayOfWeek, datePicker, hour, min) {

            const requestType = $("#RequestType").val();
            const endpoint = (requestType === "Premium Transfer")
                ? "/api/Calendar/GetAvailableMintues"
                : "/api/Calendar/GetAvailableMintuesExecutive";

            const url = `${endpoint}?dayOfWeek=${dayOfWeek}&datePicker=${datePicker}&hour=${hour}`;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#availableMintues").empty();
                        var row = ' <option value="">Select Mintues</option> ';

                        $("#availableMintues").append(row);

                        var relist = response.data;
                       
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list + '" >' + list + '</option> ';

                                $("#availableMintues").append(row);
                                sr++;
                            }
                        }

                        $('#availableMintues').select2();
                    }

                    if (min != undefined && min != null) {

