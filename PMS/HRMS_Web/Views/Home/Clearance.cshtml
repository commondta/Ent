@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#clear").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {
                        // minlength: 3,
                        required: true
                    },
                    PropertyNo: {
                        //minlength: 3,
                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    
                    SaveClearance();
                }

            });
            var chargeswavieOff = 0;
            GetAllPropertyLists();
            GetSurchargeSetup();
        });
        var totalSurCharge = 0;
        var surchargeList=new Array();
        function GetSurchargeSetup() {
            
            $.ajax({
                type: 'GET',
                url: `/api/SurchargeSetup/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    
                    if (response.code === 100) {
                        // surchargeList = response.data;
                        $.each(response.data, function (j, item) {
                            var fromDate = moment(item.fromDate).format('YYYY-MM-DD');
                            var toDate = moment(item.toDate).format('YYYY-MM-DD');
                            item.fromDate = new Date(fromDate);
                            item.toDate = new Date(toDate);
                            
                            surchargeList.push(item);
                        });
                       // totalSurCharge = response.data.totalSurCharge;
                        console.log(totalSurCharge);
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Reference Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function GetAllPropertyLists() {
            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function valOrNA(value) {
            return value === null || value === undefined || value === "" ? "N/A" : value;
        }


        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResultForNDCById?stockId=" + id + "";

            
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";

                        $("#RegistrationNo").val(valOrNA(result_User.registrationNo));
                        $("#PropertyNo").val(valOrNA(result_User.propertyNo));
                        $("#MembCode").val(valOrNA(result_User.memberProfileId));
                        $("#MembName").val(valOrNA(result_User.memberName));
                        $("#ConstrucationStatus").val(valOrNA(result_User.constructionStatus));
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(valOrNA(result_User.actualSize));
                        $("#Category").val(valOrNA(result_User.categoryName));
                        $("#Block").val(valOrNA(result_User.blockName));
                        $("#CNIC").val(valOrNA(result_User.cnic));

                        var cnicExpDate = result_User.cnicExpiryDate
                            ? result_User.cnicExpiryDate.split("T")[0].split("-").reverse().join("-")
                            : "N/A";

                        $("#CNICExp").val(cnicExpDate);

                        $("#PMemberId").text(valOrNA(result_User.memberProfileId));
                        $("#PMemberName").text(valOrNA(result_User.memberName));
                        $("#PRegistrationNumber").text(valOrNA(result_User.registrationNo));
                        $("#PPropertyNumber").text(valOrNA(result_User.propertyNo));
                        $("#PCategory").text(valOrNA(result_User.categoryName));
                        $("#PBlock").text(valOrNA(result_User.blockName));
                        $("#PSize").text(valOrNA(result_User.actualSize));
                        $("#PCNIC").text(valOrNA(result_User.cnic));
                        $("#PStatus").text(possessionstatus);
                        $("#PCStatus").text(valOrNA(result_User.constructionStatus));

                        chargeswavieOff = result_User.discountPercent;
                        const Sector = result_User.sector;
                        const Block = result_User.block;
                        const Category = result_User.category;
                        const ConstracutionStatus = result_User.constructionStatus;

                        if (Sector && Block && Category && ConstracutionStatus) {
                            const obj = {
                                Sector,
                                Block,
                                Category,
                                ConstracutionStatus
                            };

                            //getchargesdata(obj);
                        }

                        GetDataFromSap(result_User.registrationNo, result_User.memberProfileId);
                        GetSummaryDataFromSap(result_User.registrationNo, result_User.memberProfileId);
                        $("#StockCreationId").val(result_User.id);
                        $("#MemberProfileId").val(result_User.memberProfileId);

                        $("#registrationModal").modal("hide");
                        // LoadApprovalHistory(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                    }
                }
            });
        }

            function safeNumber(val) {
                val = parseFloat(val);
                return isNaN(val) ? 0 : val;
            }

        function formatAmount(val) {
            return safeNumber(val).toLocaleString('en-PK', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            });
        }

        function GetSummaryDataFromSap(registrationNo, memberProfileId) {

            $("#summaryTableBody").empty();
            $("#summaryTableBodyPrint").empty();

            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetCleareanceSummary`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { registrationNo, memberProfileId },
                success: function (response) {

                    if (response.code !== 100 || !response.data || response.data.length === 0)
                        return;

                    let totals = {
                        balanceOwed: 0,
                        receivedAmount: 0,
                        adjustmentAmount: 0,
                        balanceDue: 0,
                        surcharge: 0,
                        waiverOff: 0,
                        surchargeReceived: 0,
                        totalAmountDue: 0
                    };

                    $.each(response.data, function (index, item) {

                        const balanceOwed = safeNumber(item.balanceOwed);
                        const receivedAmount = safeNumber(item.receivedAmount);
                        const adjustmentAmount = safeNumber(item.adjustmentAmount);
                        const balanceDue = safeNumber(item.balanceDue);
                        const surcharge = safeNumber(item.surcharge);
                        const waiverOff = safeNumber(item.waiverOff);
                        const surchargeReceived = safeNumber(item.surchargeReceivedApplied);
                        const totalAmountDue = safeNumber(item.totalAmountDue);

                        totals.balanceOwed += balanceOwed;
                        totals.receivedAmount += receivedAmount;
                        totals.adjustmentAmount += adjustmentAmount;
                        totals.balanceDue += balanceDue;
                        totals.surcharge += surcharge;
                        totals.waiverOff += waiverOff;
                        totals.surchargeReceived += surchargeReceived;
                        totals.totalAmountDue += totalAmountDue;

                        let row = `
        <tr>
            <td>${index + 1}</td>
            <td>${item.chargeType || ''}</td>
            <td class="text-end">${formatAmount(balanceOwed)}</td>
            <td class="text-end">${formatAmount(receivedAmount)}</td>
            <td class="text-end">${formatAmount(adjustmentAmount)}</td>
            <td class="text-end">${formatAmount(balanceDue)}</td>
            <td class="text-end">${formatAmount(surcharge)}</td>
            <td class="text-end">${formatAmount(waiverOff)}</td>
            <td class="text-end">${formatAmount(surchargeReceived)}</td>
            <td class="text-end fw-bold">${formatAmount(balanceDue + surcharge - waiverOff - surchargeReceived)}</td>
        </tr>`;

                        $("#summaryTableBody").append(row);
                        $("#summaryTableBodyPrint").append(row);
                    });

                    // ===== GRAND TOTAL ROW =====
                    let totalRow = `
        <tr style="background:#f2f2f2;font-weight:bold;">
            <td style="font-weight:bold;">#</td>
            <td style="font-weight:bold;">GRAND TOTAL</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.balanceOwed)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.receivedAmount)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.adjustmentAmount)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.balanceDue)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.surcharge)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.waiverOff)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.surchargeReceived)}</td>
            <td class="text-end" style="font-weight:bold;">${formatAmount(totals.balanceDue + totals.surcharge - totals.waiverOff - totals.surchargeReceived)}</td>
        </tr>`;


                    $("#summaryTableBody").append(totalRow);
                    $("#summaryTableBodyPrint").append(totalRow);
                }
            });
        }



        
       


        function PrintGrid() {
            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

        // Set to true to log parsed values for debugging
        const DEBUG_PARSE_TOTALS = false;

        function GetDataFromSap(registrationNo, memberProfileId) {
            $('#loader').fadeIn();
            NProgress.start();
            NProgress.set(0.0);
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetCleareanceData`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { registrationNo, memberProfileId },
                success: function (response) {

                    if (response.code !== 100) {
                        $('#loader').fadeOut();
                        NProgress.done();
                        return
                    }

                    $('#loader').fadeOut();
                    NProgress.done();

                    var rowIndex = 1;

                    // clear previous body & print body
                    $("#Cleartbody").empty();
                    $("#tbodyPrint").empty();

                    // 1) render rows with stable class names on numeric columns
                    $.each(response.data, function (i, item) {
                        var row = `<tr>
                            <td>${rowIndex++}</td>
                            <td>${item.accountName ?? ''}</td>
                            <td>${item.description ?? ''}</td>
                            <td style="text-align: center;">${item.invoiceNo ?? ''}</td>
                            <td>${item.dueDate ? moment(item.dueDate).format("DD-MM-YYYY") : ''}</td>

                            <td class="col-invoiceAmount" style="text-align: right;">${formatPKR(item.invoiceAmount)}</td>
                            <td class="col-balanceOwed" style="text-align: right;">${formatPKR(item.balanceOwed)}</td>

                            <td style="text-align: center;">${item.settleDocNum ?? ''}</td>
                            <td>${item.settleDate ? moment(item.settleDate).format("DD-MM-YYYY") : ""}</td>

                            <td class="col-receivedAmount" style="text-align: right;">${formatPKR(item.receivedAmount)}</td>
                            <td class="col-adjustment" style="text-align: right;">${formatPKR(item.adjustment)}</td>
                            <td class="col-balanceDue" style="text-align: right;">${formatPKR(item.balanceDue)}</td>

                            <td class="col-surcharge" style="text-align: right;">${formatPKR(item.surcharge)}</td>
                                    <td class="col-waiveOff" style="text-align: right;">${formatPKR(item.waiverPaid)}</td>
                                    <td class="col-surchargeReceived" style="text-align: right;">${formatPKR(item.surchargePaymentPaid)}</td>
                                    <td class="col-receivable" style="text-align: right;">${formatPKR(item.totalAmountDue)}</td>
                        </tr>`;

                        $("#Cleartbody").append(row);
                        $("#tbodyPrint").append(row);
                    });

                    // 2) parse-then-sum from the rendered table (use integer cents)
                    function parseCellToCents(text) {
                        if (text === null || text === undefined) return 0;
                        // Remove any character that is not digit, dot, or minus sign
                        // This removes currency symbols, spaces, commas, non-breaking spaces, etc.
                        const cleaned = String(text).replace(/[^\d.\-]/g, '').trim();
                        if (cleaned === '' || cleaned === '-' || cleaned === '.' || cleaned === '-.') return 0;
                        const f = parseFloat(cleaned);
                        if (!isFinite(f)) return 0;
                        // round to nearest cent (2 decimals)
                        return Math.round(f * 100);
                    }

                    function formatMoneyFromCents(cents) {
                        const value = cents / 100;
                        if (typeof formatPKR === 'function') return formatPKR(value);
                        return value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    }

                    // helper: sum column by td selector (class)
                    function sumColumnByClass(tdClass) {
                        let totalCents = 0;
                        $("#Cleartbody").find(`td.${tdClass}`).each(function () {
                            // each numeric cell should be exactly one td with the class; parse its text
                            const txt = $(this).text();
                            const cents = parseCellToCents(txt);
                            totalCents += cents;
                            if (DEBUG_PARSE_TOTALS) {
                                console.debug(`parse ${tdClass}: raw="${txt}" -> ${cents} cents`);
                            }
                        });
                        return totalCents;
                    }

                    // Remove any previous totals row(s) to avoid double counting
                    $("#Cleartbody").find("tr.totals-row").remove();
                    $("#tbodyPrint").find("tr.totals-row").remove();

                    // Sum (in cents)
                    const docTotalC = sumColumnByClass("col-invoiceAmount");
                    const totalBalanceOwedC = sumColumnByClass("col-balanceOwed");
                    const totalReceivedC = sumColumnByClass("col-receivedAmount");
                    const totalAdjustmentC = sumColumnByClass("col-adjustment");
                    const balanceDueC = sumColumnByClass("col-balanceDue");
                    const totalSurchargeC = sumColumnByClass("col-surcharge");
                    const totalWaiveOffC = sumColumnByClass("col-waiveOff");
                    const totalSurchargeReceivedC = sumColumnByClass("col-surchargeReceived");
                    const totalReceivableC = sumColumnByClass("col-receivable");

                    if (DEBUG_PARSE_TOTALS) {
                        console.debug({
                            docTotalC, totalBalanceOwedC, totalReceivedC, totalAdjustmentC, balanceDueC,
                            totalSurchargeC, totalWaiveOffC, totalSurchargeReceivedC, totalReceivableC
                        });
                    }

                    // 3) append totals row (convert cents back to numeric/display)
                    const totalRow = `
                        <tr class="totals-row" style="font-weight: bold; background-color: #f9f9f9;">
                            <td colspan="5">Total:</td>
                            <td style="text-align: right;">${formatMoneyFromCents(docTotalC)}</td>
                            <td style="text-align: right;">${formatMoneyFromCents(docTotalC)}</td>
                            <td></td>
                            <td></td>
                            <td style="text-align: right;">${formatMoneyFromCents(totalReceivedC)}</td>
                            <td style="text-align: right;">${formatMoneyFromCents(totalAdjustmentC)}</td>
                            <td style="text-align: right;">${formatMoneyFromCents(docTotalC - totalReceivedC - totalAdjustmentC)}</td>
                            <td style="text-align: right;">${formatMoneyFromCents(totalSurchargeC)}</td>
                            <td style="text-align: right;">${formatMoneyFromCents(totalWaiveOffC)}</td>
                            <td style="text-align: right;">${formatMoneyFromCents(totalSurchargeReceivedC)}</td>
                             <td style="text-align: right;">${formatMoneyFromCents(docTotalC - totalReceivedC - totalAdjustmentC + totalSurchargeC - totalWaiveOffC - totalSurchargeReceivedC)}</td>
                        </tr>`;

                    $("#Cleartbody").append(totalRow);
                    $("#tbodyPrint").append(totalRow);

                    // 4) optional: call populateSummaryTable() which expects totals to be in table
                    // if (typeof populateSummaryTable === 'function') populateSummaryTable();
                },
                error: function (xhr, status, err) {
                    console.error("GetDataFromSap failed:", status, err);
                }
            });
        }




