        function findAmountForSurcharge(checkDate, list) {
            for (var i = 0; i < list.length; i++) {
                var currentDateRange = list[i];
                if (checkDate >= currentDateRange.fromDate && checkDate <= currentDateRange.toDate) {
                    return currentDateRange.totalSurCharge;
                }
            }
            return 0; // Return null if no matching range is found
        }



        function formatPKR(value) {
            var roundedValue = Math.round(value);
            var formattedValue = roundedValue.toLocaleString('en-PK').replace(/Rs/g, '');
            return formattedValue;
        }

        function GetSurcharge(fromdate, todate , callback) {
            var url = "/api/SurchargeSetup/GetSurchageInRange?fromdate=" + fromdate + "&todate=" + todate;

            $.ajax({
                type: "GET",
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                success: function (response) {
                    
                    if (response.code == 100) {
                        if (response.data != null) {
                            callback(response.data);
                        }
                    }
                }
            });
        }

