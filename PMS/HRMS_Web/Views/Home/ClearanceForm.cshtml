@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#clear").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {
                        // minlength: 3,
                        required: true
                    },
                    PropertyNo: {
                        //minlength: 3,
                        required: true
                    },
                },

                errorPlacement: function (error, element) {

                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    //Swal.fire({
                    //    icon: 'error',
                    //    title: 'Error',
                    //    text: 'Enter Valid Data',
                    //});
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {

                    SaveClearance();
                }

            });
            GetAllPropertyLists();

        });

        var requestAction = 0;

        //checkbox fun

        $("#chkapproved").on('change', function () {
            if ($(this).prop('checked')) {
                $("#chkdues").prop('checked', false)
                $("#chksap").prop('checked', false)
                $("#chkdues").attr("disabled", true);
                $("#chksap").attr("disabled", true);
                requestAction = 1;
            }
            else {
                $("#chkdues").attr("disabled", false);
                $("#chksap").attr("disabled", false);
            }
        });

        $("#chkdues").on('change', function () {
            if ($(this).prop('checked')) {
                $("#chkapproved").prop('checked', false)
                //$("#chksap").prop('checked', false)
                $("#chkapproved").attr("disabled", true);
                //$("#chksap").attr("disabled", true);
                requestAction = 3;
            }
            else {
                $("#chkapproved").attr("disabled", false);
                //$("#chksap").attr("disabled", false);
            }
        });

        $("#chksap").on('change', function () {
            if ($(this).prop('checked')) {
                $("#chkapproved").prop('checked', false)
                //$("#chkdues").prop('checked', false)
                $("#chkapproved").attr("disabled", true);
                //$("#chkdues").attr("disabled", true);
                requestAction = 2;
            }
            else {
                $("#chkapproved").attr("disabled", false);
                // $("#chkdues").attr("disabled", false);
            }
        });

        function refreshPage() {
            location.reload();
        }

        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Clearance/GetAllClearnceFilterList`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="id">' + list.id + '</td> ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="memberName">' + list.memberName + '</td>       ' +
                                    ' <td class="cnic">' + list.cnic + '</td>' +
                                    ' <td class="memberCode">' + list.memberCode + '</td> ' +
                                    ' <td class="redesignRequest">' + list.redesignRequest + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(this)">Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(el) {

            var id = $(el).parents('tr').find(".id").text();
            var property = $(el).parents('tr').find(".propertyNo").text();
            var Registration = $(el).parents('tr').find(".registrationNo").text();
            var memberName = $(el).parents('tr').find(".memberName").text();
            var memberCode = $(el).parents('tr').find(".memberCode").text();
            var cnic = $(el).parents('tr').find(".cnic").text();
            var redesignRequest = $(el).parents('tr').find(".redesignRequest").text();


            $(".id").val(id);
            $("#StockId").val(id);
            $("#RegistrationNo").val(Registration);
            $("#PropertyNo").val(property);
            $("#MemberName").val(memberName);
            $("#MemberCode").val(memberCode);
            $("#CNIC").val(cnic);
            $("#RedesignRequest").val(redesignRequest);

            LoadApprovalHistory(id, 9);
            ShowAlert(id);
            PropertyDetail(id);
            GetDataFromSap(Registration);
            $("#registrationModal").modal("hide");
        }

        function GetDataFromSap(registrationNo) {

            $('#loader').fadeIn();
            NProgress.start();
            NProgress.set(0.0);

            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetDemarcationClearanceData`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { registrationNo: registrationNo },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        $('#loader').fadeOut();
                        NProgress.done();
                        $("#Cleartbody").empty();
                        $.each(response.data, function (index, clearence) {
                            var rownumber = index + 1;

                            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <input disabled class="form-control line" value="' + clearence.chargeType + '"/></td>' +
                                //'<td> <input disabled class="form-control line" value=""/></td>' +
                                '<td> <input disabled class="form-control line" value="' + clearence.docNum + '"/></td>' +
                                //'<td> <input disabled class="form-control line" value="' + clearence.accntntCod + '"/></td>' +
                                '<td> <input disabled class="form-control line" value="' + clearence.receiptNum + '"/></td>' +
                                '<td> <input disabled class="form-control line" value="' + clearence.docTotal + '"/></td>' +
                                '<td> <input disabled class="form-control line" value="' + clearence.balanceDue + '"/></td>' +
                                '<td> <input disabled class="form-control line" value=""/></td>' +
                                '</tr>';

                            $("#Cleartbody").append(row);

                        });
                    }

                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function SaveClearance() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }



        function Submit() {

            if ((document.getElementById('chkapproved').checked == false) && (document.getElementById('chkdues').checked == false) && (document.getElementById('chksap').checked == false))

            //alert('You didn\'t choose any of the checkboxes!');
            {
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: 'Please Select Any One of CheckBox',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                })
            }
            else {

                var stockId = $("#StockId").val();
                var redesignRequest = $("#RedesignRequest").val();

                $('#submmit').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: 'GET',
                    url: `/api/Clearance/AddClearnceRequest`,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    data: { requestAction: requestAction, stockId: stockId, redesignRequest: redesignRequest },
                    async: false,
                    contentType: 'application/json',
                    success: function (response) {

                        $('#loader').fadeOut();
                        debugger;
                        if (response.code === 2) {
                            $('#submmit').prop('disabled', false);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                        }

                        else if (response.code === 100) {

                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }

                        else {
                            //notification("topright", "error", "fa fa-exclamation-circle vd_red", "Error", "No Record Found");
                            $('#submmit').prop('disabled', false);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'No Record Found',
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });

                            // window.alert(response.message);
                        }
                    }
                });
                //$('#submmit').prop('disabled', false); //enable
            }
        }
    </script>


}
