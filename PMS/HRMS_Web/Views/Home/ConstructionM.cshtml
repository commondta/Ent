        function PostConstructionMonitoring() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            var ConstructionMonitoring = new Object();
            var ConstructionMonitoringStageDetails = new Array();
            var voilationArr = new Array();
            var stickArr = new Array();
            var serviceArr = new Array();
            var stackingArr = new Array();

            ConstructionMonitoring.StockCreationId = parseInt($("#stockCreationId").val());
            ConstructionMonitoring.UserId = parseInt($("#userid").val());
            ConstructionMonitoring.ConstructionStatus = $("#ConstructionStatus").val();
            ConstructionMonitoring.ConstructedStatus = $("#ConstructedStatus").val();
            ConstructionMonitoring.ConstructionStartDate = $("#ConstructionStartDate").val().trim() || null;
            ConstructionMonitoring.ConstructionEndDate = $("#ConstructionEndDate").val().trim() || null;
            ConstructionMonitoring.EWSConnectionStatus = $("#EWSStatus").val();
            ConstructionMonitoring.ModifiedBy = $("#User_Id").val();
            ConstructionMonitoring.CreatedBy = $("#User_Id").val();
            ConstructionMonitoring.LastModifiedUserName = $("#User_Name").val();
            if ($("#ID").val() == null || $("#ID").val() == "") {
                ConstructionMonitoring.Id = parseInt(0);
            }
            else {
                ConstructionMonitoring.Id = parseInt($("#ID").val());
            }

            $("#StackingMtbody tr").each(function () {
                var row = $(this);
                var stacking = new Object();

                stacking.Designation = row.find(".SDesignation").val(),
                stacking.Name = row.find(".SName").val(),
                stacking.Remarks = row.find(".SRemarks").val(),
                stackingArr.push(stacking);
            });

            $("#SiteServicesMtbody tr").each(function () {
                var row = $(this);
                var service = new Object();

                    service.Name = row.find(".SSName").val(),
                    service.Date = row.find(".SSDate").val(),
                    service.Status = row.find(".SSStatus").val(),
                    service.Remarks = row.find(".SSRemarks").val(),
                    serviceArr.push(service);
            });

            $("#YardStickMtbody tr").each(function () {
                var row = $(this);
                var stick = new Object();

                    stick.Stage = row.find(".StageName1").val(),
                    stick.Date = row.find(".YSDate").val(),
                    stick.Progress = row.find(".YSProgress").val(),
                    stick.Status = row.find(".YSStatus").val() === 'Yes';
                    stick.Remarks = row.find(".YSRemarks").val(),
                    stickArr.push(stick);
            });

            $("#VoilationMtbody tr").each(function () {
                var row = $(this);
                var voilation = new Object();

                    voilation.InspectionBy = row.find(".VInspectionBy").val(),
                    voilation.Violation = row.find(".Violation1").val(),
                    voilation.Date = row.find(".VDate").val(),
                    voilation.Amount = row.find(".VAmount").val(),
                    voilation.Remarks = row.find(".VRemarks").val(),
                    voilationArr.push(voilation);
            });

            $("#ConsMtbody tr").each(function () {
                var row = $(this);
                var ConstructionMonitoringStage = new Object();

                    ConstructionMonitoringStage.StageCode = row.find(".StageCode").val(),
                    ConstructionMonitoringStage.StageName = row.find(".StageName").val(),
                    ConstructionMonitoringStage.InspectionBy = row.find(".InspectionBy").val(),
                    ConstructionMonitoringStage.Violation = row.find(".Violation").val(),
                    ConstructionMonitoringStage.Remarks = row.find(".Remarks").val(),
                    ConstructionMonitoringStage.Picture = row.find(".Picture").val(),
                    ConstructionMonitoringStageDetails.push(ConstructionMonitoringStage);
            });

            ConstructionMonitoring.ViolationCM = voilationArr;
            ConstructionMonitoring.YardStickCM = stickArr;
            ConstructionMonitoring.SiteServicesCM = serviceArr;
            ConstructionMonitoring.StackingCM = stackingArr;
            ConstructionMonitoring.ConstructionMonitoringStageDetail = ConstructionMonitoringStageDetails;
            if (ConstructionMonitoring.ConstructionMonitoringStageDetail != null && ConstructionMonitoring.ConstructionMonitoringStageDetail != undefined && ConstructionMonitoring.ConstructionMonitoringStageDetail != "") {
                if (ConstructionMonitoring != null && ConstructionMonitoring != undefined && ConstructionMonitoring != "") {
                    var ModelData = JSON.stringify(ConstructionMonitoring);

                    $('#PostConstructionMonitoring').prop('disabled', true); //disble
                    $('#loader').fadeIn();
                    var url = "";
                    var methodtype = "";
                    if ($("#ID").val() == null || $("#ID").val() == "") {
                        url = "/api/ConstructionMonitoring/AddNewConstructionMonitoring";
                        methodtype = "Post";
                    }
                    else {
                        url = "/api/ConstructionMonitoring/UpdateConstructionMonitoring";
                        methodtype = "Put";
                    }
                    $.ajax({
                        url: url,
                        type: methodtype,
                        contentType: 'application/json; charset=utf-8',
                        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                        processData: false,
                        dataType: "json",
                        async: false,
                        data: ModelData,
                        success: function (data) {

                            $('#loader').fadeOut();
                            if (data.code == 100) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: data.message,
                                    customClass: 'swal-wide',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // location.reload(true);
                                    }
                                    else if (result.isDenied) {
                                        Swal.fire('Changes are not saved', '', 'info')
                                    }
                                })
                            }
                            else {
                                $('#PostConstructionMonitoring').prop('disabled', false);
                                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", data.message);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message,
                                    customClass: 'swal-wide',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });

                            }
                        }
                    });
                }
                else {
                    $('#PostConstructionMonitoring').prop('disabled', false);
                    //notification("topright", "error", "fa fa-exclamation-circle vd_red", "Error", "please fill the revelent fields");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'please fill the revelent fields',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            }
            else {
                $('#PostConstructionMonitoring').prop('disabled', false);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Please add atleast one Line Item',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            }
        }

