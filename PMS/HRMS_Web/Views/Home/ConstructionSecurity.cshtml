        function SubmitConstructionSecurity() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            var ConstructionSecurity = new Object();
            var labourArray = new Array();
            var AttachmentArray = new Array();
            var RemarksArray = new Array();
            ConstructionSecurity.StockCreationId = parseInt($("#StockId").val());
            ConstructionSecurity.ContractorName = $("#ContractorName").val();
            ConstructionSecurity.MobileNumber = $("#MobileNumber").val();
            ConstructionSecurity.CNIC = $("#ContractorCNIC").val();
            ConstructionSecurity.Address = $("#Address").val();
            ConstructionSecurity.SurveyorName = $("#SurveyorName").val();
            ConstructionSecurity.SurveyorNumber = $("#SurveyorNumber").val();
            ConstructionSecurity.SurveyorCNIC = $("#SurveyorCNIC").val();
            ConstructionSecurity.SurveyorAddress = $("#SurveyorAddress").val();
            ConstructionSecurity.Remarks = $("#remarks").val();
            ConstructionSecurity.ModifiedBy = $("#User_Id").val();
            ConstructionSecurity.CreatedBy = $("#User_Id").val();
            ConstructionSecurity.LastModifiedUserName = $("#User_Name").val();


            $("#Labourtbody tr").each(function () {
                var row = $(this);
                var ConstructionSecurityLabour = new Object();

                ConstructionSecurityLabour.Name = row.find(".name").val(),
                ConstructionSecurityLabour.CNIC = row.find(".cnic").val(),
                ConstructionSecurityLabour.CNICAttachment = row.find(".imagefile").val(),
                ConstructionSecurityLabour.GatePassValidity = row.find(".gatePassValidity").val(),
                labourArray.push(ConstructionSecurityLabour);
            });
            $("#Attachmenttbody tr").each(function () {
                var row = $(this);
                var ConstructionSecurityAttachment = new Object();

                ConstructionSecurityAttachment.AttachmentPath = row.find(".attachmentName").val(),
                    ConstructionSecurityAttachment.AttachmentName = row.find(".attachmentName").val(),
                    ConstructionSecurityAttachment.Attachment = row.find(".imagefile").val(),
                    ConstructionSecurityAttachment.AttachmentDate = row.find(".attachmentDate").val(),
                    ConstructionSecurityAttachment.Remarks = row.find(".remarks").val(),

                    AttachmentArray.push(ConstructionSecurityAttachment);
            });

            ConstructionSecurity.ConstructionSecurityLabour = labourArray;
            ConstructionSecurity.ConstructionSecurityAttachment = AttachmentArray;

            if (ConstructionSecurity != null && ConstructionSecurity != undefined && ConstructionSecurity != "") {
                var ModelData = JSON.stringify(ConstructionSecurity);
                debugger;

                $('#SubmitConstructionSecurity').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({

                    url: `/api/ConstructionSecurity/AddNewConstructionSecurity`,
                    type: 'post',
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {
                        debugger;

                        $('#loader').fadeOut();
                        console.log(response);
                        if (response.code === 100) {

                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            $("#myModal").modal("hide");
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else {
                            debugger;
                            $('#SubmitConstructionSecurity').prop('disabled', false);
                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            })

                        }
                    }
                });

                // $('#SubmitConstructionSecurity').prop('disabled', false); //enable
            }
            else {
                $('#SubmitConstructionSecurity').prop('disabled', false);
                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "please fill the revelent fields");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'please fill the revelent fields',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            }

        }

    </script>

}
