@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#ConstrSec").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {

                    RegistrationNumber: {
                        required: true
                    },
                    PropertyNumber: {
                        required: true
                    },
                    ContractName: {
                        required: true
                    },
                    MobileNumber: {
                        required: true
                    },
                    ContractorCNIC: {
                        required: true,
                        minlength: 13,
                        maxlength: 13
                    },
                    Address: {
                        required: true
                    },
                    SurveyorName: {
                        required: true
                    },
                    SurveyorNumber: {
                        required: true
                    },
                    SurveyorCNIC: {
                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SubmitConstructionSecurity();
                }

            });
            GetAllPropertyLists();
        });


        function refreshPage() {
            location.reload();
        }


        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllConstructionSecurityFilterList",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        let date = (result_User.demarcationFileSubmitedDate).split('T')[0] ?? "";

                        $("#RegistrationNumber").val(result_User.registrationNo);
                        $("#ApprovalStatus").val(result_User.status);
                        $("#PropertyNumber").val(result_User.propertyNo);
                        $("#DemarcationDate").val(date);
                        $("#StockId").val(result_User.id);
                        PropertyDetail(result_User.id);
                        LoadApprovalHistory(result_User.id, 15);
                        ShowAlert(result_User.id);
                        $("#registrationModal").modal("hide");

                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function AddLabourRow() {


            var rownumber = parseInt($("#Lrownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#Lrownumber").val(rownumber);


            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input required name="LGActivities[' + rownumber + '].name" class="form-control name" /></td>' +
                '<td> <input type="number"  minlength="13" maxlength="13" name="LGActivities[' + rownumber + '].cnic" onkeypress="validateNumberInput(event)" class="form-control cnic" /></td>' +
                '<td> <input type="file"  class="form-control name="LGActivities[' + rownumber + '].cnicAttachment" cnicAttachment" /><input  class="form-control hide imagefile" /> </td>' +
                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +
                '<td> <input type="date" class="form-control gatePassValidity" /></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteLabourItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +

                '</tr>';


            $("#Labourtbody").append(row);


        }
        function DeleteLabourItemRow(id) {
            $('#L' + id).remove();

            var rownumber = 1;
            $("#Labourtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#Lrownumber").val(rownumber - 1);
        }

        function AddAttachmentRow() {


            var rownumber = parseInt($("#Arownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#Arownumber").val(rownumber);


            var row = '<tr id="A' + rownumber + '"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input type="file" required name="LGActivities[' + rownumber + '].attachmentPath" class="form-control attachmentPath" /><input  class="form-control hide imagefile" /></td>' +
                '<td> <input disabled class="form-control attachmentName" /></td>' +
                '<td> <input type="date" class="form-control attachmentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" disabled/></td>' +
                '<td> <textarea  class="form-control remarks" ></textarea></td>' +
                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachmentItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +

                '</tr>';


            $("#Attachmenttbody").append(row);


        }
        function DeleteAttachmentItemRow(id) {
            $('#A' + id).remove();
            var rownumber = 1;
            $("#Attachmenttbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#Arownumber").val(rownumber - 1);
        }

        //cnicAttachment
        $('body').on('change', '.cnicAttachment', UploadImageOnServer);
        $('body').on('change', '.attachmentPath', UploadImageOnServerforAttachmenttbody);

        function UploadImageOnServerforAttachmenttbody() {


            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg', 'pdf']) == -1) {
                // alert();
                //notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Sorry, invalid extension.',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {
                debugger;
                var file = row.parents('tr').find('input[type=file]').get(0).files[0];
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {
                        //$("#PreviewUrl").attr("src", reader.result);
                        //$("#PreviewUrl").attr("href", reader.result);
                        //$("#PreviewUrl").attr("target", "_blank");
                        row.parents('td').find('.imagefile').val(reader.result);
                        // $(this).parent("td").find("imagefile").val()
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('.attachmentPath').get(0).files[0];

                    }

                    reader.readAsDataURL(file);
                }
            }


        }


