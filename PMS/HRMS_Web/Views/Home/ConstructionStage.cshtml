                                            <th class="text-white" style="text-align: center;">Construction Stage</th>
                                            <th class="text-white" style="text-align: center;">Remarks</th>
                                            <th class="text-white" style="text-align: center;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyconstDef">
                                    </tbody>
                                </table>
                            </div>
                        </div>


