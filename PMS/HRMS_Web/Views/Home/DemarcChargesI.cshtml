                                        <tr>
                                            <th class="text-white">DocNo</th>
                                            <th class="text-white">Registration No.</th>
                                            <th class="text-white">Property No.</th>
                                            <th class="text-white">Member Code</th>
                                            <th class="text-white">Member Name</th>

                                            
                                            <th class="text-white">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="Demarcationtbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
              
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>



@section Scripts {




    <script type="text/javascript">


        $(document).ready(function () {
              GetPreviousDemarcations();
        });


        function GetPreviousDemarcations() {
        debugger;
        $.ajax({
            type: 'GET',
            url: `/api/DemarcationRequest/GetAllDemarcationLists`,
            dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
            contentType: 'application/json',
            success: function (response) {

                if (response.code === 0) {
                    debugger;
                     $("#Demarcationtbody").empty();
                    var relist = response.data;
                    if (relist != null && relist.length > 0) {
                        var sr = 1;
                        for (let list of relist) {
                            var row = ' <tr> ' +
                                ' <td>' + list.id + '</td> ' +
                               
                                ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                 ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                ' <td>' + list.memberCode + '</td>       ' +
                                ' <td>' + list.memberName + '</td>       ' +
                               '<td><a class="btn btn-primary" onclick="SelectDemarcation(' + list.id + ')">Select</a></td> </tr>';
                          
                            $("#Demarcationtbody").append(row);


                            sr++;

                        }
                    }

                    $('#Demarcationlist').dataTable();
                }
            }
        });


    }




    function SelectDemarcation(id){

         $.ajax({
        type: 'GET',
        url: `/api/DemarcationRequest/GetSingleDemarcation`,
        dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
        data: { id: id },
        async: false,
        contentType: 'application/json',
        success: function (response) {
        debugger;
       // var response = JSON.parse(result);
            if (response.code === 0) {
               // var result_User =JSON.stringify(response.data) ;
              var data= JSON.parse(response.data)
               
                 $("#ID").val(data.ID);
                 $("#RegistrationNo").val(data.RegistrationNo);
                 $("#PropertyNo").val(data.PropertyNo);
                 $("#MemberCode").val(data.MemberCode);
                 $("#MemberName").val(data.MemberName);

                   $.each(data.DemarcationRequestCharge, function (i, item) {
                               
                                    FillGrid(item);
                              
                               
                            });

                 $("#PrevModal").modal("hide");
            }

            else {

              //  window.alert(response.message);
                notification("topright","error","fa fa-exclamation-circle vd_red","Error",response.message);
            }
        }
    });
    }

    function FillGrid(obj){



         var row = ' <tr> ' +
                                ' <td class="DemarcationRequestChargeId"> ' + obj.Id + '</td> ' +
                               
                                ' <td class="chargeName">' + obj.chargeName + '</td>           ' +
                                 ' <td class="ammount">' + obj.Account + '</td>           ' +
                                ' <td>'+
                                '<select class="form-control status">'+
                                '<option>Allowed</option>'+
                                '<option>Not Allowed</option>'+
                                '</select></td>  </tr>';
                          
                            $("#DTbody").append(row);


    }

    function SaveDemarcationRequestForm()
    {
        var DemarcationRequestChargearr = new Array();
         


        $("#DTbody tr").each(function () {
                 var row = $(this);
                 var    DemarcationRequestCharge= new Object();
                 
                     DemarcationRequestCharge.ID=parseInt( row.find(".DemarcationRequestChargeId").text()) ,
                     DemarcationRequestCharge.chargeName=  row.find(".chargeName").text(),
                     DemarcationRequestCharge.Account= row.find(".account").text(),
                     DemarcationRequestCharge.Status= row.find(".status").val(),
                     DemarcationRequestCharge.DemarcationRequestId= parseInt($("#ID").val()),


                 DemarcationRequestChargearr.push(DemarcationRequestCharge);
             });
           
        var ModelData = JSON.stringify(DemarcationRequestChargearr);
        debugger;
        $.ajax({
            type:"POST",
            url:`/api/DemarcationRequest/updateStausOfStailTable`,
            contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
            processData: false,
            dataType: "json",
            async: false,
            data: ModelData,
            success: function(response)
            {
                if (response.code === 0)
                {
                        Swal.fire('Saved', response.message, 'success').then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                }
            }

        });
    }


    </script>


                }
