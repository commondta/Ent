<input id="rownumber" value="0" class="hide" />
<input id="StockCreationId" value="0" class="hide" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
<input type="number" class="hide" id="FindRequestAId" value="@ViewBag.Id" />


@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {

            "use strict";


            $("#Demarcationform").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {

                    RegistrationNo: {
                        //minlength: 3,
                        required: true
                    },
                    PropertyNo: {
                        //minlength: 3,
                        required: true
                    },
                    GacePeriod: {
                        //minlength: 3,
                        required: true
                    },
                },

                errorPlacement: function (error, element) {

                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else if (element.parent().parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Data',
                    })

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    //SaveMapApproval();
                }
            });



            GetAllPropertyLists();
            GetAllPropertyListsFindMode();
            var id = $("#FindRequestAId").val();
            if (id > 0) {
                SelectSinglePPS(id);
                if ($("#FindRequestAId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#Demarcationform :input").prop("disabled", true);

                }
            }
        });

        function refreshPage() {
            location.reload();
        }

        function AddRow() {


            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumber").val(rownumber);


            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <textarea required name="LGActivities[' + rownumber + '].remarks"  class="form-control remarks" ></textarea></td>' +
                '<td> <input required name="LGActivities[' + rownumber + '].targetPath" type="file" class="form-control targetPath" /><input  class="form-control CopyToTargetDocument hide" /></td>' +
                '<td  class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';


            $("#tbody").append(row);


        }


        function DeleteItemRow(id) {
            $('#' + id).remove();
            var rownumber = 1;
            $("#tbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumber").val(rownumber - 1);
        }

        // image from body
        $('body').on('change', '.targetPath', UploadImageOnServerforAttachmenttbody);

        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg','pdf']) == -1) {
                // alert();
                // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("warning", "Sorry, invalid extension.");
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('.viewAttachment a').simpleLightbox();
                        row.parents('tr').find('input[type=file]').get(0).files[0];
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        function updateDemarcationDate() {

            var date = $("#DemarcationDate").val();
            var stockId = $("#StockCreationId").val();

            $.ajax({
                type: 'GET',
                url: `/api/Demarcation/UpdateDemarcationDate`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: { date: date, stockId: stockId },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    } else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                    }
                }
            });
        }

        function GetAllPropertyListsFindMode() {
            $.ajax({
                type: 'GET',
                url: `/api/Demarcation/GetAllDemarcationFormFilterListFindMode`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#PropertytbodyFindMode").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                // format both for display and for input
                                const demarcationDateDisplay = moment(list.clientDemarmationDate).format('DD-MM-YYYY');
                                const demarcationDateValue = moment(list.clientDemarmationDate).format('YYYY-MM-DD');

                                var row = ' <tr> ' +
                                    ' <td class="stockId">' + list.id + '</td> ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td> ' +
                                    ' <td class="memberName">' + list.memberName + '</td> ' +
                                    ' <td class="memberCode">' + list.memberCode + '</td> ' +
                                    ' <td class="date">' + list.date + '</td> ' +
                                    // store ISO value in data attribute
                                    ' <td class="demarcationDate" data-value="' + demarcationDateValue + '">' + demarcationDateDisplay + '</td> ' +
                                    ' <td class="gacePeriod">' + (list.gracePeriodTime || 0) + '</td>' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(this)" >Select</a></td> </tr>';

                                $("#PropertytbodyFindMode").append(row);
                                sr++;
                            }
                        }

                        $('#proplistFindMode').dataTable();
                    }
                }
            });
        }




        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Demarcation/GetAllDemarcationFormFilterList`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                var row = ' <tr> ' +
                                    ' <td class="stockId">' + list.id + '</td> ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="memberName">' + list.memberName + '</td>       ' +
                                    ' <td class="memberCode">' + list.memberCode + '</td> ' +
                                    ' <td class="date">' + list.date + '</td> ' +
                                    '<td class="gacePeriod">' + (list.gracePeriodTime || 0) + '</td>' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(this)" >Select</a></td> </tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(el) {
            var $row = $(el).parents('tr');

            var stockCreationId = $row.find(".stockId").text();
            var id = $row.find(".stockId").text();
            var property = $row.find(".propertyNo").text();
            var Registration = $row.find(".registrationNo").text();
            var memberName = $row.find(".memberName").text();
            var memberCode = $row.find(".memberCode").text();
            var gacePeriod = $row.find(".gacePeriod").text();
            var DateofMapApproval = $row.find(".date").text();
            var demarcationDate = $row.find(".demarcationDate").data("value"); // get ISO value

            $(".stockId").val(id);
            $("#StockCreationId").val(stockCreationId);
            $("#RegistrationNo").val(Registration);
            $("#PropertyNo").val(property);
            $("#MemberName").val(memberName);
            $("#MemberCode").val(memberCode);
            $("#GacePeriod").val(gacePeriod);
            $("#DateofMapApproval").val(DateofMapApproval);
            $("#DemarcationDate").val(demarcationDate); // works for type="date"
            $("#registrationModal").modal("hide");
            $("#registrationModalFindMode").modal("hide");

            LoadApprovalHistory(id, 14);
            PropertyDetail(id);
            ShowAlert(id);
            LoadAttachedment(stockCreationId);
        }

        function SelectSinglePPS(id) {

            var url = "/api/Demarcation/GetId?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        var created = (result_User.createdOn).split('T')[0] ?? "N/A";
                        var clientDemarcationDate = (result_User.clientDemarmationDate).split('T')[0] ?? "N/A";

                        $("#StockCreationId").val(result_User.id);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MemberName").val(result_User.memberName);
                        $("#MemberCode").val(result_User.memberCode);
                        $("#GacePeriod").val(result_User.gracePeriodTime);
                        $("#DateofMapApproval").val(result_User.date);
                        $("#DemarcationDate").val(clientDemarcationDate);
                        $("#DueDate").val(created);
                        LoadApprovalHistory(result_User.id, 14);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                        LoadAttachedment(result_User.id);

                    }

                    else {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                        //window.alert(response.message);
                    }
                }
            });

        }

        function LoadAttachedment(id) {

            var url = "/api/Demarcation/GetByStocId?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#tbody").empty();

                        var relist = response.data.demarcationFormAttachments;
                        if (relist != null && relist.length > 0) {
                            $('#SubmitRequest').prop('disabled', true); //disble
                            var sr = 1;
                            for (let list of relist) {
                                let attachments = list.piture == "" ? "/img/placeholder-photo.svg" : list.piture;

                                var row = '<tr id="' + sr + '" DetailId="0"> ' +
                                    '<td> <input disabled class="form-control line" value="' + sr + '"/></td>' +
                                    '<td> <textarea required name="LGActivities[' + sr + '].remarks"  class="form-control remarks" value="' + list.remarks + '">' + list.remarks + '</textarea></td>' +
                                    '<td> <input  name="LGActivities[' + sr + '].targetPath" type="file" class="form-control targetPath" /><input  class="form-control CopyToTargetDocument hide"  value="' + attachments + '"  /></td>' +
                                    '<td  class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + getAttachmentIcon(attachments) + '" class="clickme" ></a></img></td>' +
                                    '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + sr + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                    '</tr>';

                                $("#tbody").append(row);
                                sr++;
                            }
                            let demarcationDate = (response.data.stockCreation.demarcationFileSubmitedDate).split('T')[0] ?? "";
                            var created = (response.data.createdOn).split('T')[0] ?? "";
                            $("#DemarcationDate").val(demarcationDate);
                            $("#DueDate").val(created);
                            $("#documentNo").val(response.data.id);
                        }
                    }
                }
            });
        }

        function getAttachmentIcon(url) {
            // Extract the extension
            let ext = url.split('.').pop().toLowerCase();

            // If image, return the original url
            if (['jpg', 'jpeg', 'png', 'gif'].includes(ext)) {
                return url;
            }

            // If PDF or Word, return icon path
            if (ext === 'pdf') return '/img/pdf-icon.png';
            if (ext === 'doc' || ext === 'docx') return '/img/word-icon.png';

            // Default icon for unknown file types
            return '/images/file-icon.png';
        }

        function SubmitDemarcationRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }



        function Submit() {
            var DemarcationDetailsarr = new Array();
            var Demarcation = new Object();
            Demarcation.StockCreationId = $("#StockCreationId").val();
            Demarcation.GraceMonth = $("#GacePeriod").val();
            Demarcation.ModifiedBy = $("#User_Id").val();
            Demarcation.CreatedBy = $("#User_Id").val();
            Demarcation.CreatedOn = $("#DueDate").val();
            Demarcation.LastModifiedUserName = $("#User_Name").val();



            $("#tbody tr").each(function () {
                var row = $(this);
                var DemarcationDetail = new Object();


                DemarcationDetail.Remarks = row.find(".remarks").val(),
                    DemarcationDetail.Piture = row.find(".CopyToTargetDocument").val(),
                    DemarcationDetailsarr.push(DemarcationDetail);
            });

            Demarcation.DemarcationFormAttachments = DemarcationDetailsarr;
            var ModelData = JSON.stringify(Demarcation);

            $('#SubmitRequest').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: "POST",
                url: `/api/Demarcation/AddNewDemarcation`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {


                    $('#loader').fadeOut();

                    if (response.code === 100) {
                        //Swal.fire('Saved', response.message, 'success')
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else if (response.code === 2) {
                        //notification("bottomleft", "warning", "fa fa-warning", "Warning", response.message);
                        $('#SubmitRequest').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                    }
                    else {
                        //notification("bottomleft", "error", "fa fa-error", "Error", response.message);
                        $('#SubmitRequest').prop('disabled', false);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }

            });

            // $('#SubmitRequest').prop('disabled', false); //enable
        }

