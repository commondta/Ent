        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg','pdf']) == -1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Sorry, invalid extension.',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {
                debugger;
                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".picture").val(file.name);
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        //row.parents('td').find('.picture').val(reader.result);
                        //row.parents('tr').find('input[type=file]').get(0).files[0];

                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('.viewAttachment a').simpleLightbox();
                        row.parents('tr').find('input[type=file]').get(0).files[0];

                    }

                    reader.readAsDataURL(file);
                }
            }
        }
