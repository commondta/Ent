        function GetDemarcationById(id) {

            var url = "/api/DemarcationRequest/Get?id=" + id + "";
            var branch = 1; //$("#branch").val();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id, branch: branch },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#SubmitprintVoucherDiv").hide();
                        $("#printVoucherDiv").show();

                        var result_User = response.data;
                        $("#MemberCode").val(result_User.memberCode);
                        $("#MemberName").val(result_User.memberName);
                        $("#CNIC").val(result_User.memberCnic);
                        $("#Address").val(result_User.address);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phase);
                        $("#Block").val(result_User.block);
                        $("#Type").val(result_User.type);
                        $("#Category").val(result_User.category);
                        $("#Nature").val(result_User.nature);
                        $("#Size").val(result_User.area);
                        $("#printId").val(result_User.id);
                        PropertyDetail(id);
                        ShowAlert(id);
                        $("#SearchPropertyModalDemarcationRequestFindMode").modal("hide");


                        $("#tbodyCharge").empty();
                        var rownumber = 1;
                        $.each(result_User.charges, function (i, item) {

                            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                '<td> <input  class="form-control chargeName" disabled  value="' + item.chargeName + '" /></td>' +
                                '<td> <input  class="form-control rate" style="text-align: right;"  value="' + formatPKR(item.amount) + '" /></td>' +
                                '</tr>';
                            $("#tbodyCharge").append(row)


                            rownumber++;
                        });
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function GetDemarcationPrintById() {

            let id = $("#printId").val();
            var branch = 1;//$("#branch").val();

            var url = "/api/DemarcationRequest/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id, branch: branch },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {


                        var result_User = response.data;

                        $(".challanNo").text(result_User.challanNo);
                        $(".paymentMode").text("Cash");
                        $(".registrationNo").text(result_User.registrationNo);
                        $(".buyerName").text(result_User.memberName);
                        $(".blockName").text(result_User.block);
                        $(".propertyNo").text(result_User.propertyNo);
                        $(".plotType").text(result_User.type);
                        $(".plotSize").text(result_User.unitArea);
                        $(".actualSize").text(result_User.area);
                        $(".department").text("-TPBC");
                        $(".tbodyinvoice").empty();

                        var rownumber = 1;
                        var amounttotal = 0;
                        $.each(result_User.charges, function (i, item) {

                            var row = '<tr style="font-size: 11px" id="' + rownumber + '" DetailId="0"> ' +
                                '<td style="text-align:center">' + rownumber + '</td>' +
                                '<td style="padding-left:8px;">' + item.chargeName + '</td>' +
                                '<td style="text-align:right;padding-right:4px;">' + item.amount + '</td>' +
                                '</tr>';
                            $(".tbodyinvoice").append(row);
                            amounttotal = amounttotal + item.amount;
                            rownumber++;
                        });
                        $(".invoicetotal").text(amounttotal);
                        var amountinwords = numberToWords(amounttotal);
                        $(".amountinwords").text(amountinwords);
                        printInvoice();
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function SelectRegistration(id) {
            $('#tbodyCharge').empty();
            var realEstateId = id;
            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";


            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        $("#MemberCode").val(result_User.memberProfile.id);
                        $("#MemberName").val(result_User.memberProfile.memberName);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#Address").val(result_User.memberProfile.cityOfResidence);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phaseName);
                        $("#Block").val(result_User.blockName);
                        $("#Project").val(result_User.projectName);
                        $("#Type").val(result_User.typeName);
                        $("#Category").val(result_User.categoryName);
                        $("#Floor").val(result_User.floor);
                        $("#Nature").val(result_User.natureName);
                        $("#StockCreationId").val(result_User.id);
                        $("#Size").val(result_User.actualSize);
                        PropertyDetail(id);
                        ShowAlert(id);
                        $("#registrationModal").modal("hide");
                        $("#registrationModalFindMode").modal("hide");



                        var obj = new Object();
                        obj.RealStateTypeId = result_User.realStateType;
                        obj.ProjectId = result_User.project;
                        obj.PhaseId = result_User.phase;
                        obj.BlockId = result_User.block;
                        obj.CategoryId = result_User.category;
                        obj.PropertyTypeId = result_User.type;
                        obj.NatureId = result_User.nature;
                        obj.Size = result_User.actualSize ?? 0;
                        obj.Redesign = $("#RedesignRequest").val();

                        getchargesdata(obj);


                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function SelectRedesign(id) {
            $('#tbodyCharge').empty();
            var realEstateId = id;
            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        $("#ReDesignRequestId").val(result_User.id);
                        $("#RedesignRequest").val("Yes");
                        $("#MemberCode").val(result_User.memberProfile.id);
                        $("#MemberName").val(result_User.memberProfile.memberName);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#Address").val(result_User.memberProfile.cityOfResidence);
