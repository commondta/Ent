        function getchargesdata(obj) {
            $('#tbodyCharge').empty();
            var ModelData = JSON.stringify(obj);

            $.ajax({
                type: "POST",
                url: `/api/GlobalChargesSetup/GetGlobalChargeDetailForDemarcation/?formId=1`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {

                    if (response.code == 100) {
                        if (response.data != null) {
                            var rownumber = 1;

                            $.each(response.data.globalChargeDetail, function (i, item) {
                                if (item.status == true) {
                                    var status = '<input type="checkbox" class="form-control status" checked disabled/>';
                                }
                                else {
                                    var status = '<input type="checkbox" class="form-control status" />';
                                }
                                var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                    '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                    '<td class="hide"> <input  class="form-control chargeSetUpId" disabled  value="' + item.globalChargeSetupId + '" /></td>' +
                                    '<td class="hide"> <input  class="form-control chargeId" disabled  value="' + item.id + '" /></td>' +
                                    '<td> <input  class="form-control chargeName" disabled  value="' + item.description + '" /></td>' +
                                    '<td class="hide"> <input  class="form-control chargeTypeId" disabled  value="' + item.chargeType + '" /></td>' +
                                    '<td> <input  class="form-control rate" style="text-align: right;"  value="' + formatPKR(item.rate) + '" /></td>' +
                                    '</tr>';
                                $("#tbodyCharge").append(row);
                                rownumber++;
                            });
                        }
                        else {
                            Swal.fire(
                                'Error!',
                                'Charge Detail Not Found',
                                'error'
                            )
                        }
                    }
                }

            });
        }


        function SaveDemarcationRequestForm() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }



        function Submit() {

            if ($("#StockCreationId").val() != "") {

                var DemarcationRequest = new Object();
                var DemarcationRequestDetailArr = new Array();

                var stockId = $("#StockCreationId").val();

                DemarcationRequest.StockCreationId = parseFloat($("#StockCreationId").val());
                DemarcationRequest.RedesignRequest = $("#RedesignRequest").val();
                DemarcationRequest.ModifiedBy = $("#User_Id").val();
                DemarcationRequest.CreatedBy = $("#User_Id").val();
                DemarcationRequest.CreatedOn = $("#DueDate").val();
                DemarcationRequest.LastModifiedUserName = $("#User_Name").val();

                $('#tbodyCharge tr').each(function () {

                    var row = $(this);
                    var DemarcationRequestDetail = new Object();
                    DemarcationRequestDetail.ChargeID = row.find('.chargeId').val() == null ? 0 : parseInt(row.find('.chargeId').val());
                    DemarcationRequestDetail.ChargeSetUpId = row.find('.chargeSetUpId').val() == null ? 0 : parseInt(row.find('.chargeSetUpId').val());;
                    DemarcationRequestDetail.ChargeName = row.find('.chargeName').val();
                    DemarcationRequestDetail.ChargeTypeId = row.find('.chargeTypeId').val();
                    DemarcationRequestDetail.Rate = parseFloat(row.find('.rate').val().replace(/,/g, '')) == null ? 0 : parseFloat(row.find('.rate').val().replace(/,/g, ''));
                    DemarcationRequestDetail.ModifiedBy = $("#User_Id").val();
                    DemarcationRequestDetail.CreatedBy = $("#User_Id").val();
                    DemarcationRequestDetail.LastModifiedUserName = $("#User_Name").val();

                    DemarcationRequestDetailArr.push(DemarcationRequestDetail);
                });


                DemarcationRequest.NewDemarcationRequestDetail = DemarcationRequestDetailArr;


                var ModelData = JSON.stringify(DemarcationRequest);


                $('#SaveDemarcationRequestForm').prop('disabled', true); //disble
                $('#loader').fadeIn();
                NProgress.start();
                NProgress.set(0.0);
                $.ajax({
                    type: "POST",
                    url: `/api/DemarcationRequest/AddNewDemarcationRequest`,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    dataType: "json",
                    data: ModelData,
                    success: function (response) {
                        if (response.code == 100) {
                            $('#loader').fadeOut();
                            NProgress.done();
                            $("#printId").val(response.data);
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    $('#SaveDemarcationRequestForm').prop('disabled', true);
                                    GetDemarcationPrintById();
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else {
                            $('#loader').fadeOut();
                            NProgress.done();
                            $('#SaveDemarcationRequestForm').prop('disabled', false);
                            Swal.fire({
                                icon: 'warning',
                                title: 'warning',
                                text: response.message,
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                        }
                    }

                });
                // $('#SaveDemarcationRequestForm').prop('disabled', false); //enable
            }
            else {
                $('#SaveDemarcationRequestForm').prop('disabled', false);
                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Please Select Property or check charge setup");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Please Select Property or check charge setup',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            }
        }
        function numberToWords(number) {
            var digit = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
            var elevenSeries = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
            var countingByTens = ['twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
            var shortScale = ['', 'thousand', 'million', 'billion', 'trillion'];

            number = number.toString(); number = number.replace(/[\, ]/g, ''); if (number != parseFloat(number)) return 'not a number'; var x = number.indexOf('.'); if (x == -1) x = number.length; if (x > 15) return 'too big'; var n = number.split(''); var str = ''; var sk = 0; for (var i = 0; i < x; i++) { if ((x - i) % 3 == 2) { if (n[i] == '1') { str += elevenSeries[Number(n[i + 1])] + ' '; i++; sk = 1; } else if (n[i] != 0) { str += countingByTens[n[i] - 2] + ' '; sk = 1; } } else if (n[i] != 0) { str += digit[n[i]] + ' '; if ((x - i) % 3 == 0) str += 'hundred '; sk = 1; } if ((x - i) % 3 == 1) { if (sk) str += shortScale[(x - i - 1) / 3] + ' '; sk = 0; } } if (x != number.length) { var y = number.length; str += 'point '; for (var i = x + 1; i < y; i++) str += digit[n[i]] + ' '; } str = str.replace(/\number+/g, ' '); return str.trim() + ".";

        }

        function printInvoice() {
            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }
