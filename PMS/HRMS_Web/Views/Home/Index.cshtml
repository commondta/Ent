<script>
    var map;
    var mapInitialized = false;
    var domainCharts = {};
    var entColors = ['#1e3a8a', '#c2410c', '#0f766e', '#6d28d9', '#be123c', '#0369a1', '#a16207', '#4338ca'];
    var typeColors = ['#0f766e', '#c2410c', '#6d28d9', '#be123c', '#4338ca'];

    $(document).ready(function () {

        // ---------- Domain breakdown tabs (delegated) ----------
        $(document).on('click', '.ent-tabs[data-domain] .ent-tab', function () {
            var $tabs = $(this).closest('.ent-tabs');
            var prefix = $tabs.data('domain');
            var tab = $(this).data('tab');
            $tabs.find('.ent-tab').removeClass('active');
            $(this).addClass('active');
            $('#' + prefix + '-blockTableWrap').toggle(tab === 'block');
            $('#' + prefix + '-typeTableWrap').toggle(tab === 'type');
            $('#' + prefix + '-categoryTableWrap').toggle(tab === 'category');
        });

        // ---------- Domain breakdown column sorting (delegated) ----------
        $(document).on('click', '.ent-table thead th[data-key]', function () {
            var $th = $(this);
            var $table = $th.closest('table');
            var id = $table.attr('id') || '';
            var m = id.match(/^(.+)-(block|type|category)Table$/);
            if (!m) return;
            var prefix = m[1], kind = m[2];
            var key = $th.data('key');
            var state = domainSort[prefix][kind];
            if (state.key === key) { state.dir = state.dir === 'asc' ? 'desc' : 'asc'; }
            else { state.key = key; state.dir = 'desc'; }
            updateSortIndicators($table, state);
            renderDomainTable(prefix, kind);
        });

        // ---------- View toggle (My Home / Dashboard / Map) ----------
        $('.ent-view-tab').click(function () {
            var view = $(this).data('view');
            $('.ent-view-tab').removeClass('active').attr('aria-selected', 'false');
            $(this).addClass('active').attr('aria-selected', 'true');
            $('.view-section').addClass('hide');
            $('#' + view + 'View').removeClass('hide');
            if (view === 'map') {
                if (!mapInitialized) {
                    initMap();
                }
                setTimeout(function () { if (map) map.invalidateSize(); }, 200);
            }
        });

        $('#mhOpenDashboard').click(function () {
            $('#viewTabDashboard').click();
        });

        // ---------- Main dashboard defaults + load ----------
        var currentDate = new Date();
        var firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
        var year = firstDayOfMonth.getFullYear();
        var month = ('0' + (firstDayOfMonth.getMonth() + 1)).slice(-2);
        var day = ('0' + firstDayOfMonth.getDate()).slice(-2);
        $('#mainStartDate').val(year + '-' + month + '-' + day);

        fetchMainDashboard();
        $('#mainApplyBtn').click(fetchMainDashboard);

        // ---------- My Home ----------
        loadMyHomeSummary();
        mhRenderLists();
        $(document).on('click', '.mh-star', function () {
            mhToggleFav($(this).data('u'), $(this).data('t'));
        });
    });

    // ---------- My Home: To-Dos summary ----------
    function loadMyHomeSummary() {
        var userId = $('#userid').val();
        if (!userId) return;
        fetchJson('/api/Workspace/GetMyHomeSummary?userId=' + userId).then(function (res) {
            if (!res.ok || !res.data) return;
            animateValue('mhAlerts', res.data.alerts || 0);
            animateValue('mhApprovals', res.data.pendingApprovals || 0);
            animateValue('mhActiveUsers', res.data.activeUsers || 0);
        });
    }

    /* ---------- My Home: Recent & Favourites ----------
       localStorage-backed foundation. The form registry (restructuring
       Phase 2) replaces the URL-derived names with real display names. */
    var MH_RECENT_KEY = 'pms_recent_forms';
    var MH_FAV_KEY = 'pms_fav_forms';

    function mhLoad(key) {
        try { return JSON.parse(localStorage.getItem(key)) || []; } catch (e) { return []; }
    }

    function mhSave(key, list) {
        try { localStorage.setItem(key, JSON.stringify(list)); } catch (e) { /* storage full/blocked */ }
    }

    function mhToggleFav(url, title) {
        if (!url) return;
        var favs = mhLoad(MH_FAV_KEY);
        var exists = favs.some(function (f) { return f.u === url; });
        if (exists) {
            favs = favs.filter(function (f) { return f.u !== url; });
        } else {
            favs.unshift({ u: url, t: title || url });
        }
        mhSave(MH_FAV_KEY, favs);
        mhRenderLists();
    }

    function mhRenderLists() {
        var favs = mhLoad(MH_FAV_KEY);
        var favMap = {};
        favs.forEach(function (f) { favMap[f.u] = true; });
        var recents = mhLoad(MH_RECENT_KEY).slice(0, 5);

        function itemHtml(entry, isFav) {
            var starLabel = (isFav ? 'Remove from favourites' : 'Add to favourites') + ': ' + entry.t;
            return '<li>' +
                '<a class="mh-item-link" href="' + escapeHtml(entry.u) + '">' + escapeHtml(entry.t) + '</a>' +
                '<button type="button" class="mh-star ' + (isFav ? 'on' : '') + '" title="' + escapeHtml(starLabel) + '" aria-label="' + escapeHtml(starLabel) + '" aria-pressed="' + (isFav ? 'true' : 'false') + '" ' +
                'data-u="' + escapeHtml(entry.u) + '" data-t="' + escapeHtml(entry.t) + '">&#9733;</button>' +
                '</li>';
        }

        var $recent = $('#mhRecentList');
        if ($recent.length) {
            $recent.html(recents.map(function (r) { return itemHtml(r, !!favMap[r.u]); }).join(''));
            $('#mhRecentEmpty').toggle(recents.length === 0);
        }

        var $fav = $('#mhFavList');
        if ($fav.length) {
            $fav.html(favs.map(function (f) { return itemHtml(f, true); }).join(''));
            $('#mhFavEmpty').toggle(favs.length === 0);
        }
    }

    function mirrorMyHomeDeltas() {
        ['kpiSalesDelta', 'kpiTransfersDelta', 'kpiNdcDelta'].forEach(function (id) {
            var $src = $('#' + id), $dst = $('#mh-' + id);
            if (!$src.length || !$dst.length) return;
            $dst.html($src.html());
            $dst.removeClass('up down flat');
            ['up', 'down', 'flat'].forEach(function (c) { if ($src.hasClass(c)) $dst.addClass(c); });
        });
    }

    function fetchJson(url) {
        return $.ajax({
            type: 'GET',
            url: url,
            headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
            dataType: "json",
            contentType: 'application/json'
        }).then(
            function (response) { return { ok: response.code === 100, data: response.data }; },
            function () { return { ok: false, data: null }; }
        );
    }

    function sumBy(list, key) {
        if (!list || !list.length) return 0;
        return list.reduce(function (total, item) { return total + (item[key] || 0); }, 0);
    }

    function animateValue(id, endValue) {
        // Mirror the final value onto the matching My Home tile, if present.
        var $mirror = $("#mh-" + id);
        if ($mirror.length) $mirror.text(endValue.toLocaleString());
        var $el = $("#" + id);
        if (!$el.length) return;
        var startValue = 0;
        var duration = 700;
        var startTime = null;
        function step(timestamp) {
            if (!startTime) startTime = timestamp;
            var progress = Math.min((timestamp - startTime) / duration, 1);
            var current = Math.floor(progress * (endValue - startValue) + startValue);
            $el.text(current.toLocaleString());
            if (progress < 1) window.requestAnimationFrame(step);
            else $el.text(endValue.toLocaleString());
        }
        window.requestAnimationFrame(step);
    }

    function showChartEmpty(containerId) {
        $("#" + containerId).html('<div class="ent-domain-empty">No data available</div>');
    }

    function setDomainStat(cardKey, text) {
        $("#stat-" + cardKey).text(text);
    }

    /* ===================================================================
       Per-domain Block/Type/Category breakdown: charts + sortable table.
       Parameterized by domain key so the same code drives every panel.
       Type columns follow N-Stack's 5-way split: Residential / Commercial /
       Villa / Farm House / Large Commercial.
       =================================================================== */
    var domainRows = {};
    var domainSort = {};

    function computeBreakdownRows(list) {
        return (list || []).map(function (item) {
            var residential = item.residentialCount || 0;
            var commercial = item.commercialCount || 0;
            var villa = item.villaCount || 0;
            var farmHouse = item.farmHouseCount || 0;
            var largeCommercial = item.largeComercialCount || 0;
            return {
                name: item.name,
                residential: residential,
                commercial: commercial,
                villa: villa,
                farmHouse: farmHouse,
                largeCommercial: largeCommercial,
                total: residential + commercial + villa + farmHouse + largeCommercial
            };
        });
    }

    function computeCategoryRows(list) {
        return (list || []).map(function (item) { return { name: item.name, count: item.count || 0 }; });
    }

    function sortRows(rows, key, dir) {
        var sorted = rows.slice().sort(function (a, b) {
            if (a[key] > b[key]) return 1;
            if (a[key] < b[key]) return -1;
            return 0;
        });
        if (dir === 'desc') sorted.reverse();
        return sorted;
    }

    function escapeHtml(str) {
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
        return String(str == null ? '' : str).replace(/[&<>"']/g, function (ch) { return map[ch]; });
    }

    function renderBreakdownTableBody(bodyId, rows, grandTotal) {
        var $body = $("#" + bodyId);
        if (!rows.length) { $body.html('<tr><td colspan="8" class="ent-empty-cell">No data available</td></tr>'); return; }
        var html = rows.map(function (r) {
            var share = grandTotal ? ((r.total / grandTotal) * 100).toFixed(1) : '0.0';
            return '<tr>' +
                '<td>' + escapeHtml(r.name) + '</td>' +
                '<td class="ent-num">' + r.residential.toLocaleString() + '</td>' +
                '<td class="ent-num">' + r.commercial.toLocaleString() + '</td>' +
                '<td class="ent-num">' + r.villa.toLocaleString() + '</td>' +
                '<td class="ent-num">' + r.farmHouse.toLocaleString() + '</td>' +
                '<td class="ent-num">' + r.largeCommercial.toLocaleString() + '</td>' +
                '<td class="ent-num ent-total-col">' + r.total.toLocaleString() + '</td>' +
                '<td><div class="ent-share-col"><div class="ent-share-bar"><div class="ent-share-fill" style="width:' + share + '%"></div></div><span class="ent-share-text">' + share + '%</span></div></td>' +
                '</tr>';
        }).join('');
        $body.html(html);
    }

    function renderBreakdownTableFoot(footId, rows) {
        var $foot = $("#" + footId);
        if (!rows.length) { $foot.html(''); return; }
        var totals = rows.reduce(function (acc, r) {
            acc.residential += r.residential; acc.commercial += r.commercial;
            acc.villa += r.villa; acc.farmHouse += r.farmHouse;
            acc.largeCommercial += r.largeCommercial; acc.total += r.total;
            return acc;
        }, { residential: 0, commercial: 0, villa: 0, farmHouse: 0, largeCommercial: 0, total: 0 });
        $foot.html(
            '<tr class="ent-total-row"><td>Total</td>' +
            '<td class="ent-num">' + totals.residential.toLocaleString() + '</td>' +
            '<td class="ent-num">' + totals.commercial.toLocaleString() + '</td>' +
            '<td class="ent-num">' + totals.villa.toLocaleString() + '</td>' +
            '<td class="ent-num">' + totals.farmHouse.toLocaleString() + '</td>' +
            '<td class="ent-num">' + totals.largeCommercial.toLocaleString() + '</td>' +
            '<td class="ent-num ent-total-col">' + totals.total.toLocaleString() + '</td>' +
            '<td></td></tr>'
        );
    }

    function renderCategoryTableBody(bodyId, rows, grandTotal) {
        var $body = $("#" + bodyId);
        if (!rows.length) { $body.html('<tr><td colspan="3" class="ent-empty-cell">No data available</td></tr>'); return; }
        var html = rows.map(function (r) {
            var share = grandTotal ? ((r.count / grandTotal) * 100).toFixed(1) : '0.0';
            return '<tr>' +
                '<td>' + escapeHtml(r.name) + '</td>' +
                '<td class="ent-num ent-total-col">' + r.count.toLocaleString() + '</td>' +
                '<td><div class="ent-share-col"><div class="ent-share-bar"><div class="ent-share-fill" style="width:' + share + '%"></div></div><span class="ent-share-text">' + share + '%</span></div></td>' +
                '</tr>';
        }).join('');
        $body.html(html);
    }

    function renderCategoryTableFoot(footId, rows) {
        var $foot = $("#" + footId);
        if (!rows.length) { $foot.html(''); return; }
        var total = rows.reduce(function (s, r) { return s + r.count; }, 0);
        $foot.html('<tr class="ent-total-row"><td>Total</td><td class="ent-num ent-total-col">' + total.toLocaleString() + '</td><td></td></tr>');
    }

    function updateSortIndicators($table, state) {
        $table.find("th[data-key]").removeClass("ent-sort-asc ent-sort-desc");
        $table.find('th[data-key="' + state.key + '"]').addClass(state.dir === "asc" ? "ent-sort-asc" : "ent-sort-desc");
    }

    function renderDomainTable(prefix, kind) {
        var rows = domainRows[prefix][kind];
        var state = domainSort[prefix][kind];
        var sorted = sortRows(rows, state.key, state.dir);
        if (kind === 'category') {
            var grandTotal = rows.reduce(function (s, r) { return s + r.count; }, 0);
            renderCategoryTableBody(prefix + '-categoryTableBody', sorted, grandTotal);
            renderCategoryTableFoot(prefix + '-categoryTableFoot', rows);
        } else {
            var grandTotalB = rows.reduce(function (s, r) { return s + r.total; }, 0);
            renderBreakdownTableBody(prefix + '-' + kind + 'TableBody', sorted, grandTotalB);
            renderBreakdownTableFoot(prefix + '-' + kind + 'TableFoot', rows);
        }
    }

    function renderDomainBlocksChart(prefix, blockRows) {
        var containerId = prefix + '-top-blocks-chart';
        var sorted = blockRows.slice().sort(function (a, b) { return b.total - a.total; }).slice(0, 6);
        if (!sorted.length) { showChartEmpty(containerId); return; }
        var options = {
            series: [{ name: 'Total', data: sorted.map(function (r) { return r.total; }) }],
            chart: { type: 'bar', height: 210, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: '55%', distributed: true, dataLabels: { position: 'top' } } },
            colors: entColors,
            dataLabels: { enabled: true, offsetX: 14, style: { fontSize: '9.5px', colors: ['#334155'] } },
            xaxis: { categories: sorted.map(function (r) { return r.name; }), labels: { style: { fontSize: '9.5px' } } },
            grid: { borderColor: '#f1f5f9' },
            legend: { show: false },
            tooltip: { y: { formatter: function (val) { return val; } } }
        };
        if (domainCharts[containerId]) domainCharts[containerId].destroy();
        domainCharts[containerId] = new ApexCharts(document.querySelector("#" + containerId), options);
        domainCharts[containerId].render();
    }

    function renderDomainTypeChart(prefix, typeRows) {
        var containerId = prefix + '-type-chart';
        if (!typeRows.length) { showChartEmpty(containerId); return; }
        var options = {
            series: [
                { name: 'Residential', data: typeRows.map(function (r) { return r.residential; }) },
                { name: 'Commercial', data: typeRows.map(function (r) { return r.commercial; }) },
                { name: 'Villa', data: typeRows.map(function (r) { return r.villa; }) },
                { name: 'Farm House', data: typeRows.map(function (r) { return r.farmHouse; }) },
                { name: 'Large Commercial', data: typeRows.map(function (r) { return r.largeCommercial; }) }
            ],
            chart: { type: 'bar', height: 210, stacked: true, toolbar: { show: false } },
            plotOptions: { bar: { borderRadius: 3, columnWidth: '50%' } },
            colors: typeColors,
            xaxis: { categories: typeRows.map(function (r) { return r.name; }), labels: { style: { fontSize: '9px' }, rotate: -30, trim: true } },
            yaxis: { labels: { style: { fontSize: '10px' } } },
            grid: { borderColor: '#f1f5f9' },
            legend: { position: 'top', horizontalAlign: 'left', fontSize: '10px' },
            tooltip: { y: { formatter: function (val) { return val; } } },
            fill: { opacity: 1 }
        };
        if (domainCharts[containerId]) domainCharts[containerId].destroy();
        domainCharts[containerId] = new ApexCharts(document.querySelector("#" + containerId), options);
        domainCharts[containerId].render();
    }

    function setupDomainBreakdown(prefix, blockList, typeList, categoryList) {
        if (!$('#' + prefix + '-blockTable').length) return;

        domainRows[prefix] = {
            block: computeBreakdownRows(blockList),
            type: computeBreakdownRows(typeList),
            category: computeCategoryRows(categoryList)
        };
        domainSort[prefix] = {
            block: { key: 'total', dir: 'desc' },
            type: { key: 'total', dir: 'desc' },
            category: { key: 'count', dir: 'desc' }
        };

        try {
            updateSortIndicators($('#' + prefix + '-blockTable'), domainSort[prefix].block);
            updateSortIndicators($('#' + prefix + '-typeTable'), domainSort[prefix].type);
            updateSortIndicators($('#' + prefix + '-categoryTable'), domainSort[prefix].category);

            renderDomainTable(prefix, 'block');
            renderDomainTable(prefix, 'type');
            renderDomainTable(prefix, 'category');
        } catch (e) {
            console.error('Breakdown table render failed for ' + prefix, e);
        }

        try {
            renderDomainBlocksChart(prefix, domainRows[prefix].block);
            renderDomainTypeChart(prefix, domainRows[prefix].type);
        } catch (e) {
            console.error('Breakdown chart render failed for ' + prefix, e);
        }
    }

    function clearDomainBreakdown(prefix) {
        if (!$('#' + prefix + '-blockTable').length) return;
        showChartEmpty(prefix + '-top-blocks-chart');
        showChartEmpty(prefix + '-type-chart');
        renderBreakdownTableBody(prefix + '-blockTableBody', [], 0);
        renderBreakdownTableBody(prefix + '-typeTableBody', [], 0);
        renderCategoryTableBody(prefix + '-categoryTableBody', [], 0);
        $('#' + prefix + '-blockTableFoot, #' + prefix + '-typeTableFoot, #' + prefix + '-categoryTableFoot').html('');
    }

    function formatDateParam(d) {
        var y = d.getFullYear();
        var m = ('0' + (d.getMonth() + 1)).slice(-2);
        var day = ('0' + d.getDate()).slice(-2);
        return y + '-' + m + '-' + day;
    }

    function formatDateDisplay(str) {
        var d = new Date(str + 'T00:00:00');
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        return d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
    }

    function computePreviousPeriod(fromStr, toStr) {
        var from = new Date(fromStr + 'T00:00:00');
        var to = new Date(toStr + 'T00:00:00');
        var durationDays = Math.round((to - from) / 86400000) + 1;
        var prevTo = new Date(from);
        prevTo.setDate(prevTo.getDate() - 1);
        var prevFrom = new Date(prevTo);
        prevFrom.setDate(prevFrom.getDate() - (durationDays - 1));
        return { from: formatDateParam(prevFrom), to: formatDateParam(prevTo) };
    }

    function renderDeltaBadge(id, current, previous) {
        var $el = $("#" + id);
        if (!$el.length) return;
        if (previous == null) { $el.html('').removeClass('up down flat'); return; }

        if (previous === 0) {
            if (current === 0) {
                $el.html('<i class="fa fa-minus"></i> 0% vs prev').removeClass('up down').addClass('flat');
            } else {
                $el.html('<i class="fa fa-arrow-up"></i> New vs prev').removeClass('down flat').addClass('up');
            }
            return;
        }

        var pct = ((current - previous) / previous) * 100;
        var rounded = Math.abs(pct).toFixed(1);
        if (pct > 0.05) {
            $el.html('<i class="fa fa-arrow-up"></i> ' + rounded + '% vs prev').removeClass('down flat').addClass('up');
        } else if (pct < -0.05) {
            $el.html('<i class="fa fa-arrow-down"></i> ' + rounded + '% vs prev').removeClass('up flat').addClass('down');
        } else {
            $el.html('<i class="fa fa-minus"></i> 0% vs prev').removeClass('up down').addClass('flat');
        }
    }

    function combineMonthlyLists(listA, listB) {
        var map = {};
        var order = [];
        (listA || []).concat(listB || []).forEach(function (item) {
            if (!(item.month in map)) { map[item.month] = 0; order.push(item.month); }
            map[item.month] += (item.transferCount || 0);
        });
        return order.map(function (m) { return { month: m, transferCount: map[m] }; });
    }

    function dateRangeSpanDays() {
        var from = new Date($('#mainStartDate').val() + 'T00:00:00');
        var to = new Date($('#mainEndDate').val() + 'T00:00:00');
        return Math.round((to - from) / 86400000) + 1;
    }

    function renderCombinedTrendChart(salesList, transferList, ndcList, granularity) {
        var containerId = 'chart-combined-trend';
        if (!$('#' + containerId).length) return;

        var key = granularity === 'daily' ? 'date' : 'month';
        $('#combinedTrendTitle').text(granularity === 'daily' ? 'Combined Daily Activity Trend' : 'Combined Monthly Activity Trend');

        var keySet = {};
        var order = [];
        [salesList, transferList, ndcList].forEach(function (list) {
            (list || []).forEach(function (item) {
                if (!(item[key] in keySet)) { keySet[item[key]] = true; order.push(item[key]); }
            });
        });

        if (!order.length) { showChartEmpty(containerId); return; }

        // Each source list arrives pre-sorted from the API, but merging
        // Sales-then-Transfer-then-NDC sequentially (rather than
        // interleaving) breaks that order — so sort the merged key set
        // chronologically before charting.
        var monthAbbr = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        if (granularity === 'daily') {
            order.sort(function (a, b) {
                var pa = a.split('-'), pb = b.split('-');
                var ma = monthAbbr.indexOf(pa[1]), mb = monthAbbr.indexOf(pb[1]);
                if (ma !== mb) return ma - mb;
                return parseInt(pa[0], 10) - parseInt(pb[0], 10);
            });
        } else {
            order.sort(function (a, b) {
                var pa = a.split('-'), pb = b.split('-');
                var ya = parseInt(pa[1], 10), yb = parseInt(pb[1], 10);
                if (ya !== yb) return ya - yb;
                return parseInt(pa[0], 10) - parseInt(pb[0], 10);
            });
        }

        function toMap(list) {
            var m = {};
            (list || []).forEach(function (item) { m[item[key]] = item.transferCount || 0; });
            return m;
        }
        var salesMap = toMap(salesList), transferMap = toMap(transferList), ndcMap = toMap(ndcList);

        var series = [];
        if ($('#kpiSales').length) series.push({ name: 'Sales', data: order.map(function (m) { return salesMap[m] || 0; }) });
        if ($('#kpiTransfers').length) series.push({ name: 'Transfers', data: order.map(function (m) { return transferMap[m] || 0; }) });
        if ($('#kpiNdc').length) series.push({ name: 'NDC Requests', data: order.map(function (m) { return ndcMap[m] || 0; }) });

        if (!series.length) { showChartEmpty(containerId); return; }

        var options = {
            series: series,
            chart: { type: 'line', height: 250, toolbar: { show: false } },
            stroke: { width: 3, curve: 'smooth' },
            colors: ['#1e3a8a', '#c2410c', '#6d28d9'],
            markers: { size: granularity === 'daily' ? 2.5 : 4, strokeWidth: 2, strokeColors: '#fff' },
            xaxis: { categories: order, labels: { style: { fontSize: '9.5px' }, rotate: granularity === 'daily' ? -35 : 0, trim: true } },
            yaxis: { labels: { style: { fontSize: '10px' } } },
            grid: { borderColor: '#f1f5f9' },
            dataLabels: { enabled: false },
            tooltip: { shared: true, intersect: false, y: { formatter: function (val) { return val; } } },
            legend: { position: 'top', horizontalAlign: 'left', fontSize: '11px' }
        };

        if (domainCharts.combinedTrend) domainCharts.combinedTrend.destroy();
        domainCharts.combinedTrend = new ApexCharts(document.querySelector("#" + containerId), options);
        domainCharts.combinedTrend.render();
    }

    var mainFetchToken = 0;

    function setMainLoading(isLoading) {
        $('#mainApplyBtn').prop('disabled', isLoading);
        $('#dashboardView').toggleClass('ent-is-loading', isLoading);
    }

    function fetchMainDashboard() {
        var requestToken = ++mainFetchToken;

        var fromDate = $('#mainStartDate').val();
        var toDate = $('#mainEndDate').val();
        var prevPeriod = computePreviousPeriod(fromDate, toDate);
        $('#mainErrorBanner').hide();
        $('#mainCompareCaption').removeClass('show').html('');
        setMainLoading(true);

        var hasSales = $('#kpiSales').length > 0;
        var hasTransfers = $('#kpiTransfers').length > 0;
        var hasNdc = $('#kpiNdc').length > 0;
        var hasStock = $('#kpiStock').length > 0;
        var hasAlloted = $('#stat-alloted').length > 0;
        var hasAvailable = $('#stat-available').length > 0;
        var hasMembers = $('#kpiMembers').length > 0;
        var hasAdmin = $('#kpiDealers').length > 0;

        var noop = function () { return $.Deferred().resolve({ ok: false, data: null }).promise(); };

        var pSales = hasSales ? fetchJson(`/Home/api/Dashboard/GetSalesDashboardValues?fromDate=${fromDate}&toDate=${toDate}`) : noop();
        var pSalesPrev = hasSales ? fetchJson(`/Home/api/Dashboard/GetSalesDashboardValues?fromDate=${prevPeriod.from}&toDate=${prevPeriod.to}`) : noop();
        var pTransfer = hasTransfers ? fetchJson(`/Home/api/Dashboard/GetTransferDashboardValues?fromDate=${fromDate}&toDate=${toDate}`) : noop();
        var pTransferPrev = hasTransfers ? fetchJson(`/Home/api/Dashboard/GetTransferDashboardValues?fromDate=${prevPeriod.from}&toDate=${prevPeriod.to}`) : noop();
        var pNdc = hasNdc ? fetchJson(`/Home/api/Dashboard/GetNDCDashboardValues?fromDate=${fromDate}&toDate=${toDate}&requestType=all`) : noop();
        var pNdcPrev = hasNdc ? fetchJson(`/Home/api/Dashboard/GetNDCDashboardValues?fromDate=${prevPeriod.from}&toDate=${prevPeriod.to}&requestType=all`) : noop();
        var pStock = (hasStock || hasAdmin) ? fetchJson(`/Home/api/Dashboard/GetCardsValues?project=all`) : noop();
        var pAlloted = hasAlloted ? fetchJson(`/Home/api/Dashboard/GetAllotedInventory?project=all`) : noop();
        var pAvailable = hasAvailable ? fetchJson(`/Home/api/Dashboard/GetAvailableInventory?project=all`) : noop();
        var pMember = hasMembers ? fetchJson(`/Home/api/Dashboard/GetMemberDashboardValues`) : noop();

        $.when(pSales, pSalesPrev, pTransfer, pTransferPrev, pNdc, pNdcPrev, pStock, pAlloted, pAvailable, pMember).done(
            function (sales, salesPrev, transfer, transferPrev, ndc, ndcPrev, stock, alloted, available, member) {

                if (requestToken !== mainFetchToken) return;
                setMainLoading(false);

                var anyFailed = false;
                var anyComparisonAvailable = false;

                if (hasSales) {
                    if (sales.ok) {
                        var salesTotal = sumBy(sales.data.typeWisePieChartDTO, 'count');
                        animateValue('kpiSales', salesTotal);
                        var res = sumBy(sales.data.blockWiseData, 'residentialCount');
                        var com = sumBy(sales.data.blockWiseData, 'commercialCount');
                        setDomainStat('sales', res + ' Residential · ' + com + ' Commercial');
                        setupDomainBreakdown('sales', sales.data.blockWiseData, sales.data.typeWiseStackedChartDTO, sales.data.sizeWisePieChartDTO);
                        if (salesPrev.ok) {
                            renderDeltaBadge('kpiSalesDelta', salesTotal, sumBy(salesPrev.data.typeWisePieChartDTO, 'count'));
                            anyComparisonAvailable = true;
                        } else {
                            renderDeltaBadge('kpiSalesDelta', salesTotal, null);
                        }
                    } else { anyFailed = true; clearDomainBreakdown('sales'); }
                }

                if (hasTransfers) {
                    if (transfer.ok) {
                        var transferTotal = sumBy(transfer.data.typeWisePieChartDTO, 'count');
                        animateValue('kpiTransfers', transferTotal);
                        var tRes = sumBy(transfer.data.blockWiseData, 'residentialCount');
                        var tCom = sumBy(transfer.data.blockWiseData, 'commercialCount');
                        setDomainStat('transfer', tRes + ' Residential · ' + tCom + ' Commercial');
                        setupDomainBreakdown('transfer', transfer.data.blockWiseData, transfer.data.typeWiseStackedChartDTO, transfer.data.sizeWisePieChartDTO);
                        if (transferPrev.ok) {
                            renderDeltaBadge('kpiTransfersDelta', transferTotal, sumBy(transferPrev.data.typeWisePieChartDTO, 'count'));
                            anyComparisonAvailable = true;
                        } else {
                            renderDeltaBadge('kpiTransfersDelta', transferTotal, null);
                        }
                    } else { anyFailed = true; clearDomainBreakdown('transfer'); }
                }

                if (hasNdc) {
                    if (ndc.ok) {
                        var ndcTotal = sumBy(ndc.data.typeWisePieChartDTO, 'count');
                        animateValue('kpiNdc', ndcTotal);
                        var nRes = sumBy(ndc.data.blockWiseData, 'residentialCount');
                        var nCom = sumBy(ndc.data.blockWiseData, 'commercialCount');
                        setDomainStat('ndc', nRes + ' Residential · ' + nCom + ' Commercial');
                        setupDomainBreakdown('ndc', ndc.data.blockWiseData, ndc.data.typeWiseStackedChartDTO, ndc.data.sizeWisePieChartDTO);
                        if (ndcPrev.ok) {
                            renderDeltaBadge('kpiNdcDelta', ndcTotal, sumBy(ndcPrev.data.typeWisePieChartDTO, 'count'));
                            anyComparisonAvailable = true;
                        } else {
                            renderDeltaBadge('kpiNdcDelta', ndcTotal, null);
                        }
                    } else { anyFailed = true; clearDomainBreakdown('ndc'); }
                }

                if (hasStock || hasAdmin) {
                    if (stock.ok) {
                        if (hasStock) {
                            animateValue('kpiStock', stock.data.totalStock || 0);
                            animateValue('kpiSold', stock.data.soldStock || 0);
                            animateValue('kpiAvailable', stock.data.availableStock || 0);
                            var blocks = (stock.data.blockWiseData || []).length;
                            setDomainStat('inventory', blocks + ' Block' + (blocks === 1 ? '' : 's') + ' Covered');
                            setupDomainBreakdown('inventory', stock.data.blockWiseData, stock.data.typeWiseStackedChartDTO, stock.data.sizeWisePieChartDTO);
                        }
                        if (hasAdmin) {
                            animateValue('kpiDealers', stock.data.totalDealers || 0);
                            animateValue('kpiSystemUsers', stock.data.totalPMSUsers || 0);
                        }
                    } else {
                        anyFailed = true;
                        if (hasStock) clearDomainBreakdown('inventory');
                    }
                }

                if (hasAlloted) {
                    if (alloted.ok) {
                        var aBlocks = (alloted.data.blockWiseData || []).length;
                        setDomainStat('alloted', (alloted.data.totalStock || 0) + ' Units · ' + aBlocks + ' Block' + (aBlocks === 1 ? '' : 's'));
                        setupDomainBreakdown('alloted', alloted.data.blockWiseData, alloted.data.typeWiseStackedChartDTO, alloted.data.sizeWisePieChartDTO);
                    } else { anyFailed = true; clearDomainBreakdown('alloted'); }
                }

                if (hasAvailable) {
                    if (available.ok) {
                        var vBlocks = (available.data.blockWiseData || []).length;
                        setDomainStat('available', (available.data.totalStock || 0) + ' Units · ' + vBlocks + ' Block' + (vBlocks === 1 ? '' : 's'));
                        setupDomainBreakdown('available', available.data.blockWiseData, available.data.typeWiseStackedChartDTO, available.data.sizeWisePieChartDTO);
                    } else { anyFailed = true; clearDomainBreakdown('available'); }
                }

                if (hasMembers) {
                    if (member.ok) {
                        animateValue('kpiMembers', sumBy(member.data.memberCityWiseData, 'count'));
                    } else { anyFailed = true; }
                }

                if (dateRangeSpanDays() <= 31) {
                    var combinedSalesDaily = (hasSales && sales.ok) ? sales.data.dailySalesData : [];
                    var combinedTransferDaily = (hasTransfers && transfer.ok) ? transfer.data.dailyTransferData : [];
                    var combinedNdcDaily = (hasNdc && ndc.ok) ? ndc.data.dailyTransferData : [];
                    renderCombinedTrendChart(combinedSalesDaily, combinedTransferDaily, combinedNdcDaily, 'daily');
                } else {
                    var combinedSalesMonthly = (hasSales && sales.ok) ? sales.data.monthlySalesData : [];
                    var combinedTransferMonthly = (hasTransfers && transfer.ok) ? transfer.data.monthlyTransferData : [];
                    var combinedNdcMonthly = (hasNdc && ndc.ok) ? ndc.data.monthlyTransferData : [];
                    renderCombinedTrendChart(combinedSalesMonthly, combinedTransferMonthly, combinedNdcMonthly, 'monthly');
                }

                if (anyComparisonAvailable) {
                    $('#mainCompareCaption').addClass('show').html(
                        '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m0-1A7 7 0 1 1 8 1a7 7 0 0 1 0 14"/></svg>' +
                        ' Comparing to previous period: ' + formatDateDisplay(prevPeriod.from) + ' – ' + formatDateDisplay(prevPeriod.to)
                    );
                }

                if (anyFailed) $('#mainErrorBanner').show();

                mirrorMyHomeDeltas();
            }
        );
    }

    // ---------- Map (lazy-initialized on first switch to Map view) ----------
    function initMap() {
        mapInitialized = true;

        map = L.map('map', {
            center: [29.3956, 71.6833], // Bahawalpur
            zoom: 14,
            zoomControl: true
        });

        L.tileLayer(
            'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
            {
                attribution: '© Esri, Maxar, Earthstar Geographics',
                maxZoom: 19
            }
        ).addTo(map);

        var markers = {};
        var bounds = L.latLngBounds([]);

        function normalize(val) {
            return val ? val.replace(/\s+/g, '').toUpperCase() : '';
        }

        function loadPlots() {
            $.ajax({
                url: '/api/SP/GetAllMapProperties',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    if (!data || data.length === 0) {
                        alert("⚠️ No properties found.");
                        return;
                    }

                    data.forEach(function (plot) {
                        const lat = parseFloat(plot.latitude);
                        const lng = parseFloat(plot.longitude);

                        if (isNaN(lat) || isNaN(lng)) return;

                        var marker = L.marker([lat, lng]).addTo(map);

                        var tooltipHtml = `
                            <strong>Plot No:</strong> ${plot.propertyNo ?? 'N/A'}<br>
                            <strong>Owner:</strong> ${plot.memberName ?? 'N/A'}<br>
                            <strong>Phase:</strong> ${plot.phase ?? 'N/A'}<br>
                            <strong>Block:</strong> ${plot.block ?? 'N/A'}<br>
                            <strong>Category:</strong> ${plot.category ?? 'N/A'}<br>
                            <strong>Status:</strong> ${plot.status ?? 'N/A'}<br>
                            <strong>Lat:</strong> ${lat}<br>
                            <strong>Lng:</strong> ${lng}
                        `;

                        marker.bindTooltip(tooltipHtml, {
                            direction: 'top',
                            sticky: true
                        });

                        if (plot.propertyNo) {
                            markers[normalize(plot.propertyNo)] = marker;
                        }

                        bounds.extend([lat, lng]);
                    });

                    if (bounds.isValid()) {
                        map.fitBounds(bounds, { padding: [40, 40] });
                    }

                    setTimeout(() => map.invalidateSize(), 300);
                },
                error: function (xhr, status, error) {
                    console.error("❌ AJAX Error:", xhr.responseText);
                    alert("Error loading map data.");
                }
            });
        }

        function searchPlot() {
            var key = normalize($("#searchPlot").val());
            var marker = markers[key];

            if (!marker) {
                alert("❌ Plot not found");
                return;
            }

            map.setView(marker.getLatLng(), 18, { animate: true });
            marker.openTooltip();

            var el = marker._icon;
            if (el) {
                el.classList.add('highlight');
                setTimeout(() => el.classList.remove('highlight'), 1500);
            }
        }

        $("#btnSearch").on("click", searchPlot);
        $("#searchPlot").on("keypress", function (e) {
            if (e.which === 13) searchPlot();
        });

        $("#btnReset").on("click", function () {
            $("#searchPlot").val('');
            map.setView([29.3956, 71.6833], 14);
        });

        $("#toggleFilterBtn").click(function () {
            $("#filterSection").toggleClass("hide");
        });

        $("#toggleMapBtn").click(function () {
            $("#mapContainer").toggleClass("hide");
            setTimeout(() => map.invalidateSize(), 300);
        });

        $("#mapContainer").removeClass("hide");

        loadPlots();
    }
</script>
