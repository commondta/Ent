@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .paddings {
        padding: 0 !important;
    }

    .ent-wrap * {
        box-sizing: border-box;
    }

    /* ---------- View toggle ---------- */
    .ent-view-toggle {
        display: inline-flex;
        gap: 2px;
        background: #eef1f7;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        padding: 3px;
        margin-bottom: 14px;
    }

    .ent-view-tab {
        font-family: inherit;
        font-size: 13px;
        font-weight: 650;
        color: #64748b;
        background: transparent;
        border: none;
        border-radius: 7px;
        padding: 8px 18px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background .15s ease, color .15s ease;
    }

    .ent-view-tab svg {
        opacity: .8;
    }

    .ent-view-tab:hover {
        color: #1e293b;
        background: rgba(30,58,138,0.08);
    }

    .ent-view-tab.active {
        background: #fff;
        color: #1e3a8a;
        box-shadow: 0 1px 3px rgba(16,21,31,.12);
    }

    .view-section.hide {
        display: none !important;
    }

    /* ---------- Toolbar / KPI ribbon ---------- */
    .ent-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 14px;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
    }

    .ent-toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ent-toolbar-title svg {
        color: #1e3a8a;
    }

    .ent-toolbar-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 10px;
    }

    .ent-field label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 4px;
    }

    .ent-input {
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        height: 34px;
        font-size: 13px;
    }

    .ent-btn {
        border: 1px solid #1e3a8a;
        border-radius: 4px;
        background: #1e3a8a;
        color: #fff;
        font-weight: 600;
        font-size: 13px;
        padding: 0 18px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: background .15s ease;
    }

    .ent-btn:hover {
        background: #16296b;
        color: #fff;
    }

    .ent-btn[disabled] {
        opacity: .65;
        cursor: not-allowed;
    }

    .ent-error-banner {
        display: none;
        margin-bottom: 14px;
        padding: 9px 14px;
        border-radius: 6px;
        border: 1px solid #f5c2c0;
        background: #fdecea;
        color: #b3261e;
        font-size: 13px;
        font-weight: 500;
    }

    .ent-compare-caption {
        display: none;
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 10px;
        align-items: center;
        gap: 6px;
    }

    .ent-compare-caption.show {
        display: flex;
    }

    .ent-compare-caption svg {
        color: #94a3b8;
        flex-shrink: 0;
    }

    .ent-kpi-delta {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 700;
        margin-top: 4px;
    }

    .ent-kpi-delta i {
        font-style: normal;
        font-weight: 600;
        color: #94a3b8;
    }

    .ent-kpi-delta.up { color: #059669; }
    .ent-kpi-delta.down { color: #dc2626; }
    .ent-kpi-delta.flat { color: #64748b; }

    .ent-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
    }

    .ent-panel-header {
        padding: 10px 16px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 12.5px;
        font-weight: 700;
        color: #1e293b;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .ent-kpi-ribbon {
        display: flex;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .ent-kpi-tile {
        flex: 1;
        min-width: 150px;
        padding: 12px 18px;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        position: relative;
    }

    .ent-kpi-tile:last-child {
        border-right: none;
    }

    .ent-kpi-tile::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
    }

    .ent-accent-blue::before { background: #1e3a8a; }
    .ent-accent-teal::before { background: #0f766e; }
    .ent-accent-orange::before { background: #c2410c; }
    .ent-accent-purple::before { background: #6d28d9; }
    .ent-accent-slate::before { background: #475569; }
    .ent-accent-rose::before { background: #be123c; }
    .ent-accent-indigo::before { background: #4338ca; }

    .ent-kpi-label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .ent-kpi-value {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Large per-domain breakdown panels ---------- */
    .ent-domain-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: 14px;
    }

    .ent-domain-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 16px;
        border-bottom: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .ent-domain-panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .ent-domain-icon {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        /* Black chip + white icon — theme instruction 2026-08-20 */
        background: #111111;
        color: #fff;
    }

    .ent-domain-panel-title .name {
        font-size: 14px;
        font-weight: 700;
        color: #1e293b;
    }

    .ent-domain-panel-stat {
        font-size: 11.5px;
        color: #64748b;
        font-weight: 600;
    }

    .ent-domain-panel-link {
        font-size: 12.5px;
        font-weight: 650;
        color: #1e3a8a;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .ent-domain-panel-link:hover {
        color: #1e3a8a;
        text-decoration: underline;
    }

    .ent-domain-charts-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        padding: 14px 16px;
        border-bottom: 1px solid #e2e8f0;
    }

    @@media (max-width: 767px) {
        .ent-domain-charts-row {
            grid-template-columns: 1fr;
        }
    }

    .ent-domain-chart-sm {
        min-height: 210px;
        position: relative;
    }

    .ent-domain-chart-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        margin-bottom: 6px;
    }

    .ent-domain-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 160px;
        color: #94a3b8;
        font-size: 12.5px;
    }

    .ent-table-wrap-pad {
        padding: 14px 16px 16px;
    }

    /* ---------- Sortable breakdown tables ---------- */
    .ent-tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 10px;
    }

    .ent-tab {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 4px;
        padding: 4px 12px;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #64748b;
        cursor: pointer;
    }

    .ent-tab.active {
        background: #eef2ff;
        color: #1e3a8a;
        border-color: #c7d2fe;
    }

    .ent-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
    }

    .ent-table thead th {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 8px 10px;
        text-align: left;
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #475569;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    .ent-table thead th.ent-num {
        text-align: right;
    }

    .ent-table thead th[data-key]::after {
        content: "";
        display: inline-block;
        width: 10px;
    }

    .ent-table thead th.ent-sort-asc::after {
        content: "\2191";
        color: #1e3a8a;
    }

    .ent-table thead th.ent-sort-desc::after {
        content: "\2193";
        color: #1e3a8a;
    }

    .ent-table tbody td {
        padding: 8px 10px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }

    .ent-table tbody tr:nth-child(even) {
        background: #fafbfc;
    }

    .ent-table tbody tr:hover {
        background: #f0f4ff;
    }

    .ent-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .ent-total-col {
        font-weight: 700;
        color: #0f172a;
    }

    .ent-total-row td {
        background: #f8fafc !important;
        font-weight: 700;
        border-top: 2px solid #e2e8f0;
    }

    .ent-share-col {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 110px;
    }

    .ent-share-bar {
        flex: 1;
        height: 6px;
        background: #e2e8f0;
        border-radius: 3px;
        overflow: hidden;
    }

    .ent-share-fill {
        height: 100%;
        background: #1e3a8a;
        border-radius: 3px;
    }

    .ent-share-text {
        font-size: 11px;
        color: #64748b;
        min-width: 34px;
        text-align: right;
    }

    .ent-empty-cell {
        text-align: center;
        padding: 30px;
        color: #94a3b8;
        font-size: 13px;
    }

    /* ---------- Map view styles ---------- */
    .filter-section {
        background: #ffffff;
        border-bottom: 1px solid #dee2e6;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

    .filter-body {
        margin-top: 10px;
    }

    #mapContainer {
        height: 600px;
        width: 100%;
        overflow-y: auto;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    #map {
        height: 600px;
        width: 100%;
    }

    .leaflet-tooltip {
        background-color: rgba(255, 255, 255, 0.95);
        color: #000;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 13px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    .highlight {
        animation: pulse 1s ease-out;
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.3); }
        100% { transform: scale(1); }
    }

    .toggle-buttons {
        display: flex;
        justify-content: end;
        margin-bottom: 10px;
        gap: 10px;
    }

    .hide {
        display: none !important;
    }

    #dashboardView {
        position: relative;
    }

    .ent-loading-overlay {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, .65);
        align-items: center;
        justify-content: center;
        z-index: 5;
        border-radius: 6px;
    }

    .ent-loading-overlay i {
        font-size: 24px;
        color: #1e3a8a;
    }

    #dashboardView.ent-is-loading .ent-loading-overlay {
        display: flex;
    }

    /* ---------- My Home (SAP Fiori-style workspace) ---------- */
    .mh-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .mh-span-full {
        grid-column: 1 / -1;
    }

    @@media (max-width: 900px) {
        .mh-grid { grid-template-columns: 1fr; }
    }

    .mh-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        box-shadow: 0 1px 3px rgba(16,21,31,.06);
        padding: 16px 18px;
        min-width: 0;
        transition: box-shadow .15s ease, transform .15s ease, border-color .15s ease;
    }

    .mh-card:hover {
        box-shadow: 0 6px 18px rgba(16,21,31,.12);
        transform: translateY(-2px);
        border-color: #cbd5e1;
    }

    .mh-kpi-tile {
        transition: border-color .15s ease, background .15s ease;
    }

    .mh-kpi-tile:hover {
        border-color: #cbd5e1;
        background: #f4f7fb;
    }

    .mh-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
    }

    .mh-card-title {
        font-size: 12px;
        font-weight: 700;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: .08em;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .mh-card-title svg { color: #1e293b; opacity: .75; }

    .mh-card-link {
        font-size: 12px;
        font-weight: 600;
        color: #1e3a8a;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
    }

    .mh-card-link:hover { text-decoration: underline; color: #1e3a8a; }

    .mh-kpi-row {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
    }

    /* Segmented KPI groups: one card, segments side by side, tiles in a row
       inside each; wraps to further rows when the card runs out of width */
    .mh-kpi-segments {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 18px;
    }

    .mh-kpi-seg {
        flex: 1 1 auto;
        min-width: 150px;
    }

    .mh-kpi-seg + .mh-kpi-seg {
        border-left: 1px solid #e2e8f0;
        padding-left: 18px;
    }

    .mh-kpi-seg-title {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 8px;
    }

    .mh-kpi-seg .mh-kpi-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .mh-kpi-seg .mh-kpi-tile {
        flex: 1 1 140px;
        min-width: 140px;
        max-width: 220px;
    }

    .mh-kpi-tile {
        border: 1px solid #eef1f7;
        border-left: 3px solid #1e293b;
        border-radius: 8px;
        background: #fafbfd;
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .mh-kpi-label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mh-kpi-value {
        font-size: 22px;
        font-weight: 750;
        color: #0f172a;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .mh-todo-count { font-variant-numeric: tabular-nums; }

    @@media (prefers-reduced-motion: reduce) {
        .mh-card, .mh-kpi-tile, .ent-view-tab, .mh-todo-chip, .mh-app-tile {
            transition: none !important;
        }

        .mh-card:hover { transform: none; }
    }

    .mh-kpi-delta { font-size: 10.5px; color: #94a3b8; }
    .mh-kpi-delta.up { color: #15803d; }
    .mh-kpi-delta.down { color: #b91c1c; }
    .mh-kpi-delta.flat { color: #94a3b8; }

    .mh-note {
        margin-top: 10px;
        font-size: 11px;
        color: #94a3b8;
        font-style: italic;
    }

    .mh-todo-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .mh-todo-chip {
        flex: 1 1 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        border: 1px solid #eef1f7;
        border-radius: 8px;
        background: #fafbfd;
        padding: 12px 10px;
        text-decoration: none;
        color: inherit;
        transition: border-color .15s ease, box-shadow .15s ease;
        min-width: 0;
    }

    a.mh-todo-chip:hover { border-color: #cbd5e1; box-shadow: 0 1px 4px rgba(16,21,31,.08); color: inherit; }

    .mh-todo-count { font-size: 24px; font-weight: 750; color: #0f172a; line-height: 1.1; }
    .mh-todo-label { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .05em; text-align: center; }

    .mh-apps-row {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: 10px;
    }

    .mh-app-tile {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fafbfd;
        padding: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: inherit;
        min-width: 0;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    a.mh-app-tile:hover { border-color: #94a3b8; box-shadow: 0 1px 4px rgba(16,21,31,.1); color: inherit; }

    .mh-app-tile.disabled { opacity: .55; cursor: default; }

    /* The solution you are in: ink outline, inset bar, live dot and a slow breathing ring
       (monochrome; the same treatment LIMS's My Home uses). */
    .mh-app-tile.is-current { border-color: #111111; box-shadow: inset 3px 0 0 #111111; background: #fff; animation: mhCurrentRing 2.6s ease-in-out infinite; }
    .mh-app-tile.is-current .mh-app-state { color: #111111; display: inline-flex; align-items: center; gap: 6px; }
    .mh-app-tile.is-current .mh-app-state::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #111111; box-shadow: 0 0 0 0 rgba(17,17,17,.35); animation: mhCurrentDot 1.8s ease-out infinite; }
    @@keyframes mhCurrentRing { 0%, 100% { box-shadow: inset 3px 0 0 #111111, 0 0 0 0 rgba(17,17,17,0); } 50% { box-shadow: inset 3px 0 0 #111111, 0 0 0 4px rgba(17,17,17,.08); } }
    @@keyframes mhCurrentDot { 0% { box-shadow: 0 0 0 0 rgba(17,17,17,.35); } 70% { box-shadow: 0 0 0 6px rgba(17,17,17,0); } 100% { box-shadow: 0 0 0 0 rgba(17,17,17,0); } }
    @@media (prefers-reduced-motion: reduce) { .mh-app-tile.is-current, .mh-app-tile.is-current .mh-app-state::before { animation: none; } }

    .mh-app-icon {
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #1e293b;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        letter-spacing: .03em;
    }

    .mh-app-icon img { width: 26px; height: 26px; display: block; object-fit: contain; }
    .mh-app-name { font-size: 12.5px; font-weight: 650; color: #1e293b; line-height: 1.3; }
    .mh-app-state { font-size: 10.5px; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }

    .mh-list { list-style: none; margin: 0; padding: 0; }

    .mh-list li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 7px 2px;
        border-bottom: 1px solid #f1f5f9;
        min-width: 0;
    }

    .mh-list li:last-child { border-bottom: none; }

    .mh-list a.mh-item-link {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    .mh-list a.mh-item-link:hover { color: #1e3a8a; }

    .mh-star {
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 15px;
        line-height: 1;
        color: #cbd5e1;
        padding: 2px 4px;
        flex: 0 0 auto;
    }

    .mh-star.on { color: #ca8a04; }
    .mh-star:hover { color: #ca8a04; }

    .mh-empty {
        font-size: 12px;
        color: #94a3b8;
        font-style: italic;
        padding: 8px 0;
    }
</style>

<div class="vd_content-wrapper ent-wrap">
    <div class="vd_container">
        <div class="vd_content clearfix">
            <div class="vd_content-section clearfix paddings">

                <!-- View Toggle -->
                <div class="ent-view-toggle" role="tablist" aria-label="Landing view">
                    <button type="button" class="ent-view-tab active" data-view="myhome" id="viewTabMyHome" role="tab" aria-selected="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-door" viewBox="0 0 16 16"><path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/></svg>
                        My Home
                    </button>
                    <button type="button" class="ent-view-tab" data-view="dashboard" id="viewTabDashboard" role="tab" aria-selected="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-speedometer2" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4M3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707M2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10m9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5m.754-4.246a.39.39 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.39.39 0 0 0-.029-.518z"/><path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A8 8 0 0 1 0 10m8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3"/></svg>
                        Dashboard
                    </button>
                    <button type="button" class="ent-view-tab" data-view="map" id="viewTabMap" role="tab" aria-selected="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-map" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15.817.113A.5.5 0 0 1 16 .5v14a.5.5 0 0 1-.402.49l-5 1a.5.5 0 0 1-.196 0L5.5 15.01l-4.902.98A.5.5 0 0 1 0 15.5v-14a.5.5 0 0 1 .402-.49l5-1a.5.5 0 0 1 .196 0L10.5.99l4.902-.98a.5.5 0 0 1 .415.103M10 1.91l-4-.8v12.98l4 .8zm1 12.98 4-.8V1.11l-4 .8zm-6-.8V1.11l-4 .8v12.98z"/></svg>
                        Map
                    </button>
                </div>

                <!-- ============ MY HOME VIEW (SAP Fiori-style workspace) ============ -->
                <div id="myhomeView" class="view-section">
                    <div class="mh-grid">

                        <!-- Overview Analytics -->
                        <div class="mh-card mh-span-full">
                            <div class="mh-card-head">
                                <span class="mh-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-bar-chart" viewBox="0 0 16 16"><path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm-6 3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/></svg>
                                    Overview Analytics
                                </span>
                                <a class="mh-card-link" id="mhOpenDashboard">Open full dashboard &rarr;</a>
                            </div>
                            @{
                                var pmSales = Html.UserHavePermission("Sales Dashboard");
                                var pmTransfer = Html.UserHavePermission("Transfer Dashboard");
                                var pmNdc = Html.UserHavePermission("NDC Dashboard");
                                var pmInventory = Html.UserHavePermission("Inventory Dashboard");
                                var pmMember = Html.UserHavePermission("Member Dashboard");
                                var pmDashboard = Html.UserHavePermission("Dashboard");
                                bool kpiSales = pmSales != null && pmSales.CanView;
                                bool kpiTransfer = pmTransfer != null && pmTransfer.CanView;
                                bool kpiNdc = pmNdc != null && pmNdc.CanView;
                                bool kpiInventory = pmInventory != null && pmInventory.CanView;
                                bool kpiMember = pmMember != null && pmMember.CanView;
                                bool kpiDashboard = pmDashboard != null && pmDashboard.CanView;
                            }
                            <div class="mh-kpi-segments">
                                @if (kpiSales || kpiTransfer || kpiNdc)
                                {
                                    <div class="mh-kpi-seg">
                                        <span class="mh-kpi-seg-title">Financial &amp; Operations</span>
                                        <div class="mh-kpi-row">
                                            @if (kpiSales)
                                            {
                                                <div class="mh-kpi-tile">
                                                    <span class="mh-kpi-label">Total Sales</span>
                                                    <span class="mh-kpi-value" id="mh-kpiSales">0</span>
                                                    <span class="mh-kpi-delta" id="mh-kpiSalesDelta"></span>
                                                </div>
                                            }
                                            @if (kpiTransfer)
                                            {
                                                <div class="mh-kpi-tile">
                                                    <span class="mh-kpi-label">Total Transfers</span>
                                                    <span class="mh-kpi-value" id="mh-kpiTransfers">0</span>
                                                    <span class="mh-kpi-delta" id="mh-kpiTransfersDelta"></span>
                                                </div>
                                            }
                                            @if (kpiNdc)
                                            {
                                                <div class="mh-kpi-tile">
                                                    <span class="mh-kpi-label">Total NDC Requests</span>
                                                    <span class="mh-kpi-value" id="mh-kpiNdc">0</span>
                                                    <span class="mh-kpi-delta" id="mh-kpiNdcDelta"></span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (kpiInventory)
                                {
                                    <div class="mh-kpi-seg">
                                        <span class="mh-kpi-seg-title">Inventory Overview</span>
                                        <div class="mh-kpi-row">
                                            <div class="mh-kpi-tile">
                                                <span class="mh-kpi-label">Total Stock</span>
                                                <span class="mh-kpi-value" id="mh-kpiStock">0</span>
                                            </div>
                                            <div class="mh-kpi-tile">
                                                <span class="mh-kpi-label">Sold / Registered</span>
                                                <span class="mh-kpi-value" id="mh-kpiSold">0</span>
                                            </div>
                                            <div class="mh-kpi-tile">
                                                <span class="mh-kpi-label">Available</span>
                                                <span class="mh-kpi-value" id="mh-kpiAvailable">0</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (kpiMember || kpiDashboard)
                                {
                                    <div class="mh-kpi-seg">
                                        <span class="mh-kpi-seg-title">Members &amp; Users</span>
                                        <div class="mh-kpi-row">
                                            @if (kpiMember)
                                            {
                                                <div class="mh-kpi-tile">
                                                    <span class="mh-kpi-label">Total Members</span>
                                                    <span class="mh-kpi-value" id="mh-kpiMembers">0</span>
                                                </div>
                                            }
                                            @if (kpiDashboard)
                                            {
                                                <div class="mh-kpi-tile">
                                                    <span class="mh-kpi-label">Total Dealers</span>
                                                    <span class="mh-kpi-value" id="mh-kpiDealers">0</span>
                                                </div>
                                                <div class="mh-kpi-tile">
                                                    <span class="mh-kpi-label">Total System Users</span>
                                                    <span class="mh-kpi-value" id="mh-kpiSystemUsers">0</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="mh-note">Figures follow the date filter on the Dashboard tab — current month by default.</div>
                        </div>

                        <!-- To-Dos -->
                        <div class="mh-card">
                            <div class="mh-card-head">
                                <span class="mh-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-check2-square" viewBox="0 0 16 16"><path d="M3 14.5A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5h8a.5.5 0 0 1 0 1H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5V8a.5.5 0 0 1 1 0v5a1.5 1.5 0 0 1-1.5 1.5z"/><path d="m8.354 10.354 7-7a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0"/></svg>
                                    To-Dos
                                </span>
                            </div>
                            <div class="mh-todo-row">
                                <a class="mh-todo-chip" href="/Notification/Index">
                                    <span class="mh-todo-count" id="mhAlerts">0</span>
                                    <span class="mh-todo-label">Alerts</span>
                                </a>
                                <a class="mh-todo-chip" href="/Approval/inbox">
                                    <span class="mh-todo-count" id="mhApprovals">0</span>
                                    <span class="mh-todo-label">Approvals</span>
                                </a>
                                <span class="mh-todo-chip">
                                    <span class="mh-todo-count" id="mhActiveUsers">0</span>
                                    <span class="mh-todo-label">Active Users</span>
                                </span>
                            </div>
                        </div>

                        <!-- APPS -->
                        <div class="mh-card">
                            <div class="mh-card-head">
                                <span class="mh-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-grid-3x3-gap" viewBox="0 0 16 16"><path d="M4 2v2H2V2zm1 12v-2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m5 10v-2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1M9 2v2H7V2zm5 0v2h-2V2zM4 7v2H2V7zm5 0v2H7V7zm5 0h-2v2h2zM4 12v2H2v-2zm5 0v2H7v-2zm5 0v2h-2v-2zM12 1a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm-1 6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zm1 4a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1z"/></svg>
                                    Apps
                                </span>
                            </div>
                            <div class="mh-apps-row">
                                @{
                                    // ERP platform: the applications this user may open come from the central
                                    // registry (cached at login as "erp_apps"); the appsettings list is only a fallback.
                                    var erpAppsJson = Context.Session.GetString("erp_apps");
                                    var erpApps = new List<HRMS_Web.Services.ErpPlatform.ErpApplication>();
                                    if (!string.IsNullOrEmpty(erpAppsJson)) { try { erpApps = Newtonsoft.Json.JsonConvert.DeserializeObject<List<HRMS_Web.Services.ErpPlatform.ErpApplication>>(erpAppsJson) ?? erpApps; } catch { } }
                                    var appRows = erpApps.Count > 0
                                        ? erpApps.Select(a => (Name: a.Name, Url: a.Code == "PMS" ? "/Home/Index" : "/Apps/Go?code=" + a.Code, Enabled: a.IsActive, Current: a.Code == "PMS", Code: a.Code)).ToList()
                                        : Configuration.GetSection("RealEstate:Apps").GetChildren().Select(app => (Name: app["Name"] ?? "", Url: app["Url"] ?? "", Enabled: string.Equals(app["Enabled"], "true", StringComparison.OrdinalIgnoreCase), Current: string.Equals(app["Current"], "true", StringComparison.OrdinalIgnoreCase), Code: "")).ToList();
                                }
                                @foreach (var row in appRows)
                                {
                                    var appName = row.Name;
                                    var appUrl = row.Url;
                                    var appEnabled = row.Enabled;
                                    var appCurrent = row.Current;
                                    var initials = string.Concat(appName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                                        .Where(w => char.IsUpper(w[0]))
                                                                        .Take(3)
                                                                        .Select(w => w[0]));
                                    // app mark on the tile (LIMS / Payroll parity); initials only for an unknown application
                                    var appIcon = row.Code == "PMS" ? "/img/brand/pms-icon-plain-white.svg"
                                                : row.Code == "LIMS" ? "/img/lims-logo-white.svg"
                                                : row.Code == "PAYROLL" ? (Configuration["Erp:PayrollPrefix"] ?? "/payroll") + "/Content/brand/payroll-mark-white.svg" : null;
                                    if (appEnabled && !appCurrent && !string.IsNullOrWhiteSpace(appUrl))
                                    {
                                        <a class="mh-app-tile" href="@appUrl">
                                            <span class="mh-app-icon">@if (appIcon != null) { <img src="@appIcon" alt="" /> } else { @initials }</span>
                                            <span>
                                                <span class="mh-app-name">@appName</span><br />
                                                <span class="mh-app-state">Open</span>
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="mh-app-tile @(appCurrent ? "is-current" : "disabled")" @(appCurrent ? Html.Raw("aria-current=\"true\"") : null)>
                                            <span class="mh-app-icon">@if (appIcon != null) { <img src="@appIcon" alt="" /> } else { @initials }</span>
                                            <span>
                                                <span class="mh-app-name">@appName</span><br />
                                                <span class="mh-app-state">@(appCurrent ? "Current" : "Coming soon")</span>
                                            </span>
                                        </span>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Recent -->
                        <div class="mh-card">
                            <div class="mh-card-head">
                                <span class="mh-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16"><path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z"/><path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z"/><path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5"/></svg>
                                    Recent
                                </span>
                            </div>
                            <ul class="mh-list" id="mhRecentList"></ul>
                            <div class="mh-empty" id="mhRecentEmpty">No recently opened forms yet — they will appear here as you work.</div>
                        </div>

                        <!-- Favourites -->
                        <div class="mh-card">
                            <div class="mh-card-head">
                                <span class="mh-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-star" viewBox="0 0 16 16"><path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z"/></svg>
                                    Favourites
                                </span>
                            </div>
                            <ul class="mh-list" id="mhFavList"></ul>
                            <div class="mh-empty" id="mhFavEmpty">No favourites yet — star a form in the Recent list to keep it here.</div>
                        </div>

                    </div>
                </div>
                <!-- ============ END MY HOME VIEW ============ -->

                <!-- ============ DASHBOARD VIEW ============ -->
                <div id="dashboardView" class="view-section hide">

                    <div class="ent-loading-overlay"><i class="fa fa-spinner fa-spin"></i></div>

                    <div class="ent-toolbar">
                        <div class="ent-toolbar-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-speedometer2" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4M3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707M2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10m9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5m.754-4.246a.39.39 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.39.39 0 0 0-.029-.518z"/><path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A8 8 0 0 1 0 10m8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3"/></svg>
                            Overview Dashboard
                        </div>
                        <div class="ent-toolbar-filters">
                            <div class="ent-field">
                                <label for="mainStartDate">Start Date</label>
                                <input type="date" id="mainStartDate" class="form-control ent-input">
                            </div>
                            <div class="ent-field">
                                <label for="mainEndDate">To Date</label>
                                <input type="date" id="mainEndDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control ent-input">
                            </div>
                            <button id="mainApplyBtn" class="ent-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/></svg>
                                <span>Apply</span>
                            </button>
                        </div>
                    </div>
                    <div class="ent-error-banner" id="mainErrorBanner">Some sections could not be loaded. Please try again.</div>
                    <div class="ent-compare-caption" id="mainCompareCaption"></div>

                    <div class="ent-kpi-ribbon" id="mainKpiRibbon">
                        @if (Html.UserHavePermission("Sales Dashboard") != null && Html.UserHavePermission("Sales Dashboard").CanView)
                        {
                            <div class="ent-kpi-tile ent-accent-blue">
                                <span class="ent-kpi-label">Total Sales</span>
                                <span class="ent-kpi-value" id="kpiSales">0</span>
                                <span class="ent-kpi-delta" id="kpiSalesDelta"></span>
                            </div>
                        }
                        @if (Html.UserHavePermission("Transfer Dashboard") != null && Html.UserHavePermission("Transfer Dashboard").CanView)
                        {
                            <div class="ent-kpi-tile ent-accent-orange">
                                <span class="ent-kpi-label">Total Transfers</span>
                                <span class="ent-kpi-value" id="kpiTransfers">0</span>
                                <span class="ent-kpi-delta" id="kpiTransfersDelta"></span>
                            </div>
                        }
                        @if (Html.UserHavePermission("NDC Dashboard") != null && Html.UserHavePermission("NDC Dashboard").CanView)
                        {
                            <div class="ent-kpi-tile ent-accent-purple">
                                <span class="ent-kpi-label">Total NDC Requests</span>
                                <span class="ent-kpi-value" id="kpiNdc">0</span>
                                <span class="ent-kpi-delta" id="kpiNdcDelta"></span>
                            </div>
                        }
                        @if (Html.UserHavePermission("Inventory Dashboard") != null && Html.UserHavePermission("Inventory Dashboard").CanView)
                        {
                            <div class="ent-kpi-tile ent-accent-teal">
                                <span class="ent-kpi-label">Total Stock</span>
                                <span class="ent-kpi-value" id="kpiStock">0</span>
                                <span class="ent-kpi-delta flat" id="kpiStockDelta"><i>Not date-filtered</i></span>
                            </div>
                            <div class="ent-kpi-tile ent-accent-teal">
                                <span class="ent-kpi-label">Sold / Registered</span>
                                <span class="ent-kpi-value" id="kpiSold">0</span>
                                <span class="ent-kpi-delta flat"><i>Not date-filtered</i></span>
                            </div>
                            <div class="ent-kpi-tile ent-accent-orange">
                                <span class="ent-kpi-label">Available</span>
                                <span class="ent-kpi-value" id="kpiAvailable">0</span>
