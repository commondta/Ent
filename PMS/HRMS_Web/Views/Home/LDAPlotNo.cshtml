@section Scripts
    {
    <script>


        $(document).ready(function () {
            "use strict";
            $("#ReSurrender").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {

                    LDAPlotNo: {
                        //minlength: 3,
                        required: true
                    },
                    RegNoA: {
                        //minlength: 3,
                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else if (element.parent().parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Data',
                    })

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }

            });


        });

        // Select A property
        function GetAllPropertiesListsA() {
            $.ajax({
                type: 'GET',
                url: `/api/LDAPlotNo/GetPropertiesForLDAPlotNo`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        propertyListsA = response.data;
                        processResponseA(propertyListsA);
                    }
                }
            });
        }

        function refreshPage() {
            location.reload();
        }

        function processResponseA(responseData) {
            $("#registrationtbodyA").empty();
            var relist = responseData;
            if (relist != null && relist.length > 0) {
                var sr = 1;
                for (let list of relist) {
                    var row = '<tr>' +
                        '<td>' + sr + '</td>' +
                        '<td>' + list.propertyNo + '</td>' +
                        '<td>' + list.registrationNo + '</td>' +
                        '<td><a class="btn btn-primary" onclick="SelectRegistrationA(' + list.id + ')">Select</a></td>' +
                        '</tr>';
                    $("#registrationtbodyA").append(row);
                    sr++;
                }
            }
            $('#registrationListA').dataTable();
        }

        function SelectRegistrationA(id) {

            var url = "/api/LDAPlotNo/GetFilterProperty?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;
                        // set values

                        $("#Id").val(result_User.id);
                        $("#RegNoA").val(result_User.registrationNo);
                        $("#PropertyNoA").val(result_User.propertyNo);
                        $("#SizeA").val(result_User.actualSize);
                        $("#CategoryA").val(result_User.categoryName);
                        $("#BlockA").val(result_User.blockName);
                        $("#PhaseA").val(result_User.phaseName);
                        $("#StockId").val(result_User.id);
                        $("#LDAPlotNo").val(result_User.ldaPlotNo);
                        $("#LDAAreaSize").val(result_User.ldaAreaSize);
                        $("#registrationModalA").modal("hide");
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() {
            var methodType = 'POST';
            var url = "/api/LDAPlotNo/SaveLDAPlotNoDTO";

            var ldaplot = new Object();

            ldaplot.StockId = $('#Id').val();
            ldaplot.LDAPlotNo = $('#LDAPlotNo').val();
            ldaplot.LDAAreaSize = $('#LDAAreaSize').val();

            var model = JSON.stringify(ldaplot);

            $('#PostRequest').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    debugger;
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                               // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $('#PostRequest').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
         //   $('#PostRequest').prop('disabled', false); //enable
        }
    </script>
 }

