                '<option value = "9"> Revised - Stage 4 (Working Drawings) </option>' +
                '</select></td>' +
                '<td><select required class="form-control ClientStatus" name="ClientStatus[' + rownumber + ']">' +
                '<option value="">Select Option</option>' +
                '<option value = "Yes"> Yes </option>' +
                '<option value = "No"> No </option>' +
                '</select></td>' +
                '<td> <input required disabled type="date"  class="form-control DateofFeedback" value="@DateTime.Now.ToString("yyyy-MM-dd")" name="LGActivities[' + rownumber + '].DateofFeedback" id="DateofFeedback' + rownumber + '" /></td>' +
