        function getAttachmentIcon(url) {
            // Extract the extension
            let ext = url.split('.').pop().toLowerCase();

            // If image, return the original url
            if (['jpg', 'jpeg', 'png', 'gif'].includes(ext)) {
                return url;
            }

            // If PDF or Word, return icon path
            if (ext === 'pdf') return '/img/pdf-icon.png';
            if (ext === 'doc' || ext === 'docx') return '/img/word-icon.png';

            // Default icon for unknown file types
            return '/images/file-icon.png';
        }


        function openFileInNewTab(fileData) {
            if (!fileData) return alert('No file data');

            // Check if it is a Base64 string (starts with data:)
            if (fileData.startsWith('data:')) {
                // Base64 handling
                const [meta, content] = fileData.split(',');

                if (!meta || !content) {
                    return alert('Invalid Base64 file data');
                }

                const byteCharacters = atob(content);
                const byteNumbers = new Array(byteCharacters.length);
                for (let i = 0; i < byteCharacters.length; i++) {
                    byteNumbers[i] = byteCharacters.charCodeAt(i);
                }
                const byteArray = new Uint8Array(byteNumbers);

                const mimeType = meta.split(':')[1].split(';')[0];
                const fileBlob = new Blob([byteArray], { type: mimeType });

                const fileURL = URL.createObjectURL(fileBlob);
                window.open(fileURL);

            } else if (fileData.startsWith('http')) {
                // URL handling
                window.open(fileData, '_blank');
            } else {
                alert('Invalid file data');
            }
        }




        function SaveMapApproval() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
