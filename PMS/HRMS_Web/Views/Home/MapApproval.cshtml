@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#MapApproval").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    // RegistrationNo: {
                    //     required: true
                    // },
                    PropertyNo: {
                        required: true
                    },
                    // CoveredArea: {
                    //     required: true
                    // },
                    // MappApproved: {
                    //     required: true
                    // },
                },

                errorPlacement: function (error, element) {

                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("form-control")) {
                        error.insertAfter(element);
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },
                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SaveMapApproval();
                }

            });
            GetAllPropertyLists();
            GetAllPropertyListsFindMode();
            GetAllBlocks();
            GetAllCategories();
            GetAllNatures();
            GetAllPhases();
            GetAllFinishing();
            GetAllRealEstate();
            GetAllProjects();
            GetAllFloor();
            GetAllTypes();

            var id = $("#MapAId").val();

            if (id > 0) {
                SelectRegistration(id);
                if ($("#MapAId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#MapApproval :input").prop("disabled", true);

                }
            }
        });

        function refreshPage() {
            location.reload();
        }




        function GetAllPropertyListsFindMode() {

            $.ajax({
                type: 'GET',
                url: `/api/MapApproval/GetAllMapApprovalFilterListFindMode`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Propertytbody1").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.blockName + '</td>       ' +
                                    ' <td>' + list.typeName + '</td>       ' +
                                    ' <td>' + list.realStateTypeName + '</td>       ' +
                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistrationFindMode(' + list.id + ', \'' + list.status + '\')">Select</a></td>';
                                //</tr>';
                                $("#Propertytbody1").append(row);

                                sr++;
                            }
                        }

                        $('#proplist1').dataTable();
                    }
                }
            });
        }

        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/MapApproval/GetAllMapApprovalFilterList`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td class="propertyNo">' + list.propertyNo + '</td>' +
                                    '<td class="registrationNo">' + list.registrationNo + '</td>' +
                                    '<td>' + list.blockName + '</td>' +
                                    '<td>' + list.typeName + '</td>' +
                                    '<td>' + list.realStateTypeName + '</td>' +
                                    '<td>' + list.status + '</td>' +
                                    '<td>' + list.lastModifiedUser + '</td>' +
                                    '<td>';
                                if (list.requestId != null) {
                                    row += '<a class="fa fa-print fa-2x" onclick="PrintFileRecieving(' + list.requestId + ')"></a> ';
                                }
                                row += '<a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a>' +
                                    '</td>' +
                                    '</tr>';

                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }


                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(id) {

            var url = "/api/StockCreation/GetSingleStock?stock=" + id + "";


            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        debugger;

                        var result_User = response.data;
                        // set values
                        let clearanceDate = (result_User.clearanceOn).split('T')[0] ?? "N/A";
                        $("#MemberName").val(result_User.memberProfile.memberName);
                        $("#MemberCode").val(result_User.memberProfile.id);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#ID").val(result_User.id);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phase);
                        $("#Phase").trigger("change");
                        $("#Block").val(result_User.block);
                        $("#Block").trigger("change");
                        $("#Project").val(result_User.project);
                        $("#Project").trigger("change");
                        $("#Type").val(result_User.type);
                        $("#Type").trigger("change");
                        $("#Category").val(result_User.category);
                        $("#Category").trigger("change");
                        $("#Floor").val(result_User.floor);
                        $("#Floor").trigger("change");
                        $("#Nature").val(result_User.nature);
                        $("#Nature").trigger("change");
                        $("#StockCreationId").val(result_User.id);
                        $("#CoveredArea").val(result_User.coveredArea);
                        $("#Finishing").val(result_User.finishing);
                        $("#Finishing").trigger("change");
                        $("#RealStateType").val(result_User.realStateType);
                        $("#RealStateType").trigger("change");
                        $("#ClearanceDate").val(clearanceDate);
                        $("#FindMode").val("No");

