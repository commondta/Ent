            $("#Correspondencetbody").append(row);
        }

        $('body').on('change', '.attachmentPath', imageuploading);


        function imageuploading() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg', 'pdf']) == -1) {
                // alert();
                notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".attachments").val(file.name);
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {

                        row.parents('td').find('.attachments').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);

                        row.parents('tr').find('.attachmentPath').get(0).files[0];
                        row.parents('tr').find('.viewAttachment a').simpleLightbox();

                    }
                    reader.readAsDataURL(file);
                }
            }
        }
        function DeleteRow(id) {
            $('#L' + id).remove();

            var rownumber = 1;
            $("#Correspondencetbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumber").val(rownumber - 1);
        }


        function PrintFileRecieving(id) {

            var methodType = 'GET';
            var url = "/api/FileVerification/GetClientFilebyId?Id=" + id + "";
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {
                    var printdata = response;

                    let memberImage = printdata.image == null ? "/img/placeholder-photo.svg" : printdata.image;

                    $("#PreviewUrl1").attr("src", memberImage);
                    $("#PropNo").text(printdata.propertyNo);
                    $("#RegNo").text(printdata.registrationNo);
                    $("#PropSize").text(printdata.area + " " + printdata.unitArea);
                    $("#PNature").text(printdata.nature);
                    $("#pFloor").text(printdata.floor);
                    $("#pBlock").text(printdata.block);
                    $("#pType").text(printdata.type);
                    $("#MemName").text(printdata.memberName);
                    $("#sdw").text(printdata.relationshipWith);
                    $("#MCnic").text(printdata.cnic);
                    $("#RecName").text(printdata.receivedBy);
                    $("#RecMob").text(printdata.recieverMobile);
                    $("#RecSDW").text(printdata.recieverFatherName);
                    // $("#RecDate").text(printdata.docDate);
                    $("#RecDate").text(printdata.docDate.split("T")[0]);
                    $("#RecCnic").text(printdata.recieverCNIC);
                    $("#reqtype").text(printdata.initialRequestType);
                    $("#requesttype").text(printdata.requestType);

                    if (printdata.requestType === "File Recieving" || printdata.requestType === "File Recieving (Authority Letter)") {
                        $("#title").text("");
                        $("#preTitle").text("File");
                    }
                    if (printdata.requestType === "NDC For Construction"
                        || printdata.requestType === "NDC Bank Loan") {
                        $("#title").text(" Recieving");
                        $("#preTitle").text("NDC");
                    }

                    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                    document.getElementById('currentDate').textContent = `Dated: ${new Date().toLocaleDateString('en-US', options)}`;


                    printInvoicefilerecieving();
                }
            });
        }

        function printInvoicefilerecieving() {
            debugger;
            var printContents = document.getElementById('printdivfilerecieving').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdivfilerecieving');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => {
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close();
                printWindow.focus();
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

    </script>


