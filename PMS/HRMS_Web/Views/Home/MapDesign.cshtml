<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="modaltitle">Add Map Design</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <form id="MapDesignForm" class="form-horizontal">
                <div class="modal-body">


                    <div class="container">
                        <div class="row">
                            <div class="col-sm-6 hide">
                                <label>Code</label>
                                <input id="ID" class="form-control" disabled />
                                @* <input  id="ID" class="form-control hide" />*@
                            </div>
                            <div class="col-sm-12">
                                <label>Map Design Name <small style="color:red;">*</small></label>
                                <input id="Description" name="Description" class="form-control" />
                            </div>
                        </div>
                    </div>



                </div>
                <div class="modal-footer background-login">
                    <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                    <a id="SubmitButton" onclick="SaveBlock()" class="btn btn-primary btn-theme">Save</a>
                </div>
            </form>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Confirmation</h4>
                <a class="close" data-dismiss="modal">&times;</a>

            </div>
            <div class="modal-body">
                <p>Are You sure you want to permanently delete the Map Design?</p>
                <input class="hide" id="DeleteID" />

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button onclick="DeleteBlock()" type="button" class="btn btn-primary ">Yes</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<input type="text" id="userid" value="@Context.Session.GetString("ID")" class="hide" />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            GetAllMapDesigns();

        });
        function EditBlock(id) {



            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/MapDesign/GetSingleMapDesign`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 0) {
                        var result_User = response.data;
                        $("#ID").val(result_User.id);
                        //$("#Code").val(result_User.code);
                        $("#Description").val(result_User.description);
                        $("#SubmitButton").text("Update");
                        $("#modaltitle").text("Edit Map Design Name");

                        $("#myModal").modal("show");
                    }

                    else {


                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);


                        //window.alert(response.message);
                    }
                }
            });






        }

        function openmodalAdd() {
            $("#ID").val("");
            //$("#Code").val("");
            $("#Description").val("");
            $("#SubmitButton").text("Submit");
            $("#modaltitle").text("Add Map Design");

        }


        function SaveBlock() {
            debugger;

            if ($("#Description").val() !== "") {
                debugger;
                var id = $("#ID").val();
                var newid;
                if (id == "") {
                    newid = 0;
                }
                else {
                    newid = parseInt(id);
                }
                var block =
                {

                    ID: newid,
                    //Code: $("#Code").val(),
                    Description: $("#Description").val(),
                    Updated_By: $("#userid").val(),
                    Created_By: $("#userid").val(),


                };
                var ModelData = JSON.stringify(block);
                $('#loader').fadeIn();
                $.ajax({
                    type: "POST",
                    url: `/api/MapDesign/AddMapDesign`,
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    contentType: 'application/json; charset=utf-8',
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {
                        debugger;

                        $('#loader').fadeOut();
                        console.log(response);
                        if (response.code === 0) {

                            $("#MapDesignForm").submit(function (e) {
                                e.preventDefault();
                            });
                            $("#myModal").modal("hide");
                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    //Swal.fire('Saved!', '', 'success')
                                    location.reload(true);

                                    $("#registrationModal").modal("hide");
                                    $("#confirmation").val(0);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else {
                            $("#MapDesignForm").submit(function (e) {
                                e.preventDefault();
                            });
                            //notification("bottomleft","error","fa fa-exclamation-circle vd_red","Error",response.message);
                            swalWithBootstrapButtons.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                        }
                    }
                });
            }
            else {
                debugger;

                $("#MapDesignForm").submit(function (e) {
                    e.preventDefault();
                });
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Enter Valid Data',
                })
                //notification("bottomleft","error","fa fa-exclamation-circle vd_red","Error","Please enter complete data.");
                // alert("Please enter complete data.")
            }
        }


        function GetAllMapDesigns() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/MapDesign/GetAllMapDesigns`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {
                        debugger;

                        var datatabl = $('#Block').DataTable();
                        datatabl.destroy();
                        $("#blocktbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    //' <td>' + list.id + '</td>           ' +
                                    ' <td>' + list.description + '</td>       ' +
                                    '<td><a class="fa fa-edit fa-2x" style="margin-right:10px" onclick="EditBlock(' + list.id + ')"></a><a class="fa fa-trash-o fa-2x text-danger" onclick="ConfirmBlock(' + list.id + ')"></a></td>' +
                                    '</tr>';
                                $("#blocktbody").append(row);


                                sr++;

                            }
                        }

                        $('#Block').dataTable();
                    }
                }
            });


        }
        function ConfirmBlock(id) {
            //$("#confirmationModal").modal("show");

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false

            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: 'Your data is deleted.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    DeleteBlock();
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })




            $("#DeleteID").val(id);

        }
        function DeleteBlock() {


            var id = $("#DeleteID").val();
            debugger;
            $.ajax({
                type: "GET",
                url: `/api/MapDesign/DeleteMapDesign/`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',

                success: function (response) {
                    debugger;
                    console.log(response);
                    if (response.code === 0) {

                        $("#MapDesignForm").submit(function (e) {
                            e.preventDefault();
                        });

                        //alert(response.message);
                        //location.reload();
                        //$("#confirmationModal").modal("hide");
                        GetAllMapDesigns();
                        //  alert(response.message);
                        //notification("bottomleft","success","fa fa-check-circle vd_green","Success",response.message);
                    }
                    else {
                        $("#MapDesignForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "Error", "fa fa-exclamation-circle vd_red", "Success", response.message);
                    }
                }
            });
        }

    </script>
  }