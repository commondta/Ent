@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#ConstrM").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {
                        // minlength: 3,
                        required: true
                    },
                    PropertyNo: {
                        // minlength: 3,
                        required: true
                    },
                   

                },

                errorPlacement: function (error, element) {
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },
                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostConstructionMonitoring();
                }

            });
           // GetPreviousRecords();
            GetAllPropertyLists();
            GetAllBlocks();
            GetAllNatures();
            GetAllPhases();
            GetAllRealEstate();
            GetAllProjects();
            GetAllFloor();
            GetAllTypes();

            var id = $("#ConstructionMRequestAId").val();

            if (id > 0) {
                SelectSinglePPS(id);
                if ($("#ConstructionMRequestAId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#ConstrM :input").prop("disabled", true);

                }
            }
        });

        function refreshPage() {
            location.reload();
        }

        function SelectRegistration(id) {

            var url = "/api/StockCreation/GetSingleStock?stock=" + id + "";


            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        $("#MemberName").val(result_User.memberProfile.memberName);
                        $("#MemberCode").val(result_User.memberProfile.id);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#Size").val(result_User.actualSize);
                        $("#Street").val(result_User.memberProfile.permanentAddress);

                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phase);
                        $("#Phase").trigger("change");
                        $("#Block").val(result_User.block);
                        $("#Block").trigger("change");
                        $("#Project").val(result_User.project);
                        $("#Project").trigger("change");
                        $("#Type").val(result_User.type);
                        $("#Type").trigger("change");
                        $("#Floor").val(result_User.floor);
                        $("#Floor").trigger("change");
                        $("#Nature").val(result_User.nature);
                        $("#Nature").trigger("change");
                        $("#stockCreationId").val(result_User.id);


                        $("#RealStateType").val(result_User.realStateType);
                        $("#RealStateType").trigger("change");


                        $("#registrationModal").modal("hide");
                        GetResultHistory(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);

                    }

                    else {

                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                        //window.alert(response.message);
                    }
                }
            });

        }

        function GetResultHistory(id) {
            var url = "/api/MeterialTesting/Get?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        

                        $("#ConsMtbody").empty();

                        $.each(result_User, function (i, item) {

                            let date = (item.testDate).split('T')[0] ?? "";
                            let attachment = item.attachment == "" ? "/img/placeholder-photo.svg" : item.attachment;
                            var rownumber = parseInt($("#rownumber").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumber").val(rownumber);

                            var row = '<tr id="' + rownumber + '"> ' +
                                '<td><input disabled class="form-control line" value="' + rownumber + '"/></td>' +

                                '<td><select class="form-control TestType">' +
                                '<option value="Bricks" ' + (item.testType === "Bricks" ? "selected" : "") + '>Bricks</option>' +
                                '<option value="Steel" ' + (item.testType === "Steel" ? "selected" : "") + '>Steel</option>' +
                                '</select></td>' +

                                '<td><input value="' + item.testName + '" class="form-control TestName" disabled/></td>' +

                                '<td><input type="date" class="form-control TestDate" value="' + date + '" disabled/></td>' +

                                '<td><input value="' + item.testedBy + '" class="form-control TestBy" disabled/></td>' +

                                '<td><input value="' + item.amount + '" class="form-control Amount" /></td>' +

                                '<td><select class="form-control Result">' +
                                '<option value="Pass" ' + (item.result === "Pass" ? "selected" : "") + '>Pass</option>' +
                                '<option value="Failed" ' + (item.result === "Failed" ? "selected" : "") + '>Failed</option>' +
                                '</select></td>' +

                                '<td><textarea class="form-control Remarks">' + item.remarks + '</textarea></td>' +

                                '<td><input type="file" class="form-control attachmentPath" /><input class="form-control Picture hide" value="' + attachment + '" /></td>' +
                                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + attachment + '" class="clickme"></a></td>' +

                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a></td>' +
                                '</tr>';

                            $("#ConsMtbody").append(row);
           
                        });
                    }

                    else {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                        //window.alert(response.message);
                    }
                }
            });
        }

        function AddRow() {

            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumber").val(rownumber);

            var row = '<tr id="' + rownumber + '"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td><select class="form-control TestType"><option value="Bricks">Bricks</option><option value="Steel">Steel</option></select></td>' +
                '<td> <input   class="form-control TestName"/></td>' +
                '<td> <input type="date" class="form-control TestDate" value="@DateTime.Now.ToString("yyyy-MM-dd")"  disabled/></td>' +
                '<td> <input value="@Context.Session.GetString("FullName") "  class="form-control TestBy" disabled/></td>' +
                '<td> <input value="0" type="number"  class="form-control Amount" /></td>' +
                '<td><select  class="form-control Result"><option value="Pass">Pass</option><option value="Failed">Failed</option></select></td>' +
                '<td> <textarea  class="form-control Remarks" ></textarea></td>' +
                '<td> <input required type="file" class="form-control attachmentPath" name="LGActivities[' + rownumber + '].attachmentPath" /><input  class="form-control Picture hide" /></td>' +
                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#ConsMtbody").append(row);
        }

        function imageuploading() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Sorry, invalid extension.',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".Picture").val(file.name);
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {

                        row.parents('td').find('.Picture').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);

                        row.parents('tr').find('.attachmentPath').get(0).files[0];
                        row.parents('tr').find('.viewAttachment a').simpleLightbox();
                    }
                    reader.readAsDataURL(file);
                }
            }
        }
        

        function DeleteItemRow(id) {
            $('#' + id).remove();

            var rownumber = 1;

            $("#ConsMtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumber").val(rownumber - 1);
        }


        function PostConstructionMonitoring() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            var TestDetails = new Array();

            TestDetails.StockCreationId = parseInt($("#stockCreationId").val());
            
            $("#ConsMtbody tr").each(function () {
                var row = $(this);
                var Test = new Object();

                Test.StockCreationId = parseInt($("#stockCreationId").val());
                Test.UserId = parseInt($("#userid").val());
                Test.ModifiedBy = $("#User_Id").val();
                Test.CreatedBy = $("#User_Id").val();
                Test.LastModifiedUserName = $("#User_Name").val();
                Test.TestType = row.find(".TestType").val();
                Test.TestName = row.find(".TestName").val();
                Test.TestedBy = row.find(".TestBy").val();
                Test.Amount = row.find(".Amount").val();
                Test.TestDate = row.find(".TestDate").val();
                Test.Result = row.find(".Result").val();
                Test.Remarks = row.find(".Remarks").val(),
                Test.Attachment = row.find(".Picture").val(),
                TestDetails.push(Test);
            });

            MeterialTesting = TestDetails;
            var ModelData = JSON.stringify(MeterialTesting);

                    $('#PostConstructionMonitoring').prop('disabled', true); //disble
                    $('#loader').fadeIn();
                     var url = "/api/MeterialTesting/AddNewMeterialTesting";
                      var  methodtype = "Post";
                   
                    $.ajax({
                        url: url,
                        type: methodtype,
                        contentType: 'application/json; charset=utf-8',
                        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                        processData: false,
                        dataType: "json",
                        async: false,
                        data: ModelData,
                        success: function (data) {

                            $('#loader').fadeOut();
                            if (data.code == 100) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: data.message,
                                    customClass: 'swal-wide',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // location.reload(true);
                                    }
                                    else if (result.isDenied) {
                                        Swal.fire('Changes are not saved', '', 'info')
                                    }
                                })
                            }
                            else {
                                $('#PostConstructionMonitoring').prop('disabled', false);
                                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", data.message);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message,
                                    customClass: 'swal-wide',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });

                            }
                        }
                    });
        }

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });

