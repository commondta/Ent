@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#PossessionAnnouncement").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    PropertyNoFrom: {
                        required: true
                    },
                    PropertyNoTo: {
                        required: true
                    },
                    PossessionEffectDt: {
                        required: true
                    }

                },

                errorPlacement: function (error, element) {
               
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    debugger;
                    SubmitRequest();
                }

            });
            GetAllPropertyLists1();
            GetAllPropertyLists2();
            GetAllBlocks();
            GetAllNatures();
            GetAllPhases();
            GetAllFloor();
            GetAllRealEstate();
            GetAllProjects();
        });

        $("#btnFindMode").click(function () {
            $("#findStandaloneModal").modal("show");
            loadStandaloneInvoices();
        });

        function loadStandaloneInvoices() {

            if ($.fn.DataTable.isDataTable('#standaloneTable')) {
                $('#standaloneTable').DataTable().destroy();
            }

            $('#standaloneTable').DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                searching: true,
                ordering: false,

                ajax: {
                    url: "/api/Property/GetAllPossessioned",
                    type: "GET",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search.value
                        };
                    }
                },

                columns: [
                    {
                        data: null,
                        render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1
                    },
                    { data: "registrationNo" },
                    { data: "membershipNo" },
                    { data: "memberName" },
                    { data: "cnic" },
                    { data: "possessionDate" },
                    {
                        data: null,
                        orderable: false,
                        render: function (data) {

                           

                            let viewBtn = '';

                            if (canPrint) {
                                viewBtn = `
                    <a class="btn btn-sm btn-primary ml-1"
                       title="Print"
                       onclick="PrintPossessionLetter('${data.id}')">
                        <i class="fa fa-print"></i>
                    </a>
                `;
                            }

                            return viewBtn;
                        }
                    }
                ]
            });
        }

        function PrintPossessionLetter(id) {

            var methodType = 'GET';
            var url = "/api/Document/GetPossesionLetter?Id=" + id + "";

            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                success: function (response) {

                    var printdata = response;

                    // =====================================================
                    // TOP SECTION
                    // =====================================================

                    $("#PreviewUrl").attr("src", printdata.imageUrl);
                    $(".ppossessionNo").text(printdata.possessionNo || "");
                    $(".pfileRefNo").text(printdata.registrationNo || "");
                    $(".pplotNo").text(printdata.propertyNo || "");
                    $(".psector").text(printdata.sectorName || "");
                    $(".pphase").text(printdata.phase || "");

                    // =====================================================
                    // OWNER DETAILS
                    // =====================================================

                    $(".pownerName").text(printdata.buyerName || "");
                    $(".pownerSignature").text("");

                    $(".paddress").text(printdata.permanentAddress || "");
                    $(".paddress2").text(printdata.permanentAddress || "");

                    $(".pcontactNo").text(printdata.buyerPhone || "");
                    $(".pemail").text(printdata.buyerEmail || "");

                    // =====================================================
                    // CNIC
                    // =====================================================

                    var cnic = (printdata.buyerCnic || "").replaceAll("-", "");

                    $(".cnic-box").html("");

                    $(".cnic-box").each(function (index) {

                        if (cnic[index]) {
                            $(this).html(
                                '<span class="pcnic">' + cnic[index] + '</span>'
                            );
                        }
                    });

                    // =====================================================
                    // PART I
                    // =====================================================

                    $(".pTransferRecordOfficerName").text(
                        printdata.transferRecordOfficerName || ""
                    );

                    $(".pTransferRecordDirectorName").text(
                        printdata.transferRecordDirectorName || ""
                    );

                    // =====================================================
                    // PART II
                    // =====================================================

                    $(".pFrontSide").text(printdata.frontSide || "");
                    $(".pRearSide").text(printdata.rearSide || "");
                    $(".pLeftSide").text(printdata.leftSide || "");
                    $(".pRightSide").text(printdata.rightSide || "");

                    $(".pFrontBoundary").text(printdata.frontBoundary || "");
                    $(".pRearBoundary").text(printdata.rearBoundary || "");
                    $(".pLeftBoundary").text(printdata.leftBoundary || "");
                    $(".pRightBoundary").text(printdata.rightBoundary || "");

                    $(".pStandardAreaOfPlot").text(printdata.standardAreaOfPlot || "");
                    $(".pAreaOfPlot").text(printdata.areaOfPlot || "");

                    $(".pExcessArea").text(printdata.excessArea || "");
                    $(".pLessArea").text(printdata.lessArea || "");

                    $(".pApprovedMinSheetReferenceNo").text(
                        printdata.approvedMinSheetReferenceNo || ""
                    );

                    $(".pIsCornerPlot").text(
                        printdata.isCornerPlot ? "Yes" : "No"
                    );

                    $(".pIsParkFacing").text(
                        printdata.isParkFacing ? "Yes" : "No"
                    );

                    $(".pIsMainBoulevard").text(
                        printdata.isMainBoulevard ? "Yes" : "No"
                    );

                    $(".pSurveyorName").text(
                        printdata.surveyorName || ""
                    );

                    $(".pBuildingControlDirectorName").text(
                        printdata.buildingControlDirectorName || ""
                    );

                    // =====================================================
                    // PART III
                    // =====================================================

                    let duesDate = "";

                    if (printdata.duesClearedTillDate) {
                        const d = new Date(printdata.duesClearedTillDate);

                        const day = String(d.getDate()).padStart(2, "0");
                        const month = String(d.getMonth() + 1).padStart(2, "0");
                        const year = d.getFullYear();

                        duesDate = `${day}-${month}-${year}`;
                    }

                    $(".pDuesClearedTillDate").text(duesDate);

                    $(".pNdcNo").text(printdata.ndcNo || "");

                    $(".pFinanceOfficerName").text(
                        printdata.financeOfficerName || ""
                    );

                    $(".pFinanceDirectorName").text(
                        printdata.financeDirectorName || ""
                    );

                    // =====================================================
                    // PART IV
                    // =====================================================

                    let possessionDate = "";

                    if (printdata.possessionHandedOverOn) {
                        const d = new Date(printdata.possessionHandedOverOn);

                        const day = String(d.getDate()).padStart(2, "0");
                        const month = String(d.getMonth() + 1).padStart(2, "0");
                        const year = d.getFullYear();

                        possessionDate = `${day}-${month}-${year}`;
                    }

                    $(".pPossessionHandedOverOn").text(possessionDate);

                    $(".pPossessionSurveyorName").text(
                        printdata.possessionSurveyorName || ""
                    );

                    $(".pOwnerName").text(
                        printdata.ownerName || printdata.buyerName || ""
                    );

                    // =====================================================
                    // PRINT
                    // =====================================================

                    printInvoice("printdivSitePlan");

                },

                error: function (xhr) {

                    if (xhr.status === 404) {
                        alert(xhr.responseText || "No record found. Please wait for letter print approval.");
                    }
                    else if (xhr.status === 401) {
                        alert("Unauthorized access. Please log in again.");
                    }
                    else {
                        alert("An error occurred while fetching print data. Please try again later.");
                    }
                }
            });
        }

        function printInvoice(transferType) {
            var printContents = document.getElementById(transferType).innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById(transferType);
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

        function GetAllFloor() {

            $.ajax({
                type: 'GET',
                url: `/api/Floor/GetAllBlocks`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Floor").empty();
                        var row = ' <option value="-1"></option> ';

                        $("#Floor").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Floor").append(row);


                                sr++;

                            }
                        }

                        $('#Floor').select2();
                    }
                }
            });


        }

