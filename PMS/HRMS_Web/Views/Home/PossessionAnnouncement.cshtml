        function SelectRegistration(el, id) {
            var row = $(el).closest("tr");
            // Finds the closest row <tr>
            var number = row.find("td:nth-child(2)").text();
            $("#FromID").val(id);
            PropertyDetail(id);
            ShowAlert(id);
            $("#PropertyNoFrom").val(number);
            $("#registrationModal").modal("hide");
        }
        function SelectToRegistration(el, id) {
            var row = $(el).closest("tr");
            var number = row.find("td:nth-child(2)").text();
            $("#ToID").val(id);
            $("#PropertyNoTo").val(number);
            $("#registrationNoFindModeModal").modal("hide");



            if ($("#FromID").val() != null && $("#FromID").val() != "") {

                var to = $("#ToID").val();
                var from = $("#FromID").val();
                $.ajax({
                    type: 'GET',
                    url: `/api/StockCreation/GetPropertyinRange`,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    data: { from: from, to: to },
                    async: false,
                    contentType: 'application/json',
                    success: function (response) {
                        debugger;
                        if (response.data.length > 0) {
                            var result_User = response.data[0];
                            $('#count').val(response.data.length);
                            $('#RealStateType').val(result_User.realStateType);
                            $('#RealStateType').trigger('change');
                            $('#Phase').val(result_User.phase);
                            $('#Phase').trigger('change');
                            $('#Nature').val(result_User.nature);
                            $('#Nature').trigger('change');
                            $('#Floor').val(result_User.floor);
                            $('#Floor').trigger('change');
                            $('#Project').val(result_User.project);
                            $('#Project').trigger('change');
                            $('#Block').val(result_User.block);
                            $('#Block').trigger('change');
                        }

                        else {
                            //notification("topright", "error", "fa fa-exclamation-circle vd_red", "Error", "No Record Found");
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'No Record Found',
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            // window.alert(response.message);
                        }
                    }
                });
            }
        }
        function SubmitRequest() {

            if ($("#Floor").val() != "-1" && $("#Nature").val() != "-1" && $("#Type").val() != "-1" && $("#Block").val() != "-1" && $("#RealStateType").val() != "-1" && $("#Project").val() != "-1" && $("#PossEffectiveDate").val() != "-1") {

                var GeneratePossessionCreateModel = new Object();
                var possessionFormAttachmentsarr = new Array();
                GeneratePossessionCreateModel.fromId = parseInt($("#FromID").val());
                GeneratePossessionCreateModel.toId = parseInt($("#ToID").val());
                GeneratePossessionCreateModel.possessionEffectDate = $("#PossEffectiveDate").val();
                


                $("#tbody tr").each(function () {
                    var row = $(this);
                    var possessionFormAttachment = new Object();

                    possessionFormAttachment.StockCreationId = parseInt($("#FromID").val());
                    possessionFormAttachment.Remarks = row.find(".remarks").val(),
                    possessionFormAttachment.Piture = row.find(".CopyToTargetDocument").val(),
                    possessionFormAttachmentsarr.push(possessionFormAttachment);
                });

                GeneratePossessionCreateModel.possessionFormAttachments = possessionFormAttachmentsarr;
                var ModelData = JSON.stringify(GeneratePossessionCreateModel)

                var url = '/api/StockCreation/GenratePossessionWithAttachments';

                $('#SubmitRequest').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: "Post",
                    url: url,
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    contentType: 'application/json; charset=utf-8',
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {

                        $('#loader').fadeOut();
                        if (response.code == 100) {
                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    //location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else {

                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Enter Valid Data',
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            //  alert(response.message);
                        }
                    }
                });
                //$('#SubmitRequest').prop('disabled', false); //enable
            }
            else {
               
                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Please enter complete data.");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Please enter complete data.',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            }
        }

        function AddRow() {


            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumber").val(rownumber);


            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <textarea required name="LGActivities[' + rownumber + '].remarks"  class="form-control remarks" ></textarea></td>' +
                '<td> <input required name="LGActivities[' + rownumber + '].targetPath" type="file" class="form-control targetPath" /><input  class="form-control CopyToTargetDocument hide" /></td>' +
                '<td  class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';


            $("#tbody").append(row);


        }


        function DeleteItemRow(id) {
            $('#' + id).remove();
            var rownumber = 1;
            $("#tbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumber").val(rownumber - 1);
        }

        // image from body
        $('body').on('change', '.targetPath', UploadImageOnServerforAttachmenttbody);

        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg', 'pdf']) == -1) {
                // alert();
                // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("warning", "Sorry, invalid extension.");
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");
                // $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('.viewAttachment a').simpleLightbox();
                        row.parents('tr').find('input[type=file]').get(0).files[0];
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

    </script>

