    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
<!-- /.modal -->




<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="modaltittle">Add Postfix</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body">
                <form id="BlockForm" class="form-horizontal">

                    <div class="container">
                        <div class="row">
                            <div class="col-sm-6 hide">
                                <label>Code</label>
                                <input id="ID" class="form-control" disabled />
                                @*   <input  id="ID" class="form-control hide" />*@
                            </div>
                            <div class="col-sm-12">
                                <label>Postfix <small style="color:red;">*</small></label>
                                <input id="Description" class="form-control" />
                            </div>
                            <div class="col-sm-12">
                                <label>Remarks </label>
                                <input id="Remarks" class="form-control" />
                            </div>
                        </div>
                    </div>

                </form>

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                <button onclick="SaveBlock()" id="SubmitButton" type="button" class="btn btn-primary btn-theme">Save</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Confirmation</h4>
                <a class="close" data-dismiss="modal">&times;</a>

            </div>
            <div class="modal-body">
                <p>Are You sure you want to permanently delete the Postfix Definition?</p>
                <input class="hide" id="DeleteID" />

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button onclick="DeleteBlock()" type="button" class="btn btn-primary ">Yes</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<input type="text" id="userid" value="@Context.Session.GetString("ID")" class="hide" />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";

            //$('#Block').dataTable();
            GetAllBlocks();
        });

        function EditBlock(id) 
        {
            $.ajax({
                type: 'GET',
                url: `/api/Postfix/GetSinglePrefix`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 0) {
                        var result_User = response.data;
                        $("#ID").val(result_User.id);
                        //      $("#Code").val(result_User.code);
                        $("#Description").val(result_User.description);
                        $("#Remarks").val(result_User.remarks);
                        $("#modaltittle").text("Edit Postfix");
                        $("#SubmitButton").text("Update");
                        $("#myModal").modal("show");
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);

                    }
                }
            });
        }

        function openmodalAdd() {
            $("#ID").val("");
            //     $("#Code").val("");
            $("#Description").val("");
            $("#Remarks").val("");
            $("#modaltittle").text("Add Postfix");
            $("#SubmitButton").text("Submit");
        }

        function SaveBlock() 
        {
            if ($("#Description").val() !== "") {
                debugger;
                var id = $("#ID").val();
                var newid;
                if (id == "") {
                    newid = 0;
                }
                else {
                    newid = parseInt(id);
                }
                var block =
                {

                    ID: newid,
                    //    Code: $("#Code").val(),
                    Description: $("#Description").val(),
                    Remarks: $("#Remarks").val(),
                    Updated_By: $("#userid").val(),
                    Created_By: $("#userid").val(),
                };
                var ModelData = JSON.stringify(block);
                $('#loader').fadeIn();
                $.ajax({
                    type: "POST",
                    url: `/api/Postfix/AddPrefix`,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {
                        $('#loader').fadeOut();
                        console.log(response);
                        if (response.code === 0) {

                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            $("#myModal").modal("hide");
                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })


                        }
                        else {
                            $("#BlockForm").submit(function (e) {
                                e.preventDefault();
                            });
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                        }
                    }
                });
            }
            else {
                debugger;

                $("#BlockForm").submit(function (e) {
                    e.preventDefault();
                });
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Enter Valid Data',
                })
                // alert("Please enter complete data.")
            }
        }



        function GetAllBlocks() {
            $.ajax({
                type: 'GET',
                url: `/api/Postfix/GetAllPrefixes`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {
                        debugger;
                        var datatabl = $('#Block').DataTable();
                        datatabl.destroy();
                        $("#blocktbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    //' <td>' + list.id + '</td>           ' +
                                    ' <td>' + list.description + '</td>       ' +
                                    ' <td>' + list.remarks + '</td>       ' +
                                    '<td><a class="fa fa-edit fa-2x" style="margin-right:10px" onclick="EditBlock(' + list.id + ')"></a></td>' +
                                    // <a class="fa fa-trash-o fa-2x text-danger" onclick = "ConfirmBlock(' + list.id + ')" > </a>
                                    '</tr>';
                                $("#blocktbody").append(row);


                                sr++;

                            }
                        }

                        $('#Block').dataTable();
                    }
                }
            });


        }
        function ConfirmBlock(id) {
            //$("#confirmationModal").modal("show");
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: 'Your data is deleted.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    DeleteBlock();
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })

            $("#DeleteID").val(id);


        }
        function DeleteBlock() {


            var id = $("#DeleteID").val();
            debugger;
            $.ajax({
                type: "GET",
                url: `/api/Postfix/DeletePrefix/`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',

                success: function (response) {
                    debugger;
                    console.log(response);
                    if (response.code === 0) {

                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });


                        //$("#confirmationModal").modal("hide");
                        GetAllBlocks();
                        //  alert(response.message);
                        //notification("bottomleft","success","fa fa-check-circle vd_green","Success",response.message);
                    }
                    else {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "Error", "fa fa-exclamation-circle vd_red", "Success", response.message);
                    }
                }
            });
        }

    </script>
   }
