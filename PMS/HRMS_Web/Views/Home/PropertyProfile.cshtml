@section Scripts {

    <script>
        $(document).ready(function () {
            GetAllPropertyLists();
         //   GetAllMemberProfiles();
        });

        // selection stockcreationId start
        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/RegistrationNoProfile/GetFilterList`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        debugger;
                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + list.id + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.type + '</td>       ' +
                                    ' <td class="realStateType">' + list.realStateType + '</td>       ' +
                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(id) {

            debugger;

            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;

                        $("#ID").val(result_User.id);
                        $("#PrincipalMember").val(result_User.memberProfile.memberName);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phaseName);
                        $("#Block").val(result_User.blockName);
                        $("#Project").val(result_User.projectName);
                        $("#Type").val(result_User.typeName);
                        $("#Category").val(result_User.categoryName);
                        $("#Floor").val(result_User.floor);
                        $("#Nature").val(result_User.natureName);
                        $("#REType").val(result_User.realStateTypeName);
                        $("#Location").val(result_User.location);
                        $("#Road").val(result_User.street);
                        $("#ActualSize").val(result_User.actualSize);
                        $("#ActualSizeValue").val(result_User.actualSizeUnit);
                        $("#StandardSize").val(result_User.standardSize);
                        $("#StandardSizeValue").val(result_User.standardSizeUnit);
                        $("#ConstructionStatus").val(result_User.constructionStatus);

                        $("#stockCreationId").val(result_User.id);
                        $("#registrationModal").modal("hide");

                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                    }
                }
            });
        }

        function UpdatePropertyLocation(){

            var propertyNumber = $("#PropertyNo").val();
            var location = $("#Location").val();
            var street = $("#Road").val();
       
            if(propertyNumber!="" && propertyNumber!=null){
                var url = '/api/StockCreation/UpdatePropertyLocation?propertyNumber=' + propertyNumber + '&location=' + location + '&street=' + street + '';
                     debugger;
                $('#submt').prop('disabled', true); //disble

                $.ajax({
                    type: "GET",
                    url: url,
                    processData: false,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    async: false,
                    success: function (response) {
                        debugger;
                        
                        console.log(response);
                        if (response.code == 100) {

                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                              icon: 'success',
                              title: 'success',
                              text: 'PropertyProfile Update',
                              customClass: 'swal-wide',
                              allowOutsideClick: false,
                              allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })

                        }
                        else {

                            notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Error Occured");
