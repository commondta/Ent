        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

                var methodType = 'POST';
                var url = "/api/Property/UpdatePropertySetup";
                var propertySetup = new Object();

                 //set values
                let phaseId = $("#Phase").val() == "" ? null : $("#Phase").val();
                let RealStateTypeId = $("#RealStateType").val() == "" ? null : $("#RealStateType").val();
                let ProjectId = $("#Project").val() == "" ? null : $("#Project").val();
                let BlockId = $("#Block").val() == "" ? null : $("#Block").val();
                let NatureId = $("#Nature").val() == "" ? null : $("#Nature").val();
                let CategoryId = $("#Category").val() == "" ? null : $("#Category").val();
                let TypeId = $("#Type").val() == "" ? null : $("#Type").val();
                let FeatureId = $("#Feature").val() == "" ? null : $("#Feature").val();
                let sector = $("#prefixPropertyNo").val() == "" ? null : $("#prefixPropertyNo").val();
                let possessionStatus = $("#PossessionStatus").val() == "true" ? true : false;


                propertySetup.StockCreationId = $("#StockCreationId").val();
                propertySetup.PhaseId = phaseId;
                propertySetup.RealEsateId = RealStateTypeId;
                propertySetup.ProjectId = ProjectId;
                propertySetup.BlockId = BlockId;
                propertySetup.NatureId = NatureId;
                propertySetup.CategoryId = CategoryId;
                propertySetup.TypeId = TypeId;
                propertySetup.PossessionStatus = possessionStatus;
                propertySetup.Feature = FeatureId;
                propertySetup.PrefixProperty= sector;
                propertySetup.PropertyNo = $("#PropertyNo").val();
                propertySetup.PropertyStatus = $("#PropertyStatus").val();
                propertySetup.DiscountPercent = $("#discountPercent").val() || 0;
                propertySetup.ActualSize = $("#actualSize").val();
                propertySetup.coveredArea = $("#coveredArea").val();
                propertySetup.Latitude = $("#Latitude").val();
                propertySetup.Longitude = $("#Longitude").val();
                propertySetup.CaseCode = $("#CaseCode").val();
                propertySetup.AffidavitCode= $("#AffidavitCode").val();
                propertySetup.SaleDeedNo= $("#SaleDeedNo").val();
                propertySetup.SaleDeedDate = $("#SaleDeedDate").val() || null;
                propertySetup.Mouza= $("#Mouza").val();
                propertySetup.MembershipFee = $("#MembershipFee").val();
                propertySetup.MiscCharges = $("#MiscCharges").val();
                propertySetup.AllocationNo=$("#AllocationNo").val();
                propertySetup.ConstructionStatus = $("#ConstructionStatus").val();
                propertySetup.GracePeriodDate = $("#gracePeriodDate").val();
            propertySetup.TransferRecordOfficerName = $("#TransferRecordOfficerName").val();
            propertySetup.TransferRecordDirectorName = $("#TransferRecordDirectorName").val();

            propertySetup.FrontSide = $("#FrontSide").val();
            propertySetup.RearSide = $("#RearSide").val();
            propertySetup.LeftSide = $("#LeftSide").val();
            propertySetup.RightSide = $("#RightSide").val();

            propertySetup.FrontBoundary = $("#FrontBoundary").val();
            propertySetup.RearBoundary = $("#RearBoundary").val();
            propertySetup.LeftBoundary = $("#LeftBoundary").val();
            propertySetup.RightBoundary = $("#RightBoundary").val();

            propertySetup.StandardAreaOfPlot = $("#StandardAreaOfPlot").val();
            propertySetup.AreaOfPlot = $("#AreaOfPlot").val();
            propertySetup.ExcessArea = $("#ExcessArea").val();
            propertySetup.LessArea = $("#LessArea").val();

            propertySetup.ApprovedMinSheetReferenceNo = $("#ApprovedMinSheetReferenceNo").val();

            propertySetup.IsCornerPlot = $("#IsCornerPlot").is(":checked");
            propertySetup.IsParkFacing = $("#IsParkFacing").is(":checked");
            propertySetup.IsMainBoulevard = $("#IsMainBoulevard").is(":checked");

            propertySetup.SurveyorName = $("#SurveyorName").val();
            propertySetup.BuildingControlDirectorName = $("#BuildingControlDirectorName").val();

            propertySetup.DuesClearedTillDate = $("#DuesClearedTillDate").val() || null;
            propertySetup.NdcNo = $("#NdcNo").val();
            propertySetup.NdcType = $("#NdcType").val() || "Normal NDC";

            propertySetup.FinanceOfficerName = $("#FinanceOfficerName").val();
            propertySetup.FinanceDirectorName = $("#FinanceDirectorName").val();

            propertySetup.PossessionHandedOverOn = $("#PossessionHandedOverOn").val() || null;

            propertySetup.PossessionSurveyorName = $("#PossessionSurveyorName").val();
            propertySetup.PossessionNo = $("#PossessionNo").val();
            propertySetup.OwnerName = $("#OwnerName").val();
                propertySetup.ModifiedBy = $("#User_Id").val();
                propertySetup.CreatedBy = $("#User_Id").val();
                propertySetup.LastModifiedUserName = $("#User_Name").val();

                var ModelData = JSON.stringify(propertySetup);

                $('#sbt').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: methodType,
                    url: url,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    async: false,
                    data: ModelData,
                    contentType: 'application/json',
                    success: function (response) {

                        $('#loader').fadeOut();
                        if (response.code == 100) {

                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                   // location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }

                        else {
                            //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Something went wrong");
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong',
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            // window.alert(response.message);
                        }
                    }
                });

               // $('#sbt').prop('disabled', false); //enable
        }
    </script>
