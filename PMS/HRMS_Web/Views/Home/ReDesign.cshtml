@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            $("#DemarcR").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    PropertyNo: {
                        // minlength: 3,
                        required: true
                    },
                    RegistrationNo: {
                        //minlength: 3,
                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });


                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    debugger;
                    SaveDemarcationRequestForm();
                }

            });
            GetAllPropertyLists();
            //GetAllPhases();
            //GetAllBlocks();
            //GetAllCategories();
            //GetAllTypes();
            //GetAllNatures();
        });

        function GetAllPropertyLists() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/DemarcationRequest/GetRedesignAllDemarcationFilterList`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        debugger;
                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.projectName + '</td>       ' +
                                    ' <td>' + list.typeName + '</td>       ' +
                                    ' <td>' + list.realStateTypeName + '</td>       ' +

                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function getchargesdata(obj) {

            var ModelData = JSON.stringify(obj);
            debugger;
            $.ajax({
                type: "POST",
                url: `/api/GlobalChargesSetup/GetGlobalChargeDetail`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    debugger;
                    if (response.code == 100) {
                        var rownumber = 1;
                        $("#GlobalChargeSetupId").val(response.data.id);
                        $.each(response.data.globalChargeDetail, function (i, item) {
                            if (item.status == true) {
                                var status = '<input type="checkbox" class="form-control status" checked disabled/>';
                            }
                            else {
                                var status = '<input type="checkbox" class="form-control status" />';
                            }
                            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                '<td> <input  class="form-control chargeName" disabled  value="' + item.description + '" /></td>' +
                                '<td> <input  class="form-control rate" disabled value="' + item.rate + '" /></td>' +
                                '</tr>';
                            $("#tbodyCharge").append(row);
                            rownumber++;
                        });
                    }
                }

            });
        }

        function SelectRegistration(id) {

            //       var realEstateId = id;
            var url = "/api/StockCreation/GetSingleStock?stock=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;
                        let clearanceDate = result_User.updated_at != "" ? (result_User.updated_at).split('T')[0] : "";

                        $("#MemberName").val(result_User.memberProfile.memberName);
                        $("#MemberCode").val(result_User.memberProfile.id);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#Address").val(result_User.memberProfile.permanentAddress);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#Phase").val(result_User.phaseName);
                        $("#Block").val(result_User.blockName);
                        $("#Project").val(result_User.projectName);
                        $("#Type").val(result_User.typeName);
                        $("#Category").val(result_User.categoryName);
                        $("#Floor").val(result_User.floor);
                        $("#Nature").val(result_User.nature);
                        $("#REType").val(result_User.realStateTypeName);
                        $("#Finishing").val(result_User.finishing);
                        $("#StockCreationId").val(result_User.id);
                        $("#RequestDt").val(clearanceDate);
                        $("#Size").val(1);

                        var obj = new Object();
                        obj.RealStateTypeId = result_User.realStateType;
                        obj.ProjectId = result_User.project;
                        obj.PhaseId = result_User.phase;
                        obj.BlockId = result_User.block;
                        obj.CategoryId = result_User.category;
                        obj.PropertyTypeId = result_User.type;
                        obj.NatureId = result_User.nature;

                        getchargesdata(obj);

                        $("#registrationModal").modal("hide");
                    }

                    else {


                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        //window.alert(response.message);
                    }
                }
            });

        }
        function SaveDemarcationRequestForm() {
            debugger;
            if (/*$("#GlobalChargeSetupId").val()!=null && $("#GlobalChargeSetupId").val()!="" &&*/ $("#StockCreationId").val() != null && $("#StockCreationId").val() != "") {
                var DemarcationRequest = new Object();


                //DemarcationRequest.GlobalChargeSetupId = parseFloat($("#GlobalChargeSetupId").val());
                DemarcationRequest.StockCreationId = parseFloat($("#StockCreationId").val());



                var ModelData = JSON.stringify(DemarcationRequest);
                debugger;

                $('#submmit').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: "POST",
                    url: `/api/DemarcationRequest/AddNewDemarcationRequest`,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {
                        debugger;

                        $('#loader').fadeOut();
                        console.log(response);
                        if (response.code == 100) {
                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                    }

                });

                $('#submmit').prop('disabled', false); //enable
            }
            else {
                //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Please Select Property or RFegistration Number");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Please Select PropertyNo. or RegistrationNo.',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            }
        }

        function GetAllBlocks() {

            $.ajax({
                type: 'GET',
                url: `/api/Block/GetAllBlocks`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Block").empty();
                        var row = ' <option value="-1"></option> ';

                        $("#Block").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Block").append(row);


                                sr++;

                            }
                        }

                        //$('#Block').select2();
                    }
                }
            });


        }

