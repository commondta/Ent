        function PostRequest() {
            
            var regnopro = new Object();

            var url = "";
            var type = "";

            url = "/api/RegistrationNoProfile/AddNewRegistrationNoProfile";
            type = 'POST';

            if ($("#Id").val()) {
                
                regnopro.id = parseInt($("#Id").val());
                type = 'PUT';
                url = "/api/RegistrationNoProfile/UpdateRegistrationNoProfile"
            }

            //set values

            var softLockArray = new Array();
            var propertyStatusArray = new Array();
            var alertsArray = new Array();
            var attachmentsArray = new Array();
            var tanantArray = new Array();

            regnopro.StockCreationId = $('#stockCreationId').val();
            regnopro.MemberProfileId = $('#memberProfileId').val();
            regnopro.Remarks = $('#Remarks').val();
            regnopro.CorrespondenceAddress = $('#CorrespondenceAddress').val();
            regnopro.CorrespondenceEmail = $('#CorrespondenceEmail').val();
            regnopro.CorrespondenceMobileNo = $('#CorrespondenceMobileNo').val();
            regnopro.CorrespondenceWhatsappNo = $('#CorrespondenceWhatsappNo').val();
            regnopro.ModifiedBy = $("#userid").val();
            regnopro.CreatedBy = $("#userid").val();
            regnopro.LastModifiedUserName = $("#User_Name").val();


            $('#SoftLocktbody tr').each(function () {

                var row = $(this);
                var softlock = new Object();

                softlock.SoftLockName = row.find('.Description').val();
                softlock.Reason = row.find('.Reason').val();
                softlock.StartDate = row.find('.StartDate').val();
                softlock.EndDate = row.find('.EndDate').val();
                softlock.Status = row.find('.Status').val();

                softLockArray.push(softlock);
            });

            $('#PropertyStatustbody tr').each(function () {

                var row = $(this);
                var propertyStatus = new Object();

                propertyStatus.Status = row.find('.Status').val();
                propertyStatus.Authoriser = row.find('.Authoriser').val();
                propertyStatus.Date = row.find('.Date').val();
                propertyStatus.Remarks = row.find('.Remarks').val();

                propertyStatusArray.push(propertyStatus);
            });

            $('#Alertstbody tr').each(function () {

                var row = $(this);
                var alert = new Object();

                alert.AlertName = row.find('.AlertName').val();
                alert.AlertNarration = row.find('.AlertNarration').val();
                alert.FromDate = row.find('.FromDate').val();
                alert.ToDate = row.find('.ToDate').val();
                alert.User = row.find('.User').val();
                alert.OrderedBy = row.find('.OrderedBy').val();
                // alert.Attachment = row.find('.Attachment').val();
                alert.Status = row.find('.Status').val();

                alertsArray.push(alert);
            });

            $('#Attachmentstbody tr').each(function () {

                var row = $(this);
                var attachment = new Object();

                attachment.AttachmentName = row.find('.AttachmentName').val();
                attachment.Attachment = row.find('.CopyToTargetDocument').val();
                attachment.AttachmentDate = row.find('.AttachmentDate').val();
                attachment.Remarks = row.find('.Remarks').val();

                attachmentsArray.push(attachment);
            });

            $('#Tananttbody tr').each(function () {

                var row = $(this);
                var tanant = new Object();

                tanant.Name = row.find('.Name').val();
                tanant.Mobile = row.find('.Mobile').val();
                tanant.Cnic = row.find('.Cnic').val();

                tanantArray.push(tanant);
            });

            regnopro.SoftLock = softLockArray;
            regnopro.Alerts = alertsArray;
            regnopro.RegNoProfileAttachments = attachmentsArray;
            regnopro.TanantDetail = tanantArray;
            regnopro.PropertyStatus = propertyStatusArray;

            var model = JSON.stringify(regnopro);

            
            $('#PostRequest').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: type,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        //Swal.fire('Saved', response.message, 'success')
                        Swal.fire({
                            icon: 'success',
                            title: 'success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        // window.alert(response.message);
                    }
                }
            });

            $('#PostRequest').prop('disabled', false); //enable
        }

    </script>
