@section Scripts {

    <script>

        $(document).ready(function () {

            $("#RegistrationNoProfile").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {
                        required: true
                    },
                    // PropertyNo: {
                    //     required: true
                    // },
                    // CoveredArea: {
                    //     required: true
                    // },
                    // MappApproved: {
                    //     required: true
                    // },
                },

                errorPlacement: function (error, element) {
                    
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("form-control")) {
                        error.insertAfter(element);
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },
                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    
                    PostRequest();
                }

            });

            GetAllPropertyLists();
            GetAllMemberProfiles();
            GetAllRegistrationNoProfile();
        });
        function AddRowJointMember() {

            var rownumber = parseInt($("#rownumberJ").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberJ").val(rownumber);
            var row = '<tr id="J' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td style="width: 250px;"><a class="btn btn-primary btn-sm btn-theme" onclick="GetMember(' + rownumber + ')" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +
                '<td> <input readonly required id="name_' + rownumber + '" name="jointname[' + rownumber + '].jointname" class="form-control jointname" /></td>' +
                '<td> <input readonly  id="relationship_' + rownumber + '" name="jointrelationship[' + rownumber + '].jointrelationship" class="form-control jointrelationship " /></td>' +
                '<td> <input readonly required id="cnic_' + rownumber + '" name="jointcNIC[' + rownumber + '].jointcNIC" class="form-control  jointcNIC " /></td>' +
                '<td> <input readonly  id="mobileNo_' + rownumber + '" name="jointmobileNo[' + rownumber + '].jointmobileNo" class="form-control  jointmobileNo" /></td>' +
                '<td> <input readonly  id="address_' + rownumber + '" name="jointaddress[' + rownumber + '].jointaddress" class="form-control  jointaddress " /></td>' +
                '<td class="viewAttachment" ><a><img id="PreviewUrl_' + rownumber + '" style="width:100px; height:80px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteJointMemberRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';
            $("#jointtbody").append(row);

        }

        function DeleteJointMemberRow(id) {
            $('#J' + id).remove();
            var rownumber = 1;
            $("#jointtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberJ").val(rownumber - 1);
        }
        // selection MeterNumber end
        function GetMember(id) {
            GetAllMemberListJoint();
            $("#rownumberforid").val(id);
            $("#JointMemberModal").modal("show");
        }

        function GetAllMemberListJoint() {

            $('#jmlist').DataTable({
                destroy: true,
                ajax: {
                    url: "/api/SP/GetAllMemberProfiles",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "mobile", name: "Mobile" },

                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectJoint(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function SelectJoint(id) {
       
            var url = "/api/MemberProfile/GetMemberById?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        $("#JointMemberModal").modal("hide");

                        var result_User = response.data;

                        let memberImage = result_User.imageURL == "" ? "/img/placeholder-photo.svg" : result_User.imageURL;

                        var rownumber = $("#rownumberforid").val();
                        $("#name_" + rownumber).val(result_User.memberName)
                        $("#relationship_" + rownumber).val(result_User.relationshipWith)
                        $("#cnic_" + rownumber).val(result_User.cnic)
                        $("#mobileNo_" + rownumber).val(result_User.mobile)
                        $("#address_" + rownumber).val(result_User.permanentAddress)
                        $("#PreviewUrl_" + rownumber).attr("src", memberImage);

                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


    function SelectRegistrationNoProfile(id) {

    var url = "/api/RegistrationNoProfile/Get?id=" + id;
    $.ajax({
        type: 'GET',
        url: url,
        dataType: "json",
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
        data: { id: id },
        async: false,
        contentType: 'application/json',
        success: function (response) {

            if (response.code === 100) {

                var result_User = response.data;
                if (!result_User) {
                    notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Empty response data.");
                    return;
                }

              
                // --- Safely access nested data ---
                let memberProfile = result_User.stockCreation.memberProfile || {};
                let stockCreation = result_User.stockCreation || {};

                $("#Id").val(result_User.id);
                $("#PrincipalMember").val(memberProfile.memberName || result_User.memberProfile.memberName)
                $("#RegistrationNo").val(stockCreation.registrationNo || "");
                $("#PropertyNo").val(stockCreation.propertyNo || "");
                $("#Phase").val(stockCreation.phaseName || "");
                $("#Block").val(stockCreation.blockName || "");
                $("#Project").val(stockCreation.projectName || "");
                $("#Type").val(stockCreation.typeName || "");
                $("#Category").val(stockCreation.categoryName || "");
                $("#Floor").val(stockCreation.floor || "");
                $("#Nature").val(stockCreation.natureName || "");
                $("#REType").val(stockCreation.realStateTypeName || "");
                $("#Location").val(memberProfile.permanentAddress || "");
                $("#Road").val(memberProfile.permanentAddress || "");
                $("#ActualSizeValue").val(stockCreation.actualSizeUnit || "");
                $("#StandardSize").val(stockCreation.actualSize || "");
                $("#ActualSize").val(stockCreation.actualSize || "");
                $("#StandardSizeValue").val(stockCreation.actualSizeUnit || "");
                $("#ConstructionStatus").val(stockCreation.constracutionStatus || "");
                $("#memberProfileId").val(memberProfile.id || result_User.memberProfile.id)
                $("#stockCreationId").val(stockCreation.id || "");

                // Call related functions
                if (stockCreation.id) {
                    PropertyDetail(stockCreation.id);
                    getjointmembers(stockCreation.id);
                    GetHistory(stockCreation.id);
                }

                $("#registrationNoFindModeModal").modal("hide");

                // ===== Attachments =====
                $("#Attachmentstbody").empty();
                if (Array.isArray(result_User.regNoProfileAttachments)) {
                    $.each(result_User.regNoProfileAttachments, function (i, item) {
                        let copyToTargetDocument = item.attachment
                            ? item.attachment
                            : "/img/placeholder-photo.svg";

                        var rownumberThree = parseInt($("#rownumberThree").val()) || 0;
                        rownumberThree++;
                        $("#rownumberThree").val(rownumberThree);

                        var row = `
                            <tr id="B${rownumberThree}" DetailId="0">
                                <td><input disabled class="form-control line" value="${rownumberThree}"/></td>
                                <td>
                                    <input type="file" class="form-control Attachment" />
                                    <input class="form-control CopyToTargetDocument hide" value="${copyToTargetDocument}" />
                                </td>
                                <td><input disabled class="form-control AttachmentName" value="${item.attachmentName || ""}" /></td>
                                <td><input type="date" class="form-control AttachmentDate" disabled value="${new Date().toISOString().split('T')[0]}" /></td>
                                <td><textarea class="form-control Remarks">${item.remarks || ""}</textarea></td>
                                <td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="${copyToTargetDocument}" class="clickme"></a></td>
                                <td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachRow('${rownumberThree}')"><span class="append-icon fa fa-trash-o"></span></a></td>
                            </tr>`;
                        $("#Attachmentstbody").append(row);
                    });
                }

                // ===== Soft Lock =====
                $("#SoftLocktbody").empty();
                if (Array.isArray(result_User.softLock)) {
                    $.each(result_User.softLock, function (i, item) {
                        let startingDate = item.startDate ? item.startDate.split('T')[0] : "";
                        let endingDate = item.endDate ? item.endDate.split('T')[0] : "";

                        var rownumberOne = parseInt($("#rownumberOne").val()) || 0;
                        rownumberOne++;
                        $("#rownumberOne").val(rownumberOne);

                        var canDelete = ($("#canDelete").val() || "").toLowerCase();
                        var row = `
                            <tr id="S${rownumberOne}" DetailId="0">
                                <td><input disabled class="form-control line" value="${rownumberOne}"/></td>
                                <td><select id="Description${rownumberOne}" class="form-control Description" style="width:100%"></select></td>
                                <td>
                                    <select class="form-control Reason" id="reason_${rownumberOne}">
                                        <option value="1">No Transfer</option>
                                        <option value="2">Stop Communication</option>
                                        <option value="3">Stop Correspondence</option>
                                        <option value="4">Generate Dues but stop Communication & Correspondence</option>
                                        <option value="5">Stop Dues Generation</option>
                                    </select>
                                </td>
                                <td><input type="date" class="form-control StartDate" value="${startingDate}" /></td>
                                <td><input type="date" class="form-control EndDate" value="${endingDate}" /></td>
                                <td>
                                    <select class="form-control Status" id="statussl_${rownumberOne}">
                                        <option value="Active">Active</option>
                                        ${canDelete === "yes" ? '<option value="InActive">InActive</option>' : ''}
                                    </select>
                                </td>
                            </tr>`;
                        $("#SoftLocktbody").append(row);
                        $("#reason_" + rownumberOne).val(item.reason);
                        $("#statussl_" + rownumberOne).val(item.status);
                        GetSoftLockName(rownumberOne, item.softLockName);
                    });
                }

                // ===== Property Status =====
                $("#PropertyStatustbody").empty();
                if (Array.isArray(result_User.propertyStatus)) {
                    $.each(result_User.propertyStatus, function (i, item) {
                        let date = item.date ? item.date.split('T')[0] : "";
                        var rownumberFive = parseInt($("#rownumberFive").val()) || 0;
                        rownumberFive++;
                        $("#rownumberFive").val(rownumberFive);

                        var row = `
                            <tr id="S${rownumberFive}" DetailId="0">
                                <td><input disabled class="form-control line" value="${rownumberFive}"/></td>
                                <td>
                                    <select readonly class="form-control Status" id="status_${rownumberFive}">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                        <option value="Restored-Active">Restored-Active</option>
                                        <option value="Refunded-Inactive">Refunded-Inactive</option>
                                        <option value="Dormant">Dormant</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </td>
                                <td><input readonly type="date" class="form-control Date" value="${date}" /></td>
                                <td><textarea readonly class="form-control Authoriser">${item.authoriser || ""}</textarea></td>
                                <td><textarea readonly class="form-control Remarks">${item.remarks || ""}</textarea></td>
                                <td style="padding-top:10px"><a class="btn btn-sm btn-danger disabled"><span class="append-icon fa fa-trash-o"></span></a></td>
                            </tr>`;
                        $("#PropertyStatustbody").append(row);
                        $("#status_" + rownumberFive).val(item.status);
                    });
                }

                // ===== Alerts =====
                $("#Alertstbody").empty();
                if (Array.isArray(result_User.alerts)) {
                    $.each(result_User.alerts, function (i, item) {
                        let startingDate = item.fromDate ? item.fromDate.split('T')[0] : "";
                        let endingDate = item.toDate ? item.toDate.split('T')[0] : "";

                        var rownumberTwo = parseInt($("#rownumberTwo").val()) || 0;
                        rownumberTwo++;
                        $("#rownumberTwo").val(rownumberTwo);

                        var row = `
                            <tr id="A${rownumberTwo}" DetailId="0">
                                <td><input disabled class="form-control line" value="${rownumberTwo}"/></td>
                                <td><select type="text" class="form-control AlertName" id="AlertName${rownumberTwo}" style="width:100%"></select></td>
                                <td><textarea class="form-control AlertNarration">${item.alertNarration || ""}</textarea></td>
                                <td><input type="date" class="form-control FromDate" value="${startingDate}" /></td>
                                <td><input type="date" class="form-control ToDate" value="${endingDate}" /></td>
                                <td><input disabled class="form-control User" value="@Context.Session.GetString("FullName")" /></td>
                                <td><textarea class="form-control OrderedBy">${item.orderedBy || ""}</textarea></td>
                                <td><select class="form-control Status" id="statusal_${rownumberTwo}"><option value="Active">Active</option><option value="InActive">InActive</option></select></td>
                                <td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow('${rownumberTwo}')"><span class="append-icon fa fa-trash-o"></span></a></td>
                            </tr>`;
                        $("#Alertstbody").append(row);
                        $("#statusal_" + rownumberTwo).val(item.status);
                        GetAlertName(rownumberTwo, item.alertName);
                    });
