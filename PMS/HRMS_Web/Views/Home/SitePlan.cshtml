@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {

                        required: true
                    },               
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
            GetPreviousRecords();
        });

        function refreshPage() {
            location.reload();
        }

        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/SitePlan/GetAllSitePlanRequest`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requesttbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td>' + list.memberName + '</td>           ' +
                                    ' <td>' + list.cnic + '</td>           ' +
                                    ' <td>' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.propertyNo + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a>' +
                                    '<a class="fa fa-trash-o fa-2x text-danger hide" onclick="DeleteSingleChargeSetup(' + list.id + ')"></a></td> </tr>';
                                //</tr>';
                                $("#requesttbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestlist').dataTable();
                    }
                }
            });

        }

        function SelectSinglePPS(id) {

            var url = "/api/SitePlan/GetSitePlan?id=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#requestmodal").modal("hide");
                        let result_User = response.data;

                       
                        $("#Id").val(result_User.id);
                        $("#DocumentNo").val(result_User.id);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberProfile.memberName);
                        $("#RegistrationNo").val(result_User.stockCreation.registrationNo);
                        $("#PropertyNo").val(result_User.stockCreation.propertyNo);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#ConstrucationStatus").val(result_User.construcationStatus);
                        $("#PossessionStatus").val(result_User.possessionStatus);
                        $("#Size").val(result_User.size);
                        $("#Category").val(result_User.category);
                        $("#Block").val(result_User.block);
                        $("#StockCreationId").val(result_User.stockCreationId);
                        $("#MemberProfileId").val(result_User.memberProfileId);

                        LoadApprovalHistory(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);

                        $("#Atachmenttbody").empty();
                        $.each(response.data.sitePlanAttachments, function (i, item) {
                            debugger;
                            let ndcmemberImage = item.document == "" ? "/img/placeholder-photo.svg" : item.document;
                            let attachmentDate = (item.lastModified).split('T')[0] ?? "0001-01-01";
                            var rownumber = parseInt($("#Arownumber").val());
                            var LineId = rownumber;
                            let existingrows = 2;
                            rownumber = rownumber + 1;
                            $("#Arownumber").val(rownumber);

                            var row = '<tr id="A' + rownumber + '">' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <input type="file" class="form-control attachmentPath"  /><input  class="form-control CopyToTargetDocument hide"  value="' + ndcmemberImage + '" /></td>' +
                                '<td> <input disabled class="form-control attachmentName" value="' + item.doucmentName + '" /></td>' +
                                '<td> <input type="date" class="form-control attachmentDate" value="' + attachmentDate + '" readonly/></td>' +
                                '<td> <textarea disabled class="form-control remarks">' + item.remarks + ' </textarea></td>' +
                                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + ndcmemberImage + '" class="clickme" ></a></img></td>' +
                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachmentItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';
                            $("#Atachmenttbody").append(row);
                        });
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                    }
                }
            });
        }

        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetFilterPropertyResultForNDC`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        debugger;
                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.memberName + '</td>       ' +
                                    ' <td>' + list.cnic + '</td>       ' +
                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }
                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResultForNDCById?stockId=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberName);
                        $("#ConstrucationStatus").val(result_User.constructionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);
                        $("#CNIC").val(result_User.cnic);
                        $("#StockCreationId").val(result_User.id);
                        $("#MemberProfileId").val(result_User.memberProfileId);

                        $("#registrationModal").modal("hide");
                        LoadApprovalHistory(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);

                    }
                }
            });
        }

        function AddAtachmentRow() {

            var rownumber = parseInt($("#Arownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#Arownumber").val(rownumber);
            var row = '<tr id="A' + rownumber + '">' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input required type="file" name="attachmentName[' + rownumber + '].attachmentPath" class="form-control attachmentPath" /><input  class="form-control CopyToTargetDocument hide" /></td>' +
                '<td> <input disabled class="form-control attachmentName" /></td>' +
                '<td> <input type="date" class="form-control attachmentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" disabled/></td>' +
                '<td> <textarea  class="form-control remarks" > </textarea></td>' +
                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachmentItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';
            $("#Atachmenttbody").append(row);
        }
        function DeleteAttachmentItemRow(id) {
            $('#A' + id).remove();
            var rownumber = 1;
            $("#Atachmenttbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#Arownumber").val(rownumber - 1);

        }

        // image from body
        $('body').on('change', '.attachmentPath', UploadImageOnServerforAttachmenttbody);
        debugger;
        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                ResponseMessageModal("warning", "Sorry, invalid extension.");
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");

                return false;
            }
            else {
                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".attachmentName").val(file.name);
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('input[type=file]').get(0).files[0];
                    }

                    reader.readAsDataURL(file);
                }
            }
        }


        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {
            debugger;
            var methodType = 'POST';
            var url = "/api/SitePlan/SaveSitePlan";

            var file = new Object();
            var sitePlanAttachmentsArray = new Array();


             if ($("#Id").val()) {
               
                file.Id = parseInt($("#Id").val());
                methodType = 'PUT';
                url = "/api/SitePlan/UpdateSitePlan"
            }

            file.StockCreationId = parseInt($('#StockCreationId').val());
            file.MemberProfileId = parseInt($('#MemberProfileId').val());
            file.ConstrucationStatus = $("#ConstrucationStatus").val();
            file.PossessionStatus = $("#PossessionStatus").val();
            file.Size = $("#Size").val();
            file.Category = $("#Category").val();
            file.Block = $("#Block").val();

            file.ModifiedBy = $("#User_Id").val();
            file.CreatedBy = $("#User_Id").val();
            file.LastModifiedUserName = $("#User_Name").val();

            $('#Atachmenttbody tr').each(function () {

                var row = $(this);
                var attachment = new Object();
                attachment.DoucmentName = row.find('.attachmentName').val();
                attachment.Document = row.find('.CopyToTargetDocument').val();
                attachment.Remarks = row.find('.remarks').val();

                sitePlanAttachmentsArray.push(attachment);
            });

            file.SitePlanAttachments = sitePlanAttachmentsArray;

            var model = JSON.stringify(file);
            $('#SubmitMR').prop('disabled', true);
             $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    $('#loader').fadeOut();
                    if (response.code == 100) {
                        debugger;
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                               // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $('#SubmitMR').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
    </script>
}
