        function AddStockCreation() {
     
            if ($("#Floor").val() != "-1" && $("#Nature").val() != "-1" && $("#Type").val() != "-1" && $("#Block").val() != "-1" && $("#Category").val() != "-1" && $("#RealStateType").val() != "-1" && $("#Project").val() != "-1" && $("#Phase").val() != "-1" && ($("#prefixRegistration").val() != "" || $("#numForProperty").val() != "") && $("#ActualSize").val() != "") {
               
                var id = $("#ID").val();
                var confirmation;
                var newid;
                if (id == "") {
                    newid = 0;
                }
                else {
                    newid = parseInt(id);
                }
                if ($("#confirmation").val() == "0" || $("#confirmation").val() == 0) {
                    confirmation = false;
                }
                else {
                    confirmation = true;
                }
                if ($("#numForProperty").val() == "") {
                    var numForProperty = 0;
                }
                else {
                    var numForProperty = parseInt($("#numForProperty").val());
                }
                if ($("#numForRegistration").val() == "") {
                    var numForRegistration = 0;
                }
                else {
                    var numForRegistration = parseInt($("#numForRegistration").val());
                }
                var SC =
                {
                    ID: newid,
                    RealStateType: $("#RealStateType").val(),
                    Project: $("#Project").val(),
                    Phase: $("#Phase").val(),
                    Block: $("#Block").val(),
                    Category: $("#Category").val(),
                    Type: $("#Type").val(),
                    Nature: $("#Nature").val(),
                    Finishing: $("#Finishing").val(),
                    Floor: $("#Floor").val(),
                    ActualSize: $("#ActualSize").val(),
                    ActualSizeUnit: $("#ActualSizeUnit").val(),
                    Status: $("#Status").val(),
                    User: $("#User").val(),
                    PrefixRegistration: $("#prefixRegistration").val(),
                    numForRegistration: numForRegistration,
                    postfixForRegistration: $("#postfixForRegistration").val(),
                    PrefixProperty: $("#prefixPropertyNo").val(),
                    numForProperty: numForProperty,
                    postfixForProperty: $("#postfixForProperty").val(),
                    Quantity: $("#qtyForRegistration").val(),
                    InventoryStatus: $("#InventoryStatus").val(),
                    Almt: $("#Almt").val(),
                    CaseCode: $("#CaseCode").val(),
                    AffidavitCode: $("#AffidavitCode").val(),
                    SaleDeedNo: $("#SaleDeedNo").val(),
                    SaleDeedDate: $("#SaleDeedDate").val(),
                    Mouza: $("#Mouza").val(),
                    MembershipFee: $("#MembershipFee").val(),
                    MiscCharges: $("#MiscCharges").val(),
                    AllocationNo: $("#AllocationNo").val(),
                    IsConfirmed: confirmation,
                };

                var ModelData = JSON.stringify(SC);
                
                $('#sbt').prop('disabled', true); //disble
                $('#loader').fadeIn();
                NProgress.start();
                NProgress.set(0.0);
    
                $.ajax({
                    type: "POST",
                    url: `/api/StockCreation/AddStockCreation`,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    data: ModelData,
                    success: function (response) {
                        if (response.code === 100) {
                            $('#loader').fadeOut();
                            NProgress.done();

                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else if (response.code === 2) {
                            $('#loader').fadeOut();
                            NProgress.done();
                            Swal.fire(
                                'warning!',
                                response.message,
                                'warning'
                            )
                        }
                        else if (response.code === 3) {
                            //notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", response.message);
                            //swal with loading and update text
                            //Swal.fire('After mignight I will turn into a pumpkin')
                            //    swal.showLoading()

                            //    // change the title after 2 seconds
                            //    setTimeout(() => {
                            //      Swal.update({ title: 'I am a pumpkin now!' })
                            //      Swal.hideLoading()
                            //    }, 2000)
                            //-=-=-=-=-=-=--=-=----showing list start in modal----=-=-=--=-=-=-=-
                            $('#loader').fadeOut();
                            NProgress.done();
                            $("#confirmation").val(1);
                            $("#Propertytbody").empty();
                            var relist = response.data;
                            if (relist != null && relist.length > 0) {
                                var sr = 1;
                                for (let list of relist) {
                                    var row = ' <tr> ' +
                                        ' <td>' + sr + '</td> ' +
                                        ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                        ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                        ' <td>' + list.typeName + '</td>       ' +
                                        ' <td>' + list.realStateTypeName + '</td>       ' +

                                        ' <td>' + list.status + '</td> </tr>';
                                    //</tr>';
                                    $("#Propertytbody").append(row);


                                    sr++;

                                }
                            }
                            $("#registrationModal").modal("show");

                            //-=-=-=-=-=-=--=-=----showing list end in modal----=-=-=--=-=-=-=-
                        }
                        else if (response.code === 4) {
                            //notification("bottomleft", "warning", "fa fa-exclamation-circle vd_red", "Warning", response.message);
                            $('#loader').fadeOut();
                            NProgress.done();
                            Swal.fire({
                                icon: 'warning',
                                title: 'Warning',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            
                            //-=-=-=-=-=-=--=-=----showing list start in modal----=-=-=--=-=-=-=-
                            $("#confirmation").val(0);
                            $("#conflictModaltbody").empty();
                            var relist = response.data;
                            if (relist != null && relist.length > 0) {
                                var sr = 1;
                                for (let list of relist) {
                                    var row = ' <tr> ' +
                                        ' <td>' + sr + '</td> ' +
                                        ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                        ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                        ' <td>' + list.typeName + '</td>       ' +
                                        ' <td>' + list.realStateTypeName + '</td>       ' +

                                        ' <td>' + list.status + '</td> </tr>';
                                    //</tr>';
                                    $("#conflictModaltbody").append(row);
                                    sr++;
                                }
                            }
                            $("#conflictModal").modal("show");

                            //-=-=-=-=-=-=--=-=----showing list end in modal----=-=-=--=-=-=-=-
                        }

                        else {
                            $('#loader').fadeOut();
                            NProgress.done();
                            //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });

                        }
                    }
                });
              
                $('#sbt').prop('disabled', false); //enable
            }
            else {
                $('#loader').fadeOut();
                NProgress.done();
                
                if ($("#prefixRegistration").val() == "" && $("#numForProperty").val() == "") {
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "You can't create new without Registration Number or Property Number Please select one of them");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'You cant create new without Registration Number or Property Number Please select one of them',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
                else {
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            }
        }

