<input type="number" id="Id" class="hide" />
<input type="number" id="RowNumber" value="0" class="hide" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script>
        $(document).ready(function () {
            //"use strict";

            GetSurchargeSetup();
        });

        function updateTotalSurcharge() {
            var kibor = parseFloat($('#KIBOR').val()) || 0;
            var addition = parseFloat($('#Addition').val()) || 0;

            var totalSurcharge = kibor + addition;
            $('#TotalSurCharge').val(totalSurcharge);
        }
     
        function GetSurchargeSetup() {
            
            $.ajax({
                type: 'GET',
                url: `/api/SurchargeSetup/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    
                    if (response.code == 100) {

                        var datatabl = $('#surcharge').DataTable();
                        datatabl.destroy();

                        $("#tbodyTag").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                let fromDate = moment(list.fromDate).format('DD-MM-YYYY');
                                let toDate = moment(list.toDate).format('DD-MM-YYYY');
                                let lastModified = moment(list.lastModified).format('DD-MM-YYYY');
                                let status = list.isActive == true ? "Active" : "InActive";
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td>' + list.kibor + '</td>' +
                                    '<td>' + list.addition + '</td>' +
                                    '<td>' + list.totalSurCharge + '</td>' +
                                    '<td>' + fromDate + '</td>' +
                                    '<td>' + toDate + '</td>' +
                                    '<td>' + status + '</td>' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSurcharge(' + list.id + ')"></a>' +
                                    '</td>' +

                                    '</tr>';
                                $("#tbodyTag").append(row);
                                sr++;
                            }
                        }
                        $('#surcharge').dataTable();
                    }


                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function SelectSurcharge(id) {

            var url = "/api/SurchargeSetup/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var data = response.data;
                        let status = data.isActive == true ? "1" : "0";
                        let fromDate = (data.fromDate).split('T')[0];
                        let toDate = (data.toDate).split('T')[0];

                        $("#Id").val(data.id);
                        $("#FromDate").val(fromDate);
                        $("#ToDate").val(toDate);
                        $("#Status").val(status);
                        $("#TotalSurCharge").val(data.totalSurCharge);
                        $("#Addition").val(data.addition);
                        $("#KIBOR").val(data.kibor);
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Lead',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/SurchargeSetup/AddSurchargeSetup";

            var Operation = new Object();

            Operation.KIBOR = parseFloat($('#KIBOR').val()) || 0;
            Operation.Addition = parseFloat($('#Addition').val()) || 0;

            let status = $("#Status").val() == 1 ? true : false;
            var sum = Operation.KIBOR + Operation.Addition;

            $('#TotalSurCharge').val(sum);
            Operation.TotalSurCharge = sum;
            Operation.FromDate = $("#FromDate").val();
            Operation.ToDate = $("#ToDate").val();
            Operation.IsActive = status;
            Operation.ModifiedBy = $("#User_Id").val();
            Operation.CreatedBy = $("#User_Id").val();
            Operation.LastModifiedUserName = $("#User_Name").val();


            if ($("#Id").val()) {

                Operation.Id = parseInt($("#Id").val());
                methodType = 'POST';
                url = "/api/SurchargeSetup/UpdateSurchargeSetup"
            }

            var model = JSON.stringify(Operation);
            debugger;
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {

                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
        }

    </script>
 }
