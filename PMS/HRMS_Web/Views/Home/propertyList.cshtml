<div class="modal" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Confirmation</h4>
                <a  class="close" data-dismiss="modal">&times;</a>
                
            </div>
            <div class="modal-body">
               <p>Are You sure you want to permanently delete the Property Definition?</p>
               <input class="hide" id="DeleteID"/>

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button onclick="DeleteBlock()" type="button" class="btn btn-primary ">Yes</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>



@section Scripts {
    <script src="~/js/viewprperty.js"></script>
<script type="text/javascript">
                   $(document).ready(function () {
                       "use strict";
            GetAllPropertyLists()

            GetAllBlocks();
            GetAllSizes();
            GetAllCategories();
            GetAllNatures();
            GetAllPhases();
            GetAllFinishing();
            GetAllRealEstate();
            GetAllProjects();
    
            GetAllFloor();
            GetAllTypes();

                   });



        function GetAllPropertyLists() {
         
        $.ajax({
            type: 'GET',
            url: `/api/Property/GetAllPropertyLists`,
            dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
            async: false,
            contentType: 'application/json',
            success: function (response) {

                if (response.code === 0) {
                     
                     $("#Propertytbody").empty();
                    var relist = response.data;
                    if (relist != null && relist.length > 0) {
                        var sr = 1;
                        for (let list of relist) {
                            var row = ' <tr> ' +
                                ' <td>' + sr + '</td> ' +
                                ' <td>' + list.propertyNo + '</td>           ' +
                                ' <td>' + list.registrationNo + '</td>           ' +
                                ' <td>' + list.phaseName + '</td>       ' +
                                ' <td>' + list.realStateTypeName + '</td>       ' +
                                ' <td>' + list.projectName + '</td>       ' +
                                ' <td>' + list.blockName + '</td>       ' +
                                ' <td>' + list.categoryName + '</td>       ' +
                                ' <td>' + list.natureName + '</td>       ' +
                            
                                ' <td>' + list.status + '</td>    ' +
                                '<td><a class="btn btn-primary" onclick="EditProperty(' + list.id + ')"><i class="fa fa-eye"> </i></a></tr>';
                             //  </tr>';
                            $("#Propertytbody").append(row);


                            sr++;

                        }
                    }

                    $('#proplist').dataTable();
                }
            }
        });


    }

     

        function EditProperty(id){
             
             $.ajax({
                    type: 'GET',
                    url: `/api/Property/GetSingleProperty`,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    data: { id: id },
                    async: false,
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.code === 0) {
                            var result_User = response.data;
                                    $("#RegistrationNo").val(result_User.registrationNo);
                                    $("#PropertyNo").val(result_User.propertyNo);
                                    $('#RealStateType').val(result_User.realStateType);
                                    $('#Phase').val(result_User.phase);
                                    $('#Category').val(result_User.category);
                                    $('#Type').val(result_User.type);
                                    $('#Nature').val(result_User.nature);
                                    $('#Finishing').val(result_User.finishing);
                                    $('#User').val(result_User.user);
                                    $('#Floor').val(result_User.floor);
                                    $('#ActualSize').val(result_User.actualSize);
                                    $('#ActualSizeUnit').val(result_User.actualSizeUnit);
                                    $('#Project').val(result_User.project);
                                    $('#Block').val(result_User.block);
                                    $('#StandardSize').val(result_User.standardSize);
                                    $('#StandardSizeUnit').val(result_User.standardSizeUnit);
                                    $('#Status').val(result_User.status);
                       
                    
               
                             $("#myModal").modal("show");
                        }

                        else {
                             notification("topright","error","fa fa-exclamation-circle vd_red","Error",response.message);
                           // window.alert(response.message);
                        }
                     }
              });
        }




</script>


                }
