                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <label>Phase</label>
                                <div>
                                    <select class="js-example-basic-single" name="Phase" id="Phase" disabled>
                                        <option value="-1"> Select Option </option>                                   
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label>Block</label>
                                <div>
                                    <select class="js-example-basic-single" name="Block" id="Block" disabled>
