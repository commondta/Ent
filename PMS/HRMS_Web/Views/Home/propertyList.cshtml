                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label>Category</label>
                                <div>
                                    <select class="js-example-basic-single" name="Category" id="Category" disabled>
                                        <option value="-1"> Select Option </option>
                                        </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label>Type</label>
                                <div>
                                    <select class="js-example-basic-single" name="Type" id="Type" disabled>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label>Nature</label>
                                <div>
                                    <select class="js-example-basic-single" name="Nature" id="Nature" disabled>
                                        <option value="-1"> Select Option </option>                                     
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label>Finishing</label>
                                <div>
                                    <select class="js-example-basic-single" name="Finishing" id="Finishing" disabled>
                                        <option value="-1"> Select Option </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label>User</label>
                                <div>
                                    <input type="text" class="form-control" disabled
