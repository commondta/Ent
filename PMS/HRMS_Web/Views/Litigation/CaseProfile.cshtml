<partial name="~/Views/PartialPage/viewStock.cshtml" />

@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

            $('#proplist').dataTable();

            GetCaseCategory();
            GetCaseType();
            GetForum();
            GetLaywerData();
            GetAllPropertyLists();
        });

            function GetAllPropertyLists() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetAllProperiesForIndiviualBillGenration`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        debugger;
                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    //' <td class="sr">' + sr + '</td> ' +
                                    ' <td class="stockId">' + list.id + '</td> ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="memberName">' + list.memberName + '</td>       ' +
                                    ' <td class="memberCode">' + list.memberCode + '</td> ' +
                                     '<td><a class="btn btn-primary" onclick="SelectRegistration(this)" >Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(el) {
            debugger;
            var stockCreationId = $(el).parents('tr').find(".stockId").text();
            var property = $(el).parents('tr').find(".propertyNo").text();
            var Registration = $(el).parents('tr').find(".registrationNo").text();
           

            $("#StockCreationId").val(stockCreationId);
            $("#RegistrationNo").val(Registration);
            $("#PropertyNo").val(property);
            $("#registrationModal").modal("hide");
            PropertyDetail(stockCreationId);
            ShowAlert(stockCreationId);
        }

        function GetLaywerData() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/LawyerData/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#AssignedLawyer").empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#AssignedLawyer").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.name + '</option> ';

                                $("#AssignedLawyer").append(row);

                                sr++;
                            }
                            $('#AssignedLawyer').select2();
                        }

                    }
                }
            });
        }

        function GetForum() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Forum/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#Forum").empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#Forum").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Forum").append(row);

                                sr++;
                            }
                            $('#Forum').select2();
                        }

                    }
                }
            });
        }

        function GetCaseCategory() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/CaseCategory/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#CaseCategory").empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#CaseCategory").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#CaseCategory").append(row);

                                sr++;
                            }
                            $('#CaseCategory').select2();
                        }

                    }
                }
            });
        }

        function GetCaseType() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/CaseType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#CaseType").empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#CaseType").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#CaseType").append(row);

                                sr++;
                            }
                            $('#CaseType').select2();
                        }
                    }
                }
            });
        }

