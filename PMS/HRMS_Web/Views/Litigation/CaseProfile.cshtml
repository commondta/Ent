        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/CaseProfile/AddNewCaseProfile";

            var caseProfile = new Object();

            var partiesArr = new Array();
            var hearingsArr = new Array();
            var appealsArr = new Array();
            var noticesArr = new Array();
            var attachmentsArr = new Array();

            //if ($("#Id").val()) {

            //    debugger;

            //    meterInstallation.id = parseInt($("#Id").val());
            //    methodType = 'PUT';
            //    url = "/api/MeterInstallation/UpdateMeterInstallation"
            //}

            caseProfile.StockCreationId = $('#stockCreationId').val();
            caseProfile.CaseId = $('#CaseID').val();
            caseProfile.CaseTitle = $('#CaseTitle').val();
            caseProfile.CaseTypeId = $('#CaseType').val();
            caseProfile.CaseCategoryId = $('#CaseCategory').val();
            caseProfile.CaseFor = $('#CaseFor').val();
            caseProfile.LandArea = $('#LandArea').val();
            caseProfile.FIRReferenceNo = $('#FIRRef').val();
            caseProfile.AdvanceDeposit = $('#AdvDeposited').val();
            caseProfile.SettlementMark = $('#SettleMark').val();
            caseProfile.Status = $('#Status').val();
            caseProfile.ReferenceOfSettlement = $('#Reference').val();
            caseProfile.ForumId = $('#Forum').val();
            caseProfile.Reason = $('#Reason').val();
            caseProfile.LawyerDataId = $('#AssignedLawyer').val();
            caseProfile.TermsAndConditionsOfLawyer = $('#Terms').val();
            caseProfile.LawyerFee = $('#LawyerFee').val();
            caseProfile.CourtFee = $('#CourtFee').val();
            caseProfile.Outcome = $('#Outcome').val();
            caseProfile.CreatedBy = $("#User_Id").val();
            caseProfile.ModifiedBy = $("#User_Id").val();
            caseProfile.LastModifiedUserName = $("#User_Name").val();
            
            $('#Partytbody tr').each(function () {

                var row = $(this);
                var partiesDetail = new Object();

                partiesDetail.Type = row.find('.Type').val();
                partiesDetail.Name = row.find('.Name').val();
                partiesDetail.CNIC = row.find('.CNIC').val();
                partiesDetail.MobileNo = row.find('.MobileNo').val();
                partiesDetail.Address = row.find('.Address').val();
               
                partiesArr.push(partiesDetail);
            });

            $('#CaseHearingtbody tr').each(function () {

                var row = $(this);
                var hearingDetail = new Object();

                hearingDetail.Date = row.find('.Date').val();
                hearingDetail.Time = row.find('.Time').val();
                hearingDetail.Proceeding = row.find('.Proceeding').val();
                hearingDetail.Remind = row.find('.Remind').val();
               
                hearingsArr.push(hearingDetail);
            });

            $('#Appealstbody tr').each(function () {

                var row = $(this);
                var appealDetail = new Object();

                appealDetail.Date = row.find('.Date').val();
                appealDetail.Time = row.find('.Time').val();
                appealDetail.Description = row.find('.Description').val();
              
                appealsArr.push(appealDetail);
            });

            $('#Noticestbody tr').each(function () {

                var row = $(this);
                var noticeDetail = new Object();

                noticeDetail.From = row.find('.From').val();
                noticeDetail.Date = row.find('.Date').val();
                noticeDetail.Detail = row.find('.Detail').val();
                noticeDetail.Response = row.find('.Response').val();
              
                noticesArr.push(noticeDetail);
            });

            $('#Atachmenttbody tr').each(function () {

                var row = $(this);
                var attachmentDetail = new Object();

                attachmentDetail.AttachmentPath = row.find('.CopyToTargetDocument').val();
                attachmentDetail.AttachmentName = row.find('.attachmentName').val();
                attachmentDetail.AttachmentDate = row.find('.attachmentDate').val();
                attachmentDetail.Remarks = row.find('.remarks').val();
              
                attachmentsArr.push(attachmentDetail);
            });

            caseProfile.CaseProfileParties = partiesArr;
            caseProfile.CaseProfileCaseHearings = hearingsArr;
            caseProfile.CaseProfileNotices = noticesArr;
            caseProfile.CaseProfileAppeals = appealsArr;
            caseProfile.CaseProfileAttachments = attachmentsArr;

            var model = JSON.stringify(caseProfile);
            debugger;
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {

                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
        }
    </script>


