                        <div data-action="remove-header" data-original-title="Remove Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-header-button menu"> <i class="fa fa-arrows-v"></i> </div>
                        <div data-action="fullscreen" data-original-title="Remove Navigation Bar and Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="fullscreen-button menu"> <i class="glyphicon glyphicon-fullscreen"></i> </div>

                    </div>

                </div>
            </div>
            <!-- vd_head-section -->

            <div class="vd_title-section clearfix">
                <div class="vd_panel-header">
                    <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-bank2" viewBox="0 0 16 16"><path d="M8.277.084a.5.5 0 0 0-.554 0l-7.5 5A.5.5 0 0 0 .5 6h1.875v7H1.5a.5.5 0 0 0 0 1h13a.5.5 0 1 0 0-1h-.875V6H15.5a.5.5 0 0 0 .277-.916zM12.375 6v7h-1.25V6zm-2.5 0v7h-1.25V6zm-2.5 0v7h-1.25V6zm-2.5 0v7h-1.25V6zM8 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2M.5 15a.5.5 0 0 0 0 1h15a.5.5 0 1 0 0-1z"/></svg></span>
                    <h1>CASE TYPE</h1>
                    @*       <small class="subtitle">PHASE DEFINITION</small>*@
                    <div class="vd_panel-menu  hidden-xs">


                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">

                <div class="container-fluid">
                    <div class="card p-3">
                        <div class="menu" style="float:right; ">
                            <a onclick="openmodalAdd()" class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal">Add New</a>
                        </div>
                        <br />

                        <br />
                        <div >
                            <div class="">
                                <table id="DealerC" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            <th class="text-white" style="text-align: center;">Case Type</th>
                                            <th class="text-white" style="text-align: center;">Action</th>

                                        </tr>
                                    </thead>
                                    <tbody id="dealerCtbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- .vd_content-section -->

        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
<!-- /.modal -->




<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Add Case Type</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body">
                <form id="DCategoryForm" class="form-horizontal">

                    <div class="container">
                        <div class="row">
                            <div class="col-sm-6 hide">
                                <label>Code</label>
                                <input id="ID" class="form-control" disabled />
                            </div>
                            <div class="col-sm-12">
                                <label>Description</label>
                                <input id="Description" class="form-control" />
                            </div>
                        </div>
                    </div>

                </form>

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                <button onclick="SaveCaseType()" type="button" class="btn btn-primary btn-theme">Save</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Confirmation</h4>
                <a class="close" data-dismiss="modal">&times;</a>

            </div>
            <div class="modal-body">
                <p>Are You sure you want to soft delete the Case Type?</p>
                <input class="hide" id="DeleteID" />

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button onclick="DeleteMeterType()" type="button" class="btn btn-primary ">Yes</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />


@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";

            $('#DealerC').dataTable();
            GetAllCaseTypes();
        });


        function EditBlock(id) {

            var url = "/api/CaseType/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;

                        $("#ID").val(result_User.id);
                        $("#Description").val(result_User.description);

                        $("#myModal").modal("show");
                    }

                    else {


                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                    }
                }
            });

        }

        function openmodalAdd() {
            $("#ID").val("");
            $("#Description").val("");
        }




        function SaveCaseType() {

            if ($("#Description").val() !== "") {

                var methodType = 'POST';
                var url = "/api/CaseType/AddCaseType";

                let newid = 0;

                if ($("#ID").val()) {
                    newid = parseInt($("#ID").val());
                    methodType = 'PUT';
                    url = "/api/CaseType/UpdateCaseType"
                }

                var block =
                {

                    Id: newid,
                    Description: $("#Description").val(),
                    ModifiedBy : $("#User_Id").val(),
                    CreatedBy: $("#User_Id").val(),
                    LastModifiedUserName : $("#User_Name").val(),

                };

                var ModelData = JSON.stringify(block);
                $.ajax({
                    type: methodType,
                    url: url,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {

                        if (response.code === 100) {

                            $("#DCategoryForm").submit(function (e) {
                                e.preventDefault();
                            });
                            GetAllCaseTypes();
                            $("#myModal").modal("hide");
                            Swal.fire('Saved', response.message, 'success').then((result) => {
                                if (result.isConfirmed) {
                                    //location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }
                        else {
                            $("#DCategoryForm").submit(function (e) {
                                e.preventDefault();
                            });
                            notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                        }
                    }
                    //});
                }).done(function (response) {
                    Swal.fire(
                        'Saved!',
                        'Your Data has been Saved.',
                        'success'

                    )

                })

            }
            else {
                debugger;

                $("#DCategoryForm").submit(function (e) {
                    e.preventDefault();
                })
                //notification("bottomleft","error","fa fa-exclamation-circle vd_red","Error","Please enter complete data.");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Enter Valid Data',
                })

                // alert("Please enter complete data.")
            }
        }


        function GetAllCaseTypes() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/CaseType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        debugger;
                        var datatabl = $('#DealerC').DataTable();
                        datatabl.destroy();
                        $("#dealerCtbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.description + '</td>       ' +
                                    '<td><a class="fa fa-edit fa-2x" style="margin-right:10px" onclick="EditBlock(' + list.id + ')"></a></td>' +
                                    // <a class="fa fa-trash-o fa-2x text-danger" onclick = "ConfirmBlock(' + list.id + ')" > </a>
                                    '</tr>';
                                $("#dealerCtbody").append(row);


                                sr++;

                            }
                        }

                        $('#DealerC').dataTable();
                    }
                }
            });


        }
        function ConfirmBlock(id) {
            //$("#confirmationModal").modal("show");
            //  Swal.fire({
            //  title: 'Are you sure?',
            //  text: "You won't be able to revert this!",
            //  icon: 'warning',
            //  showCancelButton: true,
            //  confirmButtonColor: '#3085d6',
            //  cancelButtonColor: '#d33',
            //  confirmButtonText: 'Yes, delete it!'
            //}).then((result) => {

            //  if (result.isConfirmed) {
            //    Swal.fire(
            //      'Deleted!',
            //      'Your file has been deleted.',
            //      'success'
            //    )
            //      DeleteBlock();
            //  }
            //})


            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire(
                        'Deleted!',
                        'Your data is deleted.',
                        'success'
                    )

                    DeleteCaseType();
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire(
                        'Cancelled',
                        'Your data is safe !',
                        'error'
                    )
                }
            })




            $("#DeleteID").val(id);



        }
        function DeleteCaseType() {

            var id = $("#DeleteID").val();

            var url = "/api/CaseType/DeleteCaseType?id=" + id + "";

            $.ajax({
                type: 'Delete',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { Id: id },
                async: false,
                contentType: 'application/json',

                success: function (response) {

                    if (response.code === 100) {

                        $("#DCategoryForm").submit(function (e) {
                            e.preventDefault();
                        });

                        GetAllCaseTypes();
                    }
                    else {
                        $("#DCategoryForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "Error", "fa fa-exclamation-circle vd_red", "Success", response.message);

                    }
                }
            });
        }

    </script>
}


