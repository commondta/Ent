<!-- Middle Content Start -->

<div class="vd_content-wrapper">
    <div class="vd_container">
        <div class="vd_content clearfix">
            <div class="vd_head-section clearfix">
                <div class="vd_panel-header">
                    <ul class="breadcrumb">
                        <li><a href="/Home/index">Home</a> </li>
                        <li class="active">Lawyer Data</li>
                    </ul>
                    <div class="vd_panel-menu hidden-sm hidden-xs" data-intro="<strong>Expand Control</strong><br/>To expand content page horizontally, vertically, or Both. If you just need one button just simply remove the other button code." data-step=5 data-position="left">
                        <div data-action="remove-navbar" data-original-title="Remove Navigation Bar Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-navbar-button menu"> <i class="fa fa-arrows-h"></i> </div>
                        <div data-action="remove-header" data-original-title="Remove Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-header-button menu"> <i class="fa fa-arrows-v"></i> </div>
                        <div data-action="fullscreen" data-original-title="Remove Navigation Bar and Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="fullscreen-button menu"> <i class="glyphicon glyphicon-fullscreen"></i> </div>

                    </div>

                </div>
            </div>
            <!-- vd_head-section -->

            <div class="vd_title-section clearfix">
                <div class="vd_panel-header">
                    <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-bank2" viewBox="0 0 16 16"><path d="M8.277.084a.5.5 0 0 0-.554 0l-7.5 5A.5.5 0 0 0 .5 6h1.875v7H1.5a.5.5 0 0 0 0 1h13a.5.5 0 1 0 0-1h-.875V6H15.5a.5.5 0 0 0 .277-.916zM12.375 6v7h-1.25V6zm-2.5 0v7h-1.25V6zm-2.5 0v7h-1.25V6zm-2.5 0v7h-1.25V6zM8 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2M.5 15a.5.5 0 0 0 0 1h15a.5.5 0 1 0 0-1z"/></svg></span>
                    <h1>LAWYER DATA</h1>

                    <div class="vd_panel-menu  hidden-xs">


                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">

                <div class="container-fluid">
                    <div class="card p-3" >
                        <div class="menu" style="float: right; margin-bottom:.5rem">
                            <a class="btn btn-primary btn-sm btn-theme" onclick="AddRow()" style="padding: 6px 20px; margin-right: 15px;">Add New</a>
                            <input type="text" id="rownumberN" value="0" class="hide" />
                        </div>
                        
                        
                        
                        <div>
                            <div class="table-responsive">
                                <table id="LawyerData" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="min-width: 90px; text-align: center;">#</th>
                                            <th class="text-white hide" style="min-width: 130px; text-align: center;">Id</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Lawyer Code</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Name</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">CNIC</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Phone No.</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Nationality</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Country</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">City</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Case Category</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Case Type</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Address</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Jurisdiction</th>
                                            <th class="text-white" style="text-align: center;">Action</th>

                                        </tr>
                                    </thead>
                                    <tbody id="Lawyertbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <br/>
                        <br />
                        <div class="col-md-12" style="display:flex; justify-content:end; margin-top: 1.5rem;">
                            <button type="submit" onclick="PostRequest();" id="sbbtn" class="btn dha_theme_btn">
                                <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Submit
                            </button>
                            <button class="btn btn-light" href="javascript:void(0);">
                                <span class="menu-icon"><i class="fa fa-fw fa-times-circle"></i></span> Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- .vd_content-section -->
        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
<!-- /.modal -->

<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            GetAllLawyerData();
        });

        function GetAllLawyerData() {

            var url = "/api/LawyerData/GetAll";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var result = response.data;

                        $("#Lawyertbody").empty();

                        $.each(result, function (i, item) {
                            var rownumber = parseInt($("#rownumberN").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumberN").val(rownumber);

                            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td class="hide"> <input type="text" class="form-control Id" value="' + item.id + '"/></td>' +
                                '<td> <input type="text" class="form-control LawyerCode" value="' + item.lawyerCode + '"/></td>' +
                                '<td> <input type="text" class="form-control Name" value="' + item.name + '"/></td>' +
                                '<td> <input type="text" class="form-control CNIC" value="' + item.cnic + '"/></td>' +
                                '<td> <input type="text" class="form-control PhoneNo" value="' + item.phoneNo + '"/></td>' +
                                '<td> <input type="text" class="form-control Nationality" value="' + item.nationality + '"/></td>' +
                                '<td> <input type="text" class="form-control Country" value="' + item.country + '"/></td>' +
                                '<td> <input type="text" class="form-control City" value="' + item.city + '"/></td>' +
                                '<td> <select type="text" class="form-control CaseCategory" id="CaseCategory' + rownumber + '"></select></td>' +
                                '<td> <select type="text" class="form-control CaseType" id="CaseType' + rownumber + '"></select></td>' +
                                '<td> <textarea type="text" class="form-control Address">' + item.address + '</textarea></td>' +
                                '<td> <textarea type="text" class="form-control Jurisdiction">' + item.jurisdiction + '</textarea></td>' +


                                '<td style="padding-top:10px"><a disabled class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';

                            $("#Lawyertbody").append(row);

                            GetCaseType(rownumber, item.caseCategoryId)
                            GetCaseCategory(rownumber, item.caseTypeId)
                        });
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Lead");
                    }
                }
            });
        }

        function AddRow() {

            var rownumber = parseInt($("#rownumberN").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberN").val(rownumber);

            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td class="hide"> <input type="text" class="form-control Id" value="0" /></td>' +
                '<td> <input type="text" class="form-control LawyerCode" /></td>' +
                '<td> <input type="text" class="form-control Name" /></td>' +
                '<td> <input type="text" class="form-control CNIC" /></td>' +
                '<td> <input type="text" class="form-control PhoneNo"/></td>' +
                '<td> <input type="text" class="form-control Nationality"/></td>' +
                '<td> <input type="text" class="form-control Country"/></td>' +
                '<td> <input type="text" class="form-control City"/></td>' +
                '<td> <select type="text" class="form-control CaseCategory" id="CaseCategory' + rownumber + '"></select></td>' +
                '<td> <select type="text" class="form-control CaseType" id="CaseType' + rownumber + '"></select></td>' +
                '<td> <textarea type="text" class="form-control Address"></textarea></td>' +
                '<td> <textarea type="text" class="form-control Jurisdiction"></textarea></td>' +
               

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#Lawyertbody").append(row);

            GetCaseType(rownumber)
            GetCaseCategory(rownumber)
        }

        function DeleteItemRow(id) {
            $('#L' + id).remove();
            var rownumber = 1;
            $("#Lawyertbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberN").val(rownumber - 1);
        }

        function GetCaseCategory(rowno, caseCategoryId) {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/CaseCategory/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#CaseCategory" + rowno).empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#CaseCategory" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#CaseCategory" + rowno).append(row);

                                sr++;
                            }
                            $('#CaseCategory' + rowno).select2();
                        }
                        if (caseCategoryId != null && caseCategoryId != undefined) {
                            $('#CaseCategory' + rowno).select2("val", [caseCategoryId])
                        }

                    }
                }
            });
        }

        function GetCaseType(rowno, caseTypeId) {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/CaseType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#CaseType" + rowno).empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#CaseType" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#CaseType" + rowno).append(row);

                                sr++;
                            }
                            $('#CaseType' + rowno).select2();
                        }
                        if (caseTypeId != null && caseTypeId != undefined) {
                            $('#CaseType' + rowno).select2("val", [caseTypeId])
                        }

                    }
                }
            });
        }

        function PostRequest() {

            var lawyerDataArray = new Array();

            $('#Lawyertbody tr').each(function () {

                var row = $(this);
                var lawyerData = new Object();

                lawyerData.Id = row.find('.Id').val();
                lawyerData.LawyerCode = row.find('.LawyerCode').val();
                lawyerData.Name = row.find('.Name').val();
                lawyerData.CNIC = row.find('.CNIC').val();
                lawyerData.PhoneNo = row.find('.PhoneNo').val();
                lawyerData.Nationality = row.find('.Nationality').val();
                lawyerData.Country = row.find('.Country').val();
                lawyerData.City = row.find('.City').val();
                lawyerData.CaseCategoryId = row.find('.CaseCategory').val();
                lawyerData.CaseTypeId = row.find('.CaseType').val();
                lawyerData.Address = row.find('.Address').val();
                lawyerData.Jurisdiction = row.find('.Jurisdiction').val();
                lawyerData.ModifiedBy = $("#User_Id").val();
                lawyerData.CreatedBy = $("#User_Id").val();
                lawyerData.LastModifiedUserName = $("#User_Name").val();

                lawyerDataArray.push(lawyerData);
            });

            var model = JSON.stringify(lawyerDataArray);
            debugger;
            $('#sbbtn').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: 'POST',
                url: `/api/LawyerData/SaveLawyerData`,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: model,

                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
            $('#sbbtn').prop('disabled', false); //enable
        }
    </script>
  }
