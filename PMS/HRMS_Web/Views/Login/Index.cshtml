           function LogIn(){

            if ($("#email").val() !== "" && $("#password").val() !== "" ) {
            if ($("#rememberMe").is(":checked")) {
                localStorage.setItem("rememberedEmail", $("#email").val());
            } else {
                localStorage.removeItem("rememberedEmail");
            }
            var block =
            {

                Email: $("#email").val(),
                Password: $("#password").val(),
                RememberMe: $("#rememberMe").is(":checked"),   // keeps the single sign-on across browser restarts; otherwise it ends with the browser
            };
 
              $('#loader').fadeIn();
             $.ajax({
                type: "POST",
                url: `Login/LoginToPortal`,
                
                data: block,
                success: function (response) {
                    debugger;
                    $('#loader').fadeOut();
                    console.log(response);
                    if (response.code == 0) {
                        localStorage.setItem("token", response.token);
                        url = "/Apps";
                        window.location.replace(url);
                    }
                    else if (response.code === 1) {
                        debugger;
                        // Swal.fire({
                        //     icon: 'error',
