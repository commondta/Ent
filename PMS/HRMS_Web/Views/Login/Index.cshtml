                        //     }
                        // })
                        showToaster();
                    }
                    else {
                        showToaster();
                    }
                    }
            });
            }
            else if ($("#email").val() == "" || $("#password").val() == "") {
                debugger;

            $("#login-form").submit(function (e) {
                e.preventDefault();
            });
            // notification("topright","error","fa fa-exclamation-circle vd_red","Error","Please enter complete data.");
           // alert("Please enter complete data.")
                showToaster();

            }
            }


        function showToaster() {
            // Get the toaster element
            var toaster = document.getElementById("toaster");

            // Set the content for the toaster
            toaster.innerHTML = "Email Or Password You Have Entered is Wrong";

            // Show the toaster
            toaster.style.display = "block";

            // Hide the toaster after 3 seconds (adjust as needed)
            setTimeout(function () {
                toaster.style.display = "none";
            }, 4000);
        }
