    <style>
        /* =====================================================================
           N-Stack login — premium dark crystal + white login
           (Theme folder: Login Page Instructions, 2026-08-20).
           LEFT: white, clean, functional login card.
           RIGHT: dark glass/crystal enterprise visual. Monochrome only.
           Functionality (form ids, validation, LogIn()) untouched.
           ===================================================================== */
        :root {
            --ink: #111111;
            --ink-strong: #000000;
            --text-secondary: #4D4D4D;
            --text-muted: #777777;
            --border: #E5E5E5;
            --surface: #F7F7F7;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body.login-layout-modern {
            min-height: 100vh;
            background: #fff;
            font-family: 'Inter', 'Open Sans', Arial, sans-serif;
        }

        /* Toaster (kept) */
        .toaster {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #111111;
            color: #ffffff;
            padding: 15px;
            border-radius: 6px;
            display: none;
            z-index: 999;
        }

        .login-split {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- LEFT 45%: white login area ---------- */
        .login-split-left {
            position: relative;
            flex: 0 0 45%;
            max-width: 45%;
            background: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
        }

        .login-support {
            position: absolute;
            top: 28px;
            right: 40px;
            font-size: 13px;
            color: #777777;
        }

        .login-support a {
            color: #111111;
            font-weight: 600;
            text-decoration: none;
        }

        .login-support a:hover {
            text-decoration: underline;
        }

        /* Floating login card */
        .login-card {
            width: 100%;
            max-width: 400px;
            background: #FFFFFF;
            border: 1px solid #E5E5E5;
            border-radius: 10px;
            box-shadow: 0 8px 28px rgba(0, 0, 0, .06);
            padding: 38px 36px 30px;
        }

        /* Staggered entrance: fade + rise, 500ms, ~80ms apart. */
        @@keyframes loginRise {
            from { opacity: 0; transform: translateY(15px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .login-card { animation: loginRise .5s ease-out both; }
        .login-anim { animation: loginRise .5s ease-out both; }
        .login-anim.d1 { animation-delay: .08s; }
        .login-anim.d2 { animation-delay: .16s; }
        .login-anim.d3 { animation-delay: .24s; }
        .login-anim.d4 { animation-delay: .32s; }
        .login-anim.d5 { animation-delay: .40s; }
        .login-anim.d6 { animation-delay: .48s; }

        @@media (prefers-reduced-motion: reduce) {
            .login-card, .login-anim,
            .crystal-shape, .crystal-line, .crystal-glow,
            .crystal-hero .hero-art, .crystal-hero .hero-hook, .crystal-hero .hero-glint {
                animation: none !important;
            }
        }

        .login-logo {
            width: 54px;
            height: 54px;
            border-radius: 12px;
            border: 1px solid #EEEEEE;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            overflow: hidden;
        }

        .login-logo img {
            max-width: 100%;
            max-height: 100%;
            object-fit: cover;
        }

        .login-logo img.login-mark {
            width: auto;
            height: 36px;
            object-fit: contain;
        }

        /* the ERP mark (black / gray, no background box) — wide (≈1.7:1), so the holder is just spacing */
        .login-logo:has(.login-mark-erp) { width: auto; height: auto; min-width: 0; padding: 0; border: 0; background: transparent; border-radius: 0; overflow: visible; }
        .login-logo img.login-mark-erp { height: 52px; }

        .login-card h2 {
            font-size: 26px;
            font-weight: 600;
            color: #000000;
            text-align: center;
            margin: 0 0 6px;
        }

        .login-sub {
            color: #666666;
            font-size: 13.5px;
            text-align: center;
            margin: 0 0 28px;
        }

        .login-field {
            margin-bottom: 18px;
        }

        .login-field label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #333333;
            margin-bottom: 6px;
        }

        .login-input-wrap {
            position: relative;
        }

        .login-input-wrap i.login-input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #999999;
            font-size: 14px;
            pointer-events: none;
            transition: color .15s ease;
        }

        .login-input-wrap input {
            box-sizing: border-box !important;
            width: 100% !important;
            height: 44px !important;
            border: 1px solid #DCDCDC !important;
            border-radius: 6px !important;
            padding: 0 16px 0 40px !important;
            font-size: 14px !important;
            color: #111111;
            background: #FFFFFF;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .login-input-wrap input::placeholder { color: #999999; }

        .login-input-wrap input:focus {
            outline: none;
            border-color: #111111 !important;
            box-shadow: 0 0 0 3px rgba(17, 17, 17, .07);
        }

        .login-input-wrap input:focus ~ i.login-input-icon,
        .login-input-wrap input:focus + i.login-input-icon {
            color: #111111;
        }

        .login-input-wrap input.vd_bd-red {
            border-color: #e11d48 !important;
        }

        .login-input-wrap input#password {
            padding-right: 42px !important;
        }

        .login-eye-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: none;
            color: #999999;
            font-size: 14px;
            cursor: pointer;
            padding: 4px;
        }

        .login-eye-toggle:hover {
            color: #111111;
        }

        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: -2px 0 22px;
        }

        .login-remember {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #4D4D4D;
            cursor: pointer;
            font-weight: 400;
            margin: 0;
        }

        .login-remember input {
            width: 15px;
            height: 15px;
            accent-color: #111111;
            cursor: pointer;
            margin: 0;
        }

        .login-options a {
            font-size: 13px;
            color: #333333;
            font-weight: 600;
            text-decoration: none;
        }

        .login-options a:hover {
            text-decoration: underline;
        }

        /* Black primary button */
        .login-btn {
            width: 100%;
            height: 46px;
            border: none;
            border-radius: 6px;
            background: #000000;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color .15s ease, transform .1s ease, box-shadow .15s ease;
        }

        .login-btn:hover {
            background: #222222;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .18);
        }

        .login-btn:active {
            background: #000000;
            transform: translateY(1px);
        }

        .login-powered {
            margin-top: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .login-powered span {
            font-size: 10.5px;
            letter-spacing: .6px;
            color: #999999;
            font-weight: 600;
        }

        .login-powered svg {
            height: 16px;
            width: auto;
        }

        /* ---------- RIGHT 55%: dark crystal visual ---------- */
        .login-split-right {
            position: relative;
            flex: 1;
            overflow: hidden;
            background: #0A0A0A;
            display: flex;
            flex-direction: column;
            justify-content: center;
            /* the panel always fits the screen: viewport-scaled padding and a
               hard ceiling — the page never has to scroll for the visual */
            padding: clamp(24px, 5vh, 60px) clamp(32px, 5vw, 72px);
            max-height: 100vh;
            min-height: 0;
            color: #fff;
        }

        /* Crystal facets: translucent glass polygons, extremely slow drift. */
        .crystal-shape {
            position: absolute;
            pointer-events: none;
            background: linear-gradient(135deg, rgba(255,255,255,0.20) 0%, rgba(255,255,255,0.06) 55%, rgba(255,255,255,0.01) 100%);
            border: 1px solid rgba(255,255,255,0.28);
        }

        .crystal-shape.s1 {
            width: 480px; height: 480px;
            top: -160px; right: -120px;
            clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 12% 88%);
            animation: crystalDrift1 18s ease-in-out infinite;
        }

        .crystal-shape.s2 {
            width: 360px; height: 360px;
            bottom: -100px; left: -80px;
            clip-path: polygon(0% 30%, 62% 0%, 100% 70%, 30% 100%);
            background: linear-gradient(45deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.05) 60%, rgba(255,255,255,0.01) 100%);
            animation: crystalDrift2 22s ease-in-out infinite;
        }

        .crystal-shape.s3 {
            width: 260px; height: 260px;
            top: 34%; right: 8%;
            clip-path: polygon(30% 0%, 100% 22%, 70% 100%, 0% 72%);
            background: linear-gradient(160deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.02) 80%);
            animation: crystalDrift1 26s ease-in-out infinite reverse;
        }

        .crystal-shape.s4 {
            width: 190px; height: 190px;
            bottom: 18%; right: 34%;
            clip-path: polygon(0% 40%, 55% 0%, 100% 55%, 42% 100%);
            background: linear-gradient(200deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.02) 75%);
            animation: crystalDrift2 20s ease-in-out infinite reverse;
        }

        /* Thin light seams between facets */
        .crystal-line {
            position: absolute;
            pointer-events: none;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.55) 50%, rgba(255,255,255,0) 100%);
            transform-origin: left center;
        }

        .crystal-line.l1 { width: 62%; top: 24%; left: 30%; transform: rotate(-24deg); animation: seamPulse 12s ease-in-out infinite; }
        .crystal-line.l2 { width: 48%; top: 66%; left: 8%;  transform: rotate(18deg);  animation: seamPulse 15s ease-in-out infinite 3s; }
        .crystal-line.l3 { width: 40%; top: 84%; left: 48%; transform: rotate(-12deg); animation: seamPulse 17s ease-in-out infinite 6s; }

        /* Soft moving glow */
        .crystal-glow {
            position: absolute;
            pointer-events: none;
            width: 560px; height: 560px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0) 65%);
            top: 8%; left: 42%;
            animation: glowRoam 20s ease-in-out infinite;
        }

        @@keyframes crystalDrift1 {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50%      { transform: translate(-14px, 12px) rotate(1.5deg); }
        }

        @@keyframes crystalDrift2 {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50%      { transform: translate(12px, -10px) rotate(-1.5deg); }
        }

        @@keyframes seamPulse {
            0%, 100% { opacity: .35; }
            50%      { opacity: .8; }
        }

        @@keyframes glowRoam {
            0%, 100% { transform: translate(0, 0); opacity: .8; }
            50%      { transform: translate(-60px, 40px); opacity: 1; }
        }

        /* Right-side identity content — minimal, above the crystal layers */
        .crystal-content {
            position: relative;
            z-index: 1;
            max-width: 460px;
        }

        /* Hero vector (your brief 2026-08-21): an original skyline-and-homes
           illustration — tower crane, glass towers, three gabled homes on a
           ground sweep — drawn monochrome for contrast on the near-black panel.
           Inline SVG, so it is razor-sharp at any size; drifts very slowly with
           the crystal layers, the crane hook sways a little. */
        .crystal-hero {
            width: 100%;             /* same width as the text column below it */
            margin: 0 0 clamp(10px, 2.4vh, 22px);
        }

        /* Height follows the screen (≈30% of it, 120–240px) so the whole panel —
           vector, headline, copy, three features — fits without scrolling on
           1366×768 laptops as well as 1080p/1440p monitors; the SVG keeps its
           aspect ratio and stays left-aligned with the text (xMinYMid). */
        .crystal-hero svg {
            display: block;
            width: 100%;
            height: auto;
            max-height: clamp(120px, 30vh, 240px);
            overflow: visible;
            filter: drop-shadow(0 22px 34px rgba(0,0,0,.55));
        }

        .crystal-hero .hero-art { animation: heroFloat 14s ease-in-out infinite; }

        .crystal-hero .hero-hook {
            transform-origin: 214px 99px;
            transform-box: view-box;
            animation: hookSway 9s ease-in-out infinite;
        }

        .crystal-hero .hero-glint { animation: seamPulse 11s ease-in-out infinite 2s; }

        @@keyframes heroFloat {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-7px); }
        }

        @@keyframes hookSway {
            0%, 100% { transform: rotate(-2.2deg); }
            50%      { transform: rotate(2.2deg); }
        }

        .crystal-title {
            font-size: clamp(22px, 1.2vw + 1.6vh + 6px, 30px);
            font-weight: 600;
            line-height: 1.25;
            color: #fff;
            margin: 0 0 14px;
        }

        .crystal-title::after {
            content: "";
            display: block;
            width: 44px;
            height: 2px;
            background: rgba(255,255,255,.85);
            margin-top: 18px;
        }

        .crystal-text {
            font-size: 14.5px;
            line-height: 1.7;
            color: rgba(255,255,255,.62);
            margin: 18px 0 30px;
        }

        .crystal-feature {
            display: flex;
            align-items: center;
            gap: 13px;
            margin-bottom: 14px;
        }

        /* Glass icon chips — icon containers get deliberate care */
        .crystal-feature .cf-icon {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.14);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex: 0 0 auto;
        }

        .crystal-feature .cf-label {
            font-size: 14px;
            font-weight: 500;
            color: rgba(255,255,255,.85);
        }

        /* Short screens (≤760px tall — 1366×768 laptops, small windows): tighter
           rhythm so the identity column still fits without a scrollbar. */
        @@media (max-height: 760px) {
            .crystal-title { margin-bottom: 10px; }
            .crystal-title::after { margin-top: 12px; }
            .crystal-text { margin: 12px 0 18px; font-size: 13.5px; line-height: 1.55; }
            .crystal-feature { margin-bottom: 10px; }
            .crystal-feature .cf-icon { width: 34px; height: 34px; }
        }

        @@media (max-height: 640px) {
            .crystal-text { display: none; }
            .crystal-hero svg { max-height: 22vh; }
        }

        .crystal-footer {
            position: absolute;
            bottom: 26px;
            right: 40px;
            z-index: 1;
            font-size: 11px;
            color: rgba(255,255,255,.38);
        }

        /* ---------- Responsive: crystal must never reduce usability ---------- */
        @@media (max-width: 900px) {
            .login-split {
                flex-direction: column;
            }

            .login-split-left {
                max-width: 100%;
                flex: 1 1 auto;
                padding: 32px 20px;
            }

            .login-split-right {
                display: none;
            }

            .login-support {
                position: static;
                text-align: right;
                margin-bottom: 12px;
            }
        }
    </style>
</head>

<body id="pages" class="login-layout-modern" data-active="pages " data-smooth-scrolling="1">
    <div class="login-split">
        @* LEFT — white, clean, functional login (Login Page Instructions §1–§3, §8–§13) *@
        <div class="login-split-left">
            <div class="login-support">Need Support? <a href="javascript:void(0);">Reach Us</a></div>

            <div class="login-card">
                <div class="login-logo login-anim d1">
                    @* ERP solution mark (the single login serves every application); N-Stack stays as "Powered by" below *@
                    <img src="~/img/brand/erp/erp-mark-mono.svg" alt="Real Estate Management System" class="login-mark login-mark-erp" />
                </div>
                <h2 class="login-anim d2">Your Workspace Awaits!</h2>
                <p class="login-sub login-anim d2">Sign in to your workspace</p>

                <form class="form-horizontal" id="login-form" action="#" role="form">
                    <div class="alert alert-danger vd_hidden">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true"><i class="icon-cross"></i></button>
                        <span class="vd_alert-icon"><i class="fa fa-exclamation-circle vd_red"></i></span><strong>Oh snap!</strong> Change a few things up and try submitting again.
                    </div>
                    <div class="alert alert-success vd_hidden">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true"><i class="icon-cross"></i></button>
                        <span class="vd_alert-icon"><i class="fa fa-check-circle vd_green"></i></span><strong>Well done!</strong>.
                    </div>

                    <div class="login-field login-anim d3" id="email-input-wrapper">
                        <label for="email">User</label>
                        <div class="login-input-wrap">
                            <i class="fa fa-envelope-o login-input-icon"></i>
                            <input type="text" placeholder="Enter your email" id="email" name="email" class="required" required>
                        </div>
                    </div>
                    <div class="login-field login-anim d4">
                        <label for="password">Password</label>
                        <div class="login-input-wrap">
                            <i class="fa fa-lock login-input-icon"></i>
                            <input type="password" placeholder="Enter your password" id="password" name="password" class="required" required>
                            <button type="button" class="login-eye-toggle" id="togglePassword" tabindex="-1" aria-label="Show password"><i class="fa fa-eye"></i></button>
                        </div>
                    </div>
                    <div id="password-input-wrapper"></div>
                    <div id="toaster" class="toaster"></div>
                    <div id="vd_login-error" class="alert alert-danger hidden"><i class="fa fa-exclamation-circle fa-fw"></i> Please fill the necessary field </div>

                    <div class="login-options login-anim d5">
                        <label class="login-remember">
                            <input type="checkbox" id="rememberMe" /> Remember me
                        </label>
