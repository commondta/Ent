    </div>
    <!-- .vd_content-wrapper -->
    <!-- Middle Content End -->
    <input value="0" id="rownumber" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
    @section Scripts {

    <script>
        $(document).ready(function () {
            GetAllFormsUI();
        });

        function GetAllFormsUI() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Forms/GetAlertForms`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#FormId").empty();
                        var row = ' <option value="-1">Select Form</option> ';

                        $("#FormId").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                              
                                    var row = ' <option value="' + list.formId + '" >' + list.formName + '</option> ';

                                    $("#FormId").append(row);
                      
                                sr++;
                            }
                        }

                        $('#FormId').select2();
                    }
                }
            });
        }


        function AddRow() {
            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            debugger;
            if ($("#FormId").val() != '-1' || $("#FormId").val() != -1) {


                $("#rownumber").val(rownumber);


                var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                    '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                    '<td> <select id="UserId' + rownumber + '" class="form-control UserId" style="width:100%" /></td>' +
                    '<td> <input  class="form-control UserDesignation" disabled /></td>' +
                    '<td style="padding-top:10px"><a class="fa fa-trash-o fa-2x text-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"></a> </td>' +
                    '</tr>';


                $("#PMSUsersTabletbody").append(row);
                BindPMSUsers(rownumber);
            }
            else {
                notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Addition of row not allowed.Please Select Form!");
            }
        }

        function DeleteItemRow(id) {
            $('#' + id).remove();
        }

        function BindPMSUsers(rownumber,userid) {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/PMSUser/GetAllPMSUsers`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#UserId" + rownumber).empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#UserId" + rownumber).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.emP_FULL_NAME + '-' + list.desiG_DESC + '</option> ';

                                $("#UserId" + rownumber).append(row);

                                sr++;

                            }
                            $('#UserId' + rownumber).select2();
                            if(userid!=undefined && userid!=null){
                                 $('#UserId' + rownumber).val(userid).trigger("change");
                            }
                        }


                    }
                }
            });
        }

        $('body').on('select2:select', '.UserId', SetuserDesignation);


        function SetuserDesignation() {
            debugger;
            var data_arr = $(this).parents('tr').find('.UserId').select2('data');

            var PMSUserarray = data_arr[0].text;
            var PMSUserdesignation = PMSUserarray.split('-');

            $(this).parents('tr').find('.UserDesignation').val(PMSUserdesignation[1]);
        }

        function SubmitRequest() {

            if ($("#FormId").val() != "-1") {
                var AS = new Object();
                var FormAlertUsers = new Array();

                AS.FormId = $("#FormId").val();
                AS.CreatedBy = $("#User_Id").val();
                AS.ModifiedBy = $("#User_Id").val();
                AS.LastModifiedUserName = $("#User_Name").val();


                $("#PMSUsersTabletbody tr").each(function () {
                    var row = $(this);


                    var UsersArray = new Object();

                    UsersArray.UserId = row.find(".UserId").val(),
                        UsersArray.UserDesignation = row.find(".UserDesignation").val(),

                        FormAlertUsers.push(UsersArray);
                });

                AS.FormAlertUsers = FormAlertUsers;

                var ModelData = JSON.stringify(AS);

                debugger;
             //   $('#sbt').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: "POST",
                    url: `/api/Notification/AddFormAlert`,
                    contentType: 'application/json; charset=utf-8',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    processData: false,
                    dataType: "json",
                    async: false,
                    data: ModelData,
                    success: function (response) {
                        
                        $('#loader').fadeOut();
                        console.log(response);
                        if (response.code === 100) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            $("#PMSUsersTabletbody").empty();
                            $("#rownumber").val(0);      
                            $("#FormId").val("-1");
                            $("#FormId").trigger("change");
                          
                        }

                    }
                });
            }
            else {
                notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Data");
            }
        }
        $(document.body).on("change", "#FormId", function () {
            GetFormUsers();
        });
      
        function GetFormUsers() {
            var id = $("#FormId").val();

            if (id != "-1" && id != -1) {
                $.ajax({
                    type: 'GET',
                    url: `/api/Notification/GetUsersAgainstForm`,
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    dataType: "json",
                    data: { id: id},
                    async: false,
                    contentType: 'application/json',
                    success: function (response) {
                        debugger;
                        if (response.code === 100) {
                           if (response.data != null) {
                                debugger;
                                if(response.data.length>0){
                                    $("#sbt").text("Update");
                                    $.each(response.data, function (i, item) {

                                        FillGrid(item);
                                    }); 
                                }  
                                else{
                                    $("#sbt").text("Submit");
                                }
                            }
                        }
                    }
                });
            }

        }
        function FillGrid(obj) {
                var rownumber = parseInt($("#rownumber").val());
                var LineId = rownumber;
                rownumber = rownumber + 1;
            
                var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                    '<td> <input disabled class="form-control UserRowId hide" value="' + obj.id + '"/><input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                    '<td> <select id="UserId' + rownumber + '" class="form-control UserId" style="width:100%" /></td>' +
                    '<td> <input  class="form-control UserDesignation" value="' + obj.userDesignation + '" disabled /></td>' +
                    '<td style="padding-top:10px"><a class="fa fa-trash-o fa-2x text-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"></a> </td>' +
                    '</tr>';
                $("#PMSUsersTabletbody").append(row);
                BindPMSUsers(rownumber, obj.userId);

                $("#rownumber").val(rownumber);

            }


    </script>
}

