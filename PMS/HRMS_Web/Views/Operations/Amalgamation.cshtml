            function getlastregistrationnumber() {

            var prefix = $("#prefixRegistration").val();
            var postfix = $("#postfixForRegistration").val();
            if (prefix != "-1" && postfix != "-1") {
                var url = '/api/StockCreation/GetLastRegNo?prefix=' + prefix;
                $.ajax({
                    type: "GET",
                    url: url,
                    processData: false,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    async: false,
                    success: function (response) {

                        console.log(response);
                        if (response.code == 100) {

                            $("#numForRegistration").val(response.data + 1);
                            //notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", response.message);

                        }
                        else {

                            //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Error Occured");
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Error Occured',
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            //  alert(response.message);
                        }
                    }
                });
            }

        }

