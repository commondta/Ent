@section Scripts {
    <script type="text/javascript">

        let propertyTable;
        let selectedProperties = [];

        $(document).ready(function () {
            "use strict";
            LoadPropertyTable();           
            GetAllPhases();
            GetAllPrefix();
            GetAllPostfix();
            GetAllTypes();
            
        });

            $("#btnFindMode").click(function () {
            $("#findStandaloneModal").modal("show");
            loadStandaloneInvoices();
        });

        function loadStandaloneInvoices() {

            if ($.fn.DataTable.isDataTable('#standaloneTable')) {
                $('#standaloneTable').DataTable().destroy();
            }

            $('#standaloneTable').DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                searching: true,
                ordering: false,

                ajax: {
                    url: "/api/Amalgamation/GetAllAmalgamation",
                    type: "GET",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search.value
                        };
                    }
                },

                columns: [
                    {
                        data: null,
                        render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1
                    },
                    { data: "registrationNo" },
                    { data: "propertyNo" },
                    { data: "remarks" },
                    { data: "oldRegistrationNums" },
                    { data: "oldPropertyNums" },
                    { data: "date" },
                    {
                        data: null,
                        orderable: false,
                        render: function (data) {

                            let viewBtn = `
                    <a class="btn btn-sm btn-primary"
                        onclick="Print(${data.amalgamationId})">
                        <i class="fa fa-print"></i>
                    </a>
                `;

                          
                            return viewBtn;
                        }
                    }
                ]
            });
        }

        // ===============================
        // LOAD DATATABLE (FIXED VERSION)
        // ===============================


        // ===============================
        // LOAD DATATABLE
        // ===============================
        function LoadPropertyTable() {

            // destroy if already exists
            if ($.fn.DataTable.isDataTable('#proplistPP')) {
                $('#proplistPP').DataTable().destroy();
            }

            propertyTable = $('#proplistPP').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    }
                },
                processing: true,
                serverSide: true,
                lengthMenu: [10, 25, 50, 100,100000],
                filter: true,
                ordering: false,

                columns: [

                    // ===============================
                    // SERIAL NUMBER
                    // ===============================
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },

                    { data: "propertyNo" },
                    { data: "registrationNo" },
                    { data: "memberName" },
                    { data: "cnic" },
                    { data: "relationshipWith" },
                    { data: "phase" },
                    { data: "block" },
                    { data: "category" },
                    { data: "propertyType" },

                    // ===============================
                    // CHECKBOX (PERSIST SELECTION)
                    // ===============================
                    {
                        data: null,
                        orderable: false,
                        render: function (data) {

                            const isChecked = selectedProperties.includes(data.id) ? "checked" : "";
                            const isDisabled = data.isAmalgamated ? "disabled" : "";

                            return `<input type="checkbox"
                                           class="prop-select"
                                           value="${data.id}"
                                           ${isChecked}
                                           ${isDisabled} />`;
                        }
                    }
                ],

                // ===============================
                // KEEP SELECTION AFTER PAGINATION
                // ===============================
                drawCallback: function () {

                    $('.prop-select').each(function () {
                        const id = parseInt($(this).val());

                        $(this).prop('checked', selectedProperties.includes(id));
                    });
                }
            });
        }

        // ===============================
        // SINGLE CHECKBOX CHANGE
        // ===============================
        $(document).on("change", ".prop-select", function () {

            const id = parseInt($(this).val());

            if ($(this).is(":checked")) {

                if (!selectedProperties.includes(id)) {
                    selectedProperties.push(id);
                }

            } else {

                selectedProperties = selectedProperties.filter(x => x !== id);
            }
        });

        // ===============================
        // SELECT ALL (CURRENT PAGE ONLY)
        // ===============================
        $(document).on("click", "#selectAll", function () {

            const isChecked = this.checked;

            $('.prop-select:not(:disabled)').each(function () {

                const id = parseInt($(this).val());

                $(this).prop('checked', isChecked);

                if (isChecked) {

                    if (!selectedProperties.includes(id)) {
                        selectedProperties.push(id);
                    }

                } else {

                    selectedProperties = selectedProperties.filter(x => x !== id);
                }
            });
        });

        // ===============================
        // OPEN MODAL
        // ===============================
        function OpenAmalgamationModal() {

            const selected = $(".prop-select:checked");

            if (selected.length < 2 || selected.length > 2) {
               Swal.fire(
                                'warning!',
                                'Max and Min Select 2 properties',
                                'warning'
                            )
                return;
            }

            // reset


            $("#prefixRegistration").val('');
            $("#postfixForRegistration").val('');
            $("#numForRegistration").val('');

            $("#Phase").val('');
            $("#RealStateType").val('');
            $("#Category").val('');
            $("#Type").val('');

            $("#remarks").val('');

            $("#amalgamationModal").modal("show");
        }

        // ===============================
        // SUBMIT
        // ===============================

          function SubmitAmalgamation() {



            const selectedIds = $(".prop-select:checked")
                .map(function () { return parseInt($(this).val()); })
                .get();

            // =========================
            // GET VALUES
            // =========================
            const prefix = $("#prefixRegistration").val();
            const postfix = $("#postfixForRegistration").val();
            const number = $("#numForRegistration").val();

            const phase = $("#Phase").val();
            const realEstateType = $("#RealStateType").val();
            const category = $("#Category").val();
            const type = $("#Type").val();

            const remarks = $("#remarks").val();
            const userName = $("#User_Name").val();

            // =========================
            // VALIDATION
            // =========================
                    if (selectedIds.length > 2) {
            Swal.fire('Limit Exceeded', 'Max 2 properties allowed', 'warning');
            return;
        }
            if (selectedIds.length < 2) {
                 Swal.fire(
                                'warning!',
                                'Select at least 2 properties',
                                'warning'
                            )
                return;
            }

            if (!prefix || !number) {
                 Swal.fire(
                                'warning!',
                                'Registration No is required',
                                'warning'
                            )
                return;
            }

            if (!phase || !realEstateType || !category || !type) {
                Swal.fire(
                                'warning!',
                                'Please fill all required fields',
                                'warning'
                            )
                return;
            }

            // =========================
            // BUILD REGISTRATION NO
            // =========================
            const newRegistrationNo = `${prefix}-${number}${postfix ? '-' + postfix : ''}`;

            // =========================
            // PAYLOAD
            // =========================
            const payload = {
                propertyIds: selectedIds,
                newRegistrationNo: newRegistrationNo,
                prefix: prefix,
                postfix: postfix,
                number: parseInt(number),
                phaseId: parseInt(phase),
                realEstateTypeId: parseInt(realEstateType),
                categoryId: parseInt(category),
                typeId: parseInt(type),
                remarks: remarks,
                userName: userName
            };

            // =========================
            // API CALL
            // =========================
            $.ajax({
                url: "/api/Amalgamation/Amalgamate",
                type: "POST",
                data: JSON.stringify(payload),
                contentType: "application/json",
                headers: {
                    Authorization: `Bearer ${localStorage.getItem("token")}`
                },
                 success: function (response) {

                 if (response.code === 100){
                   Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })

                    $("#amalgamationModal").modal("hide");

                    selectedProperties = []; // RESET

                    propertyTable.ajax.reload(null, false);

                    $("#selectAll").prop("checked", false);
                    }
                    else{
                          Swal.fire(
                                'warning!',
                                response.message,
                                'warning'
                            )
                    }
                },
                error: function (err) {
                    Swal.fire(
                                'warning!',
                                'something went wrong',
                                'warning'
                            )
                }
            });
        }

        // ===============================
        // PRINT (UNCHANGED - IMPROVED DATE)
        // ===============================

        function Print(id) {

            var methodType = 'GET';
            var url = "/api/Amalgamation/GetAllotmentLetter?Id=" + id + "";
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {

                    var printdata = response;

                    $(".ppropertyNo").text(printdata.propertyNo);
                    $(".pregistrationNo").text(printdata.registrationNo);

                    var buyerDetails = printdata.buyerWithJointMembers;
                    var sellerDetails = printdata.sellerWithJointMembers;

                    $(".pmemberNameAndDetails").empty();
                    $(".pmemberNameAndDetails").empty();
                    $('.messcountmembersdiv').hide();
                    $('.lesscountmembersdiv').show();
                    $('.lesscountmembersdiv').find('.pmemberNameAndDetails').text(buyerDetails);


                    $(".ppermanentAddress").text(printdata.permanentAddress);
                    $(".pblock").text(printdata.block);
                    $(".pbuyerPhone").text(printdata.buyerPhone);
                    // $(".pmembershipNo").text(printdata.membershipNo);
                    $(".ptype").text(printdata.type + " " + printdata.realEstateType);
                    $(".parea").text(printdata.area + " " + printdata.unitArea);

                    $(".psqryard").text(printdata.area);
                    $(".pcategory").text(printdata.category);
                    $(".pcnic").text(printdata.buyerCnic);
                    $(".pllot").text(printdata.nature);
                    $(".InternalNo").text(printdata.internalNo);
                    $(".psector").text(printdata.sectorName);
                    $(".pphase").text(printdata.phase);
                    $(".ptitle").text(printdata.title);
                    $(".pPlotNo").text(printdata.plotNo);
                    $(".pSignatoryRank").text(printdata.signatoryRank);
                    $(".pSignatoryDesignation").text(printdata.signatoryDesignation);
                    $(".pSignatoryName").text(printdata.signatoryName);
                    $(".pbuyerDetail").text(sellerDetails);
                    $(".pAmalgamatedPlot1").text(printdata.amalgamatedPlot1);
                    $(".pAmalgamatedPlot2").text(printdata.amalgamatedPlot2);
                    $(".pAmalgamatedReg1").text(printdata.amalgamatedReg1);
                    $(".pAmalgamatedReg2").text(printdata.amalgamatedReg2);
                    $(".pamalgamatedSector").text(printdata.amalgamatedSector);
                    $(".pamalgamatedPhase").text(printdata.amalgamatedPhase);

                    // $("#SellerNames").val(sellerDetails);
                    // $("#BuyerNames").val(buyerDetails);

                    printdata.letterDate = $("#DocDate").val();
                    var date = new Date(printdata.letterDate);
                    var options = { month: 'short', year: 'numeric' };
                    $(".pppdate").text(date.toLocaleDateString('en-GB', options));

                    var allotmentDate = new Date($("#AllotmentDate").val());
                    var allotmentOptions = { day: 'numeric', month: 'short', year: 'numeric' };
                    $(".ppdate").text(allotmentDate.toLocaleDateString('en-GB', allotmentOptions));

                    $(".qrcode").empty();
                    $(".imgContainerForPrint").empty();

                    var Adress = printdata.permanentAddress;
                    var Name = printdata.buyerName;
                    var RegistrationNo = printdata.propertyNo;
                    let udno = printdata.block;

                    var qrcodeContent = "BWP" + "/" + RegistrationNo + "/" + udno;
                    $(".RefNum").text(qrcodeContent);

                    $(".qrcode").each(function () {
                        $(this).empty();
                        new QRCode(this, {
                            text: qrcodeContent,
                            width: 90,
                            height: 90
                        });
                    });

                    $(".imgContainerForPrint").empty();

                    //var selectedFile = $('#docImageUpload')[0].files[0];

                    // if (selectedFile) {
                    //     // ✅ PRIORITY 1: Use uploaded image
                    //     var reader = new FileReader();

                    //     reader.onload = function (e) {
                    //         var row = '<img style="width:100%;height:100%;margin:0px;" src="' + e.target.result + '" />';
                    //         $(".imgContainerForPrint").append(row);
                    //     };

                    //     reader.readAsDataURL(selectedFile);
                    // }
                    if (printdata.imageUrl && printdata.imageUrl !== "") {
                        // ✅ PRIORITY 2: Use backend image
                        var row = '<img style="width:100%;height:100%;margin:0px;" src="' + printdata.imageUrl + '" />';
                        $(".imgContainerForPrint").append(row);
                    }


                    $(".ptext").text("purchased");
                    $(".pPropertyNo").text(printdata.propertyNo);

                    printInvoice("printdiv");

                }, error: function (xhr) {
                    // ✅ Handle backend NotFound (404) or any other error
                    if (xhr.status === 404) {
                        alert(xhr.responseText || "No record found. Please wait for letter print approval.");
                    } else if (xhr.status === 401) {
                        alert("Unauthorized access. Please log in again.");
                        // optional: redirect to login
                        // window.location.href = "/login";
                    } else {
                        alert("An error occurred while fetching print data. Please try again later.");
                    }
                }
            });
        }

        function printInvoice(transferType) {
            var printContents = document.getElementById(transferType).innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById(transferType);
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }


         function GetAllPrefix() {

            $.ajax({
                type: 'GET',
                url: `/api/Prefix/GetAllPrefixes`,
