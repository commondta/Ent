<div class="modal" id="amalgamationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Amalgamation</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">


                <div class="row">

                    <div class="col-md-12">
                        <label>Prefix</label>
                        <select class="form-control js-example-basic-single" id="prefixRegistration" style="width:100%"></select>
                    </div>

                    <div class="col-md-12">
                        <label>Postfix</label>
                        <select class="form-control js-example-basic-single" id="postfixForRegistration" style="width:100%"></select>
                    </div>

                    <div class="col-md-12">
                        <label>Number</label>
                        <input type="number" class="form-control" id="numForRegistration" />
                    </div>

                    <div class="col-md-12">
                        <label>Phase *</label>
                        <select class="form-control js-example-basic-single" id="Phase" style="width:100%"></select>
                    </div>

                    <div class="col-md-12">
                        <label>Real Estate Type *</label>
                        <select class="form-control js-example-basic-single" id="RealStateType" style="width:100%"></select>
                    </div>

                    <div class="col-md-12">
                        <label>Category *</label>
                        <select class="form-control js-example-basic-single" id="Category" style="width:100%"></select>
                    </div>

                    <div class="col-md-12">
                        <label>Type *</label>
                        <select class="form-control js-example-basic-single" id="Type" style="width:100%"></select>
                    </div>

                    <div class="col-md-12">
                        <label>Remarks</label>
                        <textarea id="remarks" class="form-control"></textarea>
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" onclick="SubmitAmalgamation()">Submit</button>
                <button class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>

        </div>
