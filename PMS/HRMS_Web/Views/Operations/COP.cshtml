        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() 
        {
            var methodType = 'POST';
            var url = "/api/COP/SaveCOP";

            var cop = new Object();
            cop.StockIdA = $('#StockIdA').val();
            cop.StockIdB = $('#StockIdB').val();
            cop.CurrentPropertyMarketValue = $('#CurrentPropertyMarketValue').val();
            cop.ProposedPropertyMarketValue = $('#ProposedPropertyMarketValue').val();
            cop.Remarks = $('#Remarks').val();
            cop.COPDate = $('#COPDate').val();

            var model = JSON.stringify(cop);

            $('#Submitp').prop('disabled', true);//disble
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) 
                {
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        //Swal.fire('Saved', response.message, 'success')
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $('#Submitp').prop('disabled', false);//disble
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
            // $('#Submitp').prop('disabled', false); //enable
        }


        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/COP/GetAllCOPRequest`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requesttbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                const requestDateTime = moment(list.createdOn).format('DD-MM-YYYY, h:mmA');
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td>' + list.currentPropertyRegistrationNo + '</td>           ' +
                                    ' <td>' + list.currentPropertyPropertyNo + '</td>           ' +
                                    ' <td>' + list.proposedPropertyRegistrationNo + '</td>           ' +
                                    ' <td>' + list.proposedPropertyPropertyNo + '</td>           ' +
                                    ' <td>' + requestDateTime + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a><a class="fa fa-print fa-2x" onclick="PrintScreen(' + list.id + ')"></a>' +
                                    '<a class="fa fa-times fa-2x" style="color: red;" onclick="CancelRequest(' + list.id + ')"></a></td> </tr>';
                                //</tr>';
                                $("#requesttbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestlist').dataTable();
                    }
                }
            });
        }

