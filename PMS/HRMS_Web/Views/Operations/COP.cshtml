@section Scripts
    {
    <script>
        $(document).ready(function () {
            "use strict";

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberNameA: {

                        required: true
                    },
                    MemberNameB: {

                        required: true
                    },
                    RegNoA: {

                        required: true
                    },
                    RegNoB: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            
            $('#Submitp').prop('disabled', false);
        });

        function refreshPage() {
            location.reload();
        }

        var propertyListsA = null;
        var propertyListsB = null;

        $(document).ready(function () {
            "use strict";
            if (propertyListsA == null) {
                GetAllPropertiesListsA();
            } else {
                processResponseA(propertyListsA);
            }

            if (propertyListsB == null) {
                GetAllPropertiesListsB();
            } else {
                processResponseB(propertyListsB);
            }

            GetPreviousRecords();
        });

        function refreshPage() {
            location.reload();
        }

        // Select A property
        function GetAllPropertiesListsA() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistrationA(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function SelectRegistrationA(id) {

            var url = "/api/COP/GetFilterProperty?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        // set values
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        let bookingDate = moment(result_User.bookingDate).format('DD-MM-YYYY');

                        $("#Id").val(result_User.id);
                        $("#DealerA").val(result_User.estateName);
                        $("#BookingDateA").val(bookingDate);
                        $("#RegNoA").val(result_User.registrationNo);
                        $("#PropertyNoA").val(result_User.propertyNo);
                        $("#MemberCodeA").val(result_User.memberCode);
                        $("#MemberNameA").val(result_User.memberName);
                        $("#ConstrucationStatusA").val(result_User.constracutionStatus);
                        $("#PossessionStatusA").val(possessionstatus);
                        $("#SizeA").val(result_User.actualSize);
                        $("#CategoryA").val(result_User.categoryName);
                        $("#BlockA").val(result_User.blockName);

                        $("#StockIdA").val(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                        $("#registrationModal").modal("hide");
                    }
                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        // Select B property
        function GetAllPropertiesListsB() {
            $.ajax({
                type: 'GET',
                url: `/api/COP/GetPropertiesForCOP`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        propertyListsB = response.data;
                        processResponseB(propertyListsB);
                    }
                }
            });
        }

        function processResponseB(responseData) {
            $("#registrationtbodyB").empty();
            var relist = responseData;
            if (relist != null && relist.length > 0) {
                var sr = 1;
                for (let list of relist) {
                    var row = '<tr>' +
                        '<td>' + sr + '</td>' +
                        ' <td >' + list.propertyNo + '</td>           ' +
                        ' <td >' + list.registrationNo + '</td>           ' +
                        ' <td >' + list.cnic + '</td>       ' +
                        ' <td >' + list.memberName + '</td> ' +
                        ' <td >' + list.categoryName + '</td> ' +
                        ' <td >' + list.blockName + '</td> ' +
                        ' <td >' + list.type + '</td> ' +
                        '<td><a class="btn btn-primary" onclick="SelectRegistrationB(' + list.id + ')">Select</a></td>' +
                        '</tr>';
                    $("#registrationtbodyB").append(row);
                    sr++;
                }
            }
            $('#registrationListB').dataTable();
        }

        function SelectRegistrationB(id) 
        {
            var url = "/api/COP/GetFilterProperty?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        // set values
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                         let bookingDate = moment(result_User.bookingDate).format('DD-MM-YYYY');

                        $("#Id").val(result_User.id);
                        $("#DealerB").val(result_User.estateName);
                        $("#BookingDateB").val(bookingDate);
