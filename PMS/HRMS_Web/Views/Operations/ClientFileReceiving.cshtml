@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";
            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberName: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
            $('#btnsubmit').prop('disabled', false);

            var id = $("#ClientFileReceivingAId").val();
            debugger;
            if (id > 0) {
                SelectSinglePPS(id);
                if ($("#ClientFileReceivingAId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#MemberNDC :input").prop("disabled", true);

                }
            }
        });


        function redirectToAnotherPage() {
            window.location.href = '/FingerPrint/VerifyFingerPrint';

        }

        function refreshPage() {
            location.reload();
        }

        $('#RequestType').change(function () {
            var selectedValue = $(this).val();
            var sendForApproval = $('#SendForApproval');

            if (selectedValue === "File Recieving") {
                sendForApproval.val("1").prop("disabled", false);
                $('#recieverImagdiv').show();
            } else {
                sendForApproval.val("0").prop("disabled", true);
                $('#recieverImagdiv').hide();
            }
        });

        $('#SearchRequestType').change(function () {
            var selectedValue = $(this).val();
            GetPreviousRecords(selectedValue);
            $("#requestModal").modal("show");
        });

        function searchRecord() {
            const selectedValue = $('#SearchRequestType').val();
            GetPreviousRecords(selectedValue);
            $("#requestModal").modal("show");
        }

        function GetPreviousRecords(selectedValue) {
            var url = "/api/FileVerification/GetFilterRequestType?requestType=" + selectedValue + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requestTbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var printbtn="";
                                debugger;
                                if (selectedValue == "File Recieving" && list.isPrintEnabled == true) {
                                    printbtn = '<a class="fa fa-print fa-2x " onclick="PrintFileRecieving(' + list.id + ')"></a>';
                                }
                                else if (selectedValue == "File Recieving") {
                                    printbtn = '';
                                }
                                else{
                                    printbtn = '<a class="fa fa-print fa-2x " onclick="Print(' + list.id + ')"></a>';
                                }
                                const requestDateTime = moment(list.createdOn).format('DD-MM-YYYY');
                                const filePrint = list.isFilePrint == true ? "Yes" : "No";
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.propertyNo + '</td>           ' +
                                    ' <td>' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.requestType + '</td>           ' +
                                    ' <td>' + list.receivedBy + '</td>           ' +
                                    ' <td>' + list.recieverCNIC + '</td>           ' +
                                    ' <td>' + filePrint + '</td>           ' +
                                    ' <td>' + requestDateTime + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a>' +
                                    printbtn + '</td>'+
                                    ' </tr>';

                                $("#requestTbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestTable').dataTable();
                    }
                }
            });
        }

        function SelectSinglePPS(id) {

            var url = "/api/FileVerification/GetClientFileVerificationRequest?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        debugger;
                        var result_User = response.data;
                        let memberImage = result_User.imageURL == "" ? "/img/placeholder-photo.svg" : result_User.imageURL;
                        let possessionstatus = result_User.stockCreation.possessionStatus == true ? "Yes" : "No";
                        let sendForApproval = "1";
                        let requestType = "File Recieving";

                        $("#Id").val(result_User.id);
                        $("#ImageURL").val(memberImage);
                        $("#PreviewUrl").attr("src", memberImage);
                        $("#RegistrationNo").val(result_User.stockCreation.registrationNo);
                        $("#PropertyNo").val(result_User.stockCreation.propertyNo);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberProfile.memberName);
                        $("#ConstrucationStatus").val(result_User.stockCreation.constructionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.stockCreation.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#RecieverMobile").val(result_User.recieverMobile);
                        $("#RecieverCNIC").val(result_User.recieverCNIC);
                        $("#RecieverFatherName").val(result_User.recieverFatherName);
                        $("#ReceivedBy").val(result_User.receivedBy);
                        $("#RequestType").val(requestType).prop("disabled", true);
                        $("#RequestType").trigger('change');
                        $("#SendForApproval").val(sendForApproval).prop("disabled", true);
                        $("#SendForApproval").trigger('change');

                        $("#StockCreationId").val(result_User.stockCreation.id);
                        PropertyDetail(result_User.stockCreation.id);
                        ShowAlert(result_User.stockCreation.id);
                        $("#MemberProfileId").val(result_User.memberProfileId);
                        const selectedsearch = $('#SearchRequestType').val();

                        if (selectedsearch === "File Recieving") {
                            $('#btnsubmit').prop('disabled', true);
                        }

                        if (result_User.isPrintEnabled) {
                            $('#btnprint').prop('disabled', false);
                        }
                        getjointmembers(result_User.stockCreationId.id);
                        $("#Atachmenttbody").empty();
                        $.each(response.data.clientFileVerificationAttachments, function (i, item) {

                            // set values
                            //let copyToTargetDocument = item.copyToTargetDocument == "" ? "/img/placeholder-photo.svg" : item.copyToTargetDocument;
                            //let attachmentDate = item.attachmentDate != "" ? (item.attachmentDate).split('T')[0] : "";
                            let copyToTargetDocument = item.copyToTargetDocument == "" ? "/img/placeholder-photo.svg" : item.document;

                            var rownumber = parseInt($("#Arownumber").val());
                            var LineId = rownumber;
