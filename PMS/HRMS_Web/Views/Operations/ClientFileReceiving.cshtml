        // image from header
        function UploadImageOnServer() 
        {
            var extension = $('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                // alert("");
                // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("error", "Sorry, invalid extension.");


                $('input[type=file]').val();
                $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = $("input[type=file]").get(0).files[0];
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {
                        $("#PreviewUrl").attr("src", reader.result);
                        $("#PreviewUrl").attr("href", reader.result);
                        $("#PreviewUrl").attr("target", "_blank");
                        $("#ImageURL").val(reader.result);
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        // image from body
        $('body').on('change', '.attachmentPath', UploadImageOnServerforAttachmenttbody);
        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                ResponseMessageModal("warning", "Sorry, invalid extension.");
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");

                return false;
            }
            else {
                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".attachmentName").val(file.name);
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('input[type=file]').get(0).files[0];
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() 
        {
            var file = new Object();

            var fileAttachmentArray = new Array();

            if ($("#Id").val()) {

                file.PreviousRecordId = parseInt($("#Id").val());
            }

            var SendForApproval = $('#SendForApproval').val() == 0 ? false : true;

            file.StockCreationId = $('#StockCreationId').val();
            file.MemberProfileId = $('#MemberProfileId').val();
            file.RecieverMobile = $('#RecieverMobile').val();
            file.RecieverCNIC = $('#RecieverCNIC').val();
            file.RecieverFatherName = $('#RecieverFatherName').val();
            file.RequestType = $('#RequestType').val();
            file.ImageURL = $('#ImageURL').val();
            file.ReceivedBy = $('#ReceivedBy').val();
            file.CreatedBy = $("#User_Id").val();
            file.ModifiedBy = $("#User_Id").val();
            file.LastModifiedUserName = $("#User_Name").val();
            file.SendForApproval = SendForApproval;
            file.IsPrintEnabled = false;
            file.IsFilePrint = false;
            file.CreatedOn = $("#documentDate").val();

            $('#Atachmenttbody tr').each(function () {
                var row = $(this);
                var attachment = new Object();
                attachment.DoucmentName = row.find('.attachmentName').val();
                attachment.Document = row.find('.CopyToTargetDocument').val();
                attachment.Remarks = row.find('.remarks').val();

                fileAttachmentArray.push(attachment);
            });

            file.ClientFileVerificationAttachments = fileAttachmentArray;

            var model = JSON.stringify(file);
            $('#loader').fadeIn();
            NProgress.start();
            NProgress.set(0.0);
            $('#btnsubmit').prop('disabled', true); //disble
            $.ajax({
                type: 'POST',
                url: `/api/FileVerification/SaveClientFileVerification`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    NProgress.done();
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                        $('#SubmitMR').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        // window.alert(response.message);
                    }
                }

            });
        }

