                            <ul class="nav nav-tabs">
                                <li class="nav-item active"><a class="nav-link active tab_clr" href="#Attachments" data-toggle="tab">Attachments</a></li>
                                <li class="nav-item "><a class="nav-link  tab_clr" href="#JointMember" data-toggle="tab">Joint Members</a></li>
                            </ul>

                            <br />
                            <div class="tab-content  mgbt-xs-20">
                                <div class="tab-pane active" id="Attachments">
                                    <div class="row mt-5">
                                        <div class="col-md-12">
