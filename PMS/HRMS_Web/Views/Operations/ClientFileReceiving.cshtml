                                        <input type="text" class="form-control"
                                               placeholder=" " name="Category" id="Category" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>Size</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " name="Size" id="Size" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>Possession Status</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " name="PossessionStatus" id="PossessionStatus" readonly />
                                    </div>
                                </div>
