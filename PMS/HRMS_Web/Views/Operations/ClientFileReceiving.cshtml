                            <div class="row">
                                <div class="col-sm-3">
                                    <label>Construcation Status</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " name="ConstrucationStatus" id="ConstrucationStatus" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <label>CNIC</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " name="CNIC" id="CNIC" disabled />
                                    </div>
