<partial name="~/Views/PartialPage/viewStock.cshtml" />
<partial name="~/Views/PartialPage/_alert.cshtml" />
<input type="text" id="userid" value="@Context.Session.GetString("ID")" class="hide" />
<input id="rownumberforid" class="hide" value="0" />
@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";
            GetRegStockBlocks();
            $("#propertyBindingForm").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    //PropertyNo: {
                    //    required: true
                    //},
                    //RegistrationNo: {
                    //    required: true
                    //}

                },

                errorPlacement: function (error, element) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    Swal.fire({
                        icon: 'warning',
                        title: 'Warning',
                        text: "Please Fill Data Properly",
                    });

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();

                }
            });
        });

        function refreshPage() {
            location.reload();
        }

        function GetRegStock(id) {

            GetRegStockBlocks();
            $("#rownumberforid").val(id);
            $("#registrationModalReg").modal("show");
        }

        function GetRegStockBlocks() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetRenumberRegistration`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        var datatabl = $('#registrationListReg').DataTable();
                        datatabl.destroy();
                        $("#registrationtbodyReg").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {

                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td class="cnic">' + list.cnic + '</td>       ' +
                                    ' <td class="memberName">' + list.memberName + '</td> ' +
                                    ' <td class="categoryName">' + list.categoryName + '</td> ' +
                                    ' <td class="blockName">' + list.blockName + '</td> ' +
                                    ' <td class="size">' + list.actualSize + '</td> ' +
                                    ' <td class="regStockId hide">' + list.id + '</td> ' +
                                    '<td class="id"><a class="btn btn-primary" onclick="SelectRegistration(this)">Select</a></td> </tr>';
                                $("#registrationtbodyReg").append(row);
                                sr++;
                            }
                        }

                        $('#registrationListReg').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(el) {
            var property = $(el).parents('tr').find(".propertyNo").text();
            var cnic = $(el).parents('tr').find(".cnic").text();
            var Registration = $(el).parents('tr').find(".registrationNo").text();
            var regStockId = $(el).parents('tr').find(".regStockId").text();
            var memberName = $(el).parents('tr').find(".memberName").text();
            var categoryName = $(el).parents('tr').find(".categoryName").text();
            var blockName = $(el).parents('tr').find(".blockName").text();
            var size = $(el).parents('tr').find(".size").text();
            var id = $(el).parents('tr').find(".id").text();
            var rownumber = $("#rownumberforid").val();

            $("#regNo_" + rownumber).val(Registration);
            $("#propNo_" + rownumber).val(property);
            $("#regStockId_" + rownumber).val(regStockId);
            $("#regsize_" + rownumber).val(size);
            $("#regcategory_" + rownumber).val(categoryName);
            $("#regblock_" + rownumber).val(blockName);
            $("#cnic_" + rownumber).val(cnic);
            $("#memberName_" + rownumber).val(memberName);
            PropertyDetail(regStockId);
            ShowAlert(regStockId);
            $("#registrationModalReg").modal("hide");
        }

        function AddRowRenumRow() {

            var rownumber = parseInt($("#rownumberJ").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberJ").val(rownumber);
            var row = '<tr id="J' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td style="width: 250px;"><a class="btn btn-primary btn-sm btn-theme" onclick="GetRegStock(' + rownumber + ')" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +
                '<td> <input readonly required id="regNo_' + rownumber + '" name="regNo_[' + rownumber + '].regNo_" class="form-control regNo_" /></td>' +
                '<td> <input readonly required id="propNo_' + rownumber + '" name="propNo_[' + rownumber + '].propNo_" class="form-control propNo_" /></td>' +
                '<td class="hide"> <input  id="regStockId_' + rownumber + '"  class="form-control regStockId" /></td>' +
                '<td> <input readonly  id="memberName_' + rownumber + '"  class="form-control memberName" /></td>' +
                '<td> <input readonly  id="cnic_' + rownumber + '"  class="form-control cnic" /></td>' +
                '<td> <input readonly  id="regblock_' + rownumber + '"  class="form-control regblock" /></td>' +
                '<td> <input readonly  id="regcategory_' + rownumber + '"  class="form-control regcategory" /></td>' +
                '<td> <input readonly  id="regsize_' + rownumber + '"  class="form-control regsize" /></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteRenumRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';
            $("#renumtbody").append(row);

        }

        function DeleteRenumRow(id) {
            $('#J' + id).remove();
            var rownumber = 1;
            $("#renumtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberJ").val(rownumber - 1);
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() {

            var bindingArray = new Array();

            $('#renumtbody tr').each(function () {

                var row = $(this);
                var bind = new Object();

                bind.RegStockId = row.find('.regStockId').val();

                bindingArray.push(bind);
            });
            var model = JSON.stringify(bindingArray);
            $('#sbbtn').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: 'POST',
                url: `/api/DeAllocation/SaveDeAllocation`,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: model,

                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $('#sbbtn').prop('disabled', false);
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
            // $('#sbbtn').prop('disabled', false); //enable
        }

    </script>
}