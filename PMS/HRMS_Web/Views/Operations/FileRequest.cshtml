<div class="hide">
    <div id="printdiv">
        <partial name="~/Views/PartialPage/_RecieptForPrint.cshtml" />
    </div>
</div>
<partial name="~/Views/PartialPage/_alert.cshtml" />
<partial name="~/Views/PartialPage/viewStock.cshtml" />
<partial name="~/Views/PartialPage/SearchPropertyModal.cshtml" />
<partial name="~/Views/PartialPage/_History.cshtml" />
<input class="hide" id="rownumber" value="0" />
<input class="hide" type="number" id="MemberProfileId" />
<input class="hide" type="number" id="StockCreationId" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberName: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
            GetPreviousRecords();
            $('#SubmitMR').prop('disabled', false);
        });

        function refreshPage() {
            location.reload();
        }

        $('#RequestType').change(function () {
            const RequestType = $(this).val();
            if (RequestType) {
                const obj = {
                    RequestType
                };

                getchargesdata(obj);
            }
        });

        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/FileVerification/GetAllFileRequest`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requesttbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                debugger;
                                const requestDateTime = moment(list.createdOn).format('DD-MM-YYYY, h:mmA');
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td>' + list.memberName + '</td>           ' +
                                    ' <td>' + list.cnic + '</td>           ' +
                                    ' <td>' + list.propertyNo + '</td>           ' +
                                    ' <td>' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.requestType + '</td>           ' +
                                    ' <td>' + requestDateTime + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a><a class="fa fa-print fa-2x" onclick="SelectSinglePPSPrint(' + list.id + ')"></a>' +
                                    '<a class="fa fa-trash-o fa-2x text-danger hide" onclick="DeleteSingleChargeSetup(' + list.id + ')"></a></td> </tr>';
                                //</tr>';
                                $("#requesttbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestlist').dataTable();
                    }
                }
            });

        }

        function SelectSinglePPS(id) {

            $('#SubmitMR').prop('disabled', true);

            var url = "/api/FileVerification/GeFileRequest?id=" + id + "";
            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#requestmodal").modal("hide");
                        let result_User = response.data;

                        const CnicExp = moment(result_User.memberProfile.cnicExpiryDate).format('DD-MM-YYYY');
                      
                        $("#Id").val(result_User.id);
                        $("#DocumentNo").val(result_User.id);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberProfile.memberName);
                        $("#RegistrationNo").val(result_User.stockCreation.registrationNo);
                        $("#PropertyNo").val(result_User.stockCreation.propertyNo);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#CNICExp").val(CnicExp);
                        $("#ConstrucationStatus").val(result_User.construcationStatus);
                        $("#PossessionStatus").val(result_User.possessionStatus);
                        $("#Size").val(result_User.size);
                        $("#Category").val(result_User.category);
                        $("#Block").val(result_User.block);
                        $("#RequestType").val(result_User.requestType).prop("disabled", true);
                        $("#RequestType").trigger('change');
                        $("#StockCreationId").val(result_User.stockCreationId);
                        $("#MemberProfileId").val(result_User.memberProfileId);

                        PropertyDetail(result_User.stockCreationId);
                        ShowAlert(result_User.stockCreationId);
                        LoadApprovalHistory(result_User.id);
                        getjointmembers(result_User.stockCreationId);


                        $("#Chargestbody").empty();
                        $.each(response.data.fileDocDupRequestedCharges, function (i, item) {

                            var rownumber = 1;

                            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                '<td> <input  class="form-control chargeName" disabled  value="' + item.chargeName + '" /></td>' +
                                '<td> <input  class="form-control rate" disabled style="text-align: right;" value="' + formatPKR(item.amount) + '" /></td>' +
                                '<td class="hide"> <input  class="form-control sapAccount" disabled  value="' + item.sapAccount + '" /></td>' +
                                '</tr>';
                            $("#Chargestbody").append(row);
                            rownumber++;
                        });
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                    }
                }
            });
        }

        function SelectSinglePPSPrint(id) {

            var url = "/api/FileVerification/GeFileRequest?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#requestmodal").modal("hide");
                        let result_User = response.data;

                        $(".id").text(result_User.id);
                        $(".registrationNo").text(result_User.stockCreation.registrationNo);
                        $(".buyerName").text(result_User.memberProfile.memberName);
                        $(".blockName").text(result_User.block);
                        $(".plotSize").text(result_User.size);

                        $(".tbodyinvoice").empty();
                        var amounttotal = 0;
                        $.each(response.data.fileDocDupRequestedCharges, function (i, item) {

                            var rownumber = 1;

                            var row = '<tr style="font-size: 7px" id="' + rownumber + '" DetailId="0"> ' +
                                '<td>' + rownumber + '</td>' +
                                '<td>' + item.chargeName + '</td>' +
                                '<td>' + item.amount + '</td>' +
                                '</tr>';

                            amounttotal = amounttotal + item.amount;
                            rownumber++;
                            $(".tbodyinvoice").append(row);
                            rownumber++;
                        });
                        $(".invoicetotal").text(amounttotal);
                        var amountinwords = numberToWords(amounttotal);
                        $(".amountinwords").text(amountinwords);
                        printInvoice();
                    }
                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                    }
                }
            });
        }

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResultForNDCById?stockId=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        debugger;
                        var result_User = response.data;
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        const cnicExpDate = moment(result_User.cnicExpiryDate).format('DD-MM-YYYY');
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberName);
                        $("#ConstrucationStatus").val(result_User.constructionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);
                        $("#CNIC").val(result_User.cnic);
                        $("#CNICExp").val(cnicExpDate);

                        const RequestType = $("#RequestType").val();
                        $("#StockCreationId").val(result_User.id);
                        $("#MemberProfileId").val(result_User.memberProfileId);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                        getjointmembers(result_User.id);

                        $("#registrationModal").modal("hide");
                        debugger;
                        if (RequestType) {
                            const obj = {
                                RequestType
                            };
                            getchargesdata(obj);
                        }
                    }
                }
            });
        }

