@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";
            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberName: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });

            GetAllPropertyLists();
            $('#submitt').prop('disabled', false);
        });

        function refreshPage() {
            location.reload();
        }

        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/FileVerification/GetFilterFileVerificationForNDC1`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                const requestDateTime = moment(list.createdOn).format('DD-MM-YYYY, h:mmA');
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.memberName + '</td>       ' +
                                    ' <td>' + list.cnic + '</td>       ' +
                                    ' <td>' + requestDateTime + '</td>           ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);
                                sr++;
                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }

        function redirectToAnotherPage() {
            window.location.href = '/FingerPrint/VerifyFingerPrint';

        }

        function SelectRegistration(id) {

            var url = "/api/FileVerification/GetFilterFileVerificationNDC1ById?ndcId=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var data = response.data;
                        let possessionstatus = data.possessionStatus == true ? "Yes" : "No";
                        $("#NDCNO").val(data.id);
                        $("#DocumentNo").val(data.id);
                        $("#RegistrationNo").val(data.registrationNo);
                        $("#RegistrationNo").val(data.registrationNo);
                        $("#PropertyNo").val(data.propertyNo);
                        $("#MemberName").val(data.memberName);
                        $("#CNIC").val(data.cnic);
                        $("#ConstrucationStatus").val(data.constracutionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(data.actualSize);
                        $("#Category").val(data.categoryName);
                        $("#Block").val(data.blockName);

                        $("#StockCreationId").val(data.stockId);
                        $("#DealerCode").val(data.dealerCode);
                        $("#MemberProfileId").val(data.memberProfileId);
                        PropertyDetail(data.stockId);
                        ShowAlert(data.stockId);
                        SelectCheckList(data.id);

                        $("#registrationModal").modal("hide");
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function SelectCheckList(id) {

            var url = "/api/Filter/GetFileVerificationNDC1CheckList?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {

                        $("#CheckListtbody").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            for (let item of relist) {

                                var rownumber = parseInt($("#Crownumber").val());
                                var LineId = rownumber;
                                rownumber = rownumber + 1;
                                $("#Crownumber").val(rownumber);

                                // set values
                                //let date = item.actionDateTime != "" ? (item.actionDateTime).split('T')[0] : "";
                                const date = moment(item.actionDateTime).format('DD-MM-YYYY');
                                var row = '<tr id="C' + rownumber + '">' +
                                    '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                    '<td> <input disabled class="form-control Department" value="' + item.userDesignation + '" /></td>' +
                                    '<td> <textarea disabled class="form-control Remarks">' + item.lastActionComment + ' </textarea></td>' +
                                    '<td> <input disabled class="form-control AlertNarration" value="' + item.approvalStatus + '" /></td>' +
                                    '<td> <input disabled class="form-control Date" value="' + date + '" /></td>' +
                                    '</tr>';
                                $("#CheckListtbody").append(row);
                            }
                        }
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Payment Plan',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function AddAtachmentRow() {

            var rownumber = parseInt($("#Arownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#Arownumber").val(rownumber);


            var row = '<tr id="A' + rownumber + '">' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input required type="file" class="form-control attachmentPath" name="attachmentPath[' + rownumber + ']" /><input  class="form-control CopyToTargetDocument hide" /></td>' +
                '<td> <input disabled  class="form-control attachmentName" /></td>' +
                '<td> <input type="date" class="form-control attachmentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" disabled/></td>' +
                '<td> <textarea  class="form-control remarks" ></textarea></td>' +
                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachmentItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +

                '</tr>';

            $("#Atachmenttbody").append(row);
        }

        function DeleteAttachmentItemRow(id) {
            $('#A' + id).remove();
            var rownumber = 1;
            $("#Atachmenttbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#Arownumber").val(rownumber - 1);
        }


        function AddAttorneyRow() {
            var rownumber = parseInt($("#AArownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#AArownumber").val(rownumber);


            var row = '<tr id="AA' + rownumber + '">' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input required class="form-control Name" name="Name[' + rownumber + ']" /></td>' +
                '<td> <input required class="form-control CNIC" name="CNIC[' + rownumber + ']" /></td>' +
                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttorneyRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';
            $("#PowerOfAttorneytbody").append(row);
        }
        function DeleteAttorneyRow(id) {
            $('#AA' + id).remove();
            var rownumber = 1;
            $("#PowerOfAttorneytbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#AArownumber").val(rownumber - 1);
        }

        // image from body
        $('body').on('change', '.attachmentPath', UploadImageOnServerforAttachmenttbody);
        function UploadImageOnServerforAttachmenttbody() {

            var row = $(this);
            var extension = row.parents('tr').find('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                ResponseMessageModal("warning", "Sorry, invalid extension.");
                var filepath = row.parents('tr').find('input[type=file]').val();
                row.parents('tr').find('input[type=file]').val("");

                return false;
            }
            else {
                var file = row.parents('td').find('input[type=file]').get(0).files[0];
                row.parents("tr").find(".attachmentName").val(file.name);
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        row.parents('td').find('.CopyToTargetDocument').val(reader.result);
                        row.parents('tr').find('.viewAttachment img').attr("src", reader.result);
                        row.parents('tr').find('input[type=file]').get(0).files[0];
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {
            var fileNDC1 = new Object();

            var NDC1PowerOfAtornyArray = new Array();
            var NDC1CheckListArray = new Array();
            var NDC1AttachmentArray = new Array();

            fileNDC1.StockCreationId = $('#StockCreationId').val();
            fileNDC1.MemberProfileId = $('#MemberProfileId').val();
            fileNDC1.CreatedBy = $("#User_Id").val();
            fileNDC1.ModifiedBy = $("#User_Id").val();
            fileNDC1.LastModifiedUserName = $("#User_Name").val();
            fileNDC1.CreatedOn = $("#documentDate").val();

            $('#Atachmenttbody tr').each(function () {

                var row = $(this);
                var attachment = new Object();
                attachment.DoucmentName = row.find('.attachmentPath').val();
                attachment.Document = row.find('.CopyToTargetDocument').val();
                attachment.Remarks = row.find('.remarks').val();

                NDC1AttachmentArray.push(attachment);
            });

            $('#PowerOfAttorneytbody tr').each(function () {

                var row = $(this);
                var power = new Object();
                power.Name = row.find('.Name').val();
                power.CNIC = row.find('.CNIC').val();

                NDC1PowerOfAtornyArray.push(power);
            });

            $('#CheckListtbody tr').each(function () {

                var row = $(this);
                var checkList = new Object();
                checkList.Department = row.find('.Department').val();
                checkList.Remarks = row.find('.Remarks').val();
                checkList.AlertNarration = row.find('.AlertNarration').val();
                checkList.Date = row.find('.Date').val();

                NDC1CheckListArray.push(checkList);
            });

            fileNDC1.FileVerificationNDC1PowerOfAttorey = NDC1PowerOfAtornyArray;
            fileNDC1.FileVerificationNDC1CheckList = NDC1CheckListArray;
            fileNDC1.FileVerificationNDC1Attachments = NDC1AttachmentArray;

            var model = JSON.stringify(fileNDC1);
            $('#submitt').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: 'POST',
                url: `/api/FileVerification/SaveFileVerificationNDC1`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else{
                        $('#submitt').prop('disabled', false); //disble
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
    </script>
    }
