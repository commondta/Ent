@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    MemberName: {

                        required: true
                    },
                    RequestType: {

                        required: true
                    },
                    TransferT: {

                        required: true
                    },
                    slotDate: {

                        required: true
                    },
                    availableHour: {

                        required: true
                    },
                    availableMintues: {

                        required: true
                    },
                    Outstation: {

                        required: true
                    },
                    day: {

                        required: true
                    }
                },

                errorPlacement: function (error, element) {
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
            GetPreviousRecords();
            $('#SubmitMR').prop('disabled', false);

            var id = $("#FileVerificationRequestAId").val();
            debugger;
            if (id > 0) {
                SelectSinglePPS(id);
                if ($("#FileVerificationRequestAId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#MemberNDC :input").prop("disabled", true);

                }
            }

        });

        function refreshPage() {
            location.reload();
        }

        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/FileVerification/GetAllFileVerificationRequest`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requesttbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                const requestDateTime = moment(list.createdOn).format('DD-MM-YYYY, h:mmA');
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td>' + list.memberName + '</td>           ' +
                                    ' <td>' + list.cnic + '</td>           ' +
                                    ' <td>' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.propertyNo + '</td>           ' +
                                    ' <td>' + requestDateTime + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a><a class="fa fa-print fa-2x" onclick="SelectSinglePPSForPrint(' + list.id + ')"></a>' +
                                    '<a class="fa fa-trash-o fa-2x text-danger hide" onclick="DeleteSingleChargeSetup(' + list.id + ')"></a></td> </tr>';
                                //</tr>';
                                $("#requesttbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestlist').dataTable();
                    }
                }
            });

        }

        function redirectToAnotherPage() {
            window.location.href = '/FingerPrint/VerifyFingerPrint';

        }

        function SelectSinglePPS(id) {

            $('#SubmitMR').prop('disabled', true);

            var url = "/api/FileVerification/GeFileVerificationRequest?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#requestmodal").modal("hide");
                        let result_User = response.data;

                        let CnicExp = moment(result_User.memberProfile.cnicExpiryDate).format("DD-MM-YYYY") || "";

                        $("#Id").val(result_User.id);
                        $("#DocumentNo").val(result_User.id);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberProfile.memberName);
                        $("#RegistrationNo").val(result_User.stockCreation.registrationNo);
                        $("#PropertyNo").val(result_User.stockCreation.propertyNo);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#CNICExp").val(CnicExp);
                        $("#ConstrucationStatus").val(result_User.construcationStatus);
                        $("#PossessionStatus").val(result_User.possessionStatus);
                        $("#Size").val(result_User.size);
                        $("#Category").val(result_User.category);
                        $("#Block").val(result_User.block);
                        $("#RecieverMobile").val(result_User.recieverMobile);
                        $("#RecieverCNIC").val(result_User.recieverCNIC);
                        $("#RecieverFatherName").val(result_User.recieverFatherName);
                        $("#ReceivedBy").val(result_User.receivedBy);
                        $("#StockCreationId").val(result_User.stockCreationId);
                        $("#MemberProfileId").val(result_User.memberProfileId);
                        PropertyDetail(result_User.stockCreationId);
                        ShowAlert(result_User.stockCreationId);
                        LoadApprovalHistory(result_User.id);

                        $("#Chargestbody").empty();
                        $.each(response.data.fileVerificationRequestCharges, function (i, item) {

                            var rownumber = 1;

                            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                '<td> <input  class="form-control chargeName" disabled  value="' + item.chargeName + '" /></td>' +
                                '<td> <input  class="form-control rate" disabled style="text-align: right;" value="' + formatPKR(item.amount) + '" /></td>' +
                                '<td class="hide"> <input  class="form-control sapAccount" disabled  value="' + item.sapAccount + '" /></td>' +
                                '</tr>';
                            $("#Chargestbody").append(row);
                            rownumber++;
                        });

                        $("#Atachmenttbody").empty();
                        $.each(response.data.fileVerificationAttachments, function (i, item) {

                            let ndcmemberImage = item.document == "" ? "/img/placeholder-photo.svg" : item.document;

                            var rownumber = parseInt($("#Arownumber").val());
                            var LineId = rownumber;
                            let existingrows = 2;
                            rownumber = rownumber + 1;
                            $("#Arownumber").val(rownumber);

                            var row = '<tr id="A' + rownumber + '">' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
