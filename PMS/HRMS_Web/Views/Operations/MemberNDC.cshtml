                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        let propertyNo = result_User.propertyNo ?? "N/A";
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(propertyNo);
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberName);
