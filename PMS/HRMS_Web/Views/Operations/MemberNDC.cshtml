        function SelectSinglePPS(id) {

            $('#SubmitMR').prop('disabled', false);

            var url = "/api/NDCRequestForMember/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#registrationModalFindMode").modal("hide");
                        let result_User = response.data;

                        let outstatioon = result_User.outstation == true ? "1" : "0";
                        let signVerification = result_User.signVerification == true ? "1" : "0";
                        let CnicExp = moment(result_User.memberProfile.cnicExpiryDate).format('DD-MM-YYYY');
                        let Selectdateforsloot = result_User.slotDate ? result_User.slotDate.split('T')[0] : "";
                        let validityDate = (result_User.validityDate).split('T')[0] ?? "";
                        let documentDate = (result_User.createdOn).split('T')[0] ?? "";

                        $("#category").val(result_User.stockCreation.category);

                        $("#Id").val(result_User.id);
                        $("#DocumentNo").val(result_User.id);
                        $("#RequestType").val(result_User.ndcRequestType);
                        $("#ApplyStation").val(result_User.applyStation);
                        $("#TransferPurpose").val(result_User.transferPurpose);
                        $("#BCApprovalRequired").val(result_User.bcApprovalRequired);
                        $("#OldTranser").val(result_User.oldTranser);
                        $("#RequestType").trigger('change');
                        $("#MembCode").val(result_User.memberProfileId);
                        $("#MembName").val(result_User.memberProfile.memberName);
                        $("#RegistrationNo").val(result_User.stockCreation.registrationNo);
                        $("#PropertyNo").val(result_User.stockCreation.propertyNo);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#CNICExp").val(CnicExp);
                        $("#Transfer").val(result_User.transferTypeID);
                        $("#Transfer").trigger('change');
                        $("#slotDate").val(Selectdateforsloot);
                        $('#availableHour').val(result_User.availableHour);
                        $('#availableMintues').val(result_User.availableMintues);
                        $("#ValidityDate").val(validityDate);
                        $("#Outstation").val(outstatioon);
                        $("#SignVerification").val(signVerification);
                        $("#day").val(result_User.day);
                        $("#ConstrucationStatus").val(result_User.construcationStatus);
                        $("#PossessionStatus").val(result_User.possessionStatus);
                        $("#Size").val(result_User.size);
                        $("#Category").val(result_User.category);
                        $("#Block").val(result_User.block);
                        $("#DealerCode").val(result_User.dealerCode);
                        $("#EstateName").val(result_User.estateName);
                        $("#DealerName").val(result_User.dealerName);
                        $("#StockCreationId").val(result_User.stockCreationId);
                        $("#MemberProfileId").val(result_User.memberProfileId);

                                          
                        $("#documentDate").val(documentDate);

                        //chargeswavieOff = result_User.stockCreation.discountPercent;
                        if (result_User.slotHour) {
                            populateHoursDropdown(result_User.slotHour);
                        }

                        if (result_User.slotMintues) {
                            populateMintuesDropdown(result_User.slotMintues);
                        }
                        //viewPropertyAndHistory(result_User.id,22,result_User.stockCreationId);
                        LoadApprovalHistory(result_User.id,22);
                        PropertyDetail(result_User.stockCreationId);
                        ShowAlert(result_User.stockCreationId);

                        $("#Atachmenttbody").empty();
                        $.each(response.data.ndcRequestForMemberAttachments, function (i, item) {

                            let ndcmemberImage = item.document == "" ? "/img/placeholder-photo.svg" : item.document;
                            let attachmentDate = (item.lastModified).split('T')[0] ?? "0001-01-01";
                            var rownumber = parseInt($("#Arownumber").val());
                            var LineId = rownumber;
                            let existingrows = 2;
                            rownumber = rownumber + 1;
                            $("#Arownumber").val(rownumber);

                            var row = '<tr id="A' + rownumber + '">' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <input required  type="file" class="form-control attachmentPath"  /><input  class="form-control CopyToTargetDocument hide"  value="' + ndcmemberImage + '" /></td>' +
                                '<td> <input disabled required name="attachmentName[' + rownumber + '].attachmentName" class="form-control attachmentName" value="' + item.doucmentName + '" /></td>' +
                                '<td> <input type="date" class="form-control attachmentDate" value="' + attachmentDate + '" disabled/></td>' +
                                '<td> <textarea class="form-control remarks">' + item.remarks + ' </textarea></td>' +
                                '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + ndcmemberImage + '" class="clickme" ></a></img></td>' +
                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachmentItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';
                            $("#Atachmenttbody").append(row);
                        });

                        $("#Chargestbody").empty();
                        var rownumber = 1;
                        $.each(response.data.ndcRequestForMemberCharges, function (i, item) {

                            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                '<td> <input  class="form-control chargeName" disabled  value="' + item.chargeName + '" /></td>' +
                                '<td> <input  class="form-control rate" style="text-align: right;" value="' + formatPKR(item.amount) + '" /></td>' +
                                '<td class="hide"> <input  class="form-control sapAccount" disabled  value="' + item.sapAccount + '" /></td>' +
                                '</tr>';
                            $("#Chargestbody").append(row);
                            rownumber++;
                        });

                        getjointmembers(result_User.stockCreationId);

                        $('#print').prop('disabled', false);

                        if (result_User.isCanceled) {
                            $('#SubmitMR').prop('disabled', true);
                        }
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                    }
                }
            });
        }

        function populateHoursDropdown(selectedValue) {
            $('#availableHour').empty();
            $('#availableHour').append($('<option>').text(selectedValue).attr('value', selectedValue));
        }
        function populateMintuesDropdown(selectedValue) {
            $('#availableMintues').empty();
            $('#availableMintues').append($('<option>').text(selectedValue).attr('value', selectedValue));
        }

        function GetAvailableHours(dayOfWeek, datePicker, hrr) {

            const requestType = $("#RequestType").val();
            const endpoint = (requestType === "Premium Transfer")
                ? "/api/Calendar/GetAvailableHours"
                : "/api/Calendar/GetAvailableHoursExecutive";

            const url = `${endpoint}?dayOfWeek=${dayOfWeek}&datePicker=${datePicker}`;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#availableHour").empty();
                        var row = ' <option value="">Select Hour</option> ';

                        $("#availableHour").append(row);

                        var relist = response.data;
                       
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list + '" >' + list + '</option> ';

                                $("#availableHour").append(row);
                                sr++;
                            }
                        }

                        $('#availableHour').select2();
                    }

                    if (hrr != undefined && hrr != null) {
                        $('#availableHour').select2('val', [hrr]);

                    }
                }
            });
        }

        function GetAvailableMintues(dayOfWeek, datePicker, hour, min) {

            const requestType = $("#RequestType").val();
            const endpoint = (requestType === "Premium Transfer")
                ? "/api/Calendar/GetAvailableMintues"
                : "/api/Calendar/GetAvailableMintuesExecutive";

            const url = `${endpoint}?dayOfWeek=${dayOfWeek}&datePicker=${datePicker}&hour=${hour}`;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#availableMintues").empty();
                        var row = ' <option value="">Select Mintues</option> ';

