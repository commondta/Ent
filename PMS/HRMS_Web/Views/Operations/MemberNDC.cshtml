        function GetDataFromSap(registrationNo, memberProfileId) {
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetCleareanceDatas`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { registrationNo, memberProfileId },
                success: function (response) {
                    if (response.code === 100) {
                        var rowIndex = 1;
                        let docTotal = 0, totalRecieved = 0, balanceDue = 0, totalSurcharge = 0;
                        let totalWaiveOff = 0, totalReceivable = 0;

                        $("#Cleartbody").empty();
                        $.each(response.data, function (i, item) {
                            var row = `<tr>
                                        <td>${rowIndex++}</td>
                                        <td>${item.accountName}</td>
                                        <td style="text-align: center;">${item.invoiceNo}</td>
                                        <td>${moment(item.dueDate).format("DD-MM-YYYY")}</td>
                                        <td style="text-align: right;">${formatPKR(item.invoiceAmount)}</td>
                                        <td style="text-align: right;">${formatPKR(item.surcharge)}</td>
                                        <td style="text-align: right;">${formatPKR(item.waiveOffApplied)}</td>
                                        <td style="text-align: right;"></td>
                                        <td style="text-align: right;">${formatPKR(item.totalAmountReceivable)}</td>
                                        <td style="text-align: center;">${item.settleDocNum}</td>
                                        <td>${moment(item.settleDate).format("DD-MM-YYYY")}</td>
                                        <td style="text-align: right;">${formatPKR(item.receivedAmount)}</td>
                                        <td style="text-align: right;">${formatPKR(item.finalBalance)}</td>
                                        <td>${item.remarks ?? ""}</td>
                                    </tr>`;

                            $("#Cleartbody").append(row);
                            docTotal += item.invoiceAmount;
                            totalSurcharge += item.surcharge;
                            totalWaiveOff += item.waiveOffApplied;
                            totalReceivable += item.totalAmountReceivable;
                            totalRecieved += item.receivedAmount;
                            balanceDue += item.finalBalance;
                        });

                        // Add summary row
                    }
                }
            });
        }

        function findAmountForSurcharge(checkDate, list) {
            for (var i = 0; i < list.length; i++) {
                var currentDateRange = list[i];
                if (checkDate >= currentDateRange.fromDate && checkDate <= currentDateRange.toDate) {
                    return currentDateRange.totalSurCharge;
                }
            }
            return 0; // Return null if no matching range is found
        }



        function formatPKR(value) {
            var roundedValue = Math.round(value);
            var formattedValue = roundedValue.toLocaleString('en-PK').replace(/Rs/g, '');
            return formattedValue;
        }

        function GetSurcharge(fromdate, todate, callback) {
            var url = "/api/SurchargeSetup/GetSurchageInRange?fromdate=" + fromdate + "&todate=" + todate;

            $.ajax({
                type: "GET",
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                success: function (response) {

                    if (response.code == 100) {
                        if (response.data != null) {
                            callback(response.data);
                        }
                    }
                }
            });
        }
