@section Scripts {
    
    <script>
       $(document).ready(function () {
            "use strict";
            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
             
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
           GetAllFindModePropertyLists();
        });

        function refreshPage() {
            location.reload();
        }

        function GetAllFindModePropertyLists() {

            $('#proplistFindNDC1Mode').DataTable({
                ajax: {
                    url: "/api/SP/GetAllModeNDC1",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    { data: "formattedDateTime", name: "DateTime" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a class="fa fa-print fa-2x" onclick="Print(${data.id},'${data.memberNdcId}')"></a>
                                    <a class="fa fa-edit fa-2x" onclick="SelectFind(${data.id})"></a>`;
             
                        }
                    }
                ]
            });
        }

        function Print(id, memberNdcId) {

            var methodType = 'GET';
            var url = "/api/NDC1/GetPrint?Id=" + id + "";
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                 headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {
                    if (response.code == 100) {

                        var printdata = response.data;
                        let ndcdatee = "";

                        let printDateVal = $('#printDate').val();

                        let finalDate = "";

                        if (printDateVal) {
                            finalDate = printDateVal;
                        } else {
                            finalDate = printdata.ndcDate.split('T')[0]; 
                        }

                        const dateObj = new Date(finalDate);

                        const options = { day: '2-digit', month: 'short', year: 'numeric' };
                        ndcdatee = dateObj.toLocaleDateString('en-GB', options);


                        $('.referenceNo').text(printdata.registrationNo);
                        $('.plotNo').text(printdata.propertyNo);
                        $('.memberName').text(printdata.memberName);
                        $('.membershipNo').text(printdata.membershipNo);
                        $('.sector').text(printdata.sector);
                        $('.phase').text(printdata.phase);
                        $('.docNo').text(memberNdcId);
                        $('.docDate').text(ndcdatee);

                        printInvoice();
                    }
                }
            });
        }

        function printInvoice() {
            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }

        function SelectFind(id) {

            var url = "/api/NDC1/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#registrationModalNDC1FindMode").modal("hide");


                        $('#sbbtn').prop('disabled', true); //disble
                        $('#btnDiscard').prop('disabled', true); //disble
                       
                        var data = response.data;

                        let processing = data.processing == true ? "Yes" : "No";
                        let possessionstatus = data.possessionStatus == true ? "Yes" : "No";
                        let atDealer = data.dealerCode != null ? "Yes" : "No";
                        let propertyNo = data.propertyNo ?? "N/A";

                        let slot = data.slot ? data.slot : "";
                        let slotDate = data.slotDate ? data.slotDate.split('T')[0] : "";

                        $("#RequestType").val(data.ndcRequestType);
                        $("#Processing").val(processing);
