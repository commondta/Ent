<partial name="~/Views/PartialPage/SearchPropertyModal.cshtml" />
<input class="hide" id="rownumber" value="0" />
<input class="hide" type="number" id="MemberProfileId" />
<input class="hide" type="number" id="StockCreationId" />
@section Scripts {
        <script type="text/javascript">
            
                    $('#loader').fadeOut();

            $(document).ready(function () {
                "use strict";

                GetAllNDCRequestTypes();
                GetAllNDCTransferTypes();
                GetAllPropertyLists();
            });


            
            
            function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/DemarcationRequest/GetAllDemarcationFilterList`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        debugger;
                        $("#Propertytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td class="propertyNo">' + list.propertyNo + '</td>           ' +
                                    ' <td class="registrationNo">' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.type + '</td>       ' +
                                    ' <td>' + list.realStateType + '</td>       ' +
                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                //</tr>';
                                $("#Propertytbody").append(row);


                                sr++;

                            }
                        }

                        $('#proplist').dataTable();
                    }
                }
            });
        }
            function SelectRegistration(id) {

            //       var realEstateId = id;
            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";

            debugger;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var result_User = response.data;
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MembCode").val(result_User.memberProfile.id);
                        $("#MembName").val(result_User.memberProfile.memberName);
                        $("#CNIC").val(result_User.memberProfile.cnic);
                        $("#CNICExp").val(result_User.memberProfile.cnicExpiryDate);

                        $("#StockCreationId").val(result_User.id);
                        $("#MemberProfileId").val(result_User.memberProfile.id);
  
                        $("#registrationModal").modal("hide");
                    }

                    else {


                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });


                        //window.alert(response.message);
                    }
                }
            });

        }
            function AddAtachmentRow() {

                    var rownumber = parseInt($("#Arownumber").val());
                    var LineId = rownumber;
                    rownumber = rownumber + 1;
                    $("#Arownumber").val(rownumber);


                    var row = '<tr id="A' + rownumber + '">' +
                        '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                        '<td> <input type="file" class="form-control attachmentPath" /><input  class="form-control imagefile hide" /></td>' +
                        '<td> <input  class="form-control attachmentName" /></td>' +
                        '<td> <input type="date" class="form-control attachmentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" disabled/></td>' +
                        '<td> <input  class="form-control remarks" /></td>' +
                        '<td class="viewAttachment" style="padding-top:10px"><a><img style="width:100px" src="/img/placeholder-photo.svg" class="clickme" ></a></img></td>' +

                        '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteAttachmentItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +

                        '</tr>';


                    $("#Atachmenttbody").append(row);


                }
            

        function PostRequest() {
            debugger;
            
            $('#SubmitDR').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: 'POST',
                url: `/api/NDCRequestForMember/AddNewNDCRequestForMember`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                    debugger;
                    $('#loader').fadeOut();
                    if (response.code === 100) {

                        //notification("bottomleft", "success", "fa fa-check-circle vd_green", "Success", response.message);
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        $("#Chargestbody").empty();
                        $("#Atachmenttbody").empty();
                        $("#rownumber").val(0);
                        window.location.reload(true);
                    }
                }
            });
            
            $('#SubmitDR').prop('disabled', true); //disble
        }
        </script>

         <script>
            $(document).ready(function(){
                $("#propertybinding").change(function(){
                    $(this).find("option:selected").each(function(){
                        var optionValue = $(this).attr("value");
                        if(optionValue){
                            $(".box").not("." + optionValue).hide();
                            $("." + optionValue).show();
                        } else{
                            $(".box").hide();
                        }
                    });
                }).change();
            });
          </script>
    }
