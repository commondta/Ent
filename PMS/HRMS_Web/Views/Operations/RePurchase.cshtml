        function GetAllCategories(rowno, propcat) {
            debugger;
            var url = "/api/StockCreation/GetAllCategories";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#category_" + rowno).empty();
                        var row = ' <option value="">-- Select Category --</option> ';

                        $("#category_" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#category_" + rowno).append(row);
                                sr++;

                            }
                        }

                        $('#category_' + rowno).select2();

                        if (propcat != null && propcat != undefined) {
                            $('#category_' + rowno).select2("val", [propcat])
                        }
                    }
                }
            });
        }

