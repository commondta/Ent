@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";
           
            $("#RePurchase").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegNo: {
                        required: true
                    },
                    PropertyNo: {
                        required: true
                    },

                },

                errorPlacement: function (error, element) {
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("form-control")) {
                        error.insertAfter(element);
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();

                }
            });
           
            GetAllPropertiesLists();
            GetPreviousRecords();
        });
        function printInvoice() {
         //   $("@@media print{<link rel='stylesheet' href='https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css'><style>.hide{display:none}.boldtext{font-size: 12px;font-weight: 500;}.f14{font-size: 12px;}</style>}").appendTo('head');
            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=600,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);

            setTimeout(() => { // Needed for large documents

                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000)
            
        }
        function refreshPage() {
            location.reload();
        }

        $("#Purchase_RefundValue").on("input", function () {
            var marketValue = parseFloat($("#MarketValue").val());
            var purchaseRefundValue = parseFloat($(this).val());
            var netProfitLoss = marketValue - purchaseRefundValue;
            $("#NetProfit_Loss").val(netProfitLoss);
        });

        $('#typeofForm').change(function () {

            var selectedValue = $(this).val();
            if (selectedValue === 'Cancellation') {
                $('#rowPlan').attr('disabled', 'disabled');
                $('#divisiontbody').empty();
            } else {
                $('#rowPlan').removeAttr('disabled');
            }
        });
         $('body').on('change', '.DeductionPercentage', Calculatetotals);
        function Calculatetotals() {
            debugger;
            var totaldeduction = 0;
            var totalrecieved = $("#TotalReceived").val();
            $('#financetbody tr').each(function() {



                var row = $(this);
                var deductionpercentage = row.find(".DeductionPercentage").val();
                if (deductionpercentage > 0) {
                    var recievedamount = row.find(".AmountRecieved").val();
                    var deductionamount = (recievedamount*deductionpercentage) / 100;
                    totaldeduction = totaldeduction + deductionamount;
                }

            });
            $("#DeductionAmount").val(totaldeduction);
            $("#Balance").val(totalrecieved - totaldeduction);

        }
    </script>

    <script>

        function GetAllPropertiesLists() {


            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function SelectRegistration(id) {

            debugger;

            var url = "/api/Surrender/GetFilterProperty?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;

                        // set values
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";
                        let bookingDate = moment(result_User.bookingDate).format('DD-MM-YYYY'); 

                        $("#Id").val(result_User.id);
                        $("#DocNo").val(result_User.id);
                        $("#Dealer").val(result_User.estateName);
                        $("#BookingDate").val(bookingDate);
                        $("#RegNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MemberCode").val(result_User.memberCode);
                        $("#MemberName").val(result_User.memberName);
                        $("#ConstrucationStatus").val(result_User.constracutionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);

                        $("#stockCreationId").val(result_User.id);
                        $("#registrationModal").modal("hide");
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);
                        GetFinance(result_User.registrationNo,result_User.memberCode);
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        // selection stockcreationId end

        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/Repurchase/GetAllRequest`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        $("#requesttbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var date = new Date(list.createdOn).toLocaleDateString("en-GB");
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td>' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.propertyNo + '</td>           ' +
                                    ' <td>' + list.type + '</td>           ' +
                                    ' <td>' + date + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a>' +
                                    '<a class="fa fa-print fa-2x text-danger" onclick="Printfunc(' + list.id + ')"></a><a class="fa fa-times fa-2x" style="color: red;" onclick="CancelRequest(' + list.id + ')"></a></td> </tr>';
                                //</tr>';
                                $("#requesttbody").append(row);
                                sr++;
                            }
                        }

                        $('#requestlist').dataTable();
                    }
                }
            });
        }

        function SelectSinglePPS(id) {

            $('#Submitp').prop('disabled', true);

            var url = "/api/Repurchase/GetRequest?id=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

