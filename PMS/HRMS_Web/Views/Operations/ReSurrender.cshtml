@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

            $('#registrationList').dataTable();
            $('#DealerCodemodal').dataTable();
            $('#historyList').dataTable();

            $("#ReSurrender").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegNo: {

                        required: true
                    },
                    EstateName: {

                        required: true
                    },
                    DealerName: {

                        required: true
                    },
                    resurrenderdateinput: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });

            GetAllSurrenderLists();
            GetAllDealerProfiles();

            $("#dealersearchbtn").prop('disabled', true);

        });
    </script>

    <script>
        function refreshPage() {
            location.reload();
        }
        // selection stockcreationId start
        function GetAllSurrenderLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetAllSurrenderAvailableForReSurrender`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#registrationtbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {


                            var sr = 1;
                            for (let list of relist) {

                                //set values
                                let resurrenderDate = list.resurrenderDate != "" ? (list.resurrenderDate).split('T')[0] : "";

                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
                                    ' <td >' + list.propertyNo + '</td>           ' +
                                    ' <td >' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.principalOwner + '</td>       ' +
                                    ' <td>' + resurrenderDate + '</td>       ' +
                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                $("#registrationtbody").append(row);
                                sr++;
                            }
                        }

                        $('#registrationList').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(id) {

            debugger;

            var url = "/api/Surrender/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;

                        // set values

                        const resurrenderDate = moment(result_User.resurrenderDate).format('DD-MM-YYYY');
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";

                        $("#Id").val(result_User.id);
                        $("#DocNo").val(result_User.id);
                        $("#RegNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MemberCode").val(result_User.memberCode);
                        $("#MemberName").val(result_User.memberName);
                        $("#SurrenderDate").val(resurrenderDate);
                        $("#EstateCode").val(result_User.estateName);
                        $("#EstateName").val(result_User.estateName);
                        $("#DealerName").val(result_User.dealerName);
                        $("#DealerCode").val(result_User.dealerId);
                        $("#Status").val(result_User.status);
                        $("#Remarks").val(result_User.remarks);

                        $("#ConstrucationStatus").val(result_User.constracutionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);

                        $("#stockCreationId").val(result_User.stockCreationId);
                        $("#dealerId").val(result_User.dealerId);
                        $("#dealersearchbtn").prop('disabled', false);
                        $("#registrationModal").modal("hide");
                        PropertyDetail(result_User.stockCreationId);
                        ShowAlert(result_User.stockCreationId);
                        GetHistory(result_User.stockCreationId);
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        // selection stockcreationId end

        // Get History

        function GetHistory(id) {

            debugger;

            var url = "/api/Filter/GetSurrenderHistory?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        $("#historytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {

                            debugger;
                            var sr = 1;
                            for (let list of relist) {

                                //set values
                                const resurrenderDate = moment(list.resurrenderDate).format('DD-MM-YYYY');
                                const createdOn = moment(list.createdOn).format('DD-MM-YYYY');
                          

                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
