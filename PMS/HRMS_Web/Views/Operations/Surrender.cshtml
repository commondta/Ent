<partial name="~/Views/PartialPage/_alert.cshtml" />
<partial name="~/Views/PartialPage/viewStock.cshtml" />
<partial name="~/Views/PartialPage/_History.cshtml" />
<input type="number" id="stockCreationId" value="" class="hide" />
<input type="number" id="dealerId" value="" class="hide" />
<input type="number" id="DealerCode" value="" class="hide" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

            $("#Surrender").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {

                        required: true
                    },
                    DealerName: {

                        required: true
                    },
                    DealerName: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        customClass: 'swal-wide',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });

            $('#registrationList').dataTable();
            $('#DealerCodemodal').dataTable();

            GetAllPropertyLists();
            GetAllDealerProfiles();

        });
    </script>

    <script>

        function refreshPage() {
            location.reload();
        }

        // selection stockcreationId start
        function GetAllPropertyLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetAllPropertiesAvailableSurrender`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#registrationtbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                const requestDateTime = moment(list.createdOn).format('DD-MM-YYYY, h:mmA');
                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
                                    ' <td >' + list.propertyNo + '</td>           ' +
                                    ' <td >' + list.registrationNo + '</td>           ' +
                                    ' <td>' + list.memberName + '</td>       ' +
                                    ' <td>' + list.mobile + '</td>       ' +
                                    ' <td>' + requestDateTime + '</td>           ' +
                                    ' <td>' + list.status + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectRegistration(' + list.id + ')">Select</a></td> </tr>';
                                $("#registrationtbody").append(row);
                                sr++;
                            }
                        }

                        $('#registrationList').dataTable();
                    }
                }
            });
        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetAllPropertiesAvailableSurrenderById?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;
                        let possessionstatus = result_User.possessionStatus == true ? "Yes" : "No";

                        $("#DocNo").val(result_User.id);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(result_User.propertyNo);
                        $("#MemberCode").val(result_User.memberCode);
                        $("#MemberName").val(result_User.memberName);
                        $("#dealerId").val(result_User.dealerId);
                        $("#EstateCode").val(result_User.dealerCode);
                        $("#DealerCode").val(result_User.dealerCode);
                        $("#DealerName").val(result_User.dealerName);
                        $("#EstateName").val(result_User.estateName);
                        $("#stockCreationId").val(result_User.id);
                        $("#ConstrucationStatus").val(result_User.constracutionStatus);
                        $("#PossessionStatus").val(possessionstatus);
                        $("#Size").val(result_User.actualSize);
                        $("#Category").val(result_User.categoryName);
                        $("#Block").val(result_User.blockName);
                        ShowAlert(result_User.id);
                        PropertyDetail(result_User.id);

                        $("#registrationModal").modal("hide");                    
                        LoadApprovalHistory(result_User.id);

                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        // selection stockcreationId end

        // selection dealerId start
        function GetAllDealerProfiles() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Dealer/GetFilterListForPreSale`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        $("#Dealertbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + sr + '</td> ' +
                                    ' <td>' + list.principalOwner + '</td>' +
                                    ' <td>' + list.estateName + '</td>' +
                                    '<td><a class="btn btn-primary" onclick="SelectDealer(' + list.id + ')">Select</a></td> </tr>';
                                $("#Dealertbody").append(row);
                                sr++;
                            }
                        }

                        $('#dealerlist').dataTable();
                    }
                }
            });
        }

        function SelectDealer(id) {

            var url = "/api/Dealer/GetDealerNDC?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;

                        $("#DealerCode").val(result_User.id);
                        $("#dealerId").val(result_User.id);
                        $("#EstateCode").val(result_User.estateName);
                        $("#EstateName").val(result_User.estateName);
                        $("#DealerName").prop("readonly", false);
                        $("#DealerName").val("");
                        $("#DealerName").prop("readonly", true);
                        GetAllEstateMember(result_User.id);
                        $("#dealerModal").modal("hide");
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Dealer");
                    }
                }
            });
        }

        function GetAllEstateMember(id) {

            $.ajax({
                type: 'GET',
                url: "/api/Dealer/GetAllEstateMembers?id=" + id + "",
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        $("#DealerEstateMembertbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                const isPrimary = list.isPrimary == true ? 'Yes' : 'No';
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + sr + '</td> ' +
                                    ' <td class="name">' + list.name + '</td>' +
                                    ' <td class="description">' + list.description + '</td>' +
                                    ' <td class="isPrimary">' + isPrimary + '</td>' +
                                    '<td><a class="btn btn-primary" onclick="SelectEstate(this)">Select</a></td> </tr>';
                                $("#DealerEstateMembertbody").append(row);
                                sr++;
                            }
                        }

                        $('#dealerEstateMemberlist').dataTable();
                    }
                }
            });
        }

        function SelectEstate(el) {

            var name = $(el).parents('tr').find(".name").text();
            $("#DealerName").val(name);
            $("#dealerEstateMemberModal").modal("hide");
        }
        // selection dealerId end


        function UploadImageOnServer() {

            debugger;
            var extension = $('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                // alert("");
                // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("error", "Sorry, invalid extension.");


                $('input[type=file]').val();
                $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = $("input[type=file]").get(0).files[0];
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {
                        $("#PreviewUrl").attr("src", reader.result);
                        $("#PreviewUrl").attr("href", reader.result);
                        $("#PreviewUrl").attr("target", "_blank");
                        $("#ImageURL").val(reader.result);
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() {

            var methodType = 'POST';
            var url = "/api/Surrender/AddNewSurrender";
            var surrender = new Object();

            //if ($("#Id").val()) {
            //    PaymemtPlan.Id = parseInt($("#Id").val());
            //    methodType = 'PUT';
            //url = "/api/AdvanceApplication/UpdateAdvanceApplication"
            //}

            surrender.DealerId = $("#dealerId").val();
            surrender.StockCreationId = $("#stockCreationId").val();
            surrender.ResurrenderDate = $("#ReSurDate").val();
            surrender.ImageURL = $("#ImageURL").val();
            surrender.ExpiryDays = $("#ExpDays").val();
            surrender.DealerName = $("#DealerName").val();
            surrender.EstateName = $("#EstateName").val();
            surrender.Status = $("#Status").val();
            surrender.Remarks = $("#Remarks").val();
            surrender.CreatedOn = $("#Docdate").val();
            surrender.CreatedBy = $("#User_Id").val();
            surrender.ModifiedBy = $("#User_Id").val();
            surrender.LastModifiedUserName = $("#User_Name").val();
            surrender.CreatedOn = $("#documentDate").val();

            var ModelData = JSON.stringify(surrender);
            debugger;
            $('#sbbtn').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                data: ModelData,
                contentType: 'application/json',
                success: function (response) {

                    debugger;

                    $('#loader').fadeOut();
                    if (response.code == 100) {

                        Swal.fire('Saved', response.message, 'success').then((result) => {
                            if (result.isConfirmed) {
                               // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }

                    else {
                        $('#sbbtn').prop('disabled', false);
                        // notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Something went wrong");
                        // window.alert(response.message);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

    </script>

