        // Combine Image
        function UploadImageOnServer() {

            
            var extension = $('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                // alert("");
               // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("error", "Sorry, invalid extension.");


                $('input[type=file]').val();
                $("#combineImagePreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = $("input[type=file]").get(0).files[0];
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {
                        $("#combineImagePreviewUrl").attr("src", reader.result);
                        $("#combineImagePreviewUrl").attr("href", reader.result);
                        $("#combineImagePreviewUrl").attr("target", "_blank");
                        $("#ImageURL").val(reader.result);
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

