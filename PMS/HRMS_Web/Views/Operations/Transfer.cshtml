                success: function (response) {

                    var printdata = response;

                    $(".ppropertyNo").text(printdata.propertyNo);
                    $(".pregistrationNo").text(printdata.registrationNo);

                    var detailsstring = "";
                    $(".pmemberNameAndDetails").text("");

                    var count = printdata.memberNames.length;
                    $.each(printdata.memberNames, function (i, item) {
                        var comma = count - 1 == i ? "" : ",";
                        detailsstring += item.memeberName + " " + item.cnic + " " + item.relationName + " " + item.relationhipwith + " " + comma + " ";
                    });

                    if (count < 3) {
                        $(".pmemberNameAndDetails").empty();
                        $('.messcountmembersdiv').hide();
                        $('.lesscountmembersdiv').show();
                        $('.lesscountmembersdiv').find('.pmemberNameAndDetails').text(detailsstring);
                    } else {
                        $(".pmemberNameAndDetails").empty();
                        $('.lesscountmembersdiv').hide();
                        $('.messcountmembersdiv').show();
                        $('.messcountmembersdiv').find('.pmemberNameAndDetails').text(detailsstring);
                    }


                    $(".ppermanentAddress").text(printdata.permanentAddress);
                    $(".pblock").text(printdata.block);
                    $(".pbuyerPhone").text(printdata.buyerPhone);
                    $(".pmembershipNo").text(printdata.membershipNo);
                    $(".ptype").text(printdata.type);
                    $(".parea").text(printdata.area + " " + printdata.unitArea);
                    //$("#psqft").text(Math.round(printdata.area * 225));
                    $(".psqryard").text(printdata.area);
                    $(".pcategory").text(printdata.category);
                    $(".pcnic").text(printdata.buyerCnic);
                    $(".pllot").text(printdata.nature);
                    $(".InternalNo").text(printdata.internalNo);
                    $(".psector").text(printdata.sectorName);
                    $(".pphase").text(printdata.phase);
                    $(".ptitle").text(printdata.title);
                    $(".pPlotNo").text(printdata.plotNo);
                    $(".pSignatoryRank").text(printdata.signatoryRank);
                    $(".pSignatoryDesignation").text(printdata.signatoryDesignation);
                    $(".pSignatoryName").text(printdata.signatoryName);
                    $(".pbuyerDetail").text(printdata.buyerDetail);
                    var date = new Date(printdata.letterDate);
                    var options = { day: 'numeric', month: 'short', year: 'numeric' };
                    $(".pppdate").text(date.toLocaleDateString('en-GB', options));

                    $(".qrcode").empty();
                    $(".imgContainerForPrint").empty();

                    var Adress = printdata.permanentAddress;
                    var Name = printdata.buyerName;
                    var RegistrationNo = printdata.propertyNo;
                    let udno = printdata.block;

                    var qrcodeContent = "BWP" + "/" + RegistrationNo + "/" + udno;
                    $(".RefNum").text(qrcodeContent);

                    $(".qrcode").each(function () {
                        $(this).empty(); 
                        new QRCode(this, {
                            text: qrcodeContent,  
                            width: 90,
                            height: 90
                        });
                    });

                    $.each(printdata.images, function (i, item) {

                        var row = '<img style="width: 100%;height:100%;margin: 0px" src="' + item.imageUrl + '"alt="" /> ';
                        // var row = '<img style="max-width: 100%;height: auto;margin: 0px;box-sizing: border-box;" src="/img/products/01.jpg"alt="" /> ';
                        $(".imgContainerForPrint").append(row);

                    });

                    $(".ptext").text("purchased");
                    $(".pPropertyNo").text(printdata.propertyNo);
                    $(".swapOverStatement").text(printdata.swapOverStatement);

                    if (printdata.transferType == 'Hiba Transfer') {
                        $(".ptext").text("been gifted");
                    }

                    var actionText = (printdata.transferType === 'Hiba Transfer') ? "been gifted" : "purchased";
                    var propNo = (printdata.propertyNo === "") ? printdata.propertyNo : printdata.plotNo

                    var statement = `The Management of N-Stack is pleased to inform that you have <b>${actionText}</b> a <b>${printdata.type}</b> <b>${printdata.nature}</b> <b>${printdata.category}</b> (<b>${printdata.area}</b> Square Yards) in phase <b>${printdata.phase}</b>, <b>${propNo}</b>, Sector-<b>${printdata.sectorName}</b>, N-Stack from <b><u>${printdata.buyerDetail}</u></b>. ${printdata.swapOverStatement || ""}`;

                    var finalStatement = (printdata.statement && printdata.statement.trim() !== "")
                        ? printdata.statement
                        : statement;

                    $(".pStatement").html(finalStatement);

                    if (printdata.legalHeireType === "50 Percent Share Hiba") {                      
                        $("#content1").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetter50percentshareHiba");
                    }
                    else if (printdata.legalHeireType === "Through Court Case") {
                        $("#content2").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetterthroughCourtCase");
                    }
                    else if (printdata.legalHeireType === "Through Court Representative") {
                        $("#content3").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetterthroughCourtRepresentative");
                    }
                    else if (printdata.legalHeireType === "Through Nadra") {
                        $("#content4").html(printdata.lagalHeireContent);
                        printInvoice("printdivlegalHeirtransferLetterthroughNadra");
                    }
                    else if (printdata.nature === "Villa") {
                        printInvoice("printdivtransferLetterVilla");
                    } else if(printdata.constructionStatus.trim() === "Constructed") {
                        printInvoice("printdivtransferLetterConstructedHouse");
                    } else if (printdata.propertyNo.trim() !== "" && printdata.unitArea && printdata.category.includes("Kanal")) {
                        printInvoice("printdivtransferLetterWithPlotNo");
                    } else if (printdata.propertyNo === "" && printdata.unitArea && printdata.category.includes("Kanal")) {
                        printInvoice("printdivtransferLetterWithoutPlotNo");
                    }else if (printdata.propertyNo.trim() !== "") {
                        printInvoice("printdivtransferLetterWithPlotNoBelowKanal");
                    } else if (printdata.propertyNo === "") {
                        printInvoice("printdivtransferLetterWithoutPlotNoBelowKanal");
                    }
                    printInvoice();
