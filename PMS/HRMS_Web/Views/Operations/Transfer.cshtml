        function GetHistory(id) {


            var url = "/api/Filter/GetTransferHistory?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#historytbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {


                            var sr = 1;
                            for (let list of relist) {

                                //set values
                                let date = list.transferDate != "" ? (list.transferDate).split('T')[0] : "";
                                let sellerName = list.sellerName != null ? list.sellerName : "N/A";
                                let sellerCnic = list.sellerCNIC != null ? list.sellerCNIC : "N/A";

                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
                                    ' <td>' + date + '</td>       ' +
                                    ' <td >' + sellerName + '</td>' +
                                    ' <td >' + sellerCnic + '</td>' +
                                    ' <td >' + list.buyerName + '</td>' +
                                    ' <td >' + list.buyerCNIC + '</td>' +
                                    ' <td >' + list.source + '</td>';
                                $("#historytbody").append(row);
                                sr++;
                            }
                        }

                        $('#historyList').dataTable();

                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

