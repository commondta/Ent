                        $("#MemberCode").val(result_User.id);
                        $("#MemberStatus").val(result_User.memberStatus);
                        $("#HusbandName").val(result_User.relationshipWith);
                        $("#Gender").val(result_User.gender);
                        $("#CNIC").val(result_User.cnic);
                        $("#ExpDate").val(cnicExp);
                        $("#MembershipNo").val(result_User.membershipno);
                        $("#PassportNo").val(result_User.passportNo);
                        $("#DOB").val(dob);
                        $("#PassExpDate").val(passExpDate);
                        $("#PerAddress").val(result_User.permanentAddress);
                        $("#CurrentA").val(result_User.currentAddress);
                        $("#Country").val(result_User.countryOfResidence);
                        $("#City").val(result_User.cityOfResidence);
                        $("#Nationality").val(result_User.nationality);

                    }

                    else {

                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding");
                    }
                }
            });

        }

