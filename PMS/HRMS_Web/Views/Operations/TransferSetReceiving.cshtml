            var row = '<tr id="A' + rownumber + '">' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input required type="file" name="attachmentName[' + rownumber + '].attachmentPath" class="form-control attachmentPath" /><input  class="form-control CopyToTargetDocument hide" /></td>' +
