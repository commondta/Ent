@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";

            $("#MemberNDC").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegistrationNo: {

                        required: true
                    },
                    slotDate: {

                        required: true
                    },
                    availableHour: {

                        required: true
                    },
                    availableMintues: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
            GetPreviousRecords();
        });

        function refreshPage() {
            location.reload();
        }

        function Print(id) {
           
            var methodType = 'GET';
            var url = "/api/TransferSetReceiving/GetTransferSetReceivingPrint?Id=" + id + "";
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {
                    if (response.code == 100) {

                        var printdata = response.data;
                   
                        let drpTime = printdata.depositTime != "" ? (printdata.depositTime).split('T')[1] : "";
                        let drpextTime = drpTime !== "" ? convertTo12HourFormat(drpTime.split('.')[0]) : "";
                        const format = d =>
                            d ? new Date(d).toLocaleDateString('en-GB').replace(/\//g, '-') : "";

                        let ndcdatee = format(printdata.ndcDate);
                        let recDate =printdata.receivingDate;

                        $("#regNop").text(printdata.registrationNo || "");
                        $("#sectorp").text(printdata.sector || "");
                        $("#TransferTypep").text(printdata.transferType || "");
                        $("#NameOfSellerp").text(printdata.memberName || "");
                        $("#DealerNamep").text(printdata.dealerName || "");
                        $("#DealerCodep").text(printdata.dealerCode || "");
                        $("#ReceivingDatep").text(recDate || "");
                        $("#Deptimep").text(drpextTime || "");
                        $("#NdcDatep").text(printdata.ndcClearedOn || "");
                        $("#Depositorp").text(printdata.depositor || "");
                        $("#pSlotDate").text(printdata.slotDate || "");
                        $("#pSlot").text(printdata.slot || "");
                        printInvoice();
                    }
                }
            });
        }

        function convertTo12HourFormat(time) {
           
            const [hours, minutes, seconds] = time.split(':');
            const period = hours >= 12 ? 'PM' : 'AM';
            const adjustedHours = hours % 12 || 12; // Convert 0 to 12
            return `${adjustedHours}:${minutes} ${period}`;
        }


        function printInvoice() {
            var printContents = document.getElementById('printdiv').innerHTML;
            var mywindow = window.open(printContents, 'PRINT', 'height=500,width=600');
            let printElement = document.getElementById('printdiv');
            var printWindow = window.open('', 'PRINT');
            printWindow.document.write(document.documentElement.innerHTML);
            setTimeout(() => { // Needed for large documents
                printWindow.document.body.style.margin = '0 0';
                printWindow.document.body.innerHTML = printElement.outerHTML;
                printWindow.document.close(); // necessary for IE >= 10
                printWindow.focus(); // necessary for IE >= 10*/
                printWindow.print();
                printWindow.close();
            }, 1000);
        }


        function GetPreviousRecords() {
            $('#proplistFindMode').DataTable({
                ajax: {
                    url: "/api/SP/GetAllFindModeTransferSet",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    { data: "status", name: "Status" },
                    { data: "formattedDateTime", name: "DateTime" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="fa fa-print fa-2x " onclick="Print(' + data.id + ')"></a>' +
                                   '<a class="fa fa-edit fa-2x" onclick = "SelectSinglePPS(' + data.id + ')" > </a>';
                        }
                    }
                ]
            });
        }

        function SelectSinglePPS(id) {

            var url = "/api/TransferSetReceiving/GetTransferSetReceiving?id=" + id;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',

                success: function (response) {

                    if (response.code === 100) {

                        $("#registrationModalFindMode").modal("hide");

                        let result_User = response.data;

                        let slotDate = result_User.slotDate ? result_User.slotDate.split('T')[0] : "";
                        let effectiveDateTimee = result_User.validateDate
                            ? result_User.validateDate.split('T')[0]
                            : "";

                        $("#Id").val(result_User.id);
                        $("#DocumentNo").val(result_User.id);

                        $("#MembCode").val(result_User.memberProfile?.id ?? "");
                        $("#MembName").val(result_User.memberProfile?.memberName ?? "");

                        $("#RegistrationNo").val(result_User.stockCreation?.registrationNo ?? "");
                        $("#PropertyNo").val(result_User.stockCreation?.propertyNo ?? "");

                        $("#ApplyStation").val(result_User.applyStation ?? "");
                        $("#CNIC").val(result_User.memberProfile?.cnic ?? "");

                        $("#ConstrucationStatus").val(result_User.construcationStatus ?? "");
                        $("#PossessionStatus").val(result_User.possessionStatus ?? "");

                        $("#Size").val(result_User.size ?? "");
                        $("#Category").val(result_User.category ?? "");
                        $("#SetReceivingStatus").val(result_User.setReceivingStatus ?? "");
                        $("#Block").val(result_User.block ?? "");

                        $("#StockCreationId").val(result_User.stockCreation?.id ?? "");
                        $("#MemberProfileId").val(result_User.memberProfile?.id ?? "");

                        $("#availableMintues").val(result_User.slotMintues ?? "");
                        $("#availableHour").val(result_User.slotHour ?? "");

                        $("#date").val(slotDate);
                        $("#slotDate").val(slotDate);
                        $("#Day").val(result_User.day ?? "");

                        $("#effectiveDateTime").val(effectiveDateTimee);

                        $("#TransferType").val(result_User.transferType ?? "");
                        $("#NDCRequestType").val(result_User.ndcRequestType ?? "");

                        $("#propertyTaxYears").val(result_User.propertyTaxYear ?? "");

                        $("#DealerCode").val(result_User.dealerCode ?? "");
                        $("#DealerName").val(result_User.dealerName ?? "");
                        $("#EstateName").val(result_User.estateName ?? "");

                        $("#Depositor").val(result_User.depositor ?? "");

                        LoadApprovalHistory(result_User.id);
                        PropertyDetail(result_User.stockCreation?.id);
                        ShowAlert(result_User.stockCreation?.id);

                        // ============================
                        // Attachments
                        // ============================

                        $("#Atachmenttbody").empty();
                        $("#Arownumber").val(0);

                        $.each(result_User.attachments || [], function (i, item) {

                            let imagePath = item.document
                                ? item.document
                                : "/img/placeholder-photo.svg";

                            let attachmentDate = item.lastModified
                                ? item.lastModified.split('T')[0]
                                : "0001-01-01";

                            var rownumber = parseInt($("#Arownumber").val()) + 1;
                            $("#Arownumber").val(rownumber);

                            var row =
                                '<tr id="A' + rownumber + '">' +
                                '<td><input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td>' +
                                '<input type="file" class="form-control attachmentPath"/>' +
                                '<input class="form-control CopyToTargetDocument hide" value="' + imagePath + '"/>' +
                                '</td>' +
                                '<td><input disabled class="form-control attachmentName" value="' + item.doucmentName + '"/></td>' +
                                '<td><input type="date" class="form-control attachmentDate" value="' + attachmentDate + '" readonly/></td>' +
