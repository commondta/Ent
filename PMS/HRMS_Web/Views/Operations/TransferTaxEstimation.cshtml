                        $("#ConstructionStatus").val(result_User.constructionStatus);
                        $("#Block").val(result_User.blockName);
                        $("#Category").val(result_User.categoryName);
                        $("#CoverArea").val(result_User.coveredArea);
                        $("#MemberName").val(result_User.sellerName);
                        $("#SellerFiler").val(result_User.filer);
                        $("#constructedyears").val(result_User.timeAgo);
                        $("#propertyTaxYears").val(result_User.propertyTaxYear);
                        ShowAlert(result_User.stockCreationId);
                        PropertyDetail(result_User.stockCreationId);
                        const FBRTAX236C = false;
                        const StockId = result_User.stockCreationId;
                        const CategoryId = result_User.categoryId;
                        const ConstracutionStatus = result_User.constructionStatus;
                        const PropertyTypeId = result_User.propertyTypeId;
                        const NatureId = result_User.natureId;
                        const Filer = result_User.filer;
                        const PropertyTaxYears = result_User.propertyTaxYear;

                        $("#category").val(result_User.categoryId);
                        $("#type").val(result_User.propertyTypeId);
                        $("#nature").val(result_User.natureId);
