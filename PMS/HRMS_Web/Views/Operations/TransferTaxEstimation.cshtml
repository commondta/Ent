        function printReciept(id) {
            var typeofprint = $("#printType").val();
            var id = id;
            var url = "/api/TransferReceiptProcessing/PrintReceipt";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id, type: typeofprint },
                async: false,
                contentType: 'application/json',
                success: function (response) {

