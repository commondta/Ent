        function getsellerchargesdata(obj) {

            $("#sellerTaxestbody").empty();

            var ModelData = JSON.stringify(obj);
            let url = "/api/GlobalChargesSetup/GetGlobalChargeDetailForSellerGovtTaxes?formId=10"
            debugger;
            $.ajax({
                type: "POST",
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    debugger;
                    if (response.code == 100) {
                        if (response.data != null) {
                            var rownumber = 1;

                            $.each(response.data.globalChargeDetail, function (i, item) {
                                var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                    '<td> <input disabled class="form-control line" disabled value="' + rownumber + '"/></td>' +
                                    '<td> <input  class="form-control chargeName" disabled  value="' + item.description + '" /></td>' +
                                    '<td> <input  class="form-control rate" disabled style="text-align: right;" value="' + formatPKR(item.rate) + '" /></td>' +
                                    '<td class="hide"> <input  class="form-control sapAccount" disabled  value="' + item.sapAccount + '" /></td>' +
                                    '</tr>';
                                $("#sellerTaxestbody").append(row);
                                rownumber++;
                            });
                        }
                        else {
                            Swal.fire(
                                'warning!',
                                'Charge Detail Not Found',
                                'warning'
                            )
                        }
                    }
                }

            });
        }

