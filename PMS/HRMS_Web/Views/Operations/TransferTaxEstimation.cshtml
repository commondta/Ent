                        var result = response.data;
                        console.log(result);
                        $(".id").text(result.id);
                        $(".registrationNo").text(result.registrationNo);
                        $(".buyerName").text(result.buyerName);
                        $(".blockName").text(result.blockName);
                        $(".plotSize").text(result.plotSize);
                        $(".tbodyinvoice").empty();

                        var relist;
                        if (typeofprint == "Seller")//tbodyinvoice
                        {
                            relist = result.govtSellerCharges;
                        }
                        else {
                            relist = result.govtBuyerCharges;
                        }
                        var amounttotal = 0;
                        var sr = 1;
                        for (let list of relist) {
                            var row = ' <tr style="font-size: 7px"> ' +
                                ' <td  style="text-align: center;">' + sr + '</td> ' +
                                //' <td  style="text-align: center;">' + list.id + '</td>           ' +
                                ' <td>' + list.chargeName + '</td>           ' +
                                ' <td>' + list.amount + '</td>       ' +
                                ' </tr>';
                            $(".tbodyinvoice").append(row);
                            amounttotal = amounttotal + list.amount;
                            sr++;
                        }
                        $(".invoicetotal").text(amounttotal);
                        var amountinwords = numberToWords(amounttotal);
                        $(".amountinwords").text(amountinwords);
                        printInvoice();

