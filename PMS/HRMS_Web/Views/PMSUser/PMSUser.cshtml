@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {


            $("#PMSUserForm").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    username: {
                        minlength: 5,
                        maxlength: 50,
                        required: true
                    },
                    employeename: {
                        required: true
                    },
                    employeecode: {
                        required: true
                    },
                    cnic: {
                        required: true

                    },

                    designation: {
                        required: true
                    },

                    fathername: {
                        required: true
                    },
                    Department: {
                        required: true
                    },

                    Status: {
                        required: true
                    }

                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'error',
                        text: 'Enter Valid Form Data',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });


                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SubmitRequest();
                }

            });
            $("#PMSUserFormPassword").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    Pusername: {

                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'error',
                        text: 'Enter Valid Form Data',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });


                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SubmitPassword();
                }

            });

            GetUserList();
            GetAllDepartments();
        });

        function GetUserList() {
            var url = "/api/PMSUser/GetAll";
            debugger;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        var relist = response.data;
                        var datatabl = $('#Promotion').DataTable();
                        datatabl.destroy();
                        $("#promotetbody").empty();
                        if (relist != null && relist.length > 0) {
                        var sr = 1;
                        for (let list of relist) {
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td>' + list.emP_FULL_NAME + '</td>' +
                                    '<td>' + list.emP_FATHER_NAM + '</td>' +
                                    '<td>' + list.departmenT_DESC + '</td>' +
                                    '<td>' + list.desiG_DESC + '</td>' +
                                    '<td>' + list.niC_NO + '</td>' +
                                    '<td><a class="fa fa-edit fa-2x" title="Edit User" style="margin-right:10px" onclick="SelectEachPromotion(' + list.id + ')" ></a>' + '<a title="Change Passsword" class="fa fa-key fa-2x" style="margin-left:10px" onclick = "PasswordUpdate(' + list.id + ')" > </a>'+
                                    // <a title="Remove User" class="fa fa-trash-o fa-2x text-danger" onclick = "ConfirmBlock(' + list.id + ')" > </a>
                                    '</td>' +
                                    '</tr>';
                                $("#promotetbody").append(row);
                                sr++;

                        }
                        
                        $('#Promotion').DataTable();
                         }
                    }
                }
            });
        }

      function  PasswordUpdate(id){

            var url = "/api/PMSUser/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var promotion = response.data;
                        let status = promotion.isActive == true ? "1" : "0";

                        $("#myModalp").modal("show");

                        $("#ID").val(promotion.id);
                        $("#Pusername").val(promotion.username);
                        $("#Ppassword").val(promotion.password);
                        $("#designation").val(promotion.desiG_DESC);
                        $("#Department").val(promotion.departmenT_DESC);
                        $("#Department").trigger('change');
                        $("#fathername").val(promotion.emP_FATHER_NAM);
                        $("#employeecode").val(promotion.emP_CODE);
                        $("#cnic").val(promotion.niC_NO);
                        $("#employeename").val(promotion.emP_FULL_NAME);
                        $("#Status").val(status);
                        $("#SubmitButtonn").text("Save Changes");
                        $("#myModalLabell").text("Update User Credentials");

                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding user',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });


        }

        function GetAllDepartments() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Department/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Department").empty();
                        var row = ' <option value="">-- Select Department --</option> ';

                        $("#Department").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';
                                $("#Department").append(row);

                                sr++;
                            }
                        }
                    }
                }
            });
        }

        //editeachpromotion

        debugger;
        function SelectEachPromotion(id) {

            var url = "/api/PMSUser/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var data = response.data;
                        let status = data.isActive == true ? "1" : "0";

                        $("#myModal").modal("show");

                        $("#ID").val(data.id);
                        $("#username").val(data.username);
                        $("#designation").val(data.desiG_DESC);
                        $("#Department").val(data.departmenT_DESC);
                        $("#Department").trigger('change');
                        $("#fathername").val(data.emP_FATHER_NAM);
                        //$("#password").val(data.password);
                        $("#employeecode").val(data.emP_CODE);
                        $("#employeename").val(data.emP_FULL_NAME);
                        $("#cnic").val(data.niC_NO);
                        $("#Status").val(status);
                        $("#SubmitButton").text("Update");
                        $("#myModalLabel").text("Edit User");
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding User',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function openmodalAdd() {
            $("#ID").val("");
            $("#username").val("");
            $("#designation").val("");
            $("#fathername").val("");
            $("#password").val("");
            $("#employeecode").val("");
            $("#Department").val("");
            $("#cnic").val("");
            $("#employeename").val("");
            $("#status").val("-1");
            $("#status").trigger("change");
            $("#SubmitButton").text("Save");
            $("#myModalLabel").text("Add New User");

        }

        function SubmitPassword(){
            debugger;
            let status = $("#Status").val() == 1 ? true : false;

            var methodType ;
            var url ;

            var user = new Object();


              if ($("#ID").val() != "") {
                debugger;
                user.id = parseInt($("#ID").val());
                methodType = 'POST';
                url = "/api/PMSUser/UpdateUserPassword"
            }

            user.LastModifiedUserName = 'SuperAdmin';//$("#User_Name").val();
            user.CreatedBy = 1;//$("#userid").val();
            user.ModifiedBy = 1;//("#userid").val();
            user.Username = $("#Pusername").val();
            user.Password = $("#Ppassword").val();
            user.DESIG_DESC = $("#designation").val();
            user.EMP_FATHER_NAM = $("#fathername").val();
            user.EMP_CODE = $("#employeecode").val();
            user.SHIFT_DESC = "G";
            user.PAY_CC_DESC = "Site Staff (Services)";
            user.NIC_NO = $("#cnic").val();
            user.JOINING_DATE = "abc";
            user.PAY_ORG_DESC = "Urban Developers";
            user.EMP_FULL_NAME = $("#employeename").val();
            user.IsActive = status;
            user.DEPARTMENT_DESC = $("#Department").val();
            user.EMP_BANK_ACC_NO = "00000000";

            var ModelData = JSON.stringify(user);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    debugger;

                    $('#loader').fadeOut();
                    console.log(response);
                    if (response.code === 100) {

                        $("#PMSUserFormPassword").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModalp").modal("hide");
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else if (response.code === 4) {
                        debugger;
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $("#PMSUserFormPassword").submit(function (e) {
                            e.preventDefault();
                        });
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }

            });
        }

