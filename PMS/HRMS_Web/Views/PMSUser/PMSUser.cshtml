<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="margin-top: 12%;">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Add New User</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <form id="PMSUserForm" class="form-horizontal">
            <div class="modal-body">
       
                    <div class="container">
                        <div class="row">
                            <div class="col-sm-6">
                                <label>User Name  <small style="color:red">*</small></label>
                                <input type="text" id="username" name="username" />
                            </div>

                            <div class="col-sm-6">
                                <label>Password </label>
                                
                               <input type="password" id="password" class="form-control" name="password" />
                            </div>

                            <div class="col-sm-6">
                                <label>Employee Name  <small style="color:red">*</small></label>
                                <input type="text" id="employeename" name="employeename" />
                            </div>
                            
                            <div class="col-sm-6">
                                <label>Father Name  <small style="color:red">*</small></label>
                                <input type="text" id="fathername" class="form-control" name="fathername" />
                            </div>

                            <div class="col-sm-6">
                                <label>Employee Code  <small style="color:red">*</small></label>
                                <input type="text" onkeypress="validateNumberInput(event)" id="employeecode" name="employeecode" />
                            </div> 
                            
                            <div class="col-sm-6">
                                <label>CNIC  <small style="color:red">*</small></label>
                                <input type="text" onkeypress="validateNumberInput(event)" id="cnic" name="cnic" />
                            </div>

                            <div class="col-sm-6">
                                <label>Department  <small style="color:red">*</small></label>
                                <div>
                                    <select class="js-example-basic-single" name="Department" id="Department">
                                        <option value=""> -- Select Department --</option>
                                    </select>
                                </div>

                            </div>
                            
                                <div class="col-sm-6">
                                    <label>Designation  <small style="color:red">*</small></label>
                                    <input type="text" id="designation" class="form-control" name="designation" />
                                </div>
                            <div class="col-sm-6">
                                <label>Status  <small style="color:red">*</small></label>
                                <div>
                                    <select class="js-example-basic-single" name="Status" id="Status">
                                        <option value="-1"> Select Option </option>
                                        <option value="1">Active</option>
                                        <option value="0">In-Active</option>
                                    </select>
                                </div>

                            </div>
                        </div>
                    
                    </div>
                    <br />        
            </div>
                    <div class="modal-footer background-login">
                        <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                        <button id="SubmitButton" type="submit" class="btn btn-primary btn-theme">Save</button>
                    </div>

            </form>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

