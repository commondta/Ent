<style>
    #registrationModal .modal-dialog {
        max-width: 100%;
        width: 100%
    }
</style>
<div class="modal" id="registrationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title">Select Registration Or Property No.</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <table id="proplist" class="table table-bordered table-hover mb-0" style="width:100%">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white">ID</th>
                                            <th class="text-white">Property No.</th>
                                            <th class="text-white">Registration No.</th>
                                            <th class="text-white">Membership No.</th>
                                            <th class="text-white">Member Name</th>
                                            <th class="text-white">CNIC</th>
                                            <th class="text-white">Relationship With</th>
                                            <th class="text-white">Phase</th>
                                            <th class="text-white">Block</th>
                                            <th class="text-white">Category</th>
                                            <th class="text-white">Property Type</th>
                                            <th class="text-white">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>

            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";


            GetPreviousRecords();

        });

        function GetPreviousRecords() {
            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllFindModeTransferSet",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    { data: "status", name: "Status" },
                    { data: "formattedDateTime", name: "DateTime" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="fa fa-print fa-2x " onclick="Print(' + data.id + ')"></a>' +
                                '<a class="fa fa-edit fa-2x" onclick = "SelectSinglePPS(' + data.id + ')" > </a>';
                        }
                    }
                ]
            });
        }

    </script>
}
