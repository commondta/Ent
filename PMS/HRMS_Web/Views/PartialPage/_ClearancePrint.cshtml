
<link media="print" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
<style>
    /* ================= PRINT SETTINGS ================= */
    @@media print {
        @@page {
            size: A4 landscape;
            margin: 0mm;
        }

        body {
            margin: 0;
        }
    }

    #tbodyPrint th, #tbodyPrint td {
        font-size: 15px;
        padding: 0px;
    }

    #headertableforprint td {
        font-size: 15px;
        padding: 0px;
        font-weight: 400;
        text-align: left;
    }

    #headertableforprint th {
        font-size: 15px;
        font-weight: 500;
        padding: 0px;
        text-align: left;
    }
</style>

<div class="container mt-2 pt-2">
    <div class="row mb-2 pb-2">
        <div class="col-sm-3">
            <img class="img-fluid" src="~/img/n-stack-logo.png" />
        </div>
        <div class="col-md-7 text-center">
            <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check2-circle" viewBox="0 0 16 16"><path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0"/><path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0z"/></svg></span>
                    <h1>
                N-Stack
            </h1>
            <h3>Member Account Statement</h3>
        </div>
    </div>
    <div class="row">

        <div class="col-md-12">
            <table class="table table-bordered w-100" id="headertableforprint">
                <tr>
                    <th>Member Id :</th>
                    <td id="PMemberId"></td>
                    <th>Member Name :</th>
                    <td id="PMemberName"></td>
                </tr>
                <tr>
                    <th>Registration Number :</th>
                    <td id="PRegistrationNumber"></td>
                    <th>Property Number :</th>
                    <td id="PPropertyNumber"></td>
                </tr>
                <tr>
                    <th>Category :</th>
                    <td id="PCategory"></td>
                    <th>Block :</th>
                    <td id="PBlock"></td>
                </tr>
                <tr>
                </tr>
                <tr>
                    <th>Construction Status :</th>
                    <td id="PCStatus"></td>
                    <th>Possession Status :</th>
                    <td id="PStatus"></td>
                </tr>
                @* <tr>
                    <th>Status :</th>
                    <td id="PRStatus"></td>
                </tr> *@
            </table>
        </div>


    </div>

    <div class="row">
        <div class="col-12 text-center" style="margin:10px 0;">
            <span style="font-size:18px;border-bottom:2px solid #000;font-weight:500">Details</span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <table style="background:lightgrey;color:#000" class="table table-bordered w-100 ">
                <thead>
                  
                    <tr>
                        <th class="text-white">#</th>
                        <th style="max-width:140px" class="text-white">Account Name</th>
                        <th style="max-width:120px" class="text-white">Description</th>
                        <th class="text-white">Invoice No.</th>
                        <th class="text-white">Due Date.</th>
                        <th class="text-white">Invoice Amount</th>
                        <th class="text-white">Balance Owed</th>
                        <th class="text-white">Settlement No.</th>
                        <th class="text-white">Settlement Date</th>
                        <th class="text-white">Recieved Amount</th>
                        <th class="text-white">Adjustment Amount</th>
                        <th class="text-white">Balance Due</th>
                        <th class="text-white">Surcharge</th>
                        <th class="text-white">WavieOff</th>
                        <th class="text-white">Surcharge Received Applied</th>
                        <th class="text-white">Total Amount Due</th>
                    </tr>
                    
                </thead>
                <tbody id="tbodyPrint"></tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-12 text-center" style="margin:10px 0;">
            <span style="font-size:18px;border-bottom:2px solid #000;font-weight:500">Summary</span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <table style="background:lightgrey;color:#000" class="table table-bordered w-100">
                <thead>
                    <tr>
                        <th style="font-size:12px">#</th>
                        <th style="font-size:12px;min-width:150px">Charge Type</th>
                        <th class="text-white">Total Balance Owed</th>
                        <th class="text-white">Total Recieved Amount</th>
                        <th class="text-white">Total Adjustment Amount</th>
                        <th class="text-white">Total Balance Due</th>
                        <th class="text-white">Total Surcharge</th>
                        <th class="text-white">Total WavieOff</th>
                        <th class="text-white">Total Surcharge Received Applied</th>
                        <th class="text-white">Total Amount Due</th>
                    </tr>
                </thead>
                <tbody id="summaryTableBodyPrint"></tbody>
            </table>

        </div>
    </div>

</div>