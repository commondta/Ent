<style>
    /* ================= PRINT SETTINGS ================= */
    @@media print {
        @@page {
            size: A4 landscape;
            margin: 0mm;
        }

        body {
            margin: 0;
        }
    }

    /* ================= LAYOUT ================= */
   

    /* Sr No column */
    .sr-col {
        width: 1.8ch;        /* single digit */
        max-width: 1.8ch;
        white-space: nowrap;
        text-align: center;
    }

    .officer-container {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .officer {
        flex: 1;
        margin: 5px;
        text-align: center;
    }

    /* Titles */
    .title,
    .title1 {
        font-size: 13px;
        border-bottom: 1px solid #000;
        padding-bottom: 5px;
        width: 70px;
        margin: 0 auto; /* centers under text */
    }

    .title1 {
        font-size: 12px;
    }

    .line {
        height: 1px;
        margin-bottom: 5px;
    }


    .details {
        font-size: 12px;
        margin-left: 33px;
        text-align: left;
        margin-top: 0;
    }

    .owner-details {
        display: block; /* default visible */
    }
</style>



