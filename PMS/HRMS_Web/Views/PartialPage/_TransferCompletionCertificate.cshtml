

<link media="print" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">




<div class="container-fluid" style="font-size:28px">
    <div class="row">
        <div class="col-3">
            <img class="img-fluid" src="~/img/n-stack-logo.png" alt="N-Stack logo">
        </div>
        <div class="col-9 text-center">
            <u>
                <h3 style="text-transform: uppercase;font-size:30px">Transfer Completion Certificate</h3>
            </u>
        </div>
    </div>

</div>

<div class="container-fluid" style="height:90%;border:2px solid #000;font-size:26px; border-style: double;">
    <div class="row mt-5">
        <div class="col-12">
           
            Dear Customer,<br> <br>
            <br>
            <ul>
                <li>
                    Your transfer process has been completed. Please collect your transfer letter after <span style="display:inline-block;width:100px;text-align:center;border-bottom:1px solid #000" id="printNoOfDays"></span>
                    Working days
                </li>
                <li>
                    For further tracking, your Reference Number <span style="display:inline-block;width:200px;text-align:center;border-bottom:1px solid #000" id="printReferenceNo"></span>, Plot No  <span style="display:inline-block;width:200px;text-align:center;border-bottom:1px solid #000" id="printplotNo"></span>,
                    Sec  <span style="display:inline-block;width:100px;text-align:center;border-bottom:1px solid #000" id="printSec"></span>, Name  <span style="display:inline-block;width:200px;text-align:center;border-bottom:1px solid #000" id="printName"></span> and CNIC is  <span style="display:inline-block;width:300px;text-align:center;border-bottom:1px solid #000" id="printCNICNo"></span>
                </li>
                <li>
                    Visit yourself along with original CNIC for collection of Transfer Letter.
                </li>
            </ul>
        </div>

    </div>

    <div class="row" style="padding-top:270px">
        <div class="col-8">
            <div style="padding-left:70px">
                <U>Sta</U> <span style="display:inline-block;width:200px;text-align:center;border-bottom:1px solid #000" id="printSta"></span>
                <br>        <br>        <br>        <br>
                Date:  <span>@DateTime.Now.ToString("dd-MM-yyyy")</span>
            </div>
        </div>
        <div class="col-4">
            <p>Transfer & Record Branch</p>
            <p>N-Stack</p>
        </div>
    </div>

</div>