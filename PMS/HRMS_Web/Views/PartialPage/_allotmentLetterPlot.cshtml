    <div class="row">
        <div class="col-sm-12 mt-2 mb-5" style="text-align:justify;">
            <ol style="padding-left:7px;">

                <!-- 1 -->
                <li style="padding-left:0.5rem;">
                    <p style="font-size:22px;">
                        The Management is pleased to inform that you have been allotted under mentioned
                        <span class="ptype"></span> Dated <span class="ppdate"></span> vide <u>
                            <b>
