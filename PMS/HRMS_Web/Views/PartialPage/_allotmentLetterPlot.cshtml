<style>
    #lesscountmembersdiv, #messcountmembersdiv {
        display: none;
    }

    ol {
        list-style-type: none;
        counter-reset: item;
        padding: 10px;
        margin: 0;
    }

        ol li {
            counter-increment: item;
            position: relative;
            margin: 0;
            padding: 0;
            line-height: 1.5;
        }

            ol li::marker {
                content: counter(item) ".";
                font-size: 24px;
                margin-right: 10px;
            }

            ol li p {
                font-size: 21px;
                margin: 0;
                padding: 0;
                line-height: 1.5;
            }

    table {
        width: 100%;
        border-collapse: collapse; /* Ensures table borders are merged */
    }

    tr {
        border-bottom: 10px solid transparent; /* Adds space between rows */
    }

    td {
        padding: 0px; /* Adds padding inside each cell */
    }
</style>


<div class="container" style="padding-left:70px;padding-right:75px;margin-top:255px; font-family: 'Times New Roman';">
    <div class="row">
        <div class="col-sm-4">
        </div>
        <div class="col-sm-4 text-center" style="font-size: 24px;">
            <u><b><p>Allotment Letter</p></b></u>
        </div>
        <div class="col-sm-4">
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-sm-4">
        </div>
        <div class="col-sm-4 text-center" style="font-size: 24px;">
        </div>
        <br />
        <div class="col-sm-4">
            <div style="font-size: 22px;">
                <span><b></b></span>
                <span style="
             margin-left: 10px;
            min-width: 160px;
            float: right;
          " class="pppdate">@DateTime.Now.ToString("dd MMMM, yyyy")</span>
                <div style="clear: both"></div>
            </div>
        </div>
    </div>

