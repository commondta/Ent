
<style>
    #lesscountmembersdiv, #messcountmembersdiv {
        display: none;
    }

    ol {
        list-style-type: none;
        counter-reset: item;
        padding: 0;
        margin: 0;
    }

        ol li {
            counter-increment: item;
            position: relative;
            margin: 0;
            padding: 0;
            line-height: 1;
        }

            ol li::marker {
                content: counter(item) ".";
                font-size: 24px;
                margin-right: 10px;
            }

            ol li p {
                font-size: 21px;
                margin: 0;
                padding: 0;
                line-height: 1;
            }

    table {
        width: 100%;
        border-collapse: collapse; /* Ensures table borders are merged */
    }

    tr {
        border-bottom: 10px solid transparent; /* Adds space between rows */
    }

    td {
        padding: 0px; /* Adds padding inside each cell */
    }

    /* Subject */
    .subject {
        margin-top: 20px;
        font-size: 21px;
    }

    /* Paragraphs */
    .content {
        margin-top: 15px;
        font-size: 21px;
        text-align: justify;
        padding-right: 80px;
    }

    /* Numbered points */
    .point {
        display: flex;
        margin-top: 10px;
        font-size: 121px;
    }

    .point-number {
        width: 20px;
        font-size: 21px;
    }

    .point-text {
        flex: 1;
        text-align: justify;
    }

    /* a,b,c table */
    .details {
        margin-top: 10px;
        margin-left: 20px;
        font-size: 21px;
    }

        .details div {
            display: flex;
            margin-bottom: 5px;
        }

        .details span:first-child {
            width: 200px;
        }
</style>


<div class="container" style="padding-left:70px;padding-right:75px;margin-top:255px; font-family: 'Times New Roman';">
