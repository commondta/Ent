<style>
    #lesscountmembersdiv, #messcountmembersdiv {
        display: none;
    }

    ol {
        list-style-type: none;
        counter-reset: item;
        padding: 10px;
        margin: 0;
    }

        ol li {
            counter-increment: item;
            position: relative;
            margin: 0;
            padding: 0;
            line-height: 1.5;
        }

            ol li::marker {
                content: counter(item) ".";
                font-size: 24px;
                margin-right: 10px;
            }

            ol li p {
                font-size: 21px;
                margin: 0;
                padding: 0;
                line-height: 1;
            }


    table {
        width: 100%;
        border-collapse: collapse; /* Ensures table borders are merged */
    }

        table td {
            padding-right: 40px;
        }

    tr {
        border-bottom: 10px solid transparent; /* Adds space between rows */
    }

    td {
        padding: 0px; /* Adds padding inside each cell */
    }
</style>


