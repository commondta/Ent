<style>
    @@page {
        size: A4;
        margin: 10mm;
    }

    body {
        font-family: Arial, sans-serif;
        color: #000;
    }

    .certificate {
        width: 100%;
        margin-bottom: 60px;
    }

    .title {
        text-align: center;
        font-weight: 800;
        font-size: 26px;
    }

    .subtitle {
        text-align: center;
        font-weight: 700;
        margin-top: 5px;
        text-decoration: underline;
    }

    .content {
        margin-top: 30px;
        font-size: 15px;
        line-height: 1.8;
    }

    .row {
        display: flex;
        margin-top: 8px;
        align-items: center;
    }

    .label {
        font-weight: 600;
        /* no border here */
        margin-right: 5px;
    }

    .value {
        min-width: 100px;
        padding: 0 5px;
        margin-right: 10px;
        text-align: center;
        border-bottom: 1px solid #000; /* underline all values */
    }

    .full-line {
        border-bottom: 1px solid #000;
        padding: 0 5px;
        min-width: 300px;
    }


    .footer {
        margin-top: 25px;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
    }

    .signature {
        text-align: center;
        margin-top: 110px;
        width: 220px;
    }

    .signature-checkedby {
        text-align: center;
        margin-top: 60px;
        width: 220px;
    }

    .signature-line {
        border-top: 1px solid #000;
        margin-bottom: 5px;
    }

    .divider {
        border-top: 1px dashed #000;
        margin: 40px 0;
    }
</style>




<!-- =================== COPY 1 =================== -->
<div class="certificate">

    <div class="title">N-STACK</div>
    <div class="subtitle">NO DEMAND CERTIFICATE</div>

    <div class="content">
        <p>
            <strong>1.</strong> Certified that all dues, as these stand today have been received for
        </p>

        <div class="row">
            <div>Ref No.</div>
            <div class="value referenceNo">002731</div>

            <div>Plot No.</div>
            <div class="value plotNo">002731</div>

            <div>Sector</div>
            <div class="value sector">OL</div>

            <div>Phase</div>
            <div class="value phase">01</div>
        </div>

        <div class="row">
            <div>Membership No</div>
            <div class="value membershipNo">OSMAM-001712</div>

            <div>Name</div>
            <div class="full-line value memberName">SAMINA UR REHMAN</div>
        </div>

        <p style="margin-top:15px">
            However the member will be required to pay any variation in development charges immediately on demand.
        </p>

        <p>
            <strong>2.</strong> The member shall be requested to pay any additional charges if the need so arises.
        </p>

        <div class="footer">
            <div>
                <div>No. <span class="value docNo">14501</span></div>
                <div>Date <span class="value docDate">30-Dec-25</span></div>
                <div class="signature-checkedby">
                    <div class="signature-line"></div>
                    Checked By
                </div>

            </div>

            <div class="signature">
                <div class="signature-line"></div>
                Finance Directorate
            </div>
        </div>
    </div>
</div>

<div class="divider"></div>

