    <script>

        function PropertyDetail(id, inbox) {
            $.ajax({
                type: 'GET',
                url: `/api/SP/GetSingleProperty`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                         if (response.code === 100) {
                         var result_User = response.data;
                         $("#RegistrationNoP").val(result_User.registrationNo);
                         $("#PropertyNoP").val(result_User.propertyNo);
                         $("#ActualSizeP").val(result_User.actualSize);
                         $("#ActualSizeUnitP").val(result_User.actualSizeUnit);
                         $("#CoveredAreaP").val(result_User.CoveredArea);
                         $("#ConstructionStatusP").val(result_User.constracutionStatus);
                         $("#PossessionStatusP").val(result_User.possessionStatus);
                         $("#MemberNameP").val(result_User.memberName);
                         $("#CnicP").val(result_User.cnic);
                         $("#phoneVP").val(result_User.phone);
                         $("#addressVP").val(result_User.address);
                         $("#PhaseP").val(result_User.phase);
                         $("#ProjectP").val(result_User.project);
                         $("#RealEstateP").val(result_User.realEstate);
                         $("#BlockP").val(result_User.block);
                         $("#CategoryP").val(result_User.category);
                         $("#PropertyTypeP").val(result_User.propertyType);
                         $("#NatureP").val(result_User.nature);
                         $("#FloorP").val(result_User.floor);
                         $("#FeatureP").val(result_User.feature);
                         $("#PropertyStatusP").val(result_User.propertyStatus);
                         $("#PropertyImageP").attr("src", result_User.imageURL);
                         $("#CNICFrontP").attr("src", result_User.cnicFrontURL);
                         $("#CNICBackP").attr("src", result_User.cnicBackURL);
                         
                         if(inbox==1){
                        $('#myModal').modal('show');
                         }
                    } else {
                        notification("topright", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                    }
                }
            });
        }

        // Open main-modal when button is clicked
        $('#propertyModal').click(function () {
            debugger;
            // Open main-modal
            $('#myModal').modal('show');

        });

    </script>
