                    <h1>PERMISSION FORM</h1>
                    @*       <small class="subtitle">PHASE DEFINITION</small>*@
                    <div class="vd_panel-menu  hidden-xs">


                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">

                <div class="container-fluid">
                    <div class="card p-3">
                        <div class="menu" style="float:right; margin-right: 15px;">
                            <a class="btn btn-primary btn-sm btn-theme" onclick="openmodalAdd()" data-toggle="modal" data-target="#myModal" style="padding: 6px 20px;">
                                <span class="menu-icon"><i class="fa fa-fw fa-plus-circle"></i></span> Add New
                            </a>
                        </div>
                        <br />

                        <br />
                        <div >
                            <div class="">
                                <table id="Promotion" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            <th class="text-white" style="text-align: center;">Name</th>
                                            <th class="text-white" style="text-align: center;">Title</th>
                                            <th class="text-white" style="text-align: center;">Serial No.</th>                                          
                                            <th class="text-white" style="text-align: center;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="promotetbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- .vd_content-section -->

        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
<!-- /.modal -->

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="margin-top: 12%;">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Add New Permission</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <form id="PMSUserForm" class="form-horizontal">
                <div class="modal-body">

                    <div class="container">
                        <div class="row">
                            <div class="col-sm-6">
                                <label>Name  <small style="color:red">*</small></label>
                                <input type="text" id="username" name="username" />
                            </div>

                            <div class="col-sm-6">
                                <label>Tilte  <small style="color:red">*</small></label>
                                <input type="text" id="employeename" name="employeename" />
                            </div>

                            <div class="col-sm-6">
                                <label>Serial No.  <small style="color:red">*</small></label>
                                <input type="number" id="serialNo" name="serialNo" />
                            </div>

                            <div class="col-sm-6 hide">
                                <label>isActive  <small style="color:red">*</small></label>
                                <input type="text" id="isActive" name="isActive" />
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
                <div class="modal-footer background-login">
                    <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                    <button id="SubmitButton" type="submit" class="btn btn-primary btn-theme">Save</button>
                </div>

            </form>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Confirmation</h4>
                <a class="close" data-dismiss="modal">&times;</a>

            </div>
            <div class="modal-body">
                <p>Are You sure you want to permanently delete the Permission?</p>
                <input class="hide" id="DeleteID" />

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button onclick="DeleteUser()" type="button" class="btn btn-primary ">Yes</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<input id="ID" class="hide" type="number" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {


            $("#PMSUserForm").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    username: {

                        required: true
                    },
                    employeename: {
                        required: true
                    },
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                    Swal.fire({
                        icon: 'error',
                        title: 'error',
                        text: 'Enter Valid Form Data',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SubmitRequest();
                }

            });

            GetUserList();
        });

        function GetUserList() {
            var url = "/api/PermissionForm/GetAll";
            debugger;

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        var relist = response.data;
                        var datatabl = $('#Promotion').DataTable();
                        datatabl.destroy();
                        $("#promotetbody").empty();
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td>' + list.name + '</td>' +
                                    '<td>' + list.title + '</td>' +
                                    '<td>' + list.serialNo + '</td>' +
                                    //'<td>' + list.isActive + '</td>' +
                                    '<td><a class="fa fa-edit fa-2x" title="Edit User" style="margin-right:10px" onclick="SelectEachPromotion(' + list.id + ')" ></a>' +
                                    // <a title="Remove User" class="fa fa-trash-o fa-2x text-danger" onclick = "ConfirmBlock(' + list.id + ')" > </a>' + '<a title="Change Passsword" > </a >
                                    '</td>' +
                                    '</tr>';
                                $("#promotetbody").append(row);
                                sr++;

                            }

                            $('#Promotion').DataTable();
                        }
                    }
                }
            });
        }

        function SelectEachPromotion(id) {

            var url = "/api/PermissionForm/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var data = response.data;
                        $("#myModal").modal("show");

                        $("#ID").val(data.id);
                        $("#username").val(data.name);
                        $("#employeename").val(data.title);
                        $("#serialNo").val(data.serialNo);
                        $("#SubmitButton").text("Update");
                        $("#myModalLabel").text("Edit Permission");
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding User',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        function openmodalAdd() {
            $("#ID").val("");
            $("#username").val("");
            $("#employeename").val("");
            $("#isActive").val("");
            $("#serialNo").val("");
            $("#SubmitButton").text("Save");
            $("#myModalLabel").text("Add New Permission Form");

        }


        function SubmitRequest() {

            var methodType = 'POST';
            var url = '/api/PermissionForm/AddNewPermission';

            var user = new Object();
            if ($("#ID").val() != "") {
                debugger;
                user.id = parseInt($("#ID").val());
                methodType = 'PUT';
                url = "/api/PermissionForm/UpdatePermissionForm"
            }

            user.Name = $("#username").val();
            user.Title = $("#employeename").val();
            user.SerialNo = $("#serialNo").val();
            user.isActive = true;
            user.ModifiedBy = $("#User_Id").val();
            user.CreatedBy = $("#User_Id").val();
            user.LastModifiedUserName = $("#User_Name").val();

            var ModelData = JSON.stringify(user);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                    debugger;

                    $('#loader').fadeOut();
                    console.log(response);
                    if (response.code === 100) {

                        $("#PMSUserForm").submit(function (e) {
                            e.preventDefault();
                        });
                        $("#myModal").modal("hide");
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else if (response.code === 4) {
                        debugger;
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }

                }
            });
        }


        function ConfirmBlock(id) {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false

            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: 'Your data is deleted.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    DeleteUser();
                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
            $("#DeleteID").val(id);
        }

        function DeleteUser() {
            var id = $("#DeleteID").val();
            var url = "/api/PermissionForm/DeletePermissionForm?id=" + id + "";
            debugger;

            $.ajax({
                type: 'Delete',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { Id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        $("#PMSUserForm").submit(function (e) {
                            e.preventDefault();
                        });
                        GetUserList();
                    }
                    else {
                        $("#PMSUserForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "Error", "fa fa-exclamation-circle vd_red", "Success", response.message);
                    }
                }
            });
        }

    </script>
 }

}