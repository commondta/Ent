<input type="text" id="idd" class="d-none" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            $('#Banner').dataTable();
            GetBannersList();
            GetAllBlocks();
            GetAllTypes();
        });

        // Image Upload
        function UploadImageOnServer() {
            var fileInput = $("#fileUpload")[0]; // Select the correct file input
            var file = fileInput.files[0];

            if (!file) return;

            var extension = file.name.split('.').pop().toLowerCase();
            var validExtensions = ['png', 'pdf', 'jpg', 'jpeg', 'gif', 'bmp', 'mp4', 'webm', 'avi', 'mov'];

            if ($.inArray(extension, validExtensions) === -1) {
                ResponseMessageModal("error", "Sorry, invalid file extension.");
                $("#fileUpload").val(''); // Reset input
                $("#PreviewUrl").attr("src", "https://via.placeholder.com/150");
                return;
            }

            var reader = new FileReader();
            reader.onload = function () {
                if ($.inArray(extension, ['mp4', 'webm', 'avi', 'mov']) !== -1) {
                    $("#PreviewUrl").replaceWith('<video id="PreviewUrl" controls style="max-width: 100%;"></video>');
                    $("#PreviewUrl").attr("src", reader.result);
                } else {
                    $("#PreviewUrl").replaceWith('<img id="PreviewUrl" style="max-width: 100%;">');
                    $("#PreviewUrl").attr("src", reader.result);
                }
                $("#ImageURL").val(reader.result);
            };

            reader.readAsDataURL(file);
        }

        // Thumbnail Upload
        function ThumbnailUploadImageOnServer() {
            var fileInput = $("#ThumbnailfileUpload")[0]; // Select the correct file input
            var file = fileInput.files[0];

            if (!file) return;

            var extension = file.name.split('.').pop().toLowerCase();
            var validExtensions = ['png', 'jpg', 'pdf', 'jpeg', 'gif', 'bmp', 'mp4', 'webm', 'avi', 'mov'];

            if ($.inArray(extension, validExtensions) === -1) {
                ResponseMessageModal("error", "Sorry, invalid file extension.");
                $("#ThumbnailfileUpload").val(''); // Reset input
                $("#ThumbnailPreviewUrl").attr("src", "https://via.placeholder.com/150");
                return;
            }

            var reader = new FileReader();
            reader.onload = function () {
                if ($.inArray(extension, ['mp4', 'webm', 'avi', 'mov']) !== -1) {
                    $("#ThumbnailPreviewUrl").replaceWith('<video id="ThumbnailPreviewUrl" controls style="max-width: 100%;"></video>');
                    $("#ThumbnailPreviewUrl").attr("src", reader.result);
                } else {
                    $("#ThumbnailPreviewUrl").replaceWith('<img id="ThumbnailPreviewUrl" style="max-width: 100%;">');
                    $("#ThumbnailPreviewUrl").attr("src", reader.result);
                }
                $("#ThumbnailImageURL").val(reader.result);
            };

            reader.readAsDataURL(file);
        }


        //Get List

        function GetBannersList() {
            var url = "/api/Banner/GetAll";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        var datatabl = $('#Banner').DataTable();
                        datatabl.destroy();
                        $("#bannerstbody").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                let createdOn = moment(list.createdOn).format('DD-MM-YYYY');
                                let lastModified = moment(list.lastModified).format('DD-MM-YYYY');
                                let status = list.isActive ? "Active" : "Inactive";

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td><img class="previewImageUrl" src="' + list.image + '" style="width:100px;height:40px"/></td>' +
                                    '<td><img class="previewImageUrl" src="' + list.thumbnail + '" style="width:100px;height:40px"/></td>' +
                                    '<td>' + list.title + '</td>' +
                                    '<td>' + list.block + '</td>' +
                                    '<td>' + list.type + '</td>' +
                                    '<td>' + list.bannerType + '</td>' +
                                    '<td>' + createdOn + '</td>' +
                                    '<td>' + status + '</td>' +
                                    '<td>' +
                                    '<a class="fa fa-edit fa-2x" onclick="SelectEachBanner(' + list.id + ')"></a> ' +
                                    '<a class="fa fa-trash fa-2x text-danger" onclick="DeleteBanner(' + list.id + ')"></a>' +
                                    '</td>' +
                                    '</tr>';

                                $("#bannerstbody").append(row);
                                sr++;
                            }
                        }

                        $('#Banner').dataTable();
                    }
                }
            });
        }


        function DeleteBanner(id) {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {

                    Discard(id);

                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })


            // $("#DeleteID").val(id);

        }
        function Discard(id) {

            var methodType = 'Delete';
            var url = "/api/Banner/Discard?id=" + id;
            $('#btn_discard').prop('disabled', true); //disble
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',

                success: function (response) {

                    if (response.code == 100) {

                        $('#loader').fadeOut();
                        NProgress.done();

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
        }


        function GetAllBlocks() {

            $.ajax({
                type: 'GET',
                url: `/api/Block/GetAllBlocks`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Block").empty();
                        var row = ' <option value="">-- Select Block --</option> ';

                        $("#Block").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Block").append(row);


                                sr++;

                            }
                        }

                        $('#Block').select2();
                    }
                }
            });
        }

        function GetAllTypes() {

            $.ajax({
                type: 'GET',
                url: `/api/PropertyType/GetAllPropertyTypes`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Type").empty();
                        var row = ' <option value="">-- Select Type --</option> ';

                        $("#Type").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Type").append(row);


                                sr++;
                            }
                        }

                        $('#Type').select2();
                    }
                }
            });
        }


        //editeachbaner

        function SelectEachBanner(id) {

            var url = "/api/Banner/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var banner = response.data;
                        let status = banner.isActive == true ? "1" : "0";
                        let imgg = document.getElementById("PreviewUrl").src = banner.image;
                        let thumbnail = document.getElementById("ThumbnailPreviewUrl").src = banner.thumbnail;
                        let date = (banner.createdOn).split('T')[0];
                        $("#myModal").modal("show");


                        $("#idd").val(banner.id);
                        $("#PreviewUrl").val(imgg);
                        $("#ImageURL").val(imgg);
                        $("#ThumbnailPreviewUrl").val(thumbnail);
                        $("#ThumbnailImageURL").val(thumbnail);
                        $("#Status").val(status);
                        $("#Title").val(banner.title);
                        $("#Description").val(banner.description);
                        $("#Block").val(banner.blockId);
                        $("#Block").trigger("change");
                        $("#Type").val(banner.propertyTypeId);
                        $("#Type").trigger("change");
                        $("#BannerType").val(banner.bannerType);
                        $("#date").val(date);
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Lead',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        //editeachbaner


        // data post
        function SubmitRequest() {

            let status = $("#Status").val() == 1 ? true : false;

            var methodType = 'POST';
            var url = "/api/Banner/AddNewBanner";
            var banner = new Object();

            if ($("#idd").val()) {

                banner.id = parseInt($("#idd").val());
                methodType = 'PUT';
                url = "/api/Banner/UpdateBanner"
            }

            let blockValue = $("#Block").val();
            let typeValue = $("#Type").val();

            banner.Image = $("#ImageURL").val();
            banner.Thumbnail = $("#ThumbnailImageURL").val();
            banner.BlockId = blockValue ? parseInt(blockValue) : null;
            banner.PropertyTypeId = typeValue ? parseInt(typeValue) : null;
            banner.BannerType = $("#BannerType").val();
            banner.Title = $("#Title").val();
            banner.Description = $("#Description").val();
            banner.CreatedOn = $("#date").val();
            banner.CreatedBy = $("#User_Id").val();
            banner.ModifiedBy = $("#User_Id").val();
            banner.LastModifiedUserName = $("#User_Name").val();
            banner.IsActive = status;


            var ModelData = JSON.stringify(banner);

            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: ModelData,
                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                        $("#myModal").modal("hide");

                        GetBannersList();
                        clear();
                    }
                    else if (response.code === 102) {
                        // notification("bottomleft", "warning", "fa fa-warning", "Warning", response.message);
                        //ResponseMessageModal("warning", response.message);
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                    }
                    else {
                        // notification("bottomleft", "error", "fa fa-error", "Error", response.message);
                        //ResponseMessageModal("error", response.message);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }

            });
        }

        function clear() {
            $("#ThumbnailImageURL").val("");
            $("#ImageURL").val("");
            $("#fileUpload").val("");
            $("#ThumbnailfileUpload").val("");
            $("#ThumbnailPreviewUrl").attr("src", "/img/placeholder-photo.svg");
            $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
            $("#status").val("-1");
            $("#status").trigger("change");
        }
    </script>
}
