                    <h1>PROMOTIONS</h1>
                    @*       <small class="subtitle">PHASE DEFINITION</small>*@
                    <div class="vd_panel-menu  hidden-xs">


                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">

                <div class="container-fluid">
                    <div class="card p-3">
                        <div class="menu" style="float:right;">
                            <button class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal" style="padding: 6px 20px;">
                                <span class="menu-icon"><i class="fa fa-fw fa-plus-circle"></i></span> Add New
                            </button>
                        </div>
                        <br />

                        <br />

                        <div class="">
                            <table id="Promotion" class="table table-bordered table-hover mb-0">
                                <thead class="bg-theme">
                                    <tr>
                                        <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                        <th class="text-white" style="text-align: center;">Image</th>
                                        <th class="text-white" style="text-align: center;">Title</th>
                                        <th class="text-white" style="text-align: center;">From Date</th>
                                        <th class="text-white" style="text-align: center;">To Date</th>
                                        <th class="text-white" style="text-align: center;">Type</th>
                                        <th class="text-white" style="text-align: center;">Created On</th>
                                        <th class="text-white" style="text-align: center;">Last Modified</th>
                                        <th class="text-white" style="text-align: center;">Status</th>
                                        <th class="text-white" style="text-align: center;">Action</th>

                                    </tr>
                                </thead>
                                <tbody id="promotetbody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- .vd_content-section -->

        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
<!-- /.modal -->

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="margin-top: 12%;">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" id="myModalLabel">Add New Promotion</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body">
                <form id="PromotionForm" class="form-horizontal">
                    <div class="container mt-4">
                        <div class="row">
                            <!-- Left Column -->
                            <div class="col-sm-6">
                                <!-- Image Upload -->
                                <div class="mb-3">
                                    <label for="imageUpload" class="form-label">Image</label>
                                    <input type="file" id="imageUpload" class="form-control" onchange="UploadImageOnServer()" />
                                    <input type="hidden" id="ImageURL" />
                                </div>
                                <div class="mb-3">

                                    <label for="Title">Title</label>
                                    <input type="text" id="Title" name="Title" />

                                </div>
                                <!-- From Date -->
                                <div class="mb-3">
                                    <label for="FromDate" class="form-label">From Date</label>
                                    <input type="date" id="FromDate" class="form-control" />
                                </div>

                                <!-- To Date -->
                                <div class="mb-3">
                                    <label for="ToDate" class="form-label">To Date</label>
                                    <input type="date" id="ToDate" class="form-control" />
                                </div>

                                <!-- Status -->
                                <div class="mb-3">
                                    <label for="Status" class="form-label">Status</label>
                                    <select class="form-select js-example-basic-single" id="Status" name="Status">
                                        <option value="-1">Select Option</option>
                                        <option value="1">Active</option>
                                        <option value="0">Inactive</option>
                                    </select>
                                </div>

                                <!-- Promotion Type -->
                                <div class="mb-3">
                                    <label for="PromotionType" class="form-label">Promotion Type</label>
                                    <select class="form-select js-example-basic-single" id="PromotionType" name="PromotionType">
                                        <option value="Project">Project</option>
                                        <option value="Exclusive Offer">Exclusive Offer</option>
                                        <option value="Brand">Brand</option>
                                        <option value="Upcoming Project">Upcoming Project</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-sm-6 text-center">
                                <label for="PreviewUrl" class="form-label">Preview</label>
                                <div class="d-flex justify-content-center align-items-center" style="height: 140px;">
                                    <img id="PreviewUrl"
                                         class="img-fluid"
                                         style="max-width: 140px; max-height: 120px;"
                                         src="/img/placeholder-photo.svg"
                                         alt="Image Preview" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                <button onclick="SubmitRequest()" type="button" class="btn btn-primary btn-theme">Save</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<input type="text" id="idd" class="hidden" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />


@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            $('#Promotion').dataTable();
            GetPromotionList();
        });

        //Image Upload
        function UploadImageOnServer() {

            var extension = $('input[type=file]').val().split('.').pop().toLowerCase();

            if ($.inArray(extension, ['png', 'jpg', 'jpeg']) == -1) {
                // alert("");
                // notification("topright", "error", "fa fa-exclamation-circle vd_red", "Eror", "Sorry, invalid extension.");
                ResponseMessageModal("error", "Sorry, invalid extension.");


                $('input[type=file]').val();
                $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
                return false;
            }
            else {

                var file = $("input[type=file]").get(0).files[0];
                if (file) {
                    var reader = new FileReader();

                    reader.onload = function () {
                        $("#PreviewUrl").attr("src", reader.result);
                        $("#PreviewUrl").attr("href", reader.result);
                        $("#PreviewUrl").attr("target", "_blank");
                        $("#ImageURL").val(reader.result);
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        //Get List

        function GetPromotionList() {
            console.log("Call Api:"); // Log each row
            var url = "/api/Promotion/GetAll";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        var datatabl = $('#Promotion').DataTable();
                        datatabl.destroy();

                        $("#promotetbody").empty();

                        var relist = response.data;
                        if (relist && relist.length > 0) {
                            let sr = 1;
                            for (let list of relist) {
                                let fromDate = moment(list.fromDate).isValid() ? moment(list.fromDate).format('DD-MM-YYYY') : '';
                                let toDate = moment(list.toDate).isValid() ? moment(list.toDate).format('DD-MM-YYYY') : '';
                                let createdOn = moment(list.createdOn).isValid() ? moment(list.createdOn).format('DD-MM-YYYY') : '';
                                let lastModified = moment(list.lastModified).isValid() ? moment(list.lastModified).format('DD-MM-YYYY') : '';
                                let status = list.isActive ? "Active" : "InActive";
                                let row = `
                                            <tr>
                                                <td>${sr}</td>
                                                <td><img class="PreviewUrl" src="${list.image}" style="width:100px;height:40px"/></td>
                                                <td>${list.title}</td>
                                                <td>${fromDate}</td>
                                                <td>${toDate}</td>
                                                <td>${list.promotionType}</td>
                                                <td>${createdOn}</td>
                                                <td>${lastModified}</td>
                                                <td>${status}</td>
                                                <td>
                                                    <a class="fa fa-edit fa-2x" onclick="SelectEachPromotion(${list.id})"></a>
                                                    <a class="fa fa-trash fa-2x text-danger" onclick="DeletePromotion(${list.id})"></a>
                                                </td>
                                            </tr>`;
                                $("#promotetbody").append(row);
                                sr++;
                            }
                        }

                        $('#Promotion').DataTable();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching promotions:", error);
                }
            });
        }

        function DeletePromotion(id) {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {

                    Discard(id);

                } else if (
                    /* Read more about handling dismissals below */
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })


            // $("#DeleteID").val(id);

        }
        function Discard(id) {

            var methodType = 'Delete';
            var url = "/api/Promotion/Discard?id=" + id;
            $('#btn_discard').prop('disabled', true); //disble
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',

                success: function (response) {

                    if (response.code == 100) {

                        $('#loader').fadeOut();
                        NProgress.done();

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });
        }



        function SelectEachPromotion(id) {

            var url = "/api/Promotion/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var promotionn = response.data;
                        let status = promotionn.isActive == true ? "1" : "0";
                        let imgg = document.getElementById("PreviewUrl").src = promotionn.image;
                        let fromDate = (promotionn.fromDate).split('T')[0];
                        let toDate = (promotionn.toDate).split('T')[0];
                        $("#myModal").modal("show");


                        $("#idd").val(promotionn.id);
                        $("#PreviewUrl").val(imgg);
                        $("#ImageURL").val(imgg);
                        $("#FromDate").val(fromDate);
                        $("#ToDate").val(toDate);
                        $("#Status").val(status);
                        $("#Title").val(promotionn.title);
                        $("#PromotionType").val(promotionn.promotionType);

                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Lead',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }


        // data post
        function SubmitRequest() {


            let status = $("#Status").val() == 1 ? true : false;

            var methodType = 'POST';
            var url = "/api/Promotion/AddNewPromotion";
            var promotion = new Object();


            if ($("#idd").val()) {

                promotion.id = parseInt($("#idd").val());
                methodType = 'PUT';
                url = "/api/Promotion/UpdatePromotion"
            }

            promotion.Image = $("#ImageURL").val();
            promotion.Title = $("#Title").val();
            promotion.FromDate = $("#FromDate").val();
            promotion.ToDate = $("#ToDate").val();
            promotion.IsActive = status;
            promotion.PromotionType = $("#PromotionType").val();
            promotion.CreatedBy = $("#User_Id").val();
            promotion.ModifiedBy = $("#User_Id").val();
            promotion.LastModifiedUserName = $("#User_Name").val();


            var ModelData = JSON.stringify(promotion);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: ModelData,
                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        });

                        $("#myModal").modal("hide");
                        GetPromotionList();
                        clear();
                    }
                    else if (response.code === 102) {
                        // notification("bottomleft", "warning", "fa fa-warning", "Warning", response.message);
                        //ResponseMessageModal("warning", response.message);
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                    }
                    else {
                        // notification("bottomleft", "error", "fa fa-error", "Error", response.message);
                        //ResponseMessageModal("error", response.message);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }

            });
        }

        function clear() {
            $("#ImageURL").val("");
            $("#imageUpload").val("");
            $("#PreviewUrl").attr("src", "/img/placeholder-photo.svg");
            $("#FromDate").val("");
            $("#ToDate").val("");
            $("#status").val("-1");
            $("#status").trigger("change");
        }
    </script>
}



                }