@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

            $('#registrationmodal').dataTable();

        });

        function AddRow() {

            var rownumber = parseInt($("#rownumberN").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberN").val(rownumber);

            var row = '<tr id="R' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <input type="date" class="form-control DueDate " /></td>' +
                '<td> <input onkeypress="validateNumberInput(event)" class="form-control Amount"></td>' +
                '<td style="width: 550px;"> <input disabled class="BankName" style="height:30px; width: 400px; background-color: #E5E5E5; border:#E5E5E5; border-radius:5px;"/><a class="btn btn-primary btn-sm btn-theme" data-toggle="modal" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +
                '<td> <input onkeypress="validateNumberInput(event)" class="form-control  ChequeNo" /></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#Deposittbody").append(row);
        }

        function DeleteItemRow(id) {
            $('#R' + id).remove();
            var rownumber = 1;
            $("#Deposittbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberN").val(rownumber - 1);
        }


    </script>
 }
