                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        d.refrenceNo = $('#refrenceNo').val() || "";
                        d.plotNo = $('#plotNo').val() || "";
                        d.city = $('#city').val() || "";
                        d.Phase = $('#Phase').val() || "";
                        d.RealStateType = $('#RealStateType').val() || "";
                        d.Category = $('#Category').val() || "";
                        d.Block = $('#Block').val() || "";
                        d.Type = $('#Type').val() || "";
                        d.Nature = $('#Nature').val() || "";
                        d.dealerName = $('#dealerName').val() || "";
                        d.propertyStatus = $('#PropertyStatus').val() || "";
                        d.country = $('#country').val() || "";
                        d.cnic = $('#cnic').val() || "";
                        d.almt = $('#Almt').val() || "";
                    }
                },
                processing: true,
                serverSide: true,
                filter: true,
                lengthMenu: [[10, 25, 50, 10000000], [10, 25, 50, "All"]],
                filter: true,
                dom: '<"top"lfB>rt<"bottom"ip><"clear">',
                buttons: ["copy", "csv", "excel", "print", "pdf"],
                columns: [
                    {
                        data: null,
                        render: (data, type, row, meta) => meta.row + 1,
                        title: '#'
                    },
                    // { data: 'formattedDateTime', name: 'DateTime' },
