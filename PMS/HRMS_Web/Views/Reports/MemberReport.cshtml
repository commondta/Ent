                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Project").append(row);


                                sr++;

                            }
                        }

                        $('#Project').select2();
                    }
                }
            });
        }

        function GetAllNatures(id) {
            var url = "/api/StockCreation/GetNatureDropdownByRealEstateId?realEstateId=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: id,
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#Nature").empty();
                        var row = ' <option value="">Select Nature</option> ';

                        $("#Nature").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#Nature").append(row);
                                sr++;
                            }
                        }

                        $('#Nature').select2();
                    }
                }
            });
        }

        function GetAllRealEstate(id, real) {

            $.ajax({

                type: 'GET',
                url: `/api/RealEstate/GetRealEstatesByPhaseId`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#RealStateType").empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#RealStateType").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#RealStateType").append(row);


                                sr++;

                            }
                            $('#RealStateType').select2();

                            if (real != undefined && real != null) {
                               
                                $('#RealStateType').select2('val', [real]);
                                GetAllCategories(real);
                                GetAllNatures(real);
                                GetAllProjects(real);
                            }
                        }

                    }
                }
            });
        }
