    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            $('#Almt').select2();

            GetAllPhases();
            GetAllBlocks();
            GetAllTypes();
            // GetAllSector();
            //GetAllCities();
            GetAllCountries();
            GetAllAlmt();
            GetAllPropertyLists();
            $('#searchButton').on('click', function () {
                $('#proplist').DataTable().ajax.reload();
                loadSummaryData();
            });

            loadSummaryData();
        });

        $('#country').on('change', function () {
            var selectedCountry = $(this).val();
            if (selectedCountry) {
                GetAllCities(selectedCountry);
            } else {
                $("#city").empty();
                $("#city").append('<option value="">-- Select city --</option>');
                $('#city').select2();
            }
        });

        function loadSummaryData() {

            const filters = {
                refrenceNo: $('#refrenceNo').val() || "",
                plotNo: $('#plotNo').val() || "",
                sector: $('#sector').val() || "",
                city: $('#city').val() || "",
                phase : $('#Phase').val() || "",
                realStateType : $('#RealStateType').val() || "",
                category : $('#Category').val() || "",
                block : $('#Block').val() || "",
                type : $('#Type').val() || "",
                nature : $('#Nature').val() || "",
                dealerName: $('#dealerName').val() || "",
                propertyStatus: $('#PropertyStatus').val() || "",
                country: $('#country').val() || "",
                cnic: $('#cnic').val() || "",
                almt: $('#Almt').val() || ""
            };

            $.ajax({
                url: "/api/SP/MemberSummaryReport",
                method: "POST",
                headers: {
                    Authorization: `Bearer ${localStorage.getItem("token")}`
                },
                data: filters,
                success: function (response) {
                    renderSummary(response);
                },
                error: function () {
                    $('#summary-tab').html('<div class="error">Failed to load summary data.</div>');
                }
            });

        }

        function renderSummary(data) {
            if (!Array.isArray(data) || data.length === 0) {
                $('#summary-tab').html('<div class="error">No summary data found.</div>');
                return;
            }

            let html = '<div class="summary-container">';
            data.forEach(item => {
                html += `
                                                    <div class="summary-card">
                                                        <div class="summary-name">${item.name}</div>
                                                        <div class="summary-count">${item.count}</div>
                                                    </div>
                                                `;
            });
            html += '</div>';

            $('#summary-tab').html(html);
        }


        function GetAllPropertyLists() {

            $('#proplist').DataTable({
