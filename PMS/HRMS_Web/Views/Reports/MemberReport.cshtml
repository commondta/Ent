                    { data: 'dealerName', name: 'DealerName' },
                    { data: 'propertyStatus', name: 'PropertyStatus' },
                    { data: 'phase', name: 'Phase' },
                    { data: 'block', name: 'Block' },
                    { data: 'category', name: 'Category' },
                    { data: 'propertyType', name: 'PropertyType' },
                ]
            });
        }

        function GetAllSector() {
            $.ajax({
                type: 'GET',
                url: `/api/Sector/GetAllSectors`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                success: function (response) {

                    if (response.code === 0) {

                        $("#sector").empty();
                        var row = ' <option value="">-- Select Sector --</option> ';

                        $("#sector").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#sector").append(row);


                                sr++;
                            }
                        }

                        $('#sector').select2();
                    }
                }
            });
        }

        function GetAllCities(country) {
            $.ajax({
                type: 'GET',
                url: `/api/MemberProfile/GetAllCities`,
                data: { country: country },  
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                success: function (response) {
                    if (response.code === 100) {
                        $("#city").empty();
                        $("#city").append('<option value="">-- Select city --</option>');

                        var cities = response.data;
                        if (cities && cities.length > 0) {
                            for (let city of cities) {
                                $("#city").append(`<option value="${city.name}">${city.name}</option>`);
                            }
                        }

                        $('#city').select2();
                    }
                }
            });
        }

