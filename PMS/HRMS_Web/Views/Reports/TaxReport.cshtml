    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            GetAllPropertyLists();
            GetAllPhases();
            GetAllBlocks();
            GetAllTypes();
            GetAllSector();
            $('#searchButton').on('click', function () {
                $('#proplist').DataTable().ajax.reload();
                loadSummaryData();
            });

            loadSummaryData();
        });

        function loadSummaryData() {

            const filters = {
                startDate: $('#startDate').val() || "",
                endDate: $('#endDate').val() || "",
                refrenceNo: $('#refrenceNo').val() || "",
                plotNo: $('#plotNo').val() || "",
                sector: $('#sector').val() || "",
                Phase: $('#Phase').val() || "",
                RealStateType: $('#RealStateType').val() || "",
                Category: $('#Category').val() || "",
                Block: $('#Block').val() || "",
                Type: $('#Type').val() || "",
                Nature: $('#Nature').val() || "",
                requestType: $('#requestType').val() || "",
                transferType: $('#transfer').val() || "",
                dealerName: $('#dealerName').val() || ""
            };

            $.ajax({
                url: "/api/SP/TaxSummaryReport",
                method: "POST",
                headers: {
                    Authorization: `Bearer ${localStorage.getItem("token")}`
                },
                data: filters,
                success: function (response) {
                    renderSummary(response);
                },
                error: function () {
                    $('#summary-tab').html('<div class="error">Failed to load summary data.</div>');
                }
            });

        }

        function renderSummary(data) {
            if (!Array.isArray(data) || data.length === 0) {
                $('#summary-tab').html('<div class="error">No summary data found.</div>');
                return;
            }

            let html = '<div class="summary-container">';
            data.forEach(item => {
                html += `
                                    <div class="summary-card">
                                        <div class="summary-name">${item.name}</div>
                                        <div class="summary-count">${item.count}</div>
                                    </div>
                                `;
            });
            html += '</div>';

            $('#summary-tab').html(html);
        }

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetTaxReport",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        d.startDate = $('#startDate').val() || "";
                        d.endDate = $('#endDate').val() || "";
                        d.refrenceNo = $('#refrenceNo').val() || "";
                        d.plotNo = $('#plotNo').val() || "";
                        d.sector = $('#sector').val() || "";
                        d.Phase = $('#Phase').val() || "";
                        d.RealStateType = $('#RealStateType').val() || "";
                        d.Category = $('#Category').val() || "";
                        d.Block = $('#Block').val() || "";
                        d.Type = $('#Type').val() || "";
                        d.Nature = $('#Nature').val() || "";
                        d.plotSize = $('#plotSize').val() || "";
                        d.dealerName = $('#dealerName').val() || "";
                    }
                },
                processing: true,
                serverSide: true,
                filter: true,
                lengthMenu: [[10, 25, 50, 10000000], [10, 25, 50, "All"]],
                filter: true,
                dom: '<"top"lfB>rt<"bottom"ip><"clear">',
                buttons: ["copy", "csv", "excel", "print", "pdf"],
                columns: [
                    {
                        data: null,
                        render: (data, type, row, meta) => meta.row + 1,
                        title: '#'
                    },
                    {
                        data: "dateTime", // or whatever field your backend returns
                        title: "Transfer Date",
                        render: function (data, type, row) {
                            if (!data) return "";
                            // Convert to date only
                            var date = new Date(data);
                            var day = String(date.getDate()).padStart(2, '0');
                            var month = String(date.getMonth() + 1).padStart(2, '0');
                            var year = date.getFullYear();
                            return `${day}-${month}-${year}`;
                        }
                    },
                    { data: "propertyNo", name: "Property No" },
                    { data: 'registrationNo', name: 'RegistrationNo' },
                    { data: 'memberName', name: 'SellerName' },
                    { data: 'relationshipWith', name: 'SellerRelationshipWith' },
                    { data: 'membershipNo', name: 'SellerMembershipNo' },
                    { data: 'cnic', name: 'SellerCnic' },
                    { data: 'buyerName', name: 'BuyerName' },
                    { data: 'buyerRelationshipWith', name: 'BuyerRelationshipWith' },
                    { data: 'buyerMembershipNo', name: 'BuyerMembershipNo' },
                    { data: 'buyerCnic', name: 'BuyerCnic' },                 
                    { data: 'sellerDates', name: 'SellerTaxDates' },
                    { data: 'sellerAmounts', name: 'SellerTaxAmounts' },
                    { data: 'sellerTaxDescriptions', name: 'SellerTaxDescriptions' },
                    { data: 'sellerChallanNos', name: 'SellerTaxChallanNos' },
                    { data: 'buyerDates', name: 'BuyerTaxDates' },
                    { data: 'buyerAmounts', name: 'BuyerTaxAmounts' },
                    { data: 'buyerTaxDescriptions', name: 'BuyerTaxDescriptions' },
                    { data: 'buyerChallanNos', name: 'BuyerTaxChallanNos' },
                    { data: 'ndcRequestType', name: 'NDCRequestType' },
                    { data: 'transferType', name: 'TransferType' },
                    { data: 'applyStation', name: 'ApplyStation' },
                    { data: 'estateName', name: 'EstateName' },
                    { data: 'dealerName', name: 'DealerName' },
                    { data: 'phase', name: 'Phase' },
                    { data: 'block', name: 'Block' },
                    { data: 'category', name: 'Category' },
                    { data: 'propertyType', name: 'PropertyType' },
                ]
            });

        }

        function GetAllSector() {
            $.ajax({
                type: 'GET',
                url: `/api/Sector/GetAllSectors`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                success: function (response) {

                    if (response.code === 0) {

                        $("#sector").empty();
                        var row = ' <option value="">-- Select Sector --</option> ';

                        $("#sector").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#sector").append(row);


                                sr++;
                            }
                        }

                        $('#sector').select2();
                    }
                }
            });
        }
