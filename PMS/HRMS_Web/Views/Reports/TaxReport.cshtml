    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css">

    <!-- Summary Styling -->
    <style>
        .summary-container {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1rem;
        }

        .summary-card {
            background: #f8f9fa;
            padding: 1rem 1.5rem;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            text-align: center;
            min-width: 140px;
            flex: 1 1 150px;
            transition: transform 0.2s ease;
        }

            .summary-card:hover {
                transform: translateY(-4px);
            }

        .summary-name {
            font-size: 14px;
            font-weight: 600;
            color: #555;
        }

        .summary-count {
            font-size: 24px;
            font-weight: bold;
            color: #007bff;
            margin-top: 5px;
        }

        .tab-pane .error {
            color: red;
            font-weight: bold;
            padding: 1rem;
        }
    </style>
}

