                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';

                                $("#RealStateType").append(row);


                                sr++;

                            }
                            $('#RealStateType').select2();

                            if (real != undefined && real != null) {
                                debugger;
                                $('#RealStateType').select2('val', [real]);
                                GetAllCategories(real);
                                GetAllNatures(real);
                                GetAllProjects(real);
                            }
                        }

                    }
                }
            });
        }

    </script>
}

