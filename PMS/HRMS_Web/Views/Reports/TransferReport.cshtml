@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            
            $('#sector').select2();
            $('#transfer').select2();

            
            GetAllSector();
            GetAllNDCTransferTypes();
            GetAllPropertyLists();
            GetAllPhases();
            GetAllBlocks();
            GetAllTypes();
            // GetAllSector();

            $('#searchButton').on('click', function () {
                $('#proplist').DataTable().ajax.reload();
                loadSummaryData();
            });

            loadSummaryData();
        });

        function loadSummaryData() {

            const filters = {
                startDate: $('#startDate').val() || "",
                endDate: $('#endDate').val() || "",
                refrenceNo: $('#refrenceNo').val() || "",
                plotNo: $('#plotNo').val() || "",
                Phase: $('#Phase').val() || "",
                RealStateType: $('#RealStateType').val() || "",
                Category: $('#Category').val() || "",
                Block: $('#Block').val() || "",
                Type: $('#Type').val() || "",
                Nature: $('#Nature').val() || "",
                requestType: $('#requestType').val() || "",
                transferType: $('#transfer').val() || "",
                dealerName: $('#dealerName').val() || ""
            };

            $.ajax({
                url: "/api/SP/TransferSummaryReport",
                method: "POST",
                headers: {
                    Authorization: `Bearer ${localStorage.getItem("token")}`
                },
                data: filters,
                success: function (response) {
                    renderSummary(response);
                },
                error: function () {
                    $('#summary-tab').html('<div class="error">Failed to load summary data.</div>');
                }
            });

        }

        function renderSummary(data) {
            if (!Array.isArray(data) || data.length === 0) {
                $('#summary-tab').html('<div class="error">No summary data found.</div>');
                return;
            }

            let html = '<div class="summary-container">';
            data.forEach(item => {
                html += `
                            <div class="summary-card">
                                <div class="summary-name">${item.name}</div>
                                <div class="summary-count">${item.count}</div>
                            </div>
                        `;
            });
            html += '</div>';

            $('#summary-tab').html(html);
        }

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllTransferRequestFilters",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        d.startDate = $('#startDate').val() || "";
                        d.endDate = $('#endDate').val() || "";
                        d.refrenceNo = $('#refrenceNo').val() || "";
                        d.plotNo = $('#plotNo').val() || "";
                        d.Phase = $('#Phase').val() || "";
                        d.RealStateType = $('#RealStateType').val() || "";
                        d.Category = $('#Category').val() || "";
                        d.Block = $('#Block').val() || "";
                        d.Type = $('#Type').val() || "";
                        d.Nature = $('#Nature').val() || "";
                        d.requestType = $('#requestType').val() || "";
                        d.transferType = $('#transfer').val() || "";
                        d.dealerName = $('#dealerName').val() || "";
                    }
                },
                processing: true,
                serverSide: true,
                filter: true,
                lengthMenu: [[10, 25, 50, 10000000], [10, 25, 50, "All"]],
                filter: true,
                dom: '<"top"lfB>rt<"bottom"ip><"clear">',
                buttons: ["copy", "csv", "excel", "print", "pdf"],
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "Property No" },  
                    { data: "registrationNo", name: "Registration No" },
                    { data: "sellerName", name: "Seller Name" },
                    { data: "buyerName", name: "Buyer Name" },
                    { data: "estateName", name: "Estate Name" },  
                    { data: "dealerName", name: "Dealer Name" },
                    { data: "ndcRequestType", name: "NDC Request Type" },
                    { data: "transferType", name: "Transfer Type" },
                    {
                        data: "dateTime",
                        title: "Apply Date",
                        render: function (data, type, row) {
                            if (!data) return "";
                            var date = new Date(data);
                            var day = String(date.getDate()).padStart(2, '0');
                            var month = String(date.getMonth() + 1).padStart(2, '0');
                            var year = date.getFullYear();
                            return `${day}-${month}-${year}`;
                        }
                    },                 
                    { data: "formattedDateTime", name: "Transfer Date" },
                    { data: "applyStation", name: "Apply Station" },
                    { data: "status", name: "NDC Status" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "Property Type" }
                ]
            });

        }

        function GetAllSector() {
            $.ajax({
                type: 'GET',
                url: `/api/Sector/GetAllSectors`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                success: function (response) {

                    if (response.code === 0) {

                        $("#sector").empty();
                        var row = ' <option value="">-- Select Sector --</option> ';

                        $("#sector").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#sector").append(row);


                                sr++;
                            }
                        }

                        $('#sector').select2();
                    }
                }
            });
        }

