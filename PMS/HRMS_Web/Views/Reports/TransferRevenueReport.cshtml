<!-- Middle Content Start -->
@section CSS {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" />

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<!-- Middle Content Start -->

<div class="vd_content-wrapper">
    <div class="vd_container">
        <div class="vd_content clearfix">
            <div class="vd_head-section clearfix">
                <div class="vd_panel-header">
                    <ul class="breadcrumb">
                        <li><a href="/Home/index">Home</a> </li>
                        <li class="active">Transfer Revenue Report</li>
                    </ul>
                    <div class="vd_panel-menu hidden-sm hidden-xs" data-intro="<strong>Expand Control</strong><br/>To expand content page horizontally, vertically, or Both. If you just need one button just simply remove the other button code." data-step=5 data-position="left">
                        <div data-action="remove-navbar" data-original-title="Remove Navigation Bar Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-navbar-button menu"> <i class="fa fa-arrows-h"></i> </div>
                        <div data-action="remove-header" data-original-title="Remove Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-header-button menu"> <i class="fa fa-arrows-v"></i> </div>
                        <div data-action="fullscreen" data-original-title="Remove Navigation Bar and Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="fullscreen-button menu"> <i class="glyphicon glyphicon-fullscreen"></i> </div>

                    </div>

                </div>
            </div>
            <!-- vd_head-section -->

            <div class="vd_title-section clearfix">
                <div class="vd_panel-header">
                    <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-left-right" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 11.5a.5.5 0 0 0 .5.5h11.793l-3.147 3.146a.5.5 0 0 0 .708.708l4-4a.5.5 0 0 0 0-.708l-4-4a.5.5 0 0 0-.708.708L13.293 11H1.5a.5.5 0 0 0-.5.5m14-7a.5.5 0 0 1-.5.5H2.707l3.147 3.146a.5.5 0 1 1-.708.708l-4-4a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 4H14.5a.5.5 0 0 1 .5.5"/></svg></span>
                    <h1>Transfer Revenue Report</h1>
                    <div class="vd_panel-menu  hidden-xs">

                        <div class="menu">
                            @*
                            <a class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal">Add New</a>
                            *@
                        </div>
                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        <div class="col-md-12">
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="row">
                                            <div class="col-sm-3">
                                                <label for="startDate">Start Date:</label>
                                                <input type="date" id="startDate" class="form-control">
                                            </div>
                                            <div class="col-sm-3">
                                                <label for="endDate">End Date:</label>
                                                <input type="date" id="endDate" class="form-control">
                                            </div>
                                            <div class="col-sm-3">
                                                <label>Ref No. :</label>
                                                <div>
                                                    <input type="text" class="form-control"
                                                           placeholder=" " id="refrenceNo" />
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <label>Plot No. :</label>
                                                <div>
                                                    <input type="text" class="form-control"
                                                           placeholder=" " id="plotNo" />
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <label>Sector :</label>
                                                <div>
                                                    <select class="form-control" name="sector" id="sector">
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <label>NDC Request Type</label>
                                                <div>
                                                    <select class="form-control" id="requestType" name="requestType">
                                                        <option value=""> Select NDC Request Type</option>
                                                        <option value="Premium Transfer"> Premium Transfer</option>
                                                        <option value="Executive Transfer"> Executive Transfer </option>
                                                        <option value="Regular"> Regular </option>
                                                        <option value="Provisional"> Provisional </option>
                                                        <option value="Open NDC"> Open NDC </option>
                                                        <option value="Urgent"> Urgent </option>
                                                        <option value="Dealer/Investors">Dealer/Investors</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <label>Transfer Type</label>
                                                <div>
                                                    <select class="form-control" id="transfer" name="TransferT">
                                                    </select>

                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <label>Dealer Name :</label>
                                                <div>
                                                    <input type="text" class="form-control"
                                                           placeholder=" " id="dealerName" />
                                                </div>
                                            </div>

                                            <div class="col-sm-12 mt-2 text-right">
                                                <button id="searchButton" class="btn btn-primary">Filter</button>
                                            </div>
                                        </div>
                                        <br />
                                        <div class="">
                                            <table id="proplist" class="table table-bordered table-hover mb-0" style="width:100%">
                                                <thead class="bg-theme">
                                                    <tr>
                                                        <th class="text-white">Sr #</th>
                                                        <th class="text-white">Property No.</th>
                                                        <th class="text-white">Registration No.</th>
                                                        <th class="text-white">Seller Name</th>
                                                        <th class="text-white">Buyer Name</th>
                                                        <th class="text-white">Estate Name</th>
                                                        <th class="text-white">Dealer Name</th>
                                                        <th class="text-white">NDC Request Type</th>
                                                        <th class="text-white">Transfer Type</th>
                                                        <th class="text-white">Transfer Charges</th>
                                                        <th class="text-white">Apply Date</th>
                                                        <th class="text-white">Apply Station</th>
                                                        <th class="text-white">NDC Status</th>
                                                        <th class="text-white">Sector</th>
                                                        <th class="text-white">Phase</th>
                                                        <th class="text-white">Block</th>
                                                        <th class="text-white">Category</th>
                                                        <th class="text-white">Property Type</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- .vd_content-section -->

        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";

            $('#sector').select2();
            $('#transfer').select2();


            GetAllSector();
            GetAllNDCTransferTypes();
            GetAllPropertyLists();

            $('#searchButton').on('click', function () {
                $('#proplist').DataTable().ajax.reload();
            });
        });

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllTransferRevenueRequestFilters",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                    data: function (d) {
                        d.startDate = $('#startDate').val() || "";
                        d.endDate = $('#endDate').val() || "";
                        d.refrenceNo = $('#refrenceNo').val() || "";
                        d.plotNo = $('#plotNo').val() || "";
                        d.sector = $('#sector').val() || "";
                        d.requestType = $('#requestType').val() || "";
                        d.transferType = $('#transfer').val() || "";
                        d.dealerName = $('#dealerName').val() || "";
                    }
                },
                processing: true,
                serverSide: true,
                filter: true,
                lengthMenu: [[10, 25, 50, 10000000], [10, 25, 50, "All"]],
                filter: true,
                dom: '<"top"lfB>rt<"bottom"ip><"clear">',
                buttons: ["copy", "csv", "excel", "print", "pdf"],
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "Property No" },
                    { data: "registrationNo", name: "Registration No" },
                    { data: "sellerName", name: "Seller Name" },
                    { data: "buyerName", name: "Buyer Name" },
                    { data: "estateName", name: "Estate Name" },
                    { data: "dealerName", name: "Dealer Name" },
                    { data: "ndcRequestType", name: "NDC Request Type" },
                    { data: "transferType", name: "Transfer Type" },
                    { data: "transferCharges", name: "Transfer Charges" },
                    { data: "formattedDateTime", name: "Apply Date" },
                    { data: "applyStation", name: "Apply Station" },
                    { data: "status", name: "NDC Status" },
                    { data: "sector", name: "Sector" },
                    { data: "phase", name: "Phase" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "Property Type" }
                ]
            });

        }

        function GetAllSector() {
            $.ajax({
                type: 'GET',
                url: `/api/Sector/GetAllSectors`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                success: function (response) {

                    if (response.code === 0) {

                        $("#sector").empty();
                        var row = ' <option value="">-- Select Sector --</option> ';

                        $("#sector").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#sector").append(row);


                                sr++;
                            }
                        }

                        $('#sector').select2();
                    }
                }
            });
        }

        function GetAllNDCTransferTypes() {

            $.ajax({
                type: 'GET',
                url: `/api/TransferType/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#transfer").empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#transfer").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#transfer").append(row);
                                sr++;
                            }
                        }

                        $('#transfer').select2();
                    }
                }
            });
        }

    </script>
}

