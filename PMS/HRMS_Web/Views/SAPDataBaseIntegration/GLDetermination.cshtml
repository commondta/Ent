                    <h1>G/L DETERMINATION</h1>

                    <div class="vd_panel-menu  hidden-xs">


                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">

                <div class="container-fluid">
                    <div class="card p-3" >
                        <div class="menu" style="float: right; margin-bottom: .5rem;">
                            <a class="btn btn-primary btn-sm btn-theme" onclick="AddRow()" style="padding: 6px 20px; margin-right: 15px;">Add New</a>
                            <input type="text" id="rownumberN" value="0" class="hide" />
                        </div>
                       
                        <div >
                            <div class="table-responsive">
                                <table id="GLData" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="min-width: 90px; text-align: center;">#</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Charge Type</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">SAP Account Code</th>
                                            <th class="text-white" style="min-width: 130px; text-align: center;">Remarks</th>
                                            <th class="text-white" style="text-align: center;">Action</th>

                                        </tr>
                                    </thead>
                                    <tbody id="GLtbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <br />
                        <br />
