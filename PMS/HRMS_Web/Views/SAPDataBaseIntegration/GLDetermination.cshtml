<!-- /.modal -->

<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";
            GetAllGLData();
        });

        function GetAllGLData() {

            var url = "/api/GLDetermination/GetAll";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        var result = response.data;

                        $("#GLtbody").empty();

                        $.each(result, function (i, item) {
                            var rownumber = parseInt($("#rownumberN").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumberN").val(rownumber);

                            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <select type="text" class="form-control ChargeType" style="width: 100%;" id="ChargeType' + rownumber + '"></select></td>' +
                                '<td> <input type="text" class="form-control SapAccountCode" value="' + item.sapAccountCode + '"/></td>' +
                                '<td> <textarea type="text" class="form-control Remarks">' + item.remarks + '</textarea></td>' +

                                '<td style="padding-top:10px"><a disabled class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';

                            $("#GLtbody").append(row);

                            GetChargeType(rownumber, item.chargeGroupTypeId)
                        });
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Lead");
                    }
                }
            });
        }

        function AddRow() {

            var rownumber = parseInt($("#rownumberN").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberN").val(rownumber);

            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <select type="text" class="form-control ChargeType" style="width: 100%;" id="ChargeType' + rownumber + '"></select></td>' +
                '<td> <input type="text" class="form-control SapAccountCode"/></td>' +
                '<td> <textarea type="text" class="form-control Remarks"></textarea></td>' +


                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#GLtbody").append(row);

            GetChargeType(rownumber)
        }

        function DeleteItemRow(id) {
            $('#L' + id).remove();
            var rownumber = 1;
            $("#GLtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberN").val(rownumber - 1);
        }

        function GetChargeType(rowno, chargeTypeId) {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/ChargeGroupType/GetAllChargeGroupType`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 0) {

                        $("#ChargeType" + rowno).empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#ChargeType" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.chargeTypeName + '</option> ';

                                $("#ChargeType" + rowno).append(row);

                                sr++;
                            }
                            $('#ChargeType' + rowno).select2();
                        }
                        if (chargeTypeId != null && chargeTypeId != undefined) {
                            $('#ChargeType' + rowno).select2("val", [chargeTypeId])
                        }

                    }
                }
            });
        }

        function PostRequest() {

            var GLDataArray = new Array();

            $('#GLtbody tr').each(function () {

                var row = $(this);
                var GLData = new Object();

                GLData.ChargeGroupTypeId = row.find('.ChargeType').val();
                GLData.SapAccountCode = row.find('.SapAccountCode').val();
                GLData.Remarks = row.find('.Remarks').val();
                GLData.ModifiedBy = $("#User_Id").val();
                GLData.CreatedBy = $("#User_Id").val();
                GLData.LastModifiedUserName = $("#User_Name").val();

                GLDataArray.push(GLData);
            });

            var model = JSON.stringify(GLDataArray);
            debugger;
            $('#sbbtn').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: 'POST',
                url: `/api/GLDetermination/SaveGLDetermination`,
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: model,

                success: function (response) {

                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
            $('#sbbtn').prop('disabled', false); //enable
        }
    </script>
  }