<input type="number" id="Id" class="hide" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";

            GetOperation();
        });

        
        function GetOperation() {

            $.ajax({
                type: 'GET',
                url: `/api/SAPOperations/Get`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var data = response.data;

                        $('#Id').val(data.id);
                        $('#Server').val(data.server);
                        $('#DBname').val(data.dbName);
                        $('#DBUsername').val(data.dbUserName);
                        $('#DBPassword').val(data.dbPassword);
                        $('#SAPUser').val(data.sapUser);
                        $('#SAPPassword').val(data.sapPassword);
                        $('#DatabaseType').val(data.dbType);
                        $('#DealerAccountCode').val(data.dealerAccountCode);
                        $('#MemberAccountCode').val(data.memberAccountCode);
                        $('#CustomerSeries').val(data.customerSeries);
                        $('#BookingAccount').val(data.bookingAccount);
                        $('#TownPlanningClearanceCommaSepratedGLs').val(data.townPlanningClearanceCommaSepratedGLs);
                        $('#SignatoryRank').val(data.signatoryRank);
                        $('#SignatoryDesignation').val(data.signatoryDesignation);
                        $('#AllocationSignatoryRank').val(data.allocationSignatoryRank);
                        $('#AllocationSignatoryName').val(data.allocationSignatoryName);
                        $('#AllocationSignatoryDesignation').val(data.allocationSignatoryDesignation);
                        $('#SignatoryName').val(data.signatoryName);
                        $('#BillDiscountPercentage').val(data.billDiscountPercentage);
                        $('#FingerPrintThreshhold').val(data.fingerPrintThreshhold);
                        $('#TransferCertificateTimeLineStatement').val(data.transferCertificateTimeLineStatement);

                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

     
        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/SAPOperations/AddNewSAPOperations";

            var Operation = new Object();

            Operation.Server = $('#Server').val();
            Operation.DBName = $('#DBname').val();
            Operation.DBUserName = $('#DBUsername').val();
            Operation.DBPassword = $('#DBPassword').val();
            Operation.SAPUser = $('#SAPUser').val();
            Operation.SAPPassword = $('#SAPPassword').val();
            Operation.DBType = $('#DatabaseType').val();
            Operation.CustomerSeries = $('#CustomerSeries').val();
            Operation.MemberAccountCode = $('#MemberAccountCode').val();
            Operation.DealerAccountCode = $('#DealerAccountCode').val();
            Operation.BookingAccount = $('#BookingAccount').val();
            Operation.CreatedBy = $("#User_Id").val();
            Operation.ModifiedBy = $("#User_Id").val();
            Operation.LastModifiedUserName = $("#User_Name").val();
            Operation.TownPlanningClearanceCommaSepratedGLs = $("#TownPlanningClearanceCommaSepratedGLs").val();
            Operation.SignatoryRank = $("#SignatoryRank").val();
            Operation.SignatoryDesignation = $("#SignatoryDesignation").val();
            Operation.SignatoryName = $("#SignatoryName").val();
            Operation.AllocationSignatoryRank = $("#AllocationSignatoryRank").val();
            Operation.AllocationSignatoryDesignation = $("#AllocationSignatoryDesignation").val();
            Operation.AllocationSignatoryName = $("#AllocationSignatoryName").val();
            Operation.BillDiscountPercentage = $("#BillDiscountPercentage").val();
            Operation.FingerPrintThreshhold = $("#FingerPrintThreshhold").val();
            Operation.TransferCertificateTimeLineStatement = $("#TransferCertificateTimeLineStatement").val();

            if ($("#Id").val()) {

                Operation.Id = parseInt($("#Id").val());
                methodType = 'POST';
                url = "/api/SAPOperations/UpdateSAPOperations"
            }

            var model = JSON.stringify(Operation);
            debugger;
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {

                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
        }
    </script>
 }