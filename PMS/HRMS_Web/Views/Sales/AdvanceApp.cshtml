<input type="number" id="dealId" value="" class="hide" />
<input type="number" id="dealerId" value="" class="hide" />
<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {

    <script>
        $(document).ready(function () {
            "use strict";
            // GetAllPropertyLists();
            // GetAllDeal();
            GetAllDealerProfiles();

            $('#receipts').dataTable();
            $('#dealerlist').dataTable();
            $('#deallist').dataTable();
        });

        function refreshPage() {
            location.reload();
        }

        // selection dealerId start
        function GetAllDealerProfiles() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Dealer/GetFilterListForPreSale`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        $("#Dealertbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + list.id + '</td> ' +
                                    ' <td class="principalOwner">' + list.principalOwner + '</td>' +
                                    '<td><a class="btn btn-primary" onclick="SelectDealer(' + list.id + ')">Select</a></td> </tr>';
                                $("#Dealertbody").append(row);
                                sr++;
                            }
                        }

                        $('#dealerlist').dataTable();
                    }
                }
            });
        }

        function SelectDealer(id) {

            var url = "/api/Dealer/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;

                        $("#DealerCode").val(result_User.id);
                        $("#dealername").val(result_User.principalOwner);
                        $("#dealerId").val(result_User.id);
                        $("#dealerModal").modal("hide");
                        GetAllDeal(result_User.id);

                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Dealer");
                    }
                }
            });
        }
        // selection dealerId end

        // selection dealId start
        function GetAllDeal(id) {

            var id = $("#dealerId").val();
            var url = "/api/Filter/GetFilterDealByDealerId?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                        $("#Dealtbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + list.id + '</td> ' +
                                    ' <td >' + list.dealName + '</td>' +
                                    ' <td >' + list.dealNature + '</td>' +
                                    ' <td >' + list.dealType + '</td>' +
                                    '<td><a class="btn btn-primary" onclick="SelectDeal(' + list.id + ')">Select</a></td> </tr>';
                                $("#Dealtbody").append(row);
                                sr++;
                            }
                        }

                        $('#deallist').dataTable();
                    }
                }
            });
        }

        function SelectDeal(id) {

            var url = "/api/Filter/GetFilterDealById?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var deal = response.data;

                        $("#DealCode").val(deal.id);
                        $("#Dealname").val(deal.dealName);
                        $("#dealId").val(deal.id);

                        $("#ApplyOntbody").empty();

                        $.each(deal.dealProperty, function (i, item) {

                            var rownumber2 = parseInt($("#rownumber1").val());
                            var LineId = rownumber2;
                            rownumber2 = rownumber2 + 1;

                            $("#rownumber1").val(rownumber2);

                            var row = '<tr id="PP' + rownumber2 + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber2 + '"/></td>' +
                                '<td> <input disabled class="form-control registrationNo"  value="' + item.registrationNo + '" /></td>' +
                                '<td> <input disabled class="form-control propertyNo" value="' + item.propertyNo + '"/></td>' +
                                '<td> <input disabled class="form-control outstandingBalance" value="' + item.outstandingBalance + '"/></td>' +
                                '<td> <input onkeypress="validateNumberInput(event)" class="form-control amountApplied" value="0" /></td>' +

                                '</tr>';

                            $("#ApplyOntbody").append(row);

                        });
                        $("#dealModal").modal("hide");
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Dealer");
                    }
                }
            });
        }
        // selection dealId end

        function AddRow() {

            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumber").val(rownumber);


            var row = '<tr id="R' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <a><input  class="form-control ReceiptNo" readonly /></a><a class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal" style="padding: 6px 7px;"> Search </a> </td > ' +
                '<td> <input class="form-control Amount" readonly/></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +

                '</tr>';


            $("#Receipttbody").append(row);
        }

        function DeleteItemRow(id) {
            $('#R' + id).remove();
            var rownumber = 1;
            $("#Receipttbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumber").val(rownumber - 1);
        }

        function SubmitRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            var methodType = 'POST';
            var url = "/api/AdvanceApplication/AddNewAdvanceApplication";
            var advanceApp = new Object();
            var advanceAppReciptsArr = new Array();
            var advanceAppPaymentApplyArr = new Array();

            //if ($("#Id").val()) {
            //    PaymemtPlan.Id = parseInt($("#Id").val());
            //    methodType = 'PUT';
            //url = "/api/AdvanceApplication/UpdateAdvanceApplication"
            //}

            advanceApp.DealerId = $("#dealerId").val();
            advanceApp.DealId = $("#dealId").val();
            advanceApp.ModifiedBy = $("#User_Id").val();
            advanceApp.CreatedBy = $("#User_Id").val();
            advanceApp.LastModifiedUserName = $("#User_Name").val();

            $("#ApplyOntbody tr").each(function () {
                var row = $(this);

                //set values
                let amountApplied = $(row).find(".amountApplied").val() == "" ? "0" : $(row).find(".amountApplied").val();

                var paymentApply = new Object();

                paymentApply.RegistrationNo = $(row).find(".registrationNo").val(),
                    paymentApply.PropertyNo = $(row).find(".propertyNo").val(),
                    paymentApply.OutstandingBalance = $(row).find(".outstandingBalance").val(),
                   
                    paymentApply.AmountApplied = amountApplied,

                    advanceAppPaymentApplyArr.push(paymentApply);
            });

            $("#Receipttbody tr").each(function () {
                var row = $(this);
                var recipt = new Object();

                recipt.ReciptNo = $(row).find(".ReceiptNo").val(),
                    recipt.Amount = $(row).find(".Amount").val(),

                    advanceAppReciptsArr.push(recipt);
            });

            advanceApp.DealAdvanceApplicationHistory = advanceAppPaymentApplyArr;
            advanceApp.DealAdvanceApplicationRecipt = advanceAppReciptsArr;

            var ModelData = JSON.stringify(advanceApp);
            $('#SubmitMR').prop('disabled', true);
            $.ajax({
                type: methodType,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                data: ModelData,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {

                        Swal.fire('Saved', response.message, 'success').then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Something went wrong");
                        // window.alert(response.message);
                    }
                }
            });
        }
    </script>
 }
