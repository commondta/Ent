@section Scripts {

    <script>
        $(document).ready(function() {
            GetAllBacklogBooking();
        });
   
       function GetAllBacklogBooking() {

            var methodType = 'GET';
            var url = "/api/Filter/GetAllNotPostedInvoicesForBooking";

             
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                success: function (response) {
                     $('#loader').fadeOut();
                    if (response.code === 100) {
                    
                       $("#BookingBackLOgtbody").empty();

                        var model = response.data;

                        var relist = model;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            
                            for (let list of relist) {

                                var errorin = list.bookingType == 1 ? "Booking Processing Charges" : "Booking Payment Schedule Charges";
                              
                                debugger;
                                var row = '<tr>' +
                                     '<td>' + list.id + '</td>' +
                                     '<td>' + list.registrationNo + '</td>' +
                                     '<td>' + list.propertyNo + '</td>' +
                                     '<td>' + list.memberName + '</td>' +
                                     '<td>' + list.bookingPrice + '</td>' +
                                    '<td>' + list.errorMessage + '</td>' +
                                    '<td>' + errorin + '</td>' +
                                    '<td> <a onclick="PostingBooking(' + list.id + ',' + list.bookingType + ')" class="btn btn-primary btn-sm"> POST</a></td>' +
            '</tr>';
                                if (list.bookingChargePosted == false) {
                                    $("#BookingBackLOgtbody").append(row);
                                    sr++;
                                    }
                                    


                            }
                            $("#BookingBackLOg").DataTable();

                        }
                       
                    }
                    else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        } 

  
    
      
      
function convertDate(date) {

    if (typeof date == "string")
        date = new Date(date);
    var day = (date.getDate() <= 9 ? "0" + date.getDate() : date.getDate());
    var month = (date.getMonth() + 1 <= 9 ? "0" + (date.getMonth() + 1) : (date.getMonth() + 1));
    var dateString = day + "/" + month + "/" + date.getFullYear();

    return dateString;

}


function PostingBooking(id,bookingtype) {
    var url = "/api/SapIntegration/PostingBackLogBooking";
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id, bookingtype: bookingtype },
               // async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    console.log(response);
                    NProgress.done();
                    $('#loader').fadeOut();
                    if (response.code === 0) {
                     
                        Swal.fire({
                                icon: 'Information',
                                title: 'Information',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
}
  </script>
 }
