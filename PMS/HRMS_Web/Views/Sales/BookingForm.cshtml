        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {
   
            var methodType = 'POST';
            var url = "/api/Booking/AddNewBooking";

            var booking = new Object();

            var bookingProcessingChargesArray = new Array();
            var bookingSchedulePaymentPlanDetailArray = new Array();
            var bookingJointMemberArray = new Array();
            var bookingNomineeArray = new Array();


            var jointOwners = $('#JointOwners').val() == 0 ? false : true;
            var dealerId = $('#dealerId').val() != "" ? $('#dealerId').val() : null;


            if ($("#Id").val()) {
             
                booking.id = parseInt($("#Id").val());
                methodType = 'POST';
                url = "/api/Booking/UpdateBooking"
            }

            booking.CreatedOn = $('#DocDate').val();
            booking.StockCreationId = $('#stockCreationId').val();
            booking.MemberProfileId = $('#memberProfileId').val();
            booking.DealerId = dealerId;
            booking.JointOwners = jointOwners;
            booking.Remarks = $('#Remarks').val();
            booking.CorrespondenceAddress = $('#CorrespondenceAddress').val();
            booking.CorrespondenceEmail = $('#CorrespondenceEmail').val();
            booking.CorrespondenceMobileNo = $('#CorrespondenceMobileNo').val();
            booking.CorrespondenceWhatsappNo = $('#CorrespondenceWhatsappNo').val();
            booking.BookingPrice = $('#BookingPrice').val();
            booking.AdvanceAmount = $('#AdvanceAmount').val();
            booking.BalanceAmount = $('#BalanceAmount').val();
            booking.ImageURL = $('#ImageURL').val();
            booking.AdvanceReceiptNo = $('#AdvRcptNo').val();
            booking.AdvanceReceiptDate = $('#ReceiptDate').val();
            booking.BookingConfirmationReceiptNo = $('#BConfNo').val();
            booking.BookingConfirmationReceiptDate = $('#BConfDate').val();
            booking.CreatedBy = $("#User_Id").val();
            booking.ModifiedBy = $("#User_Id").val();
            booking.LastModifiedUserName = $("#User_Name").val();

            $('#processingChargestbody tr').each(function () {

                var row = $(this);
                var processingcharg = new Object();

                processingcharg.FeeType = row.find('.FeeType').val();
                processingcharg.SapAccount = row.find('.sapAccount').val();
                processingcharg.Amount = row.find('.Amount').val();
                processingcharg.Remarks = row.find('.Remarks').val();

                bookingProcessingChargesArray.push(processingcharg);
            });

            $('#PaymentPlantbody tr').each(function () {

                var row = $(this);
                var paymentPlan = new Object();

                paymentPlan.PaymentTypeId = row.find('.paymentTypeId').val();
                paymentPlan.InstallementNo = row.find('.description').val();
                paymentPlan.ChargeTypeId = row.find('.chargeTypeId').val();
                paymentPlan.Days = row.find('.days').val();
                paymentPlan.DueDate = row.find('.dueDate').val();
                paymentPlan.Amount = row.find('.amount').val();
                paymentPlan.ReceiptNo = row.find('.receiptNo').val();
                paymentPlan.Remarks = row.find('.remarks').val();
                bookingSchedulePaymentPlanDetailArray.push(paymentPlan);
            });

            $('#JointMembertbody tr').each(function () {

                var row = $(this);

                var jointMember = new Object();

                jointMember.MemberProfileId = row.find('.JMemberProfile').val();
                jointMember.Name = row.find('.name').val();
                jointMember.Mobile = row.find('.mobile').val();
                jointMember.CNIC = row.find('.cnic').val();
                jointMember.Remarks = row.find('.Remarks').val();

                bookingJointMemberArray.push(jointMember);
            });

            $('#Nomineetbody tr').each(function () {

                var row = $(this);
                var nomineeMember = new Object();

                nomineeMember.Name = row.find('.NMemberProfile').val();
                nomineeMember.Relationship = row.find('.relationship').val();
                nomineeMember.CNIC = row.find('.cNIC').val();
                nomineeMember.Mobile = row.find('.mobileNo').val();
                nomineeMember.Address = row.find('.address').val();

                bookingNomineeArray.push(nomineeMember);
            });

            booking.BookingProcessingCharges = bookingProcessingChargesArray;
            booking.BookingSchedulePaymentPlanDetail = bookingSchedulePaymentPlanDetailArray;
            booking.BookingJointMember = bookingJointMemberArray;
            booking.BookingNominee = bookingNomineeArray;

            var model = JSON.stringify(booking);

            $('#sbbtn').prop('disabled', true); //disble
            NProgress.start();
            NProgress.set(0.0);
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,

                success: function (response) {
                    NProgress.done();
                    $('#loader').fadeOut();
                    if (response.code === 100) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                //location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $('#sbbtn').prop('disabled', false);

                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        })
                    }
                }
            });

        }

