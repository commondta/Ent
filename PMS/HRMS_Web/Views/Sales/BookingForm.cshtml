        // calculation run time
        function calculateNetAmount(event) {

            let tbody = document.querySelector('#PaymentPlantbody');
            let tr = event.target.closest('tr');
            let netAmountInputs = tbody.querySelectorAll('input[name="netAmount"]');
            let bookingPrice = 0.00;

            // Loop through each netAmount input and add its value to bookingPrice
            netAmountInputs.forEach(function (input) {
                bookingPrice += parseFloat(input.value) || 0.00;
            });

            // Update the value of the bookingPrice input field
            $("#BookingPrice").val(bookingPrice);
        }

        // on start
        function calculatation() {

            const tbody = document.querySelector('#PaymentPlantbody');
            let bookingPrice = 0.00;

            tbody.querySelectorAll('tr').forEach((tr) => {

                let netAmount = parseFloat(tr.querySelector('input[name="netAmount"]').value);
                bookingPrice = bookingPrice + netAmount;

            });

            $("#BookingPrice").val(bookingPrice.toFixed(2));
        }

