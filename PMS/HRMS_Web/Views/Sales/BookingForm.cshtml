        function safeFormatDate(date) {
            if (!date) return "";
            const d = (date instanceof Date) ? date : new Date(date);
            if (isNaN(d.getTime())) return ""; // invalid date fallback
            return formatDate(d); // your existing formatDate function
        }

        function PrintLetter(id) {
