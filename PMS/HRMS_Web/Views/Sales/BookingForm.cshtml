                                    '</a> ' +
                                    '<a class="btn btn-info btn-sm" title="Print Letter" onclick="PrintLetter(' + list.id + ')">' +
                                    '<i class="fa fa-print"></i> Letter' +
                                    '</a>' +
                                    '</td>' +
