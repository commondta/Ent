        function SelectBooking(id) {
          
            var url = "/api/Booking/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        $("#BookingModal").modal("hide");
                        var Booking_User = response.data;
                        let memberImage = Booking_User.memberProfile.imageURL == "" ? "/img/placeholder-photo.svg" : Booking_User.memberProfile.imageURL;
                        let jointImage = Booking_User.imageURL == "" ? "/img/placeholder-photo.svg" : Booking_User.memberProfile.imageURL;
                        let dealerCode = Booking_User.dealerId != null ? "Y" : "N";
                        let joinownerr = Booking_User.jointOwners == true ? "1" : "0";
                        let overSeas = Booking_User.memberProfile.overSeas == 1 ? "Yes" : "No";
                        let dob = Booking_User.memberProfile.dob == null ? "0001-01-01" : (Booking_User.memberProfile.dob).split('T')[0];
                        let cnicExp = (Booking_User.memberProfile.cnicExpiryDate).split('T')[0] ?? "0001-01-01";

                        let AdvancDatt = (Booking_User.advanceReceiptDate).split('T')[0] ?? "0001-01-01";
                        let bookingconfdate = (Booking_User.bookingConfirmationReceiptDate).split('T')[0] ?? "0001-01-01";

                        let passExpDate = (Booking_User.memberProfile.passportExpiryDate).split('T')[0] ?? "0001-01-01";

                        $("#Id").val(Booking_User.id);
                        $("#PreviewUrl").attr("src", memberImage);
