        function SelectPaymentPlan(id) {

            var url = "/api/Filter/GetBookingPlanFromPreSale?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                   
                    if (response.code === 100) {

                        $("#PaymentPlantbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            for (let item of relist) {

                                let daysToAdd = item.days;
                                let currentDate = new Date();
                                let newDate = new Date(currentDate.getTime() + (daysToAdd * 24 * 60 * 60 * 1000));
                                let year = newDate.getFullYear();
                                let month = newDate.getMonth() + 1;
                                let day = newDate.getDate();
                                let formattedDate = `${year}-${("0" + month).slice(-2)}-${("0" + day).slice(-2)}`;

                                var rownumber2 = parseInt($("#rownumberPP").val());
                                var LineId = rownumber2;
                                rownumber2 = rownumber2 + 1;
                                $("#rownumberPP").val(rownumber2);

                                var row = '<tr id="PP' + rownumber2 + '" DetailId="0"> ' +
                                    '<td> <input disabled type="number" class="form-control line" value="' + rownumber2 + '"/></td>' +
                                    '<td> <input required name="Validate[' + rownumber2 + '].description" class="form-control description" value="' + item.paymentType + '" /></td>' +
                                    '<td class="hide"> <input class="form-control chargeTypeId" value="' + item.chargeTypeId + '" /></td>' +
                                    '<td> <input required name="Validate[' + rownumber2 + '].days" onkeypress="validateNumberInput(event)" class="form-control days" value="' + item.days + '" /></td>' +
                                    '<td> <input required name="Validate[' + rownumber2 + '].dueDate" type="date" class="form-control dueDate" value="' + formattedDate + '" /></td>' +
                                    '<td> <input onkeypress="validateNumberInput(event)" type="number" name="netAmount" onkeyup="calculateNetAmount(event)" class="form-control amount" value="' + item.netAmount + '" /></td>' +
                                    '<td> <input type="text" class="form-control receiptNo" value="N/A" /></td>' +
                                    '<td> <input class="form-control remarks" /></td>' +
                                    '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeletePaymentPlanRow(\'' + rownumber2 + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                    '</tr>';

                                $("#PaymentPlantbody").append(row);

                            }
                        }
                        calculatation();
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Payment Plan',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

