<!-- Middle Content Start -->

<div class="vd_content-wrapper">
    <div class="vd_container">
        <div class="vd_content clearfix">
            <div class="vd_head-section clearfix">
                <div class="vd_panel-header">
                    <ul class="breadcrumb">
                        <li><a href="/Home/index">Home</a> </li>
                        <li class="active">Deal Setup</li>
                    </ul>
                    <div class="vd_panel-menu hidden-sm hidden-xs" data-intro="<strong>Expand Control</strong><br/>To expand content page horizontally, vertically, or Both. If you just need one button just simply remove the other button code." data-step=5 data-position="left">
                        <div data-action="remove-navbar" data-original-title="Remove Navigation Bar Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-navbar-button menu"> <i class="fa fa-arrows-h"></i> </div>
                        <div data-action="remove-header" data-original-title="Remove Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-header-button menu"> <i class="fa fa-arrows-v"></i> </div>
                        <div data-action="fullscreen" data-original-title="Remove Navigation Bar and Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="fullscreen-button menu"> <i class="glyphicon glyphicon-fullscreen"></i> </div>

                    </div>

                </div>
            </div>
            <!-- vd_head-section -->

            <div class="vd_title-section clearfix">
                <div class="vd_panel-header">
                    <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-briefcase" viewBox="0 0 16 16"><path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5m1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0M1.5 4h13a.5.5 0 0 1 .5.5v1.616L8.129 7.948a.5.5 0 0 1-.258 0L1 6.116V4.5a.5.5 0 0 1 .5-.5"/></svg></span>
                    <h1>DEAL SETUP</h1>
                    <small class="subtitle">DEAL SETUP</small>
                    <div class="vd_panel-menu  hidden-xs">

                        <div class="menu">

                            @*  <a class="btn btn-primary btn-sm btn-theme" data-toggle="modal" data-target="#myModal">Add New</a>*@

                        </div>
                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->

            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        <form class="custom-validation" id="dealsetup">
                            <div class="row">
                                <div class="col-sm-6">
                                    <label>Document No.</label>
                                    <div>
                                        <div>
                                            <input type="text" class="form-control"
                                                   placeholder=" " id="docno" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Document Date</label>
                                    <div>
                                        <div>
                                            <input type="date" class="form-control"
                                                   placeholder=" " id="docdt" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Deal Code</label>
                                    <div>
                                        <div>
                                            <input type="text" class="form-control"
                                                   placeholder=" " id="dlcode" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Deal Name</label>
                                    <div>
                                        <div>
                                            <input type="text" class="form-control"
                                                   placeholder=" " id="dlname" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Deal Date</label>
                                    <div>
                                        <input type="date" class="form-control"
                                               placeholder=" " id="dealdt" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Expiry Date</label>
                                    <div>
                                        <input type="date" class="form-control"
                                               placeholder=" " id="expdt" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Commission</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="comm" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Total Value</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="tvalue" />
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <label>Rebate</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="rebate" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Net Receivable</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="netR" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Total Received</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="totalR" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Outstanding Receivable</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="outsts" />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label>Status</label>
                                    <div>
                                        <input type="text" class="form-control"
                                               placeholder=" " id="status" />
                                    </div>
                                </div>
                            </div>



                            <div class="container-fluid">
                                <div class="card p-3">
                                    <div class="col-md-12">
                                        <div class="menu" style="float: right;">

                                            <a class="btn btn-primary btn-sm btn-theme" onclick="AddRow()">Add New</a>
                                            <input type="text" id="rownumber" value="0" class="hide" />
                                        </div>
                                        <br>
                                        <br>
                                        <div class="table-responsive">
                                            <table id="DealSetup" class="table table-bordered table-hover mb-0">
                                                <thead class="bg-theme">
                                                    <tr>
                                                        <th class="text-white" style="min-width:70px";>#</th>
                                                        <th class="text-white">Real Estate Type</th>
                                                        <th class="text-white">Project</th>
                                                        <th class="text-white">Block</th>
                                                        <th class="text-white">Property No.(From)</th>
                                                        <th class="text-white">Property No.(To)</th>
                                                        <th class="text-white">Registration No.(From)</th>
                                                        <th class="text-white">Registration No.(To)</th>
                                                        <th class="text-white">Total Advance</th>
                                                        <th class="text-white">Rebate</th>
                                                        <th class="text-white">Net Receivable</th>
                                                        <th class="text-white">Applied Amount</th>
                                                        <th class="text-white">Outstanding Balance</th>
                                                        <th class="text-white">Remarks</th>
                                                        <th class="text-white">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="DealSetuptbody">
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <br>

                        <div class="col-12" style="float: right;">
                            <input type="button" class="btn btn-primary btn-sm btn-theme" style="margin:5px;" value="Add " />
                            <input type="button" class="btn btn-primary btn-sm btn-theme" style="margin:5px;" value="Cancel">
                        </div>
                    </div>
                </div>




            </div>
            <!-- .vd_content-section -->

        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>



@section Scripts {

    <script>
        function AddRow() {
          
            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumber").val(rownumber);


                 var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <select  class="form-control RealEstateType" /></td>' +
                '<td> <select  class="form-control Project" /></td>' +
                '<td> <select  class="form-control Block" /></td>' +
                '<td> <select  class="form-control Property No.(From)" /></td>' +
                '<td> <select  class="form-control Property No.(To)" /></td>' +
                '<td> <select  class="form-control Registration No.(From)" /></td>' +
                '<td> <select  class="form-control Registration No.(To)" /></td>' +
                '<td> <input  class="form-control Total Advance" /></td>' +
                '<td> <input  class="form-control Rebate" /></td>' +
                '<td> <input  class="form-control Net Receivable" /></td>' +
                '<td> <input  class="form-control Applied Amount" /></td>' +
                '<td> <input  class="form-control Outstanding Balance" /></td>' +
                '<td> <textarea  class="form-control Remarks" ></textarea></td>' +

                '<td style="padding-top:20px"><a class="btn btn-sm btn-danger"  onclick="return DeleteItemRow(\'' + rownumber + '\')">X</a> </td>' +
                '</tr>';


            $("#DealSetuptbody").append(row);


        }

        function DeleteItemRow(id) {
            $('#' + id).remove();
        }
    </script>

 }
