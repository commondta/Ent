                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <select required name="Validate[' + rownumber + '].designation" name="designation" id="designation'+rownumber+'" class="form-control designation" /></td>' +
                                '<td> <input required name="Validate[' + rownumber + '].name" class="form-control name" value="' + item.name + '" /></td>' +
                                '<td> <input required minlength="13" maxlength="13" name="Validate[' + rownumber + '].cNIC" name="cNIC"  class="form-control cNIC" onkeypress="validateNumberInput(event)" value="' + item.cnic + '"/></td>' +
                                '<td> <input required name="Validate[' + rownumber + '].mobileNo"  class="form-control mobileNo"  onkeypress="validateNumberInput(event)"  value="' + item.mobileNo + '" /></td>' +
                                '<td> <input  class="form-control telephoneNo" onkeypress="validateNumberInput(event)"    value="' + item.telephoneNo + '" /></td>' +
                                '<td> <input  required name="Validate[' + rownumber + '].emailAddress" class="form-control emailAddress" type="email" value="' + item.emailAddress + '" /></td>' +
                                '<td> <input  name="Validate[' + rownumber + '].address" class="form-control address" value="' + item.address + '" /></td>' +
                                '<td> <textarea  class="form-control remarks">' + item.remarks + ' </textarea></td>' +
                                '<td> <input type="file" class="form-control attachmentPath" /><input class="form-control CopyToTargetDocument hide" value="' + dealerEstateImage + '"/></td>' +
                                '<td class="ViewAttachment" style="padding-top:10px"><a><img style="width:100px" src="' + dealerEstateImage + '" class="clickme" ></a></img></td>' +
                                '<td> <input ' + isPrimary + ' class="checkboxfield isPrimary"  type = "checkbox"   /> </td>' +
                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteEItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';


                            $("#EstateNametbody").append(row);
                            GetDealerDesignation(rownumber, item.dealerDesignationId);
                        });

                        $("#Attachmentstbody").empty();

