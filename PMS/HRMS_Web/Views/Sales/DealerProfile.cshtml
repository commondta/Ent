        function SelectDealerProfile(id) {
            
            var url = "/api/Dealer/Get?id=" + id + "";
           
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                contentType: 'application/json',
                success: function (response) {
                    
                    if (response.code === 100) {
                        var dealer_User = response.data;

                        let dealerImage = dealer_User.pictureBase64 == "" ? "/img/placeholder-photo.svg" : dealer_User.pictureBase64;
                        let renewalDate = (dealer_User.renewalDate).split('T')[0] ?? "N/A";
                        let dateofRegistration = (dealer_User.createdOn).split('T')[0] ?? "N/A";

                        $("#Id").val(dealer_User.id);
                        $("#ImageURL").val(dealerImage);
                        $("#PreviewUrl").attr("src", dealerImage);
                        $('#DealerCategoryId').val(dealer_User.dealerCategory.id).trigger('change');
                        $('#PrincipalOwner').val(dealer_User.principalOwner);
                        $('#Cnic').val(dealer_User.cnic);
                        $('#dateofRegistration').val(dateofRegistration);
                        $('#ResidentialAddress').val(dealer_User.residentialAddress);
                        $('#EstateName').val(dealer_User.estateName);
                        $('#EstateAddress').val(dealer_User.estateAddress);
                        $('#ContactNo').val(dealer_User.contactNo);
                        $('#Email').val(dealer_User.email);
                        $('#RenewalDate').val(renewalDate);
                        $('#Nationality').val(dealer_User.nationality);
                        $('#Country').val(dealer_User.country);
                        $('#City').val(dealer_User.city);
                        $('#RegistrationFee').val(dealer_User.registrationFee);
                        $('#DealerStatus').val(dealer_User.dealerStatus);
                        $('#OutstandingBalance').val(dealer_User.outstandingBalance);
                        $('#OutstandingAdvance').val(dealer_User.outstandingAdvance);
                        $('#DelaerRegisrationCode').val(dealer_User.delaerRegisrationCode);
                        $('#UserName').val(dealer_User.userName);
                        $('#Password').val(dealer_User.password);
                        $("#dealerModal").modal("hide");

                        LoadApprovalHistory(dealer_User.id);

                        $("#EstateNametbody").empty();

                        $.each(dealer_User.dealerEstateDeatail, function (i, item) {
                            var rownumber = parseInt($("#rownumberE").val());
                            let dealerEstateImage = item.picture == "" ? "/img/placeholder-photo.svg" : item.picture;
