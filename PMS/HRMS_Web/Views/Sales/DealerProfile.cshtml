    <script>

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() {

            var methodType = 'POST';
            var url = "/api/Dealer/AddDealer";

            var DealerProfile = new Object();
            var EstateDetailArr = new Array();
            debugger;
            var DealerRelationshipHistoryArr = new Array();
            var DealerEstate = new Array();
            var AttachmentArr = new Array();

            if ($("#Id").val()) {

                DealerProfile.id = parseInt($("#Id").val());
                methodType = 'PUT';
                url = "/api/Dealer/UpdateDealer"
            }

            DealerProfile.RegistrationFee = $("#RegistrationFee").val();
            DealerProfile.DealerStatus = $("#DealerStatus").val();
            DealerProfile.DealerCategoryId = $("#DealerCategoryId").val();
            DealerProfile.PrincipalOwner = $("#PrincipalOwner").val();
            DealerProfile.CNIC = $("#Cnic").val();
            DealerProfile.ResidentialAddress = $("#ResidentialAddress").val();
            DealerProfile.EstateName = $("#EstateName").val();
            DealerProfile.EstateAddress = $("#EstateAddress").val();
            DealerProfile.Email = $("#Email").val();
            DealerProfile.ContactNo = $("#ContactNo").val();
            DealerProfile.RenewalDate = $("#RenewalDate").val();
            DealerProfile.Nationality = $("#Nationality").val();
            DealerProfile.Country = $("#Country").val();
            DealerProfile.City = $("#City").val();
            DealerProfile.OutstandingBalance = $("#OutstandingBalance").val();
            DealerProfile.OutstandingAdvance = $("#OutstandingAdvance").val();
            DealerProfile.DelaerRegisrationCode = $("#DelaerRegisrationCode").val();
            DealerProfile.UserName = $("#UserName").val();
            DealerProfile.Password = $("#Password").val();
            DealerProfile.ModifiedBy = $("#User_Id").val();
            DealerProfile.CreatedBy = $("#User_Id").val();
            DealerProfile.CreatedOn = $("#dateofRegistration").val();
            DealerProfile.LastModifiedUserName = $("#User_Name").val();

            DealerProfile.PictureBase64 = $("#ImageURL").val();


            $("#EstateNametbody tr").each(function () {
                debugger;
                var row = $(this);
                var estateDetail = new Object();

                    let isPrimary = row.find('.isPrimary').is(":checked");

                    estateDetail.DealerDesignationId = row.find(".designation").val(),
                    estateDetail.Name = row.find(".name").val(),
                    estateDetail.CNIC = row.find(".cNIC").val(),
                    estateDetail.MobileNo = row.find(".mobileNo").val(),
                    estateDetail.TelephoneNo = row.find(".telephoneNo").val(),
                    estateDetail.EmailAddress = row.find(".emailAddress").val(),
                    estateDetail.Address = row.find(".address").val(),
                    estateDetail.Remarks = row.find(".remarks").val(),
                    estateDetail.Picture = row.find(".CopyToTargetDocument").val(),
                    estateDetail.IsPrimary = isPrimary,

                    EstateDetailArr.push(estateDetail);

            });
            debugger;
            $("#RelationshipHistorytbody tr").each(function () {
                var row = $(this);
                var DealerRelationshipHistory = new Object();
                let relationshipresolutionDatee = row.find(".resolationDate").val() == "" ? null : row.find(".resolationDate").val();

                    DealerRelationshipHistory.AlertDate = row.find(".alertDate").val(),
                    DealerRelationshipHistory.AlertNarration = row.find(".alertNarration").val(),
                    DealerRelationshipHistory.AlertType = row.find(".alertType").val(),
                    DealerRelationshipHistory.ResolationDate = relationshipresolutionDatee,
                    DealerRelationshipHistory.ResolationDescription = row.find(".resolutionDescription").val(),

                    DealerRelationshipHistoryArr.push(DealerRelationshipHistory);
            });

            $("#Attachmentstbody tr").each(function () {
                var row = $(this);
                var Attachment = new Object();

                Attachment.AttachmentName = row.find(".attachmentName").val(),
                    Attachment.AttachmentDate = row.find(".attachmentDate").val(),
                    Attachment.Attachment = row.find(".CopyToTargetDocument").val(),
                    Attachment.Remarks = row.find(".remarks").val(),

                    AttachmentArr.push(Attachment);
            });
            
            $("#jointtbody tr").each(function () {
                var row = $(this);
                var DealerEstae = new Object();

                DealerEstae.Name = row.find(".name").val(),
                    DealerEstae.Designation = row.find(".designation").val(),
                    DealerEstae.Email = row.find(".email").val(),
                    DealerEstae.MobileNo = row.find(".mobileNo").val(),
                    DealerEstae.Remarks = "",
                    DealerEstae.CNIC = row.find(".cNIC").val(),

                    DealerEstate.push(DealerEstae);
            });

            DealerProfile.DealerEstateDeatail = EstateDetailArr;
            DealerProfile.DealerRelationshipHistory = DealerRelationshipHistoryArr;
            DealerProfile.DealerAttachments = AttachmentArr;
            DealerProfile.DealerWitness = DealerEstate;

            var ModelData = JSON.stringify(DealerProfile);
       
            $('#sbt').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                processData: false,
                dataType: "json",
                data: ModelData,
                success: function (response) {
                    debugger;
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'success',
                            text: 'DealerProfile Save Data',
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else if (response.code === 102) {
                        $('#sbt').prop('disabled', true);
                        ResponseMessageModal("warning", response.message);
                    }
                    else {
                        $('#sbt').prop('disabled', true);
                        ResponseMessageModal("error", response.message);
                    }
                }
            });
          
        }

        function clear() {
            $("#Id").val("");
            $("#RegistrationFee").val("");
            $("#DealerStatus").val("");
            $("#CNIC").val("");
            $("#ResidentialAddress").val("");
            $("#DealerCategoryId").val("")
            $("#PrincipalOwner").val("");
            $("#EstateName").val("");
            $("#EstateAddress").val("");
            $("#RenewalDate").val("");
            $("#Nationality").val("");
            $("#Country").val("");
            $("#City").val("");
            $("#OutstandingBalance").val("0");
            $("#OutstandingAdvance").val("0");
            $("#UserName").val("");
            $("#Password").val("");
            $("#EstateNametbody").empty();
            $("#RelationshipHistorytbody").empty();
            $("#Attachmentstbody").empty();
        }
        function ResponseMessageModal(iconValue, responseMessage, callBack) {
            const options = {
                position: 'center',
                icon: iconValue,
                title: responseMessage,
                showConfirmButton: false,
                timer: 2000
            }
            if (iconValue == "success") {
                delete options.timer
                options.showConfirmButton = true
            }
            Swal.fire(options).then((result) => {
                if (result.isConfirmed && typeof callBack == "function")
                    callBack()
            })
        }
        
        function AddRowJointMember() {

            var rownumber = parseInt($("#rownumberJ").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumberJ").val(rownumber);
            var row = '<tr id="J' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td style="width: 250px;"><a class="btn btn-primary btn-sm btn-theme" onclick="GetMember(' + rownumber + ')" style="padding: 6px 7px; margin-left: 32px;"> Search </a> </td > ' +                            
                '<td> <input readonly required id="name_' + rownumber + '" name="name[' + rownumber + ']" class="form-control name" /></td>' +
                '<td> <input readonly required id="designation_' + rownumber + '" name="designation[' + rownumber + ']" class="form-control designation " /></td>' +
                '<td> <input readonly required id="cnic_' + rownumber + '" name="cNIC[' + rownumber + ']" class="form-control  cNIC " /></td>' +
                '<td> <input readonly required id="mobileNo_' + rownumber + '" name="mobileNo[' + rownumber + ']" class="form-control  mobileNo" /></td>' +
                '<td> <input readonly required id="email_' + rownumber + '" name="email[' + rownumber + ']" class="form-control  email " /></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteJointMemberRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';
            $("#jointtbody").append(row);

        }
        function GetMember(id) {
            GetAllMemberList();
            $("#rownumberforid").val(id);
            $("#JMemberModal").modal("show");
        }

        function DeleteJointMemberRow(id) {
            $('#J' + id).remove();
             var rownumber = 1;
            $("#jointtbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberJ").val(rownumber - 1);
        }
          function GetAllMemberList() {
            $.ajax({
                type: 'GET',
                url: "/api/Dealer/GetAllDealerEstates",
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#JMembertbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td >' + sr + '</td> ' +
                                    ' <td>' + list.name + '</td> ' +
                                    ' <td>' + list.mobileNo + '</td> ' +
                                    ' <td>' + list.cnic + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectDealerEstate(' + list.id + ')">Select</a></td> </tr>';
                                $("#JMembertbody").append(row);
                                sr++;
                            }
                        }

                        $('#JMemberModalTable').dataTable();
                    }
                }
            });
        }
        
        function SelectDealerEstate(id) {

            var url = "/api/Dealer/SelectDealerEstateById?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        debugger;
                        var result_User = response.data;
                        var rownumber = $("#rownumberforid").val();
                        $("#name_" + rownumber).val(result_User.name);
                        $("#designation_" + rownumber).val(result_User.description);
                        $("#cnic_" + rownumber).val(result_User.cnic);
                        $("#mobileNo_" + rownumber).val(result_User.mobileNo);
                        $("#email_" + rownumber).val(result_User.emailAddress);
                        
                        $("#JMemberModal").modal("hide");
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
    </script>    
 }
