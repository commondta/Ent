    @section Scripts {

    <script>
        function AddRow() {


            var rownumber = parseInt($("#rownumber").val());
            var LineId = rownumber;
            rownumber = rownumber + 1;
            $("#rownumber").val(rownumber);


            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                '<td> <select  class="form-control DealCode" /></td>' +
                '<td> <input disabled  class="form-control DealName" /></td>' +
                '<td> <select  class="form-control Block" /></td>' +
                '<td> <select  class="form-control PropertyNo.(From)" /></td>' +
                '<td> <select  class="form-control PropertyNo.(To)" /></td>' +
                '<td> <input  class="form-control Remarks" /></td>' +
                '<td> <input  class="form-control Quantity" /></td>' +
                '<td> <input  class="form-control Status" /></td>' +

                '<td style="padding-top:20px"><a class="btn btn-sm btn-danger"  onclick="return DeleteItemRow(\'' + rownumber + '\')">X</a> </td>' +
                '</tr>';


            $("#DReservationtbody").append(row);


        }

        function DeleteItemRow(id) {
            $('#' + id).remove();
        }
    </script>

