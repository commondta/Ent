        function SubmitRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            var methodType = 'POST';
            var url = "/api/LeadGenration/AddNewLeadGenration";

            var SocialStatusArr = new Array();
            var LGActivitiesArr = new Array();
            var LGInterestArr = new Array();
            var LG = new Object();

            debugger;
            if ($("#Id").val()) {
                debugger;
                LG.Id = parseInt($("#Id").val());
                methodType = 'PUT';
                url = "/api/LeadGenration/UpdateLeadGenration"
            }


            LG.HonorificsName = $("#HonorificsName").val();
            LG.Name = $("#Name").val();
            LG.HonorificsContactPersoon = $("#HonorificsContactPersoon").val();
            LG.ContactPerson = $("#ContactPerson").val();
            LG.ContactPersonNumber = $("#ContactPersonNumber").val();
            LG.Relationship = $("#Relationship").val();
            LG.RelationshipWith = $("#RelationshipWith").val();
            LG.Cnic = $("#Cnic").val();
            LG.CnicExpirtyDate = $("#CnicExpirtyDate").val();
            LG.MobileNo = $("#MobileNo").val();
            LG.WhatsAppNo = $("#WhatsAppNo").val();
            LG.Nationality = $("#Nationality").val();
            LG.CountryOfResidence = $("#CountryOfResidence").val();
            LG.CityOfResidence = $("#CityOfResidence").val();
            LG.EmailId = $("#EmailId").val();
            LG.Interst = $("#Interst").val();
            LG.Gender = $("#Gender").val();
            LG.SourceOfInfo = $("#SourceOfInfo").val();
            LG.ModeOfContact = $("#ModeOfContact").val();
            LG.Remarks = $("#Remarks").val();
            LG.LGType = $("#LGType").val();
            LG.CreatedBy = $("#userid").val();
            LG.ModifiedBy = $("#userid").val();
            LG.LastModifiedUserName = $("#User_Name").val();

            $("#SocialStatustbody tr").each(function () {
                var row = $(this);
                var LGSocialStatus = new Object();


                LGSocialStatus.SocialStatus = row.find(".socialStatus").val(),
                    SocialStatusArr.push(LGSocialStatus);
            });
            $("#Activitiestbody tr").each(function () {
                var row = $(this);
                var LGActivities = new Object();


                LGActivities.ContactDate = row.find(".contactDate").val(),
                    LGActivities.ContactPerson = row.find(".contactPerson").val(),
                    LGActivities.ModeOfConatcat = row.find(".modeOfContact").val(),
                    LGActivities.Response = row.find(".response").val(),
                    LGActivities.NextContactDate = row.find(".nextContactDate").val(),
                    LGActivitiesArr.push(LGActivities);
            });
            $("#MemberInteresttbody tr").each(function () {
                var row = $(this);
                var MemberInterest = new Object();


                MemberInterest.PropertyNature = row.find(".propertyNature").val(),
                    MemberInterest.PropertyType = row.find(".propertyType").val(),
                    MemberInterest.Category = row.find(".category").val(),

                    LGInterestArr.push(MemberInterest);
            });

            LG.LGSocialStatus = SocialStatusArr;
            LG.LGActivities = LGActivitiesArr;
            LG.LGInterests = LGInterestArr;

            var ModelData = JSON.stringify(LG);

            debugger;
            $('#SubmitRequest').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({
                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                //   async: false,
                data: ModelData,
                success: function (response) {
                    debugger;
                    $('#loader').fadeOut();
                    console.log(response);
                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                //location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else if (response.code === 2) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }

                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                    }
                }
            });
        }

        var checkCNIC = function (textBox) {

            var regexp = new RegExp('^[0-9+]{5}[0-9+]{7}[0-9]{1}$');
            var check = textBox.value;
            if (!regexp.test(check)) {
                $(textBox).css('border-color', 'red');
                return false;

            }
            else {
                $(textBox).css('border-color', '#D5D5D5');
                $(textBox).value = check;
                return true;
            }
        }

