@section Scripts {

    <script>
        $(document).ready(function () {

            $("#LeadGenerationForm").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    HonorificsName: {

                        required: true
                    },
                    Name: {
                        required: true
                    },
                    Gender: {
                        required: true
                    },
                    MobileNo: {
                        required: true
                    },
                    ModeOfContact: {
                        required: true
                    }
                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SubmitRequest();
                }
            });
            GetPreviousRecords();
        });


        function refreshPage() {
            location.reload();
        }

        function GetPreviousRecords() {
            const userId = $("#userid").val();
            var url = "/api/LeadGenration/GetAllByUserId?userId=" + userId + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        debugger;
                        $("#LeadGenerationTbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td>' + list.name + '</td>           ' +
                                    ' <td>' + list.mobileNo + '</td>           ' +
                                    ' <td>' + list.cnic + '</td>           ' +
                                    ' <td>' + list.remarks + '</td>           ' +
                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a>' +
                                    '<a class="fa fa-trash-o fa-2x text-danger hide" onclick="DeleteSingleChargeSetup(' + list.id + ')"></a></td> </tr>';

                                $("#LeadGenerationTbody").append(row);
                                sr++;
                            }
                        }

                        $('#LeadGenerationTable').dataTable();
                    }
                }
            });
        }


        function SelectSinglePPS(id) {
            debugger;
            var url = "/api/LeadGenration/Get?id=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        let result_User = response.data;

                        let CnicExp = (result_User.cnicExpirtyDate).split('T')[0] ?? "N/A";


                        $("#Id").val(result_User.id);
                        //$("#DocDate").val(Documentdate);
                        $("#HonorificsName").val(result_User.honorificsName);
                        $("#HonorificsName").trigger('change');
                        $("#Name").val(result_User.name);
                        $("#Gender").val(result_User.gender);
                        $("#Gender").trigger('change');

                        $("#HonorificsContactPersoon").val(result_User.honorificsContactPersoon);
                        $("#HonorificsContactPersoon").trigger('change');
                        $("#ContactPerson").val(result_User.contactPerson);
                        $("#ContactPersonNumber").val(result_User.contactPersonNumber);
                        $("#Relationship").val(result_User.relationship);
                        $("#Relationship").trigger('change');
                        $("#RelationshipWith").val(result_User.relationshipWith);
                        $("#SourceOfInfo").val(result_User.sourceOfInfo);
                        $("#Cnic").val(result_User.cnic);
                        $("#CnicExpirtyDate").val(CnicExp);
                        $("#MobileNo").val(result_User.mobileNo);
                        $("#Nationality").val(result_User.nationality);
                        $("#CountryOfResidence").val(result_User.countryOfResidence);
                        $("#CityOfResidence").val(result_User.cityOfResidence);
                        $("#ModeOfContact").val(result_User.modeOfContact);
                        $("#ModeOfContact").trigger('change');
                        $("#EmailId").val(result_User.emailId);
                        $("#WhatsAppNo").val(result_User.whatsAppNo);
                        $("#Interst").val(result_User.interst);
                        $("#Remarks").val(result_User.remarks);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);

                        $("#SocialStatustbody").empty();
                        $("#Activitiestbody").empty();
                        $("#MemberInteresttbody").empty();

                        $.each(response.data.lgSocialStatus, function (i, item) {

                            var rownumber = parseInt($("#rownumber").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumber").val(rownumber);

