                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                //async: false,
                data: ModelData,
                success: function (response) {

                    if (response.code == 100) {
                        NProgress.done();
                        $('#loader').fadeOut();
                        Swal.fire({
                            icon: 'success',
                            title: 'success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                //location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'error')
                            }
                        })

                    }
                    else if (response.code === 4) {
                        NProgress.done();
                        $('#loader').fadeOut();
                        $('#sbt').prop('disabled', false); //enable
                        // notification("bottomleft", "warning", "fa fa-warning", "Warning", response.message);
                        ResponseMessageModal("warning", response.message);

                    }
                    else if (response.code === 102) {
                        NProgress.done();
                        $('#loader').fadeOut();
                        $('#sbt').prop('disabled', false); //enable
                        // notification("bottomleft", "warning", "fa fa-warning", "Warning", response.message);
                        ResponseMessageModal("warning", response.message);

                    }
                    else {
                        NProgress.done();
                        $('#loader').fadeOut();
                        $('#sbt').prop('disabled', false); //enable
                        // notification("bottomleft", "error", "fa fa-error", "Error", response.message);
                        ResponseMessageModal("error", response.message);
                    }
                }

            });


        }

        function ResponseMessageModal(iconValue, responseMessage) {
            Swal.fire({
                position: 'center',
                icon: iconValue,
                title: responseMessage,
                showConfirmButton: true,
                //timer: 4000
            })
        }

        function GetDataFromSap(memberProfileId) {
            $.ajax({
                type: 'GET',
                url: `/api/SapIntegration/GetFinanacialsData`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { memberProfileId: memberProfileId },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    $("#Cleartbody").empty();
                    if (response.code === 100) {
                        //$("#Cleartbody").empty();
                        $.each(response.data, function (index, clearence) {
                            var rownumber = index + 1;
                            var duedate = clearence.docDueDate.split("T")[0];

                            var row = '<tr id="L' + rownumber + '" DetailId="0"> ' +
                                '<td>' + rownumber + '</td>' +
                                '<td>' + clearence.project + '</td>' +
                                '<td>' + clearence.acctName + '</td>' +
                                '<td>' + clearence.docNum + '</td>' +
                                '<td>' + duedate + '</td>' +
                                '<td>' + clearence.accntntCod + '</td>' +
                                '<td>' + clearence.receiptNum + '</td>' +
                                '<td>' + clearence.docTotal + '</td>' +
                                '<td>' + clearence.totalRecieved + '</td>' +
                                '<td>' + clearence.balanceDue + '</td>' +
                                '<td> </td>' +
                                '</tr>';
                            $("#Cleartbody").append(row);
                        });
                    }
                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Lead");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

