            MP.PermanentAddress = $("#PermanentAddress").val();
            MP.Vehicle = $("#Vehicle").val();
            MP.Mobile = $("#Mobile").val();
            MP.MothersMaidenName = $("#MothersMaidenName").val();
            MP.HomeNo = $("#HomeNo").val();
            MP.WhatsAppNo = $("#WhatsAppNo").val();
            MP.OfficeNo = $("#OfficeNo").val();
            MP.ImoNo = $("#ImoNo").val();
            MP.EmailId = $("#EmailId").val();
            MP.InstagramId = $("#InstagramId").val();
            MP.LinkedId = $("#LinkedId").val();
            MP.FacebookId = $("#FacebookId").val();
            MP.TwitterId = $("#TwitterId").val();
            MP.Profession = $("#Profession").val();
