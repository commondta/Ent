        function GetAllMemberCategories() {

            $.ajax({
                type: 'GET',
                url: `/api/MemberCategory/GetAllMemberCategorys`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#MemberCategory").empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#MemberCategory").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.description + '" >' + list.description + '</option> ';

                                $("#MemberCategory").append(row);

                                sr++;

                            }
                        }

                        $('#MemberCategory').select2();
                    }
                }
            });
        }

