            });

            $("#NomineesTbody tr").each(function () {
                var row = $(this);
                var MemberNominee = new Object();


                MemberNominee.Name = row.find(".name").val(),
                    MemberNominee.CNIC = row.find(".cNIC").val(),
                    MemberNominee.Relationship = row.find(".relationship").val(),
                    MemberNominee.MobileNo = row.find(".mobileNo").val(),
                    MemberNominee.Address = row.find(".address").val(),

