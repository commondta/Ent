        function SelectSinglePPS(id) {

            var url = "/api/LeadGenration/Get?id=" + id + "";

            debugger;
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        let result_User = response.data;

                        let CnicExp = (result_User.cnicExpirtyDate).split('T')[0] ?? "N/A";

                        $("#LeadId").val(result_User.id);
                        $("#HonorificsName").val(result_User.honorificsName);
                        $("#HonorificsName").trigger('change');
                        $("#MemberName").val(result_User.name);
                        $("#Gender").val(result_User.gender);
                        $("#Gender").trigger('change');
                        $("#Relationship").val(result_User.relationship);
                        $("#Relationship").trigger('change');
                        $("#RelationshipWith").val(result_User.relationshipWith);
                        $("#SourceOfInfo").val(result_User.sourceOfInfo);
                        $("#Cnic").val(result_User.cnic);
                        $("#CnicExpiryDate").val(CnicExp);
                        $("#Mobile").val(result_User.mobileNo);
                        $("#Nationality").val(result_User.nationality);
                        $("#CountryOfResidence").val(result_User.countryOfResidence);
                        $("#CityOfResidence").val(result_User.cityOfResidence);
                        $("#Remarks").val(result_User.remarks);

                        $("#MemberInteresttbody").empty();

                        $.each(response.data.lgInterests, function (i, item) {

                            var rownumber = parseInt($("#rownumberInterest").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumberInterest").val(rownumber);

                            var row = '<tr id="I' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td><select id="PropertyNature' + rownumber + '" class="form-control propertyNature" style="width:100%" /></td>' +
                                '<td><select id="PropertyType' + rownumber + '" class="form-control propertyType" style="width:100%" /></td>' +
