@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";
            $("#PreSale").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {

                    RegistrationNo: {
                        // minlength: 3,
                        required: true
                    }
                },

                errorPlacement: function (error, element) {

                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    // Swal.fire({
                    //    icon: 'error',
                    //    title: 'Error',
                    //    text: 'Enter Valid Data',
                    //})
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }

            });
            GetAllPropertyLists();
            GetAllPaymentPlanLists();
            var id = $("#PreSaleId").val();

            if (id > 0) {
                SelectPresale(id);
                if ($("#PreSaleId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#PreSale :input").prop("disabled", true);

                }
            }
        });

    </script>

    <script>

        $('#IntialDate').on('change', function () {

            $('#PaymentPlantbody tr').each(function () {

                let days = $(this).find('.dueDays').val();

                let dueDate = getDueDateFromDays(days);        
                $(this).find('.dueDate').val(dueDate);
        
            });
        });

        function refreshPage() {
            location.reload();
        }

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });

        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;


                        let propertyNo = result_User.propertyNo ?? "N/A";
                        let possessionStatus = result_User.possessionStatus == '1' ? "Approved" : "Not-Approved";

                        $("#ID").val(result_User.id);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(propertyNo);
                        $("#PropertyNo").val(propertyNo);
                        $("#memberProfileId").val(result_User.memberProfileId);
                       
                        $("#stockCreationId").val(result_User.id);
                        $("#registrationModal").modal("hide");
                        //LoadApprovalHistory(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);


                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        // selection stockcreationId end

        // selection memberProfileId start

        // selection All PaymentPlan Start
        function GetAllPaymentPlanLists() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetFilterPaymentPlan`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#modalpaymentPlantbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + list.id + '</td> ' +
                                    ' <td>' + list.planType + '</td>           ' +
                                    ' <td>' + list.description + '</td>           ' +
                                    ' <td>' + list.phaseName + '</td>       ' +
                                    ' <td>' + list.realStateTypeName + '</td>       ' +
                                    ' <td>' + list.projectName + '</td> ' +
                                    ' <td>' + list.categoryName + '</td> ' +
                                    ' <td>' + list.natureName + '</td> ' +
                                    ' <td>' + list.blockName + '</td> ' +
                                    '<td><a class="btn btn-primary" onclick="SelectPaymentPlan(' + list.id + ')">Select</a></td> </tr>';
                                $("#modalpaymentPlantbody").append(row);
                                sr++;
                            }
                        }

                        $('#paymentPlanlist').dataTable();
                    }
                }
            });
        }

        function SelectPaymentPlan(id) {

            var url = "/api/PaymentPlanSetup/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {

                        var paymentPlan = response.data;

                        $('#PlanCode').val(paymentPlan.description);

                        $("#PaymentPlantbody").empty();

                        $.each(paymentPlan.planInformation, function (i, item) {

                            var rownumber2 = parseInt($("#rownumberP").val());
                            rownumber2 = rownumber2 + 1;
                            $("#rownumberP").val(rownumber2);

                            // ✅ CALCULATE DUE DATE HERE
                            let dueDatee = getDueDateFromDays(item.dueDays);
                           
                            var row = '<tr id="PP' + rownumber2 + '" DetailId="0"> ' +
                                '<td><input disabled class="form-control line" value="' + rownumber2 + '"/></td>' +
                                '<td><select class="form-control paymentType" style="width:100%" id="PaymentType' + rownumber2 + '"></select></td>' +
                                '<td class="hide"><input class="form-control chargeTypeId" value="' + item.chargeTypeId + '" /></td>' +
                                '<td><input class="form-control amount" name="amount" value="' + item.amount + '" /></td>' +
                                // ✅ FIXED
                                '<td><input type="number" name="rebate" onkeyup="calculateNetAmount(event)" class="form-control rebate" value="0" /></td>' +

                                // ✅ FIXED
                                '<td><input type="number" name="netAmount" class="form-control netAmount" value="' + item.amount + '" /></td>' +

                                '<td><input class="form-control dueDays" value="' + item.dueDays + '" /></td>' +

                                '<td><input type="date" class="form-control dueDate" value="' + dueDatee + '"/></td>' +

                                '<td><input class="form-control paymentFor" value="' + item.paymentFor + '" /></td>' +
                                '<td><select class="form-control paymentMethod">' +
                                '<option value="">Select</option>' +
                                '<option value="OnePayment">One-Time Payment</option>' +
                                '<option value="Installments">Installments</option>' +
                                '</select></td>' +

                                '<td><a class="btn btn-sm btn-danger" onclick="DeletePaymentPlanRow(' + rownumber2 + ')">X</a></td>' +
                                '</tr>';

                            $("#PaymentPlantbody").append(row);

                            ChargeGroupType(rownumber2, item.paymentType);
                        });

                        calculatation();
                        $("#paymentPlanModal").modal("hide");
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Payment Plan");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Payment Plan',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function getDueDateFromDays(days) {

            // get value from input
            let initialVal = $('#IntialDate').val();

            // if empty → use today, else use selected date
            let baseDate = initialVal ? new Date(initialVal) : new Date();

            if (!days || days == 0) {
                return formatDate(baseDate);
            }

            let due = new Date(baseDate);
            due.setDate(baseDate.getDate() + parseInt(days));

            return formatDate(due);
        }

        function formatDate(date) {
            let yyyy = date.getFullYear();
            let mm = String(date.getMonth() + 1).padStart(2, '0');
            let dd = String(date.getDate()).padStart(2, '0');

            return `${yyyy}-${mm}-${dd}`; 
        }

        function ChargeGroupType(rowno, chargetype) {

            $.ajax({
                type: 'GET',
                url: `/api/ChargeGroupType/GetAllChargeGroupType`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 0) {

                        $("#PaymentType" + rowno).empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#PaymentType" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.chargeTypeName + '" >' + list.chargeTypeName + '</option> ';

                                $("#PaymentType" + rowno).append(row);

                                sr++;
                            }
                            $('#PaymentType' + rowno).select2();
                        }
                        if (chargetype != null && chargetype != undefined) {
                            $('#PaymentType' + rowno).select2("val", [chargetype])
                        }

                    }
                }
            });
        }

        function ChargeGroupTypes(rowno, chargetype) {

            let type = 'GET';
            let url = "/api/PaymentPlanSetup/GetGlobalChargeDetail/?formId=6";

            $.ajax({
                type: type,
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {

                        $("#paymentType" + rowno).empty();
                        var row = ' <option value="">Select Option</option> ';

                        $("#paymentType" + rowno).append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.chargeTypeName + '" >' + list.chargeTypeName + '</option> ';

                                $("#paymentType" + rowno).append(row);

                                sr++;
                            }
                            $('#paymentType' + rowno).select2();
                        }
                        if (chargetype != null && chargetype != undefined) {
                            $('#paymentType' + rowno).select2("val", [chargetype])
                        }

                    }
                }
            });
        }

        $('body').on('select2:select', '.paymentType', Setcode);

        function Setcode() {

            var data_arr = $(this).parents('tr').find('.paymentType').select2('data');

            var id = data_arr[0].element.attributes['data-id'].value;
            $(this).parents('tr').find('.chargeTypeId').val(id);
        }


        // selection All paymentPlan End


        function AddRowPaymentPlan() {

            var rownumber2 = parseInt($("#rownumberP").val());
            var LineId = rownumber2;
            rownumber2 = rownumber2 + 1;
            $("#rownumberP").val(rownumber2);


            var row = '<tr id="PP' + rownumber2 + '" DetailId="0"> ' +
                '<td> <input readonly class="form-control line" value="' + rownumber2 + '"/></td>' +
                '<td> <select class="form-control paymentType" style="width:100%" id="paymentType' + rownumber2 + '"></select></td>' +
                '<td class="hide"> <input  class="form-control chargeTypeId" /></td>' +
                '<td> <input type="number" onkeyup="calculateTotalCost(event)" name="amount" onkeypress="validateNumberInput(event)"   class="form-control amount" value="0" /></td>' +
                '<td> <input type="number" onkeyup="calculateNetAmount(event)" name="rebate" onkeypress="validateNumberInput(event)" class="form-control  rebate" value="0"/></td>' +
                '<td> <input type="number" onkeypress="validateNumberInput(event)" name="netAmount" class="form-control  netAmount" value="0"/></td>' +
                '<td> <input  class="form-control dueDays" value="0"/></td>' +
                '<td> <input  type="date" class="form-control dueDate"/></td>' +
                '<td> <input  class="form-control paymentFor" value="" /></td>' +
                '<td> <select  onchange="CalculateInstallmentAndOneTimePaymentforpaymentPlan()" class="form-control  paymentMethod " <option value="">Select Option</option><option value="OnePayment">One-Time Payment</option><option value="Installments">Installments</option>/></td>' +

                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeletePaymentPlanRow(\'' + rownumber2 + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                '</tr>';

            $("#PaymentPlantbody").append(row);

            ChargeGroupTypes(rownumber2)
        }

        function DeletePaymentPlanRow(id) {

            $('#PP' + id).remove();
            var rownumber = 1;
            $("#PaymentPlantbody tr").each(function () {
                var row = $(this);
                row.find(".line").val(parseInt(rownumber));
                rownumber++;
            });
            $("#rownumberP").val(rownumber - 1);
            calculatation();
            CalculateInstallmentAndOneTimePaymentforpaymentPlan();
        }

        

        // calculation
        function calculateNetAmount(event) {

            let tbody = document.querySelector('#PaymentPlantbody');
            let totalRebate = 0;
            let netCost = 0;
            let tr = event.target.closest('tr');
            let amount = tr.querySelector('input[name="amount"]').value;
            let result = parseInt(amount) - parseInt(event.target.value);
            tr.querySelector('input[name="netAmount"]').value = result;

            let rebateInputs = tbody.querySelectorAll('input[name="rebate"]');
            rebateInputs.forEach(function (input) {
                totalRebate += parseFloat(input.value) || 0;
            });

            let netAmountInputs = tbody.querySelectorAll('input[name="netAmount"]');
            for (let i = 0; i < netAmountInputs.length; i++) {
                netCost += parseFloat(netAmountInputs[i].value) || 0;
            }

            $("#TotalRebate").val(totalRebate);
            $("#NetCost").val(netCost);
        }

        function calculateTotalCost(event) {

            let tbody = document.querySelector('#PaymentPlantbody');
            let tr = event.target.closest('tr');
            let rebate = tr.querySelector('input[name="rebate"]').value;
            let result = parseInt(event.target.value) - parseInt(rebate);
            tr.querySelector('input[name="netAmount"]').value = result;
            let amountInputs = tbody.querySelectorAll('input[name="amount"]');
            let totalCost = 0;
            let netCost = 0;

            amountInputs.forEach(function (input) {
                totalCost += parseFloat(input.value) || 0;
            });

            let netAmountInputs = tbody.querySelectorAll('input[name="netAmount"]');
            for (let i = 0; i < netAmountInputs.length; i++) {
                netCost += parseFloat(netAmountInputs[i].value) || 0;
            }

            $("#NetCost").val(netCost);
            $("#TotalCost").val(totalCost);
        }

        // on start
        function calculatation() {

            const tbody = document.querySelector('#PaymentPlantbody');
            let totalCost = 0;
            let totalRebate = 0;
            let netCost = 0;

            tbody.querySelectorAll('tr').forEach((tr) => {

                let amountEl = tr.querySelector('input[name="amount"]');
                let rebateEl = tr.querySelector('input[name="rebate"]');
                let netEl = tr.querySelector('input[name="netAmount"]');

                let amount = amountEl ? parseFloat(amountEl.value) || 0 : 0;
                let rebate = rebateEl ? parseFloat(rebateEl.value) || 0 : 0;
                let netAmount = netEl ? parseFloat(netEl.value) || 0 : 0;

                totalCost += amount;
                totalRebate += rebate;
                netCost += netAmount;
            });

            $("#TotalCost").val(totalCost);
            $("#TotalRebate").val(totalRebate);
            $("#NetCost").val(netCost);

            CalculateInstallmentAndOneTimePaymentforpaymentPlan();
        }

        function CalculateInstallmentAndOneTimePaymentforpaymentPlan() {
            $that = $(this);
            var table = "#PaymentPlantbody tr";
            var otpAmount = 0;
            var instalmentAmount = 0;
            $(table).each(function () {

                row = $(this);
                if (row.find(".paymentMethod").val() == "Installments") {
                    var rowins = parseInt(row.find(".netAmount").val());
                    instalmentAmount = instalmentAmount + rowins;
                }
                else {
                    var rowotp = parseInt(row.find(".netAmount").val());
                    otpAmount = otpAmount + rowotp;
                }

            });

            $("#OneTimePayment").val(otpAmount);
            $("#Installments").val(instalmentAmount);
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            let schedule = {};

            let paymentPlanArray = [];

            let memberProfileId = $('#memberProfileId').val() || null;

            schedule.StockCreationId = parseInt($('#stockCreationId').val());
            schedule.MemberProfileId = memberProfileId ? parseInt(memberProfileId) : null;
            schedule.Remarks = $('#remarks').val() || "";
            schedule.PostingDate = $('#PostingDate').val() || "";
            schedule.ModifiedBy = $("#userid").val();
            schedule.CreatedBy = $("#userid").val();
            schedule.LastModifiedUserName = $("#User_Name").val();

            $('#PaymentPlantbody tr').each(function () {

                let row = $(this);

                let paymentPlan = {
                    PaymentType: row.find('.paymentType').val() || "",
                    ChargeTypeId: row.find('.chargeTypeId').val() || "",
                    Amount: parseFloat(row.find('.amount').val()) || 0,
                    Rebate: parseFloat(row.find('.rebate').val()) || 0,
                    NetAmount: parseFloat(row.find('.netAmount').val()) || 0,
                    Days: parseInt(row.find('.dueDays').val()) || 0,
                    DueDate: row.find('.dueDate').val() || "",
                    PaymentFor: row.find('.paymentFor').val() || "",
                    PaymentMethod: row.find('.paymentMethod').val() || ""
                };

                paymentPlanArray.push(paymentPlan);
            });

            schedule.PaymentPlan = paymentPlanArray;

            if (paymentPlanArray.length === 0) {
                Swal.fire("Error", "Add at least one row", "error");
                return;
            }

            $('#Submitp').prop('disabled', true);
            $('#loader').fadeIn();

            $.ajax({
                type: 'POST',
                url: "/api/SapIntegration/PostScheduleInSap",
                contentType: 'application/json',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: JSON.stringify(schedule),
                success: function (response) {

                    $('#loader').fadeOut();
                    $('#Submitp').prop('disabled', false);

                    if (response.code === 100) {
                        Swal.fire("Success", response.message, "success");
                    } else {
                        Swal.fire("Error", response.message, "error");
                    }
                },
                error: function () {
                    $('#loader').fadeOut();
                    $('#Submitp').prop('disabled', false);
                    Swal.fire("Error", "Server error", "error");
                }
            });
        }
    </script>
}
