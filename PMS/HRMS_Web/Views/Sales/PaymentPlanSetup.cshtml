@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";


            $("#PaymentPlanSetup").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    PlanType: {
                        //minlength: 3,
                        required: true
                    },
                    PlanDesc: {
                        // minlength: 3,
                        required: true
                    },
                    Phase: {
                        //minlength: 3,
                        required: false
                    },
                    RealStateType: {
                        //minlength: 3,
                        required: false
                    },
                    Project: {
                        //minlength: 3,
                        required: false
                    },
                    Category: {
                        //minlength: 3,
                        required: false
                    },
                    Block: {
                        //minlength: 3,
                        required: false
                    },
                    Nature: {
                        //minlength: 3,
                        required: false
                    },
                    Type: {
                        //minlength: 3,
                        required: false
                    },
                    NUmberOfInstallment: {
                        //minlength: 3,
                        required: true
                    },

                    InstallmentDays: {
                        //minlength: 3,
                        required: true
                    },

                    SurChargePerDay: {
                        //minlength: 3,
                        required: true
                    },

                    LandCost: {
                        //minlength: 3,
                        required: true
                    },
                    GrancePeriodFine: {
                        //minlength: 3,
                        required: true
                    },


                },

                errorPlacement: function (error, element) {
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    SubmitRequest();
                }

            });
            GetAllPaymentPlanTypes();
            GetAllPhases();
            GetAllBlocks();
            GetAllTypes();
            GetPreviousRecords();
        });

    </script>

    <script>
        function refreshPage() {
            location.reload();
        }

        function GetPreviousRecords() {
            $.ajax({
                type: 'GET',
                url: `/api/PaymentPlanSetup/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },

                contentType: 'application/json',
                success: function (response) {
                    if (response.code == 100) {
                        debugger;
                        $("#PPStbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td>' + list.id + '</td> ' +
                                    ' <td>' + list.planType + '</td>           ' +
                                    ' <td>' + list.description + '</td>           ' +

                                    '<td><a class="fa fa-edit fa-2x" onclick="SelectSinglePPS(' + list.id + ')"></a>' +
                                    '<a class="fa fa-trash-o fa-2x text-danger" onclick="DeleteSinglePPS(' + list.id + ')"></a></td> </tr>';
                                //</tr>';
                                $("#PPStbody").append(row);


                                sr++;

                            }
                        }

                        $('#PPSTable').dataTable();
                    }
                }
            });
        }

        function SelectSinglePPS(id) {
            var url = "/api/PaymentPlanSetup/Get?id=" + id + "";
            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {
                        var result_User = response.data;
                        $("#Id").val(result_User.id);
                        $("#PlanType").val(result_User.planType);
                        $("#PlanType").trigger('change');
                        $("#PlanDesc").val(result_User.description);
                        $("#Phase").val(result_User.phaseId);
                        $("#Phase").trigger('change');
                        GetAllRealEstate(result_User.phaseId, result_User.realEsateId);
                        $("#Block").val(result_User.blockId);
                        $("#Block").trigger('change');
                        $("#Project").val(result_User.projectId);
                        $("#Project").trigger('change');
                        $("#Type").val(result_User.typeId);
                        $("#Type").trigger('change');
                        $("#Category").val(result_User.categoryId);
                        $("#Category").trigger('change');
                        $("#Nature").val(result_User.natureId);
                        $("#Nature").trigger('change');
                        $("#LandCost").val(result_User.landCost);
                        $("#NUmberOfInstallment").val(result_User.nUmberOfInstallment);

                        $("#InstallmentDays").val(result_User.installmentDays);
                        $("#SurChargePerDay").val(result_User.surChargePerDay);
                        $("#GrancePeriodFine").val(result_User.grancePeriodFine);
                        $("#Total").val(result_User.total);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);

                        $("#PlanInformationtbody").empty();

                        $.each(result_User.planInformation, function (i, item) {
                            var rownumber = parseInt($("#rownumber").val());
                            var LineId = rownumber;
                            rownumber = rownumber + 1;
                            $("#rownumber").val(rownumber);
                            var row = '<tr id="' + rownumber + '" DetailId="0"> ' +
                                '<td> <input disabled class="form-control line" value="' + rownumber + '"/></td>' +
                                '<td> <select class="form-control PaymentType" id="PaymentType' + rownumber + '"></select></td>' +
                                '<td class="hide"> <input disabled  class="form-control chargeTypeId" value="' + item.chargeTypeId + '" /></td>' +
                                '<td class="hide"> <input disabled  class="form-control Percentage" value="' + item.percentage + '" /></td>' +
                                '<td> <input  class="form-control Amount" style="text-align: right;" value="' + formatPKR(item.amount) + '" /></td>' +
                                '<td> <input  class="form-control DueDays" value="' + item.dueDays + '"/></td>' +
                                '<td> <input  class="form-control PaymentFor" value="' + item.paymentFor + '" /></td>' +
                                '<td style="padding-top:10px"><a class="btn btn-sm btn-danger" onclick="return DeleteItemRow(\'' + rownumber + '\')"><span class="append-icon fa fa-trash-o"></span></a> </td>' +
                                '</tr>';
                            $("#PlanInformationtbody").append(row);

                            ChargeGroupType(rownumber, item.paymentType)

                        });


                        $("#PPSModal").modal("hide");

                    }

                    else {


                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", response.message);


                        //window.alert(response.message);
                    }
                }
            });
        }

        function GetAllPhases() {
            $.ajax({
                type: 'GET',
                url: `/api/Phase/GetAllPhases`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Phase").empty();
                        var row = ' <option value="">Select Phase</option> ';

                        $("#Phase").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + '</option> ';
                                $("#Phase").append(row);
                                sr++;
                            }
                        }
                        $('#Phase').select2();
                    }
                }
            });
        }
        $('#Phase').on('select2:selecting', function (e) {


            debugger;
            var value = e.params.args.data.id;
            GetAllRealEstate(value);
        });
        $('#RealStateType').on('select2:selecting', function (e) {
            var value = e.params.args.data.id;
            GetAllCategories(value);
            GetAllNatures(value);
            GetAllProjects(value);
            // GetAllSizes(value);

        });

