        function SubmitRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

            if ($("#LandCost").val() == $("#Total").val()) {
                var methodType = 'POST';
                var url = "/api/PaymentPlanSetup/AddNewPaymentPlanSetup";
                var PaymemtPlan = new Object();
                var PaymemtPlanDetailArr = new Array();

                //set values
                let phaseId = $("#Phase").val() == "" ? null : $("#Phase").val();
                let RealStateTypeId = $("#RealStateType").val() == "" ? null : $("#RealStateType").val();
                let ProjectId = $("#Project").val() == "" ? null : $("#Project").val();
                let BlockId = $("#Block").val() == "" ? null : $("#Block").val();
                let NatureId = $("#Nature").val() == "" ? null : $("#Nature").val();
                let CategoryId = $("#Category").val() == "" ? null : $("#Category").val();
                let TypeId = $("#Type").val() == "" ? null : $("#Type").val();

                if ($("#Id").val()) {
                    PaymemtPlan.Id = parseInt($("#Id").val());
                    methodType = 'POST';
                    url = "/api/PaymentPlanSetup/UpdatePaymentPlanSetup"
                }

                PaymemtPlan.PlanType = $("#PlanType").val();
                PaymemtPlan.Description = $("#PlanDesc").val();
                PaymemtPlan.PhaseId = phaseId;
                PaymemtPlan.RealEsateId = RealStateTypeId;
                PaymemtPlan.ProjectId = ProjectId;
                PaymemtPlan.BlockId = BlockId;
                PaymemtPlan.NatureId = NatureId;
                PaymemtPlan.CategoryId = CategoryId;
                PaymemtPlan.TypeId = TypeId;
                PaymemtPlan.LandCost = $("#LandCost").val();
                PaymemtPlan.NUmberOfInstallment = $("#NUmberOfInstallment").val();
                PaymemtPlan.InstallmentDays = $("#InstallmentDays").val();
                PaymemtPlan.SurChargePerDay = $("#SurChargePerDay").val();
                PaymemtPlan.GrancePeriodFine = $("#GrancePeriodFine").val();
                PaymemtPlan.Total = $("#Total").val();
                PaymemtPlan.CreatedBy = $("#User_Id").val();
                PaymemtPlan.ModifiedBy = $("#User_Id").val();
                PaymemtPlan.LastModifiedUserName = $("#User_Name").val();

                $("#PlanInformationtbody tr").each(function () {
                    var row = $(this);
                    var PaymemtPlanDetail = new Object();

                    PaymemtPlanDetail.PaymentType = $(row).find(".PaymentType").val(),
                        PaymemtPlanDetail.ChargeTypeId = $(row).find(".chargeTypeId").val(),
                        PaymemtPlanDetail.Percentage = $(row).find(".Percentage").val(),
                        // PaymemtPlanDetail.Amount = $(row).find(".Amount").val(),
                        PaymemtPlanDetail.Amount = parseFloat(row.find('.Amount').val().replace(/,/g, ''));
                    PaymemtPlanDetail.DueDays = $(row).find(".DueDays").val(),
                        PaymemtPlanDetail.PaymentFor = $(row).find(".PaymentFor").val(),

                        PaymemtPlanDetailArr.push(PaymemtPlanDetail);
                });

                PaymemtPlan.PlanInformation = PaymemtPlanDetailArr;
                var ModelData = JSON.stringify(PaymemtPlan);

                $('#sbt').prop('disabled', true); //disble
                $('#loader').fadeIn();
                $.ajax({
                    type: methodType,
                    url: url,
                    dataType: "json",
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    async: false,
                    data: ModelData,
                    contentType: 'application/json',
                    success: function (response) {

                        $('#loader').fadeOut();
                        if (response.code == 100) {

                            //Swal.fire('Saved', response.message, 'success')
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // location.reload(true);
                                }
                                else if (result.isDenied) {
                                    Swal.fire('Changes are not saved', '', 'info')
                                }
                            })
                        }

                        else {
                            //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Something went wrong");
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong',
                                customClass: 'swal-wide',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            // window.alert(response.message);
                        }
                    }
                });
            }
            else {
                //notification("bottomleft", "warning", "fa fa-exclamation-circle vd_red", "Warning", "Land Cost and Payment Plan should be equal");
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: 'Land Cost and Payment Plan should be equal',
                    customClass: 'swal-wide',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            }
        }

