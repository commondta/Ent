        // calculation
        function calculateNetAmount(event) {
           
            let tbody = document.querySelector('#PaymentPlantbody');
            let totalRebate = 0;
            let netCost = 0;
            let tr = event.target.closest('tr');
            let amount = tr.querySelector('input[name="amount"]').value;
            let result = parseInt(amount) - parseInt(event.target.value);
            tr.querySelector('input[name="netAmount"]').value = result;

            let rebateInputs = tbody.querySelectorAll('input[name="rebate"]');
            rebateInputs.forEach(function (input) {
                totalRebate += parseFloat(input.value) || 0;
            });

            let netAmountInputs = tbody.querySelectorAll('input[name="netAmount"]');
            for (let i = 0; i < netAmountInputs.length; i++) {
                netCost += parseFloat(netAmountInputs[i].value) || 0;
            }

            $("#TotalRebate").val(totalRebate);
            $("#NetCost").val(netCost);
        }

        function calculateTotalCost(event) {
        
            let tbody = document.querySelector('#PaymentPlantbody');
            let tr = event.target.closest('tr');
            let rebate = tr.querySelector('input[name="rebate"]').value;
            let result = parseInt(event.target.value) - parseInt(rebate);
            tr.querySelector('input[name="netAmount"]').value = result;
            let amountInputs = tbody.querySelectorAll('input[name="amount"]');
            let totalCost = 0;
            let netCost = 0;

            amountInputs.forEach(function (input) {
                totalCost += parseFloat(input.value) || 0;
            });

            let netAmountInputs = tbody.querySelectorAll('input[name="netAmount"]');
            for (let i = 0; i < netAmountInputs.length; i++) {
                netCost += parseFloat(netAmountInputs[i].value) || 0;
            }

            $("#NetCost").val(netCost);
            $("#TotalCost").val(totalCost);
        }

        // on start
        function calculatation() {
          
            const tbody = document.querySelector('#PaymentPlantbody');
            let totalCost = 0;
            let totalRebate = 0;
            let netCost = 0;

            tbody.querySelectorAll('tr').forEach((tr) => {

                let amount = parseFloat(tr.querySelector('input[name="amount"]').value);
                let rebate = parseFloat(tr.querySelector('input[name="rebate"]').value);
                let netAmount = parseFloat(tr.querySelector('input[name="netAmount"]').value);
                totalCost = totalCost + amount;
                totalRebate = totalRebate + rebate;
                netCost = netCost + netAmount;
            });

            $("#TotalCost").val(totalCost);
            $("#TotalRebate").val(totalRebate);
            $("#NetCost").val(netCost);

            CalculateInstallmentAndOneTimePaymentforpaymentPlan();
        }

        function CalculateInstallmentAndOneTimePaymentforpaymentPlan() {
            $that = $(this);
            var table = "#PaymentPlantbody tr";
            var otpAmount = 0;
            var instalmentAmount = 0;
            $(table).each(function () {

                row = $(this);
                if (row.find(".paymentMethod").val() == "Installments") {
                    var rowins = parseInt(row.find(".netAmount").val());
                    instalmentAmount = instalmentAmount + rowins;
                }
                else {
                    var rowotp = parseInt(row.find(".netAmount").val());
                    otpAmount = otpAmount + rowotp;
                }

            });

            $("#OneTimePayment").val(otpAmount);
            $("#Installments").val(instalmentAmount);
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }


        function Submit() {

          
            var methodType = 'POST';
            var url = "/api/PreSale/AddNewPreSale";

            var presale = new Object();

            var termsConditionArray = new Array();
            var paymentPlanArray = new Array();

            // set values
            var memberProfileId = $('#memberProfileId').val() == "" ? null : $('#memberProfileId').val();
            var dealerId = $('#dealerId').val() == "" ? null : $('#dealerId').val();


            //presale
            if ($("#Id").val()) {
             
                presale.id = parseInt($("#Id").val());
                methodType = 'PUT';
                url = "/api/PreSale/UpdatePreSale"
            }
            //presale

            presale.StockCreationId = $('#stockCreationId').val();
            presale.MemberProfileId = memberProfileId;
            presale.DealerId = dealerId;
            presale.Remarks = $('#remarks').val();
            presale.Status = $('#Status').val();
            presale.MemberName = $('#PrincipalMember').val();
            presale.Cnic = $('#CNIC').val();
            presale.Address = $('#Address').val();
            presale.Email = $('#Email').val();
            presale.MobileNo = $('#MobileNo').val();
            presale.ByCareOf = $('#ReservedBy').val();
            presale.ReferedBy = $('#ReservedByPhoneNo').val();
            presale.DealerCode = $('#DealerCode').val();
            presale.DealerName = $('#DealerName').val();
            presale.SaleBy = $('#SaleBy').val();
            presale.TranscationType = $('#TransactionType').val();
            presale.OneTimePayment = $('#OneTimePayment').val();
            presale.Installments = $('#Installments').val();
            presale.PlanCode = $('#PlanCode').val();
            presale.TotalCost = $('#TotalCost').val();
            presale.TotalRebate = $('#TotalRebate').val();
            presale.NetCost = $('#NetCost').val();
            presale.ModifiedBy = $("#userid").val();
            presale.CreatedBy = $("#userid").val();
            presale.LastModifiedUserName = $("#User_Name").val();

            $('#TermsConditiontbody tr').each(function () {

                var row = $(this);
                var termcondition = new Object();

                termcondition.TranscationType = row.find('.transcationType').val();

                termsConditionArray.push(termcondition);
            });

            $('#PaymentPlantbody tr').each(function () {
                
                var row = $(this);
                var paymentPlan = new Object();

                paymentPlan.PaymentType = row.find('.paymentType').val();
                paymentPlan.ChargeTypeId = row.find('.chargeTypeId').val();
                paymentPlan.Amount = row.find('.amount').val();
                paymentPlan.Rebate = row.find('.rebate').val();
                paymentPlan.NetAmount = row.find('.netAmount').val();
                paymentPlan.Days = row.find('.dueDays').val();
                paymentPlan.PaymentFor = row.find('.paymentFor').val();
                paymentPlan.PaymentMethod = row.find('.paymentMethod').val();

                paymentPlanArray.push(paymentPlan);
            });

            presale.TermsConditions = termsConditionArray;
            presale.PaymentPlan = paymentPlanArray;

            var model = JSON.stringify(presale);
            

            $('#Submitp').prop('disabled', true); //disble
            $('#loader').fadeIn();
            $.ajax({

                type: methodType,
                url: url,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: model,
                success: function (response) {
                   
                    $('#loader').fadeOut();
                    if (response.code === 100) {
                        //Swal.fire('Saved', response.message, 'success')
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                        Swal.fire({
                            icon: 'warning',
                            title: 'warning',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        // window.alert(response.message);
                    }
                }
            });
        }

        var checkCNIC = function (textBox) {

            var regexp = new RegExp('^[0-9+]{5}[0-9+]{7}[0-9]{1}$');
            var check = textBox.value;
            if (!regexp.test(check)) {
                $(textBox).css('border-color', 'red');
                return false;
            }

            else {
                $(textBox).css('border-color', '#D5D5D5');
                $(textBox).value = check;
                return true;
            }
        }


