@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            "use strict";


            $("#PreSale").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    Status: {
                        //minlength: 3,
                        required: true
                    },

                    RegistrationNo: {
                        // minlength: 3,
                        required: true
                    },
                    PropertyNo: {
                        //minlength: 3,
                        required: true
                    },
                    //leadNo: {
                    //    //minlength: 3,
                    //    required: true
                    //},
                    PrincipalMember: {
                        //minlength: 3,
                        required: true
                    },
                    TransactionType: {
                        //minlength: 3,
                        required: true
                    },
                    SaleBy: {
                        // minlength: 3,
                        required: true
                    },
                    PrincipalMember: {
                        // minlength: 3,
                        required: true
                    },
                    //MobileNo: {
                    //    // minlength: 3,
                    //    required: false,
                    //    number: true,
                    //    minlength: 10,
                    //    maxlength: 10
                    //},
                    ReservedByPhoneNo: {
                        // minlength: 3,
                        required: false,
                        number: true,
                    },
                    Email: {
                        // minlength: 3,
                        required: false,
                        email: true
                    },
                },

                errorPlacement: function (error, element) {

                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) { //display error alert on form submit
                    //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", "Enter Valid Form Data");
                    // Swal.fire({
                    //    icon: 'error',
                    //    title: 'Error',
                    //    text: 'Enter Valid Data',
                    //})
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Enter Valid Form Data',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    //   label
                    //       .addClass('valid').addClass('help-inline fa fa-check vd_green mgl-10') // mark the current input as valid and display OK icon
                    //       .closest('.control-group').removeClass('error').addClass('success'); // set success class to the control group
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }

            });
            GetAllPropertyLists();
            GetAllMemberProfiles();
            GetAllDealerProfiles();
            GetAllLeadGenration();
            GetAllPreSaleLists();
            GetAllPaymentPlanLists();
            var id = $("#PreSaleId").val();
         
            if (id > 0) {
                SelectPresale(id);
                if ($("#PreSaleId").val() != null) {
                    $("#openModal").prop("disabled", true);
                    $("#PreSale :input").prop("disabled", true);

                }
            }
        });

    </script>

    <script>

        function refreshPage() {
            location.reload();
        }
        // selection LeadNo start
        function GetAllLeadGenration() {

            $.ajax({
                type: 'GET',
                url: `/api/LeadGenration/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json',
                success: function (response) {

                    if (response.code == 100) {
                      
                        $("#leadtbody").empty();
                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <tr> ' +
                                    ' <td class="Id">' + list.id + '</td> ' +
                                    ' <td class="contactPerson">' + list.name + '</td>' +
                                    ' <td class="cnic">' + list.cnic + '</td>' +
                                    ' <td class="contactPerson">' + list.contactPerson + '</td>' +
                                    ' <td class="contactPersonNumber">' + list.contactPersonNumber + '</td>' +

                                    '<td><a class="btn btn-primary" onclick="SelectLead(' + list.id + ')">Select</a></td> </tr>';
                                $("#leadtbody").append(row);
                                sr++;
                            }
                        }

                        $('#leadlist').dataTable();
                    }
                }
            });
        }

        function SelectLead(id) {

            var url = "/api/LeadGenration/Get?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
           
                    if (response.code === 100) {
                        var result_User = response.data;

                        $("#ID").val(result_User.id);
                        $('#PrincipalMember').val(result_User.name);
                        $('#CNIC').val(result_User.cnic);
                        $('#Address').val(result_User.countryOfResidence + " " + result_User.cityOfResidence);
                        $('#Email').val(result_User.emailId);
                        $('#MobileNo').val(result_User.mobileNo);
                        $('#ReservedBy').val(result_User.contactPerson);
                        $('#ReservedByPhoneNo').val(result_User.contactPersonNumber);
                        $("#leadModal").modal("hide");

                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Lead");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Lead',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }
        // selection LeadNo end

        // selection memberProfileId start

        // selection stockcreationId start


        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllPreSale",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "membershipNo", name: "MembershipNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });

        }

        function SelectRegistration(id) {

            var url = "/api/Filter/GetFilterPropertyResult?stock=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        var result_User = response.data;
                        

                        let propertyNo = result_User.propertyNo ?? "N/A";
                        let possessionStatus = result_User.possessionStatus == '1' ? "Approved" : "Not-Approved";

                        $("#ID").val(result_User.id);
                        $("#RegistrationNo").val(result_User.registrationNo);
                        $("#PropertyNo").val(propertyNo);
                        $("#Phase").val(result_User.phaseName);
                        $("#Block").val(result_User.blockName);
                        $("#Project").val(result_User.projectName);
                        $("#Type").val(result_User.typeName);
                        $("#Category").val(result_User.categoryName);
                        $("#Floor").val(result_User.floor);
                        $("#Nature").val(result_User.natureName);
                        $("#REType").val(result_User.realStateTypeName);
                        $("#Location").val(result_User.location);
                        $("#Road").val(result_User.street);
                        $("#ActualSizeValue").val(result_User.actualSizeUnit);
                        $("#StandardSize").val(result_User.standardSize);
                        $("#StandardSizeValue").val(result_User.standardSizeUnit);
                        $("#ConstructionStatus").val(result_User.constracutionStatus);
                        $("#possessionStatus").val(possessionStatus);
                        $('#Finishing').val(result_User.finishing);
                        $('#Status').val(result_User.status);
                        $('#StandardSize').val(result_User.actualSize);
                        $('#StandardSizeValue').val(result_User.actualSizeUnit);

                        $("#stockCreationId").val(result_User.id);
                        $("#registrationModal").modal("hide");
                        LoadApprovalHistory(result_User.id);
                        PropertyDetail(result_User.id);
                        ShowAlert(result_User.id);


                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
