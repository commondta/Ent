    <script>

        $(document).ready(function () {
            localStorage.setItem("token", '@Context.Session.GetString("token")');
            setTimeout(function () {
                $('#loader').fadeOut();
            }, 1000);
            GetNotificationCount();
            GetPendingApprovalCount();
        });

        /* Recent / Favourites — header icons (top-left, after the menu icon) AND
           the My Home cards read the same two localStorage stores. Star clicks
           here refresh the My Home cards live when that page is open. */
        (function () {
            var RECENT_KEY = 'pms_recent_forms';
            var FAV_KEY = 'pms_fav_forms';

            function load(key) {
                try { return JSON.parse(localStorage.getItem(key)) || []; } catch (e) { return []; }
            }
            function save(key, list) {
                try { localStorage.setItem(key, JSON.stringify(list)); } catch (e) { }
            }
            function esc(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, function (ch) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
                });
            }

            var $recentPop = $('<div class="hdr-pop" id="hdrRecentPop"><div class="hdr-pop-title">Recent forms</div><ul></ul><div class="hq-empty">Nothing yet — forms you open will appear here.</div></div>');
            var $favPop = $('<div class="hdr-pop" id="hdrFavPop"><div class="hdr-pop-title">Favourite forms</div><ul></ul><div class="hq-empty">No favourites yet — star a form in the Recent list.</div></div>');
            $('body').append($recentPop, $favPop);

            function itemHtml(entry, isFav) {
                var starLabel = (isFav ? 'Remove from favourites' : 'Add to favourites') + ': ' + entry.t;
                return '<li>' +
                    '<a class="hq-link" href="' + esc(entry.u) + '">' + esc(entry.t) + '</a>' +
                    '<button type="button" class="hq-star ' + (isFav ? 'on' : '') + '" title="' + esc(starLabel) + '" aria-label="' + esc(starLabel) + '" aria-pressed="' + (isFav ? 'true' : 'false') + '" data-u="' + esc(entry.u) + '" data-t="' + esc(entry.t) + '">&#9733;</button>' +
                    '</li>';
            }

            function renderPops() {
                var favs = load(FAV_KEY);
                var favMap = {};
                favs.forEach(function (f) { favMap[f.u] = true; });
                var recents = load(RECENT_KEY).slice(0, 10);

                $recentPop.find('ul').html(recents.map(function (r) { return itemHtml(r, !!favMap[r.u]); }).join(''));
                $recentPop.find('.hq-empty').toggle(recents.length === 0);
                $favPop.find('ul').html(favs.map(function (f) { return itemHtml(f, true); }).join(''));
                $favPop.find('.hq-empty').toggle(favs.length === 0);
            }

            function closePops() {
                $('.hdr-pop').removeClass('show');
                $('.hdr-quick-btn, .hdr-more-btn').removeClass('open').filter('[aria-expanded]').attr('aria-expanded', 'false');
            }
            window.pmsCloseHeaderPops = closePops;

            // $anchor: the visible control the popover hangs from — the button
            // itself, or the ⋮ More button when the original is folded away.
            // Right-aligns under the anchor when it would otherwise run off-screen.
            function togglePop($btn, $pop, $anchor) {
                var wasOpen = $pop.hasClass('show');
                closePops();
                if (wasOpen) return;
                renderPops();
                var $a = ($anchor && $anchor.length) ? $anchor : $btn;
                var r = $a[0].getBoundingClientRect();
                var left = Math.max(6, r.left - 10);
                var w = Math.min(340, Math.max(260, $pop.outerWidth() || 260));
                if (left + w > window.innerWidth - 6) left = Math.max(6, window.innerWidth - 6 - w);
                $pop.css({ top: (r.bottom + 6) + 'px', left: left + 'px' }).addClass('show');
                $a.addClass('open').filter('[aria-expanded]').attr('aria-expanded', 'true');
            }

            $(document).on('click', '#hdrRecentBtn', function (e) { e.stopPropagation(); try { togglePop($(this), $recentPop); } catch (ex) { } });
            $(document).on('click', '#hdrFavBtn', function (e) { e.stopPropagation(); try { togglePop($(this), $favPop); } catch (ex) { } });

            /* ⋮ More menu (small screens): opens like the other header
               popovers; its items run the same handlers as the header controls. */
            var $morePop = $('#hdrMorePop');
            $(document).on('click', '#hdrMoreBtn', function (e) {
                e.stopPropagation();
                try {
                    var wasOpen = $morePop.hasClass('show');
                    closePops();
                    if (wasOpen) return;
                    var r = this.getBoundingClientRect();
                    var w = 220;
                    var left = Math.min(r.left - 10, window.innerWidth - 6 - w);
                    $morePop.css({ top: (r.bottom + 6) + 'px', left: Math.max(6, left) + 'px' }).addClass('show');
                    $(this).addClass('open').attr('aria-expanded', 'true');
                } catch (ex) { }
            });
            $(document).on('click', '#hdrMorePop .hm-item[data-act]', function (e) {
                e.stopPropagation();
                var act = $(this).data('act');
                var $more = $('#hdrMoreBtn');
                try {
                    if (act === 'recent') { togglePop($('#hdrRecentBtn'), $recentPop, $more); return; }
                    if (act === 'favs') { togglePop($('#hdrFavBtn'), $favPop, $more); return; }
                    closePops();
                    if (act === 'alert') { $('#hdrAlertBtn').trigger('click'); return; }
                    if (act === 'notifications' && typeof window.pmsOpenNotifications === 'function') { window.pmsOpenNotifications(); }
                } catch (ex) { }
            });

            // Shared favourite API — used by the header popovers, the form title
            // strip star, and the My Home cards.
            window.pmsFavHas = function (url) {
                return load(FAV_KEY).some(function (f) { return f.u === url; });
            };
            window.pmsFavToggle = function (url, title) {
                if (!url) return false;
                var favs = load(FAV_KEY);
                var isOn;
                if (favs.some(function (f) { return f.u === url; })) {
                    favs = favs.filter(function (f) { return f.u !== url; });
                    isOn = false;
                } else {
                    favs.unshift({ u: url, t: title || url });
                    isOn = true;
                }
                save(FAV_KEY, favs);
                renderPops();
                if (typeof window.mhRenderLists === 'function') { try { window.mhRenderLists(); } catch (e2) { } }
                return isOn;
            };

            $(document).on('click', '.hdr-pop .hq-star', function (e) {
                e.stopPropagation();
                window.pmsFavToggle($(this).data('u'), $(this).data('t'));
            });

            // Form title strip: the Add-to-Favourite star for the open form.
            var $fts = $('#ftsFavBtn');
            if ($fts.length) {
                if (window.pmsFavHas($fts.data('u'))) {
                    $fts.addClass('on').attr({ 'title': 'Remove from favourites', 'aria-pressed': 'true' });
                }
                $fts.on('click', function () {
                    var on = window.pmsFavToggle($(this).data('u'), $(this).data('t'));
                    $(this).toggleClass('on', on).attr({
                        'title': on ? 'Remove from favourites' : 'Add to favourites',
                        'aria-pressed': on ? 'true' : 'false'
                    });
                });
            }

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.hdr-pop, .hdr-quick-btn, .hdr-more-btn').length) closePops();
            });
            $(window).on('resize scroll', closePops);
        })();

        /* Merge the form title strip with the legacy form header: move the strip
           INSIDE the form's content wrapper (so it resizes with the navigation
           pane and shares the form's edges), then absorb the legacy banner's
           icon and action buttons. The legacy breadcrumb row and banner are
           hidden by the fts-active class the strip set at render time. */
        (function () {
            try {
                var $fts = $('.fts').first();
                if (!$fts.length) return;
                var $content = $('.vd_content-wrapper .vd_content').first();
                if ($content.length) { $fts.prependTo($content); }
                var $ts = $('.vd_title-section').first();
                if ($ts.length) {
                    var $svg = $ts.find('.tp-head-icon svg').first();
                    if ($svg.length) { $('#ftsIcon').append($svg).addClass('has-icon'); }
                    $ts.find('button, a.btn').appendTo('#ftsActions');
                }
            } catch (e) { }
        })();

        /* Folder open-state sync: the theme leaves the "open" class on anchors
           whose submenu has actually closed (e.g. after moving to another
           folder), so the tint lingered. After each menu click, settle the
           classes to match what is really visible. */
        (function () {
            function syncOpenState() {
                $('.vd_menu a[data-action^="click-trigger"]').each(function () {
                    var visible = $(this).siblings('.child-menu').is(':visible');
                    $(this).toggleClass('open', visible).attr('aria-expanded', visible ? 'true' : 'false');
                });
            }
            $(document).on('click', '.vd_menu a[data-action^="click-trigger"]', function () {
                setTimeout(syncOpenState, 450);
            });
            setTimeout(syncOpenState, 600);
        })();

        /* Icons-only bar ↔ full bar: collapse every open folder on the way in
           AND out, so the active trail's pre-expanded submenus don't hang as
           stale fly-out panels beside the short bar (they carry inline
           display:block from the server render). */
        $(document).on('click', '[data-action="nav-left-medium"], [data-action="nav-left-small"]', function () {
            $('.vd_navbar-left .vd_menu .child-menu').css('display', 'none');
            $('.vd_navbar-left .vd_menu a[data-action^="click-trigger"]')
                .removeClass('open').attr('aria-expanded', 'false');
        });

        /* In the icons-only bar, opening one module's fly-out closes the
           others — one cascade chain at a time, like a top-nav menu. */
        $(document).on('click', '.nav-left-medium .vd_navbar-left .vd_menu > ul > li > a[data-action^="click-trigger"], .nav-left-small .vd_navbar-left .vd_menu > ul > li > a[data-action^="click-trigger"]', function () {
            var $li = $(this).closest('li');
            $('.vd_navbar-left .vd_menu > ul > li').not($li).find('.child-menu').css('display', 'none');
            $('.vd_navbar-left .vd_menu > ul > li').not($li).find('a[data-action^="click-trigger"]')
                .removeClass('open').attr('aria-expanded', 'false');
        });

        /* Global search — debounced query against api/Workspace/GlobalSearch,
           grouped results, click or Enter to open. */
        (function () {
            var timer = null, lastQ = '';

            function esc(s) { return $('<i>').text(s == null ? '' : s).html(); }

            function hide() { $('#gsResults').removeClass('show'); }

            function render(d) {
                var html = '';
                function group(title, items, map) {
                    if (!items || !items.length) return;
                    html += '<div class="gs-group">' + title + '</div>';
                    items.forEach(function (it) { html += map(it); });
                }
                group('Forms', d.forms, function (f) {
                    return '<a class="gs-item" href="' + esc(f.route) + '"><div class="gs-item-name">' + esc(f.name) + '</div>' +
                        (f.path ? '<div class="gs-item-sub">' + esc(f.path) + '</div>' : '') + '</a>';
                });
                group('Properties', d.properties, function (p) {
                    var href = d.propertyForm.route + (p.profileId ? '?gs=' + p.profileId : '');
                    return '<a class="gs-item" href="' + esc(href) + '"><div class="gs-item-name">' + esc(p.propertyNo || p.registrationNo) + '</div>' +
                        '<div class="gs-item-sub">Reg No: ' + esc(p.registrationNo) + ' &middot; in ' + esc(d.propertyForm.name) + '</div></a>';
                });
                group('Members', d.members, function (m) {
                    return '<a class="gs-item" href="' + esc(d.memberForm.route + '?gs=' + m.id) + '"><div class="gs-item-name">' + esc(m.name) + '</div>' +
                        '<div class="gs-item-sub">CNIC: ' + esc(m.cnic) + ' &middot; in ' + esc(d.memberForm.name) + '</div></a>';
                });
                group('Dealers', d.dealers, function (dl) {
                    return '<a class="gs-item" href="' + esc(d.dealerForm.route + '?gs=' + dl.id) + '"><div class="gs-item-name">' + esc(dl.name) + '</div>' +
                        '<div class="gs-item-sub">CNIC: ' + esc(dl.cnic) + ' &middot; in ' + esc(d.dealerForm.name) + '</div></a>';
                });
                if (!html) html = '<div class="gs-none">No matches for &ldquo;' + esc(lastQ) + '&rdquo;</div>';
                $('#gsResults').html(html).addClass('show');
            }

            function run(q) {
                lastQ = q;
                $.ajax({
                    type: 'GET',
                    url: '/api/Workspace/GlobalSearch?q=' + encodeURIComponent(q),
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    dataType: 'json'
                }).done(function (response) {
                    if (response.code === 100 && response.data && $('#gsInput').val().trim() === q) render(response.data);
                });
            }

            $(document).on('input', '#gsInput', function () {
                var q = $(this).val().trim();
                $('#gsWrap').toggleClass('typing', $(this).val().length > 0);
                clearTimeout(timer);
                if (q.length < 2) { hide(); return; }
                timer = setTimeout(function () { run(q); }, 300);
            });

            $(document).on('keydown', '#gsInput', function (e) {
                if (e.key === 'Escape') { hide(); $(this).blur(); }
                if (e.key === 'Enter') {
                    var $first = $('#gsResults .gs-item').first();
                    if ($first.length) window.location.href = $first.attr('href');
                }
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#gsWrap').length) hide();
            });

            /* Deep-link contract: a search hit arrives as ?gs=<recordId>; each
               deep-linkable form maps to its existing record-select function.
               Adding a form to search deep-linking = one line here (this map
               moves into the registry when the search contract formalises). */
            var gsOpeners = {
                '/home/registrationnoprofile': 'SelectRegistrationNoProfile',
                '/sales/memberprofile': 'SelectMember',
                '/sales/dealerprofile': 'SelectDealerProfile'
            };
            $(function () {
                try {
                    var gs = new URLSearchParams(window.location.search).get('gs');
                    if (!gs) return;
                    var fn = gsOpeners[window.location.pathname.toLowerCase().replace(/\/$/, '')];
                    if (!fn) return;
                    // let the page's own ready handlers (select2, lookups) settle first
                    setTimeout(function () {
                        try { if (typeof window[fn] === 'function') window[fn](parseInt(gs, 10)); } catch (e) { }
                    }, 700);
                } catch (e) { }
            });
        })();

        /* Generate Alert box */
        (function () {
            var usersLoaded = false;

            function loadUsers() {
                if (usersLoaded) return;
                $.ajax({
                    type: 'GET',
                    url: '/api/Workspace/GetActiveUsers',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    dataType: 'json'
                }).done(function (response) {
                    if (response.code !== 100 || !response.data) return;
                    var self = $('#userid').val();
                    var opts = '<option value="">Select user…</option>';
                    response.data.forEach(function (u) {
                        var label = String(u.id) === String(self) ? u.name + ' (me)' : u.name;
                        opts += '<option value="' + u.id + '">' + $('<i>').text(label).html() + '</option>';
                    });
                    $('#gaUser').html(opts);
                    usersLoaded = true;
                });
            }

            function closeGa() { $('#gaOverlay').removeClass('show'); }

            $(document).on('click', '#hdrAlertBtn', function () {
                $('#gaOverlay').addClass('show');
                loadUsers();
            });
            $(document).on('click', '#gaClose', closeGa);
            $(document).on('click', '#gaOverlay', function (e) { if (e.target === this) closeGa(); });
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape' && $('#gaOverlay').hasClass('show')) closeGa();
            });

            $(document).on('click', '#gaSend', function () {
                var receiver = $('#gaUser').val();
                var message = $.trim($('#gaMessage').val());
                if (!receiver) { $('#gaUser').focus(); return; }
                if (!message) { $('#gaMessage').focus(); return; }
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    type: 'POST',
                    url: '/api/Workspace/SendAlert',
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    contentType: 'application/json',
                    data: JSON.stringify({ receiverId: parseInt(receiver, 10), message: message, type: $('#gaType').val() })
                }).done(function (response) {
                    if (response && response.code === 100) {
                        closeGa();
                        $('#gaMessage').val('');
                        $('#gaToast').stop(true, true).fadeIn(150).delay(2500).fadeOut(400);
                    }
                }).always(function () { $btn.prop('disabled', false); });
            });
        })();

        // My Home workspace: record every visited form page into the per-browser
        // recent list (AI file.xlsx UI sheet — RECENT). The form registry will
        // later supply real display names; until then the name is derived from
        // the URL. Never allowed to break a page.
        (function () {
            try {
                var path = window.location.pathname;
                var name = null;
                // Prefer the registry identity set by the form title strip.
                if (window.__pmsForm && window.__pmsForm.u) {
                    path = window.__pmsForm.u;
                    name = window.__pmsForm.t;
                }
                if (!path || path === '/') return;
                var lower = path.toLowerCase();
                if (lower === '/home/index' || lower.indexOf('/login') === 0 || lower.indexOf('/hiddenforms') === 0) return;
                if (!name) {
                    var seg = path.split('/').filter(Boolean);
                    if (!seg.length) return;
                    name = seg[seg.length - 1]
                        .replace(/[-_]/g, ' ')
                        .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
                        .replace(/\s+/g, ' ')
                        .trim();
                    if (!name) return;
                    name = name.charAt(0).toUpperCase() + name.slice(1);
                }
                var key = 'pms_recent_forms';
                var list = [];
                try { list = JSON.parse(localStorage.getItem(key)) || []; } catch (e) { }
                list = list.filter(function (it) { return it.u !== path; });
                list.unshift({ u: path, t: name, ts: Date.now() });
                if (list.length > 10) list = list.slice(0, 10);
                localStorage.setItem(key, JSON.stringify(list));
            } catch (e) { }
        })();

        /* Unread alerts for this user — the existing count endpoint feeds the
           bell badge (hidden by CSS when empty), the ⋮ More menu's item count
           and the dot on the ⋮ button. Large counts compact to 99+. Refreshed
           on load, every minute, when the tab regains focus, and after the
           panel loads (GetAll marks the alerts viewed). */
        function pmsSetUnseen(n) {
            n = parseInt(n, 10) || 0;
            var label = n > 99 ? '99+' : (n > 0 ? String(n) : '');
            $("#unSeenBadge").text(label);
            $("#hdrMoreNotifCount").text(label);
            $("#hdrMoreBtn").toggleClass('has-new', n > 0);
            var $bell = $('#hdrBellLink');
            if ($bell.length) { $bell.attr('title', n > 0 ? 'Notifications (' + label + ' unread)' : 'Notifications'); }
        }

        function GetNotificationCount() {
            var userId = $("#userid").val();
            if (!userId) return;
            $.ajax({
                type: 'GET',
                url: "/api/Notification/GetNotificationCount?userId=" + encodeURIComponent(userId),
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json"
            }).done(function (response) {
                if (response && response.code == 100) pmsSetUnseen(response.data);
            });
        }

        setInterval(function () { try { GetNotificationCount(); } catch (e) { } }, 60000);
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) { try { GetNotificationCount(); } catch (e) { } }
        });

        /* Notifications panel — the bell opens it over the current page instead
           of navigating away (brief 2026-08-21 §4–5). Same source as the
           /Notification/Index page: api/Notification/GetAll, which also marks
           the alerts viewed — so the badge is refreshed once the list loads.
           DataTables gives the panel its search box, page size and pages. */
        (function () {
            var table = null, loading = false;

            function esc(s) { return $('<i>').text(s == null ? '' : s).html(); }

            function typeChip(t) {
                var crit = String(t || '').toLowerCase() === 'critical';
                return '<span class="np-type' + (crit ? ' critical' : '') + '">' + esc(t) + '</span>';
            }

            function render(list) {
                if (table) { try { table.destroy(); } catch (e) { } table = null; }
                var rows = '';
                (list || []).forEach(function (n, i) {
                    var when = n.createdOn ? moment(n.createdOn).format('DD-MM-YYYY, h:mmA') : '';
                    rows += '<tr>' +
                        '<td class="np-hide-sm">' + (i + 1) + '</td>' +
                        '<td>' + typeChip(n.type) + '</td>' +
                        '<td>' + esc(n.senderName) + '</td>' +
                        '<td class="np-hide-sm">' + esc(n.designation) + '</td>' +
                        '<td class="np-when">' + esc(when) + '</td>' +
                        '<td class="np-narr">' + esc(n.narration) + '</td>' +
                        '</tr>';
                });
                $('#npTbody').html(rows);
                var any = !!(list && list.length);
                $('#npCount').text(any ? list.length : '');
                $('#npEmpty').toggle(!any);
                $('#npTable').toggle(any);
                if (any) {
                    table = $('#npTable').DataTable({
                        dom: '<"np-tools"f><"np-scroll"t><"np-foot"<"np-len"l><"np-info"i><"np-pages"p>>',
                        order: [],
                        pageLength: 10,
                        lengthMenu: [5, 10, 25, 50],
                        pagingType: 'simple_numbers',
                        autoWidth: false,
                        language: {
                            search: '',
                            searchPlaceholder: 'Search notifications…',
                            lengthMenu: 'Show _MENU_',
                            info: '_START_–_END_ of _TOTAL_',
                            infoEmpty: 'No notifications',
                            infoFiltered: '(filtered from _MAX_)',
                            zeroRecords: 'No notifications match your search',
                            paginate: { previous: '‹', next: '›' }
                        }
                    });
                }
            }

            function load() {
                if (loading) return;
                loading = true;
                $('#npLoading').show();
                $('#npError').hide();
                $.ajax({
                    type: 'GET',
                    url: '/api/Notification/GetAll?userId=' + encodeURIComponent($('#userid').val()),
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    dataType: 'json'
                }).done(function (r) {
                    if (r && r.code == 100) { render(r.data || []); }
                    else { $('#npError').text('Could not load notifications.').show(); }
                }).fail(function () {
                    $('#npError').text('Could not load notifications.').show();
                }).always(function () {
                    loading = false;
                    $('#npLoading').hide();
                    try { GetNotificationCount(); } catch (e) { }
                });
            }

            function closeNp() {
                $('#npOverlay').removeClass('show');
                $('#hdrBellLink').removeClass('open').attr('aria-expanded', 'false');
            }

            function openNp() {
                if (typeof window.pmsCloseHeaderPops === 'function') window.pmsCloseHeaderPops();
                $('#gaOverlay').removeClass('show');
                $('#npOverlay').addClass('show');
                $('#hdrBellLink').addClass('open').attr('aria-expanded', 'true');
                load();
                setTimeout(function () { $('#npClose').trigger('focus'); }, 30);
            }

            window.pmsOpenNotifications = openNp;

            $(document).on('click', '#hdrBellLink', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if ($('#npOverlay').hasClass('show')) closeNp(); else openNp();
            });
            $(document).on('click', '#npClose', closeNp);
            $(document).on('click', '#npOverlay', function (e) { if (e.target === this) closeNp(); });
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape' && $('#npOverlay').hasClass('show')) closeNp();
            });
        })();

        /* Small-screen search: the field folds into an icon (≤767px, CSS); the
           icon drops the same field and results below the bar — one search. */
        (function () {
            function closeSearch() {
                $('#gsWrap').removeClass('gs-open');
                $('#gsToggle').attr('aria-expanded', 'false');
                $('#gsResults').removeClass('show');
            }
            $(document).on('click', '#gsToggle', function (e) {
                e.stopPropagation();
                var open = !$('#gsWrap').hasClass('gs-open');
                $('#gsWrap').toggleClass('gs-open', open);
                $(this).attr('aria-expanded', open ? 'true' : 'false');
                if (open) {
                    if (typeof window.pmsCloseHeaderPops === 'function') window.pmsCloseHeaderPops();
                    setTimeout(function () { $('#gsInput').trigger('focus'); }, 20);
                }
            });
            $(document).on('click', function (e) {
                if ($('#gsWrap').hasClass('gs-open') && !$(e.target).closest('#gsWrap').length) closeSearch();
            });
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape' && $('#gsWrap').hasClass('gs-open')) closeSearch();
            });
            $(window).on('resize', function () { if (window.innerWidth > 767) closeSearch(); });
        })();

        /* Coordinated responsiveness (brief 2026-08-21 §9–10): below 1200px the
           navigation runs in its icons-only mode so the bar and the header
           shrink together. The theme's own tablet behaviour hid the whole bar
           and re-showed it on any tap in the content — that toggle is retired;
           the hamburger still switches icons-only ↔ full at any width. */
        (function () {
            var NARROW = 1199, lastNarrow = null, autoMedium = false;

            function collapseFolders() {
                $('.vd_navbar-left .vd_menu .child-menu').css('display', 'none');
                $('.vd_navbar-left .vd_menu a[data-action^="click-trigger"]').removeClass('open').attr('aria-expanded', 'false');
            }

            function apply(force) {
                var narrow = window.innerWidth <= NARROW;
                var $b = $('body');
                if (narrow) {
                    $b.removeClass('nav-left-hide');
                    if ((narrow !== lastNarrow || force) && !$b.hasClass('nav-left-medium')) {
                        $b.addClass('nav-left-medium');
                        autoMedium = true;
                        collapseFolders();
                    }
                } else if (narrow !== lastNarrow && autoMedium) {
                    $b.removeClass('nav-left-medium');
                    autoMedium = false;
                    collapseFolders();
                }
                lastNarrow = narrow;
            }

            $(function () {
                $('.vd_container').off('click');
                apply(true);
                setTimeout(function () { apply(true); }, 60);
            });

            var t;
            $(window).on('resize', function () {
                clearTimeout(t);
                t = setTimeout(function () { apply(false); }, 120);
                // the theme's breakpoint handlers re-hide the bar a beat later
                setTimeout(function () { if (window.innerWidth <= NARROW) $('body').removeClass('nav-left-hide'); }, 400);
            });
        })();

        /* Pending approvals waiting on this user — red count over the inbox icon,
           same pattern as the alerts badge (empty badge is hidden by CSS). */
        function GetPendingApprovalCount() {
            var userId = $("#userid").val();
            if (!userId) return;
            $.ajax({
                type: 'GET',
                url: "/api/Approvals/GetPendingApprovalCount?userId=" + userId,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json"
            }).done(function (response) {
                if (response.code == 100) {
                    var count = parseInt(response.data, 10) || 0;
                    var label = count > 99 ? '99+' : (count > 0 ? String(count) : '');
                    $("#approvalBadge").text(label);
                    $("#hdrMoreInboxCount").text(label);
                }
            });
        }

    </script>
    <script src="~/js/erp-platform.js" asp-append-version="true"></script>
</body>
</html>
