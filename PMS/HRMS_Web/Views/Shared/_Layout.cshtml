        window.onload = () => { (u.style.pointerEvents = ""), (u.style.userSelect = ""), (u.style.cursor = "") }
        @* Legacy hamburger handler removed 2026-08-20: it blind-toggled inline
           display on every .menu-text/.menu-badge, desyncing from the actual
           nav mode (chevrons vanished or appeared at random). The
           nav-left-medium CSS rules own that hiding now. *@
        /* One active form at a time: the server marks the current form from the
           URL (class nav-active in _NavigationMenu). This only moves the
           highlight instantly on click, before the new page loads — the old
           active state disappears immediately. Folders never take it. */
        $(document).ready(function () {
            $(document).on('click', '.vd_menu .child-menu a:not(.nav-group)', function () {
                $('.vd_menu a.nav-active').removeClass('nav-active');
                $(this).addClass('nav-active');
            });
        });

