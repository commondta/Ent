                document.body.prepend(a), g.setAttribute("style", "height:50px;color:#fff;filter:brightness(" + settings.filterBrightness + ");animation:.8s swell infinite linear"), g.setAttribute("viewBox", "0 0 100 100"), a.prepend(g),
                c.setAttribute("cx", "50"), c.setAttribute("cy", "50"), c.setAttribute("r", "35"), c.setAttribute("fill", "none"),
