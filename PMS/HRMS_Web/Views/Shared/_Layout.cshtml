    @RenderSection("css", false)
    <style>
        #loader {
            color: #fff
        }
        /*Swl Styling*/
        .text-red {
            color: red;
        }

        .swal2-styled.swal2-confirm {
            border: 0;
            border-radius: 0.25em;
            background: initial;
            background-color: #111111;
            color: #fff;
            font-size: 1em;
            width: 76px;
        }

        .red_error {
            border: 1px solid red;
        }

        .badge {
            display: inline-block;
            padding: 3px 6px;
            font-size: 12px;
            font-weight: 500;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            background-color: #dc3545;
            color: #fff;
            border-radius: 10px;
        }

        .badge-top {
            position: absolute;
            top: -10px;
            right: -10px;
        }

        .logo img {
            width: 100%;
        }

        .logo {
            padding-top: 0rem;
        }

        /* One header system: the top bar is 61px (set by the profile item) —
           brand, icon groups and search all share its centerline. */
        .vd_top-nav .vd_panel-header {
            display: flex;
            align-items: center;
            height: 61px;
        }

        /* Brand lockup: house mark + name, minimalist real-estate style */
        /* The theme forces .logo a to inline-block/120px/17px-top — beat its
           specificity so the lockup is a real flex row: icon left, text right */
        header .vd_top-nav .vd_panel-header .logo a.brand-lockup,
        .brand-lockup {
            display: inline-flex !important;
            flex-direction: row !important;
            align-items: center;
            gap: 9px;
            width: auto !important;
            margin-top: 0 !important;
            text-decoration: none !important;
            padding: 0;
            white-space: nowrap;
        }

        .brand-svg { display: block; }

        /* The anchor is inline-level, so .logo grows ~7px of baseline dead space
           below it and flex centers the wrong box — center the SVG itself */
        header .vd_top-nav .vd_panel-header .logo {
            display: flex;
            align-items: center;
        }

        /* Profile: plain person glyph + name (no round avatar image).
           Selectors mirror the theme's own so cascade order decides */
        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.profile > .mega-link {
            display: flex;
            align-items: center;
            height: 100%;
        }

        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.profile .mega-name {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            float: none;
            margin-left: 0;
            margin-top: 0;
        }

        .mega-li.profile .user-glyph { display: block; }

        .sidebar_fix {
            background-color: #FFFFFF !important;
            border-right: 1px solid #E5E5E5;
        }

        /* Navigation panel = flex column: the menu scrolls, the size toggle stays pinned at the
           bottom-left (LIMS-style "Collapsed View"); the header hamburger is gone. */
        #dashboard .vd_navbar.vd_nav-width.vd_navbar-left {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        #dashboard .vd_navbar-left > .navbar-menu {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
        }
        #dashboard .vd_navbar-left > .navbar-menu::-webkit-scrollbar { width: 7px; }
        #dashboard .vd_navbar-left > .navbar-menu::-webkit-scrollbar-thumb { background: rgba(0,0,0,.16); border-radius: 4px; }
        #dashboard .vd_navbar-left > .navbar-spacing,
        #dashboard .vd_navbar-left > .vd_navbar-bottom-widget { display: none; }
        .nav-footer {
            flex: 0 0 auto;
            border-top: 1px solid #E5E5E5;
            padding: 8px 10px;
            background: #FFFFFF;
        }
        .nav-footer-btn {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            border: 0;
            background: transparent;
            color: #4D4D4D;
            font-size: 13px;
            font-weight: 500;
            padding: 7px 10px;
            border-radius: 6px;
            cursor: pointer;
            white-space: nowrap;
            transition: background .15s ease, color .15s ease;
        }
        .nav-footer-btn:hover { background: #F3F3F3; color: #111111; }
        .nav-footer-btn svg { flex: 0 0 auto; color: #111111; transition: transform .2s ease; }
        /* Short bar: the fly-out panels hang outside the 60px bar — release both the panel
           column and the menu's private scroll region (the same reason customStyling.css
           releases .vd_navbar in these modes). */
        body#dashboard.nav-left-medium .vd_navbar.vd_nav-width.vd_navbar-left,
        body#dashboard.nav-left-small .vd_navbar.vd_nav-width.vd_navbar-left,
        body#dashboard.nav-left-medium .vd_navbar-left > .navbar-menu,
        body#dashboard.nav-left-small .vd_navbar-left > .navbar-menu { overflow: visible !important; }
        .nav-left-medium .nav-footer { padding: 8px 6px; }
        .nav-left-medium .nav-footer-btn { justify-content: center; padding: 7px 0; }
        .nav-left-medium .nav-footer-btn .nav-footer-text { display: none; }
        .nav-left-medium .nav-footer-btn svg { transform: scaleX(-1); }   /* points the other way while collapsed */
        header .vd_top-nav .vd_panel-header #menu_m { display: none !important; }




        /* =====================================================================
           Navigation grid (redesign brief 2026-08-17): every row is one flex
           line — [icon][text][chevron] — so the chevron sits at the same right
           edge on every expandable item, no matter how long the label is.
           ===================================================================== */
        .vd_menu > ul > li > a,
        .vd_menu .child-menu a {
            display: flex;
            align-items: center;
        }

        .vd_menu a .menu-icon {
            float: none;
            flex: 0 0 24px;
        }

        .vd_menu a .menu-text {
            flex: 1 1 auto;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Every chevron on ONE vertical line at every depth. Two parts:
           1) the theme pads each nested child-menu 16px but pulls its rows
              out -20px, so rows grew 4px wider per level — pin padding and
              margins to the same 16px so every row spans the exact same
              width at any depth;
           2) the chip is then pinned at the same right offset of its row.
           (Also neutralises theme.min.css's legacy .menu-badge top:-23px
           float hack. !important: the theme's descendant selectors outrank
           these class selectors.) */
        .vd_menu ul li .child-menu {
            padding-left: 16px !important;
            padding-right: 16px !important;
        }

        .vd_menu ul li .child-menu ul li {
            margin-left: -16px !important;
            margin-right: -16px !important;
        }

        .vd_menu a.nav-link,
        .vd_menu a.nav-group {
            position: relative;
            padding-right: 46px !important;
        }

        .vd_menu a .menu-badge {
            float: none;
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            margin-left: 0;
            padding-left: 0;
        }

        /* Medium (icons-only) mode centers a lone icon — keep its block layout */
        .nav-left-medium .vd_navbar-left .vd_menu > ul > li > a {
            display: block;
        }

        /* Active form (persistent — exactly one leaf at a time, marked from the
           URL server-side). Hover is temporary; this stays until the user opens
           another form. */
        /* section label between Home and the modules (Payroll parity); hidden in icons-only mode */
        .vd_menu > ul > li.nav-label { list-style: none; padding: 12px 20px 4px; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #8A8A8A; }
        .nav-left-medium .vd_navbar-left .vd_menu > ul > li.nav-label { display: none; }
        .vd_menu a.nav-active {
            background: #F0F0F0;
            box-shadow: inset 3px 0 0 #111111;
            border-radius: 0 6px 6px 0;
        }

        .vd_menu a.nav-active .menu-text {
            color: #111111;
            font-weight: 500;
        }

        /* Recent / Favourites header icons + popovers.
           The theme pins every .vd_panel-menu to the same absolute corner
           (right:0), which put this block on top of the hamburger — anchor it
           just PAST the panel header's right edge instead, so the order reads
           menu icon → recent → favourites. */
        .hdr-quick {
            left: calc(100% + 18px);
            right: auto;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .hdr-quick-btn {
            cursor: pointer;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            float: none !important;
        }

        .hdr-quick .hdr-quick-btn.open {
            background: #FFFFFF !important;
            color: #111111 !important;
        }

        .hdr-pop {
            position: fixed;
            display: none;
            min-width: 260px;
            max-width: 340px;
            max-height: 340px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 6px 24px rgba(16,21,31,.18);
            z-index: 3000;
            padding: 8px 0;
        }

        .hdr-pop.show { display: block; }

        .hdr-pop-title {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: 4px 14px 8px;
            border-bottom: 1px solid #f1f5f9;
            margin-bottom: 4px;
        }

        .hdr-pop ul { list-style: none; margin: 0; padding: 0; }

        .hdr-pop li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 14px;
        }

        .hdr-pop li:hover { background: #f8fafc; }

        .hdr-pop a.hq-link {
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
            flex: 1 1 auto;
        }

        .hdr-pop a.hq-link:hover { color: #111111; }

        .hq-star {
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 15px;
            line-height: 1;
            color: #cbd5e1;
            padding: 2px 4px;
            flex: 0 0 auto;
        }

        .hq-star.on, .hq-star:hover { color: #ca8a04; }

        .hq-empty {
            font-size: 12px;
            color: #94a3b8;
            font-style: italic;
            padding: 8px 14px;
        }

        /* Legacy float pattern on many forms: an action link floated right,
           followed by a card that overlaps it (Form Watcher's "Add User" etc).
           Keep the float clickable and start the card below it. */
        .vd_content-section .row > div[style*="float"] {
            position: relative;
            z-index: 5;
        }

        .vd_content-section .row > div[style*="float"] + .card {
            clear: both;
        }

        /* =====================================================================
           Header refinement (redesign brief 2026-08-16): standalone icons, one
           consistent treatment left and right, crisp badge, calm hover states.
           ===================================================================== */

        /* Right-side icons: drop the 36px circle + border — standalone glyphs.
           Flex-centered so the vector sits dead centre of the hit area (it was
           riding the text baseline and looked lifted). */
        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.one-icon > .mega-link {
            border: none !important;
            background: transparent !important;
            border-radius: 8px;
            width: 34px;
            height: 34px;
            line-height: 1 !important;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            transition: background .15s ease, color .15s ease;
            overflow: visible !important;
        }

        .mega-icon {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
        }

        .mega-icon > svg { display: block; }

        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.one-icon .mega-link:hover {
            background: rgba(255,255,255,.18) !important;
            color: #FFFFFF !important;
        }

        /* Active/selected header icon: white container, black icon */
        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.one-icon .mega-link.open {
            background: #FFFFFF !important;
            color: #111111 !important;
        }

        /* Vertically centre both header icon groups on one line (search bar
           keeps its own placement) */
        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.one-icon {
            padding: 0 3px !important;
            display: flex;
            align-items: center;
            height: 61px; /* matches the profile item that sets the bar height */
        }

        /* Left icon group: nudge to the same centerline as the right side
           (the 50%/transform approach collapsed against the panel header's
           height and threw the icons off-screen — fixed offset instead). */
        .vd_top-nav .vd_panel-menu {
            top: 14px;
        }

        .mega-icon { position: relative; display: inline-block; }

        /* Notification badge: crisp count chip, ringed against the header */
        .badge-top {
            top: -7px;
            right: -9px;
            background: #dc2626;
            border: 2px solid #242729;
            font-size: 10px;
            font-weight: 700;
            min-width: 17px;
            height: 17px;
            line-height: 13px;
            padding: 0 4px;
            border-radius: 9px;
        }

        .badge-top:empty { display: none; }

        /* Header icon buttons are real <button>s — neutralise UA styles and
           give them a visible keyboard focus ring */
        button.hdr-quick-btn {
            padding: 0;
            font: inherit;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }

        button.hdr-quick-btn:focus-visible,
        .mega-link:focus-visible,
        .gs-input:focus-visible,
        .fts-star:focus-visible,
        .hq-star:focus-visible {
            outline: 2px solid #BBBBBB;
            outline-offset: 2px;
        }

        /* Numbers align in columns and badges */
        .badge-top,
        .gs-results,
        .hdr-pop {
            font-variant-numeric: tabular-nums;
        }

        /* Honour reduced-motion preferences on everything the shell animates */
        @@media (prefers-reduced-motion: reduce) {
            .gs-icon, .gs-input, .nav-chevron svg, .hdr-quick-btn,
            .vd_menu .child-menu a, .fts-star, .ga-send,
            .vd_top-nav .vd_panel-menu .menu,
            .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.one-icon > .mega-link {
                transition: none !important;
            }
        }

        /* Left icon group (hamburger, recent, favourites, alert): same flat
           treatment as the right side */
        .vd_top-nav .vd_panel-menu .menu {
            background: transparent !important;
            border: none !important;
            color: #FFFFFF !important;
            border-radius: 8px;
            width: 32px !important;
            height: 32px !important;
            line-height: 1 !important;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            transition: background .15s ease, color .15s ease;
        }

        .vd_top-nav .vd_panel-menu .menu svg { display: block; }

        .vd_top-nav .vd_panel-menu .menu:hover {
            background: rgba(255,255,255,.18) !important;
            color: #FFFFFF !important;
        }

        /* Active/selected left-group icon: white container, black icon */
        .vd_top-nav .vd_panel-menu .menu.open,
        .nav-left-medium .vd_top-nav .vd_panel-menu .menu[data-action^="nav-left-medium"],
        .nav-left-small .vd_top-nav .vd_panel-menu .menu[data-action^="nav-left-small"] {
            background: #FFFFFF !important;
            color: #111111 !important;
        }

        /* Profile name typography — white on the charcoal bar, never gray */
        .mega-name {
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: .01em;
        }

        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.profile .mega-link,
        .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > li.profile .mega-name {
            color: #FFFFFF !important;
        }

        /* Navigation chevron: proper icon, not a text-like pill */
        .vd_menu .menu-badge,
        .vd_menu .menu-badge span {
            background: none !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }

        /* Chevron as a proper icon chip: rounded token holding the custom
           double-chevron SVG; brightens and grows slightly on hover, fills with
           the warm accent while its folder is open. */
        .vd_menu .nav-chevron {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: #F7F7F7;
            border: 1px solid #E5E5E5;
            color: #777777;
            opacity: 1;
            transition: color .15s ease, background .15s ease, border-color .15s ease,
                        opacity .2s ease-in-out, transform .2s ease-in-out;
        }

        .vd_menu a:hover .nav-chevron {
            background: #EBEBEB;
            border-color: #D9D9D9;
            color: #111111;
            opacity: 1;
            transform: scale(1.06);
        }

        .vd_menu a.open .nav-chevron {
            background: #111111;
            border-color: #111111;
            color: #FFFFFF;
            opacity: 1;
        }

        /* Navigation rhythm: consistent row height, quieter forms vs groups */
        .vd_menu .child-menu a {
            padding-top: 6px;
            padding-bottom: 6px;
        }

        .vd_menu .child-menu a .menu-text {
            font-size: 12.5px;
            color: #4D4D4D;
            transition: color .18s ease;
        }

        .vd_menu .child-menu a.nav-group .menu-text {
            color: #333333;
        }

        /* Global search — centered inside the fixed top bar */
        .gs-wrap {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            top: 14px; /* (61px bar − 32px field) / 2 — same centerline as the icons */
            width: 430px;
            max-width: 36vw;
            z-index: 1005;
        }

        /* White enterprise search pill: the idle field clearly reads "Search";
           the glyph slides in on the left only while the user is typing. */
        .gs-icon {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%) translateX(-6px);
            opacity: 0;
            color: #64748b;
            pointer-events: none;
            display: inline-flex;
            transition: opacity .18s ease, transform .18s ease;
        }

        .gs-wrap.typing .gs-icon {
            opacity: 1;
            transform: translateY(-50%) translateX(0);
        }

        .gs-input {
            width: 100%;
            height: 32px;
            border: 1px solid #E5E5E5;
            border-radius: 16px;
            background: #ffffff;
            color: #111111;
            font-size: 12.5px;
            padding: 0 14px;
            outline: none;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
            transition: box-shadow .15s ease, border-color .15s ease, padding-left .18s ease;
        }

        /* A theme input[type=text] rule outranks .gs-input and re-adds 6/7px
           vertical padding + 23px line-height, floating the text above the
           centerline — pin the vertical metrics at higher specificity */
        #gsWrap .gs-input {
            padding-top: 0;
            padding-bottom: 0;
            line-height: 30px; /* 32px field − 2×1px border */
        }

        .gs-wrap.typing .gs-input { padding-left: 32px; }

        .gs-input::placeholder { color: #777777; opacity: 1; }

        .gs-input:focus {
            border-color: #111111;
            box-shadow: 0 0 0 3px rgba(17,17,17,0.06);
        }

        .gs-results {
            position: absolute;
            top: 38px;
            left: 0;
            right: 0;
            display: none;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            box-shadow: 0 10px 32px rgba(16,21,31,.22);
            max-height: 420px;
            overflow-y: auto;
            padding: 6px 0;
        }

        .gs-results.show { display: block; }

        .gs-group {
            font-size: 10.5px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: 8px 14px 4px;
        }

        .gs-item {
            display: block;
            padding: 7px 14px;
            text-decoration: none;
            cursor: pointer;
        }

        .gs-item:hover, .gs-item.active {
            background: #f1f5f9;
        }

        .gs-item-name {
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
        }

        .gs-item-sub {
            font-size: 11px;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .gs-none {
            font-size: 12px;
            color: #94a3b8;
            font-style: italic;
            padding: 10px 14px;
        }

        /* Desktop: the centered field must never reach the icon groups on
           either side (left group ends ≈400px in, right group ≈300px wide). */
        @@media (min-width: 1200px) {
            .gs-wrap { max-width: min(36vw, calc(100vw - 860px)); }
        }

        /* Generate Alert — small in-window box over the current screen */
        .ga-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.35);
            z-index: 4000;
            display: none;
            align-items: flex-start;
            justify-content: center;
            padding-top: 9vh;
        }

        .ga-overlay.show { display: flex; }

        .ga-modal {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 12px 40px rgba(16,21,31,.25);
            width: 400px;
            max-width: calc(100vw - 32px);
            padding: 18px 20px 16px;
            overscroll-behavior: contain;
        }

        .ga-title {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .ga-close {
            border: none;
            background: transparent;
            font-size: 18px;
            line-height: 1;
            cursor: pointer;
            color: #94a3b8;
        }

        .ga-close:hover { color: #1e293b; }

        .ga-field { margin-bottom: 10px; }

        .ga-field label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 4px;
        }

        .ga-field select,
        .ga-field textarea {
            width: 100%;
            border: 1px solid #cbd5e1;
            border-radius: 5px;
            font-size: 13px;
            padding: 7px 9px;
            background: #fff;
        }

        .ga-field textarea { min-height: 74px; resize: vertical; }

        .ga-send {
            width: 100%;
            border: none;
            border-radius: 6px;
            background: #111111;
            color: #fff;
            font-weight: 600;
            font-size: 13px;
            padding: 9px 0;
            cursor: pointer;
            margin-top: 4px;
        }

        .ga-send:hover { background: #3A3A3A; }
        .ga-send:disabled { opacity: .6; cursor: default; }

        .ga-toast {
            position: fixed;
            bottom: 22px;
            left: 22px;
            background: #14532d;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            padding: 11px 18px;
            box-shadow: 0 6px 20px rgba(16,21,31,.3);
            z-index: 4100;
            display: none;
        }

        /* Short Bar: the hamburger's medium mode shows icons ONLY (the theme
           only hid names in its small mode) — child menus fly out on click. */
        .nav-left-medium .vd_navbar-left .vd_menu > ul > li > a > .menu-text,
        .nav-left-medium .vd_navbar-left .vd_menu > ul > li > a > .menu-badge,
        .nav-left-small .vd_navbar-left .vd_menu > ul > li > a > .menu-badge {
            display: none !important;
        }

        /* Chevron visibility is owned by CSS, never by inline styles (a legacy
           hamburger handler used to blind-toggle them): full-width modes show
           every chevron; icons-only modes hide only the top-level ones while
           the fly-out panels keep theirs so folders stay recognisable. */
        body:not(.nav-left-medium):not(.nav-left-small) .vd_menu a > .menu-badge {
            display: block !important;
        }

        .nav-left-medium .vd_navbar-left .vd_menu .child-menu a > .menu-badge,
        .nav-left-small .vd_navbar-left .vd_menu .child-menu a > .menu-badge {
            display: block !important;
        }

        .nav-left-medium .vd_navbar-left .vd_menu .child-menu a > .menu-text,
        .nav-left-small .vd_navbar-left .vd_menu .child-menu a > .menu-text {
            display: block !important;
        }

        /* Expand chevron: points right while collapsed; rotates to point down
           while its folder is open (the theme toggles class "open" on the
           trigger anchor). Only the icon animates — the text never moves. */
        .vd_menu .nav-chevron {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .vd_menu .nav-chevron svg {
            transition: transform .22s ease-in-out;
        }

        .vd_menu a.open .nav-chevron svg {
            transform: rotate(90deg);
        }

        /* Open folders are visibly distinct: tinted background, warm accent bar
           on the left, full-white label — closed folders stay flat. */
        .vd_menu a.open {
            background: #F0F0F0;
            box-shadow: inset 3px 0 0 #111111;
        }

        .vd_menu a.open > .menu-text {
            color: #111111;
            font-weight: 600;
        }

        /* Typography hierarchy (redesign brief 2026-08-17):
           main module 600 · expanded folder 600 · sub-folder 500 · form 400.
           Hover emphasis comes from color, never weight — text must not move. */
        .vd_menu > ul > li > a > .menu-text {
            font-weight: 600;
        }

        .vd_menu .child-menu a .menu-text {
            font-weight: 400;
        }

        .vd_menu .child-menu a.nav-group .menu-text {
            font-weight: 500;
            opacity: .95;
        }

        /* Navigation hover: subtle background lift + brighter text and icon,
           150–200ms ease. Temporary by design — the persistent state is
           .nav-active (form) / .open (folder). */
        .vd_menu > ul > li > a:hover {
            background: #F3F3F3;
        }

        .vd_menu .child-menu a {
            border-radius: 6px;
            transition: background .18s ease, color .18s ease;
        }

        .vd_menu .child-menu a:hover {
            background: #F3F3F3;
        }

        .vd_menu a:hover .menu-text {
            color: #111111;
        }

        .vd_menu a:hover .menu-icon {
            color: #111111;
        }

        /* Hover for tabs inside forms (both Bootstrap tab flavours in use). */
        .nav-tabs > li > a:hover,
        .nav-tabs .nav-link:hover {
            background-color: #F3F3F3;
            transition: background-color .12s ease;
        }

        /* Registry-driven form title strip — THE single header of every form.
           The legacy per-form breadcrumb row and title banner are hidden when a
           strip is present; the banner's icon and action buttons are relocated
           into the strip by script. */
        .fts-active .vd_head-section,
        .fts-active .vd_title-section {
            display: none;
        }

        .fts {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px 16px;
            margin: 12px 15px 4px;
            box-shadow: 0 1px 2px rgba(16,21,31,.05);
        }

        .fts-icon {
            display: none;
            flex: 0 0 38px;
            width: 38px;
            height: 38px;
            border-radius: 9px;
            background: #111111;
            color: #fff;
            align-items: center;
            justify-content: center;
        }

        .fts-icon.has-icon { display: inline-flex; }

        .fts-left { min-width: 0; }

        .fts-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-left: auto;
        }

        .fts-actions .btn { margin: 0; }

        .fts-crumbs {
            font-size: 11px;
            color: #94a3b8;
            letter-spacing: .02em;
            margin-bottom: 2px;
        }

        /* h1 semantics with strip-scale visuals; long names truncate cleanly */
        h1.fts-title, .fts-title {
            font-size: 16px;
            font-weight: 700;
            color: #1e293b;
            line-height: 1.2;
            margin: 0;
            padding: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 48vw;
        }

        .fts-star {
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 22px;
            line-height: 1;
            color: #cbd5e1;
            padding: 4px 6px;
            flex: 0 0 auto;
            transition: color .12s ease, transform .12s ease;
        }

        .fts-star:hover { color: #ca8a04; transform: scale(1.15); }
        .fts-star.on { color: #ca8a04; }

        /* Expand controls in the title strip (restored from the legacy per-form
           panel menu). The strip lives in the content area, so it stays visible
           in every mode and can always restore the layout. */
        .fts-view {
            display: flex;
            align-items: center;
            gap: 4px;
            flex: 0 0 auto;
        }

        .fts-view-btn {
            width: 28px;
            height: 28px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            background: #fff;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            transition: background .15s ease, color .15s ease;
        }

        .fts-view-btn:hover { background: #f1f5f9; color: #1e293b; }

        /* pressed state while that mode's class is active on the body element */
        .remove-navbar .fts-view .remove-navbar-button,
        .remove-header .fts-view .remove-header-button,
        .fullscreen .fts-view .fullscreen-button {
            background: #111111;
            border-color: #111111;
            color: #fff;
        }

        /* The theme's remove-navbar / fullscreen classes only ever hid the
           HEADER (the navbar hiding was never wired in its CSS) — mirror the
           theme's own nav-left-hide mechanics so both modes really hide the
           navigation pane too. */
        .remove-navbar .vd_navbar-left,
        .fullscreen .vd_navbar-left {
            margin-left: -260px;
        }

        .remove-navbar .content .vd_container,
        .fullscreen .content .vd_container {
            margin-left: 0;
        }

        .remove-navbar .vd_head-section,
        .fullscreen .vd_head-section,
        .remove-navbar .vd_content-section,
        .fullscreen .vd_content-section,
        .remove-navbar .vd_title-section,
        .fullscreen .vd_title-section {
            margin-left: -15px;
        }

        /* =====================================================================
           Responsive header (brief 2026-08-21 §6–8, §10). Desktop (≥1200) keeps
           the theme geometry. Below 1200px the bar becomes ONE flex row —
           [menu][brand][quick icons] … [search] … [bell][inbox][⋮][user] — and
           discloses progressively: the user's name goes first (≤767), then the
           quick icons and the inbox fold into the ⋮ More menu (≤767), then the
           bell (≤480). Menu button, brand and user never leave the bar.
           ===================================================================== */
        header .mega-ul > li.hdr-more { display: none !important; }

        button.hdr-more-btn {
            padding: 0;
            font: inherit;
            cursor: pointer;
            position: relative;
        }

        .hdr-more-dot {
            position: absolute;
            top: -3px;
            right: -4px;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #dc2626;
            border: 2px solid #242729;
            display: none;
        }

        .hdr-more-btn.has-new .hdr-more-dot { display: block; }

        .hdr-more-pop { min-width: 220px; }

        .hdr-more-pop li { padding: 0; }

        .hdr-more-pop .hm-notif { display: none; }

        .hm-item {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            padding: 8px 14px;
            cursor: pointer;
            text-decoration: none;
        }

        .hm-item:hover, .hm-item:focus-visible { background: #f8fafc; color: #111111; text-decoration: none; outline: none; }

        .hm-item svg { flex: 0 0 auto; color: #475569; }

        .hm-count {
            margin-left: auto;
            font-size: 10.5px;
            font-weight: 700;
            color: #fff;
            background: #dc2626;
            border-radius: 9px;
            min-width: 18px;
            height: 18px;
            line-height: 18px;
            text-align: center;
            padding: 0 5px;
        }

        .hm-count:empty { display: none; }

        /* Search toggle (icon-only search on small screens) */
        .gs-toggle {
            display: none;
            width: 32px;
            height: 32px;
            border: none;
            border-radius: 8px;
            background: transparent;
            color: #FFFFFF;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
        }

        .gs-toggle:hover { background: rgba(255,255,255,.18); }

        @@media (max-width: 1199px) {
            header .vd_top-menu-wrapper > .container.topNav {
                display: flex;
                align-items: center;
                height: 61px;
                padding: 0 8px 0 0;
                position: relative;
            }

            header .vd_top-nav.vd_nav-width {
                position: static !important;
                width: auto !important;
                height: 61px !important;
                padding: 0 0 0 12px !important;
                margin: 0 !important;
                flex: 0 0 auto;
                float: none;
                order: 1;
                min-width: 0;
            }

            header .vd_top-nav .vd_panel-header {
                display: flex;
                align-items: center;
                gap: 4px;
                height: 61px;
                position: static;
            }

            header .vd_top-nav .vd_panel-header .logo {
                float: none;
                text-align: left;
                margin: 0 6px 0 0;
                flex: 0 0 auto;
            }

            header .vd_top-nav .vd_panel-menu {
                position: static !important;
                top: auto !important;
                right: auto !important;
                left: auto !important;
                margin: 0 !important;
                float: none;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            header .vd_top-nav .vd_panel-menu.visible-sm,
            header .vd_top-nav .vd_panel-menu.visible-xs { display: none !important; }

            /* search becomes a flexible middle item */
            header .gs-wrap {
                position: relative;
                left: auto;
                top: auto;
                transform: none;
                flex: 1 1 auto;
                min-width: 0;
                width: auto;
                max-width: 430px;
                margin: 0 12px;
                order: 2;
                display: block;
            }

            header .vd_container.width_set {
                order: 3;
                margin-left: auto !important;
                margin-right: 0 !important;
                padding: 0 !important;
                height: 61px !important;
                display: block !important;
                flex: 0 0 auto;
                float: none;
                min-width: 0;
            }

            header .vd_container > .row { margin: 0; display: block; }
            header .vd_container > .row > .col { padding: 0; }
            header .vd_mega-menu-wrapper .vd_mega-menu { float: none !important; }

            header .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul {
                display: flex;
                align-items: center;
                flex-wrap: nowrap;
            }

            header .vd_mega-menu-wrapper .vd_mega-menu > .mega-ul > .mega-li { float: none; }
            header .container { padding: 0; }
        }

        /* Below the desktop sidebar rules (customStyling ≥992px) the theme
           offsets content 50px beside a 60px icons-only bar — keep them apart. */
        @@media (max-width: 991px) {
            .nav-left-medium .content .vd_container { margin-left: 60px !important; }
        }

        @@media (max-width: 767px) {
            header .mega-user-name { display: none; }
            header .hdr-quick { display: none !important; }          /* → ⋮ */
            header .mega-ul > li#top-menu-inbox { display: none !important; }  /* → ⋮ */
            header .mega-ul > li.hdr-more { display: flex !important; }

            /* search collapses to an icon; tapping it drops the field below the bar */
            header .gs-wrap { flex: 0 0 auto; width: 32px; max-width: 32px; margin: 0 4px; }
            header .gs-wrap .gs-input, header .gs-wrap .gs-icon { display: none; }
            header .gs-toggle { display: inline-flex; }

            header .gs-wrap.gs-open {
                position: absolute;
                left: 8px;
                right: 8px;
                top: 61px;
                width: auto;
                max-width: none;
                margin: 0;
                padding: 8px;
                background: #242729;
                border-radius: 0 0 10px 10px;
                box-shadow: 0 10px 24px rgba(0,0,0,.25);
                z-index: 1006;
            }

            header .gs-wrap.gs-open .gs-input { display: block; }
            header .gs-wrap.gs-open .gs-toggle { display: none; }
            header .gs-wrap.gs-open.typing .gs-icon { display: inline-flex; left: 19px; }
            header .gs-wrap.gs-open .gs-results { top: 46px; left: 8px; right: 8px; }

            .brand-svg { width: 150px; height: auto; }

            /* the theme floats the content 717px wide when the nav is hidden on
               phones — never let the header or content overflow sideways */
            .nav-left-hide .content .vd_container { float: none; min-width: 0; }
        }

        @@media (max-width: 480px) {
            header .mega-ul > li#top-menu-3 { display: none !important; }   /* bell → ⋮ */
            .hdr-more-pop .hm-notif { display: flex; }
            .brand-svg { width: 132px; }
            header .vd_top-nav.vd_nav-width { padding-left: 6px !important; }
            header .vd_top-nav .vd_panel-header .logo { margin-right: 2px; }
        }

        @@media (max-width: 375px) {
            .brand-svg { width: 118px; }
        }

        /* =====================================================================
           Notifications panel — opens from the bell over the current screen
           (same overlay pattern as Generate Alert). Header stays put, the list
           scrolls on its own; DataTables provides search, page size and pages.
           The full page /Notification/Index stays reachable from the header.
           ===================================================================== */
        .np-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.28);
            z-index: 4000;
            display: none;
        }

        .np-overlay.show { display: block; }

        .np-panel {
            position: absolute;
            top: 66px;
            right: 12px;
            width: 760px;
            max-width: calc(100vw - 24px);
            max-height: calc(100vh - 80px);
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 12px 40px rgba(16,21,31,.25);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            overscroll-behavior: contain;
        }

        .np-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 16px;
            border-bottom: 1px solid #e5e7eb;
            flex: 0 0 auto;
        }

        .np-title {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .np-count {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            background: #f1f5f9;
            border-radius: 10px;
            padding: 2px 8px;
        }

        .np-count:empty { display: none; }

        .np-head-actions { display: flex; align-items: center; gap: 6px; }

        .np-full {
            font-size: 12px;
            font-weight: 600;
            color: #64748b;
            text-decoration: none;
            padding: 4px 8px;
            border-radius: 6px;
        }

        .np-full:hover { background: #f1f5f9; color: #111111; text-decoration: none; }

        .np-close {
            border: none;
            background: transparent;
            font-size: 20px;
            line-height: 1;
            cursor: pointer;
            color: #94a3b8;
            padding: 2px 6px;
        }

        .np-close:hover { color: #1e293b; }

        .np-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }

        .np-body .dataTables_wrapper {
            display: flex;
            flex-direction: column;
            min-height: 0;
            flex: 1 1 auto;
        }

        .np-tools { padding: 10px 16px; border-bottom: 1px solid #f1f5f9; flex: 0 0 auto; }
        .np-tools .dataTables_filter { float: none; text-align: left; }
        .np-tools .dataTables_filter label { display: block; margin: 0; font-weight: 400; }

        .np-tools .dataTables_filter input {
            width: 100%;
            margin: 0;
            height: 32px;
            border: 1px solid #E5E5E5;
            border-radius: 16px;
            padding: 0 14px;
            font-size: 12.5px;
            outline: none;
        }

        .np-tools .dataTables_filter input:focus { border-color: #111111; box-shadow: 0 0 0 3px rgba(17,17,17,.06); }

        .np-scroll { flex: 1 1 auto; min-height: 0; overflow: auto; }

        .np-table { width: 100% !important; margin: 0 !important; font-size: 12.5px; }

        .np-table thead th {
            position: sticky;
            top: 0;
            background: #f8fafc;
            z-index: 1;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
            border-bottom: 1px solid #e5e7eb !important;
            padding: 8px 10px;
            white-space: nowrap;
        }

        .np-table tbody td {
            padding: 8px 10px;
            vertical-align: top;
            border-top: 1px solid #f1f5f9;
            color: #1e293b;
        }

        .np-table td.np-narr { white-space: normal; min-width: 220px; line-height: 1.45; }
        .np-table td.np-when { white-space: nowrap; color: #64748b; }

        .np-type {
            display: inline-block;
            font-size: 10.5px;
            font-weight: 700;
            border-radius: 10px;
            padding: 2px 8px;
            background: #f1f5f9;
            color: #334155;
            white-space: nowrap;
        }

        .np-type.critical { background: #fee2e2; color: #b91c1c; }

        .np-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            padding: 8px 16px;
            border-top: 1px solid #e5e7eb;
            flex: 0 0 auto;
            font-size: 12px;
            color: #64748b;
        }

        .np-foot .dataTables_length,
        .np-foot .dataTables_info,
        .np-foot .dataTables_paginate { float: none; padding: 0; margin: 0; }

        .np-foot .dataTables_length label { margin: 0; font-weight: 400; }

        .np-foot .dataTables_length select {
            height: 26px;
            border: 1px solid #E5E5E5;
            border-radius: 6px;
            padding: 0 6px;
            font-size: 12px;
            margin: 0 2px;
        }

        .np-foot .dataTables_paginate .paginate_button {
            padding: 3px 8px;
            min-width: 26px;
            font-size: 12px;
            border-radius: 6px;
            margin-left: 2px;
        }

        .np-foot .dataTables_paginate .paginate_button.current,
        .np-foot .dataTables_paginate .paginate_button.current:hover {
            background: #111111;
            color: #fff !important;
            border-color: #111111;
        }

        .np-empty, .np-loading {
            padding: 28px 16px;
            text-align: center;
            color: #94a3b8;
            font-size: 13px;
            font-style: italic;
        }

        .np-error { padding: 16px; color: #b91c1c; font-size: 12.5px; display: none; }

        @@media (max-width: 600px) {
            .np-panel {
                top: 61px;
                right: 0;
                left: 0;
                width: auto;
                max-width: none;
                max-height: calc(100vh - 61px);
                border-radius: 0 0 10px 10px;
            }

            .np-table .np-hide-sm { display: none; }
            .np-table td.np-narr { min-width: 0; }
        }
    </style>
