@using B_DB_Model
@inject B_DB_Context.DataBase_Context Db
@{
    // Registry-driven navigation (AI file.xlsx Instructions §5): the tree lives in
    // NavigationNodes; DisplayName is presentation, PermissionKey is authorization.
    // A form shows only when the signed-in user's permission set grants CanView on
    // its PermissionKey; a group shows only when it has a visible descendant.
    List<NavigationNode> allNodes;
    try
    {
        allNodes = Db.NavigationNodes.Where(n => n.IsActive && n.IsVisible).ToList();
    }
    catch
    {
        allNodes = new List<NavigationNode>();
    }

    var childrenOf = allNodes
        .GroupBy(n => n.ParentId ?? 0)
        .ToDictionary(g => g.Key, g => g.OrderBy(n => n.SequenceNo).ThenBy(n => n.Id).ToList());

    var visibleCache = new Dictionary<int, bool>();

    bool NodeVisible(NavigationNode n)
    {
        if (visibleCache.TryGetValue(n.Id, out var v)) return v;
        bool result;
        if (n.NodeType == "Form")
        {
            var perm = string.IsNullOrEmpty(n.PermissionKey) ? null : Html.UserHavePermission(n.PermissionKey);
            result = perm != null && perm.CanView;
        }
        else
        {
            result = childrenOf.TryGetValue(n.Id, out var kids) && kids.Any(NodeVisible);
        }
        visibleCache[n.Id] = result;
        return result;
    }

