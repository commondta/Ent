        "Financial Operations" => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" class=\"bi bi-cash-coin\" viewBox=\"0 0 16 16\"><path fill-rule=\"evenodd\" d=\"M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8m5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0\"/><path d=\"M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.54-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.668zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195z\"/><path d=\"M1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083q.088-.517.258-1H3a2 2 0 0 0-2-2V3a2 2 0 0 0 2-2h10a2 2 0 0 0 2 2v3.528c.38.34.717.728 1 1.154V1a1 1 0 0 0-1-1z\"/><path d=\"M9.998 5.083 10 5a2 2 0 1 0-3.132 1.65 6 6 0 0 1 3.13-1.567\"/></svg>",
        "Records & File Management" => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" class=\"bi bi-archive\" viewBox=\"0 0 16 16\"><path d=\"M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5zm13-3H1v2h14zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5\"/></svg>",
        "Business Analytics" => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" class=\"bi bi-graph-up\" viewBox=\"0 0 16 16\"><path fill-rule=\"evenodd\" d=\"M0 0h1v15h15v1H0zm14.817 3.113a.5.5 0 0 1 .07.704l-4.5 5.5a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61 4.15-5.073a.5.5 0 0 1 .704-.07\"/></svg>",
        // Construction & Development — tower crane over a building (hand-drawn, solid, currentColor)
        "Construction & Development" => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M1.2 1.6h12.3v1.2H1.2z\"/><path d=\"M2.7 2.8h1.5V15H2.7z\"/><path d=\"M1.7 2.8h3.5v1.8H1.7z\"/><path d=\"M11.1 2.8h.8v3.1h-.8z\"/><path d=\"M10 5.9h3v1.1h-3z\"/><path fill-rule=\"evenodd\" d=\"M7.6 8.2h7V15h-7zm1.2 1.3v1.4h1.5V9.5zm2.9 0v1.4h1.5V9.5zM8.8 12v1.4h1.5V12zm2.9 0v1.4h1.5V12z\"/><path d=\"M.5 15h15v1H.5z\"/></svg>",
        // Utilities Management — meter gauge with needle (hand-drawn, solid, currentColor)
        "Utilities Management" => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M1.3 10.4a6.7 6.7 0 0 1 13.4 0h-1.9a4.8 4.8 0 0 0-9.6 0z\"/><path d=\"M7.4 10.9 11.8 5.6l.9.75-4.4 5.3z\"/><circle cx=\"8\" cy=\"11.4\" r=\"1.4\"/><path d=\"M2.2 14h11.6v1.1H2.2z\"/></svg>",
        "Administration" => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" class=\"bi bi-gear\" viewBox=\"0 0 16 16\"><path d=\"M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0\"/><path d=\"M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z\"/></svg>",
        _ => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" class=\"bi bi-folder\" viewBox=\"0 0 16 16\"><path d=\"M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a2 2 0 0 1 .342-1.31zM2.19 4a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91h10.348a1 1 0 0 0 .995-.91l.637-7A1 1 0 0 0 13.81 4zm4.69-1.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139q.323-.119.684-.12h5.396z\"/></svg>"
    };

    // Depth-based indentation so the tree reads as a hierarchy: level 1 sits at
    // the theme's 20px baseline, each further level steps in 16px. Forms and
    // groups at the same level share the same indent.
    string Indent(NavigationNode n) => $"padding-left:{20 + Math.Max(0, n.Depth - 1) * 16}px;";

    // Active form = the node whose Route matches the current URL. Exactly one
    // leaf is active at a time; its ancestor chain renders pre-expanded
    // (classes nav-trail / nav-trail-trigger keep it open — see theme.js).
    var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    var activeForm = allNodes.FirstOrDefault(n => n.NodeType == "Form" && !string.IsNullOrEmpty(n.Route) &&
        string.Equals(n.Route.TrimEnd('/'), currentPath, StringComparison.OrdinalIgnoreCase));
    var activeTrail = new HashSet<int>();
    if (activeForm != null)
    {
        var byId = allNodes.ToDictionary(n => n.Id);
        var walk = activeForm.ParentId;
        while (walk != null && byId.TryGetValue(walk.Value, out var parentNode))
        {
            activeTrail.Add(parentNode.Id);
            walk = parentNode.ParentId;
        }
    }

    // Custom expand indicators, drawn by hand to match the supplied reference:
    // bold solid chevron bands (not strokes, not a font glyph), pointing right
    // while collapsed; CSS rotates them to point down while open. Main modules
    // carry the double chevron, sub-folders a single one. Inherit currentColor.
    const string ChevronDouble = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M2 2.5 7.5 8 2 13.5h3.2L10.7 8 5.2 2.5Z\"/><path d=\"M7 2.5 12.5 8 7 13.5h3.2L15.7 8 10.2 2.5Z\"/></svg>";
    const string ChevronSingle = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4 2.5 9.5 8 4 13.5h3.2L12.7 8 7.2 2.5Z\"/></svg>";

    void RenderChildren(int parentId)
    {
        if (!childrenOf.TryGetValue(parentId, out var kids)) { return; }
        foreach (var child in kids.Where(NodeVisible))
        {
            if (child.NodeType == "Form")
            {
                <li>
                    <a href="@child.Route" class="@(activeForm != null && child.Id == activeForm.Id ? "nav-active" : null)" style="@Indent(child)">
                        <span class="menu-text">@child.DisplayName</span>
                    </a>
                </li>
            }
            else
            {
                var onTrail = activeTrail.Contains(child.Id);
                <li>
                    <a href="javascript:void(0);" data-action="click-trigger" class="nav-group@(onTrail ? " open nav-trail-trigger" : "")" style="@Indent(child)" aria-expanded="@(onTrail ? "true" : "false")">
                        <span class="menu-text">@child.DisplayName</span>
                        <span class="menu-badge" aria-hidden="true"><span class="nav-chevron">@Html.Raw(ChevronSingle)</span></span>
                    </a>
                    <div class="child-menu@(onTrail ? " nav-trail" : "")" data-action="click-target" style="@(onTrail ? "display:block" : null)">
                        <ul>
                            @{ RenderChildren(child.Id); }
                        </ul>
                    </div>
                </li>
            }
        }
    }
}

@{
    // Home entry at the top of the tree (Payroll parity); active on the landing page.
    var isHome = currentPath.Length == 0 || currentPath.Equals("/Home", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
}
<li>
    <a href="/Home/Index" class="nav-link home-nav@(isHome ? " nav-active" : "")" title="Home">
        <span class="menu-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/></svg></span>
        <span class="menu-text">Home</span>
    </a>
</li>
<li class="nav-label" aria-hidden="true"><span class="menu-text">Modules</span></li>
@foreach (var module in (childrenOf.TryGetValue(0, out var roots) ? roots : new List<NavigationNode>()).Where(NodeVisible))
{
    var moduleOnTrail = activeTrail.Contains(module.Id);
    <li>
        <a href="javascript:void(0);" data-action="click-trigger" class="nav-link@(moduleOnTrail ? " open nav-trail-trigger" : "")" title="@module.DisplayName" aria-expanded="@(moduleOnTrail ? "true" : "false")">
            <span class="menu-icon" aria-hidden="true">@Html.Raw(ModuleIcon(module.DisplayName))</span>
            <span class="menu-text">@module.DisplayName</span>
            <span class="menu-badge" aria-hidden="true"><span class="nav-chevron">@Html.Raw(ChevronDouble)</span></span>
        </a>
        <div class="child-menu@(moduleOnTrail ? " nav-trail" : "")" data-action="click-target" style="@(moduleOnTrail ? "display:block" : null)">
            <ul>
                @{ RenderChildren(module.Id); }
            </ul>
        </div>
    </li>
}
