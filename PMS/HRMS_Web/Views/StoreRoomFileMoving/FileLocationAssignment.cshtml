                        <div data-action="remove-header" data-original-title="Remove Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="remove-header-button menu"> <i class="fa fa-arrows-v"></i> </div>
                        <div data-action="fullscreen" data-original-title="Remove Navigation Bar and Top Menu Toggle" data-toggle="tooltip" data-placement="bottom" class="fullscreen-button menu"> <i class="glyphicon glyphicon-fullscreen"></i> </div>
                    </div>

                </div>
            </div>
            <!-- vd_head-section -->

            <div class="vd_title-section clearfix">
                <div class="vd_panel-header">
                    <span class="tp-head-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-archive" viewBox="0 0 16 16"><path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5zm13-3H1v2h14zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/></svg></span>
                    <h1>FILE LOCATION ASSIGNMENT</h1>
                    @*    <small class="subtitle">CATEGORY DEFINITION</small>*@
                    <div class="vd_panel-menu  hidden-xs">
                        <!-- menu -->
                    </div>
                    <!-- vd_panel-menu -->
                </div>
                <!-- vd_panel-header -->
            </div>
            <!-- vd_title-section -->
            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        @if (Html.UserHavePermission("Record Room") != null && Html.UserHavePermission("Record Room").CanAdd)
                        {
               
                            <form class="custom-validation" action="#" role="form" id="Store">

                                <div class="row">
                                    <div class="col-sm-3">
                                        <label>File No. </label>
                                        <div class="search_btn ">
                                            <div class="input_div">
                                                <input type="text" class="form-control"  name="PropNo" placeholder="" id="PropNo" />
                                            </div>
                                            <div>
                                                <button data-toggle="modal" data-target="#registrationModal" type="button" class="btn btn-sm dha_theme_btn">
                                                    Search
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    </div>
                                    <div class="row">
                                    <div class="col-sm-3">
                                        <label>Reference No. <small style="color:red;">*</small></label>
                                        <div>
                                            <input type="text" class="form-control" readonly name="RegNo" id="RegNo" style="width:100%" />

                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label>Block <small style="color:red;">*</small></label>
                                        <div>
                                            <input type="text" class="form-control"  name="Block" id="Block" style="width:100%" />

                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label>Rack <small style="color:red;">*</small></label>
                                        <div>
                                            <input type="text" class="form-control" name="Rack" id="Rack" style="width:100%" />

                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label>Row <small style="color:red;">*</small></label>
                                        <div>
                                            <input type="text" class="form-control" name="Roww" id="Roww" style="width:100%" />

                                        </div>
                                    </div>
                                    
                                      
                                       
                                
                                   

                                </div>
                                
                                    <div style="margin: 25px 0px; float:right" >
                                        <button type="submit" class="btn dha_theme_btn" id="Submitp">
                                            <span class="menu-icon"><i class="fa fa-fw fa-check-circle"></i></span>Submit
                                        </button>
                                    </div>
                                
                            </form>
                        }
                        <br />
                        <div >
                            <div class="">
                                <table id="BlockModal" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            <th class="text-white hide" style="text-align: center;">StockId</th>
                                            <th class="text-white" style="text-align: center;">Reference No.</th>
                                            <th class="text-white" style="text-align: center;">File No/Plot No.</th>
                                            <th class="text-white" style="text-align: center;">Block</th>
                                            <th class="text-white" style="text-align: center;">Rack </th>
                                            <th class="text-white" style="text-align: center;">Row </th>
                                            <th class="text-white" style="text-align: center; width:150px">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="blocktbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- .vd_content-section -->
        </div>
        <!-- .vd_content -->
    </div>
    <!-- .vd_container -->
</div>
<!-- .vd_content-wrapper -->
<!-- Middle Content End -->
