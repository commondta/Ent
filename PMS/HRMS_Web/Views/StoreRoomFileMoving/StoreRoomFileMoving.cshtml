<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="modaltitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title" onclick="openmodalAdd()" id="modaltitle">Add File</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form id="Store" class="custom-validation" action="#" role="form">

                    <div class="container">
                        <div class="row">
                            <div class="col-md-12 hide">
                                <label>Code</label>
                                <input id="ID" class="form-control" disabled />
                                @* <input type="number"  id="ID" class="form-control hide" />*@
                            </div>
                            <div class="col-md-12">
                                <label>Department <small style="color:red;">*</small></label>
                                <div>
                                    <select class="js-example-basic-single" name="Departmentpop" id="Departmentpop" style="width:100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label>File Receiver <small style="color:red;">*</small></label>
                                <div>
                                    <select class="js-example-basic-single" name="PMSUSERpop" id="PMSUSERpop" style="width:100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12">
                                <label>Page Out <small style="color:red;">*</small></label>
                                <div>
                                    <input type="text" class="js-example-basic-single" name="PageOutInPop" id="PageOutInPop" style="width:100%" />

                                </div>
                            </div>
                            <div class="col-sm-2 hide">
                                <label>Expected Receiving Date <small style="color:red;">*</small></label>
                                <div>
                                    <input type="date" class="js-example-basic-single" name="ExpectedReceivingDatePop" id="ExpectedReceivingDatePop" style="width:100%" />

                                </div>
                            </div>
                            <div class="col-md-12">
                                <label>Reason<small style="color:red;">*</small></label>
                                <div>
                                    <textarea class="js-example-basic-single" name="UserRemarks" id="UserRemarks" style="width:100%;"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer background-login">
                        <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
                        <button id="SubmitButton" type="submit" class="btn btn-primary btn-theme">Submit</button>
                    </div>
                </form>
            </div>
           
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


<div class="modal" id="fileTrackerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header vd_bg-blue vd_white">
                <h4 class="modal-title">Files Tracker. </h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <table id="fileTracker" class="table table-bordered table-hover mb-0">
                                    <thead class="bg-theme">
                                        <tr>
                                            <th class="text-white" style="width: 90px; text-align: center;">#</th>
                                            <th class="text-white" style="text-align: center;">Reference No.</th>
                                            <th class="text-white" style="text-align: center;">FileNo/Plot No.</th>
                                            <th class="text-white" style="text-align: center;">Block</th>
                                            <th class="text-white" style="text-align: center;">User</th>
                                            <th class="text-white" style="text-align: center;">Depart</th>
                                            <th class="text-white" style="text-align: center;">Remarks </th>
                                            <th class="text-white" style="text-align: center;">Assigned DateTime </th>
                                            <th class="text-white" style="text-align: center;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody id="fileTrackertbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer background-login">
                <button type="button" class="btn vd_btn vd_bg-grey" data-dismiss="modal">Close</button>
            </div>
