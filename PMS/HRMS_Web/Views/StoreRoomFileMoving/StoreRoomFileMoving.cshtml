</div>
<partial name="~/Views/PartialPage/_alert.cshtml" />
<partial name="~/Views/PartialPage/SearchPropertyModal.cshtml" />
<input id="RegID" type="number" class="hide" />
<input id="PageOut" type="number" class="hide" value="0" />
<input type="text" id="userid" value="@Context.Session.GetString("ID")" class="hide" />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />
@section Scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            "use strict";

            $("#Store").validate({
                errorElement: 'div', //default input error message container
                errorClass: 'vd_red', // default input error message class
                focusInvalid: false, // do not focus the last invalid input
                ignore: "",
                rules: {
                    RegNoA: {

                        required: true
                    },
                    StoreRemarks: {

                        required: true
                    },
                    PMSUSER: {

                        required: true
                    },
                    Department: {

                        required: true
                    },

                    StoreRemarks: {

                        required: true
                    },
                    ExpectedReceivingDate: {

                        required: true
                    },
                    PageOutIn: {

                        required: true
                    },
                    PMSUSERpop: {

                        required: true
                    },
                    Departmentpop: {

                        required: true
                    },
                    UserRemarks: {

                        required: true
                    },
                    PageOutInPop:{
                        required : true
                    }

                },

                errorPlacement: function (error, element) {
                    debugger;
                    if (element.parent().hasClass("vd_checkbox") || element.parent().hasClass("vd_radio")) {
                        element.parent().append(error);
                    } else if (element.parent().hasClass("vd_input-wrapper")) {
                        error.insertAfter(element.parent());
                    } else if (element.hasClass("js-example-basic-single")) {
                        error.insertAfter(element.parent());
                    } else {
                        error.insertAfter(element);
                    }
                },

                invalidHandler: function (event, validator) {
                },

                highlight: function (element) { // hightlight error inputs

                    $(element).addClass('vd_bd-red');
                    $(element).siblings('.help-inline').removeClass('help-inline fa fa-check vd_green mgl-10');

                },

                unhighlight: function (element) { // revert the change dony by hightlight
                    $(element)
                        .closest('.control-group').removeClass('error'); // set error class to the control group
                },

                success: function (label, element) {
                    $(element).removeClass('vd_bd-red');
                },

                submitHandler: function (form) {
                    PostRequest();
                }
            });
            GetAllPropertyLists();
            GetAllDepartments();
            GetAllFiles();
            $('#PMSUSER').select2();
            $('#Department').select2();
            $('#PMSUSERpop').select2();
            $('#Departmentpop').select2();
        });

        $('#Department').on('select2:selecting', function (e) {
            var value = e.params.args.data.id;
            GetPMSUserByDepartment(value);
        });

        function GetPMSUserByDepartment(id) {
            $.ajax({

                type: 'GET',
                url: `/api/PMSUser/GetPMSUserByDepartment`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        $("#PMSUSER").empty();
                        var row = ' <option value="-1">-- Select User type --</option> ';

                        $("#PMSUSER").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.emP_FULL_NAME + '</option> ';
                                $("#PMSUSER").append(row);
                                sr++;
                            }
                        }
                        $('#PMSUSER').select2();
                    }
                }
            });
        }

        function GetAllDepartments() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Department/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Department").empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#Department").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + ' </option> ';

                                $("#Department").append(row);

                                sr++;
                            }

                        }

                    }
                }
            });
        }

        // popup

        $('#Departmentpop').on('select2:selecting', function (e) {
            var value = e.params.args.data.id;
            GetPMSUserByDepartmentpop(value);
        });

        function GetPMSUserByDepartmentpop(id) {
            debugger;
            $.ajax({

                type: 'GET',
                url: `/api/PMSUser/GetPMSUserByDepartment`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code === 100) {

                        $("#PMSUSERpop").empty();
                        var row = ' <option value="-1">-- Select User type --</option> ';

                        $("#PMSUSERpop").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.emP_FULL_NAME + '</option> ';

                                $("#PMSUSERpop").append(row);


                                sr++;

                            }

                        }
                        $('#PMSUSERpop').select2();
                    }
                }
            });
        }

        function GetAllDepartmentspop() {
            debugger;
            $.ajax({
                type: 'GET',
                url: `/api/Department/GetAll`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 0) {

                        $("#Departmentpop").empty();
                        var row = ' <option value="-1">Select Option</option> ';

                        $("#Departmentpop").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.description + ' </option> ';

                                $("#Departmentpop").append(row);

                                sr++;
                            }

                        }

                    }
                }
            });
        }

        function GetAllPropertyLists() {

            $('#proplist').DataTable({
                ajax: {
                    url: "/api/SP/GetAllProprtties",
                    type: "POST",
                    headers: {
                        Authorization: `Bearer ${localStorage.getItem("token")}`
                    },
                },
                processing: true,
                serverSide: true,
                filter: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        },
                        title: "#",
                    },
                    { data: "propertyNo", name: "PropertyNo" },
                    { data: "registrationNo", name: "RegistrationNo" },
                    { data: "memberName", name: "MemberName" },
                    { data: "cnic", name: "CNIC" },
                    { data: "relationshipWith", name: "RelationshipWith" },
                    { data: "phase", name: "Phase" },
                    { data: "block", name: "Block" },
                    { data: "category", name: "Category" },
                    { data: "propertyType", name: "PropertyType" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return '<a class="btn btn-primary" onclick="SelectRegistration(' + data.id + ')">Select</a>';
                        }
                    }
                ]
            });
        }

        function SelectRegistration(id) {
           
            var url = "/api/LDAPlotNo/GetFilterProperty?id=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                data: { id: id },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                  
                    if (response.code === 100) {
                        var result_User = response.data;
                        // set values
                        $("#RegNoA").val(result_User.registrationNo);
                        $("#RegID").val(result_User.id);
                        $("#registrationModal").modal("hide");
                        ShowAlert(result_User.id);
                    }

                    else {
                        //notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Eror", "Problem Finding Registration Number");
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem Finding Registration Number',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function EditBlock(id) {
          
            $.ajax({
                type: 'GET',
                url: `/api/StoreRoomFileMoving/Get`,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                dataType: "json",
                data: { id: id },
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response.code === 100) {
                      
                        GetAllDepartmentspop();
                        var result_User = response.data;
                        let expectedReceivingDate = (result_User.expectedReceivingDate).split('T')[0] ?? "";
                        $("#ID").val(result_User.id);
                        $("#RegID").val(result_User.stockCreationId);
                        $("#ExpectedReceivingDatePop").val(expectedReceivingDate);
                        var pageOutInValue = result_User.pageOutIn.split('/')[0];
                        $("#PageOutInPop").val(pageOutInValue);
                        $("#PageOut").val(pageOutInValue);
                        $("#SubmitButton").text("Update");
                        $("#modaltitle").text("Move File ");
                        $("#myModal").modal("show");
                    }

                    else {
                        notification("bottomleft", "error", "fa fa-exclamation-circle vd_red", "Error", response.message);
                        // window.alert(response.message);
                    }
                }
            });
        }

        function PostRequest() {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Submit();
                } else if (
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Submit() {

          
       var isRecordRoom = false;
       var modifiedBy = $("#User_Id").val();
       var createdBy = $("#User_Id").val();
       var lastModifiedUserName = $("#User_Name").val();

            var RegId = $("#RegID").val();

            if (RegId == "") {
                RegId = $("#RegNo").val();
            }
            else {
                RegId = $("#RegID").val();
            }

            var DeptId = $("#Department").val();

            if (DeptId == undefined) {
                DeptId = $("#Departmentpop").val();
            }
            else {
                DeptId = $("#Department").val();
            }

            var pageOutIn = $("#PageOutIn").val();

            if (pageOutIn == undefined) {
                pageOutIn = $("#PageOutInPop").val();
            }
            else {
                pageOutIn = $("#PageOutIn").val();
            }

            var expectedReceivingDate = $("#ExpectedReceivingDate").val();

            if (expectedReceivingDate == undefined) {
                expectedReceivingDate = $("#ExpectedReceivingDatePop").val();
            }
            else {
                expectedReceivingDate = $("#ExpectedReceivingDate").val();
            }

            var userId = $("#PMSUSER").val();

            if (userId == null) {
                userId = $("#PMSUSERpop").val();
                pageOut = $("#PageOut").val();
            }
            else {
                isRecordRoom = true;
                userId = $("#PMSUSER").val();
                pageOut = $("#PageOutIn").val();
            }

            var remarks = $("#StoreRemarks").val() == undefined ? 'N/A' : $("#StoreRemarks").val().trim();

            if (remarks == 'N/A') {
                remarks = $("#UserRemarks").val().trim();
            }
            else {
                remarks = $("#StoreRemarks").val().trim();
            }

            var category =
            {
                StockCreationId: RegId,
                DepartmentId: DeptId,
                PMSUserId: userId,
                IsFileClosed: false,
                IsRecordRoom: isRecordRoom,
                Remarks: remarks,
                ExpectedReceivingDate: expectedReceivingDate,
                PageOutIn: pageOutIn,
                PageOut : pageOut,
                ModifiedBy : modifiedBy,
                CreatedBy : createdBy,
                LastModifiedUserName : lastModifiedUserName,
            };

            var ModelData = JSON.stringify(category);
            $('#loader').fadeIn();
            $.ajax({
                type: "POST",
                url: `/api/StoreRoomFileMoving/AddNewFile`,
                contentType: 'application/json; charset=utf-8',
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                processData: false,
                dataType: "json",
                async: false,
                data: ModelData,
                success: function (response) {
                 

                    $('#loader').fadeOut();
                  
                    if (response.code === 100) {

                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });

                        $("#myModal").modal("hide");
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                    else {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                    }
                }
            });
        }

        function GetAllFiles() {

            var id = $("#userid").val();
            $.ajax({
                type: 'GET',
                url: "/api/StoreRoomFileMoving/GetAll?id=" + id + "",
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {

                    if (response.code === 100) {
                        var datatabl = $('#Block').DataTable();
                        datatabl.destroy();
                        $("#blocktbody").empty();

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            for (let list of relist) {
                                const assignedDateTime = moment(list.createdOn).format('DD-MM-YYYY, h:mmA');
                                const expectedrecievedDateTime = moment(list.expectedReceivingDate).format('DD-MM-YYYY');
                                var haspermission = $("#RegNoA").val() == undefined ? false : true;
                                var btnstring = '';
                                if (haspermission == true) {
                                    btnstring = '<button  class="btn-warning " onclick = "CloseFile(' + list.id + ')">Received</button>';
                                    $("#actionDate").text("Actual Return Date");
                                }
                                else {
                                    btnstring = '<button  class="btn-primary"  onclick="EditBlock(' + list.id + ')" >Move</button>';
                                    $("#actionDate").text("Issed Date");
                                }
                                var row = ' <tr> ' +
                                    ' <td>' + sr + '</td> ' +
                                    ' <td class="hide">' + list.stockCreationId + '</td>' +
                                    ' <td Style = "text-align: center">' + list.registrationNo + '</td>' +
                                    ' <td Style = "text-align: center">' + list.propertyNo + '</td>' +
                                    ' <td Style = "text-align: center">' + list.block + '</td>' +
                                    ' <td Style = "text-align: center">' + list.remarks + '</td>' +
                                    ' <td Style = "text-align: center">' + list.pageOutIn + '</td>' +
                                    ' <td Style = "text-align: center">' + expectedrecievedDateTime + '</td>' +
                                    ' <td Style = "text-align: center">' + assignedDateTime + '</td>' +
                                    '<td Style = "text-align: center">' + btnstring + '</td>' +
                                    '</tr>';
                                $("#blocktbody").append(row);
                                sr++;
                            }
                        }
                        $('#Block').dataTable();
                    }
                }
            });
        }

        function CloseFile(id) {

            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            })

            swalWithBootstrapButtons.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Close it!',
                cancelButtonText: 'No, cancel!',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    swalWithBootstrapButtons.fire({
                        icon: 'success',
                        title: 'Closed',
                        text: 'Your file is Close.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    Closed(id);
                } else if (               
                    result.dismiss === Swal.DismissReason.cancel
                ) {
                    swalWithBootstrapButtons.fire({
                        icon: 'error',
                        title: 'Cancelled',
                        text: 'Your data is safe !',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                }
            })
        }

        function Closed(id) {
       
            $.ajax({
                type: "Post",
                url: "/api/StoreRoomFileMoving/CloseFile?id=" + id + "",
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    if (response.code === 100) {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        GetAllFiles();
                    }
                    else {
                        $("#BlockForm").submit(function (e) {
                            e.preventDefault();
                        });
                        notification("bottomleft", "Error", "fa fa-exclamation-circle vd_red", "Success", response.message);
                    }
                }
            });
        }

