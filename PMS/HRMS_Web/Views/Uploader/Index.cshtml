<div class="vd_content-wrapper">
    <div class="vd_container">
        <div class="vd_content clearfix">
            <div class="vd_head-section clearfix">
                <div class="vd_panel-header">
                    <ul class="breadcrumb">
                        <li><a href="/Home/index">Home</a></li>
                        <li class="active">Uploader</li>
                    </ul>
                    <div class="vd_panel-menu hidden-sm hidden-xs">
                        <div data-action="remove-navbar" class="remove-navbar-button menu">
                            <i class="fa fa-arrows-h"></i>
                        </div>
                        <div data-action="remove-header" class="remove-header-button menu">
                            <i class="fa fa-arrows-v"></i>
                        </div>
                        <div data-action="fullscreen" class="fullscreen-button menu">
                            <i class="glyphicon glyphicon-fullscreen"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="vd_content-section clearfix">
                <div class="container-fluid">
                    <div class="card p-3">
                        <form id="uploadForm" enctype="multipart/form-data" class="mb-4">
                            <div class="form-group">
                                <label><strong>Instructions for Uploading Files:</strong></label>
                                <ul>
                                    <li>Avoid to upload <strong>Redundent</strong> data in table.</li>
                                    <li>Request database adminstrator to <strong>RESEED</strong> primary key before upload data in table.</li>
                                    <li>The file must be in <strong>.csv</strong> format.</li>
                                    <li>Select the relevant <strong>table</strong> name from the dropdown before selecting a file.</li>
                                    <li>The headers in the CSV file must match the table headers in the database schema, and all fields should be included. You can set the primary key as <code>Id = 0</code>.</li>
                                    <li>If a field no value/data keep it empty system automatically set vaule <code>null</code></li>
                                    <li>The date format must follow <strong>dd/mm/yyyy</strong> (e.g., <code>23/01/2025</code>).</li>
                                    <li>If you are adding a reference ID in any table, ensure the relevant parent table is must have that value (e.g., <code>StockCreationId</code> or <code>PhaseId</code>).</li>
                                    <li>
                                        Ensure that the parent table data is uploaded before uploading data for child tables, and the relational ID is mapped correctly. For example:
                                        <ul>
                                            <li><strong>Parent Table:</strong> MeterInstallation</li>
                                            <li><strong>Child Table:</strong> MeterDetail</li>
                                        </ul>
                                        The <code>MeterInstallationId</code> must be mapped before uploading MeterDetail data.
                                    </li>
                                </ul>
                            </div>

                            <div class="form-group">
                                <label for="tableSelect">Select Table</label>
                                <select id="tableSelect" name="tableName" class="form-control">
                                    <option value="" disabled selected>Select a table</option>
                                    <option value="FileLocationAssigment">File Location Assigment</option>
                                    <option value="TransferHistoricalData">Transfer Historical Data</option>
                                    <option value="StockCreation">Stock Creation</option>
                                   @*  <option value="MemberProfile">Meter Profile</option>
                                    <option value="Dealer">Dealer</option>
                                    <option value="DealerEstateDeatail">Dealer Estate Deatail</option>
                                    <option value="DealerWitness">DealerWitness</option>
                                    
                                    <option value="SurrenderHistoricalData">Surrender Historical Data</option>
                                    <option value="TransferHistoricalData">Transfer Historical Data</option>
                                    <option value="RenumberHistoricalData">RenumberHistoricalData</option>
                                    <option value="RRCHistoricalData">Repurchase Refund Cancellation HistoricalData</option>
                                    <option value="NomineesHistoricalData">Nominees Historical Data</option>
                                    <option value="JointMemberHistoricalData">Joint MemberHistorical Data</option>
                                    <option value="COPHistoricalData">COP Historical Data</option>
                                    <option value="MeterInstallation">Meter Installation</option>
                                    <option value="MeterDetail">Meter Detail</option>
                                    <option value="RegistrationNoProfile">RegistrationNo Profile</option>
                                    <option value="SoftLock">SoftLock</option>
                                    <option value="Alerts">Alerts</option> *@
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="fileInput">Choose CSV File</label>
                                <input type="file" id="fileInput" name="file" class="form-control" />
                            </div>
                            <button type="button" id="uploadButton" class="btn btn-primary">Upload</button>
                        </form>
                        <div id="status" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#uploadButton").on("click", function () {
                var formData = new FormData();
                var fileInput = $("#fileInput")[0].files[0];
                var tableName = $("#tableSelect").val();

                if (!fileInput || !tableName) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please select a table and a file.',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });
                    return;
                }

                formData.append("file", fileInput);
                formData.append("tableName", tableName);

                $('#loader').fadeIn();

                $.ajax({
                    type: 'POST',
                    url: `/api/Uploader/UploadCsv`,
                    contentType: false,
                    processData: false,
                    data: formData,
                    headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                    success: function (response) {
                        $('#loader').fadeOut();

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        $("#status").html(`<div class="alert alert-success">${response.message}</div>`);
                    },
                    error: function (xhr) {
                        $('#loader').fadeOut();

                        const errorResponse = xhr.responseJSON || { title: "Error", errors: { general: "An unknown error occurred." } };
                        let errorMessage = errorResponse.title;

                        if (errorResponse.errors) {
                            errorMessage += Object.values(errorResponse.errors)
                                .flat()
                                .map(err => `<li>${err}</li>`)
                                .join('');
                        }

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            html: `<ul>${errorMessage}</ul>`,
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                        $("#status").html(`<div class="alert alert-danger">Error: ${xhr.responseText}</div>`);
                    }
                });
            });
        });
    </script>
}
