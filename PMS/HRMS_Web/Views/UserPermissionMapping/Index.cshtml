<input type="text" class="hide" id="User_Id" value='@Context.Session.GetString("ID")' />
<input type="text" class="hide" id="User_Name" value='@Context.Session.GetString("FullName")' />

@section Scripts {
    <script>
    $(document).ready(function () {
           GetAllPMSUSERS();

            $("#sbbtn").prop('disabled', false);
    });

        $("#User").change(function () {
            var userId = $(this).val();
            GetAllUserPermissions(userId);
            
        });

        function GetAllPMSUSERS() {

            $.ajax({
                type: 'GET',
                url: `/api/Filter/GetAllPMSUSERS`,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    debugger;
                    if (response.code == 100) {

                        $("#User").empty();
                        var row = ' <option value="-1">Select User</option> ';

                        $("#User").append(row);

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {

                            var sr = 1;
                            for (let list of relist) {
                                var row = ' <option value="' + list.id + '" >' + list.emP_FULL_NAME + '</option> ';

                                $("#User").append(row);

                                sr++;
                            }
                            $('#User').select2();
                        }
                    }
                }
            });
        }

        function GetAllUserPermissions(id){

            debugger;

            var url = "/api/UserPermissionMapping/GetUserPermissionAsync?userId=" + id + "";

            $.ajax({
                type: 'GET',
                url: url,
                dataType: "json",
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                async: false,
                contentType: 'application/json',
                success: function (response) {
                    
                    if (response.code == 100) {

                       $("#userPermissiontbody").empty();
                  

                        var relist = response.data;
                        if (relist != null && relist.length > 0) {
                            var sr = 1;
                            
                            for (let list of relist) {

                                var canview = list.canView==true?"checked":"";
                                var canAdd = list.canAdd == true ? "checked" : "";
                                var canEdit = list.canEdit == true ? "checked" : "";
                                var canDelete = list.canDelete == true ? "checked" : "";

                                var row = '<tr>' +
                                    '<td>' + sr + '</td>' +
                                    '<td>' + list.name + '</td>' +
                                    '<td class="hide"> <input class="form-control  formId" value="' + list.id + '" /></td>' +
                                    '<td> <input ' + canview + ' class="checkboxfield isCheckedCanView"  type = "checkbox"   /> </td>' +
                                    '<td> <input '+canAdd+' class="checkboxfield isCheckedCanAdd"  type = "checkbox"   /> </td>' +
                                    '<td> <input '+canEdit+' class="checkboxfield isCheckedCanEdit"  type = "checkbox"   /> </td>' +
                                    '<td> <input '+canDelete+' class="checkboxfield isCheckedCanDelete"  type = "checkbox"  /> </td>' +
                                    '</tr>';
                               $("#userPermissiontbody").append(row);
                                sr++;

                            }
                        }  
                    }
                }
            });
        }


        function PostRequest() {

            var methodType = 'POST';
            var url = "/api/UserPermissionMapping/SaveUserPermissions";

            var userPermissionMappingArr = new Array();

            //if ($("#Id").val()) {

            //    debugger;

            //    meterInstallation.id = parseInt($("#Id").val());
            //    methodType = 'PUT';
            //    url = "/api/MeterInstallation/UpdateMeterInstallation"
            //}


            $('#userPermissiontbody tr').each(function () {

                var row = $(this);
                var userPermissionMapping = new Object();

                var isCheckedCanView = row.find('.isCheckedCanView').is(":checked");
                var isCheckedCanAdd = row.find('.isCheckedCanAdd').is(":checked");
                var isCheckedCanEdit = row.find('.isCheckedCanEdit').is(":checked");
                var isCheckedCanDelete = row.find('.isCheckedCanDelete').is(":checked");
                

                userPermissionMapping.EMP_CODE = $('#User').val();
                userPermissionMapping.CanView = isCheckedCanView;
                userPermissionMapping.CanAdd = isCheckedCanAdd;
                userPermissionMapping.CanEdit = isCheckedCanEdit;
                userPermissionMapping.CanDelete = isCheckedCanDelete;
                userPermissionMapping.PermissionFormsId = row.find('.formId').val();
                userPermissionMapping.CreatedBy = $("#User_Id").val();
                userPermissionMapping.ModifiedBy = $("#User_Id").val();
                userPermissionMapping.LastModifiedUserName = $("#User_Name").val();

                userPermissionMappingArr.push(userPermissionMapping);
            });


            var model = JSON.stringify(userPermissionMappingArr);
            debugger;
            $.ajax({
                type: methodType,
                url: url,
                headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                data: model,
                success: function (response) {

                    if (response.code === 100) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            customClass: 'swal-wide',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload(true);
                            }
                            else if (result.isDenied) {
                                Swal.fire('Changes are not saved', '', 'info')
                            }
                        })
                    }
                }
            });
        }
    </script>
 }

