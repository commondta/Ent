@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Change password";
    bool forced = ViewBag.Forced != null && (bool)ViewBag.Forced;
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>Change password</h1>
        <ol class="breadcrumb"><li><a href="@Url.Action("Index", "Home")">Home</a></li><li class="active">Change password</li></ol>
    </section>
    <section class="content">
        <div class="box" style="max-width:520px">
            <div class="box-body">
                @if (forced) { <div class="alert alert-warning">@Icons.Svg("lock", 13) Your password was set by an administrator. Please choose a new one before continuing.</div> }
                @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
                <form method="post" action="@Url.Action("ChangePassword", "Account")" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="forced" value="@(forced ? "true" : "false")" />
                    <div class="form-group"><label for="currentPassword">Current password</label><input type="password" class="form-control" id="currentPassword" name="currentPassword" required autofocus autocomplete="current-password" /></div>
                    <div class="form-group"><label for="newPassword">New password</label><input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password" /><span class="help-block">At least 8 characters, with letters and digits.</span></div>
                    <div class="form-group"><label for="confirmPassword">Confirm new password</label><input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" /></div>
                    <div style="display:flex;gap:8px;margin-top:18px">
                        <button type="submit" class="btn btn-primary">Change password</button>
                        @if (!forced) { <a href="@Url.Action("Profile")" class="btn btn-default">Cancel</a> }
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
