@using Payroll_HCC.Infrastructure
@{
    Layout = null;
    string error = TempData["LoginError"] as string;
    string info = TempData["LoginInfo"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · @Payroll_HCC.Infrastructure.App.ProductName</title>
    <link rel="icon" type="image/svg+xml" href="~/Content/brand/favicon.svg?v=20260828c">
    <link rel="shortcut icon" href="~/favicon.ico?v=20260828c">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/Content/login.css?v=20260826g">
</head>
<body>
    <main class="login-page">
        <section class="login-brand" aria-hidden="true">
            <div class="login-brand-inner">
                @Html.Partial("_BrandMark", "light")
                <h1>Payroll Management</h1>
                <p>Employees, compensation, attendance, leave, loans and payroll processing — one secure workspace.</p>
                <ul>
                    <li>Role-based access with server-side enforcement</li>
                    <li>Approval workflow for payroll runs and user accounts</li>
                    <li>Complete activity trail</li>
                </ul>
            </div>
            <div class="login-brand-foot">&copy; @DateTime.Now.Year N-Stack</div>
        </section>
        <section class="login-panel">
            <form method="post" action="@Url.Action("Login", "Account")" class="login-form" autocomplete="off" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="login-mobile-brand">@Html.Partial("_BrandMark", "dark") <b>Payroll Management</b></div>
                <h2>Sign in</h2>
                <p class="login-sub">Use your Payroll Management account.</p>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="login-alert error" role="alert">@error</div>
                }
                else if (!string.IsNullOrEmpty(info))
                {
                    <div class="login-alert info" role="status">@info</div>
                }

                <label for="username">Username</label>
                <input type="text" id="username" name="Username" required autofocus autocapitalize="off" spellcheck="false" />

                <label for="passwd">Password</label>
                <div class="pwd-wrap">
                    <input type="password" id="passwd" name="Passwd" required />
                    <button type="button" class="pwd-eye" aria-label="Show password" onclick="var p=document.getElementById('passwd');p.type=p.type==='password'?'text':'password';this.classList.toggle('on')">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                    </button>
                </div>

                <button type="submit" class="login-btn">Sign in</button>
                <p class="login-foot">Forgot your password? Ask an administrator to reset it.</p>
            </form>
        </section>
    </main>
</body>
</html>
