@using Payroll_HCC.Infrastructure
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Access required · Payroll Management</title>
    <link rel="icon" type="image/svg+xml" href="~/Content/brand/favicon.svg?v=20260828c">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/Content/login.css">
</head>
<body>
    <main class="login-page" style="grid-template-columns:1fr">
        <section class="login-panel">
            <div class="login-form" style="text-align:center">
                <div class="login-mobile-brand" style="display:flex;justify-content:center">@Html.Partial("_BrandMark", "dark") <b>Payroll Management</b></div>
                <h2>Access required</h2>
                <p class="login-sub">Your ERP account is signed in, but it is not entitled to <b>Payroll Management</b>. Ask an ERP administrator to grant the <i>Payroll User</i> role.</p>
                <a class="login-btn" style="display:block;line-height:42px;text-decoration:none" href="@ErpSso.AppsUrl">Back to Applications Library</a>
            </div>
        </section>
    </main>
</body>
</html>
