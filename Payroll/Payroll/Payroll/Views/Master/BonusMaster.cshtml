@{
    ViewBag.Title = "Bonus Setup";
}

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Bonus Setup</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Compensation &amp; Payroll Setup</li>
            <li class="active">Bonus Setup</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Bonus Setup</h3>
                <button type="submit" class="btn btn-primary" onclick="save()">Save</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <div class="col-sm-4">
                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="year" class="col-sm-3 control-label">Year</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="year">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="branch" class="col-sm-3 control-label">Branch</label>
                                <div class="col-sm-8">
                                    <select id="branch" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row" style="padding: 0 20px;">
                    <table id="bonus-master-dataTable" class="table table-responsive table-bordered" style="margin-top:2%; width: 100%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>From Year</th>
                                <th>To Year</th>
                                <th>Percentages</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td><input type="text" /></td>
                                <td><input type="text" /></td>
                                <td><input type="text" /></td>
                                <td><input type="text" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>