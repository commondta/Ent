
@{
    ViewBag.Title = "Companies";
}

<!-- Add Modal -->
<div id="add-company-modal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">New Company</h4>
            </div>
            <div class="modal-body">
                <form id="company-form">

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="company-name" class="col-sm-4 control-label">Company Name</label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" id="company-name" name="CompanyName"  autofocus required>
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="tax-no" class="col-sm-4 control-label">Tax #</label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="TaxNo" id="tax-no">
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="esi-no" class="col-sm-4 control-label">ESI #</label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="ESINo" id="esi-no">
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="annual-days" class="col-sm-4 control-label">Annual Days</label>
                            <div class="col-sm-6">
                                <input type="number" class="form-control" name="AnnualDays" id="annual-days">
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="address" class="col-sm-4 control-label">Address</label>
                            <div class="col-sm-6">
                                <textarea class="form-control" id="address" name="Address" rows="3" placeholder="Enter here..."></textarea>
                            </div>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="CompanyCreate()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Companies</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Employee Management</li>
            <li class="active">Companies</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Companies</h3>
                <div id="table-buttons">
                    <button type="button" class="btn" data-toggle="tooltip" title="Switch" onclick="CompanySwitch()">
                        <i class="fa fa-refresh"></i>
                        <div class="ripple-container">
                        </div>
                    </button>
                    <button type="button" class="btn" data-toggle="tooltip" title="Delete" onclick="CompanyDelete()">
                        <i class="fa fa-trash-o"></i>
                        <div class="ripple-container">
                        </div>
                    </button>
                </div>
                <button type="button" class="btn" data-toggle="tooltip" title="New" onclick="$('#add-company-modal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body">
                <table id="company-table" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Company Name</th>
                            <th>Tax #</th>
                            <th>ESI #</th>
                            <th>Annual Days</th>
                            <th>Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.Company)
                        {
                            <tr>
                                <td>@item.id</td>
                                <td>@item.CompanyName</td>
                                <td>@item.TaxNo</td>
                                <td>@item.ESINo</td>
                                <td>@item.AnnualDays</td>
                                <td>@item.Address</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <div id="snackbar"></div>
</div>