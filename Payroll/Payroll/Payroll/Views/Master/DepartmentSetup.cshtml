@using DataLayer
@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Departments";
    bool canCreate = Payroll_HCC.Infrastructure.App.Can("Employees.Departments", PermissionAction.Create);
    bool canEdit = Payroll_HCC.Infrastructure.App.Can("Employees.Departments", PermissionAction.Edit);
    bool canDelete = Payroll_HCC.Infrastructure.App.Can("Employees.Departments", PermissionAction.Delete);
}

<!-- Add / edit department -->
<div id="deptModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:460px;max-width:92vw">
        <div class="modal-content">
            <form id="deptForm" onsubmit="return saveDept(event)">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title" id="deptModalTitle">New department</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="d_id" value="0" />
                    <div class="form-group"><label for="d_name">Department name</label><input type="text" class="form-control" id="d_name" maxlength="100" required autocomplete="off" /></div>
                    <div class="form-group"><label for="d_desc">Description</label><input type="text" class="form-control" id="d_desc" maxlength="250" autocomplete="off" /></div>
                    <div class="alert alert-danger" id="d_error" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="d_save">Save department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import from Excel (secondary) -->
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:460px;max-width:92vw">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Import departments from Excel</h4>
            </div>
            <div class="modal-body">
                <p class="text-muted" style="margin-bottom:10px">Two columns: <b>Department</b>, <b>Description</b> (first row is the header). Existing departments are replaced by the file contents.</p>
                <input type="file" id="file" accept=".xls,.xlsx,.csv" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="UploadfileDept()">Import</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">
    <section class="content-header">
        <h1>Departments</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Employee Management</li>
            <li class="active">Departments</li>
        </ol>
    </section>

    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Departments <span class="tag">@(((List<DepartmentSetupModel>)ViewBag.DepartmentDetail).Count)</span></h3>
                <div>
                    @if (canCreate) { <button type="button" class="btn btn-default" onclick="$('#myModal').modal('show');">Import Excel</button> }
                    @if (canCreate) { <button type="button" class="btn btn-primary" onclick="openDept(null)">@Icons.Svg("plus", 14) New department</button> }
                </div>
            </div>
            <div class="box-body">
                <div class="table-responsive">
                    <table id="department-table" class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:60px">#</th>
                                <th>Department</th>
                                <th>Description</th>
                                <th style="width:90px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DepartmentSetupModel item in ViewBag.DepartmentDetail)
                            {
                                <tr data-id="@item.id" data-name="@item.DepartmentName" data-desc="@item.Description">
                                    <td>@item.id</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.Description</td>
                                    <td class="text-right" style="white-space:nowrap">
                                        @if (canEdit) { <button type="button" class="btn btn-icon" title="Edit" onclick="openDept(this)">@Icons.Svg("pencil", 14)</button> }
                                        @if (canDelete) { <button type="button" class="btn btn-icon danger" title="Delete" onclick="deleteDept(this)">@Icons.Svg("trash", 14)</button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts {
<script>
    $(function () {
        $('#department-table').DataTable({ order: [[1, 'asc']], columnDefs: [{ orderable: false, targets: 3 }], pageLength: 25, language: { search: '', searchPlaceholder: 'Filter departments…', emptyTable: 'No departments yet — add one or import from Excel.' } });
    });
    function openDept(btn) {
        var $tr = btn ? $(btn).closest('tr') : null;
        $('#d_error').hide();
        $('#d_id').val($tr ? $tr.data('id') : 0);
        $('#d_name').val($tr ? $tr.data('name') : '');
        $('#d_desc').val($tr ? $tr.data('desc') : '');
        $('#deptModalTitle').text($tr ? 'Edit department' : 'New department');
        $('#deptModal').modal('show');
        setTimeout(function () { $('#d_name').focus(); }, 300);
    }
    function saveDept(e) {
        e.preventDefault();
        $('#d_save').prop('disabled', true);
        ERP.post('@Url.Action("DepartmentSave", "Master")', { id: $('#d_id').val(), DepartmentName: $('#d_name').val(), Description: $('#d_desc').val() }, function (r) {
            $('#d_save').prop('disabled', false);
            if (!r.ok) { $('#d_error').text(r.message).show(); return; }
            $('#deptModal').modal('hide'); ERP.toast(r.message); setTimeout(function () { location.reload(); }, 500);
        }, function (m) { $('#d_save').prop('disabled', false); $('#d_error').text(m).show(); });
        return false;
    }
    function deleteDept(btn) {
        var $tr = $(btn).closest('tr');
        ERP.confirm({ title: 'Delete department "' + $tr.data('name') + '"?', text: 'Employees assigned to it keep their department text; the entry is removed from this list.', ok: 'Delete', danger: true }, function () {
            ERP.post('@Url.Action("DepartmentDelete", "Master")', { id: $tr.data('id') }, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); if (r.ok) setTimeout(function () { location.reload(); }, 500); });
        });
    }
    function UploadfileDept() {
        var files = $("#file").get(0).files;
        if (!files.length) { ERP.toast('Choose a file first.', 'err'); return; }
        var data = new FormData();
        data.append("File", files[0]);
        data.append("__RequestVerificationToken", ERP.token());
        $.ajax({ type: "POST", url: "@Url.Action("UploadFile", "Master")", data: data, contentType: false, processData: false })
            .done(function (response) { $('#myModal').modal('hide'); ERP.toast(String(response)); setTimeout(function () { location.reload(); }, 600); })
            .fail(function () { ERP.toast('Import failed.', 'err'); });
    }
</script>
}
