@using DataLayer
@{
    ViewBag.Title = "Employee Categories";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Employee Categories</h4>
            </div>
            <div class="modal-body">
                <form action="/" method="post" id="employee-category-master-form">

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="EmployeeCategoryCode" class="col-sm-4 control-label">Employee Category Code</label>
                            <div class="col-sm-6">
                                <select class="form-control" name="EmployeeCategoryCode" id="EmployeeCategoryCode" autofocus required>
                                    <option selected="selected" value="Permanent">Permanent</option>
                                    <option value="Temporary">Temporary</option>
                                    <option value="Contract">Contract</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="EmployeeCategoryName" class="col-sm-4 control-label">Employee Category Name</label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="EmployeeCategoryName" id="EmployeeCategoryName">
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="AccountCode" class="col-sm-4 control-label">Account Code</label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="AccountCode" id="AccountCode">

                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="Remarks" class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="Remarks" id="Remarks">
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="EmployeeCategoryMasterAdd()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Employee Categories</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Employee Management</li>
            <li class="active">Employee Categories</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Employee Categories</h3>
                <div id="table-buttons">
                    @*<button type="button" class="btn" data-toggle="tooltip" title="Update" onclick="">
                        <i class="fa fa-edit"></i>
                        <div class="ripple-container">
                        </div>
                    </button>*@
                    <button type="button" class="btn" data-toggle="tooltip" title="Delete" onclick="EmpCategMasterDelete()">
                        <i class="fa fa-trash-o"></i>
                        <div class="ripple-container">
                        </div>
                    </button>
                </div>
                <button type="button" class="btn" data-toggle="tooltip" title="New" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body" style="padding-top: unset;">
                @*<div id="table-buttons"><button type="button" class="btn btn-default" onclick="EmpCategMasterDelete()">Delete<div class="ripple-container"></div></button></div>*@
                <table id="employee-category-master-table" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Employee Category Code</th>
                            <th>Employee Category Name</th>
                            <th>Account Code</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="show" class="select">
                        @foreach (var empCategMaster in ViewData["EmployeeCategoryMaster"] as IList<EmployeeCategoryMasterModel>)
                        {
                            <tr>
                                <td>@empCategMaster.id</td>
                                <td>@empCategMaster.EmployeeCategoryCode</td>
                                <td>@empCategMaster.EmployeeCategoryName</td>
                                <td>@empCategMaster.AccountCode</td>
                                <td>@empCategMaster.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <div id="snackbar"></div>
</div>


