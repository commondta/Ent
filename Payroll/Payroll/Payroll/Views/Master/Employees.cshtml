                                        <th class="grey-cell">Leave Code</th>
                                        <th class="grey-cell">Leave Name</th>
                                        <th class="grey-cell">Leave Type</th>
                                        <th class="grey-cell">Total Leaves in Year</th>
                                        <th class="grey-cell">Bal. Leave Last Year</th>
                                        <th class="grey-cell">Min Balance for Encashment</th>
                                        <th class="grey-cell">Max Leave to Encashment</th>
                                        <th class="grey-cell">Carry Forward to Next Year</th>
                                        <th class="grey-cell">Max Monthly Applicable</th>
                                        <th class="grey-cell">Min Continuous</th>
                                        <th class="grey-cell">Max Continuous</th>
                                        <th class="grey-cell">Encashable</th>
