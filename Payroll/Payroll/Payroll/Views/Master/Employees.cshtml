                            </table>
                        </div>
                        <!-- /.tab-pane -->
                    </div>
                    <!-- /.tab-content -->
                </div>
            </div>

            <div class="modal-footer" id="add-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="EmployeeCreate()">ADD</button>
            </div>
            <div class="modal-footer hidden" id="update-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="EmployeeUpdate()">Update</button>
            </div>
        </div>
    </div>
</div>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Employee Profiles</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Employee Management</li>
            <li class="active">Employee Profiles</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">Employee Profiles</h3>
                        <div id="table-buttons">
                            <button type="button" class="btn" data-toggle="tooltip" title="Edit" onclick="EmployeesUpdateModal()">
                                <i class="fa fa-pencil"></i>
                                <div class="ripple-container">
                                </div>
                            </button>
                            <button type="button" class="btn" data-toggle="tooltip" title="Delete" onclick="TableDelete('emp-dataTable', 'EmployeesDelete')">
                                <i class="fa fa-trash-o"></i>
                                <div class="ripple-container">
                                </div>
                            </button>
                        </div>
                        <button type="button" class="btn" data-toggle="tooltip" title="New" id="new-btn">
                            <i class="fa fa-plus"></i>
                            <div class="ripple-container">
                            </div>
                        </button>
                    </div>



                    <!-- /.box-header -->
                    <div class="box-body">
                        <table id="emp-dataTable" class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Payroll Name</th>
                                    <th>Job Title</th>
                                    <th>Gender</th>
                                    <th>Company Start Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (EmployeeDetailModel employeeObj in ViewBag.Employees)
                                {
                                    <tr data-id="@employeeObj.id">
                                        <td>@employeeObj.PayrollName</td>
                                        <td>@employeeObj.JobTitlePosition</td>
                                        <td>@employeeObj.Gender</td>
                                        <td>@employeeObj.CompanyStartDate.ToString("dd-MM-yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    <!-- /.content -->
    <div id="snackbar"></div>
</div>
<!-- /.content-wrapper -->