                                            <td><input type="checkbox" name="OT" /></td>
                                            <td><input type="checkbox" name="Tax" /></td>
                                        </tr>
                                        @*@for (int i = 0; i < 9; i++)
                                    {
                                        <tr>
                                            <td class="grey-cell"><input type="text" name="id" readonly /></td>
                                            <td><input type="text" name="code"></td>
                                            <td class="grey-cell"><input type="text" name="Name" readonly /></td>
                                            <td class="grey-cell"><input type="text" name="EffectiveDate" readonly /></td>
                                            <td class="grey-cell"><input type="text" name="Type" readonly /></td>
                                            <td><input type="text" name="Amount" /></td>
                                            <td><input type="text" name="OT" /></td>
                                            <td><input type="text" name="Tax" /></td>
                                        </tr>
                                    }*@
                                    </tbody>
                                </table>
                            </form>
                        </div>
                        <!-- /.tab-pane -->
                        <div class="tab-pane" id="tab_leave-details">
                            <table id="emp-leave-dataTable" class="table table-bordered">
