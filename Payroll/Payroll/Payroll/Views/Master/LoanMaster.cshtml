
@{
    ViewBag.Title = "Loan Setup";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Loan Setup</h4>
            </div>
            <div class="modal-body">

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="code" class="col-sm-3 control-label">Code <span class="red-text">*</span></label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" id="code" autofocus required>
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="descrition" class="col-sm-3 control-label">Description <span class="red-text">*</span></label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" id="descrition" required>
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="loan-type" class="col-sm-3 control-label">Loan Type</label>
                        <div class="col-sm-5">
                            <select id="loan-type" class="form-control">
                                <option selected="selected">this</option>
                                <option>that</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="max-amount" class="col-sm-3 control-label">Max Amount</label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" id="max-amount">
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="rate-of-interest" class="col-sm-3 control-label">Rate of Interest</label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" id="rate-of-interest">
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="min-repayment-amount" class="col-sm-3 control-label">Min. Repayment Amount</label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" id="min-repayment-amount">
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="max-no-of-installments" class="col-sm-3 control-label">Max. No. of Installments</label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" id="max-no-of-installments">
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="remarks" class="col-sm-3 control-label">Remarks</label>
                        <div class="col-sm-9">
                            <textarea class="form-control" id="remarks" rows="3" placeholder="Enter..."></textarea>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer" style="margin-left:4%">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="save()">ADD</button>
            </div>
        </div>
    </div>
</div>

<!-- edit Modal -->
<div id="myModal2" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">EDIT Loan Master</h4>
            </div>
            <div class="modal-body" style="border:solid 1px; margin:3%;">
                <div class="row topSectionMargin">
                    <div class="col-md-12">
                        <div class="row topMargin">
                            <div class="col-md-12">
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black;font-size:small;">Code *</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="hidden" id="eid" />
                                        <input type="text" id="ecode" style="border-radius:3%;" autofocus>
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black;font-size:small;">Description *</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" id="edescrition" style="border-radius:3%;">
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black;font-size:small;">Loan Type</label>
                                    </div>
                                    <div class="col-md-8">
                                        <select id="eloantype" style="width:160px; border-radius:3%;">
                                            <option>Personal</option>
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black;font-size:small;">Max amount</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" id="emaxamount" style="border-radius:3%;">
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black;font-size:small;">Rate of Interest</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" id="erateofinterest" style="border-radius:3%;">
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black; font-size:small;">Min Repayment Amount</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" id="eminrepaymentamount" style="border-radius:3%;">
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black; font-size:small;">Max. No. of Installments</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" id="einstallment" style="border-radius:3%;">
                                    </div>
                                </div>
                                <div class="row topMargin">
                                    <div class="col-md-4" style="border-bottom:solid 0.1px;">
                                        <label style="color:black;font-size:small;">Remarks</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea rows="3" cols="45" id="eremarks" style="border-radius:3%;"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="margin-left:4%">
                <button type="submit" class="btn btn-primary" onclick="update()" style="float:left; border:solid 1px;">Update</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal" style="float:left;border:solid 1px;">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Loan Setup</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Leave &amp; Benefits Setup</li>
            <li class="active">Loan Setup</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Loan Setup</h3>
                <button type="button" class="btn" data-toggle="tooltip" title="Add Criteria" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body">
                <table id="myTable" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Code</th>
                            <th>Description</th>
                            <th>Loan Type</th>
                            <th>Max amount</th>
                            <th>Rate of Interest</th>
                            <th>Min. Repayment Amount</th>
                            <th>Max. No. of Installments</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@*Script part*@
<script>
    let Global_Array = new Array();
    //show data
    $(document).ready(function () {
        view();
    });

    function view() {
        $.ajax({
            type: "get",
            url: "@Url.Action("list", "loanMaster")",
            success: function (result) {
                if (result != "error") {
                    Global_Array = result;
                    $("td").remove();
                    for (let i = 0; i < result.length; i++) {
                        var tab = $('<tr />');
                        tab.append("<td>" + result[i].id + "</td>", "<td>" + result[i].code + "</td>", "<td>" + result[i].description + "</td>", "<td>" + result[i].loantype + "</td>", "<td>" + result[i].maxAmount + "</td>", "<td>" + result[i].rateOfInterest + "</td>", "<td>" + result[i].minRepayment + "</td>", "<td>" + result[i].maxInstallment + "</td>", "<td>" + result[i].remarks + "</td>", "<td >" + "<a onclick='Edit(" + result[i].id + ")'>Edit</a> | <a onclick='del(" + result[i].id + ")'>DELETE</a>" + "</td>");
                        $('#myTable').append(tab);
                    }
                }
            }
        });
    }
    //add Data
    function Add() {
        $('#myModal').modal('show');
    }
    function save() {
        let c = $("#code").val();
        let des = $("#descrition").val();
        let lt = $("#loantype").val();
        let ma = $("#maxamount").val();
        let roi = $("#rateofinterest").val();
        let mra = $("#minrepaymentamount").val();
        let ins = $("#installment").val();
        let r = $("#remarks").val();
        $.ajax({
            type: "post",
            url: "@Url.Action("Add", "loanMaster")",
            data: {
                c: c,
                des: des,
                lt: lt,
                ma: ma,
                roi: roi,
                mra: mra,
                ins: ins,
                r: r
            },
            success: function (result) {
                $('#myModal').modal('hide');
                if (result != "error") {
                    $("td").remove();
                    for (let i = 0; i < result.length; i++) {
                        var tab = $('<tr />');
                        tab.append("<td>" + result[i].id + "</td>", "<td>" + result[i].code + "</td>", "<td>" + result[i].description + "</td>", "<td>" + result[i].loantype + "</td>", "<td>" + result[i].maxAmount + "</td>", "<td>" + result[i].rateOfInterest + "</td>", "<td>" + result[i].minRepayment + "</td>", "<td>" + result[i].maxInstallment + "</td>", "<td>" + result[i].remarks + "</td>", "<td >" + "<a onclick='Edit(" + result[i].id + ")'>Edit</a> | <a onclick='del(" + result[i].id + ")'>DELETE</a>" + "</td>");
                        $('#myTable').append(tab);
                    }
                }
            }
        });
    }

    //Edit data
    function Edit(idRow) {
        for (let i = 0; i < Global_Array.length; i++) {
            if (Global_Array[i].id == idRow) {
                $('#myModal2').modal('show');
                $("#eid").val(idRow);
                $('#ecode').val(Global_Array[i].code);
                $('#edescrition').val(Global_Array[i].description);
                $('#eloantype').val(Global_Array[i].loantype);
                $('#emaxamount').val(Global_Array[i].maxAmount);
                $('#erateofinterest').val(Global_Array[i].rateOfInterest);
                $('#eminrepaymentamount').val(Global_Array[i].minRepayment);
                $('#einstallment').val(Global_Array[i].maxInstallment);
                $('#eremarks').val(Global_Array[i].remarks);
            }
        }
    }
    function update() {
        let id = $("#eid").val();
        let c = $("#ecode").val();
        let des = $("#edescrition").val();
        let lt = $("#eloantype").val();
        let ma = $("#emaxamount").val();
        let roi = $("#erateofinterest").val();
        let mra = $("#eminrepaymentamount").val();
        let ins = $("#einstallment").val();
        let r = $("#eremarks").val();
        $.ajax({
            type: "post",
            url: "@Url.Action("Edit", "loanMaster")",
            data: {
                id: id,
                c: c,
                des: des,
                lt: lt,
                ma: ma,
                roi: roi,
                mra: mra,
                ins: ins,
                r: r
            },
            success: function (result) {
                $('#myModal2').modal('hide');
                if (result != "error") {
                    $("td").remove();
                    for (let i = 0; i < result.length; i++) {
                        var tab = $('<tr />');
                        tab.append("<td>" + result[i].id + "</td>", "<td>" + result[i].code + "</td>", "<td>" + result[i].description + "</td>", "<td>" + result[i].loantype + "</td>", "<td>" + result[i].maxAmount + "</td>", "<td>" + result[i].rateOfInterest + "</td>", "<td>" + result[i].minRepayment + "</td>", "<td>" + result[i].maxInstallment + "</td>", "<td>" + result[i].remarks + "</td>", "<td >" + "<a onclick='Edit(" + result[i].id + ")'>Edit</a> | <a onclick='del(" + result[i].id + ")'>DELETE</a>" + "</td>");
                        $('#myTable').append(tab);
                    }
                }
            }
        });
    }

    // Delete data
    function del(idrow) {
        var id = idrow
        $.ajax({
            type: "post",
            url: "@Url.Action("Delete", "loanMaster")",
            data: {
                id: id,
            },
            success: function (result) {
                if (result != "error") {
                    $("td").remove();
                    for (let i = 0; i < result.length; i++) {
                        var tab = $('<tr />');
                        tab.append("<td>" + result[i].id + "</td>", "<td>" + result[i].code + "</td>", "<td>" + result[i].description + "</td>", "<td>" + result[i].loantype + "</td>", "<td>" + result[i].maxAmount + "</td>", "<td>" + result[i].rateOfInterest + "</td>", "<td>" + result[i].minRepayment + "</td>", "<td>" + result[i].maxInstallment + "</td>", "<td>" + result[i].remarks + "</td>", "<td >" + "<a onclick='Edit(" + result[i].id + ")'>Edit</a> | <a onclick='del(" + result[i].id + ")'>DELETE</a>" + "</td>");
                        $('#myTable').append(tab);
                    }
                }
            }
        });
    }
</script>
