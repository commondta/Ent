
@{
    ViewBag.Title = "Overtime Rules";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Overtime Rules</h4>
            </div>
            <div class="modal-body">
                <div class="row topMargin">
                    <div class="form-group">
                        <label for="code" class="col-sm-3 control-label">Code</label>
                        <div class="col-sm-6">
                            <input type="number" class="form-control" id="code" autofocus>
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="type" class="col-sm-3 control-label">Type</label>
                        <div class="col-sm-6">
                            <select id="type" class="form-control">
                                <option selected="selected">this</option>
                                <option>that</option>
                                <option>other</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="max-ot-hours" class="col-sm-3 control-label">Max OT Hours</label>
                        <div class="col-sm-6">
                            <input type="number" class="form-control" id="max-ot-hours">
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="min-ot-hours" class="col-sm-3 control-label">Min OT Hours</label>
                        <div class="col-sm-6">
                            <input type="number" class="form-control" id="min-ot-hours">
                        </div>
                    </div>
                </div>

                <div class="row topMargin">
                    <div class="form-group">
                        <label for="factors" class="col-sm-3 control-label">Factors</label>
                        <div class="col-sm-6">
                            <input type="number" class="form-control" id="factors">
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Overtime Rules</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Leave &amp; Benefits Setup</li>
            <li class="active">Overtime Rules</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Overtime Rules</h3>
                <button type="button" class="btn" data-toggle="tooltip" title="Add Criteria" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body">
                <table id="myTable" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Max OT Hours</th>
                            <th>Min OT Hours</th>
                            <th>Factors</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>