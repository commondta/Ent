@using DataLayer;
@{
    ViewBag.Title = "Pay Elements";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Pay Elements</h4>
            </div>
            <div class="modal-body">
                <form action="/" method="post" id="pay-element-form">

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="pay-element-code" class="col-sm-4 control-label">Pay Element Code <span class="red-text">*</span></label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="PayElementCode" id="pay-element-code" autofocus required>
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="description" class="col-sm-4 control-label">Description <span class="red-text">*</span></label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" name="Description" id="description" required>
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="type" class="col-sm-4 control-label">Type</label>
                            <div class="col-sm-6">
                                <select id="type" class="form-control" name="Type">
                                    <option selected="selected" value="static">Static</option>
                                    <option value="percentage">Percentage</option>
                                    <option value="one time">One Time</option>
                                    <option value="recurring">Recurring</option>
                                    <option value="benefit in kind">Benefit in Kind</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="pay-element-type" class="col-sm-4 control-label">Pay Element Type</label>
                            <div class="col-sm-6">
                                <select id="pay-element-type" class="form-control" name="PayElementType">
                                    <option selected="selected">Addition</option>
                                    <option>Deduction</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="amount" class="col-sm-4 control-label">Amount</label>
                            <div class="col-sm-6">
                                <input type="number" class="form-control" name="Amount" id="amount">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group">
                            <label for="document-date" class="col-sm-4 control-label">Effective Date</label>
                            <div class="col-sm-6">
                                <input type="date" class="form-control" id="effective-date" name="EffectiveDate">
                            </div>
                        </div>
                    </div>

                    <div class="row topMargin">
                        <div class="form-group">
                            <label for="pay-element-type" class="col-sm-4 control-label">Taxable</label>
                            <div class="col-sm-6">
                                <select id="pay-element-type" name="Taxable" class="form-control">
                                    <option selected="selected">No</option>
                                    <option>Yes</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="payElementAdd()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Pay Elements</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Compensation &amp; Payroll Setup</li>
            <li class="active">Pay Elements</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Pay Elements</h3>
                <div id="table-buttons">
                    @*<button type="button" class="btn" data-toggle="tooltip" title="Update" onclick="EmployeesUpdateModal()">
                        <i class="fa fa-edit"></i>
                        <div class="ripple-container">
                        </div>
                    </button>*@
                    <button type="button" class="btn" data-toggle="tooltip" title="Delete" onclick="PayElementsDelete()">
                        <i class="fa fa-trash-o"></i>
                        <div class="ripple-container">
                        </div>
                    </button>
                </div>
                <button type="button" class="btn" data-toggle="tooltip" title="New" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body" style="padding-top: unset;">
                <table id="pay-elements-table" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Pay Element Code</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Pay Element Type</th>
                            <th>Amount</th>
                            <th>Effective Date</th>
                            <th>Taxable</th>
                            
                        </tr>
                    </thead>
                    <tbody class="select">
                        @foreach (PayElementsModel PayElementObj in ViewBag.PayElements)
                        {
                            <tr>
                                <td>@PayElementObj.id</td>
                                <td>@PayElementObj.PayElementCode</td>
                                <td>@PayElementObj.Description</td>
                                <td>@PayElementObj.Type</td>
                                <td>@PayElementObj.PayElementType</td>
                                <td>@PayElementObj.Amount</td>
                                <td>@PayElementObj.EffectiveDate.ToString("yyyy-MM-dd")</td>
                                <td>@PayElementObj.Taxable</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <div id="snackbar"></div>
</div>
