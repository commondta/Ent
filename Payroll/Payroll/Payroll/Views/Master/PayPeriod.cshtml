@using DataLayer
@{
    ViewBag.Title = "Payroll Periods";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Payroll Periods</h4>
            </div>
            <div class="modal-body">
                <div class="content">
                    <form id="pay-period-form">
                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="project-site" class="col-sm-4 control-label">Location / Project Site</label>
                                <div class="col-sm-6">
                                    <select id="project-site" class="form-control" name="LocationProjectSite">
                                        <option selected="selected">Site 1</option>
                                        <option>Site 2</option>
                                        <option>Site 3</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="pay-period-code-month" class="col-sm-4 control-label">Pay Period Code / Month <span class="red-text">*</span></label>
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="pay-period-code-month" name="PayPeriodCodeMonth">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="name" class="col-sm-4 control-label">Name <span class="red-text">*</span></label>
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="name" name="Name">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="from-date" class="col-sm-4 control-label">From Date <span class="red-text">*</span></label>
                                <div class="col-sm-6">
                                    <input type="date" class="form-control" id="from-date" name="FromDate">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="to-date" class="col-sm-4 control-label">To Date <span class="red-text">*</span></label>
                                <div class="col-sm-6">
                                    <input type="date" class="form-control" id="to-date" name="ToDate">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="pay-month" class="col-sm-4 control-label">Pay Month</label>
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="pay-month" name="PayMonth">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="no-of-working-days" class="col-sm-4 control-label">No. of working Days</label>
                                <div class="col-sm-6">
                                    <input type="number" class="form-control" id="no-of-working-days" name="NoOfWorkingDays">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="no-of-fridays" class="col-sm-4 control-label">No. of Fridays</label>
                                <div class="col-sm-6">
                                    <input type="number" class="form-control" id="no-of-fridays" name="NoOfFridays">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="no-of-holidays" class="col-sm-4 control-label">No. of Holidays</label>
                                <div class="col-sm-6">
                                    <input type="number" class="form-control" id="no-of-holidays" name="NoOfHolidays">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="max-normal-ot-hours-month" class="col-sm-4 control-label">Maximum Normal OT Hours / Month</label>
                                <div class="col-sm-6">
                                    <input type="number" class="form-control" id="max-normal-ot-hours-month" name="MaximumNormalOTHoursMonth">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="max-working-hours" class="col-sm-4 control-label">Maximum Working Hours/ Month</label>
                                <div class="col-sm-6">
                                    <input type="number" class="form-control" id="max-working-hours" name="MaximumWorkingHoursMonth">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="remarks" class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-6">
                                    <textarea class="form-control" id="remarks" name="Remarks" rows="3" placeholder="Enter..."></textarea>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" onclick="PayPeriodCreate()">Add</button>
                </div>
            </div>
        </div>
    </div>
</div>

