<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Payroll Periods</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Compensation &amp; Payroll Setup</li>
            <li class="active">Payroll Periods</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Payroll Periods</h3>
                <div id="table-buttons">
                    <button type="button" class="btn" data-toggle="tooltip" title="Update" onclick="PayPeriodUpdateModal()">
                        <i class="fa fa-pencil"></i>
                        <div class="ripple-container">
                        </div>
                    </button>
                    <button type="button" class="btn" data-toggle="tooltip" title="Delete" onclick="PayPeriodDelete()">
                        <i class="fa fa-trash-o"></i>
                        <div class="ripple-container">
                        </div>
                    </button>
                </div>
                <button type="button" class="btn" data-toggle="tooltip" title="New" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body" style="padding-top: unset;">
                <table id="pay-period-table" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Location / Project Site</th>
                            <th>Pay Period Code / Month</th>
                            <th>Name</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th>Pay Month</th>
                            <th>No of working Days</th>
                            <th>No of Fridays</</th>
                            <th>No of Holidays</</th>
                            <th>Maximum Normal OT Hours / Month</th>
                            <th>Maximum Working Hours / Month</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody class="select">
                        @foreach (var payPeriod in ViewData["PayPeriod"] as IList<PayPeriodModel>)
                        {
                            <tr>
                                <td>@payPeriod.id</td>
                                <td>@payPeriod.LocationProjectSite</td>
                                <td>@payPeriod.PayPeriodCodeMonth</td>
                                <td>@payPeriod.Name</td>
                                <td>@payPeriod.FromDate.ToString("yyyy-MM-dd")</td>
                                <td>@payPeriod.ToDate.ToString("yyyy-MM-dd")</td>
                                <td>@payPeriod.PayMonth</td>
                                <td>@payPeriod.NoOfWorkingDays</td>
                                <td>@payPeriod.NoOfFridays</td>
                                <td>@payPeriod.NoOfHolidays</td>
                                <td>@payPeriod.MaximumNormalOTHoursMonth</td>
                                <td>@payPeriod.MaximumWorkingHoursMonth</td>
                                <td>@payPeriod.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <div id="snackbar"></div>
</div>

