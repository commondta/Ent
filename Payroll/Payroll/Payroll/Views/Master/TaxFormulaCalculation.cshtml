
@{
    ViewBag.Title = "Payroll Tax Rules";
}

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Payroll Tax Rules</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Compensation &amp; Payroll Setup</li>
            <li class="active">Payroll Tax Rules</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Payroll Tax Rules</h3>
                <div class="doc-nav" id="nav-tax-formula-calc">
                    <button class="btn btn-default" title="First"><i class="fa fa-angle-double-left"></i></button>
                    <button class="btn btn-default" title="Previous"><i class="fa fa-arrow-left"></i></button>
                    <button class="btn btn-default" title="Next"><i class="fa fa-arrow-right"></i></button>
                    <button class="btn btn-default" title="Last"><i class="fa fa-angle-double-right"></i></button>
                </div>
                
                @*<button type="button" class="btn" data-toggle="tooltip" title="Delete" id="delete-btn" onclick="TaxFormulaCalcDelete();">
                    <i class="fa fa-trash-o"></i>
                    <div class="ripple-container">
                    </div>
                </button>*@

                <button type="button" class="btn" data-toggle="tooltip" title="New" id="new-btn"  onclick="TaxFormulaCalcAddMode();">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>

                <button class="btn btn-danger hidden" id="cancel-btn" onclick="TaxFormulaCalcCancel()">Cancel</button>
                <button class="btn btn-primary hidden" id="update-btn" onclick="TaxFormulaCalcUpdate()">Update</button>
                <button type="submit" class="btn btn-primary hidden" id="add-btn" onclick="TaxFormulaCalcCreate()">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <form id="tax-formula-calc-parent-form">
                        <div class="col-sm-4">

                            <div class="row">
                                <div class="form-group" style="margin-top: unset;">
                                    <label for="from-date" class="col-sm-4 control-label">From Date</label>
                                    <div class="col-sm-8">
                                        <input type="date" class="form-control" id="from-date" name="FromDate">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <label for="to-date" class="col-sm-4 control-label">To Date</label>
                                    <div class="col-sm-8">
                                        <input type="date" class="form-control" id="to-date" name="ToDate">
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="col-sm-4 col-sm-offset-1">

                            <div class="row">
                                <div class="form-group" style="margin-top: unset;">
                                    <label for="code" class="col-sm-4 control-label">Code</label>
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control" id="code" name="Code" readonly>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                    <div class="col-sm-8">
                                        <input type="date" class="form-control" id="document-date" name="DocumentDate">
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>

                <button type="button" class="btn btn-default" id="add-row-tax-formula-calc">New Row</button>
                <form id="tax-formula-calc-child-form">
                    <table id="tax-formula-calculation-table" class="table table-responsive table-bordered" style="margin-top:2%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Lower Amount</th>
                                <th>Higher Amount</th>
                                <th>Percentage</th>
                                <th>Fixed Amount</th>
                                <th>Other Amount</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="text" name="id" readonly /></td>
                                <td><input type="number" name="LowerAmount" min="0" /></td>
                                <td><input type="number" name="HigherAmount" min="0" /></td>
                                <td><input type="number" name="Percentage" min="0" /></td>
                                <td><input type="number" name="FixedAmount" min="0" /></td>
                                <td><input type="number" name="OtherAmount" min="0" /></td>
                                <td><input type="text" name="Remarks" /></td>
                            </tr>
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
    </section>
    <div id="snackbar"></div>
</div>
