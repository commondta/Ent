@using DataLayer
@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Approval Setup";
    var processes = (List<ApprovalProcessModel>)ViewBag.Processes;
    var roles = (List<RoleModel>)ViewBag.Roles;
    var users = (List<UserModel>)ViewBag.Users;
    var modules = (List<ModuleInfo>)ViewBag.Modules;
    var gated = new HashSet<string>(processes.Where(p => p.IsForm).Select(p => p.FormKey), StringComparer.OrdinalIgnoreCase);
    bool canEdit = Payroll_HCC.Infrastructure.App.Can("Security.ApprovalSetup", PermissionAction.Edit);
    var ser = new System.Web.Script.Serialization.JavaScriptSerializer();
    string processesJson = ser.Serialize(processes.Select(p => new
    {
        p.RequestType, p.Title, p.Description, p.IsEnabled, p.UpdatedBy, p.IsForm, p.Actions,
        UpdatedAt = p.UpdatedAt.HasValue ? p.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : null,
        Stages = p.Stages.Select(s => new { s.StageNo, s.Name, s.ApproverRoleId, s.RequiredCount, s.UserIds })
    }));
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>Approval Setup</h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li>Security &amp; Administration</li>
            <li class="active">Approval Setup</li>
        </ol>
    </section>
    <section class="content">
        <div class="row">
            <div class="col-md-4 col-lg-3">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">Approval processes</h3>
                        @if (canEdit) { <button type="button" class="btn btn-primary btn-sm" onclick="openAddForm()">@Icons.Svg("plus", 13) Add form</button> }
                    </div>
                    <ul class="role-list" id="procList">
                        @foreach (var p in processes)
                        {
                            <li data-type="@p.RequestType">
                                <a href="#" onclick="selectProcess('@p.RequestType');return false;">
                                    <div><b>@p.Title</b><small>@(p.IsForm ? "Form · " + (p.Actions ?? "").Replace(",", ", ") + " · " : "")@(p.Stages.Count) stage@(p.Stages.Count == 1 ? "" : "s")</small></div>
                                    <span class="status @(p.IsEnabled ? "status-success" : "status-neutral")" data-role="state">@(p.IsEnabled ? "Required" : "Off")</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="box">
                    <div class="box-body" style="font-size:12.5px;color:var(--muted)">
                        <b style="display:block;color:var(--text-2);margin-bottom:6px">How it works</b>
                        <b>Add form</b> puts any screen under approval: pick the form and the actions (Create / Edit / Delete). A user without the
                        <b>Approve</b> right on that form then has the change <i>held</i> — nothing is written until an approver approves it, after
                        which the change is applied. Approvers of the form keep writing directly.<br><br>
                        A request walks through its stages in order. A stage is complete when it has the required number of approvals from its approvers
                        (<i>Any approver</i> = every user holding the <b>Approve</b> right on <b>Approvals</b>; or a role; or named users).
                        Rejecting or returning ends the request at any stage; a returned request restarts at stage 1 when resubmitted.
                        Administrators can always decide.
                    </div>
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <div class="box" id="procBox" style="display:none">
                    <div class="box-header">
                        <h3 class="box-title"><span id="procTitle"></span> <small class="text-muted" id="procType"></small></h3>
                        <div>
                            <span id="procActions" style="margin-right:14px;display:none">
                                <span class="text-muted" style="font-size:12px;margin-right:6px">Held for approval:</span>
                                @foreach (var a in new[] { "Create", "Edit", "Delete" }) { <label class="checkbox-inline" style="font-weight:500"><input type="checkbox" class="proc-action" value="@a" @(canEdit ? "" : "disabled") /> @a</label> }
                            </span>
                            <label class="checkbox-inline" style="margin-right:14px;font-weight:500"><input type="checkbox" id="procEnabled" @(canEdit ? "" : "disabled") /> Approval required</label>
                            @if (canEdit) { <button type="button" class="btn btn-danger btn-sm" id="btnRemoveForm" style="display:none" onclick="removeForm()">@Icons.Svg("trash", 13) Remove form</button> }
                            @if (canEdit) { <button type="button" class="btn btn-default btn-sm" onclick="addStage()">@Icons.Svg("plus", 13) Add stage</button> }
                            @if (canEdit) { <button type="button" class="btn btn-primary btn-sm" onclick="saveProcess()">Save setup</button> }
                        </div>
                    </div>
                    <div class="box-body">
                        <p id="procDesc" class="text-muted" style="margin:0 0 14px"></p>
                        <div class="alert alert-warning" id="procOffNote" style="display:none">Approval is switched off for this process: new requests of this kind are applied immediately and do not enter the queue. The stages below are kept for when it is switched on again.</div>
                        <div class="table-responsive">
                            <table class="table stage-table" id="stageTable">
                                <thead>
                                    <tr><th style="width:60px">Stage</th><th style="width:22%">Name</th><th style="width:22%">Approver role</th><th>Specific users</th><th style="width:110px">Approvals needed</th><th style="width:70px"></th></tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <small class="text-muted" id="procUpdated"></small>
                    </div>
                </div>
                <div class="box" id="procEmpty">
                    <div class="box-body"><div class="empty"><div class="ico">@Icons.Svg("sliders", 30)</div><b>Select a process</b><span>Choose an approval process on the left to review or change who approves it and in how many stages.</span></div></div>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="addFormModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="width:520px;max-width:92vw">
        <div class="modal-content">
            <form onsubmit="return addForm(event)">
                <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title">Put a form under approval</h4></div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="af_form">Form</label>
                        <select class="form-control" id="af_form" required>
                            <option value="">Choose a form…</option>
                            @foreach (var m in modules.Where(x => x.Key != "Home" && x.Key != "Security"))
                            {
                                <optgroup label="@m.Title">
                                    @foreach (var f in m.Forms) { <option value="@f.Key" @(gated.Contains(f.Key) ? "disabled" : "")>@f.Title@(gated.Contains(f.Key) ? " (already under approval)" : "")</option> }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Actions that need approval</label><br />
                        @foreach (var a in new[] { "Create", "Edit", "Delete" }) { <label class="checkbox-inline" style="font-weight:500"><input type="checkbox" class="af-action" value="@a" @(a == "Create" ? "checked" : "") /> @a</label> }
                        <span class="help-block" style="margin-top:8px">A user who holds the <b>Approve</b> right on the form is not held; everyone else's change waits in the queue and is applied on approval. Uploads (attachments) cannot be held.</span>
                    </div>
                    <div class="alert alert-danger" id="af_error" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add to approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section styles {
<style>
    .stage-table td { vertical-align: middle !important; }
    .stage-table .stage-no { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--charcoal); color: #fff; font-weight: 700; font-size: 12px; }
    .stage-table select[multiple] { min-height: 74px; font-size: 12.5px; }
    .stage-table input[type=number] { width: 80px; }
    .stage-table .btn-icon { padding: 4px 6px; }
    .stage-table .hint { display: block; font-size: 11px; color: var(--muted); margin-top: 3px; }
</style>
}

@section scripts {
<script>
    var PROCESSES = @Html.Raw(processesJson);
    var ROLES = @Html.Raw(ser.Serialize(roles.Select(r => new { r.id, r.Name })));
    var USERS = @Html.Raw(ser.Serialize(users.Where(u => u.IsActive).Select(u => new { u.id, Name = string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName + " (" + u.Username + ")" })));
    var canEdit = @(canEdit ? "true" : "false"), current = null;

    function opt(v, t, sel) { return '<option value="' + v + '"' + (sel ? ' selected' : '') + '>' + ERP.esc(t) + '</option>'; }
    function stageRow(s, i) {
        var roleOpts = opt('', 'Any approver', !s.ApproverRoleId);
        ROLES.forEach(function (r) { roleOpts += opt(r.id, r.Name, s.ApproverRoleId === r.id); });
        var userOpts = '';
        USERS.forEach(function (u) { userOpts += opt(u.id, u.Name, (s.UserIds || []).indexOf(u.id) >= 0); });
        var dis = canEdit ? '' : ' disabled';
        return '<tr>' +
            '<td><span class="stage-no">' + (i + 1) + '</span></td>' +
            '<td><input type="text" class="form-control input-sm st-name" maxlength="100" value="' + ERP.esc(s.Name || '') + '" placeholder="Stage ' + (i + 1) + '"' + dis + '></td>' +
            '<td><select class="form-control input-sm st-role"' + dis + '>' + roleOpts + '</select><span class="hint">Users of this role may approve</span></td>' +
            '<td><select class="form-control st-users" multiple' + dis + '>' + userOpts + '</select><span class="hint">Optional - named approvers in addition to the role (Ctrl-click to pick several)</span></td>' +
            '<td><input type="number" class="form-control input-sm st-count" min="1" max="99" value="' + (s.RequiredCount || 1) + '"' + dis + '></td>' +
            '<td class="text-right" style="white-space:nowrap">' + (canEdit ?
                '<button type="button" class="btn btn-icon" title="Move up" onclick="moveStage(this,-1)">&#9650;</button>' +
                '<button type="button" class="btn btn-icon" title="Move down" onclick="moveStage(this,1)">&#9660;</button>' +
                '<button type="button" class="btn btn-icon" title="Remove stage" onclick="removeStage(this)">' + ERP.icon('x', 13) + '</button>' : '') + '</td>' +
            '</tr>';
    }
    function renumber() { $('#stageTable tbody tr').each(function (i) { $(this).find('.stage-no').text(i + 1); $(this).find('.st-name').attr('placeholder', 'Stage ' + (i + 1)); }); }
    function selectProcess(type) {
        var p = PROCESSES.filter(function (x) { return x.RequestType === type; })[0]; if (!p) return;
        current = p;
        $('#procList li').removeClass('active').filter('[data-type="' + type + '"]').addClass('active');
        $('#procTitle').text(p.Title); $('#procType').text(p.RequestType); $('#procDesc').text(p.Description || '');
        $('#procEnabled').prop('checked', p.IsEnabled); $('#procOffNote').toggle(!p.IsEnabled);
        $('#procActions').toggle(!!p.IsForm); $('#btnRemoveForm').toggle(!!p.IsForm);
        var acts = (p.Actions || '').split(',').map(function (a) { return $.trim(a); });
        $('.proc-action').each(function () { this.checked = acts.indexOf(this.value) >= 0; });
        $('#procUpdated').text(p.UpdatedAt ? 'Last changed by ' + p.UpdatedBy + ' on ' + p.UpdatedAt : 'Default setup - not changed yet');
        var $b = $('#stageTable tbody').empty();
        (p.Stages.length ? p.Stages : [{ Name: 'Approval', RequiredCount: 1 }]).forEach(function (s, i) { $b.append(stageRow(s, i)); });
        $('#procEmpty').hide(); $('#procBox').show();
        try { if (history.replaceState) history.replaceState(null, '', '#' + type.replace(/\./g, '_')); } catch (e) { }
    }
    function addStage() { var n = $('#stageTable tbody tr').length; $('#stageTable tbody').append(stageRow({ Name: '', RequiredCount: 1 }, n)); }
    function removeStage(btn) {
        if ($('#stageTable tbody tr').length <= 1) { ERP.toast('A process needs at least one stage. Switch approval off instead if none is wanted.', 'err'); return; }
        $(btn).closest('tr').remove(); renumber();
    }
    function moveStage(btn, dir) {
        var $tr = $(btn).closest('tr');
        if (dir < 0) $tr.prev().before($tr); else $tr.next().after($tr);
        renumber();
    }
    function readStages() {
        var stages = [];
        $('#stageTable tbody tr').each(function () {
            var $tr = $(this);
            stages.push({
                Name: $.trim($tr.find('.st-name').val()),
                ApproverRoleId: $tr.find('.st-role').val() ? parseInt($tr.find('.st-role').val(), 10) : null,
                UserIds: ($tr.find('.st-users').val() || []).map(function (v) { return parseInt(v, 10); }),
                RequiredCount: Math.max(1, Math.min(99, parseInt($tr.find('.st-count').val(), 10) || 1))
            });
        });
        return stages;
    }
    $('#procEnabled').on('change', function () { $('#procOffNote').toggle(!this.checked); });
    function saveProcess() {
        if (!current) return;
        var stages = readStages();
        var acts = $('.proc-action:checked').map(function () { return this.value; }).get().join(',');
        ERP.post('@Url.Action("ApprovalSetupSave", "Security")', { requestType: current.RequestType, isEnabled: $('#procEnabled').is(':checked'), stagesJson: JSON.stringify(stages), actions: acts }, function (r) {
            ERP.toast(r.message, r.ok ? 'ok' : 'err');
            if (!r.ok) return;
            current.IsEnabled = $('#procEnabled').is(':checked'); current.Stages = stages.map(function (s, i) { s.StageNo = i + 1; return s; });
            if (current.IsForm) { current.Actions = acts; $('#procList li[data-type="' + current.RequestType + '"] small').text('Form · ' + acts.replace(/,/g, ', ') + ' · ' + stages.length + ' stage' + (stages.length === 1 ? '' : 's')); }
            current.UpdatedBy = r.by; current.UpdatedAt = r.at; $('#procUpdated').text('Last changed by ' + r.by + ' on ' + r.at);
            var $li = $('#procList li[data-type="' + current.RequestType + '"]');
            if (!current.IsForm) $li.find('small').text(stages.length + ' stage' + (stages.length === 1 ? '' : 's'));
            $li.find('[data-role=state]').text(current.IsEnabled ? 'Required' : 'Off').attr('class', 'status ' + (current.IsEnabled ? 'status-success' : 'status-neutral'));
        });
    }
    function openAddForm() { $('#af_error').hide(); $('#af_form').val(''); $('#addFormModal').modal('show'); }
    function addForm(e) {
        e.preventDefault();
        var key = $('#af_form').val(), acts = $('.af-action:checked').map(function () { return this.value; }).get().join(',');
        if (!key) { $('#af_error').text('Choose a form.').show(); return false; }
        if (!acts) { $('#af_error').text('Pick at least one action.').show(); return false; }
        ERP.post('@Url.Action("ApprovalSetupAddForm", "Security")', { formKey: key, actions: acts }, function (r) {
            if (!r.ok) { $('#af_error').text(r.message).show(); return; }
            $('#addFormModal').modal('hide'); ERP.toast(r.message);
            location.hash = '#' + r.requestType.replace(/\./g, '_'); location.reload();
        }, function (m) { $('#af_error').text(m).show(); });
        return false;
    }
    function removeForm() {
        if (!current || !current.IsForm) return;
        ERP.confirm({ title: 'Remove ' + current.Title + ' from approval?', text: 'New changes on this form will be written directly again. Pending requests already in the queue stay there.', ok: 'Remove', danger: true }, function () {
            ERP.post('@Url.Action("ApprovalSetupRemove", "Security")', { requestType: current.RequestType }, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); if (r.ok) { location.hash = ''; location.reload(); } });
        });
    }
    $(function () {
        var m = /#([\w.]+)/.exec(location.hash);
        if (m) m[1] = m[1].replace(/_/g, '.');
        if (m && PROCESSES.some(function (p) { return p.RequestType === m[1]; })) selectProcess(m[1]);
        else if (m && PROCESSES.some(function (p) { return p.RequestType.replace(/\./g, '_') === m[1].replace(/\./g, '_'); })) selectProcess(PROCESSES.filter(function (p) { return p.RequestType.replace(/\./g, '_') === m[1].replace(/\./g, '_'); })[0].RequestType);
        else if (PROCESSES.length) selectProcess(PROCESSES[0].RequestType);
    });
</script>
}
