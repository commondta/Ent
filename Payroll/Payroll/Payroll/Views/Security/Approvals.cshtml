@using DataLayer
@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Approvals";
    var requests = (List<ApprovalRequestModel>)ViewBag.Requests;
    string status = ViewBag.Status;
    bool canApprove = ViewBag.CanApprove;
    var decidable = (HashSet<int>)ViewBag.Decidable;
    bool canSetup = ViewBag.CanSetup;
    string me = Payroll_HCC.Infrastructure.App.CurrentUsername;
    string[] tabs = { "Pending", "Approved", "Rejected", "Returned", "All" };
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>Approvals</h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li>Security &amp; Administration</li>
            <li class="active">Approvals</li>
        </ol>
    </section>
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Approval queue</h3>
                <div class="btn-group">
                    @foreach (var t in tabs) { <a href="@Url.Action("Approvals", new { status = t })" class="btn btn-sm @(t == status ? "btn-primary" : "btn-default")">@t</a> }
                </div>
                @if (canSetup) { <a class="btn btn-sm btn-default" href="@Url.Action("ApprovalSetup", "Security")" title="Who approves what, and in how many stages">@Icons.Svg("sliders", 13) Approval Setup</a> }
            </div>
            <div class="box-body">
                @if (requests.Count == 0)
                {
                    <div class="empty"><div class="ico">@Icons.Svg("check-circle", 30)</div><b>No @(status == "All" ? "" : status.ToLower()) requests</b><span>@(status == "Pending" ? "Everything has been reviewed." : "Nothing to show for this filter.")</span></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover" id="apr-table">
                            <thead>
                                <tr><th>#</th><th>Request</th><th>Type</th><th>Stage</th><th>Requested by</th><th>Requested</th><th>Status</th><th>Reviewed</th><th style="width:150px"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in requests)
                                {
                                    <tr id="r@(r.id)" data-id="@r.id">
                                        <td>@r.id</td>
                                        <td><b style="font-weight:600">@r.Title</b>@if (!string.IsNullOrEmpty(r.Detail)) { <br /><small class="text-muted">@r.Detail</small> }</td>
                                        <td><span class="tag" title="@r.RequestType">@r.ProcessTitle</span></td>
                                        <td>@if (r.Status == "Pending") { <span title="@r.StageName">@r.CurrentStage of @r.StageCount@(string.IsNullOrEmpty(r.StageName) ? "" : " · " + r.StageName)</span> } else { <span class="text-muted">—</span> }</td>
                                        <td>@r.RequestedBy</td>
                                        <td title="@r.RequestedAt.ToString("dd MMM yyyy HH:mm")">@Payroll_HCC.Infrastructure.App.TimeAgo(r.RequestedAt)</td>
                                        <td><span class="status status-@r.Status">@r.Status</span>@if (r.HasPayload && r.Status == "Approved") { <br /><small class="text-muted">@(r.AppliedAt.HasValue ? "applied " + Payroll_HCC.Infrastructure.App.TimeAgo(r.AppliedAt.Value) : "not applied yet")</small> }</td>
                                        <td>@if (r.ReviewedAt.HasValue) { <small>@r.ReviewedBy<br />@r.ReviewedAt.Value.ToString("dd MMM yyyy HH:mm")</small> } else { <span class="text-muted">—</span> }</td>
                                        <td class="text-right" style="white-space:nowrap">
                                            <button type="button" class="btn btn-icon" title="Details & history" onclick="showDetail(@r.id)">@Icons.Svg("info-circle", 14)</button>
                                            @if (r.Status == "Pending" && canApprove && decidable.Contains(r.id))
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" onclick="decide(@r.id, 'Approved')">Approve</button>
                                                <button type="button" class="btn btn-sm btn-default" onclick="decide(@r.id, 'Returned')">Return</button>
                                                <button type="button" class="btn btn-sm btn-danger" onclick="decide(@r.id, 'Rejected')">Reject</button>
                                            }
                                            else if (r.Status == "Returned" && r.RequestedBy == me)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" onclick="resubmit(@r.id)">Resubmit</button>
                                            }
                                            else if (r.Status == "Approved" && r.HasPayload && !r.AppliedAt.HasValue && canApprove)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" title="The approved change has not been applied yet" onclick="applyApproved(@r.id)">Apply change</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="decideModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="width:460px;max-width:92vw">
        <div class="modal-content">
            <form onsubmit="return submitDecision(event)">
                <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title" id="d_title">Approve request</h4></div>
                <div class="modal-body">
                    <input type="hidden" id="d_id" /><input type="hidden" id="d_decision" />
                    <p id="d_text"></p>
                    <div class="form-group"><label for="d_comment" id="d_comment_label">Comment (optional)</label><textarea class="form-control" id="d_comment" rows="3"></textarea></div>
                    <div class="alert alert-danger" id="d_error" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="d_ok">Approve</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="width:560px;max-width:92vw">
        <div class="modal-content">
            <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title">Request details</h4></div>
            <div class="modal-body" id="detailBody"></div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

@section scripts {
<script>
    function decide(id, decision) {
        var title = $('#r' + id + ' td:nth-child(2) b').text();
        $('#d_id').val(id); $('#d_decision').val(decision); $('#d_error').hide(); $('#d_comment').val('');
        $('#d_title').text((decision === 'Approved' ? 'Approve' : decision === 'Rejected' ? 'Reject' : 'Return') + ' request');
        $('#d_text').html('<b>' + ERP.esc(title) + '</b>');
        $('#d_comment_label').text(decision === 'Approved' ? 'Comment (optional)' : 'Reason (required)');
        $('#d_ok').text(decision === 'Approved' ? 'Approve' : decision === 'Rejected' ? 'Reject' : 'Return for revision').attr('class', 'btn ' + (decision === 'Rejected' ? 'btn-danger' : 'btn-primary'));
        $('#decideModal').modal('show');
    }
    function submitDecision(e) {
        e.preventDefault();
        ERP.post('@Url.Action("ApprovalDecide", "Security")', { id: $('#d_id').val(), decision: $('#d_decision').val(), comment: $('#d_comment').val() }, function (r) {
            if (!r.ok) { $('#d_error').text(r.message).show(); return; }
            $('#decideModal').modal('hide'); ERP.toast(r.message);
            if (r.replay) { replayRequest(r.replayId, r.replay); return; }
            setTimeout(function () { location.reload(); }, 500);
        }, function (m) { $('#d_error').text(m).show(); });
        return false;
    }
    function resubmit(id) {
        ERP.confirm({ title: 'Resubmit request #' + id + '?', text: 'It goes back into the pending queue for review.', ok: 'Resubmit' }, function () {
            ERP.post('@Url.Action("ApprovalResubmit", "Security")', { id: id, comment: '' }, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); if (r.ok) setTimeout(function () { location.reload(); }, 500); });
        });
    }
    /* form gate: re-send the captured write exactly as the requester sent it, flagged as an approved replay */
    function replayRequest(id, p) {
        var opts = { type: p.Method || 'POST', url: p.Url, headers: { 'X-Approval-Replay': String(id), 'X-Requested-With': 'XMLHttpRequest' } };
        if (p.ContentType === 'application/json') { opts.contentType = 'application/json'; opts.data = p.Body || '{}'; }
        else { var f = p.Form || {}; var d = []; for (var k in f) { (f[k] || []).forEach(function (v) { d.push(encodeURIComponent(k) + '=' + encodeURIComponent(v)); }); } d.push('__RequestVerificationToken=' + encodeURIComponent(ERP.token())); opts.data = d.join('&'); opts.contentType = 'application/x-www-form-urlencoded; charset=UTF-8'; }
        $.ajax(opts).done(function (res) {
            if (res && res.ok === false) { ERP.toast('Could not apply the change: ' + (res.message || ''), 'err'); }
            else ERP.toast('Approved change #' + id + ' applied.');
            setTimeout(function () { location.reload(); }, 900);
        }).fail(function (xhr) { ERP.toast('Applying the change failed (' + xhr.status + '). Use "Apply change" to retry.', 'err'); setTimeout(function () { location.reload(); }, 1500); });
    }
    function applyApproved(id) {
        $.getJSON('@Url.Action("ApprovalReplay", "Security")', { id: id }).done(function (r) { if (!r.ok) { ERP.toast(r.message, 'err'); return; } replayRequest(r.id, r.replay); });
    }
    function showDetail(id) {
        $.getJSON('@Url.Action("ApprovalDetail", "Security")', { id: id }).done(function (r) {
            var h = '<dl class="kv"><dt>Request</dt><dd><b>' + ERP.esc(r.Title) + '</b></dd><dt>Type</dt><dd>' + ERP.esc(r.RequestType) + (r.ReferenceKey ? ' · ref ' + ERP.esc(r.ReferenceKey) : '') + '</dd>' +
                (r.Detail ? '<dt>Detail</dt><dd>' + ERP.esc(r.Detail) + '</dd>' : '') + (r.HasPayload ? '<dt>Change</dt><dd>' + (r.AppliedAt ? 'applied ' + ERP.esc(r.AppliedAt) + ' by ' + ERP.esc(r.AppliedBy) : (r.Status === 'Approved' ? 'approved, not applied yet' : 'held until approved')) + '</dd>' : '') +
                (r.Status === 'Pending' ? '<dt>Stage</dt><dd>' + r.CurrentStage + ' of ' + r.StageCount + (r.StageName ? ' · ' + ERP.esc(r.StageName) : '') + '</dd>' : '') + '<dt>Requested by</dt><dd>' + ERP.esc(r.RequestedBy) + ' · ' + ERP.esc(r.RequestedAt) + '</dd><dt>Status</dt><dd><span class="status status-' + ERP.esc(r.Status) + '">' + ERP.esc(r.Status) + '</span></dd></dl>' +
                '<h5 style="margin:18px 0 10px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#777">History</h5><ul class="timeline">';
            (r.history || []).forEach(function (x) { h += '<li><b>' + ERP.esc(x.Action) + '</b>' + (x.Stage ? ' <span class="tag">stage ' + x.Stage + '</span>' : '') + ' by ' + ERP.esc(x.ActionBy) + '<small>' + ERP.esc(x.ActionAt) + '</small>' + (x.Comment ? '<p>' + ERP.esc(x.Comment) + '</p>' : '') + '</li>'; });
            h += '</ul>';
            $('#detailBody').html(h); $('#detailModal').modal('show');
        });
    }
    $(function () {
        if ($('#apr-table').length) $('#apr-table').DataTable({ order: [], pageLength: 25, columnDefs: [{ orderable: false, targets: 8 }], language: { search: '', searchPlaceholder: 'Filter requests…' } });
        var m = /#r(\d+)/.exec(location.hash); if (m) $('#r' + m[1]).css('background', '#fff7e6');
    });
</script>
}
