@using DataLayer
@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Roles & Permissions";
    var roles = (List<RoleModel>)ViewBag.Roles;
    var modules = (List<ModuleInfo>)ViewBag.Modules;
    bool canCreate = Payroll_HCC.Infrastructure.App.Can("Security.Roles", PermissionAction.Create);
    bool canEdit = Payroll_HCC.Infrastructure.App.Can("Security.Roles", PermissionAction.Edit);
    bool canDelete = Payroll_HCC.Infrastructure.App.Can("Security.Roles", PermissionAction.Delete);
    string[] actions = { "View", "Create", "Edit", "Delete", "Approve", "Export", "Print" };
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>Roles &amp; Permissions</h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li>Security &amp; Administration</li>
            <li class="active">Roles &amp; Permissions</li>
        </ol>
    </section>
    <section class="content">
        <div class="row">
            <div class="col-md-4 col-lg-3">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">Roles</h3>
                        @if (canCreate) { <button type="button" class="btn btn-primary btn-sm" onclick="openRole(null)">@Icons.Svg("plus", 13) New</button> }
                    </div>
                    <ul class="role-list" id="roleList">
                        @foreach (var r in roles)
                        {
                            <li data-id="@r.id" data-name="@r.Name" data-desc="@r.Description" data-system="@(r.IsSystem ? 1 : 0)">
                                <a href="#" onclick="selectRole(@r.id);return false;"><div><b>@r.Name</b><small>@r.Description</small></div><span class="tag">@r.UserCount user@(r.UserCount == 1 ? "" : "s")</span></a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <div class="box" id="permBox" style="display:none">
                    <div class="box-header">
                        <h3 class="box-title"><span id="permRoleName"></span> <small class="text-muted" id="permRoleDesc"></small></h3>
                        <div>
                            @if (canEdit) { <button type="button" class="btn btn-default btn-sm" id="btnEditRole" onclick="openRole(currentRole)">@Icons.Svg("pencil", 13) Rename</button> }
                            @if (canDelete) { <button type="button" class="btn btn-danger btn-sm" id="btnDeleteRole" onclick="deleteRole()">@Icons.Svg("trash", 13) Delete</button> }
                            @if (canEdit) { <button type="button" class="btn btn-primary btn-sm" id="btnSavePerms" onclick="savePerms()">Save permissions</button> }
                        </div>
                    </div>
                    <div class="box-body">
                        <div class="alert alert-info" id="permSystemNote" style="display:none">The Administrator role always has full access to every form; its permissions cannot be edited.</div>
                        <div class="table-responsive">
                            <table class="table perm-table" id="permTable">
                                <thead>
                                    <tr>
                                        <th>Form</th>
                                        @foreach (var a in actions) { <th style="width:72px">@a<br /><input type="checkbox" class="col-all" data-action="@a" title="Toggle column" /></th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in modules)
                                    {
                                        <tr class="perm-module"><td>@Icons.Svg(m.Icon, 13) @m.Title</td><td colspan="@actions.Length" style="text-align:right"><label style="font-weight:500;text-transform:none;letter-spacing:0;cursor:pointer;margin:0"><input type="checkbox" class="mod-all" /> all</label></td></tr>
                                        foreach (var f in m.Forms)
                                        {
                                            <tr class="perm-form" data-key="@f.Key">
                                                <td>@f.Title</td>
                                                @foreach (var a in actions) { <td><input type="checkbox" data-action="@a" /></td> }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="box" id="permEmpty">
                    <div class="box-body"><div class="empty"><div class="ico">@Icons.Svg("key", 30)</div><b>Select a role</b><span>Choose a role on the left to view or edit what it can access.</span></div></div>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="roleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="width:460px;max-width:92vw">
        <div class="modal-content">
            <form onsubmit="return saveRole(event)">
                <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title" id="roleModalTitle">New role</h4></div>
                <div class="modal-body">
                    <input type="hidden" id="ro_id" value="0" />
                    <div class="form-group"><label for="ro_name">Role name</label><input type="text" class="form-control" id="ro_name" maxlength="50" required /></div>
                    <div class="form-group"><label for="ro_desc">Description</label><input type="text" class="form-control" id="ro_desc" maxlength="200" /></div>
                    <div class="alert alert-danger" id="ro_error" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save role</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script>
    var currentRole = null, currentSystem = false, canEdit = @(canEdit ? "true" : "false");
    function selectRole(id) {
        $('#roleList li').removeClass('active').filter('[data-id=' + id + ']').addClass('active');
        $.getJSON('@Url.Action("RolePermissions", "Security")', { id: id }).done(function (r) {
            currentRole = r.role.id; currentSystem = r.role.IsSystem;
            $('#permRoleName').text(r.role.Name); $('#permRoleDesc').text(r.role.Description || '');
            $('#permTable input[type=checkbox]').prop('checked', false).prop('disabled', currentSystem || !canEdit);
            $('#permSystemNote').toggle(currentSystem);
            $('#btnSavePerms, #btnEditRole, #btnDeleteRole').toggle(!currentSystem);
            if (currentSystem) $('#permTable tr.perm-form input').prop('checked', true);
            (r.permissions || []).forEach(function (p) {
                var $tr = $('#permTable tr.perm-form[data-key="' + p.FormKey + '"]');
                $tr.find('input[data-action=View]').prop('checked', p.CanView);
                $tr.find('input[data-action=Create]').prop('checked', p.CanCreate);
                $tr.find('input[data-action=Edit]').prop('checked', p.CanEdit);
                $tr.find('input[data-action=Delete]').prop('checked', p.CanDelete);
                $tr.find('input[data-action=Approve]').prop('checked', p.CanApprove);
                $tr.find('input[data-action=Export]').prop('checked', p.CanExport);
                $tr.find('input[data-action=Print]').prop('checked', p.CanPrint);
            });
            $('#permEmpty').hide(); $('#permBox').show();
            if (history.replaceState) history.replaceState(null, '', '#role' + id);
        });
    }
    function savePerms() {
        var perms = [];
        $('#permTable tr.perm-form').each(function () {
            var $tr = $(this), g = function (a) { return $tr.find('input[data-action=' + a + ']').is(':checked'); };
            var p = { FormKey: $tr.data('key'), CanView: g('View'), CanCreate: g('Create'), CanEdit: g('Edit'), CanDelete: g('Delete'), CanApprove: g('Approve'), CanExport: g('Export'), CanPrint: g('Print') };
            if (p.CanView || p.CanCreate || p.CanEdit || p.CanDelete || p.CanApprove || p.CanExport || p.CanPrint) perms.push(p);
        });
        var data = { id: currentRole };
        perms.forEach(function (p, i) { for (var k in p) data['permissions[' + i + '].' + k] = p[k]; });
        ERP.post('@Url.Action("RolePermissionsSave", "Security")', data, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); });
    }
    function openRole(id) {
        $('#ro_error').hide();
        if (id) { var $li = $('#roleList li[data-id=' + id + ']'); $('#ro_id').val(id); $('#ro_name').val($li.data('name')); $('#ro_desc').val($li.data('desc')); $('#roleModalTitle').text('Edit role'); }
        else { $('#ro_id').val(0); $('#ro_name').val(''); $('#ro_desc').val(''); $('#roleModalTitle').text('New role'); }
        $('#roleModal').modal('show');
    }
    function saveRole(e) {
        e.preventDefault();
        ERP.post('@Url.Action("RoleSave", "Security")', { id: $('#ro_id').val(), Name: $('#ro_name').val(), Description: $('#ro_desc').val() }, function (r) {
            if (!r.ok) { $('#ro_error').text(r.message).show(); return; }
            $('#roleModal').modal('hide'); ERP.toast(r.message); setTimeout(function () { location.href = location.pathname + '#role' + r.id; location.reload(); }, 500);
        }, function (m) { $('#ro_error').text(m).show(); });
        return false;
    }
    function deleteRole() {
        ERP.confirm({ title: 'Delete role "' + $('#permRoleName').text() + '"?', text: 'Only roles with no users can be deleted. Its permission rows are removed.', ok: 'Delete', danger: true }, function () {
            ERP.post('@Url.Action("RoleDelete", "Security")', { id: currentRole }, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); if (r.ok) setTimeout(function () { location.href = location.pathname; location.reload(); }, 500); });
        });
    }
    $(function () {
        // Checking any action implies View; unchecking View clears the row.
        $('#permTable').on('change', 'tr.perm-form input', function () {
            var $tr = $(this).closest('tr'), a = $(this).data('action');
            if (a !== 'View' && this.checked) $tr.find('input[data-action=View]').prop('checked', true);
            if (a === 'View' && !this.checked) $tr.find('input').prop('checked', false);
        });
        $('#permTable').on('change', '.mod-all', function () {
            var on = this.checked; $(this).closest('tr').nextUntil('tr.perm-module').find('input:not(:disabled)').prop('checked', on);
        });
        $('#permTable').on('change', '.col-all', function () {
            var on = this.checked, a = $(this).data('action');
            $('#permTable tr.perm-form input[data-action=' + a + ']:not(:disabled)').prop('checked', on);
            if (on) $('#permTable tr.perm-form input[data-action=View]:not(:disabled)').prop('checked', true);
        });
        var m = /#role(\d+)/.exec(location.hash);
        if (m) selectRole(parseInt(m[1], 10));
    });
</script>
}
