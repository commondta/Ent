@using DataLayer
@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "User Management";
    var users = (List<UserModel>)ViewBag.Users;
    var roles = (List<RoleModel>)ViewBag.Roles;
    bool canCreate = Payroll_HCC.Infrastructure.App.Can("Security.Users", PermissionAction.Create);
    bool canEdit = Payroll_HCC.Infrastructure.App.Can("Security.Users", PermissionAction.Edit);
    bool canDelete = Payroll_HCC.Infrastructure.App.Can("Security.Users", PermissionAction.Delete);
    bool canApprove = Payroll_HCC.Infrastructure.App.Can("Security.Users", PermissionAction.Approve);
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>User Management</h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li>Security &amp; Administration</li>
            <li class="active">User Management</li>
        </ol>
    </section>
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Users <span class="tag">@users.Count</span></h3>
                @if (canCreate)
                {
                    <button type="button" class="btn btn-primary" onclick="openUser(null)">@Icons.Svg("plus", 14) New user</button>
                }
            </div>
            <div class="box-body">
                @if (canCreate && !canApprove)
                {
                    <div class="alert alert-info">Users you create are kept inactive until a user with the <b>Approve</b> permission on User Management approves them.</div>
                }
                <div class="table-responsive">
                    <table id="users-table" class="table table-hover">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Last sign-in</th>
                                <th>Created</th>
                                <th style="width:120px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in users)
                            {
                                <tr data-id="@u.id" data-username="@u.Username" data-fullname="@u.FullName" data-email="@u.Email" data-roleid="@u.RoleId" data-active="@(u.IsActive ? 1 : 0)">
                                    <td>
                                        <span class="user-chip" style="gap:8px"><span class="avatar" style="background:#242729;color:#fff;width:26px;height:26px;font-size:10.5px">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Username.Substring(0, Math.Min(2, u.Username.Length)).ToUpper() : string.Concat(u.FullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper())</span>
                                        <span><b style="font-weight:600">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName)</b>@if (!string.IsNullOrEmpty(u.Email)) { <br /><small class="text-muted">@u.Email</small> }</span></span>
                                    </td>
                                    <td><code style="background:none;color:inherit;padding:0">@u.Username</code></td>
                                    <td>@(string.IsNullOrEmpty(u.RoleName) ? "—" : u.RoleName)</td>
                                    <td>
                                        <span class="status @(u.IsActive ? "status-Active" : "status-Inactive")">@(u.IsActive ? "Active" : "Inactive")</span>
                                        @if (u.MustChangePassword) { <span class="tag" title="Must change password at next sign-in">pwd reset</span> }
                                    </td>
                                    <td>@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd MMM yyyy HH:mm") : "never")</td>
                                    <td><small>@u.CreatedAt.ToString("dd MMM yyyy")@(string.IsNullOrEmpty(u.CreatedBy) ? "" : " by " + u.CreatedBy)</small></td>
                                    <td class="text-right" style="white-space:nowrap">
                                        @if (canEdit)
                                        {
                                            <button type="button" class="btn btn-icon" title="Edit" onclick="openUser(this)">@Icons.Svg("pencil", 14)</button>
                                            <button type="button" class="btn btn-icon" title="Reset password" onclick="openReset(this)">@Icons.Svg("key", 14)</button>
                                            <button type="button" class="btn btn-icon" title="@(u.IsActive ? "Deactivate" : "Activate")" onclick="toggleUser(this)">@Icons.Svg(u.IsActive ? "x-circle" : "check-circle", 14)</button>
                                        }
                                        @if (canDelete)
                                        {
                                            <button type="button" class="btn btn-icon danger" title="Delete" onclick="deleteUser(this)">@Icons.Svg("trash", 14)</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- User modal -->
<div class="modal fade" id="userModal" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="userForm" onsubmit="return saveUser(event)">
                <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title" id="userModalTitle">New user</h4></div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="u_id" value="0" />
                    <div class="row">
                        <div class="col-sm-6"><div class="form-group"><label for="u_username">Username</label><input type="text" class="form-control" name="Username" id="u_username" maxlength="50" required autocomplete="off" /></div></div>
                        <div class="col-sm-6"><div class="form-group"><label for="u_role">Role</label>
                            <select class="form-control" name="RoleId" id="u_role" required>
                                <option value="">Choose a role…</option>
                                @foreach (var r in roles) { <option value="@r.id" data-system="@(r.IsSystem ? 1 : 0)">@r.Name</option> }
                            </select></div></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6"><div class="form-group"><label for="u_fullname">Full name</label><input type="text" class="form-control" name="FullName" id="u_fullname" maxlength="100" /></div></div>
                        <div class="col-sm-6"><div class="form-group"><label for="u_email">Email</label><input type="email" class="form-control" name="Email" id="u_email" maxlength="150" /></div></div>
                    </div>
                    <div class="row" id="u_pwd_row">
                        <div class="col-sm-6"><div class="form-group"><label for="u_password">Initial password</label><input type="password" class="form-control" name="Password" id="u_password" autocomplete="new-password" /><span class="help-block">At least 8 characters with letters and digits. The user must change it at first sign-in.</span></div></div>
                    </div>
                    <div class="form-group" id="u_active_row">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer"><input type="checkbox" name="IsActive" id="u_active" value="true" checked style="width:15px;height:15px;margin:0;accent-color:#111" /> Account is active</label>
                    </div>
                    <div class="alert alert-danger" id="u_error" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="u_save">Save user</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset password modal -->
<div class="modal fade" id="resetModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="width:420px;max-width:92vw">
        <div class="modal-content">
            <form onsubmit="return saveReset(event)">
                <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title">Reset password</h4></div>
                <div class="modal-body">
                    <input type="hidden" id="r_id" />
                    <p>Set a new temporary password for <b id="r_name"></b>. They will be asked to change it at their next sign-in.</p>
                    <div class="form-group"><label for="r_pwd">New password</label><input type="password" class="form-control" id="r_pwd" autocomplete="new-password" required /></div>
                    <div class="alert alert-danger" id="r_error" style="display:none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reset password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script>
    var isAdmin = @(Payroll_HCC.Infrastructure.App.CurrentUser.IsAdministrator ? "true" : "false");
    $(function () {
        $('#users-table').DataTable({ order: [[0, 'asc']], columnDefs: [{ orderable: false, targets: 6 }], pageLength: 25, language: { search: '', searchPlaceholder: 'Filter users…' } });
        if (!isAdmin) $('#u_role option[data-system="1"]').prop('disabled', true);
    });
    function openUser(btn) {
        var $tr = btn ? $(btn).closest('tr') : null;
        $('#u_error').hide();
        $('#u_id').val($tr ? $tr.data('id') : 0);
        $('#u_username').val($tr ? $tr.data('username') : '');
        $('#u_fullname').val($tr ? $tr.data('fullname') : '');
        $('#u_email').val($tr ? $tr.data('email') : '');
        $('#u_role').val($tr ? String($tr.data('roleid') || '') : '');
        $('#u_active').prop('checked', $tr ? $tr.data('active') == 1 : true);
        $('#u_pwd_row').toggle(!$tr);
        $('#u_password').prop('required', !$tr).val('');
        $('#userModalTitle').text($tr ? 'Edit user' : 'New user');
        $('#userModal').modal('show');
    }
    function saveUser(e) {
        e.preventDefault();
        var $f = $('#userForm');
        var data = { id: $('#u_id').val(), Username: $('#u_username').val(), FullName: $('#u_fullname').val(), Email: $('#u_email').val(), RoleId: $('#u_role').val(), Password: $('#u_password').val(), IsActive: $('#u_active').is(':checked') };
        $('#u_save').prop('disabled', true);
        ERP.post('@Url.Action("UserSave", "Security")', data, function (r) {
            $('#u_save').prop('disabled', false);
            if (!r.ok) { $('#u_error').text(r.message).show(); return; }
            $('#userModal').modal('hide'); ERP.toast(r.message); setTimeout(function () { location.reload(); }, 600);
        }, function (msg) { $('#u_save').prop('disabled', false); $('#u_error').text(msg).show(); });
        return false;
    }
    function toggleUser(btn) {
        var $tr = $(btn).closest('tr'), active = $tr.data('active') == 1;
        ERP.confirm({ title: (active ? 'Deactivate ' : 'Activate ') + $tr.data('username') + '?', text: active ? 'The user will no longer be able to sign in.' : 'The user will be able to sign in again.', ok: active ? 'Deactivate' : 'Activate', danger: active }, function () {
            ERP.post('@Url.Action("UserToggle", "Security")', { id: $tr.data('id') }, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); if (r.ok) setTimeout(function () { location.reload(); }, 500); });
        });
    }
    function deleteUser(btn) {
        var $tr = $(btn).closest('tr');
        ERP.confirm({ title: 'Delete user ' + $tr.data('username') + '?', text: 'This permanently removes the account. Activity history is kept. Consider deactivating instead.', ok: 'Delete', danger: true }, function () {
            ERP.post('@Url.Action("UserDelete", "Security")', { id: $tr.data('id') }, function (r) { ERP.toast(r.message, r.ok ? 'ok' : 'err'); if (r.ok) setTimeout(function () { location.reload(); }, 500); });
        });
    }
    function openReset(btn) {
        var $tr = $(btn).closest('tr');
        $('#r_error').hide(); $('#r_id').val($tr.data('id')); $('#r_name').text($tr.data('username')); $('#r_pwd').val('');
        $('#resetModal').modal('show');
    }
    function saveReset(e) {
        e.preventDefault();
        ERP.post('@Url.Action("UserResetPassword", "Security")', { id: $('#r_id').val(), newPassword: $('#r_pwd').val() }, function (r) {
            if (!r.ok) { $('#r_error').text(r.message).show(); return; }
            $('#resetModal').modal('hide'); ERP.toast(r.message); setTimeout(function () { location.reload(); }, 600);
        }, function (msg) { $('#r_error').text(msg).show(); });
        return false;
    }
</script>
}
