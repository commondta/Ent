@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Access denied";
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>Access denied</h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li class="active">Access denied</li>
        </ol>
    </section>
    <section class="content">
        <div class="box">
            <div class="box-body">
                <div class="empty">
                    <div class="ico">@Icons.Svg("shield-lock", 34)</div>
                    <b>You do not have permission to open @(string.IsNullOrEmpty(ViewBag.What as string) ? "this page" : (string)ViewBag.What).</b>
                    <span>Your role (@(Payroll_HCC.Infrastructure.App.CurrentUser == null ? "" : Payroll_HCC.Infrastructure.App.CurrentUser.RoleName)) does not include this access. Ask an administrator if you need it.</span>
                    <div style="margin-top:16px"><a href="@Url.Action("Index", "Home")" class="btn btn-primary">Go to Home</a></div>
                </div>
            </div>
        </div>
    </section>
</div>
