@using Payroll_HCC.Infrastructure
@{
    ViewBag.Title = "Error";
}
<div class="content-wrapper">
    <section class="content-header">
        <h1>Something went wrong</h1>
        <ol class="breadcrumb"><li><a href="@Url.Action("Index", "Home")">Home</a></li><li class="active">Error</li></ol>
    </section>
    <section class="content">
        <div class="box">
            <div class="box-body">
                <div class="empty">
                    <div class="ico">@Icons.Svg("x-circle", 34)</div>
                    <b>The request could not be completed.</b>
                    <span>The problem has been recorded for the administrators. Please try again or return to Home.</span>
                    <div style="margin-top:16px"><a href="@Url.Action("Index", "Home")" class="btn btn-primary">Go to Home</a></div>
                </div>
            </div>
        </div>
    </section>
</div>
