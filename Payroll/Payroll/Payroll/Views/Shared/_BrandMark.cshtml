@* Payroll Management brand mark = the "group of people" silhouette (brand/payroll-mark-generator.py).
   Model: "light" = white mark (for charcoal grounds) · "dark" = ink mark (for white grounds). Monochrome only. *@
@{
    bool light = (Model as string) != "dark";
    string ink = light ? "#ffffff" : "#111111";
    string mid = "pm" + Guid.NewGuid().ToString("N").Substring(0, 6);   // mask id, unique per instance
}
