@{
    ViewBag.Title = "Daily Attendance";
}


<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Daily Attendance</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Time &amp; Attendance</li>
            <li class="active">Daily Attendance</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Daily Attendance</h3>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 50px 20px;">
                    <div class="col-sm-4">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="attendance-date" class="col-sm-4 control-label">Attendance Date <span class="red-text">*</span></label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="attendance-date" required>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="location" class="col-sm-4 control-label">Location</label>
                                <div class="col-sm-8">
                                    <select id="location" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="employee-type" class="col-sm-4 control-label">Employee Type</label>
                                <div class="col-sm-8">
                                    <select id="employee-type" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="shift" class="col-sm-4 control-label">Shift</label>
                                <div class="col-sm-8">
                                    <select id="shift" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="pay-period" class="col-sm-4 control-label">Pay Period <span class="red-text">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="pay-period">
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-4 col-sm-offset-1">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="no-type" class="col-sm-4 control-label">No.</label>
                                <div class="col-sm-8">
                                    <select id="no-type" class="form-control">
                                        <option selected="selected">Primary</option>
                                        <option>Secondary</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <input type="text" class="form-control" id="no">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="document-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="status" class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="status">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row" style="padding: 0 20px;">
                    <table id="daily-attendance-sheet-dataTable" class="table table-responsive table-bordered" style="margin-top:2%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Department</th>
                                <th>Employee ID</th>
                                <th>Company ID</th>
                                <th>Employee Name</th>
                                <th>Designation</th>
                                <th>Employee Type</th>
                                <th>Location</th>
                                <th>Employee Shift</th>
                                <th>Overtime</th>
                                <th>Shift From Time</th>
                                <th>Shift to Time</th>
                                <th>Time in</th>
                                <th>Time out</th>
                                <th>Hours Worked</th>
                                <th>Performance Point</th>
                                <th>Performance Incen. Hours</th>
                                <th>Performance Incen. Amount</th>
                                <th>Attendance</th>
                                <th>LOP</th>
                                <th>Leave Type</th>
                                <th>Shift Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 10; i++)
                            {
                                <tr>
                                    <td class="grey-cell">@(i + 1)</td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td class="grey-cell"></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td class="grey-cell"></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <div class="col-sm-8">
                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="remarks" class="col-sm-2 control-label">Remarks</label>
                                <div class="col-sm-10">
                                    <textarea class="form-control" id="remarks" rows="3" placeholder="Enter..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
