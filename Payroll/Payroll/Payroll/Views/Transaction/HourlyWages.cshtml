
@{
    ViewBag.Title = "Hourly Wages";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog modal-lg">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Hourly Wages</h4>
            </div>
            <div class="modal-body">

                <div class="row topSectionMargin">
                    <div class="col-md-12">
                        <fieldset>
                            <legend class="text-semibold"><i class="icon-reading position-left"></i>Employee Details</legend>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-md-6 split-col">
                                        <div class="row topMargin">
                                            <div class="form-group">
                                                <label for="payroll-name" class="col-sm-4 control-label">Payroll Name</label>
                                                <div class="col-sm-8">
                                                    <input type="text" class="form-control" id="payroll-name">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row topMargin">
                                            <div class="form-group">
                                                <label for="employee-name" class="col-sm-4 control-label">Employee Name</label>
                                                <div class="col-sm-8">
                                                    <input type="text" class="form-control" id="employee-name">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="employee-id" class="col-sm-4 control-label">Employee ID</label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="employee-id">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="row topSectionMargin">
                    <div class="col-md-12 topSectionMargin">
                        <fieldset>
                            <legend class="text-semibold"><i class="icon-reading position-left"></i>Payment Detail</legend>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="row topMargin">
                                        <div id="personal-info" class="col-md-6 split-col">

                                            <div class="row topMargin">
                                                <div class="form-group">
                                                    <label for="payroll-pay-element" class="col-sm-4 control-label">Payroll Pay Element</label>
                                                    <div class="col-sm-8">
                                                        <input type="text" class="form-control" id="payroll-pay-element">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row topMargin">
                                                <div class="form-group">
                                                    <label for="effective-date" class="col-sm-4 control-label">Effective Date</label>
                                                    <div class="col-sm-8">
                                                        <input type="date" class="form-control" id="effective-date">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-md-6">

                                            <div class="row topMargin">
                                                <div class="form-group">
                                                    <label for="end" class="col-sm-4 control-label">Hours</label>
                                                    <div class="col-sm-8">
                                                        <input type="number" class="form-control" id="end">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row topMargin">
                                                <div class="form-group">
                                                    <label for="end" class="col-sm-4 control-label">Rate</label>
                                                    <div class="col-sm-8">
                                                        <input type="number" class="form-control" id="end">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="row topSectionMargin">
                    <div class="col-md-12 topSectionMargin">
                        <fieldset>
                            <legend class="text-semibold"><i class="icon-reading position-left"></i>Comments</legend>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="row topMargin">
                                        
                                        <div class="row topMargin">
                                            <div class="form-group">
                                                <label for="comments" class="col-sm-2 control-label">Comments</label>
                                                <div class="col-sm-10">
                                                    <textarea class="form-control" id="comments" rows="3" placeholder="Enter here..."></textarea>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Hourly Wages</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Payroll Transactions</li>
            <li class="active">Hourly Wages</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Hourly Wages</h3>
                <button type="button" class="btn" data-toggle="tooltip" title="Add Criteria" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body">
                <table id="myTable" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Payroll Name</th>
                            <th>Employee Name</th>
                            <th>Employee ID</th>
                            <th>Payroll Pay Element</th>
                            <th>Effective Date</th>
                            <th>Hours</th>
                            <th>Rate</th>
                            <th>Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
