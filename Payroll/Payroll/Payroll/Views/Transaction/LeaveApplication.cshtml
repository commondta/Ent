
@{
    ViewBag.Title = "Leave Requests";
}

<!-- Add Modal -->
<div id="add-leave-master-modal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Leave Master</h4>
            </div>
            <div class="modal-body">
                <div class="row topSectionMargin">
                    <div class="col-md-12">
                        <div class="row topMargin">
                            <div class="col-md-6">

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="location" class="col-sm-5 control-label">Location</label>
                                        <div class="col-sm-7">
                                            <select id="location" class="form-control">
                                                <option selected="selected">this</option>
                                                <option>that</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="employee-id" class="col-sm-5 control-label">Employee ID <span class="red-text">*</span></label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="employee-id" placeholder="xxxxx" autofocus>
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="employee-name" class="col-sm-5 control-label">Employee Name</label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="employee-name">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="designation" class="col-sm-5 control-label">Designation</label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="designation">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="nationality" class="col-sm-5 control-label">Nationality</label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="nationality">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="passport-no" class="col-sm-5 control-label">Passport No.</label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="passport-no">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="last-leave-from-date" class="col-sm-5 control-label">Last Leave from Date</label>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control" id="last-leave-from-date">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="last-leave-to-date" class="col-sm-5 control-label">Last Leave to Date</label>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control" id="last-leave-to-date">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="leave-code" class="col-sm-5 control-label">Leave Code <span class="red-text">*</span></label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="leave-code">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="from-date" class="col-sm-5 control-label">From Date <span class="red-text">*</span></label>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control" id="from-date">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="to-date" class="col-sm-5 control-label">To Date <span class="red-text">*</span></label>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control" id="to-date">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="no-of-days-leave-required" class="col-sm-5 control-label">No. of Days Leave Required</label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="no-of-days-leave-required">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="balance-leave" class="col-sm-5 control-label">Balance Leave</label>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control" id="balance-leave">
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-md-6">

                                <div class="row">
                                    <div class="form-group" style="margin-top: unset;">
                                        <label for="no-type" class="col-sm-4 control-label">No.</label>
                                        <div class="col-sm-8">
                                            <select id="no-type" class="form-control">
                                                <option selected="selected">Primary</option>
                                                <option>Secondary</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-sm-8 col-sm-offset-4">
                                            <input type="text" class="form-control" id="no">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                        <div class="col-sm-8">
                                            <input type="date" class="form-control" id="document-date">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <label for="status" class="col-sm-4 control-label">Status</label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="status">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="doj" class="col-sm-4 control-label">DOJ</label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="doj">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="doj-after-leave" class="col-sm-4 control-label">DOJ after Leave</label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="doj-after-leave">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="leave-type" class="col-sm-4 control-label">Leave Type</label>
                                        <div class="col-sm-8">
                                            <select id="leave-type" class="form-control">
                                                <option selected="selected">Full</option>
                                                <option>Half</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="signed-by" class="col-sm-4 control-label">Signed by</label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="signed-by">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin" >
                                    <div class="form-group">
                                        <label for="leave-address" class="col-sm-4 control-label">Leave Address</label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control" id="leave-address" rows="3" placeholder="Enter here..."></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="contact-no" class="col-sm-4 control-label">Contact #</label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="contact-no">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="prepared-by" class="col-sm-4 control-label">Prepared by <span class="red-text">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="prepared-by">
                                        </div>
                                    </div>
                                </div>

                                <div class="row topMargin">
                                    <div class="form-group">
                                        <label for="notes" class="col-sm-4 control-label">Notes</label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control" id="notes" rows="3" placeholder="Enter here..."></textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="row topSectionMargin">
                    <div class="col-sm-12">
                        <fieldset>
                            <legend class="text-semibold"><i class="icon-reading position-left"></i><b>Office Use</b></legend>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="address-1" class="col-sm-5 control-label">Recommended by</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="recommended-by">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="leave-recommended-from" class="col-sm-5 control-label">Leave Recommended from</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="leave-recommended-from">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="leave-recommended-to" class="col-sm-5 control-label">Leave Recommended to</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="leave-recommended-to">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="no-of-days-recommended" class="col-sm-5 control-label">No. of Days Recommended</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="no-of-days-recommended">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="address-3" class="col-sm-5 control-label">Approved by DO / GM</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="approved-by-do-gm">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-7 col-sm-offset-5">
                                            <div class="form-group">
                                                <div class="checkbox">
                                                    <label>
                                                        <input type="checkbox" id="approved">
                                                        Approved
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="col-md-6">
                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="leave-approved-from" class="col-sm-5 control-label">Leave Approved From</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="leave-approved-from">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="leave-approved-to" class="col-sm-5 control-label">Leave Approved to</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="leave-approved-to">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="no-of-days-approved" class="col-sm-5 control-label">No. of Days Approved</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="no-of-days-approved">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="rejoining-date" class="col-sm-5 control-label">Rejoining Date</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="rejoining-date">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="earned-leave-due" class="col-sm-5 control-label">Earned Leave Due</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="earned-leave-due">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row topMargin">
                                        <div class="form-group">
                                            <label for="settlement-for" class="col-sm-5 control-label">Settlement for</label>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control" id="settlement-for">
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Leave Requests</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Leave Management</li>
            <li class="active">Leave Requests</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Leave Requests</h3>
                <button type="button" class="btn" data-toggle="tooltip" title="Add Criteria" onclick="$('#add-leave-master-modal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body">
                <table id="myTable" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Leave Code</th>
                            <th>Description</th>
                            <th>Total Leaves in Year</th>
                            <th>Total Leaves in Year For Trainer</th>
                            <th>Laeave Type</th>
                            <th>Applicable During Probation</th>
                            <th>Enchashable</th>
                            <th>...</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>