
@{
    ViewBag.Title = "Leave Settlement";
}

<!-- Add Modal -->
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Leave Settlement</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="type" class="col-sm-4 control-label">Type</label>
                                <div class="col-sm-8">
                                    <select id="type" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="employee-id" class="col-sm-4 control-label">Employee ID</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="employee-id">
                                </div>
                            </div>
                        </div>


                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="employee-name" class="col-sm-4 control-label">Employee Name</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="employee-name">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="comp-emp-id" class="col-sm-4 control-label">Comp. Emp. ID</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="comp-emp-id">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="leave-appl-number" class="col-sm-4 control-label">Leave Appl. Number</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="leave-appl-number">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="leave-amount" class="col-sm-4 control-label">Leave Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="leave-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="current-payperiod" class="col-sm-4 control-label">Current Pay Period</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="current-payperiod">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="other-amount" class="col-sm-4 control-label">Other Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="other-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="total-amount" class="col-sm-4 control-label">Total Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="total-amount">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="no-type" class="col-sm-4 control-label">No.</label>
                                <div class="col-sm-8">
                                    <select id="no-type" class="form-control">
                                        <option selected="selected">Primary</option>
                                        <option>Secondary</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <input type="text" class="form-control" id="no">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="document-date">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="approved-from-date" class="col-sm-4 control-label">Approved From Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="approved-from-date">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="approved-to-date" class="col-sm-4 control-label">Approved to Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="approved-to-date">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="approved-days" class="col-sm-4 control-label">Approved Days</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="approved-days">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="eligible-days" class="col-sm-4 control-label">Eligible Days</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="eligible-days">
                                </div>
                            </div>
                        </div>

                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="previous-pay-period" class="col-sm-4 control-label">Previous Pay Period</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="previous-pay-period">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding: 15px;">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Leave Settlement</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Leave Management</li>
            <li class="active">Leave Settlement</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Leave Settlement / Leave Encashment</h3>
                <button type="button" class="btn" data-toggle="tooltip" title="Add Criteria" onclick="$('#myModal').modal('show');">
                    <i class="fa fa-plus"></i>
                    <div class="ripple-container">
                    </div>
                </button>
            </div>
            <div class="box-body">
                <table id="leave-settlement-dataTable" class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Type</th>
                            <th>Employee ID</th>
                            <th>Employee Name</th>
                            <th>Comp. Emp. ID</th>
                            <th>Leave Appl Number</th>
                            <th>Leave Amount</th>
                            <th>Other Amount</th>
                            <th>Total Amount</th>
                            <th>Document Days</th>
                            <th>Approved from Days</th>
                            <th>Approved to Days</th>
                            <th>Approved Days</th>
                            <th>Eligible Days</th>
                            <th>Current Pay Period</th>
                            <th>Previous Pay Period</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                            <td>dummy</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>


