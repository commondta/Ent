
@{
    ViewBag.Title = "Loan & Salary Advance Requests";
}

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Loan &amp; Salary Advance Requests</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Loan &amp; Advances</li>
            <li class="active">Loan &amp; Salary Advance Requests</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Loan &amp; Salary Advance Requests</h3>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 50px 20px;">
                    <div class="col-sm-4">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="employee-type" class="col-sm-4 control-label">Employee Type</label>
                                <div class="col-sm-8">
                                    <select id="employee-type" class="form-control">
                                        <option selected="selected">Permanent</option>
                                        <option>Temporary</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="employee-id" class="col-sm-4 control-label">Employee ID <span class="red-text">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="employee-id">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="employee-name" class="col-sm-4 control-label">Employee Name</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="employee-name">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="designation" class="col-sm-4 control-label">Designation</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="designation">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="loan-code" class="col-sm-4 control-label">Loan Code <span class="red-text">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="loan-code">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="loan-type" class="col-sm-4 control-label">Loan Type</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="loan-type">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="loan-amount" class="col-sm-4 control-label">Loan Amount <span class="red-text">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="loan-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="sanctioned-amount" class="col-sm-4 control-label">Sanctioned Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="sanctioned-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="rate-of-interest" class="col-sm-4 control-label">Rate of Interest</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="rate-of-interest">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="no-of-installments" class="col-sm-4 control-label">No. of Installments</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="no-of-installments">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="amount-month" class="col-sm-4 control-label">Amount / Month</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="amount-month">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="interest-amount" class="col-sm-4 control-label">Interest Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="interest-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-8 col-sm-offset-4">
                                <div class="form-group">
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" id="interest-amount-approved">
                                            Approved
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-4 col-sm-offset-1">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="no-type" class="col-sm-4 control-label">No.</label>
                                <div class="col-sm-8">
                                    <select id="no-type" class="form-control">
                                        <option selected="selected">Primary</option>
                                        <option>Secondary</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <input type="text" class="form-control" id="no">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="document-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="status" class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="status">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="petron-id" class="col-sm-4 control-label">Petron ID</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="petron-id">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="effective-pay-period" class="col-sm-4 control-label">Effective Pay Period</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="effective-pay-period">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="effective-date" class="col-sm-4 control-label">Effective Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="effective-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="deducted-amount" class="col-sm-4 control-label">Deducted Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="deducted-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="pending-amount" class="col-sm-4 control-label">Pending Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="pending-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="previous-loan-amount" class="col-sm-4 control-label">Previous Loan Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="previous-loan-amount">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="previous-loan-pending-amount" class="col-sm-4 control-label">Previous Loan Pending Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="previous-loan-pending-amount">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row" style="padding: 0 20px;">
                    <table id="loan-application-dataTable" class="table table-responsive table-bordered" style="margin-top:2%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Month</th>
                                <th>Year</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 10; i++)
                            {
                                <tr>
                                    <td class="grey-cell">@(i + 1)</td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <div class="col-sm-8">
                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="remarks" class="col-sm-2 control-label">Remarks</label>
                                <div class="col-sm-10">
                                    <textarea class="form-control" id="remarks" rows="3" placeholder="Enter..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
