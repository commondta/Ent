
@{
    ViewBag.Title = "Monthly Additions";
}

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Monthly Additions</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Payroll Transactions</li>
            <li class="active">Monthly Additions</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Monthly Additions</h3>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 50px 20px;">
                    <div class="col-sm-4">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="location" class="col-sm-4 control-label">Location</label>
                                <div class="col-sm-8">
                                    <select id="location" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="pay-period" class="col-sm-4 control-label">Pay Period</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="pay-period">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="employee-type" class="col-sm-4 control-label">Employee Type</label>
                                <div class="col-sm-8">
                                    <select id="employee-type" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-4 col-sm-offset-1">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="document-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="document-no" class="col-sm-4 control-label">Document #</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="document-no">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="status" class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="status">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row" style="padding: 0 20px;">
                    <table id="monthly-addition-dataTable" class="table table-responsive table-bordered" style="margin-top:2%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Employee ID</th>
                                <th>Employee Name</th>
                                <th>Designation</th>
                                <th>Department</th>
                                @for (int i = 0; i < 10; i++)
                                {
                                    <th>Addition @(i + 1)</th>
                                }
                                <th>Net Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 10; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>
