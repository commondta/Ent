@{
    ViewBag.Title = "Monthly Attendance";
}


<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Monthly Attendance</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Time &amp; Attendance</li>
            <li class="active">Monthly Attendance</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Monthly Attendance</h3>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 50px 20px;">
                    <div class="col-sm-4">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="location" class="col-sm-4 control-label">Location</label>
                                <div class="col-sm-8">
                                    <select id="location" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="employee-type" class="col-sm-4 control-label">Employee Type</label>
                                <div class="col-sm-8">
                                    <select id="employee-type" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="shift" class="col-sm-4 control-label">Shift</label>
                                <div class="col-sm-8">
                                    <select id="shift" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="pay-period" class="col-sm-4 control-label">Pay Period <span class="red-text">*</span></label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="pay-period">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="from-date" class="col-sm-4 control-label">From Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="from-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="pay-period-month" class="col-sm-4 control-label">Pay Period Month</label>
                                <div class="col-sm-8">
                                    <select id="pay-period-month" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-4 col-sm-offset-1">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="no-type" class="col-sm-4 control-label">No.</label>
                                <div class="col-sm-8">
                                    <select id="no-type" class="form-control">
                                        <option selected="selected">Primary</option>
                                        <option>Secondary</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <input type="text" class="form-control" id="no">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="date" class="col-sm-4 control-label">Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="status" class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="status">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="year" class="col-sm-4 control-label">Year</label>
                                <div class="col-sm-8">
                                    <select id="year" class="form-control">
                                        <option selected="selected">this</option>
                                        <option>that</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="to-date" class="col-sm-4 control-label">To Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="to-date">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row" style="padding: 0 20px;">
                    <table id="monthly-attendance-sheet-dataTable" class="table table-responsive table-bordered" style="margin-top:2%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Employee ID</th>
                                <th>Employee Name</th>
                                <th>Percentage</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Cost Center</th>
                                <th>Total Days</th>
                                <th>Working Days</th>
                                <th>No. of Present Days</th>
                                <th>LOP Days</th>
                                <th>Payable Leaves</th>
                                <th>OT Hours</th>
                                <th>Normal OT Hours</th>
                                <th>Sunday</th>
                                <th>MisBioMatericDays</th>
                                <th>Comp-off Days</th>
                                <th>Annual Leave</th>
                                <th>Half Day Leave</th>
                                <th>Casual Leave</th>
                                <th>Sick Leave</th>
                                <th>Earn Leave</th>
                                <th>SHLD</th>
                                <th>Week off</th>
                                <th>Night</th>
                                <th>On Duty Days</th>
                                <th>Addnl. Normal OT Hours</th>
                                <th>Addnl. Friday OT Hours</th>
                                <th>Payable Days</th>
                                <th>Absent Days</th>
                                <th>Day Shift</th>
                                <th>Field Exp.</th>
                                <th>Mob. Exp.</th>
                                <th>Gaz. Amt.</th>
                                <th>Night Shift Allowance</th>
                                <th>Extra Duty Allowance</th>
                                <th>Arrears</th>
                                <th>Sal. Adv.</th>
                                <th>TADA</th>
                                <th>Other Allowance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 10; i++)
                            {
                            <tr>
                                <td class="grey-cell">@(i + 1)</td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td><input type="text" /></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td><input type="text" /></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td><input type="text" /></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td><input type="text" /></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                                <td class="grey-cell"></td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <div class="col-sm-8">
                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="remarks" class="col-sm-2 control-label">Remarks</label>
                                <div class="col-sm-10">
                                    <textarea class="form-control" id="remarks" rows="3" placeholder="Enter..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
