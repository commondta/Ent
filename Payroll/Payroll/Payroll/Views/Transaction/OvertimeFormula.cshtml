<script>
    let Global_Array = new Array();
    //show data
    $(document).ready(function () {
        view();
    });

    function view() {
        $.ajax({
            type: "get",
            url: "@Url.Action("list", "otFormalMaster")",
            success: function (result) {
                if (result != "error") {
                    Global_Array = result;
                    $("td").remove();
