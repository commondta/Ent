@{
    ViewBag.Title = "Overtime Processing";
}


<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Overtime Processing</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Overtime Management</li>
            <li class="active">Overtime Processing</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Overtime Processing</h3>
                <button type="submit" class="btn btn-primary" onclick="save()">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 50px 20px;">
                    <div class="col-sm-4">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="pay-period" class="col-sm-4 control-label">Pay Period</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="pay-period">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="pay-month" class="col-sm-4 control-label">Pay Month</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="pay-month">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="from-date" class="col-sm-4 control-label">From Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="from-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="to-date" class="col-sm-4 control-label">To Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="to-date">
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-4 col-sm-offset-1">

                        <div class="row">
                            <div class="form-group" style="margin-top: unset;">
                                <label for="no-type" class="col-sm-4 control-label">No.</label>
                                <div class="col-sm-8">
                                    <select id="no-type" class="form-control">
                                        <option selected="selected">Primary</option>
                                        <option>Secondary</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <input type="text" class="form-control" id="no">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="document-date" class="col-sm-4 control-label">Document Date</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="document-date">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group">
                                <label for="status" class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="status">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row" style="padding: 0 20px;">
                    <table id="ot-process-dataTable" class="table table-responsive table-bordered" style="margin-top:2%;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Employee ID</th>
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Company ID</th>
                                <th>Net Amount</th>
                                <th>Basic</th>
                                <th>Week Days OT Hours</th>
                                <th>Week Days OT Amount</th>
                                <th>Week End OT Hours</th>
                                <th>Week End OT Amount</th>
                                <th>MIG Allowance</th>
                                <th>Gross Salary</th>
                                <th>Other Deductions</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 10; i++)
                            {
                                <tr>
                                    <td class="grey-cell">@(i + 1)</td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td class="grey-cell"></td>
                                    <td><input type="text" /></td>
                                    <td class="grey-cell"></td>
                                    <td><input type="text" /></td>
                                    <td><input type="text" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <div class="col-sm-8">
                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="remarks" class="col-sm-2 control-label">Remarks</label>
                                <div class="col-sm-10">
                                    <textarea class="form-control" id="remarks" rows="3" placeholder="Enter..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
