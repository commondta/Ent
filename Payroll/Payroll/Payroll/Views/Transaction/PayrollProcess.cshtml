@using DataLayer
@{
    ViewBag.Title = "Payroll Processing";
}

<!-- cfl Modal -->
<div id="cflModal" class="modal fade" role="dialog" style="float:none;margin:auto; ">
    <div class="modal-dialog modal-lg">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Pay Period</h4>
            </div>
            <div class="modal-body">
                <table id="cfl-pay-period-table" class="table table-responsive" style="margin-top:2%;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Pay Period Code Month</th>
                            <th>Pay Month</th>
                            <th>From Date</th>
                            <th>To Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payPeriodObj in ViewData["PayPeriod"] as IList<PayPeriodModel>)
                        {
                            <tr>
                                <td>@payPeriodObj.id</td>
                                <td>@payPeriodObj.PayPeriodCodeMonth</td>
                                <td>@payPeriodObj.PayMonth</td>
                                <td>@payPeriodObj.FromDate.ToString("yyyy-MM-dd")</td>
                                <td>@payPeriodObj.ToDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" data-dismiss="modal" onclick="PayPeriodPayProcSelect()">Select</button>
            </div>
        </div>
    </div>
</div>

<div class="content-wrapper">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>Payroll Processing</h1>
        <ol class="breadcrumb">
            <li><a href="~/Home/Index">Home</a></li>
            <li>Payroll Transactions</li>
            <li class="active">Payroll Processing</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">Payroll Processing</h3>
                <div class="doc-nav" id="nav-payroll-process">
                    <button class="btn btn-default" title="First"><i class="fa fa-angle-double-left"></i></button>
                    <button class="btn btn-default" title="Previous"><i class="fa fa-arrow-left"></i></button>
                    <button class="btn btn-default" title="Next"><i class="fa fa-arrow-right"></i></button>
                    <button class="btn btn-default" title="Last"><i class="fa fa-angle-double-right"></i></button>
                </div>

                <button class="btn btn-primary" id="new-btn" onclick="PayrollProcessInsertMode();">New</button>
                <button class="btn btn-primary btn-danger" id="delete-btn" onclick="PayrollProcessDelete()" >Delete</button>
                <button class="btn btn-danger hidden" id="cancel-btn" onclick="PayrollProcessCancel();">Cancel</button>
                <button class="btn btn-primary hidden" id="update-btn" onclick="PayrollProcessUpdate()">Update</button>
                <button type="submit" class="btn btn-primary hidden" id="add-btn" onclick="PayrollProcessCreate('payroll-process-parent-form', 'payroll-process-child-form', 'TaxableSalary', 'PayrollProcessCreate')">Add</button>
            </div>
            <div class="box-body">
                <div class="row" style="padding: 0 20px 20px 20px;">
                    <form id="payroll-process-parent-form" data-id="">
                        <div class="col-sm-4">

                            <div class="row">
                                <div class="form-group" style="margin-top: unset;">
                                    <label for="employee-type" class="col-sm-4 control-label">Employee Type</label>
                                    <div class="col-sm-8">
                                        <select id="employee-type" class="form-control" name="EmployeeType">
                                            <option selected="selected" disabled>Select</option>
                                            @for (int i = 0; i < ViewBag.EmployeeCategories.Length; i++)
                                            {
                                                <option value="@ViewBag.EmployeeCategories[i]">@ViewBag.EmployeeCategories[i]</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group">
                                    <label for="pay-period" class="col-sm-4 control-label">Pay Period</label>
                                    <div class="col-sm-8">
                                        <div class="cfl-container">
                                            <input type="text" class="form-control" id="pay-period" name="PayPeriod" readonly>
                                            <span onclick="$('#cflModal').modal('show')"><i class="fa fa-reorder"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group">
                                    <label for="pay-month" class="col-sm-4 control-label">Pay Month</label>
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control" name="PayMonth">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group">
                                    <label for="from-date" class="col-sm-4 control-label">From Date</label>
                                    <div class="col-sm-8">
                                        <input type="date" class="form-control" id="from-date" name="FromDate">
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="col-sm-4 col-sm-offset-1">

                            <div class="row">
                                <div class="form-group" style="margin-top: unset;">
                                    <label for="to-date" class="col-sm-4 control-label">To Date</label>
                                    <div class="col-sm-8">
                                        <input type="date" class="form-control" id="to-date" name="ToDate">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group">
                                    <label for="no-type" class="col-sm-4 control-label">Document No.</label>
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control" name="DocumentNo" readonly>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group">
                                    <label for="date" class="col-sm-4 control-label">Document Date</label>
                                    <div class="col-sm-8">
                                        <input type="date" class="form-control" id="document-date" name="DocumentDate">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group">
                                    <label for="status" class="col-sm-4 control-label">Status</label>
                                    <div class="col-sm-8">
                                        <select id="status" class="form-control" name="Status">
                                            <option selected="selected" disabled>Select</option>
                                            <option value="open">Open</option>
                                            <option value="close">Close</option>
                                            <option value="cancel">Cancel</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            @*<div class="row">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" id="applicable-during-probation" name="PostJE">
                                                Post JE
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-8 col-sm-offset-4">
                                    <div class="form-group">
                                        <input type="date" class="form-control" id="post-je-date" name="PostingDate">
                                    </div>
                                </div>
                            </div>*@

                        </div>
                    </form>
                </div>

                <div class="row" style="padding: 0 20px;">
                    <button type="button" id="calculate-pay-btn" class="btn btn-default disabled" onclick="CalculatePay()">Calculate Pay</button>
                    <form id="payroll-process-child-form">
                        <table id="payroll-process-table" class="table table-responsive table-bordered" style="margin-top:2%; width: 100%;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Employee ID</th>
                                    <th>Name</th>
                                    @foreach (var payElement in ViewBag.PayElements)
                                    {
                                        <th data-code="@payElement.PayElementCode">@payElement.Description</th>
                                    }
                                    <th data-code="IncomeTax">Income Tax</th>
                                    <th data-code="TotalDeduction">Total Deduction</th>
                                    <th data-code="NetSalary">Net Salary</th>
                                    <th data-code="TaxableSalary">Taxable Salary</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </form>
                </div>

                <div class="row" style="padding: 0 20px 20px 20px;">
                    <div class="col-sm-8">
                        <div class="row topMargin">
                            <div class="form-group">
                                <label for="remarks" class="col-sm-2 control-label">Remarks</label>
                                <div class="col-sm-10">
                                    <textarea class="form-control" id="remarks" rows="3" placeholder="Enter..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    <div id="snackbar"></div>
</div>